{
  "@context": {
    "cd": "https://w3id.org/project-chemie-digital/ontology/",
    "ex": "https://w3id.org/project-chemie-digital/resource/",
    "type": "@type",
    "id": "@id",
    "forTopic": { "@id": "cd:forTopic", "@type": "@id" },
    "hasStep": { "@id": "cd:hasStep", "@type": "@id" },
    "position": "cd:position",
    "usesResource": { "@id": "cd:usesResource", "@type": "@id" },
    "viewType": "cd:viewType"
  },
  "@graph": [
    {
      "id": "ex:standard-deviation-default-path",
      "type": "cd:LearningPath",
      "forTopic": "ex:standard-deviation",
      "hasStep": [
        "ex:sd-step-definition",
        "ex:sd-step-expression",
        "ex:sd-step-symbols",
        "ex:sd-step-examples",
        "ex:sd-step-exercise"
      ]
    },
    {
      "id": "ex:sd-step-definition",
      "type": "cd:PathStep",
      "position": 1,
      "usesResource": "ex:standard-deviation-definition-basic",
      "viewType": "concept-introduction"
    },
    {
      "id": "ex:sd-step-expression",
      "type": "cd:PathStep",
      "position": 2,
      "usesResource": "ex:sample-standard-deviation-expression",
      "viewType": "formula-introduction"
    },
    {
      "id": "ex:sd-step-symbols",
      "type": "cd:PathStep",
      "position": 3,
      "usesResource": ["ex:symbol-s", "ex:symbol-n", "ex:symbol-x-i", "ex:symbol-x-bar"],
      "viewType": "symbol-explanation"
    },
    {
      "id": "ex:sd-step-examples",
      "type": "cd:PathStep",
      "position": 4,
      "usesResource": ["ex:standard-deviation-example-replicates", "ex:standard-deviation-example-sensor"],
      "viewType": "worked-examples"
    },
    {
      "id": "ex:sd-step-exercise",
      "type": "cd:PathStep",
      "position": 5,
      "usesResource": "ex:standard-deviation-exercise-01",
      "viewType": "exercise"
    }
  ]
}
