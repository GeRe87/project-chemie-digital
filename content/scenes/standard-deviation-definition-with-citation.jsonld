    "communicativeRole": { "@id": "cd:communicativeRole", "@type": "@id" },
    "selectionPath": "cd:selectionPath",
    "language": "cd:language"
  },
  "@graph": [
    {
      "id": "ex:scene-standard-deviation-definition-with-citation",
