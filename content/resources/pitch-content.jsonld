{
  "@context": {
    "cd": "https://w3id.org/project-chemie-digital/ontology/",
    "ex": "https://w3id.org/project-chemie-digital/resource/",
    "schema": "https://schema.org/",
    "type": "@type",
    "id": "@id",
    "body": "cd:body",
    "hasSource": { "@id": "cd:hasSource", "@type": "@id" },
    "sourcePath": "cd:sourcePath"
  },
  "@graph": [
    {
      "id": "ex:pitch-knowledge-first-proposition",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Die Plattform behandelt wissenschaftliche Konzepte, wiederverwendbare Lernressourcen und ihre Beziehungen als primäre Wissensbasis. Präsentationsansichten werden daraus erzeugt und sind nicht die alleinige Quelle des Inhalts.", "@language": "de" },
      "hasSource": ["ex:pitch-source-product-vision", "ex:pitch-source-readme"]
    },
    {
      "id": "ex:pitch-semantic-resource-layer",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Definitionen, mathematische Ausdrücke, Symbole, Beispiele, Übungen und Quellen sind adressierbare semantische Ressourcen, die in unterschiedlichen Lehr- und Ausgabeformaten wiederverwendet werden können.", "@language": "de" },
      "hasSource": ["ex:pitch-source-product-vision", "ex:pitch-source-adr-0002"]
    },
    {
      "id": "ex:pitch-path-layer",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Didaktische und narrative Pfade wählen semantische Ressourcen aus und ordnen sie für einen konkreten Lehr-, Selbstlern- oder Präsentationszweck, ohne Renderer-Komponenten festzulegen.", "@language": "de" },
      "hasSource": ["ex:pitch-source-product-vision", "ex:pitch-source-adr-0002"]
    },
    {
      "id": "ex:pitch-scene-composition-layer",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Eine deterministische Kompositionsschicht überführt aufgelöste Pfade in rendererneutrale Szenendokumente und bewahrt dabei semantische Identitäten, Provenienz und Barrierefreiheitsinformationen.", "@language": "de" },
      "hasSource": ["ex:pitch-source-architecture", "ex:pitch-source-adr-0002"]
    },
    {
      "id": "ex:pitch-renderer-separation",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Konkrete Präsentationstechnologien bleiben hinter nachgelagerten Renderer-Adaptern gekapselt. Das Domänenmodell, die Pfadauflösung und die Szenenkomposition bleiben von einem einzelnen Ausgabekanal unabhängig.", "@language": "de" },
      "hasSource": ["ex:pitch-source-adr-0001", "ex:pitch-source-adr-0002"]
    },
    {
      "id": "ex:pitch-multiple-output-channels",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Dieselbe semantische Wissensbasis kann für Live-Präsentationen, Selbstlernansichten, Wissensnetzwerke sowie Druck- und spätere offene Bildungsformate genutzt werden.", "@language": "de" },
      "hasSource": ["ex:pitch-source-product-vision", "ex:pitch-source-readme"]
    },
    {
      "id": "ex:pitch-standard-deviation-proof",
      "type": ["cd:WorkedExample", "cd:PitchResource"],
      "body": { "@value": "Der technische Machbarkeitsnachweis nutzt die Standardabweichung als semantisch modelliertes Beispiel mit Definition, Formel, Symbolen, Beispielen, Übung, Lernpfad, Szenenkomposition und Wissensnetzwerkprojektion.", "@language": "de" },
      "hasSource": ["ex:pitch-source-readme", "ex:pitch-source-standard-deviation-concept"]
    },
    {
      "id": "ex:pitch-vertical-slice-purpose",
      "type": ["cd:Definition", "cd:PitchResource"],
      "body": { "@value": "Der Studiendekanat-Pitch ist als erste durchgängige Anwendung vorgesehen und soll die geplante Plattformarchitektur anhand semantischer Inhalte, einer pfadgesteuerten Struktur und mehrerer erzeugter Ansichten demonstrieren.", "@language": "de" },
      "hasSource": ["ex:pitch-source-product-vision", "ex:pitch-source-pitch-app"]
    },
    {
      "id": "ex:pitch-source-product-vision",
      "type": "cd:PitchSource",
