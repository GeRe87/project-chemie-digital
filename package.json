{
  "name": "project-chemie-digital",
  "version": "0.0.0",
  "private": true,
  "description": "Semantic learning-content platform with Reveal.js and self-study renderers.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:json": "node scripts/check-json.mjs",
    "test:json-discovery": "node --test scripts/json-candidates.test.mjs",
    "check:semantics": "python scripts/validate_semantics.py",
    "generate:runtime": "python scripts/generate_canonical_runtime.py",
    "check:runtime": "python scripts/generate_canonical_runtime.py --check",
    "prepare:interactive-runtime": "python scripts/prepare_interactive_runtime.py",
    "check:interactive-runtime": "python scripts/prepare_interactive_runtime.py --check",
    "fuseki:prepare": "python scripts/fuseki_local.py prepare",
    "fuseki:load": "python scripts/fuseki_local.py load",
    "fuseki:doctor": "python scripts/fuseki_local.py doctor",
    "fuseki:start": "python scripts/fuseki_local.py start",
    "fuseki:check": "node --experimental-strip-types packages/semantic-client/src/preflight.mts",
    "authoring:checkout": "python scripts/semantic_authoring.py checkout",
    "authoring:validate": "python scripts/semantic_authoring.py validate",
    "authoring:preview": "python scripts/semantic_authoring.py preview",
    "authoring:prepare-promotion": "python scripts/semantic_authoring.py prepare-promotion",
    "test:semantics": "python -m unittest discover -s tests -v",
    "test:core": "npm --workspace @project-chemie-digital/core test",
    "test:semantic-client": "node --experimental-strip-types --test packages/semantic-client/test/*.test.mts",
    "test:renderer-reveal": "npm --workspace @project-chemie-digital/renderer-reveal test",
    "test:renderer-d3": "npm --workspace @project-chemie-digital/renderer-d3 test",
    "test:renderer-self-study": "npm --workspace @project-chemie-digital/renderer-self-study test",
    "test:pitch": "npm --workspace @project-chemie-digital/pitch test",
    "test:self-study": "npm --workspace @project-chemie-digital/self-study test",
    "pitch:dev": "npm --workspace @project-chemie-digital/pitch run dev",
    "self-study:dev": "npm --workspace @project-chemie-digital/self-study run dev",
    "poll:demo": "python scripts/limesurvey_poll_proxy.py --demo",
    "test": "npm run check:json && npm run test:json-discovery && npm run check:semantics && npm run test:semantics && npm run test:core && npm run test:semantic-client && npm run test:renderer-reveal && npm run test:renderer-d3 && npm run test:renderer-self-study && npm run generate:runtime && npm run check:runtime && npm run test:pitch && npm run test:self-study"
  },
  "engines": {
    "node": ">=22"
  }
}
