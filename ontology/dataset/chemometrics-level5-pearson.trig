<https://w3id.org/project-chemie-digital/graph/knowledge/level5-pearson> {
  ex:l5-pearson-gof a cd:Concept ; skos:prefLabel "Pearson chi-square goodness-of-fit test for category probabilities"@en ; cd:hasDefinition ex:l5-p20-definition ; cd:authoredResource true .
  ex:l5-p20-definition a cd:Definition ; cd:body "Pearson's goodness-of-fit statistic sums squared observed-minus-expected category counts divided by their positive expected counts. For iid categorical observations with a fixed total, fixed exhaustive categories and fully specified positive category probabilities, its large-sample null reference is chi-square with category count minus one degrees of freedom. This is an approximation, unlike the exact normal-sample variance law. Sparse expected counts, fitted parameters, adaptive categories and dependent sampling require justified adjustments or alternative calibration. Rejection concerns the specified category probabilities, not identification of an alternative distribution or measurement bias."@en ; cd:hasSource ex:l5-source-nist-pearson ; cd:authoredResource true .
  ex:l5-source-nist-pearson a cd:Source ; dct:title "NIST/SEMATECH e-Handbook: Chi-Square Goodness-of-Fit Test" ; dct:creator "NIST/SEMATECH" ; dct:identifier "l5-source-nist-pearson" ; dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/eda35f.htm> ; cd:supportsResource ex:l5-p20-definition, ex:l5-p20a-formula, ex:l5-p20b-formula ; cd:authoredResource true .
  ex:l5-p20a-formula a cd:MathExpression ; cd:formulaLabel "Expected counts come from the specified model"@en ; cd:body "Multiply the fixed total of 100 particles by each predeclared category probability: 0.10, 0.20, 0.40, 0.20, 0.10. Expected counts are 10, 20, 40, 20 and 10."@en ; cd:latex "E_j=n p_j" ; dct:hasPart ex:l5-p20a-legend ; cd:hasSymbol ex:l5-p20a-expectation, ex:l5-p20a-total, ex:l5-p20a-probability, ex:l5-p20a-index ; cd:authoredResource true .
  ex:l5-p20a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-p20a-entry ; cd:authoredResource true .
  ex:l5-p20a-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, counts and class convention"@en ; dct:references ex:l5-p20a-expectation, ex:l5-p20a-total, ex:l5-p20a-probability, ex:l5-p20a-index ; cd:authoredResource true .
  ex:l5-p20a-expectation a cd:MathSymbol ; cd:symbol "expected category count" ; cd:mathNotation "E_j" ; cd:body "Expected count of particles in category j under the fixed null model. Not an expected diameter or an observed frequency."@en ; cd:authoredResource true .
  ex:l5-p20a-total a cd:MathSymbol ; cd:symbol "fixed sample size" ; cd:mathNotation "n,\\ =" ; cd:body "Fixed total n = 100 independently classified particles. Equality defines expected counts; adjacent n and p mean multiplication."@en ; cd:authoredResource true .
  ex:l5-p20a-probability a cd:MathSymbol ; cd:symbol "specified probability" ; cd:mathNotation "p_j" ; cd:body "Prespecified probabilities 0.10, 0.20, 0.40, 0.20, 0.10. They sum to 1; none is estimated from this sample. Each is dimensionless."@en ; cd:authoredResource true .
  ex:l5-p20a-index a cd:MathSymbol ; cd:symbol "category index" ; cd:mathNotation "j" ; cd:body "Categories 1 to 5: diameters below 5, 5 to below 10, 10 to below 20, 20 to below 40, at least 40 micrometres. Lower bounds included."@en ; cd:authoredResource true .
  ex:l5-p20b-formula a cd:MathExpression ; cd:formulaLabel "Add the five weighted squared discrepancies"@en ; cd:body "Pearson Q is the sum over categories of observed minus expected count squared, divided by expected count. Contributions 3.6, 3.2, 0.4, 0.8 and 3.6 sum to 11.6."@en ; cd:latex "Q=\\sum_{j=1}^{k}\\frac{(O_j-E_j)^2}{E_j}=11.6" ; dct:hasPart ex:l5-p20b-legend ; cd:hasSymbol ex:l5-p20b-counts, ex:l5-p20b-index, ex:l5-p20b-arithmetic, ex:l5-p20b-statistic ; cd:hasSource ex:l5-source-nist-pearson ; cd:authoredResource true .
  ex:l5-p20b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-p20b-entry ; cd:authoredResource true .
  ex:l5-p20b-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and weighting"@en ; dct:references ex:l5-p20b-counts, ex:l5-p20b-index, ex:l5-p20b-arithmetic, ex:l5-p20b-statistic ; cd:authoredResource true .
  ex:l5-p20b-counts a cd:MathSymbol ; cd:symbol "observed and expected" ; cd:mathNotation "O_j,\\ E_j" ; cd:body "Observed counts 4, 12, 44, 24, 16; null expected counts 10, 20, 40, 20, 10. Counts, not percentages or diameters; all expected values are positive."@en ; cd:authoredResource true .
  ex:l5-p20b-index a cd:MathSymbol ; cd:symbol "sum and classes" ; cd:mathNotation "j,\\ k,\\ \\sum_{j=1}^{k}" ; cd:body "j labels each predeclared size band. k = 5 exhaustive, mutually exclusive categories. Add all five contributions, including any observed-zero class."@en ; cd:authoredResource true .
  ex:l5-p20b-arithmetic a cd:MathSymbol ; cd:symbol "difference and weighting" ; cd:mathNotation "-,\\ {}^2,\\ /,\\ =" ; cd:body "Subtract, square, divide by the expected count, then sum. Equalities define and evaluate the statistic. Squaring removes the sign of each departure."@en ; cd:authoredResource true .
  ex:l5-p20b-statistic a cd:MathSymbol ; cd:symbol "Pearson statistic" ; cd:mathNotation "Q" ; cd:body "Nonnegative dimensionless discrepancy, here 11.6. A large value challenges the specified category probabilities, not a particular alternative model."@en ; cd:authoredResource true .
  ex:l5-p20c-formula a cd:MathExpression ; cd:formulaLabel "Five probabilities, one fixed-total constraint"@en ; cd:body "With five fixed categories and no parameters estimated from these counts, the approximate chi-square reference has five minus one, or four, degrees of freedom."@en ; cd:latex "\\nu=k-1=4" ; dct:hasPart ex:l5-p20c-legend ; cd:hasSymbol ex:l5-p20c-df, ex:l5-p20c-categories, ex:l5-p20c-constraint ; cd:authoredResource true .
  ex:l5-p20c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-p20c-entry ; cd:authoredResource true .
  ex:l5-p20c-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and approximation conditions"@en ; dct:references ex:l5-p20c-df, ex:l5-p20c-categories, ex:l5-p20c-constraint ; cd:authoredResource true .
  ex:l5-p20c-df a cd:MathSymbol ; cd:symbol "degrees of freedom" ; cd:mathNotation "\\nu" ; cd:body "Nu labels degrees of freedom of the approximate chi-square null reference. It is dimensionless and is not sample size minus 1 here."@en ; cd:authoredResource true .
  ex:l5-p20c-categories a cd:MathSymbol ; cd:symbol "category count" ; cd:mathNotation "k" ; cd:body "Five fixed categories with positive null probabilities. No model parameters are estimated from these data; expected counts are 10 or more."@en ; cd:authoredResource true .
  ex:l5-p20c-constraint a cd:MathSymbol ; cd:symbol "minus one and equality" ; cd:mathNotation "-1,\\ =" ; cd:body "The fixed total constrains category counts, leaving five minus one independent directions. Equality gives 4; the chi-square approximation still needs iid sampling and adequate expected counts."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-pearson> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:l5-pearson-gof .
  ex:l5-p20a-title a cd:Interpretation ; skos:prefLabel "Another target: particle-size proportions"@en ; cd:authoredResource true .
  ex:l5-p20b-title a cd:Interpretation ; skos:prefLabel "Find which categories challenge the model"@en ; cd:authoredResource true .
  ex:l5-p20c-title a cd:Interpretation ; skos:prefLabel "Calibrate the grouped-model discrepancy"@en ; cd:authoredResource true .
  ex:l5-p20d-title a cd:Interpretation ; skos:prefLabel "Reject these proportions, not water quality"@en ; cd:authoredResource true .
  ex:l5-p20e-title a cd:Interpretation ; skos:prefLabel "Model checking does not validate sampling"@en ; cd:authoredResource true .
  ex:l5-p20a-chart a cd:ChartDefinition ; skos:prefLabel "100 constructed particle classifications in five predeclared size bands"@en ; cd:body "Observed: 4, 12, 44, 24, 16. Expected: 10, 20, 40, 20, 10. All particles retained; diameter bands in micrometres."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-p20-counts ; cd:xAxisLabel "Diameter band"@en ; cd:yAxisLabel "Particle count"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-p20b-chart a cd:ChartDefinition ; skos:prefLabel "Pearson contributions in the same five-band order"@en ; cd:body "Contributions: 3.6, 3.2, 0.4, 0.8, 3.6. Total 11.6. The largest count is not necessarily the largest discrepancy."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-p20-contributions ; cd:xAxisLabel "Diameter band"@en ; cd:yAxisLabel "Contribution to Q"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-p20c-chart a cd:ChartDefinition ; skos:prefLabel "Chi-square with four degrees of freedom: approximate Pearson null reference"@en ; cd:body "Approximate, not exact: 4 degrees of freedom. 5% cutoff 9.487729; observed Q 11.6. Right tail continues beyond 32."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.20 ; cd:usesDataset ex:l5-t16-chi4 ; cd:xAxisLabel "Pearson statistic"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Reference density"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-p20d-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-p20d-statistic, ex:l5-p20d-cutoff, ex:l5-p20d-pvalue, ex:l5-p20d-decision ; cd:authoredResource true .
  ex:l5-p20d-statistic a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed Q: 11.6"@en ; cd:body "Five categories, fixed total 100, probabilities specified in advance. No parameters fitted to these counts."@en ; cd:authoredResource true .
  ex:l5-p20d-cutoff a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "5% reference cutoff: 9.487729"@en ; cd:body "Use the upper tail of chi-square with 4 degrees of freedom. This is an asymptotic reference for Pearson Q."@en ; cd:authoredResource true .
  ex:l5-p20d-pvalue a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Approximate p value: 0.0206"@en ; cd:body "Under the specified null and its chi-square approximation, the upper-tail probability at least as large as Q is about 2.06%."@en ; cd:authoredResource true .
  ex:l5-p20d-decision a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Reject at the chosen 5% level"@en ; cd:body "Evidence against these category probabilities under the assumptions, not a probability the model is false or proof of a specific alternative."@en ; cd:authoredResource true .
  ex:l5-p20e-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-p20e-sparse, ex:l5-p20e-fitting, ex:l5-p20e-binning, ex:l5-p20e-comparison ; cd:authoredResource true .
  ex:l5-p20e-sparse a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Expected counts matter"@en ; cd:body "Check expected, not observed, counts. Sparse cells may need justified pooling or exact/simulation calibration. A count of 5 is not a universal guarantee."@en ; cd:authoredResource true .
  ex:l5-p20e-fitting a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Fitted parameters matter"@en ; cd:body "Estimating model parameters can consume degrees of freedom. The adjustment depends on fitting and regularity; do not subtract parameters blindly."@en ; cd:authoredResource true .
  ex:l5-p20e-binning a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Classes and sampling matter"@en ; cd:body "Prespecify exhaustive classes and boundary rules. Keep tail categories. Dependence or classes chosen after seeing departures change calibration."@en ; cd:authoredResource true .
  ex:l5-p20e-comparison a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Different from classical KS"@en ; cd:body "Pearson tests category probabilities and can handle discrete outcomes. Classical KS compares unbinned data with a fixed continuous CDF; neither proves model truth."@en ; cd:authoredResource true .
  ex:l5-p20-protocol a cd:WorkedExample ; cd:bodyFormat "markdown" ; cd:body """Constructed classifications of 100 independently sampled particles under a hypothetical iid categorical model, not measured field data and not the five KS readings. Diameter bands are [0,5), [5,10), [10,20), [20,40) and [40,infinity) micrometres. Diameters are nonnegative; each lower boundary is included and each finite upper boundary excluded. Thus 5 belongs to the second band, and all diameters at least 40 stay in the last band. The five bands are fixed before observing counts.

Null probabilities are fixed at 0.10, 0.20, 0.40, 0.20 and 0.10. Expected counts are 10,20,40,20,10. Observed counts 4,12,44,24,16 sum to the same fixed total 100. No probability is fitted to these data. Pearson contributions are 3.6,3.2,0.4,0.8,3.6, sum 11.6. The first observed count is only 4 but its expected count is 10; the approximation check concerns expectations. Zero observed counts would still contribute when expectations are positive. Zero null probability with a positive observed count is a null-impossible event, not a denominator to divide by; structurally impossible zero-probability categories require separate handling.

Under this fixed multinomial null, the reference converges to chi-square with k-1=4 degrees of freedom as total size increases. It is not the exact normal-sample variance identity from T16. The chosen 5% reference cutoff is 9.487729036781154. The chi-square-four survival function at nonnegative q is exp(-q/2)*(1+q/2). It gives 0.05 at that cutoff and 0.020587372268555542 at Q=11.6. These are exact calculations for the reference distribution, but its application to this finite multinomial sample is approximate. Reject the specified category-probability null at the prespecified nominal 5% level using this approximation. No exact finite-sample multinomial p value is claimed. A p value is not the probability that the null is true or false.

For fitted categorical models, a k-1-m reference requires appropriate regular estimation of m identifiable parameters, usually from the grouped multinomial likelihood, with sufficient positive expected counts and positive remaining degrees of freedom. Estimation from ungrouped observations, adaptive categories or other fitting schemes does not automatically justify subtracting m. Use an appropriately calibrated method or simulate the whole analysis, including fitting and any category-selection rule. A prespecified pooling scheme based on expected counts changes the category count and must be reflected in the reference. Do not drop empty observed categories or tail bins, or choose bins after inspecting departures to optimize a result. Independence, fixed category definitions and representative sampling are substantive assumptions. Pearson loses within-class location information; grouped counts cannot reconstruct the raw observations or the KS statistic. The positive and negative discrepancies show which bands differ descriptively, but global rejection does not identify a unique alternative model or a cause such as contamination or measurement bias."""@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:forTopic ex:l5-pearson-gof ; cd:hasStep ex:l5-p20a-step, ex:l5-p20b-step, ex:l5-p20c-step, ex:l5-p20d-step, ex:l5-p20e-step .
  ex:l5-p20a-step a cd:PathStep ; cd:position 64 ; cd:usesScene ex:l5-p20a-scene ; cd:usesResource ex:l5-p20a-title, ex:l5-p20a-chart, ex:l5-p20a-formula ; cd:authoredResource true .
  ex:l5-p20b-step a cd:PathStep ; cd:position 65 ; cd:usesScene ex:l5-p20b-scene ; cd:usesResource ex:l5-p20b-title, ex:l5-p20b-chart, ex:l5-p20b-formula ; cd:authoredResource true .
  ex:l5-p20c-step a cd:PathStep ; cd:position 66 ; cd:usesScene ex:l5-p20c-scene ; cd:usesResource ex:l5-p20c-title, ex:l5-p20c-chart, ex:l5-p20c-formula ; cd:authoredResource true .
  ex:l5-p20d-step a cd:PathStep ; cd:position 67 ; cd:usesScene ex:l5-p20d-scene ; cd:usesResource ex:l5-p20d-title, ex:l5-p20d-cards ; cd:authoredResource true .
  ex:l5-p20e-step a cd:PathStep ; cd:position 68 ; cd:usesScene ex:l5-p20e-scene ; cd:usesResource ex:l5-p20e-title, ex:l5-p20e-cards ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-pearson> {
  ex:l5-p20a-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; cd:hasSceneItem ex:l5-p20a-heading, ex:l5-p20a-plot, ex:l5-p20a-math ; cd:narration "P20a. Use a new constructed sample of one hundred independently classified particles, not the five unbinned KS concentrations. Predeclare five exhaustive diameter bands: below five, five to below ten, ten to below twenty, twenty to below forty and at least forty micrometres. Nonnegative diameters at each lower boundary belong to that band. No tail particles are discarded. The null fixes probabilities at 0.10, 0.20, 0.40, 0.20 and 0.10 before observing the sample. Multiply by the fixed total one hundred to obtain expected counts ten, twenty, forty, twenty and ten. Observed counts are four, twelve, forty-four, twenty-four and sixteen. Both totals are one hundred. The grouped bars compare counts in the same bands; expected counts are not extra observations. No model parameters are estimated from these data. The null concerns these category probabilities, not whether raw diameters follow a normal distribution. This is a hypothetical teaching example, not evidence about a real particle population."@en ; cd:authoredResource true .
  ex:l5-p20b-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; cd:hasSceneItem ex:l5-p20b-heading, ex:l5-p20b-plot, ex:l5-p20b-math ; cd:narration "P20b. Pearson's statistic weights each squared observed-minus-expected count by its expected count. In the first band, four minus ten is minus six; squaring gives thirty-six, divided by ten gives 3.6. The second contribution is sixty-four divided by twenty, or 3.2. The central band contributes sixteen divided by forty, or 0.4. The fourth gives sixteen divided by twenty, or 0.8, and the last thirty-six divided by ten, or 3.6. Sum all five contributions: Q is 11.6. All contributions are nonnegative and the statistic is dimensionless. The central band has the largest count but not the largest discrepancy after weighting. Squaring hides the direction, so retain the original observed and expected comparison for descriptive interpretation. Observed zeros are not omitted when their null expectations are positive. A null expected count of zero is not something to divide by; a positive count there is impossible under that null. Do not reconstruct raw diameter observations from these category totals."@en ; cd:authoredResource true .
  ex:l5-p20c-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; cd:hasSceneItem ex:l5-p20c-heading, ex:l5-p20c-plot, ex:l5-p20c-math ; cd:narration "P20c. For a fixed total and five positive, prespecified category probabilities with no fitted parameters, the large-sample Pearson null reference has four degrees of freedom. One constraint comes from the category counts adding to the fixed total. Degrees of freedom are categories minus one, not total observations minus one. The displayed chi-square-four density is reused from T16, but its role here is approximate. In T16, a scaled normal-sample variance had that law exactly. Here a multinomial count statistic approaches it under its regular sampling assumptions as total size increases. Expected counts are ten, twenty, forty, twenty and ten, all at least ten. It is expected counts, not the observed first count of four, that matter to this check; a simple minimum-count rule is not a universal guarantee. The reference five percent upper-tail cutoff is about 9.487729. The observed Q of 11.6 is above it. The reference tail continues beyond the plotted window. The graph is a theoretical reference, not a histogram of particle sizes or an exact finite-sample count distribution."@en ; cd:authoredResource true .
  ex:l5-p20d-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; cd:hasSceneItem ex:l5-p20d-heading, ex:l5-p20d-list ; cd:narration "P20d. Prespecify the nominal significance level at five percent. Under the chi-square approximation with four degrees of freedom, reject when Q exceeds about 9.487729. Our constructed statistic 11.6 exceeds that cutoff. The reference probability of a statistic at least this large is approximately 0.020587, about 2.06 percent. Therefore reject this fully specified set of category probabilities at the chosen five percent level, conditional on the iid multinomial assumptions and adequacy of the approximation. The chi-square-four survival calculation is exact for the reference distribution, not an exact multinomial p value for this finite sample. A p value describes a tail probability under the null and its reference calibration; it is not the probability that the null is true or false. Rejection neither proves a particular alternative distribution nor identifies contamination, dependence or measurement bias as the cause. It also does not quantify practical importance. The two size extremes and the second band contribute strongly, but a global test is not five separate post-hoc class tests."@en ; cd:authoredResource true .
  ex:l5-p20e-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; cd:hasSceneItem ex:l5-p20e-heading, ex:l5-p20e-list ; cd:narration "P20e. Expected counts, fitting, class construction and sampling all affect the reference. Sparse expectations may require justified pooling or exact or Monte Carlo multinomial calibration under a fixed null, rather than blindly applying a chi-square cutoff. A common expected-count guide of five is not a theorem guaranteeing validity in every setting. Keep categories with zero observed counts when their null probabilities are positive, and retain the tails. If model parameters are estimated, the familiar category count minus one minus the number of fitted parameters reference needs appropriate regular estimation and identifiable parameters, commonly from the grouped multinomial likelihood. Estimating from ungrouped observations or using other fitting rules does not automatically justify that subtraction. A bootstrap must reproduce fitting and any category-selection process. Prespecified pooling changes the number of categories and the reference; choosing bins after seeing departures changes calibration. Dependence also invalidates the simple iid model. Pearson compares grouped category probabilities and applies to suitable discrete outcomes, unlike the classical fixed-continuous-null KS calibration. Grouping loses information within each band and the result depends on the categories. These counts cannot reconstruct the unbinned KS statistic. Neither test proves model truth, independence or analytical accuracy."@en ; cd:authoredResource true .
  ex:l5-p20a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-p20a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20a-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20a-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-p20a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-p20b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20b-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20b-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20b-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-p20b-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20c-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-p20c-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20c-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20c-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20c-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-p20c-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20d-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-p20d-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20d-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20d-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20e-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-p20e-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-p20e-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20e-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
