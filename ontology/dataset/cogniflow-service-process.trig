@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-service-process> {
  ex:cogniflow-service-process a cd:Concept ;
    skos:prefLabel "Services Replace Direct Dependencies"@en ;
    cd:hasDefinition ex:def-cogniflow-service-process ;
    cd:authoredResource true .

  ex:def-cogniflow-service-process a cd:Definition ;
    cd:body "Consumers call Cogniflow services by capability and semantic constraints through the MCP gateway. The Semantic Authority resolves a matching ServiceOperation through Fuseki, validates the declared interface, invokes the matched executor, and returns a standardized service result. Consumer code does not import the concrete provider implementation."@en ;
    cd:authoredResource true .

  ex:cogniflow-service-marketplace-banner a cd:Interpretation ;
    cd:body """ONLINE MARKETPLACE LOGIC
search by need → match provider → standardized order → standardized delivery"""@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-service-process a cd:SequenceDiagram ;
    skos:prefLabel "Capability-driven Cogniflow service marketplace"@en ;
    cd:body "The MCP gateway exposes cf_call_service. Semantic Authority owns semantic resolution and Fuseki access, resolves a matching ServiceOperation, validates its interface, invokes the matched executor, and returns cf.service.result.v1 through the same boundary."@en ;
    cd:hasParticipantRole ex:role-service-consumer,
      ex:role-service-gateway,
      ex:role-service-authority,
      ex:role-service-executor ;
    cd:hasInteractionMessage ex:message-service-search,
      ex:message-service-match,
      ex:message-service-order,
      ex:message-service-return,
      ex:message-service-result,
      ex:message-service-deliver ;
    cd:authoredResource true .

  ex:role-service-consumer a cd:ParticipantRole ;
    skos:prefLabel "Consumer"@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:role-service-gateway a cd:ParticipantRole ;
    skos:prefLabel "MCP Gateway"@en ;
    cd:position 2 ;
    cd:authoredResource true .

  ex:role-service-authority a cd:ParticipantRole ;
    skos:prefLabel "Authority"@en ;
    cd:position 3 ;
    cd:authoredResource true .

  ex:role-service-executor a cd:ParticipantRole ;
    skos:prefLabel "Provider"@en ;
    cd:position 4 ;
    cd:authoredResource true .

  ex:message-service-search a cd:InteractionMessage ;
    skos:prefLabel "SEARCH · capability + constraints"@en ;
    cd:position 1 ;
    cd:sourceParticipantRole ex:role-service-consumer ;
    cd:targetParticipantRole ex:role-service-gateway ;
    cd:authoredResource true .

  ex:message-service-match a cd:InteractionMessage ;
    skos:prefLabel "MATCH · resolve via Fuseki"@en ;
    cd:position 2 ;
    cd:sourceParticipantRole ex:role-service-gateway ;
    cd:targetParticipantRole ex:role-service-authority ;
    cd:authoredResource true .

  ex:message-service-order a cd:InteractionMessage ;
    skos:prefLabel "ORDER · invoke matched operation"@en ;
    cd:position 3 ;
    cd:sourceParticipantRole ex:role-service-authority ;
    cd:targetParticipantRole ex:role-service-executor ;
    cd:authoredResource true .

  ex:message-service-return a cd:InteractionMessage ;
    skos:prefLabel "RETURN · cf.service.result.v1"@en ;
    cd:position 4 ;
    cd:sourceParticipantRole ex:role-service-executor ;
    cd:targetParticipantRole ex:role-service-authority ;
    cd:authoredResource true .

  ex:message-service-result a cd:InteractionMessage ;
    skos:prefLabel "RESULT · standardized envelope"@en ;
    cd:position 5 ;
    cd:sourceParticipantRole ex:role-service-authority ;
    cd:targetParticipantRole ex:role-service-gateway ;
    cd:authoredResource true .

  ex:message-service-deliver a cd:InteractionMessage ;
    skos:prefLabel "DELIVER · result"@en ;
    cd:position 6 ;
    cd:sourceParticipantRole ex:role-service-gateway ;
    cd:targetParticipantRole ex:role-service-consumer ;
    cd:authoredResource true .

  ex:cogniflow-service-marketplace-note a cd:Interpretation ;
    cd:body "CONSUMERS DEPEND ON THE SERVICE CONTRACT — NOT ON CONCRETE PROVIDER IMPLEMENTATIONS"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-standardized-data-processing> {
  ex:path-cogniflow-standardized-data-processing cd:hasStep ex:path-step-cogniflow-service-process .
  ex:path-step-cogniflow-service-process a cd:PathStep ;
    cd:position 14 ;
    cd:usesResource ex:cogniflow-service-marketplace-banner,
      ex:diagram-cogniflow-service-process,
      ex:cogniflow-service-marketplace-note ;
    cd:usesScene ex:scene-cogniflow-service-process ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-service-process> {
  ex:scene-cogniflow-service-process a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-service-process ;
    cd:hasSceneItem ex:scene-item-cogniflow-service-process-heading,
      ex:scene-item-cogniflow-service-process-marketplace,
      ex:scene-item-cogniflow-service-process-diagram,
      ex:scene-item-cogniflow-service-process-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-service-process-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-service-process ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-service-process-marketplace a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-service-marketplace-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-service-process-diagram a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:diagram-cogniflow-service-process ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-service-process-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-service-marketplace-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
