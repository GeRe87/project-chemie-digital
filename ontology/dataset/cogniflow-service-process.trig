<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-service-process> {
  ex:cogniflow-service-process a cd:Concept ; skos:prefLabel "A stable interface coordinates specialized providers"@en ; cd:hasDefinition ex:def-cogniflow-service-process ; cd:authoredResource true .
  ex:def-cogniflow-service-process a cd:Definition ; cd:body "A user or AI agent sends a request through the MCP server. The CogniFlow Orchestrator resolves the required semantic, data, or artifact and provenance capability without changing the interface contract."@en ; cd:authoredResource true .
  ex:diagram-cogniflow-service-process a cd:SequenceDiagram ; skos:prefLabel "Stable interface service process"@en ; cd:body "Roles describe the interaction. States bind those roles to the current MCP-facing interface, orchestration, specialized provider and consumer terms."@en ; cd:hasParticipantRole ex:role-interface, ex:role-orchestrator, ex:role-provider, ex:role-consumer ; cd:hasInteractionMessage ex:message-request, ex:message-dispatch, ex:message-resolve, ex:message-result ; cd:hasSequenceState ex:state-service-process-request, ex:state-service-process-provider, ex:state-service-process-result ; cd:authoredResource true .
  ex:role-interface a cd:ParticipantRole ; skos:prefLabel "Interface"@en ; cd:position 1 ; cd:authoredResource true .
  ex:role-orchestrator a cd:ParticipantRole ; skos:prefLabel "Orchestration"@en ; cd:position 2 ; cd:authoredResource true .
  ex:role-provider a cd:ParticipantRole ; skos:prefLabel "Specialized provider"@en ; cd:position 3 ; cd:authoredResource true .
  ex:role-consumer a cd:ParticipantRole ; skos:prefLabel "Consumer"@en ; cd:position 4 ; cd:authoredResource true .
  ex:message-request a cd:InteractionMessage ; skos:prefLabel "request"@en ; cd:position 1 ; cd:sourceParticipantRole ex:role-consumer ; cd:targetParticipantRole ex:role-interface ; cd:authoredResource true .
  ex:message-dispatch a cd:InteractionMessage ; skos:prefLabel "dispatch"@en ; cd:position 2 ; cd:sourceParticipantRole ex:role-interface ; cd:targetParticipantRole ex:role-orchestrator ; cd:authoredResource true .
  ex:message-resolve a cd:InteractionMessage ; skos:prefLabel "resolve capability"@en ; cd:position 3 ; cd:sourceParticipantRole ex:role-orchestrator ; cd:targetParticipantRole ex:role-provider ; cd:authoredResource true .
  ex:message-result a cd:InteractionMessage ; skos:prefLabel "return result"@en ; cd:position 4 ; cd:sourceParticipantRole ex:role-provider ; cd:targetParticipantRole ex:role-consumer ; cd:authoredResource true .
  ex:state-service-process-request a cd:DiagramState ; skos:prefLabel "Stable request interface"@en ; cd:position 1 ; cd:activeInteractionMessage ex:message-request, ex:message-dispatch ; cd:hasParticipantBinding ex:binding-request-interface, ex:binding-request-orchestrator, ex:binding-request-consumer ; cd:authoredResource true .
  ex:state-service-process-provider a cd:DiagramState ; skos:prefLabel "Specialized capability"@en ; cd:position 2 ; cd:activeInteractionMessage ex:message-request, ex:message-dispatch, ex:message-resolve ; cd:hasParticipantBinding ex:binding-provider-interface, ex:binding-provider-orchestrator, ex:binding-provider-provider, ex:binding-provider-consumer ; cd:authoredResource true .
  ex:state-service-process-result a cd:DiagramState ; skos:prefLabel "Reusable result"@en ; cd:position 3 ; cd:activeInteractionMessage ex:message-request, ex:message-dispatch, ex:message-resolve, ex:message-result ; cd:hasParticipantBinding ex:binding-result-interface, ex:binding-result-orchestrator, ex:binding-result-provider, ex:binding-result-consumer ; cd:authoredResource true .
  ex:binding-request-interface a cd:ParticipantBinding ; skos:prefLabel "MCP Server"@en ; cd:bindsParticipantRole ex:role-interface ; cd:bindsParticipant ex:node-cogniflow-mcp ; cd:authoredResource true .
  ex:binding-request-orchestrator a cd:ParticipantBinding ; skos:prefLabel "CogniFlow Orchestrator"@en ; cd:bindsParticipantRole ex:role-orchestrator ; cd:bindsParticipant ex:node-cogniflow-orchestrator ; cd:authoredResource true .
  ex:binding-request-consumer a cd:ParticipantBinding ; skos:prefLabel "User / AI Agent"@en ; cd:bindsParticipantRole ex:role-consumer ; cd:bindsParticipant ex:node-cogniflow-actors ; cd:authoredResource true .
  ex:binding-provider-interface a cd:ParticipantBinding ; skos:prefLabel "MCP Server"@en ; cd:bindsParticipantRole ex:role-interface ; cd:bindsParticipant ex:node-cogniflow-mcp ; cd:authoredResource true .
  ex:binding-provider-orchestrator a cd:ParticipantBinding ; skos:prefLabel "CogniFlow Orchestrator"@en ; cd:bindsParticipantRole ex:role-orchestrator ; cd:bindsParticipant ex:node-cogniflow-orchestrator ; cd:authoredResource true .
  ex:binding-provider-provider a cd:ParticipantBinding ; skos:prefLabel "Semantic Provider"@en ; cd:bindsParticipantRole ex:role-provider ; cd:bindsParticipant ex:node-cogniflow-semantic-store ; cd:authoredResource true .
  ex:binding-provider-consumer a cd:ParticipantBinding ; skos:prefLabel "User / AI Agent"@en ; cd:bindsParticipantRole ex:role-consumer ; cd:bindsParticipant ex:node-cogniflow-actors ; cd:authoredResource true .
  ex:binding-result-interface a cd:ParticipantBinding ; skos:prefLabel "MCP Server"@en ; cd:bindsParticipantRole ex:role-interface ; cd:bindsParticipant ex:node-cogniflow-mcp ; cd:authoredResource true .
  ex:binding-result-orchestrator a cd:ParticipantBinding ; skos:prefLabel "CogniFlow Orchestrator"@en ; cd:bindsParticipantRole ex:role-orchestrator ; cd:bindsParticipant ex:node-cogniflow-orchestrator ; cd:authoredResource true .
