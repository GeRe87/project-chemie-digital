  ex:binding-result-consumer a cd:ParticipantBinding ; skos:prefLabel "User / AI Agent"@en ; cd:bindsParticipantRole ex:role-consumer ; cd:bindsParticipant ex:node-cogniflow-actors ; cd:authoredResource true .
