@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix schema: <https://schema.org/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-thanks> {
 ex:ted-thanks a cd:Concept ; skos:prefLabel "Thank you for your attention"@en ; cd:hasDefinition ex:ted-thanks-definition ; cd:authoredResource true .
 ex:ted-thanks-definition a cd:Definition ; cd:body "Closing slide with the speaker-specified talks website, presented both as readable text and a locally generated QR code."@en ; cd:authoredResource true .
 ex:ted-talks-website a cd:Interpretation ; cd:body "talks.odea-project.org"@en ; schema:url "https://talks.odea-project.org"^^xsd:anyURI ; cd:authoredResource true .
 ex:ted-talks-qr a cd:MediaAsset ; cd:uri "/talks-media/talks-website-qr.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "QR code linking to https://talks.odea-project.org. The address is also displayed below."@en ; dct:references ex:ted-talks-website ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/paths/talk-microplastics-ted-gc-ms> {
 ex:path-talk-microplastics-ted-gc-ms cd:hasStep ex:ted-step-thanks .
 ex:ted-step-thanks a cd:PathStep ; cd:position 25 ; cd:usesResource ex:ted-talks-qr, ex:ted-talks-website ; cd:usesScene ex:ted-scene-thanks ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-thanks> {
 ex:ted-scene-thanks a cd:SceneDefinition ; cd:focusConcept ex:ted-thanks ; cd:hasSceneItem ex:ted-thanks-heading, ex:ted-thanks-image, ex:ted-thanks-address ; cd:narration "Thank the audience for their attention. Invite them to scan the QR code or use the displayed address, talks.odea-project.org. The QR code links directly to the HTTPS website without a redirect or external QR service."@en ; cd:authoredResource true .
 ex:ted-thanks-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-thanks ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
 ex:ted-thanks-image a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-talks-qr ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
 ex:ted-thanks-address a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-talks-website ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
}
