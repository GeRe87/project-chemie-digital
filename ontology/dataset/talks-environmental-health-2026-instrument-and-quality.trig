    cd:alternativeText "TED-GC-MS setup showing sample heating, Twister capture, transfer of the sorbent, thermal desorption, cryofocusing, gas chromatography and mass spectrometry."@en ;
    dct:references ex:ted-setup-illustration ; cd:authoredResource true .
  ex:eh26-controlled-automation-figure a cd:MediaAsset ;
    cd:uri "/talks/eh26-controlled-automation.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ;
    cd:alternativeText "A TED-GC-MS instrument saves its completed data file. An event handler registers file readiness and starts the execution engine. The engine follows the configured pipeline and produces a report with provenance. The same event handler registers the completed report before sending it to the data store."@en ;
    dct:references ex:eh26-controlled-automation-flow ; cd:authoredResource true .
  ex:eh26-quality-checks a cd:Concept ;
    skos:prefLabel "What Makes an SBR Result Comparable?"@en ;
    cd:hasDefinition ex:eh26-quality-definition ; cd:authoredResource true .
  ex:eh26-quality-definition a cd:Definition ;
    cd:body "A comparison links each result to evidence about background, recovery in its matrix, calibration, and the sampling design."@en ;
    cd:hasSource ex:eh26-quality-source ; cd:authoredResource true .
  ex:eh26-quality-visual a cd:MediaAsset ;
    cd:uri "/talks/eh26-quality-checks.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ;
    cd:alternativeText "Three questions before comparing SBR results. Procedural blank: what did the method contribute? Matrix spike: how much of the addition was recovered? Independent check standard: did the response meet its acceptance criterion?"@en ;
    cd:authoredResource true .
  ex:eh26-quality-footer a cd:Interpretation ;
    cd:body "Compare SBR results alongside their quality checks. · Kittner et al."@en ;
