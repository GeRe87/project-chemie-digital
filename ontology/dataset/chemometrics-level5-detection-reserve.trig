<https://w3id.org/project-chemie-digital/graph/paths/level5-screening-reserve> {
  ex:path-level5-screening-reserve cd:forTopic ex:l5-concentration-dependent-detection ; cd:hasStep ex:l5-v03a-step, ex:l5-v03b-step, ex:l5-v03c-step .
  ex:l5-v03a-step a cd:PathStep ; cd:position 4 ; cd:usesScene ex:l5-v03a-scene ; cd:usesResource ex:l5-v03a-title, ex:l5-v03a-chart, ex:l5-v03a-formula ; cd:authoredResource true .
  ex:l5-v03b-step a cd:PathStep ; cd:position 5 ; cd:usesScene ex:l5-v03b-scene ; cd:usesResource ex:l5-v03b-title, ex:l5-v03b-chart, ex:l5-v03b-formula ; cd:authoredResource true .
  ex:l5-v03c-step a cd:PathStep ; cd:position 6 ; cd:usesScene ex:l5-v03c-scene ; cd:usesResource ex:l5-v03c-title, ex:l5-v03c-cards ; cd:authoredResource true .
