  ex:l5-v03-logistic a cd:Dataset ; skos:prefLabel "Chosen logistic probability coordinates, not fitted observations"@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:l5-v03-protocol ; cd:hasObservation ex:l5-v03-p0, ex:l5-v03-p1, ex:l5-v03-p2, ex:l5-v03-p3, ex:l5-v03-p4, ex:l5-v03-p5, ex:l5-v03-p6, ex:l5-v03-p7, ex:l5-v03-p8, ex:l5-v03-p9, ex:l5-v03-p10, ex:l5-v03-p11, ex:l5-v03-p12, ex:l5-v03-p13, ex:l5-v03-p14, ex:l5-v03-p15, ex:l5-v03-p16 ; cd:authoredResource true .
  ex:l5-v03-p0 a cd:Observation ; cd:position 1 ; cd:xValue 0.0 ; cd:numericValue 0.017986209962 ; cd:authoredResource true .
  ex:l5-v03-p1 a cd:Observation ; cd:position 2 ; cd:xValue 0.25 ; cd:numericValue 0.029312230751 ; cd:authoredResource true .
