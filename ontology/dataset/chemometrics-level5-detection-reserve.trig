  ex:l5-v03c-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-v03c-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
