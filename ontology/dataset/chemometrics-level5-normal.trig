  ex:l5-n10a-step a cd:PathStep ; cd:position 22 ; cd:usesScene ex:l5-n10a-scene ; cd:usesResource ex:l5-n10a-title, ex:l5-n10a-chart, ex:l5-n10a-formula ; cd:authoredResource true .
