  ex:l5-n09b-step a cd:PathStep ; cd:position 20 ; cd:usesScene ex:l5-n09b-scene ; cd:usesResource ex:l5-n09b-title, ex:l5-n09b-chart, ex:l5-n09b-formula ; cd:authoredResource true .
