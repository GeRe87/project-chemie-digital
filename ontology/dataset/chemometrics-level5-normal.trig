@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/sources/level5-normal> {
  ex:l5-source-r-normal a cd:Source ; dct:title "R stats: The Normal Distribution" ; dct:creator "R Core Team" ; dct:identifier "l5-source-r-normal" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Normal.html> ; cd:supportsResource ex:l5-normal-definition, ex:l5-n09c-formula, ex:l5-n10a-formula ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal> {
  ex:normal-measurement-model a cd:Concept ; skos:prefLabel "Normal model for repeated measurements"@en ; cd:hasDefinition ex:l5-normal-definition ; cd:authoredResource true .
  ex:l5-normal-definition a cd:Definition ; cd:body "A normal distribution is a continuous model with a real mean and a strictly positive standard deviation. Its density is symmetric about the mean and integrates to one. Normal measurement errors are an assumption to check, not a universal property of chemical measurements. Repeated technical measurements of the same homogeneous sample and variation across environmental sites are different populations."@en ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .

  ex:l5-n09a-formula a cd:MathExpression ; cd:formulaLabel "One sample, repeated measurements"@en ; cd:body "Measurement result i equals fixed true concentration plus constant bias plus random error. Assume normally distributed zero-mean errors with variance sigma squared."@en ; cd:latex "\\begin{gathered}Y_i=c+b+\\varepsilon_i\\\\\\varepsilon_i\\sim\\mathcal{N}(0,\\sigma^2)\\end{gathered}" ; dct:hasPart ex:l5-n09a-legend ; cd:hasSymbol ex:l5-na-reading, ex:l5-na-fixed, ex:l5-na-error, ex:l5-na-notation ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n09a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-na-entry ; cd:authoredResource true .
  ex:l5-na-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and assumptions"@en ; dct:references ex:l5-na-reading, ex:l5-na-fixed, ex:l5-na-error, ex:l5-na-notation ; cd:authoredResource true .
  ex:l5-na-reading a cd:MathSymbol ; cd:symbol "Y, i" ; cd:mathNotation "Y_i" ; cd:body "Random UV/Vis nitrate measurement result in mg/L; index i labels a repeat on the same homogeneous sample, not a different site."@en ; cd:authoredResource true .
  ex:l5-na-fixed a cd:MathSymbol ; cd:symbol "c, b" ; cd:mathNotation "c,\\ b" ; cd:body "Fixed true concentration and constant bias, both in mg/L. Their sum is the model mean; zero bias is not implied by a bell shape."@en ; cd:authoredResource true .
  ex:l5-na-error a cd:MathSymbol ; cd:symbol "epsilon, sigma" ; cd:mathNotation "\\varepsilon_i,\\ \\sigma^2" ; cd:body "Random error in mg/L. Positive sigma is its standard deviation in mg/L; sigma squared is variance in (mg/L) squared."@en ; cd:authoredResource true .
  ex:l5-na-notation a cd:MathSymbol ; cd:symbol "model notation and operators" ; cd:mathNotation "=,\\ +,\\ \\sim,\\ \\mathcal{N}(0,\\sigma^2)" ; cd:body "Equality and addition define the measurement result. Tilde means distributed as; N is normal with zero error mean and variance as second parameter."@en ; cd:authoredResource true .

  ex:l5-n09b-formula a cd:MathExpression ; cd:formulaLabel "Location and spread are separate"@en ; cd:body "The measurement model is normal with mean mu equal to c plus b, and variance sigma squared. Shifting the mean moves the curve; increasing sigma makes it wider and lower."@en ; cd:latex "\\begin{gathered}Y_i\\sim\\mathcal{N}(\\mu,\\sigma^2)\\\\\\mu=c+b,\\quad\\sigma>0\\end{gathered}" ; dct:hasPart ex:l5-n09b-legend ; cd:hasSymbol ex:l5-nb-reading, ex:l5-nb-location, ex:l5-nb-spread ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n09b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-nb-entry ; cd:authoredResource true .
  ex:l5-nb-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and parameter convention"@en ; dct:references ex:l5-nb-reading, ex:l5-nb-location, ex:l5-nb-spread ; cd:authoredResource true .
  ex:l5-nb-reading a cd:MathSymbol ; cd:symbol "Y, i, N" ; cd:mathNotation "Y_i\\sim\\mathcal{N}" ; cd:body "Measurement result i in mg/L follows a normal model. Tilde means distributed as; i labels a repeat. The second N parameter is variance, not SD."@en ; cd:authoredResource true .
  ex:l5-nb-location a cd:MathSymbol ; cd:symbol "mu, c, b" ; cd:mathNotation "\\mu=c+b" ; cd:body "Mean = true concentration + bias, all in mg/L. Narrow curves: means 10.0 and 10.6 mg/L, both with SD 0.30 mg/L."@en ; cd:authoredResource true .
  ex:l5-nb-spread a cd:MathSymbol ; cd:symbol "sigma and variance" ; cd:mathNotation "\\sigma>0,\\ \\sigma^2" ; cd:body "SD must be positive; its square is variance. Broad curve: mean 10.0, SD 0.60 mg/L. Every complete model has total area one."@en ; cd:authoredResource true .

  ex:l5-n09c-formula a cd:MathExpression ; cd:formulaLabel "The normal probability density"@en ; cd:body "The normal density has a normalizing factor and an exponential of minus one half the squared standardized distance from the mean."@en ; cd:latex "f(x)=\\frac{1}{\\sigma\\sqrt{2\\pi}}\\exp\\!\\left(-\\frac{(x-\\mu)^2}{2\\sigma^2}\\right)" ; dct:hasPart ex:l5-n09c-legend ; cd:hasSymbol ex:l5-nc-value, ex:l5-nc-location, ex:l5-nc-constants, ex:l5-nc-operators ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n09c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-nc-entry ; cd:authoredResource true .
  ex:l5-nc-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, operators and units"@en ; dct:references ex:l5-nc-value, ex:l5-nc-location, ex:l5-nc-constants, ex:l5-nc-operators ; cd:authoredResource true .
  ex:l5-nc-value a cd:MathSymbol ; cd:symbol "f, x" ; cd:mathNotation "f(x)" ; cd:body "Density in L/mg at concentration x in mg/L, not point probability. Areas are probabilities; total area on the real line is one."@en ; cd:authoredResource true .
  ex:l5-nc-location a cd:MathSymbol ; cd:symbol "mu, sigma" ; cd:mathNotation "\\mu,\\ \\sigma" ; cd:body "Mean 10.0 mg/L and positive SD 0.30 mg/L here. Sigma squared is variance, in (mg/L) squared."@en ; cd:authoredResource true .
  ex:l5-nc-constants a cd:MathSymbol ; cd:symbol "pi, exponential and root" ; cd:mathNotation "\\pi,\\ \\exp,\\ \\sqrt{2\\pi}" ; cd:body "Pi is about 3.14159; exp is the natural exponential; the root is the positive square root. Constants 1 and 2 are dimensionless."@en ; cd:authoredResource true .
  ex:l5-nc-operators a cd:MathSymbol ; cd:symbol "equality and arithmetic" ; cd:mathNotation "(x-\\mu)^2/(2\\sigma^2)" ; cd:body "Equality defines f. Subtract, square, divide by twice the variance, then negate: a dimensionless exponent. Multiply by the prefactor to normalize area."@en ; cd:authoredResource true .

  ex:l5-n10a-formula a cd:MathExpression ; cd:formulaLabel "A result 1.5 standard deviations above the mean"@en ; cd:body "Standardize by subtracting the mean and dividing by the standard deviation. The threshold 10.45 becomes 1.5. The probability above it is one minus Phi of 1.5, about 6.68 percent."@en ; cd:latex "\\begin{gathered}Z=\\frac{X-\\mu}{\\sigma},\\quad z=\\frac{10.45-10.0}{0.30}=1.5\\\\P(X>10.45)=1-\\Phi(1.5)\\approx6.68\\%\\end{gathered}" ; dct:hasPart ex:l5-n10a-legend ; cd:hasSymbol ex:l5-nt-reading, ex:l5-nt-standard, ex:l5-nt-cdf, ex:l5-nt-operators ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n10a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-nt-entry ; cd:authoredResource true .
  ex:l5-nt-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and probability"@en ; dct:references ex:l5-nt-reading, ex:l5-nt-standard, ex:l5-nt-cdf, ex:l5-nt-operators ; cd:authoredResource true .
  ex:l5-nt-reading a cd:MathSymbol ; cd:symbol "X, mu, sigma" ; cd:mathNotation "X,\\ \\mu,\\ \\sigma" ; cd:body "One future measurement result; mean 10.0 and SD 0.30, all in mg/L. Threshold 10.45 is in mg/L; the units cancel in the ratio."@en ; cd:authoredResource true .
  ex:l5-nt-standard a cd:MathSymbol ; cd:symbol "Z, z" ; cd:mathNotation "Z,\\ z" ; cd:body "Dimensionless standardized random measurement result and threshold. Z is standard normal: mean 0, variance 1. Lowercase z = 1.5 is not a probability."@en ; cd:authoredResource true .
  ex:l5-nt-cdf a cd:MathSymbol ; cd:symbol "P, Phi" ; cd:mathNotation "P,\\ \\Phi" ; cd:body "P denotes event probability; Phi is the standard-normal CDF, giving left-tail probability. One minus Phi gives the right tail."@en ; cd:authoredResource true .
  ex:l5-nt-operators a cd:MathSymbol ; cd:symbol "operators and percent" ; cd:mathNotation "=,\\ -,\\ /,\\ >,\\ \\approx,\\ \\%" ; cd:body "Subtract and divide to standardize; > means above. Equalities are exact identities; approximation and percent give rounded probability, not a confidence interval."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-normal> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:normal-measurement-model .
  ex:l5-n09a-title a cd:Interpretation ; skos:prefLabel "Model the analytical part of uncertainty"@en ; cd:authoredResource true .
  ex:l5-n09b-title a cd:Interpretation ; skos:prefLabel "Separate analytical centre and spread"@en ; cd:authoredResource true .
  ex:l5-n09c-title a cd:Interpretation ; skos:prefLabel "Express analytical variation as a density"@en ; cd:authoredResource true .
  ex:l5-n10a-title a cd:Interpretation ; skos:prefLabel "Tool: probability under a specified model"@en ; cd:authoredResource true .
  ex:l5-n09a-chart a cd:ChartDefinition ; skos:prefLabel "A model for one future UV/Vis nitrate result"@en ; cd:body "Assumed model: mean 10.0, SD 0.30 mg/L. Not fitted to the five values."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.5 ; cd:xAxisLabel "Measured nitrate concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-normal-base ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n09b-chart a cd:ChartDefinition ; skos:prefLabel "Change one parameter at a time"@en ; cd:body "Keep the model family; change only the mean or SD. All areas remain one."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.5 ; cd:xAxisLabel "Measured nitrate concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-normal-base ; dct:hasPart ex:l5-normal-shift, ex:l5-normal-wide ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n09c-chart a cd:ChartDefinition ; skos:prefLabel "Same curve, now expressed mathematically"@en ; cd:body "Return to mean 10.0, SD 0.30 mg/L. Use density areas for probabilities."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.5 ; cd:xAxisLabel "Measured nitrate concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-normal-base ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n10a-chart a cd:ChartDefinition ; skos:prefLabel "Above 10.45 mg/L: about 6.68%"@en ; cd:body "Same nitrate model, one future result, not a sample mean. Full tail: 6.68%."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.5 ; cd:xAxisLabel "Measured nitrate concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-normal-base ; cd:hasChartAnnotation ex:l5-normal-tail ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-normal-tail a cd:ChartRangeAnnotation ; cd:position 1 ; cd:startObservation ex:l5-nbase-22 ; cd:endObservation ex:l5-nbase-32 ; cd:body "Right tail: about 6.68%"@en ; cd:authoredResource true .

  ex:l5-normal-base a cd:Dataset ; skos:prefLabel "Normal model: mean 10.0, SD 0.30 mg/L"@en ; cd:body "Authored theoretical density coordinates, not simulated or measured observations. Linear drawing segments approximate the normal curve; the mathematical support is the whole real line. Display spans four standard deviations either side, omitting about 0.006334% total probability."@en ; cd:derivedFromResource ex:l5-n09c-formula ; cd:hasObservation ex:l5-nbase-0, ex:l5-nbase-1, ex:l5-nbase-2, ex:l5-nbase-3, ex:l5-nbase-4, ex:l5-nbase-5, ex:l5-nbase-6, ex:l5-nbase-7, ex:l5-nbase-8, ex:l5-nbase-9, ex:l5-nbase-10, ex:l5-nbase-11, ex:l5-nbase-12, ex:l5-nbase-13, ex:l5-nbase-14, ex:l5-nbase-15, ex:l5-nbase-16, ex:l5-nbase-17, ex:l5-nbase-18, ex:l5-nbase-19, ex:l5-nbase-20, ex:l5-nbase-21, ex:l5-nbase-22, ex:l5-nbase-23, ex:l5-nbase-24, ex:l5-nbase-25, ex:l5-nbase-26, ex:l5-nbase-27, ex:l5-nbase-28, ex:l5-nbase-29, ex:l5-nbase-30, ex:l5-nbase-31, ex:l5-nbase-32 ; cd:authoredResource true .
