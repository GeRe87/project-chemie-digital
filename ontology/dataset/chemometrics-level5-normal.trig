  ex:l5-normal-shift a cd:Dataset ; skos:prefLabel "Normal model: mean 10.6, SD 0.30 mg/L"@en ; cd:body "Theoretical density coordinates, not observations. Same spread as the baseline, shifted by 0.6 mg/L. Tails continue beyond the displayed four-SD span."@en ; cd:derivedFromResource ex:l5-n09c-formula ; cd:hasObservation ex:l5-nshift-0, ex:l5-nshift-1, ex:l5-nshift-2, ex:l5-nshift-3, ex:l5-nshift-4, ex:l5-nshift-5, ex:l5-nshift-6, ex:l5-nshift-7, ex:l5-nshift-8, ex:l5-nshift-9, ex:l5-nshift-10, ex:l5-nshift-11, ex:l5-nshift-12, ex:l5-nshift-13, ex:l5-nshift-14, ex:l5-nshift-15, ex:l5-nshift-16 ; cd:authoredResource true .
