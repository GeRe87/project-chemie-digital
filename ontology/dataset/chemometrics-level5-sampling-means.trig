<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:forTopic ex:sampling-distribution-of-mean ; cd:hasStep ex:l5-c13a-step, ex:l5-c13b-step, ex:l5-c13c-step .
