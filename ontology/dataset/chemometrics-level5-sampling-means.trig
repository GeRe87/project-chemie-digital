<https://w3id.org/project-chemie-digital/graph/knowledge/level5-sampling-means> {
  ex:sampling-distribution-of-mean a cd:Concept ; skos:prefLabel "Sampling distribution of an arithmetic mean"@en ; cd:hasDefinition ex:l5-c13-definition ; cd:authoredResource true .
  ex:l5-c13-definition a cd:Definition ; cd:body "Repeated independent samples from a specified population each produce one arithmetic mean. The resulting sampling distribution describes that statistic, not the original individual values. The population is unchanged. A finite simulated histogram approximates the sampling distribution; it is not an exact normal density."@en ; cd:authoredResource true .
  ex:l5-c13a-formula a cd:MathExpression ; cd:formulaLabel "A new synthetic population"@en ; cd:body "The individual concentration has population arithmetic expectation ten milligrams per litre and population standard deviation nine milligrams per litre."@en ; cd:latex "\\begin{gathered}E[X]=10\\;\\mathrm{mg/L}\\\\\\operatorname{SD}(X)=9\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:l5-c13a-legend ; cd:hasSymbol ex:l5-ca-variable, ex:l5-ca-expectation, ex:l5-ca-spread ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-c13a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-ca-entry ; cd:authoredResource true .
  ex:l5-ca-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, targets and units"@en ; dct:references ex:l5-ca-variable, ex:l5-ca-expectation, ex:l5-ca-spread ; cd:authoredResource true .
  ex:l5-ca-variable a cd:MathSymbol ; cd:symbol "X" ; cd:mathNotation "X" ; cd:body "Concentration of an equal-volume water unit, selected with equal chance at the fixed survey time. Idealized independent sampling; new lognormal teaching model."@en ; cd:authoredResource true .
  ex:l5-ca-expectation a cd:MathSymbol ; cd:symbol "E and equality" ; cd:mathNotation "E[X],\\ =" ; cd:body "Population arithmetic expectation, not a sample result. Equality specifies the model mean 10; mg/L means milligrams per litre."@en ; cd:authoredResource true .
  ex:l5-ca-spread a cd:MathSymbol ; cd:symbol "SD" ; cd:mathNotation "\\operatorname{SD}(X)" ; cd:body "Population standard deviation of individual values: 9 mg/L. This is not the SD of sample means or uncertainty in an estimated mean."@en ; cd:authoredResource true .
  ex:l5-c13b-formula a cd:MathExpression ; cd:formulaLabel "Four values give one arithmetic mean"@en ; cd:body "The sample mean equals the sum of four observed concentrations divided by four. For this first simulated sample the result is approximately 5.18 milligrams per litre."@en ; cd:latex "\\begin{gathered}\\bar{x}=\\frac{x_1+x_2+x_3+x_4}{4}\\\\\\approx5.18\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:l5-c13b-legend ; cd:hasSymbol ex:l5-cb-values, ex:l5-cb-mean, ex:l5-cb-operators ; cd:authoredResource true .
  ex:l5-c13b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-cb-entry ; cd:authoredResource true .
  ex:l5-cb-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, indices and calculation"@en ; dct:references ex:l5-cb-values, ex:l5-cb-mean, ex:l5-cb-operators ; cd:authoredResource true .
  ex:l5-cb-values a cd:MathSymbol ; cd:symbol "x and indices" ; cd:mathNotation "x_1,\\ x_2,\\ x_3,\\ x_4" ; cd:body "Four individual values in mg/L: about 3.678, 10.309, 2.395 and 4.345. Subscripts 1 to 4 label positions in one sample."@en ; cd:authoredResource true .
  ex:l5-cb-mean a cd:MathSymbol ; cd:symbol "x bar" ; cd:mathNotation "\\bar{x}" ; cd:body "Sample arithmetic mean in mg/L, estimating the water-body mean under the stated selection model. Not a fifth observation or the known true mean."@en ; cd:authoredResource true .
  ex:l5-cb-operators a cd:MathSymbol ; cd:symbol "addition, division and rounding" ; cd:mathNotation "+,\\ /4,\\ =,\\ \\approx" ; cd:body "Add all four values and divide by sample size 4. Equality defines the mean; approximation rounds the unrounded calculation to 5.18 mg/L."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-sampling-means> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:sampling-distribution-of-mean .
  ex:l5-c13a-title a cd:Interpretation ; skos:prefLabel "Use a known population to study estimation"@en ; cd:authoredResource true .
  ex:l5-c13b-title a cd:Interpretation ; skos:prefLabel "Our sample gives an estimate, not the truth"@en ; cd:authoredResource true .
  ex:l5-c13c-title a cd:Interpretation ; skos:prefLabel "Sampling variation limits our estimate"@en ; cd:authoredResource true .
  ex:l5-c13a-chart a cd:ChartDefinition ; skos:prefLabel "Individual concentrations: a synthetic lognormal population"@en ; cd:body "Mean 10, SD 9 mg/L: known only as simulation benchmarks, not fitted data."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.13 ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-c13-population ; cd:authoredResource true .
  ex:l5-c13b-chart a cd:ChartDefinition ; skos:prefLabel "Four simulated environmental units and their mean estimate"@en ; cd:body "Equal-chance, equal-volume sampling model: estimate 5.18 mg/L."@en ; cd:chartType cd:DotPlot ; cd:hasChartGroup ex:l5-c13-first-group ; cd:xAxisLabel "One environmental sample of four units"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:yAxisMinimum 0.0 ; cd:observationLabel "Individual values" ; cd:summaryLabel "Mean estimate" ; cd:authoredResource true .
  ex:l5-c13-first-group a cd:ChartGroup ; skos:prefLabel "Four individual values"@en ; cd:position 1 ; cd:usesDataset ex:l5-c13-first-sample ; cd:summaryResult ex:l5-c13-first-mean ; cd:authoredResource true .
  ex:l5-c13-first-sample a cd:Dataset ; skos:prefLabel "First independent four-value sample from the reproducible simulation"@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:l5-c13-simulation ; cd:hasObservation ex:l5-c13-v1, ex:l5-c13-v2, ex:l5-c13-v3, ex:l5-c13-v4 ; cd:authoredResource true .
  ex:l5-c13-v1 a cd:Observation ; cd:position 1 ; cd:numericValue 3.6776570580960026 ; cd:authoredResource true .
  ex:l5-c13-v2 a cd:Observation ; cd:position 2 ; cd:numericValue 10.308605666047372 ; cd:authoredResource true .
  ex:l5-c13-v3 a cd:Observation ; cd:position 3 ; cd:numericValue 2.3947714985271094 ; cd:authoredResource true .
  ex:l5-c13-v4 a cd:Observation ; cd:position 4 ; cd:numericValue 4.344605852877969 ; cd:authoredResource true .
  ex:l5-c13-first-mean a cd:StatisticalResult ; cd:usesDataset ex:l5-c13-first-sample ; cd:quantifiesProperty ex:arithmetic-mean ; cd:unit "mg/L" ; cd:numericValue 5.181410018887113 ; cd:derivedFromResource ex:l5-c13-v1, ex:l5-c13-v2, ex:l5-c13-v3, ex:l5-c13-v4 ; cd:authoredResource true .
  ex:l5-c13c-context a cd:Interpretation ; cd:body "One real investigation gives one estimate. These 5,000 simulated investigations reveal its sampling variation, not 5,000 required field surveys."@en ; cd:authoredResource true .
  ex:l5-c13c-chart a cd:ChartDefinition ; skos:prefLabel "5,000 means from 5,000 new four-value samples"@en ; cd:body "Bars: 5,000 sample means, four new draws each. Line: unchanged individual-value density. Shared concentration scale: 0 to 80 mg/L."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:l5-c13-mean-counts ; dct:hasPart ex:l5-c13-population ; cd:binEdges ex:l5-c13-edge-0 ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:authoredResource true .
  ex:l5-c13-mean-counts a cd:Dataset ; skos:prefLabel "Published histogram counts of 5,000 independently sampled four-value means"@en ; cd:unit "mg/L" ; cd:binCounts ex:l5-c13-count-0 ; cd:derivedFromResource ex:l5-c13-simulation ; cd:body "Counts are from Mulberry32 seed 20261031 and uncached cosine Box-Muller, two uniform outputs per individual draw; 5,000 consecutive fresh samples of size four, 20,000 individual draws. Bins are width 2 mg/L from 0 to 80; no means are excluded. Mean of means 9.99967656233794 mg/L; descriptive divisor-5000 SD 4.429316292559388 mg/L. Minimum mean 2.0790953584438268, maximum 44.51649509643375 mg/L. These are simulated frequencies, not measured data or an exact sampling density."@en ; cd:authoredResource true .
  ex:l5-c13-simulation a cd:WorkedExample ; cd:bodyFormat "markdown" ; cd:body """Reproducible simulation protocol. Specified lognormal individual expectation 10 mg/L and population SD 9 mg/L, with reference 1 mg/L. Uniforms use Mulberry32, seed 20261031. Each normal variate uses the cosine Box-Muller branch with 1-u for the radial uniform; the sine branch is discarded. Each individual consumes exactly two outputs. Four new independent model draws make each sample. There is no resampling from a finite observed dataset, balancing, rejection, forced mean or reuse of an old sample. The first sample is included among the 5,000, not added again.

```javascript
function simulate(repetitions = 5000, sampleSize = 4, seed = 20261031) {
  let state = seed >>> 0;
  function uniform() {
    state = (state + 0x6d2b79f5) >>> 0;
    let t = state;
    t = Math.imul(t ^ (t >>> 15), t | 1);
    t ^= t + Math.imul(t ^ (t >>> 7), t | 61);
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  }
  const logVariance = Math.log1p(81 / 100);
  const m = Math.log(10) - logVariance / 2;
  const s = Math.sqrt(logVariance);
  const rows = [], means = [], counts = Array(40).fill(0);
  for (let r = 0; r < repetitions; r++) {
    const row = [];
    for (let i = 0; i < sampleSize; i++) {
      const z = Math.sqrt(-2 * Math.log(1 - uniform())) * Math.cos(2 * Math.PI * uniform());
      row.push(Math.exp(m + s * z));
    }
    const mean = row.reduce((a, b) => a + b, 0) / sampleSize;
    if (!(mean >= 0 && mean <= 80)) throw new Error("Mean outside published bin domain");
    counts[Math.min(39, Math.floor(mean / 2))]++;
    rows.push(row); means.push(mean);
  }
  return { rows, means, counts, m, s };
}
```

The code is provenance for the published TriG counts, not executable lecture UI. Fixed PRNG output approximates the independent-draw mathematical model; it does not prove physical independence or describe field measurements."""@en ; cd:authoredResource true .

