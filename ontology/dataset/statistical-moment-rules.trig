@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Shared mathematical library. No LearningPath owns these rules. Applications
# reference stable identities; their numerical examples and datasets live elsewhere.
<https://w3id.org/project-chemie-digital/graph/mathematics/rules> {
  ex:rule-scale-symbol a cd:MathSymbol ; cd:symbol "a" ; cd:mathNotation "a" ; cd:body "Fixed real scale factor in an affine transformation."@en ; cd:presentationDefinition "Fixed scale factor."@en ; cd:authoredResource true .
  ex:rule-shift-symbol a cd:MathSymbol ; cd:symbol "b" ; cd:mathNotation "b" ; cd:body "Fixed real additive shift in an affine transformation."@en ; cd:presentationDefinition "Fixed additive shift."@en ; cd:authoredResource true .
  ex:rule-c-symbol cd:presentationDefinition "Fixed real constant."@en .
  ex:rule-a-symbol cd:presentationDefinition "Placeholder value or indexed term."@en .
  ex:rule-b-symbol cd:presentationDefinition "Second value or indexed term."@en .
  ex:rule-Y-symbol cd:presentationDefinition "Random quantity with the required moments."@en .
  ex:rule-U-symbol cd:presentationDefinition "Integrable random quantity."@en .
  ex:rule-V-symbol cd:presentationDefinition "Second integrable random quantity."@en .
  ex:rule-cov-symbol a cd:MathSymbol ; cd:symbol "Cov" ; cd:mathNotation "\\operatorname{Cov}" ; cd:body "Covariance of two random quantities; it measures their joint linear variation."@en ; cd:authoredResource true .
  ex:rule-indexed-Y-symbol a cd:MathSymbol ; cd:symbol "Y_i" ; cd:mathNotation "Y_i" ; cd:body "The indexed random quantity i in a finite sum."@en ; cd:authoredResource true .
  ex:rule-m-symbol a cd:MathSymbol ; cd:symbol "m" ; cd:mathNotation "m" ; cd:body "Common expectation of the indexed quantities."@en ; cd:authoredResource true .
  ex:rule-v-symbol a cd:MathSymbol ; cd:symbol "v" ; cd:mathNotation "v" ; cd:body "Common finite variance of the indexed quantities."@en ; cd:authoredResource true .
  ex:assumption-fixed-scalars a cd:Interpretation ; skos:prefLabel "Fixed real scalars"@en ; cd:body "a, b and c are finite real constants, not random quantities; any divisor is nonzero."@en ; cd:authoredResource true .
  ex:assumption-independent-finite a cd:Interpretation ; skos:prefLabel "Independent finite-variance summands"@en ; cd:body "A finite collection of mutually independent random quantities with finite second moments. Independence makes all pairwise covariance terms zero. Pairwise zero covariance would also suffice for the variance sum."@en ; cd:authoredResource true .
  ex:assumption-common-moments a cd:Interpretation ; skos:prefLabel "Common finite moments"@en ; cd:body "For every i = 1 through the positive integer n, E[Y_i] = m and Var(Y_i) = v, with finite second moments. This substitution does not by itself require independence."@en ; cd:authoredResource true .

  ex:rule-expectation-constant a cd:MathematicalRule ; skos:prefLabel "Expected value of a constant"@en ; cd:ruleFormula ex:rule-expectation-constant-formula ; cd:requiresAssumption ex:assumption-fixed-scalars ; cd:body "A constant has the same value on every repetition. Its probability-weighted theoretical average is therefore that value. This is not a statement about a random observation that happens to be observed once."@en ; cd:authoredResource true .
  ex:rule-expectation-constant-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[c]=c" ; cd:formulaLabel "A fixed constant stays fixed"@en ; cd:hasSymbol ex:vr-E-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:rule-expectation-location-scale a cd:MathematicalRule ; skos:prefLabel "Expectation under scaling and translation"@en ; cd:ruleFormula ex:rule-expectation-location-scale-formula ; cd:requiresAssumption ex:assumption-integrable, ex:assumption-fixed-scalars ; dct:hasPart ex:rule-expectation-factor, ex:rule-expectation-addition, ex:rule-expectation-constant ; cd:body "For an integrable random variable Y and fixed real a and b, multiplying the variable by a multiplies its expectation by a; adding b shifts the expectation by b. No independence assumption is needed because the other terms are constants."@en ; cd:authoredResource true .
  ex:rule-expectation-location-scale-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[aY+b]=a\\operatorname{E}[Y]+b" ; cd:formulaLabel "Scaling and shifting the theoretical mean"@en ; cd:hasSymbol ex:vr-E-symbol, ex:rule-Y-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol ; cd:authoredResource true .
  # Stable existing identity moved from the lecture graph to this shared library.
  ex:rule-expectation-affine a cd:MathematicalRule ; skos:prefLabel "Linearity with a fixed multiplier"@en ; cd:ruleFormula ex:uq-affine-rule-formula ; dct:hasPart ex:rule-expectation-addition, ex:rule-expectation-factor ; cd:requiresAssumption ex:assumption-integrable ; cd:body "For integrable random quantities U and V, expectation distributes over their sum. A fixed coefficient c may be taken outside E. Independence is not needed for this rule."@en ; cd:authoredResource true .
  ex:uq-affine-rule-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[U+cV]=\\operatorname{E}[U]+c\\operatorname{E}[V]" ; cd:hasSymbol ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-c-symbol, ex:vr-E-symbol ; cd:authoredResource true .

  ex:rule-variance-scaling a cd:MathematicalRule ; skos:prefLabel "Variance under scaling"@en ; cd:ruleFormula ex:rule-variance-scaling-formula ; cd:requiresAssumption ex:assumption-second-moment, ex:assumption-fixed-scalars ; dct:hasPart ex:rule-variance-definition, ex:rule-expectation-factor ; cd:body "Variance squares the centered distance. Replacing Y by cY multiplies every centered distance by c and its square by c². Consequently variance is multiplied by c², not by c. The standard deviation is multiplied by the absolute value of c."@en ; cd:authoredResource true .
  ex:rule-variance-scaling-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(cY)=c^2\\operatorname{Var}(Y)" ; cd:formulaLabel "Scaling acts quadratically on variance"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-c-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-variance-translation a cd:MathematicalRule ; skos:prefLabel "Variance under translation"@en ; cd:ruleFormula ex:rule-variance-translation-formula ; cd:requiresAssumption ex:assumption-second-moment, ex:assumption-fixed-scalars ; dct:hasPart ex:rule-variance-definition ; cd:body "Adding a fixed c moves the random quantity and its expectation by the same amount. Their difference is unchanged, so the variance is unchanged. This does not hold for adding an arbitrary random quantity."@en ; cd:authoredResource true .
  ex:rule-variance-translation-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(Y+c)=\\operatorname{Var}(Y)" ; cd:formulaLabel "A fixed shift does not change spread"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-c-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-variance-location-scale a cd:MathematicalRule ; skos:prefLabel "Variance under scaling and translation"@en ; cd:ruleFormula ex:rule-variance-location-scale-formula ; cd:requiresAssumption ex:assumption-second-moment, ex:assumption-fixed-scalars ; dct:hasPart ex:rule-variance-scaling, ex:rule-variance-translation ; cd:body "Combine translation invariance with the squared scaling factor. For fixed a and b and finite variance, Var(aY+b) = a² Var(Y). Unlike expectation, variance does not acquire an additive b term."@en ; cd:authoredResource true .
  ex:rule-variance-location-scale-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(aY+b)=a^2\\operatorname{Var}(Y)" ; cd:formulaLabel "Combine the two variance rules"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-variance-covariance a cd:MathematicalRule ; skos:prefLabel "Variance-covariance identity"@en ; cd:ruleFormula ex:rule-variance-covariance-formula ; cd:requiresAssumption ex:assumption-second-moment ; cd:body "For two random quantities with finite second moments, expand the squared centered sum. The expected cross product is the covariance. Positive covariance increases the variance of the sum; negative covariance decreases it. Independence is not needed for this identity."@en ; cd:authoredResource true .
  ex:rule-variance-covariance-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\operatorname{Var}(U+V)&=\\operatorname{Var}(U)+\\operatorname{Var}(V)\\\\&\\quad+2\\operatorname{Cov}(U,V)\\end{aligned}" ; cd:formulaLabel "Include the covariance of jointly varying contributions"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-cov-symbol ; cd:authoredResource true .
  ex:rule-variance-independent-sum a cd:MathematicalRule ; skos:prefLabel "Variance of a finite independent sum"@en ; cd:ruleFormula ex:rule-variance-independent-sum-formula ; cd:requiresAssumption ex:assumption-independent-finite ; dct:hasPart ex:rule-variance-covariance ; cd:body "Mutual independence makes every cross covariance zero. The variance of the finite sum then equals the sum of its variances. For two variables this reduces to Var(U+V) = Var(U)+Var(V). Standard deviations are not directly additive."@en ; cd:authoredResource true .
  ex:rule-variance-independent-sum-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}\\!\\left(\\sum_{i=1}^nY_i\\right)=\\sum_{i=1}^n\\operatorname{Var}(Y_i)" ; cd:formulaLabel "Zero pairwise covariances: add individual variances"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-indexed-Y-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-expectation-finite-average a cd:MathematicalRule ; skos:prefLabel "Expected value of a finite average"@en ; cd:ruleFormula ex:rule-expectation-finite-average-formula ; cd:requiresAssumption ex:assumption-integrable, ex:assumption-finite-sum ; dct:hasPart ex:rule-expectation-factor, ex:rule-expectation-addition ; cd:body "The sample count is fixed and positive. Move 1/n outside expectation and distribute expectation over the finite sum. This needs finite expectations, not independence. It applies to observations and also to squared deviations when their expectations exist."@en ; cd:authoredResource true .
  ex:rule-expectation-finite-average-formula a cd:MathExpression ; cd:latex "\\operatorname{E}\\!\\left[\\frac1n\\sum_{i=1}^nY_i\\right]=\\frac1n\\sum_{i=1}^n\\operatorname{E}[Y_i]" ; cd:hasSymbol ex:vr-E-symbol, ex:rule-indexed-Y-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-common-moments a cd:MathematicalRule ; skos:prefLabel "Substitute common moments in a finite sum"@en ; cd:ruleFormula ex:rule-common-moments-formula ; cd:requiresAssumption ex:assumption-common-moments ; dct:hasPart ex:rule-sum-constant ; cd:body "If every indexed quantity has expectation m and variance v, the sums of these expectations and variances are nm and nv. This is substitution followed by summing a constant. It says nothing by itself about the variance of a sum: that separate operation may need covariance terms."@en ; cd:authoredResource true .
  ex:rule-common-moments-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\sum_{i=1}^n\\operatorname{E}[Y_i]=nm\\\\\\sum_{i=1}^n\\operatorname{Var}(Y_i)=nv\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:vm-var-symbol, ex:rule-indexed-Y-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol, ex:rule-m-symbol, ex:rule-v-symbol ; cd:authoredResource true .
  ex:rule-normalize-rearrange a cd:MathematicalRule ; skos:prefLabel "Divide by a fixed count and rearrange"@en ; cd:ruleFormula ex:rule-normalize-rearrange-formula ; cd:requiresAssumption ex:assumption-fixed-scalars, ex:assumption-finite-sum ; cd:body "Divide both sides by the same positive n. Subtract c from both sides to isolate the normalized b term. These are reversible algebraic operations and require no probability assumptions."@en ; cd:authoredResource true .
  ex:rule-normalize-rearrange-formula a cd:MathExpression ; cd:latex "a=b+nc\\quad\\Longleftrightarrow\\quad\\frac bn=\\frac an-c" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:rule-substitute-equality a cd:MathematicalRule ; skos:prefLabel "Substitute an established equality"@en ; cd:ruleFormula ex:rule-substitute-equality-formula ; cd:body "Equal values may replace one another in the same expression whenever the operations are defined. The mathematical justification of the substituted value must have been established first; substitution does not prove a statistical premise."@en ; cd:requiresAssumption ex:assumption-fixed-scalars ; cd:authoredResource true .
  ex:rule-substitute-equality-formula a cd:MathExpression ; cd:latex "a=b\\quad\\Longrightarrow\\quad a+c=b+c" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:rule-factor-shortfall a cd:MathematicalRule ; skos:prefLabel "Factor a common value"@en ; cd:ruleFormula ex:rule-factor-shortfall-formula ; cd:requiresAssumption ex:assumption-finite-sum ; cd:body "Write a as na/n, subtract a/n and factor out a. The result holds for every real a and positive integer n. This is algebra, not an additional statistical assumption."@en ; cd:authoredResource true .
  ex:rule-factor-shortfall-formula a cd:MathExpression ; cd:latex "a-\\frac an=\\frac{n-1}{n}a" ; cd:hasSymbol ex:rule-a-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:rule-expectation-addition-formula cd:formulaLabel "Addition needs no independence"@en .
  ex:rule-expectation-constant-formula dct:hasPart ex:rule-legend-constant .
  ex:rule-expectation-location-scale-formula dct:hasPart ex:rule-legend-affine .
  ex:rule-expectation-addition-formula dct:hasPart ex:rule-legend-addition .
  ex:rule-variance-scaling-formula dct:hasPart ex:rule-legend-variance .
  ex:rule-variance-translation-formula dct:hasPart ex:rule-legend-variance .
  ex:rule-variance-location-scale-formula dct:hasPart ex:rule-legend-affine-var .
  ex:rule-variance-covariance-formula dct:hasPart ex:rule-legend-covariance .
  ex:rule-variance-independent-sum-formula dct:hasPart ex:rule-legend-independent .
  ex:rule-legend-constant a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lc ; cd:authoredResource true .
  ex:rule-lc a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Constant"@en ; cd:body "Expectation and a fixed constant."@en ; dct:references ex:vr-E-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:rule-legend-affine a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-la ; cd:authoredResource true .
  ex:rule-la a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Affine expectation"@en ; cd:body "Fixed coefficients and a random quantity."@en ; dct:references ex:vr-E-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-legend-addition a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-ladd ; cd:authoredResource true .
  ex:rule-ladd a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Expectation addition"@en ; cd:body "Two integrable random quantities."@en ; dct:references ex:vr-E-symbol, ex:rule-U-symbol, ex:rule-V-symbol ; cd:authoredResource true .
  ex:rule-legend-variance a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lvar ; cd:authoredResource true .
  ex:rule-lvar a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Variance transformation"@en ; cd:body "Finite variance and fixed coefficients."@en ; dct:references ex:vm-var-symbol, ex:rule-c-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-legend-affine-var a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lav ; cd:authoredResource true .
  ex:rule-lav a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Affine variance"@en ; cd:body "Finite variance and two fixed scalars."@en ; dct:references ex:vm-var-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-legend-covariance a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lcov ; cd:authoredResource true .
  ex:rule-lcov a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Variance and covariance"@en ; cd:body "Both quantities have finite second moments."@en ; dct:references ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-cov-symbol ; cd:authoredResource true .
  ex:rule-legend-independent a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lind ; cd:authoredResource true .
  ex:rule-variance-independent-sum dct:hasPart ex:rule-independent-pair-formula .
  ex:rule-independent-pair-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(U+V)=\\operatorname{Var}(U)+\\operatorname{Var}(V)" ; cd:formulaLabel "Independent U and V: covariance is zero"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol ; dct:hasPart ex:rule-legend-pair ; cd:authoredResource true .
  ex:rule-legend-pair a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rule-lpair ; cd:authoredResource true .
  ex:rule-lpair a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent pair"@en ; cd:body "Independent quantities with finite second moments."@en ; dct:references ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol ; cd:authoredResource true .
  ex:rule-lind a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Finite independent sum"@en ; cd:body "A positive count of independent finite-variance quantities."@en ; dct:references ex:vm-var-symbol, ex:rule-indexed-Y-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
}
