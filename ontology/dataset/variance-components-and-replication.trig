  ex:uq-ta2 a cd:Observation ; cd:position 2 ; cd:xValue 0.12 ; cd:numericValue 0.08 ; cd:authoredResource true .
  ex:uq-ta3 a cd:Observation ; cd:position 3 ; cd:xValue -0.08 ; cd:numericValue 0.12 ; cd:authoredResource true .
  ex:uq-ta4 a cd:Observation ; cd:position 4 ; cd:xValue 0.08 ; cd:numericValue -0.12 ; cd:authoredResource true .
  ex:uq-tb1 a cd:Observation ; cd:position 1 ; cd:xValue -0.70 ; cd:numericValue -0.45 ; cd:authoredResource true .
  ex:uq-tb2 a cd:Observation ; cd:position 2 ; cd:xValue 0.70 ; cd:numericValue 0.45 ; cd:authoredResource true .
  ex:uq-tb3 a cd:Observation ; cd:position 3 ; cd:xValue -0.45 ; cd:numericValue 0.70 ; cd:authoredResource true .
  ex:uq-tb4 a cd:Observation ; cd:position 4 ; cd:xValue 0.45 ; cd:numericValue -0.70 ; cd:authoredResource true .
  ex:uq-target-media a cd:MediaAsset ; cd:uri "/chemometrics/precision-targets.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two illustrative target patterns, centered by construction. Crosses have smaller spread; open circles have larger spread. The target center is a reference, not a validation of trueness of the QC methods."@en ; cd:body "Schematic spread only: both patterns are centered by construction. This does not establish method trueness."@en ; dct:source ex:uq-target-a, ex:uq-target-b ; cd:authoredResource true .
}
