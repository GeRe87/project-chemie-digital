@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-visuals> {
  ex:nn-process-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-normal-ic-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "One homogeneous nitrate control passes repeatedly through injection, an IC separation column, detector and concentration reporting. Small variations in injection, flow, temperature and electronics can change a result. A repeated sample does not by itself imply identical results, normal errors or zero bias."@en ; cd:authoredResource true .
  ex:nn-cdf-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-normal-eta-phi.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Schematic standard-normal density and CDF on the same z range minus four to four. Lowercase z is the concrete standardized threshold, not a function. Density near z two is 0.053991 per z-unit. Blue area to the left of z two is cumulative probability 0.9772499; orange right tail is 0.0227501. The CDF panel marks the same left probability at z two. Curves are schematic and truncated for drawing; numerical labels use the full normal law, not the drawing's area."@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-normal-ic-story> {
  ex:nn-case a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-case-h, ex:nn-case-c, ex:nn-case-v ; cd:narration "Continue from the binomial model to repeated concentration measurements of one nitrate control by IC. Ask which of the six results is the true concentration; none is automatically identified as truth. Nominal concentration, method expectation, individual result and sample mean are different concepts. The six readings have sample mean 10.0166667 and sample SD about 0.07285 mg/L, but those are not used to set the later theoretical parameters. The later chi-square precision-check readings are another series from this method, not these six reused with different numbers. No mandatory one-by-one reveal is needed: invite predictions in acquisition order with all six values visible."@en ; cd:authoredResource true .
  ex:nn-case-title a cd:Interpretation ; skos:prefLabel "Same nitrate control, different IC results"@en ; cd:authoredResource true .
  ex:nn-case-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-case-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-case-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-case-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-case-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-process-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-model-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-model-h, ex:nn-model-c, ex:nn-model-f ; cd:narration "Recall the additive measurement model without assuming its errors must be normal. The expectation can differ from nominal concentration because of bias. A sample mean and SD describe the available results but do not explain the shape or establish future probabilities. Expand the experiment before naming the law. Stable independent normal results will be a generator for the demonstration, not a conclusion proved from its histogram."@en ; cd:authoredResource true .
  ex:nn-model-title a cd:Interpretation ; skos:prefLabel "Random measurement errors need a process explanation"@en ; cd:authoredResource true .
  ex:nn-model-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-model-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-model-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-model-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-model-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-model ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-growth-live a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-growth-h, ex:nn-growth-p, ex:nn-growth-code ; cd:narration "Optional instructor-operated growth experiment. Increase M from twenty to fifty, one hundred and one thousand using one seeded stream, while holding the generating method fixed. Ask for a shape description before adding any theoretical curve. This demonstrates finite empirical behavior under an assumed generator; it does not explain why real IC errors are normal. Keep the stable mode now; drift, interference and reporting censoring are revisited at the end."@en ; cd:authoredResource true .
  ex:nn-growth-title a cd:Interpretation ; skos:prefLabel "20, 50, 100, 1,000 results: describe their shape"@en ; cd:authoredResource true .
  ex:nn-growth-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-growth-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-growth-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-growth-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-growth-code a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-readings-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-growth-saved a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-saved-h, ex:nn-saved-v ; cd:narration "This saved histogram replays exactly one thousand stable individual draws from the authored generator. It has no theoretical curve overlay. The counts concentrate near the model expectation and large deviations are rarer, but the histogram is not itself a mechanism or proof of normality. Now ask why several signed contributions can make central values more common, and connect to the preceding binomial model."@en ; cd:authoredResource true .
  ex:nn-saved-title a cd:Interpretation ; skos:prefLabel "Why are central results more common"@en ; cd:authoredResource true .
  ex:nn-saved-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-saved-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-saved-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-growth-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-four a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-four-h, ex:nn-four-v, ex:nn-four-f ; cd:narration "Use four independent equal-probability signed effects as a simplified representation of injection, flow, temperature and electronics. There are sixteen equally likely sign combinations. Only one gives each extreme; six cancel to zero and four give each intermediate error. Count positive contributions with the familiar binomial distribution, then transform that count into total error. The actual sources need not be binary or exactly independent; this construction motivates a mechanism, not a validation claim. When n changes, scale each contribution down to keep the total variance fixed."@en ; cd:authoredResource true .
  ex:nn-four-title a cd:Interpretation ; skos:prefLabel "Four signed effects: many ways to compensate"@en ; cd:authoredResource true .
  ex:nn-four-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-four-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-four-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-four-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-four-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-errors ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-binomial-live a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-bin-h, ex:nn-bin-p, ex:nn-bin-code ; cd:narration "Compare exact binomial models at four, sixteen, fifty and two hundred contributions. The total physical variance stays 0.01 (mg/L) squared; standardized variance stays one. Each finite model is still discrete. Dividing a point mass by the z lattice spacing makes a density-like bar comparison meaningful; do not overlay raw masses against a continuous density. The central-limit result concerns the standardized sum, under appropriate conditions. Iid finite-variance contributions are sufficient; a dominating or common disturbance is not automatically averaged away. Stirling asymptotics are an optional mathematical extension, not required here."@en ; cd:authoredResource true .
  ex:nn-bin-title a cd:Interpretation ; skos:prefLabel "From binomial sums toward a normal shape"@en ; cd:authoredResource true .
  ex:nn-bin-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-bin-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bin-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-binomial-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bin-code a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-binomial-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-phi-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-phi-h, ex:nn-phi-v, ex:nn-phi-f ; cd:narration "Name the limiting standard-normal density lowercase phi. It is symmetric, has maximum at zero, decreases with absolute standardized distance, and integrates to one. Lowercase z is the concrete horizontal coordinate, not another function. An exact point has probability zero under this continuous law; only interval area is probability. We have motivated rather than fully derived this density from the binomial limit."@en ; cd:authoredResource true .
  ex:nn-phi-title a cd:Interpretation ; skos:prefLabel "Lowercase phi describes density, not point probability"@en ; cd:authoredResource true .
  ex:nn-phi-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-phi-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-phi-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-phi-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-phi-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-phi ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-eta-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-z ; cd:hasSceneItem ex:nn-eta-h, ex:nn-eta-c, ex:nn-eta-f ; cd:narration "Specify the fixed theoretical model now: expectation 10.00 and SD 0.10 mg/L are treated as known independently of the six introductory values. Uppercase Z is the standardized random variable; lowercase z is a concrete standardized deviation. Zero, plus one, plus two and minus three correspond to 10.00, 10.10, 10.20 and 9.70 mg/L. Mapping the standard-normal density back to concentration requires the one-over-sigma factor, because density has reciprocal axis units. Standardizing an arbitrary nonnormal variable does not make it normal."@en ; cd:authoredResource true .
  ex:nn-eta-title a cd:Interpretation ; skos:prefLabel "z-score: distance from expectation in SD units"@en ; cd:authoredResource true .
  ex:nn-eta-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-eta-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-eta-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-eta-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-eta-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-eta ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-devices-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-z ; cd:hasSceneItem ex:nn-devices-h, ex:nn-devices-c, ex:nn-devices-f ; cd:narration "The same 10.20 result is two SDs above expectation for device A but only one for device B. Under their respective normal models the upper-tail probabilities are about 2.28 and 15.87 percent, so the result is more unusual for A. Raw concentration distance alone misses that reference-scale difference. Do not compare dimensional PDF heights as though they were tail probabilities. The later editable limit workbench can reproduce both cases by changing sigma only."@en ; cd:authoredResource true .
  ex:nn-devices-title a cd:Interpretation ; skos:prefLabel "Compare Methods on a Standardized Scale"@en ; cd:authoredResource true .
  ex:nn-devices-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-devices-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-devices-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-devices-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-devices-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-devices ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-cdf-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-cdf-h, ex:nn-cdf-v, ex:nn-cdf-f ; cd:narration "We know the density but need a probability below a measurement threshold. Uppercase Phi specializes the general CDF to standard-normal Z and integrates its PDF from minus infinity to lowercase z. At z two, the left probability is about 97.725 percent. In the paired schematic, the left density area and CDF ordinate encode that same number. The plot range is truncated for drawing, while the labels use the full distribution. z remains an argument, lowercase phi remains density, uppercase Phi is cumulative probability."@en ; cd:authoredResource true .
  ex:nn-cdf-title a cd:Interpretation ; skos:prefLabel "Uppercase Phi turns density area into probability"@en ; cd:authoredResource true .
  ex:nn-cdf-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-cdf-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-cdf-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-cdf-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-cdf-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-cdf ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-tail-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-tail-h, ex:nn-tail-c, ex:nn-tail-f ; cd:narration "Now answer the upper control-limit question. The standardized limit is two. Lowercase phi at two is about 0.054 per z-unit, not 5.4 percent probability. Uppercase Phi is about 0.97725; its complement gives about 2.275 percent above 10.20 mg/L. An unchanged method can therefore trigger this rule by chance. This is a per-result model probability, not a fault diagnosis or a regulatory specification."@en ; cd:authoredResource true .
  ex:nn-tail-title a cd:Interpretation ; skos:prefLabel "How often does a stable method exceed 10.20 mg/L"@en ; cd:authoredResource true .
  ex:nn-tail-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-tail-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-tail-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-tail-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-tail-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-tail ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-threshold-live a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-threshold-h, ex:nn-threshold-p, ex:nn-threshold-code-item ; cd:narration "This is the second and third priority experiment combined: vary a physical threshold and convert to z; separately vary method SD at fixed result. Inspect printed density and probability, the shaded PDF and corresponding CDF ordinate. The finite graph window does not redefine the full normal probability. Ask the class for a candidate one-percent upper threshold before using the printed inverse-CDF answer. The static surrounding calculations provide a fallback if browser R is unavailable."@en ; cd:authoredResource true .
  ex:nn-threshold-title a cd:Interpretation ; skos:prefLabel "Move the limit: z, phi and Phi change together"@en ; cd:authoredResource true .
  ex:nn-threshold-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-threshold-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-threshold-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-threshold-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-threshold-code-item a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-threshold-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-ecdf-live a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-ecdf-h, ex:nn-ecdf-p, ex:nn-ecdf-code-item ; cd:narration "Return to exactly the same thousand seeded individual draws as the saved histogram. Plot their full empirical step CDF and the fixed theoretical normal CDF on the same concentration axis. At 10.20 the empirical fraction is 0.978, whereas the model CDF is 0.977249868. The difference is finite-sample variation, not proof that a fitted model is wrong or right. This is an assumed generating model, not one estimated from these observations. Do not turn the visual comparison into an uncalibrated goodness-of-fit test."@en ; cd:authoredResource true .
  ex:nn-ecdf-title a cd:Interpretation ; skos:prefLabel "Why does the ECDF not exactly follow the model"@en ; cd:authoredResource true .
  ex:nn-ecdf-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-ecdf-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-ecdf-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-ecdf-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-ecdf-code-item a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-ecdf-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-decision-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-decision-h, ex:nn-decision-c, ex:nn-decision-f ; cd:narration "Reverse the question. A one-percent upper-tail target requires left probability 0.99, so use inverse Phi. The exact standardized quantile is about 2.326347874 and the concentration cutoff about 10.232634787 mg/L. Display 10.233 as a rounded illustration, not an exact operational prescription. The false-alarm target is per individual reading under the known-parameter normal model; multiple checks and estimated parameters require separate calibration. This is not a chemical acceptance specification, legal limit or authorization to release a sample."@en ; cd:authoredResource true .
  ex:nn-decision-title a cd:Interpretation ; skos:prefLabel "Where should an upper one-percent limit lie"@en ; cd:authoredResource true .
  ex:nn-decision-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-decision-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-decision-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-rule-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-decision-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-decision ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bands-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-bands-h, ex:nn-bands-c, ex:nn-bands-f ; cd:narration "Derive rather than memorize the 68-95-99.7 rule. CDF differences give a central interval. Symmetry gives twice Phi at k minus one. With k one, two, three the exact coverages are approximately 68.268949, 95.449974 and 99.730020 percent. The interval plus/minus two SD excludes both tails, totaling about 4.55 percent; a single upper two-SD limit excludes only about 2.28 percent. These probabilities concern individual results, not confidence limits for a population mean."@en ; cd:authoredResource true .
  ex:nn-bands-title a cd:Interpretation ; skos:prefLabel "One tail or two: derive the central coverage"@en ; cd:authoredResource true .
  ex:nn-bands-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-bands-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bands-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-bands-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bands-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-bands ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-means-h, ex:nn-means-f ; cd:narration "Switch random quantities: compare one individual result with the mean of six independent normal readings. The mean has the same expectation but SD 0.10 divided by root six, about 0.040824829 mg/L. Variance of an average is individual variance over n under independence and common variance; normality is not required for that variance identity. Normal individuals additionally give an exactly normal sample mean for every sample size. It is not the CLT alone that makes this particular mean law exact. Method scatter and constant bias are not removed by averaging."@en ; cd:authoredResource true .
  ex:nn-means-title a cd:Interpretation ; skos:prefLabel "Individual result versus the mean of six readings"@en ; cd:authoredResource true .
  ex:nn-means-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-means-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-means-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-means ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-live a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-means-live-h, ex:nn-means-live-p, ex:nn-means-code-item ; cd:narration "Repeat complete independent experiments rather than averaging the same fixed six values repeatedly. One fresh individual draw and a separate fresh n-reading average contribute to the two histograms in each simulation iteration. Shared physical axes and density scales make the narrower sampling distribution visible. Change n with M held fixed; more simulated experiments stabilize the picture, whereas more readings per average reduce its true SE. The underlying individual SD stays 0.10 mg/L."@en ; cd:authoredResource true .
  ex:nn-means-live-title a cd:Interpretation ; skos:prefLabel "Repeat the experiment: single results and sample means"@en ; cd:authoredResource true .
  ex:nn-means-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-means-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-live-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-means-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-means-code-item a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:nn-means-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-limits-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-limits-h, ex:nn-limits-c ; cd:narration "Return optionally to the earlier reading workbench at M one thousand and change only its mode: drift, interference or censored. It plots acquisition order beside the histogram, so drift cannot hide behind a pooled distribution. The artificial 9.95 reporting threshold illustrates censoring, not an actual nitrate detection limit or a recommended substitution. Ask which stable-model assumption or observation process changed. Normality is a defensible model under suitable conditions, not a universal property of chemical measurements. The visible cards are a static alternative to running the modes."@en ; cd:authoredResource true .
  ex:nn-limits-title a cd:Interpretation ; skos:prefLabel "A normal model is not a universal measurement law"@en ; cd:authoredResource true .
  ex:nn-limits-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-limits-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-limits-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-limits-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bridge a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; cd:hasSceneItem ex:nn-bridge-h, ex:nn-bridge-c ; cd:narration "Keep the same IC method and the known precision reference 0.10 mg/L, but open a new six-result QC series. Its sample SD is about 0.155 mg/L. We can predict individual measurements under a model, but the SD estimated from a small series is itself random. Ask whether chance alone can produce this much observed spread. This is the direct transition to chi-square, which constructs a reference for scaled sample variances by squaring and summing independent standard-normal residual coordinates. Lowercase z is a realized standardized coordinate; capital Z is the random standard-normal variable in that construction."@en ; cd:authoredResource true .
  ex:nn-bridge-title a cd:Interpretation ; skos:prefLabel "How reliable is an estimated SD"@en ; cd:authoredResource true .
  ex:nn-bridge-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:nn-bridge-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:nn-bridge-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:nn-bridge-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
