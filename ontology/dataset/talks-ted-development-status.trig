<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-development-status> {
 ex:ted-source-development-status a cd:Source ; dct:title "Speaker update: automation and AI development status" ; dct:creator "Gerrit Renner" ; dct:identifier "speaker-authoring-request/automation-ai-development-status" ; dct:description "The speaker states that the engine and semantically described pipelines exist, while the complete laboratory automation system and AI-assisted orchestration remain under development. Initial AI tests reportedly construct pipelines and pass all configured pipeline-validation checks. No test logs, benchmark, success rate, release-readiness evidence or independent scientific validation were supplied with this update."@en ; cd:supportsResource ex:ted-event-execution-definition, ex:ted-ai-definition ; cd:authoredResource true .
 ex:ted-event-execution-definition cd:hasSource ex:ted-source-development-status .
 ex:ted-ai-definition cd:hasSource ex:ted-source-development-status .
 ex:ted-source-report-storage a cd:Source ; dct:title "Speaker clarification: report completion and data-server storage" ; dct:identifier "speaker-authoring-request/report-ready-event-data-server" ; dct:description "Pipelines form the execution schema followed by the engine. Completed reports are deposited in the data server after the event handler registers report completion. This clarifies the proposed automation architecture; it is not evidence that the full integrated system has been released."@en ; cd:supportsResource ex:ted-event-execution-definition ; cd:authoredResource true .
 ex:ted-event-execution-definition cd:hasSource ex:ted-source-report-storage .
}
