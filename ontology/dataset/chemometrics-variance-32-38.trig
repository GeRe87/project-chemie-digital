  ex:v35h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:v35 ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:v35f1 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:v35-sd ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:v35f2 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:v35-se ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
