@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-multi-view> {
  ex:cogniflow-same-semantics-different-views a cd:Concept ;
    skos:prefLabel "One Meaning. Multiple Views."@en ;
    cd:hasDefinition ex:def-cogniflow-same-semantics-different-views ;
    cd:authoredResource true .

  ex:def-cogniflow-same-semantics-different-views a cd:Definition ;
    cd:body "The same semantic resource can become RDF, a table or a chart without copying or redefining the underlying observations."@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-multi-view-extension> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-same-semantics-different-views .

  ex:path-step-cogniflow-same-semantics-different-views a cd:PathStep ;
    cd:position 6 ;
    cd:usesResource ex:code-cogniflow-chart-semantics,
      ex:chart-cogniflow-replicate-peak-area ;
    cd:usesScene ex:scene-cogniflow-same-semantics-different-views ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-multi-view> {
  ex:scene-cogniflow-same-semantics-different-views a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-same-semantics-different-views ;
    cd:hasSceneItem ex:scene-item-cogniflow-multi-view-heading,
      ex:scene-item-cogniflow-multi-view-semantic-source,
      ex:scene-item-cogniflow-multi-view-chart ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-multi-view-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-same-semantics-different-views ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-multi-view-semantic-source a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:code-cogniflow-chart-semantics ;
    cd:communicativeRole cd:CodeRole ;
    cd:selectionPath "cd:hasCodeExample" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-multi-view-chart a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:chart-cogniflow-replicate-peak-area ;
    cd:communicativeRole cd:ChartRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
