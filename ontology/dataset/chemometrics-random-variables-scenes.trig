@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-random-variables-lecture> {
  # 01 — title only ----------------------------------------------------------
  ex:scene-chemometrics-variables-constants-title a cd:SceneDefinition ;
    cd:focusConcept ex:variables-and-constants ;
    cd:hasSceneItem ex:scene-item-vc-title-heading ;
    cd:authoredResource true .
  ex:scene-item-vc-title-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:variables-and-constants ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .

  # 02 — sourced definition card --------------------------------------------
  ex:scene-chemometrics-variable-definition a cd:SceneDefinition ;
    cd:focusConcept ex:variable ;
    cd:presentationPattern cd:DefinitionWithCitation ;
    cd:hasSceneItem ex:scene-item-variable-heading,
      ex:scene-item-variable-definition,
      ex:scene-item-variable-citation ;
    cd:authoredResource true .
  ex:scene-item-variable-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:variable ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-variable-definition a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:def-variable ;
    cd:communicativeRole cd:QuotationRole ; cd:selectionPath "cd:hasDefinition" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-variable-citation a cd:SceneItem ;
    cd:position 3 ; cd:selectsResource ex:source-openstax-statistics ;
    cd:communicativeRole cd:CitationRole ;
    cd:selectionPath "cd:hasDefinition/cd:hasSource" ;
    cd:authoredResource true .

  # 03 — continuously changing illustrative measurements --------------------
  ex:scene-chemometrics-measured-variable-example a cd:SceneDefinition ;
    cd:focusConcept ex:measured-variable-example ;
    cd:hasSceneItem ex:scene-item-measured-variable-heading,
      ex:scene-item-measured-variable-intro,
      ex:scene-item-measured-variable-table,
      ex:scene-item-measured-variable-chart ;
    cd:authoredResource true .
  ex:scene-item-measured-variable-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:measured-variable-example ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-measured-variable-intro a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:measured-variable-example-intro ;
    cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-measured-variable-table a cd:SceneItem ;
    cd:position 3 ; cd:selectsResource ex:table-live-absorbance-observations ;
    cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-measured-variable-chart a cd:SceneItem ;
    cd:position 4 ; cd:selectsResource ex:chart-live-absorbance-observations ;
    cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ;
    cd:language "en" ; cd:authoredResource true .

  # 04 — independent / dependent via y=f(x) ---------------------------------
  ex:scene-chemometrics-functional-dependence a cd:SceneDefinition ;
    cd:focusConcept ex:independent-dependent-variable-roles ;
    cd:hasSceneItem ex:scene-item-functional-heading,
      ex:scene-item-functional-intro,
      ex:scene-item-functional-formula,
      ex:scene-item-functional-examples,
      ex:scene-item-functional-caveat ;
    cd:authoredResource true .
  ex:scene-item-functional-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:independent-dependent-variable-roles ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-functional-intro a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:functional-dependence-intro ;
    cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ;
