    cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ;
    cd:language "en" ; cd:authoredResource true .

  # 06 — minimal webR random draw -------------------------------------------
  ex:scene-chemometrics-random-draw-r a cd:SceneDefinition ;
