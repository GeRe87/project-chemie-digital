@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-random-variables-lecture> {
  # 01 — title ---------------------------------------------------------------
  ex:scene-chemometrics-variables-title a cd:SceneDefinition ;
    cd:focusConcept ex:variables-foundation ;
    cd:hasSceneItem ex:scene-item-variables-title-heading ;
    cd:authoredResource true .
  ex:scene-item-variables-title-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:variables-foundation ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .

  # 02 — general variable definition ----------------------------------------
  ex:scene-chemometrics-variable-definition a cd:SceneDefinition ;
