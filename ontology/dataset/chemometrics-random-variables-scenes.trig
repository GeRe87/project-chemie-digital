<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-random-variables-lecture> {
  # 01 — contrast diagram ----------------------------------------------------
  ex:scene-chemometrics-variables-constants-opener a cd:SceneDefinition ;
    cd:focusConcept ex:variables-and-constants ;
