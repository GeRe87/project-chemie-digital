    cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-functional-examples a cd:SceneItem ;
    cd:position 4 ; cd:selectsResource ex:function-example-cards ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-functional-caveat a cd:SceneItem ;
    cd:position 5 ; cd:selectsResource ex:functional-dependence-caveat ;
    cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ;
    cd:language "en" ; cd:authoredResource true .

  # 05 — variable, observation, sample, random-variable model ----------------
  ex:scene-chemometrics-observation-random-bridge a cd:SceneDefinition ;
    cd:focusConcept ex:variable-observation-random-model ;
