@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-random-variables-lecture> {
  ex:scene-chemometrics-random-variables-opener a cd:SceneDefinition ;
    cd:focusConcept ex:random-variable ;
    cd:hasSceneItem ex:scene-item-chemometrics-random-variables-opener-heading,
      ex:scene-item-chemometrics-random-variables-opener-exercise,
      ex:scene-item-chemometrics-random-variables-opener-code ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-random-variables-opener-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:random-variable ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-random-variables-opener-exercise a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:exercise-dice-realizations ;
    cd:communicativeRole cd:ExerciseRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

