  # 08 — assigned variable versus constant in UV/Vis ------------------------
  ex:scene-chemometrics-uvvis-example a cd:SceneDefinition ;
    cd:focusConcept ex:uvvis-calibration-roles ;
    cd:hasSceneItem ex:scene-item-uvvis-heading,
