      ex:scene-item-uvvis-table,
      ex:scene-item-uvvis-chart,
      ex:scene-item-uvvis-roles ;
    cd:authoredResource true .
  ex:scene-item-uvvis-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:uvvis-calibration-roles ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
