  # 07 — sourced constant definition ----------------------------------------
  ex:scene-chemometrics-constant-definition a cd:SceneDefinition ;
    cd:focusConcept ex:constant ;
    cd:presentationPattern cd:DefinitionWithCitation ;
    cd:hasSceneItem ex:scene-item-constant-heading,
