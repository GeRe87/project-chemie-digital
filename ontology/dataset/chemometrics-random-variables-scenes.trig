      ex:scene-item-vc-opener-diagram ;
    cd:authoredResource true .
  ex:scene-item-vc-opener-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:variables-and-constants ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ; cd:authoredResource true .
  ex:scene-item-vc-opener-diagram a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:diagram-variable-constant-contrast ;
    cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ;
    cd:language "en" ; cd:authoredResource true .

