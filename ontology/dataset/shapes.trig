@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/shapes/core> {
  cd:ConceptShape a sh:NodeShape ;
    sh:targetClass cd:Concept ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:hasDefinition ; sh:minCount 1 ] .

  cd:PitchResourceShape a sh:NodeShape ;
    sh:targetClass cd:PitchResource ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ] ;
    sh:property [ sh:path cd:hasSource ; sh:minCount 1 ] .

  cd:PitchSourceShape a sh:NodeShape ;
    sh:targetClass cd:PitchSource ;
    sh:property [ sh:path cd:sourcePath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .

  cd:LearningPathShape a sh:NodeShape ;
    sh:targetClass cd:LearningPath ;
    sh:property [ sh:path cd:forTopic ; sh:minCount 1 ] ;
    sh:property [ sh:path cd:hasStep ; sh:minCount 1 ] .

  cd:PathStepShape a sh:NodeShape ;
    sh:targetClass cd:PathStep ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ] ;
    sh:property [ sh:path cd:usesResource ; sh:minCount 1 ] .

  cd:KeyPointShape a sh:NodeShape ;
    sh:targetClass cd:KeyPoint ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [
      sh:path [ sh:inversePath cd:hasKeyPoint ] ;
      sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:LearningResource ;
      sh:message "A KeyPoint must have exactly one owning LearningResource through cd:hasKeyPoint."
    ] .

  cd:AttributionShape a sh:NodeShape ;
    sh:targetClass cd:Attribution ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:KeyPointOwnerShape a sh:NodeShape ;
    sh:targetSubjectsOf cd:hasKeyPoint ;
    sh:class cd:LearningResource ;
    sh:property [ sh:path cd:hasKeyPoint ; sh:minCount 1 ; sh:class cd:KeyPoint ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
      sh:message "KeyPoint positions must be unique within one owning LearningResource." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasKeyPoint ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] ;
    sh:sparql [
      sh:message "A KeyPoint sequence must start at position 1." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasKeyPoint ?point .
        FILTER NOT EXISTS { $this cd:hasKeyPoint ?first . ?first cd:position 1 . }
      }"""
    ] ;
    sh:sparql [
      sh:message "KeyPoint positions must be contiguous within one owning LearningResource." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasKeyPoint ?point .
        ?point cd:position ?position .
        FILTER (?position > 1)
        FILTER NOT EXISTS {
          $this cd:hasKeyPoint ?previous .
          ?previous cd:position ?previousPosition .
          FILTER (?previousPosition = ?position - 1)
        }
      }"""
    ] .

  cd:ChartDefinitionShape a sh:NodeShape ;
    sh:targetClass cd:ChartDefinition ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path cd:chartType ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( cd:BarChart cd:LineChart ) ] ;
    sh:property [ sh:path cd:xAxisUnit ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cd:yAxisUnit ; sh:maxCount 1 ; sh:datatype xsd:string ] ;
    sh:property [ sh:path cd:hasChartAnnotation ; sh:class cd:ChartAnnotation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:xAxisLabel ; sh:minCount 1 ; sh:uniqueLang true ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:yAxisLabel ; sh:minCount 1 ; sh:uniqueLang true ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:usesDataset ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Dataset ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
      sh:message "Bar-chart observations require an authored category label." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT $this WHERE {
        $this cd:chartType cd:BarChart ; cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?observation .
        FILTER NOT EXISTS { ?observation skos:prefLabel ?label . }
      }"""
    ] ;
    sh:sparql [
      sh:message "Bar-chart observations require numeric values and positive positions." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        $this cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?observation .
        FILTER (
          NOT EXISTS {
            ?observation cd:numericValue ?value .
            FILTER (datatype(?value) = xsd:decimal)
          }
          || NOT EXISTS { ?observation cd:position ?position . FILTER (?position >= 1) }
        )
      }"""
    ] ;
    sh:sparql [
      sh:message "Line-chart observations require xsd:decimal x-values." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT $this WHERE {
        $this cd:chartType cd:LineChart ; cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?observation .
        FILTER NOT EXISTS {
          ?observation cd:xValue ?x .
          FILTER (datatype(?x) = xsd:decimal)
        }
      }"""
    ] ;
    sh:sparql [
      sh:message "Line-chart x-values must be strictly increasing in observation order." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:chartType cd:LineChart ; cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?left, ?right .
        ?left cd:position ?leftPosition ; cd:xValue ?leftX .
        ?right cd:position ?rightPosition ; cd:xValue ?rightX .
        FILTER (?leftPosition < ?rightPosition && ?leftX >= ?rightX)
      }"""
    ] ;
    sh:sparql [
      sh:message "Bar-chart observation positions must be unique." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] ;
    sh:sparql [
      sh:message "Bar-chart observation positions must start at 1 and be contiguous." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:usesDataset ?dataset .
        ?dataset cd:hasObservation ?observation .
        {
          FILTER NOT EXISTS { ?dataset cd:hasObservation ?first . ?first cd:position 1 . }
        }
        UNION
        {
          ?observation cd:position ?position .
          FILTER (?position > 1)
          FILTER NOT EXISTS {
            ?dataset cd:hasObservation ?previous .
            ?previous cd:position ?previousPosition .
            FILTER (?previousPosition = ?position - 1)
          }
        }
      }"""
    ] .

  cd:FlowDiagramShape a sh:NodeShape ;
    sh:targetClass cd:FlowDiagram ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path cd:hasDiagramNode ; sh:minCount 2 ; sh:class cd:DiagramNode ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:hasDiagramEdge ; sh:minCount 1 ; sh:class cd:DiagramEdge ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:hasDiagramGroup ; sh:class cd:DiagramGroup ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:hasDiagramState ; sh:class cd:DiagramState ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:focusNode ; sh:maxCount 1 ; sh:class cd:DiagramNode ; sh:nodeKind sh:IRI ] ;
    sh:sparql [
      sh:message "FlowDiagram focusNode must belong to the diagram's own node set." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:focusNode ?focus .
        FILTER NOT EXISTS { $this cd:hasDiagramNode ?focus . }
      }"""
    ] ;
    sh:sparql [
      sh:message "SharedEdgeAnnotation edges must belong to the owning FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
  $this cd:hasDiagramState/cd:hasSharedEdgeAnnotation ?annotation .
  ?annotation cd:annotatesDiagramEdge ?edge .
  FILTER NOT EXISTS { $this cd:hasDiagramEdge ?edge . }
}"""
    ] ;
    sh:sparql [
      sh:message "DiagramNode group membership must belong to the owning FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramNode ?node .
        ?node cd:memberOfDiagramGroup ?group .
        FILTER NOT EXISTS { $this cd:hasDiagramGroup ?group . }
      }"""
    ] ;
    sh:sparql [
      sh:message "Every DiagramEdge endpoint must belong to the owning FlowDiagram node set." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramEdge ?edge .
        {
          ?edge cd:sourceNode ?node .
          FILTER NOT EXISTS { $this cd:hasDiagramNode ?node . }
        }
        UNION
        {
          ?edge cd:targetNode ?node .
          FILTER NOT EXISTS { $this cd:hasDiagramNode ?node . }
        }
      }"""
    ] ;
    sh:sparql [
      sh:message "DiagramNode positions must be unique within one FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramNode ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] ;
    sh:sparql [
      sh:message "A FlowDiagram node sequence must start at position 1." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramNode ?node .
        FILTER NOT EXISTS { $this cd:hasDiagramNode ?first . ?first cd:position 1 . }
      }"""
    ] ;
    sh:sparql [
      sh:message "DiagramNode positions must be contiguous within one FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramNode ?node .
        ?node cd:position ?position .
        FILTER (?position > 1)
        FILTER NOT EXISTS {
          $this cd:hasDiagramNode ?previous .
          ?previous cd:position ?previousPosition .
          FILTER (?previousPosition = ?position - 1)
        }
      }"""
    ] ;
    sh:sparql [
      sh:message "DiagramEdge positions must be unique within one FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramEdge ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] ;
    sh:sparql [
      sh:message "A FlowDiagram edge sequence must start at position 1." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramEdge ?edge .
        FILTER NOT EXISTS { $this cd:hasDiagramEdge ?first . ?first cd:position 1 . }
      }"""
    ] ;
    sh:sparql [
      sh:message "DiagramEdge positions must be contiguous within one FlowDiagram." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasDiagramEdge ?edge .
        ?edge cd:position ?position .
        FILTER (?position > 1)
        FILTER NOT EXISTS {
          $this cd:hasDiagramEdge ?previous .
          ?previous cd:position ?previousPosition .
          FILTER (?previousPosition = ?position - 1)
        }
      }"""
    ] .

  cd:DiagramStateShape a sh:NodeShape ;
    sh:targetClass cd:DiagramState ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path [ sh:inversePath cd:hasDiagramState ] ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:FlowDiagram ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:hasSharedEdgeAnnotation ; sh:class cd:SharedEdgeAnnotation ; sh:nodeKind sh:IRI ] .

  cd:SharedEdgeAnnotationShape a sh:NodeShape ;
    sh:targetClass cd:SharedEdgeAnnotation ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:annotatesDiagramEdge ; sh:minCount 2 ; sh:class cd:DiagramEdge ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:DiagramNodeShape a sh:NodeShape ;
    sh:targetClass cd:DiagramNode ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:visualRole ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:property [ sh:path cd:memberOfDiagramGroup ; sh:class cd:DiagramGroup ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:DiagramGroupShape a sh:NodeShape ;
    sh:targetClass cd:DiagramGroup ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:DiagramEdgeShape a sh:NodeShape ;
    sh:targetClass cd:DiagramEdge ;
    sh:property [ sh:path skos:prefLabel ; sh:minCount 1 ; sh:uniqueLang true ] ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:visualRole ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:pattern "^[a-z][a-z0-9-]*$" ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] ;
    sh:property [ sh:path cd:sourceNode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:DiagramNode ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:targetNode ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:DiagramNode ; sh:nodeKind sh:IRI ] .

  cd:ChartPointAnnotationShape a sh:NodeShape ;
    sh:targetClass cd:ChartPointAnnotation ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:targetObservation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Observation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:ChartRangeAnnotationShape a sh:NodeShape ;
    sh:targetClass cd:ChartRangeAnnotation ;
    sh:property [ sh:path cd:body ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype rdf:langString ] ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:startObservation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Observation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:endObservation ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Observation ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:authoredResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:hasValue true ] .

  cd:ChartAnnotationOwnerShape a sh:NodeShape ;
    sh:targetSubjectsOf cd:hasChartAnnotation ;
    sh:class cd:ChartDefinition ;
    sh:sparql [
      sh:message "Chart annotations must target observations from the chart's own dataset." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:usesDataset ?dataset ; cd:hasChartAnnotation ?annotation .
        {
          ?annotation cd:targetObservation ?observation .
          FILTER NOT EXISTS { ?dataset cd:hasObservation ?observation . }
        }
        UNION
        {
          ?annotation cd:startObservation ?observation .
          FILTER NOT EXISTS { ?dataset cd:hasObservation ?observation . }
        }
        UNION
        {
          ?annotation cd:endObservation ?observation .
          FILTER NOT EXISTS { ?dataset cd:hasObservation ?observation . }
        }
      }"""
    ] ;
    sh:sparql [
      sh:message "Chart annotation positions must be unique." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasChartAnnotation ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] .

  cd:SceneDefinitionShape a sh:NodeShape ;
    sh:targetClass cd:SceneDefinition ;
    sh:property [ sh:path cd:focusConcept ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Concept ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:hasSceneItem ; sh:minCount 1 ; sh:class cd:SceneItem ; sh:nodeKind sh:IRI ] ;
    sh:property [ sh:path cd:presentationPattern ; sh:maxCount 1 ; sh:in ( cd:DefinitionWithCitation ) ] ;
    sh:sparql [
      sh:message "Scene item positions must be unique within a scene." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:hasSceneItem ?left, ?right .
        ?left cd:position ?position .
        ?right cd:position ?position .
        FILTER (?left != ?right)
      }"""
    ] .

  cd:SceneItemShape a sh:NodeShape ;
    sh:targetClass cd:SceneItem ;
    sh:property [ sh:path cd:position ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:integer ; sh:minExclusive 0 ] ;
    sh:property [ sh:path cd:selectsResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:nodeKind sh:IRI ; sh:or ( [ sh:class cd:Concept ] [ sh:class cd:LearningResource ] [ sh:class cd:Source ] ) ] ;
    sh:property [ sh:path ( cd:selectsResource cd:authoredResource ) ; sh:hasValue true ; sh:message "A selected resource must carry explicit authored-resource evidence." ] ;
    sh:property [ sh:path cd:communicativeRole ; sh:minCount 1 ; sh:maxCount 1 ; sh:in ( cd:HeadingRole cd:QuotationRole cd:CitationRole cd:CodeRole cd:PollRole cd:StatementRole cd:ExampleRole cd:ExerciseRole cd:FormulaRole cd:KeyPointRole cd:AttributionRole cd:DiagramRole cd:ChartRole ) ] ;
    sh:property [ sh:path cd:selectionPath ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ; sh:in ( "skos:prefLabel@de" "skos:prefLabel@en" "cd:hasDefinition" "cd:hasDefinition/cd:hasSource" "cd:hasCodeExample" "cd:hasAudiencePoll" "cd:body" "cd:latex" "cd:hasKeyPoint" ) ] ;
    sh:sparql [
      sh:message "KeyPointRole requires exactly the cd:hasKeyPoint selector." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:KeyPointRole ; cd:selectionPath ?selector .
        FILTER (?selector != "cd:hasKeyPoint")
      }"""
    ] ;
    sh:sparql [
      sh:message "The cd:hasKeyPoint selector requires KeyPointRole." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:selectionPath "cd:hasKeyPoint" ; cd:communicativeRole ?role .
        FILTER (?role != cd:KeyPointRole)
      }"""
    ] ;
    sh:sparql [
      sh:message "KeyPointRole must select a LearningResource with one or more linked KeyPoints." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:KeyPointRole ; cd:selectsResource ?source .
        FILTER NOT EXISTS { ?source cd:hasKeyPoint ?point . ?point a cd:KeyPoint . }
      }"""
    ] ;
    sh:sparql [
      sh:message "AttributionRole requires exactly the cd:body selector." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:AttributionRole ; cd:selectionPath ?selector .
        FILTER (?selector != "cd:body")
      }"""
    ] ;
    sh:sparql [
      sh:message "AttributionRole must select an Attribution resource." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:AttributionRole ; cd:selectsResource ?source .
        FILTER NOT EXISTS { ?source a cd:Attribution . }
      }"""
    ] ;
    sh:sparql [
      sh:message "An Attribution selected by a scene item requires AttributionRole." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:selectsResource ?source ; cd:communicativeRole ?role .
        ?source a cd:Attribution .
        FILTER (?role != cd:AttributionRole)
      }"""
    ] ;
    sh:sparql [
      sh:message "ChartRole requires exactly the cd:body selector and a ChartDefinition resource." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:ChartRole ; cd:selectionPath ?selector ; cd:selectsResource ?source .
        FILTER (?selector != "cd:body" || NOT EXISTS { ?source a cd:ChartDefinition . })
      }"""
    ] ;
    sh:sparql [
      sh:message "A ChartDefinition selected by a scene item requires ChartRole." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:selectsResource ?source ; cd:communicativeRole ?role .
        ?source a cd:ChartDefinition .
        FILTER (?role != cd:ChartRole)
      }"""
    ] ;
    sh:sparql [
      sh:message "DiagramRole requires exactly the cd:body selector and a FlowDiagram resource." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:communicativeRole cd:DiagramRole ; cd:selectionPath ?selector ; cd:selectsResource ?source .
        FILTER (?selector != "cd:body" || NOT EXISTS { ?source a cd:FlowDiagram . })
      }"""
    ] ;
    sh:sparql [
      sh:message "A FlowDiagram selected by a scene item requires DiagramRole." ;
      sh:select """PREFIX cd: <https://w3id.org/project-chemie-digital/ontology/>
SELECT $this WHERE {
        $this cd:selectsResource ?source ; cd:communicativeRole ?role .
        ?source a cd:FlowDiagram .
        FILTER (?role != cd:DiagramRole)
      }"""
    ] .
}
