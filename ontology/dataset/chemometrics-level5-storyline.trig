@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-storyline> {
  ex:rev-functions-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-fun1, ex:rev-fun2, ex:rev-fun3 ; cd:authoredResource true .
  ex:rev-fun1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "PDF: probability in a volume range"@en ; cd:body "- Assume uniform volume: 9.98 to 10.02 mL.\n\n- Integrate density over the range of interest."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "supporting" ; cd:authoredResource true .
  ex:rev-fun2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "CDF: probability below a volume limit"@en ; cd:body "- What fraction lies at or below 10.01 mL?\n\n- Accumulate PDF area up to that threshold."@en ; cd:visualMotif "nonlinear-curve" ; cd:visualMotifRole "supporting" ; cd:authoredResource true .
  ex:rev-fun3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Inverse CDF: volume at a probability"@en ; cd:body "- Which volume is the 75th percentile?\n\n- Probability in, value in mL out. Assumed model, not guaranteed tolerance."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "supporting" ; cd:authoredResource true .
  ex:rev-functions-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-functions-vertical.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Three stacked diagrams of the same dimensionless Uniform(0,1) input. PDF: horizontal value, vertical density, interval area is probability. CDF: horizontal value threshold, vertical accumulated probability. Inverse CDF: horizontal probability, vertical returned value. The adjacent cards apply these operations to an assumed pipette volume model."@en ; cd:authoredResource true .
  ex:rev-df a cd:Concept ; skos:prefLabel "Degrees of freedom as independent directions after constraints"@en ; cd:hasDefinition ex:rev-df-def ; cd:authoredResource true .
  ex:rev-df-def a cd:Definition ; cd:body "Degrees of freedom count independent directions left after fitted constraints. Five deviations about an estimated mean sum to zero, leaving four independent residual directions. Distribution-specific assumptions determine how that count enters a reference law; it is not a universal sample-size-minus-one rule."@en ; cd:authoredResource true .
  ex:unit-level5-probability-models cd:hasFocusConcept ex:rev-df .
  ex:rev-chi-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-chi-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "One homogeneous nitrate control, five independent normal lab results, fit their mean, calculate squared deviations and sum them. A different five-result series gives another sample variance. Normal residual coordinates leave four independent directions; scaling by the true variance gives a chi-square reference. The goal is uncertainty in repeatability variance."@en ; cd:authoredResource true .
  ex:rev-t-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-t-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Repeat independent five-result normal laboratory series. Each produces a sample mean and sample SD. Center the mean at its population expectation. A known population standard error gives a standard normal reference; replacing it by the same series' estimated standard error gives Student-t with four degrees of freedom. Larger samples stabilize the estimated denominator and t approaches normal."@en ; cd:authoredResource true .
  ex:rev-f-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-f-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two independent methods each provide six normal control results. Each series fits its own mean and estimates variance, leaving five degrees of freedom. Divide the prespecified B variance by A variance. Under equal population variances this ratio has an F reference with numerator five and denominator five degrees of freedom. It compares precision, not accuracy."@en ; cd:authoredResource true .
  ex:rev-df-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-df-constraint.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five results 9.6, 9.8, 10.0, 10.2, 10.4 mg/L have fitted mean 10.0. Deviations are minus 0.4, minus 0.2, zero, plus 0.2 and plus 0.4. Once the first four deviations and the zero-sum constraint are specified, the fifth must be plus 0.4. Five residuals have four independent directions. This does not mean the original observations were dependent."@en ; cd:authoredResource true .
  ex:rev-df-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-df1, ex:rev-df2, ex:rev-df3 ; cd:authoredResource true .
  ex:rev-df1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "One fitted mean"@en ; cd:body "- Five normal repeats leave four residual directions.\n\n- Chi-square variance reference and one-sample t both use 4 df."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-df2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Two independent series"@en ; cd:body "- Six results per method, one fitted mean per series.\n\n- F needs two ordered counts: 5 numerator df and 5 denominator df."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-df3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Five categories, fixed total"@en ; cd:body "- Four category counts determine the fifth.\n\n- Pearson uses 4 df here, not 99. Fitting model parameters needs further justification."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-chi-data a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-chi-data1 ; cd:authoredResource true .
  ex:rev-chi-data1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "How precisely have we estimated repeatability"@en ; cd:body "Five repeats: 9.6, 9.8, 10.0, 10.2, 10.4 mg/L. Mean 10.0. We estimate variance from their squared deviations; another series would give another variance."@en ; cd:authoredResource true .
  ex:rev-chi-pivot-info a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-chi-pivot1 ; cd:authoredResource true .
  ex:rev-chi-pivot1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "What varies in repeated five-result series"@en ; cd:body "Sample variance fluctuates; true method variance is fixed. For independent normal results, their scaled ratio follows chi-square with 4 df."@en ; cd:authoredResource true .
  ex:rev-chi-interval-info a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-chi-interval1 ; cd:authoredResource true .
  ex:rev-chi-interval1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "How uncertain is our variance estimate of 0.10 (mg/L)²"@en ; cd:body "Invert the chi-square reference for a 95% variance confidence interval. Same five repeats, not a range of individual results."@en ; cd:authoredResource true .
  ex:rev-chi-pivot a cd:MathExpression ; cd:formulaLabel "Squared deviations connect our data to chi-square"@en ; cd:latex "\\begin{gathered}U=\\frac{\\sum_{i=1}^{n}(X_i-\\bar X)^2}{\\sigma^2}\\\\=\\frac{(n-1)S^2}{\\sigma^2}\\sim\\chi^2_{n-1}\\end{gathered}" ; dct:hasPart ex:rev-chi-legend ; cd:hasSymbol ex:rev-chi-values, ex:rev-chi-ops, ex:rev-chi-law ; cd:authoredResource true .
  ex:rev-chi-interval a cd:MathExpression ; cd:formulaLabel "95% confidence interval for true repeatability variance"@en ; cd:latex "\\begin{gathered}\\left[\\frac{(n-1)s^2}{q_{0.975}},\\frac{(n-1)s^2}{q_{0.025}}\\right]\\\\\\approx[0.03590,\\ 0.82573]\\;(\\mathrm{mg/L})^2\\end{gathered}" ; dct:hasPart ex:al-chi-legend ; cd:hasSymbol ex:al-chi-data, ex:al-chi-quantiles, ex:al-chi-ops ; cd:authoredResource true .
  ex:rev-chi-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-chi-legend1 ; cd:authoredResource true .
  ex:rev-chi-legend1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Variance reference and assumptions"@en ; dct:references ex:rev-chi-values, ex:rev-chi-ops, ex:rev-chi-law ; cd:authoredResource true .
  ex:rev-chi-values a cd:MathSymbol ; cd:symbol "results and spread" ; cd:mathNotation "X_i,\\bar X,S^2,\\sigma^2" ; cd:body "X indexed by i: normal results in mg/L; bar X: sample mean. S squared: random sample variance; sigma squared: fixed positive true variance, both in (mg/L) squared. Uppercase quantities vary across series."@en ; cd:authoredResource true .
  ex:rev-chi-ops a cd:MathSymbol ; cd:symbol "residual sum" ; cd:mathNotation "\\sum,i,n,-,{}^2,/" ; cd:body "Sum indexed deviations from i=1 to n=5, square and divide by true variance. Minus subtracts; juxtaposition multiplies. Estimating one mean leaves n-1=4 independent normal residual coordinates, not independent raw centered residuals."@en ; cd:authoredResource true .
  ex:rev-chi-law a cd:MathSymbol ; cd:symbol "reference law" ; cd:mathNotation "U,=,\\sim,\\chi^2_{n-1}" ; cd:body "U is dimensionless scaled variance; equality rewrites the same statistic; tilde means distributed as chi-square, subscript degrees of freedom. The exact law requires independent identically normal results, not just five numbers."@en ; cd:authoredResource true .
  ex:rev-t-known a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-t-known1 ; cd:authoredResource true .
  ex:rev-t-known1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "What if the true method SD were known"@en ; cd:body "Across normal five-result series, means are normal. Subtract the true mean and divide by the known SD of the mean: the standardized mean is standard normal, even for a small sample."@en ; cd:authoredResource true .
  ex:rev-t-est a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-t-est1 ; cd:authoredResource true .
  ex:rev-t-est1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "But our five repeats estimate their own SD"@en ; cd:body "Replacing known population SD by sample SD changes the standardized mean to Student-t with 4 df. The mean itself has not become t-distributed; the denominator is now estimated."@en ; cd:authoredResource true .
  ex:rev-t-limit a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-t-limit1 ; cd:authoredResource true .
  ex:rev-t-limit1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Why more degrees of freedom bring t closer to normal"@en ; cd:body "Larger normal samples estimate SD more stably. The extra tail probability decreases: t approaches standard normal as df grows without bound. No finite df is exactly normal; 30 is not a universal rule."@en ; cd:authoredResource true .
  ex:rev-t-ci a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-t-ci1 ; cd:authoredResource true .
  ex:rev-t-ci1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "How uncertain is the same five-result mean"@en ; cd:body "Mean 10.0 mg/L; sample SD 0.31623 mg/L; estimated SE 0.14142 mg/L. Use the t quantile with 4 df to report a confidence interval for the analytical mean, not for individual results."@en ; cd:authoredResource true .
  ex:rev-f-data a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-f-data1, ex:rev-f-data2, ex:rev-f-data3 ; cd:authoredResource true .
  ex:rev-f-data1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Method A: six results (mg/L)"@en ; cd:body "- 9.7, 9.9, 10.0, 10.0, 10.1, 10.3.\n\n- Mean 10.0; variance 0.04 (mg/L)²."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-f-data2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Method B: six results (mg/L)"@en ; cd:body "- 9.4, 9.8, 10.0, 10.0, 10.2, 10.6.\n\n- Mean 10.0; variance 0.16 (mg/L)²."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-f-data3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Is B less precise than A"@en ; cd:body "- Prespecify B over A; independent normal series.\n\n- Ratio 4. Compare with F(5,5) under equal true variances. These constructed values do not establish the assumptions."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-f-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-f-context1 ; cd:authoredResource true .
  ex:rev-f-result a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-f-result1 ; cd:authoredResource true .
  ex:rev-f-result1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Return to our two six-result methods"@en ; cd:body "Variance ratio B over A: 4. Compare with the one-sided 5% cutoff for 5 numerator and 5 denominator df. A large observed ratio does not alone establish a precision difference."@en ; cd:authoredResource true .
  ex:rev-f-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Does a ratio of 4 exceed expected variance-estimation variation"@en ; cd:body "The two six-result series each leave 5 df. Under equal true variances, their unknown common variance cancels from the ordered sample-variance ratio. This tests precision, not bias or accuracy."@en ; cd:authoredResource true .
  ex:rev-check-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-check1, ex:rev-check2, ex:rev-check3 ; cd:authoredResource true .
  ex:rev-check1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "First inspect: normal Q-Q plot"@en ; cd:body "- Pair sorted data with theoretical normal quantiles.\n\n- A near-straight pattern supports the shape; bends or isolated extremes flag departures."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-check2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Then compare: KS"@en ; cd:body "- Overlay ECDF and a specified continuous CDF.\n\n- Find the largest vertical gap and compare with the correctly calibrated critical value."@en ; cd:visualMotif "nonlinear-curve" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-check3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "For grouped counts: Pearson"@en ; cd:body "- Compare observed and expected category counts.\n\n- Sum weighted squared discrepancies; use a chi-square reference with the correct df."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
}
