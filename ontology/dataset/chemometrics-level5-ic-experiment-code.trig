@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-experiment-code> {
  ex:ix-simulation a cd:CodeExample ; skos:prefLabel "Repeat complete normal measurement series"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:al-chi-square ; cd:code """# Hypothetical stable method. No field or validation data.
# First change M: 100, 1000, 10000. Later change n: 6, 30.
M <- 100; n <- 6; sigma <- 0.10; mu <- 10
stopifnot(M %in% c(100, 1000, 10000), n >= 2, n <= 100,
          n == as.integer(n), sigma > 0)
state <- 20261101
S2 <- numeric(M)
first <- numeric(n)
for (j in seq_len(M)) {
  x <- numeric(n)
  for (i in seq_len(n)) {
    state <- (16807 * state) %% 2147483647
    x[i] <- mu + sigma * qnorm(state / 2147483647)
  }
  if (j == 1) first <- x
  S2[j] <- sum((x - mean(x))^2) / (n - 1)
}
cat('First series (mg/L):', format(first, digits=8), '\\n')
cat('M:', M, 'n:', n, 'df:', n-1, '\\n')
cat('Mean sample variance:', mean(S2), '(mg/L)^2\\n')
cat('Relative SD, empirical:', sd(S2)/mean(S2),
    'theoretical:', sqrt(2/(n-1)), '\\n')
cat('Count at least observed variance 0.024:', sum(S2 >= 0.024), '\\n')
old <- par(mfrow=c(1,2), mar=c(5,4,3,1))
plot(seq_len(M), S2, pch=16, cex=0.35, col='#176b90',
     xlab='Independent series number', ylab='Sample variance ((mg/L)^2)',
     main=paste(M, 'complete series'), ylim=c(0,max(0.064,S2)))
abline(h=sigma^2, col='#a63d21', lty=2)
breaks <- seq(0, max(0.064, ceiling(max(S2)/0.002)*0.002), by=0.002)
hist(S2, breaks=breaks, right=FALSE, probability=TRUE, col='#8ecae6',
     xlab='Sample variance ((mg/L)^2)', ylab='Density per (mg/L)^2',
     main=paste('n =', n), xlim=c(0,max(breaks)))
abline(v=0.024, col='#a63d21', lwd=2)
par(old)
""" ; cd:authoredResource true .
  ex:ix-repeat-task a cd:Exercise ; cd:body "Optional instructor demonstration: run with 100 complete series, then 1,000 and 10,000. Keep six readings per series and true SD 0.10 mg/L. Each point is one estimated variance, not one nitrate result. Compare points with histogram bars. More series stabilize the picture; they do not make a six-reading variance estimate more reliable. The following saved 10,000-series histogram is available without running R."@en ; cd:authoredResource true .
  ex:ix-size-task a cd:Exercise ; cd:body "Optional instructor demonstration: set M to 10,000 and compare n=6 with n=30. Keep true SD 0.10 mg/L. Use the same variance-axis units and compare the printed empirical relative SD with 63.2% and 26.3%. More readings per series narrow the distribution of the estimate. More simulated series only improve the Monte Carlo picture. Static theoretical values on the preceding slide remain usable without R."@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-ic-experiment-code> {
  ex:ix-repeat-live a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-repeat-h, ex:ix-repeat-p, ex:ix-repeat-code ; cd:narration "Run only if useful for the class. The TriG-authored R code creates fresh independent normal measurements for each complete series and estimates its own mean. The deterministic Park-Miller stream is reset on each execution, so increasing M extends the same experiment. There is no chi-square formula or theoretical chi-square overlay yet. First inspect points, then the histogram. The saved reference on the next slide has exactly the same 10,000-series default n-six protocol. Do not claim a live execution when showing its fallback."@en ; cd:authoredResource true .
  ex:ix-repeat-title a cd:Interpretation ; skos:prefLabel "100, 1,000, 10,000 series: the variance itself varies"@en ; cd:authoredResource true .
  ex:ix-repeat-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-repeat-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-repeat-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-repeat-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-repeat-code a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-simulation ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-live a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-size-live-h, ex:ix-size-live-p, ex:ix-size-live-code ; cd:narration "Reuse the experiment, now changing readings per series rather than the count of simulated series. Compare n six and thirty with ten thousand series each. The generator is reset for reproducibility, not to create a paired experimental design. Independent new series remain the model. Compare physical sample-variance axes and theoretical relative uncertainty, not raw Q values across different df. Browser R is optional; preceding theoretical values are the noninteractive fallback."@en ; cd:authoredResource true .
  ex:ix-size-live-title a cd:Interpretation ; skos:prefLabel "Change the number of readings, not the method precision"@en ; cd:authoredResource true .
  ex:ix-size-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-size-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-live-p a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-size-task ; cd:communicativeRole cd:ExerciseRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-live-code a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-simulation ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
}
