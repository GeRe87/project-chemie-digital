@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/scenes/level5-model-check-story> {
  ex:rev-check-start a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-check-start-h, ex:rev-check-start-c ; cd:narration "Separate visual diagnosis from a calibrated decision. Start with Q-Q plots to see where data and normal quantiles differ. Then use the same two small constructed samples to overlay ECDF and a fixed model CDF for KS. Finally use a different grouped particle-count study for Pearson, with expected counts from prespecified probabilities. Every formal decision needs a stated null, sampling assumptions, significance level and correctly calibrated cutoff. A non-rejected example is compatible evidence, not proof of a normal population. A rejected example does not identify a unique alternative. The two critical-value tables will show how row, tail probability and function convention connect to each decision."@en ; cd:authoredResource true .
  ex:rev-check-start-title a cd:Interpretation ; skos:prefLabel "Check a model: inspect the pattern, then calibrate a test"@en ; cd:authoredResource true .
  ex:rev-check-start-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-check-start-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-check-start-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-check-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-build a cd:SceneDefinition ; cd:focusConcept ex:rev-qq ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-qq-build-h, ex:rev-qq-build-c, ex:rev-qq-build-f ; cd:narration "Use the two displayed constructed samples and keep one normal model fixed beforehand, mean 10 and SD 0.50 mg/L. Sort each sample. For n five use midpoint plotting probabilities 0.1, 0.3, 0.5, 0.7 and 0.9. Invert the normal CDF at each to get theoretical concentration quantiles 9.3592, 9.7378, 10.0, 10.2622 and 10.6408 mg/L. Plot theoretical quantile horizontally and observed ordered result vertically. No ECDF standardization is required. For this fixed location-scale model, agreement is near the identity line. If instead one fits a line with freely adjusted intercept and slope, the question becomes primarily shape compatibility; a straight but displaced line can still reject the particular fixed model."@en ; cd:authoredResource true .
  ex:rev-qq-build-title a cd:Interpretation ; skos:prefLabel "Build a normal Q-Q plot from sorted analytical results"@en ; cd:authoredResource true .
  ex:rev-qq-build-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-qq-build-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-build-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-qq-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-build-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-qq-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-read a cd:SceneDefinition ; cd:focusConcept ex:rev-qq ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-qq-read-h, ex:rev-qq-read-c, ex:rev-qq-read-v ; cd:narration "These panels keep identical concentration axes and identical normal quantiles. Sample A closely follows the identity line. Sample B has four almost equal concentrations and one extreme high value, producing a pronounced bend. This is a deliberately skewed teaching alternative, not a random sample whose population distribution we have proved. A near-straight pattern gives descriptive support for shape; systematic curvature, clusters or isolated extremes identify things to investigate. Q-Q plots are particularly useful for seeing tail behavior but five observations provide little detail. Next keep both samples unchanged and compare their cumulative functions, so the visual checks and numerical test have a shared story."@en ; cd:authoredResource true .
  ex:rev-qq-read-title a cd:Interpretation ; skos:prefLabel "Q-Q comparison: near the line versus a clear bend"@en ; cd:authoredResource true .
  ex:rev-qq-read-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-qq-read-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-read-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-qq-reading ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-qq-read-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-qq-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-overlay a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-ks-overlay-h, ex:rev-ks-overlay-v, ex:rev-ks-overlay-c, ex:rev-ks-overlay-f ; cd:narration "Keep the same A and B values used in the Q-Q comparison. The empirical CDF jumps by one fifth at each value; the model CDF is the smooth fixed normal reference. Overlay them on the same mg/L horizontal axis and probability vertical axis. The KS statistic is their greatest absolute vertical distance over all thresholds. Check both the left limit and the included value at every jump. For A the maximum is 0.144578. For B it is 0.725747 immediately before its first observation, 10.3 mg/L: the empirical fraction is still zero while the model CDF is already 0.725747. A horizontal distance would be a concentration difference, not the KS statistic. The numerical computation uses the analytic CDF, not the finite drawing grid. We next discuss optional coordinate changes before reading the rejection table."@en ; cd:authoredResource true .
  ex:rev-ks-overlay-title a cd:Interpretation ; skos:prefLabel "KS: overlay ECDF and CDF, find the largest vertical gap"@en ; cd:authoredResource true .
  ex:rev-ks-overlay-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-ks-overlay-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-overlay-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-ks-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-overlay-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-ks-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-overlay-f a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l5-g19b-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-scale a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-ks-scale-h, ex:rev-ks-scale-c ; cd:narration "The ECDF is already a cumulative fraction between zero and one. Standardization, when used, transforms the observation axis, not its probabilities. We may compare directly in mg/L, or transform every observation using the fixed mean 10 and SD 0.50 and compare with a standard-normal CDF. That fixed increasing coordinate change preserves all vertical gaps and the KS distance. If we instead estimate mean and SD from the same sample, the reference follows the data and the distribution of the maximum gap changes. Classical fixed-CDF cutoffs cannot then be used unchanged. A suitable Lilliefors calibration for fitted normality or a parametric bootstrap refitting parameters in each replicate addresses that different procedure. Ties, censoring and dependence also require matching calibration."@en ; cd:authoredResource true .
  ex:rev-ks-scale-title a cd:Interpretation ; skos:prefLabel "KS needs a common scale, not compulsory standardization"@en ; cd:authoredResource true .
  ex:rev-ks-scale-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-ks-scale-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-scale-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-ks-scale-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-table-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-ks-table-h, ex:rev-ks-table-t, ex:rev-ks-table-c, ex:rev-ks-table-code ; cd:narration "First identify the table: exact finite-sample, two-sided one-sample KS for a fully specified continuous null and iid observations. Choose row n five and upper-tail significance column 0.05: cutoff 0.563275. The displayed base-R function computes the exact finite-sum upper tail in the region above one half; uniroot finds where it equals the chosen alpha. Its inputs n and a denote sample size and significance level; k indexes the finite sum and d is candidate distance. The restricted bracket is valid for these displayed table entries, not a general-purpose small-distance KS implementation. This is a displayed software reference, not an interactive cell. Reject above the cutoff: A's 0.144578 is below, so do not reject; B's 0.725747 is above, so reject the fixed normal model. Non-rejection with five observations is not proof of normality. Some tables use cumulative rather than upper-tail probabilities; read the heading. The large-sample 1.36-over-root-n shortcut is not the exact n-five value."@en ; cd:authoredResource true .
  ex:rev-ks-table-title a cd:Interpretation ; skos:prefLabel "KS cutoff: row n=5, upper-tail 5%"@en ; cd:authoredResource true .
  ex:rev-ks-table-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-ks-table-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-table-t a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-ks-table ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-table-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-ks-lookup ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-ks-table-code a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:rev-ks-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .

  ex:rev-pearson-start a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-pearson-start-h, ex:rev-pearson-start-v, ex:rev-pearson-start-c, ex:rev-pearson-start-f ; cd:narration "This is a new grouped study, not our five KS readings and not the repeatability-variance problem. One hundred particles are independently classified into five fixed exhaustive diameter bands with probabilities specified before the data. Expected counts are total times each probability: ten, twenty, forty, twenty and ten. Observed counts are four, twelve, forty-four, twenty-four and sixteen. Both totals are one hundred. We ask whether these category proportions are plausible, not whether these large-diameter categories follow the earlier lognormal size model. All categories including both tails are retained, with lower boundaries included. No parameters are fitted from the counts. The next slide adds their weighted discrepancies."@en ; cd:authoredResource true .
  ex:rev-pearson-start-title a cd:Interpretation ; skos:prefLabel "Pearson: do 100 particle counts match five stated proportions"@en ; cd:authoredResource true .
  ex:rev-pearson-start-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-pearson-start-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-start-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-start-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-pearson-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-start-f a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l5-p20a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-sum a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-pearson-sum-h, ex:rev-pearson-sum-v, ex:rev-pearson-sum-c, ex:rev-pearson-sum-f ; cd:narration "For each category subtract expected from observed, square, then divide by the expected count. The first class gives thirty-six divided by ten, or 3.6. The five contributions are 3.6, 3.2, 0.4, 0.8 and 3.6, summing to 11.6. A large observed count does not automatically make a large discrepancy. Under a fixed multinomial total, one of the five count directions is constrained, leaving four df. With adequate expectations and iid sampling the statistic has an approximate chi-square-four reference. This count result is asymptotic, unlike the exact chi-square scaled-variance law for normal repeats. Next read the upper-tail cutoff from the table and reproduce it with a function."@en ; cd:authoredResource true .
  ex:rev-pearson-sum-title a cd:Interpretation ; skos:prefLabel "Add the five weighted count discrepancies"@en ; cd:authoredResource true .
  ex:rev-pearson-sum-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-pearson-sum-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-sum-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-p20b-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-sum-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-pearson-calc ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-sum-f a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l5-p20b-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-table-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-pearson-table-h, ex:rev-pearson-table-t, ex:rev-pearson-table-c, ex:rev-pearson-table-code ; cd:narration "This table labels upper-tail probabilities. Choose four degrees of freedom, not one hundred minus one. Read the 0.05 column: 9.487729. The base-R inverse CDF qchisq takes cumulative 0.95 and df four to return that same critical value. Observed Q of 11.6 is larger, so reject these proportions at the prespecified five-percent level under the chi-square approximation. The reference upper-tail probability from pchisq is about 0.020587. This p value is not the probability the null is false. Adequate expected counts and fixed categories support the approximation; fitted probabilities, sparse expectations or dependence can require a different calibration. The function is exact for the reference chi-square law, not an exact finite-sample multinomial test."@en ; cd:authoredResource true .
  ex:rev-pearson-table-title a cd:Interpretation ; skos:prefLabel "Pearson decision: read 4 df and the 5% column"@en ; cd:authoredResource true .
  ex:rev-pearson-table-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-pearson-table-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-table-t a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-chi-table ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-table-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rev-pearson-lookup ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-table-code a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:rev-pearson-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-pair a cd:SceneDefinition ; cd:focusConcept ex:l5-pearson-gof ; dct:subject ex:l5-topic-tests ; cd:hasSceneItem ex:rev-pearson-pair-h, ex:rev-pearson-pair-c ; cd:narration "Compare two constructed count outcomes with the same expected counts ten, twenty, forty, twenty and ten. Compatible counts nine, twenty-one, thirty-nine, twenty-one and ten give contributions 0.1, 0.05, 0.025, 0.05 and zero, totaling 0.225. The departing counts give 11.6. Both use four df and the same upper five-percent cutoff 9.487729. Do not reject the first; reject the second under the approximation. Neither outcome proves a population model or identifies the cause of departures. These examples compare categorical probabilities; do not confuse them with testing raw diameters for normality. Keep category definitions, sampling assumptions and fitting rules in the report."@en ; cd:authoredResource true .
  ex:rev-pearson-pair-title a cd:Interpretation ; skos:prefLabel "Same expected proportions: compatible and departing counts"@en ; cd:authoredResource true .
  ex:rev-pearson-pair-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rev-pearson-pair-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rev-pearson-pair-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rev-pearson-compare ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
