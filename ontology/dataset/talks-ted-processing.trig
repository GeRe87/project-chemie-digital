  ex:ted-process-import a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Import"@en ; cd:body "Shimadzu GQD files"@en ; cd:visualMotif "data-import" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-data-processing ; cd:authoredResource true .
  ex:ted-process-peaks a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Find peaks"@en ; cd:body "qPeaks: scan each EIC at multiple window sizes"@en ; cd:visualMotif "peak-search" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-qpeaks ; cd:authoredResource true .
  ex:ted-process-components a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Form components"@en ; cd:body "Joint fit: shared shape, individual heights"@en ; cd:visualMotif "shared-peak-shape" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-peak-components ; cd:authoredResource true .
  ex:ted-process-markers a cd:DiagramNode ; cd:position 4 ; skos:prefLabel "Select markers"@en ; cd:body "Choose polymer marker components"@en ; cd:visualMotif "marker-selection" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-polymer-markers ; cd:authoredResource true .
  ex:ted-process-calibration a cd:DiagramNode ; cd:position 5 ; skos:prefLabel "Calibrate"@en ; cd:body "External calibration to polymer content"@en ; cd:visualMotif "regression" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-running-calibration ; cd:authoredResource true .
  ex:ted-process-edge1 a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:ted-process-import ; cd:targetNode ex:ted-process-peaks ; skos:prefLabel "EICs"@en ; cd:authoredResource true .
