<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-processing> {
  ex:ted-scene-processing a cd:SceneDefinition ; cd:focusConcept ex:ted-data-processing ; cd:hasSceneItem ex:ted-processing-heading, ex:ted-processing-visual ;
    cd:narration "A static overview of the author's processing workflow. Import Shimadzu GQD files. qPeaks repeatedly scans each extracted-ion chromatogram with different regression-window sizes to detect and describe features. Parallel peak fitting groups features with the same elution profile into components: a shared shape, with individual channel heights. Select polymer marker components, then apply external calibration. The thumbnails are schematic, not measurements. Model details and the author's reported seconds-scale processing are retained in the linked knowledge definitions, not displayed as formulas or benchmark claims here. A fitted component is not automatically a chemically identified substance."@en ; cd:authoredResource true .
  ex:ted-processing-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-data-processing ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-processing-visual a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-processing-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
}
