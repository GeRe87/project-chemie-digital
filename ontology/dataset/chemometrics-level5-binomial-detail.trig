@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/mathematics/level5-binomial-coefficient> {
  ex:l5-binomial-formula cd:hasDerivationDetail ex:l5-choose-detail .
  ex:l5-choose-detail a cd:MathematicalDerivation ; skos:prefLabel "Meaning of n choose k"@en ; cd:inputFormula ex:l5-choose-general ; cd:resultFormula ex:l5-choose-result ; cd:hasDerivationStep ex:l5-choose-step1, ex:l5-choose-step2 ; cd:authoredResource true .

  ex:l5-choose-general a cd:MathExpression ; cd:formulaLabel "Choose k distinct positions from n, without order"@en ; cd:latex "\\binom{n}{k}=\\frac{n!}{k!(n-k)!}" ; dct:hasPart ex:l5-choose-legend ; cd:hasSymbol ex:l5-choose-symbol, ex:l5-choose-n, ex:l5-choose-k, ex:l5-choose-factorial, ex:l5-choose-operators ; cd:authoredResource true .
  ex:l5-choose-example a cd:MathExpression ; cd:formulaLabel "Example: choose two positive positions among ten"@en ; cd:latex "\\binom{10}{2}=\\frac{10!}{2!\\,8!}" ; dct:hasPart ex:l5-choose-legend ; cd:hasSymbol ex:l5-choose-symbol, ex:l5-choose-factorial, ex:l5-choose-operators ; cd:authoredResource true .
  ex:l5-choose-result a cd:MathExpression ; cd:formulaLabel "45 different arrangements, not a probability"@en ; cd:latex "\\binom{10}{2}=\\frac{10\\cdot9}{2\\cdot1}=45" ; dct:hasPart ex:l5-choose-legend ; cd:hasSymbol ex:l5-choose-symbol, ex:l5-choose-operators ; cd:authoredResource true .

  ex:l5-choose-rule a cd:MathematicalRule ; skos:prefLabel "Count unordered selections"@en ; cd:ruleFormula ex:l5-choose-general ; cd:body "For whole numbers n at least zero and k between zero and n, count selections of k distinct positions, without replacement and without regard to selection order. First count ordered selections, then divide by the k! orders of each selected set. No independence or probability assumption is needed for this counting identity."@en ; cd:authoredResource true .
  ex:l5-choose-arithmetic a cd:MathematicalRule ; skos:prefLabel "Expand factorials and cancel common factors"@en ; cd:ruleFormula ex:l5-choose-result ; cd:body "Expand the factorial products. The common factor 8! is positive, so it cancels from numerator and denominator. Divide the remaining product by 2! to avoid counting each pair twice."@en ; cd:authoredResource true .
  ex:l5-choose-step1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Set n to 10 and k to 2"@en ; cd:fromFormula ex:l5-choose-general ; cd:toFormula ex:l5-choose-example ; cd:appliesRule ex:l5-choose-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l5-choose-explain1 ; cd:authoredResource true .
  ex:l5-choose-step2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Remove duplicate orders to obtain 45 pairs"@en ; cd:fromFormula ex:l5-choose-example ; cd:toFormula ex:l5-choose-result ; cd:appliesRule ex:l5-choose-arithmetic ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l5-choose-explain2 ; cd:authoredResource true .
  ex:l5-choose-explain1 a cd:Interpretation ; cd:applicationFormula ex:l5-choose-example ; cd:body "Read the stacked notation as n choose k, not n divided by k. We choose which trial positions are positive, not the order in which those positions are selected.\nFor ten trials and two positives, select two distinct positions; the other eight are negative. Choosing positions 2 then 7 gives the same positive-position set as choosing 7 then 2. Different positive-position sets give different binary sequences.\nIn the binomial probability formula each such sequence has the same probability under independent trials with a common success probability. The coefficient counts the sequences; it is not itself a probability."@en ; cd:authoredResource true .
  ex:l5-choose-explain2 a cd:Interpretation ; cd:applicationFormula ex:l5-choose-result ; cd:body "There are ten choices for the first position and nine for the second, giving 90 ordered pairs. Each unordered pair appears twice, so divide by two to obtain 45.\nFactorials give the same calculation: expand 10! down to 8! and cancel 8!. The denominator 2! equals two times one.\nChoosing no positions or all positions each gives exactly one selection. The convention zero factorial equals one makes the general formula valid at both boundaries, including n equal to zero. All counts and probabilities here are dimensionless; the count 45 is not 45 percent."@en ; cd:authoredResource true .
  ex:l5-choose-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l5-choose-detail ; cd:firstDerivationStep ex:l5-choose-step1 ; cd:lastDerivationStep ex:l5-choose-step2 ; cd:usesLegend ex:l5-choose-legend ; cd:authoredResource true .

  ex:l5-choose-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-choose-entry1, ex:l5-choose-entry2, ex:l5-choose-entry3, ex:l5-choose-entry4, ex:l5-choose-entry5 ; cd:authoredResource true .
  ex:l5-choose-symbol a cd:MathSymbol ; cd:symbol "binomial coefficient" ; cd:mathNotation "\\binom{n}{k}" ; cd:body "Number of unordered selections of k distinct positions from n. Read n choose k, not division; a dimensionless count, not a probability."@en ; cd:authoredResource true .
  ex:l5-choose-n a cd:MathSymbol ; cd:symbol "available positions" ; cd:mathNotation "n" ; cd:body "Total number of distinct trial positions, a nonnegative whole number; ten in this example. Not a concentration or unit."@en ; cd:authoredResource true .
  ex:l5-choose-k a cd:MathSymbol ; cd:symbol "selected positions" ; cd:mathNotation "k,\\ n-k" ; cd:body "k is the number of selected positive positions, a whole number from zero to n; two here. n minus k counts unselected negative positions, eight here. No replacement."@en ; cd:authoredResource true .
  ex:l5-choose-factorial a cd:MathSymbol ; cd:symbol "factorial" ; cd:mathNotation "!" ; cd:body "Factorial multiplies the positive whole numbers up to its argument. Thus 2! is two times one. By convention 0! equals one. Parentheses make n minus k the factorial argument."@en ; cd:authoredResource true .
  ex:l5-choose-operators a cd:MathSymbol ; cd:symbol "arithmetic and example counts" ; cd:mathNotation "=,\\ \\frac{\\ }{\\ },\\ \\cdot,\\ -" ; cd:body "Equality means the same count. A fraction bar divides; a dot or juxtaposition multiplies; minus subtracts. Parentheses group terms. The numbers 10, 2 and 8 specify available, selected and remaining positions; 9 and 1 arise in the factorial products; 45 counts selections. All are dimensionless."@en ; cd:authoredResource true .
  ex:l5-choose-entry1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "n choose k"@en ; cd:mathNotation "\\binom{n}{k}" ; cd:body "Number of unordered selections of k distinct positions from n. Not n divided by k and not a probability."@en ; dct:references ex:l5-choose-symbol ; cd:authoredResource true .
  ex:l5-choose-entry2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Available positions"@en ; cd:mathNotation "n" ; cd:body "Nonnegative whole number of distinct trial positions; ten here. All counts are dimensionless."@en ; dct:references ex:l5-choose-n ; cd:authoredResource true .
  ex:l5-choose-entry3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Selected and remaining positions"@en ; cd:mathNotation "k,\\ n-k" ; cd:body "k is a whole number from zero to n, two positives here. n minus k is eight negatives. Select distinct positions without replacement; selection order does not matter."@en ; dct:references ex:l5-choose-k ; cd:authoredResource true .
  ex:l5-choose-entry4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Factorial"@en ; cd:mathNotation "!" ; cd:body "Multiply the positive whole numbers up to the argument. 2! is two times one; 0! equals one by convention. Parentheses group the argument n minus k. Selecting none or all gives one selection."@en ; dct:references ex:l5-choose-factorial ; cd:authoredResource true .
  ex:l5-choose-entry5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "Arithmetic and counts"@en ; cd:mathNotation "=,\\ \\frac{\\ }{\\ },\\ \\cdot,\\ -" ; cd:body "Equality means the same count; a fraction divides; a dot or juxtaposition multiplies; minus subtracts. 10, 2 and 8 count available, selected and remaining positions; 9 and 1 come from factorial products. 45 is a count, not 45 percent; no physical units."@en ; dct:references ex:l5-choose-operators ; cd:authoredResource true .
}
