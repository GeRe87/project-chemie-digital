<https://w3id.org/project-chemie-digital/graph/knowledge/level5-cdf-first> {
  ex:cf-question-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-question1 ; cd:authoredResource true .
  ex:cf-question1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Predict a range, not an exact result"@en ; cd:body "Under the same stable conditions, how likely is the next reading to fall below a threshold or inside a range?"@en ; cd:authoredResource true .
  ex:cf-cdf a cd:MathExpression ; cd:formulaLabel "An observed fraction estimates an unknown probability"@en ; cd:latex "\\begin{gathered}\\widehat F_n(x)=\\frac{\\#\\{i:x_i\\le x\\}}{n}\\\\\\widehat F_{20}(10.2)=\\frac{15}{20}=0.75\\\\F(x)=P(X\\le x)\\end{gathered}" ; cd:hasSymbol ex:cf-cdf-symbols ; dct:hasPart ex:cf-cdf-legend ; cd:authoredResource true .
  ex:cf-cdf-symbols a cd:MathSymbol ; cd:symbol "data fraction versus future probability" ; cd:mathNotation "\\widehat F_n,F,X,x_i,x,n,i,\\#,\\{\\},:,\\le,P,=,/" ; cd:body "X: future result; x: threshold; x indexed by i: reading, all in mg/L. i indexes n=20 readings. Hash counts indices in braces with reading at most x, including ties; colon means such that. Divide by n. Hat F: empirical estimate; F: population CDF; P: probability. Equals defines/evaluates. CDF values are dimensionless. Observed 75% estimates, not establishes, future probability."@en ; cd:authoredResource true .
  ex:cf-cdf-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-cdf-entry ; cd:authoredResource true .
  ex:cf-cdf-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Empirical and theoretical notation"@en ; dct:references ex:cf-cdf-symbols ; cd:authoredResource true .
  ex:cf-interval a cd:MathExpression ; cd:formulaLabel "Subtract cumulative values, not density heights"@en ; cd:latex "\\begin{gathered}P(9.8<X\\le10.2)\\\\=F(10.2)-F(9.8)\\\\\\widehat F_{20}(10.2)-\\widehat F_{20}(9.8)\\\\=\\frac{15}{20}-\\frac{4}{20}=0.55\\end{gathered}" ; cd:hasSymbol ex:cf-interval-symbols ; dct:hasPart ex:cf-interval-legend ; cd:authoredResource true .
  ex:cf-interval-symbols a cd:MathSymbol ; cd:symbol "interval endpoints and estimate" ; cd:mathNotation "X,F,\\widehat F_{20},P,<,\\le,-,=,/" ; cd:body "X: future nitrate result in mg/L; 9.8 and 10.2: lower and upper thresholds in mg/L. Strict lower comparison excludes 9.8; at most includes 10.2. P: probability; F: unknown population CDF. Hat F subscript 20: empirical CDF of twenty results. Subtract the lower cumulative value from the upper; divide counts by twenty. Equality gives the identity and observed estimate. 11/20=55% estimates the interval probability, not its exact population value."@en ; cd:authoredResource true .
  ex:cf-interval-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-interval-entry ; cd:authoredResource true .
  ex:cf-interval-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Keep the lower endpoint strict"@en ; dct:references ex:cf-interval-symbols ; cd:authoredResource true .
  ex:cf-density a cd:MathExpression ; cd:formulaLabel "Normalize a bin by both sample count and width"@en ; cd:latex "h=\\frac{m/n}{\\Delta x}=\\frac{7/20}{0.20\\;\\mathrm{mg/L}}=1.75\\;\\mathrm{L/mg}" ; cd:hasSymbol ex:cf-density-symbols ; dct:hasPart ex:cf-density-legend ; cd:authoredResource true .
  ex:cf-density-symbols a cd:MathSymbol ; cd:symbol "frequency density" ; cd:mathNotation "h,m,n,\\Delta x,=,/" ; cd:body "h: histogram density height; m=7: readings in the left-closed/right-open bin from 9.90 to 10.10 mg/L; n=20: all readings; delta x=0.20 mg/L: bin width. Divide relative frequency by width. Equality evaluates the ratio. Density has inverse concentration units L/mg; height times bin width gives dimensionless area 0.35. Bin width affects height, so height alone is not a fraction."@en ; cd:authoredResource true .
  ex:cf-density-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-density-entry ; cd:authoredResource true .
  ex:cf-density-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Counts, width and units"@en ; dct:references ex:cf-density-symbols ; cd:authoredResource true .
  ex:cf-link a cd:MathExpression ; cd:formulaLabel "Two views of the same density-based model"@en ; cd:latex "\\begin{gathered}f(x)=\\frac{dF(x)}{dx}\\\\F(x)=\\int_{-\\infty}^{x}f(t)\\,dt\\end{gathered}" ; cd:hasSymbol ex:cf-link-symbols ; dct:hasPart ex:cf-link-legend ; cd:authoredResource true .
  ex:cf-link-symbols a cd:MathSymbol ; cd:symbol "density, slope and accumulated area" ; cd:mathNotation "f,F,x,t,d/dx,\\int,-\\infty,dt,=" ; cd:body "f: population PDF in L/mg; F: population CDF, dimensionless; x: concentration threshold; t: integration variable in mg/L. The derivative is the local slope of F, where it exists. Integrate f times dt from minus infinity to x to accumulate probability. Equality links the functions for an absolutely continuous distribution; the derivative identity holds almost everywhere. The step ECDF itself is not differentiated into an ordinary population PDF."@en ; cd:authoredResource true .
  ex:cf-link-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-link-entry ; cd:authoredResource true .
  ex:cf-link-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Model relationship, not an ECDF derivative"@en ; dct:references ex:cf-link-symbols ; cd:authoredResource true .
  ex:cf-model-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-cdf-first-pair.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A conceptual triangular PDF, not fitted to the twenty observations, beside its integrated quadratic CDF. Both concentration axes are in mg/L. The PDF peaks at concentration 10 with height 1.2 L/mg; its whole area is one. The CDF runs from zero to one and is steepest at concentration 10. Its ordinate is dimensionless cumulative probability, not density. Support endpoints approximately 9.17 and 10.83 mg/L. No normal distribution is assumed."@en ; cd:authoredResource true .
  ex:cf-area a cd:MathExpression ; cd:formulaLabel "Density height is not a probability"@en ; cd:latex "\\begin{gathered}f(10.0)=1.2\\;\\mathrm{L/mg}\\\\P(a\\le X\\le b)=\\int_a^b f(x)\\,dx\\\\\\int_{-\\infty}^{\\infty}f(x)\\,dx=1,\\quad P(X=10.0)=0\\end{gathered}" ; cd:hasSymbol ex:cf-area-symbols ; dct:hasPart ex:cf-area-legend ; cd:authoredResource true .
  ex:cf-area-symbols a cd:MathSymbol ; cd:symbol "height, area and exact point" ; cd:mathNotation "f,X,x,a,b,P,\\int,dx,-\\infty,\\infty,\\le,=" ; cd:body "X: idealized continuous result; x: integration variable; a and b: ordered concentration bounds, all in mg/L. f: PDF in L/mg, here with conceptual height 1.2 at 10.0 mg/L, not 120%. P denotes dimensionless probability. Integrate density times dx over the bounded interval; infinite limits cover all values. Comparisons include endpoints, each of probability zero in a density-based model. Equality states heights, interval area, normalization and zero exact-point probability."@en ; cd:authoredResource true .
  ex:cf-area-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-area-entry ; cd:authoredResource true .
  ex:cf-area-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Reciprocal units become probability only after integration"@en ; dct:references ex:cf-area-symbols ; cd:authoredResource true .
  ex:cf-round-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-round1, ex:cf-round2 ; cd:authoredResource true .
  ex:cf-round1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Does height 1.2 mean 120%"@en ; cd:body "No. It is 1.2 per mg/L. Probability is area, not the height at a point. Densities can exceed one without violating the probability bound."@en ; cd:authoredResource true .
  ex:cf-round2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Why can the display still read 10.0"@en ; cd:body "With nearest-0.1 mg/L rounding, a displayed 10.0 represents roughly 9.95 to 10.05 mg/L; tie conventions affect the endpoints. That interval can have positive probability. The display is not an infinitely precise point."@en ; cd:authoredResource true .
  ex:cf-discrete a cd:MathExpression ; cd:formulaLabel "Count positives: use masses, and keep the CDF"@en ; cd:latex "\\begin{gathered}K\\in\\{0,1,\\ldots,10\\}\\\\p(k)=P(K=k)\\\\F(x)=P(K\\le x)=\\sum_{k\\le x}p(k)\\end{gathered}" ; cd:hasSymbol ex:cf-discrete-symbols ; dct:hasPart ex:cf-discrete-legend ; cd:authoredResource true .
  ex:cf-discrete-symbols a cd:MathSymbol ; cd:symbol "discrete count and cumulative mass" ; cd:mathNotation "K,k,x,p,F,P,\\in,\\{\\},\\ldots,=,\\le,\\sum" ; cd:body "K: number of positive results among ten assays; k: one possible integer from zero through ten; x: any real count threshold. Membership and braces give the support; dots include the intermediate integers. Lowercase p is the PMF, a probability for exactly k, not a density. P denotes probability; F is the CDF. Sum all support masses with k at most x, including the endpoint. All counts and probabilities are dimensionless; equalities define the functions."@en ; cd:authoredResource true .
  ex:cf-discrete-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-discrete-entry ; cd:authoredResource true .
  ex:cf-discrete-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Different random variable, same cumulative language"@en ; dct:references ex:cf-discrete-symbols ; cd:authoredResource true .
  ex:cf-compare a cd:TableDefinition ; skos:prefLabel "Both have a CDF"@en ; cd:hasTableColumn ex:cf-col1, ex:cf-col2, ex:cf-col3 ; cd:hasTableRow ex:cf-row1, ex:cf-row2, ex:cf-row3 ; cd:authoredResource true .
  ex:cf-col1 a cd:TableColumn ; cd:position 1 ; skos:prefLabel "Question"@en ; cd:authoredResource true .
  ex:cf-col2 a cd:TableColumn ; cd:position 2 ; skos:prefLabel "Discrete count"@en ; cd:authoredResource true .
  ex:cf-col3 a cd:TableColumn ; cd:position 3 ; skos:prefLabel "With a PDF"@en ; cd:authoredResource true .
  ex:cf-row1 a cd:TableRow ; cd:position 1 ; cd:hasTableCell ex:cf-cell11, ex:cf-cell12, ex:cf-cell13 ; cd:authoredResource true .
  ex:cf-cell11 a cd:TableCell ; cd:position 1 ; cd:body "One exact value"@en ; cd:authoredResource true .
  ex:cf-cell12 a cd:TableCell ; cd:position 2 ; cd:body "May have mass"@en ; cd:authoredResource true .
  ex:cf-cell13 a cd:TableCell ; cd:position 3 ; cd:body "Zero probability"@en ; cd:authoredResource true .
  ex:cf-row2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:cf-cell21, ex:cf-cell22, ex:cf-cell23 ; cd:authoredResource true .
  ex:cf-cell21 a cd:TableCell ; cd:position 1 ; cd:body "Local view"@en ; cd:authoredResource true .
  ex:cf-cell22 a cd:TableCell ; cd:position 2 ; cd:body "PMF: mass"@en ; cd:authoredResource true .
  ex:cf-cell23 a cd:TableCell ; cd:position 3 ; cd:body "PDF: density"@en ; cd:authoredResource true .
  ex:cf-row3 a cd:TableRow ; cd:position 3 ; cd:hasTableCell ex:cf-cell31, ex:cf-cell32, ex:cf-cell33 ; cd:authoredResource true .
  ex:cf-cell31 a cd:TableCell ; cd:position 1 ; cd:body "Range"@en ; cd:authoredResource true .
  ex:cf-cell32 a cd:TableCell ; cd:position 2 ; cd:body "Add masses"@en ; cd:authoredResource true .
  ex:cf-cell33 a cd:TableCell ; cd:position 3 ; cd:body "Integrate density"@en ; cd:authoredResource true .
  ex:cf-quantile a cd:MathExpression ; cd:formulaLabel "Reverse the question: probability in, threshold out"@en ; cd:latex "\\begin{gathered}Q(u)=\\inf\\{x:F(x)\\ge u\\}\\\\0<u<1\\end{gathered}" ; cd:hasSymbol ex:cf-quantile-symbols ; dct:hasPart ex:cf-quantile-legend ; cd:authoredResource true .
  ex:cf-quantile-symbols a cd:MathSymbol ; cd:symbol "generalized inverse CDF" ; cd:mathNotation "Q,u,x,F,\\inf,\\{\\},:,\\ge,<,=" ; cd:body "u: requested dimensionless probability strictly between zero and one; x: threshold in the variable's units, mg/L for nitrate. F: CDF. Q: quantile function, often written inverse F, returning the smallest limiting threshold at which F reaches or exceeds u. Inf is the greatest lower bound of the set in braces; colon means such that. Comparisons include a CDF jump that exceeds u; equality defines Q. This is an inverse function, not reciprocal F; discrete quantiles need not achieve exact CDF equality."@en ; cd:authoredResource true .
  ex:cf-quantile-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-quantile-entry ; cd:authoredResource true .
  ex:cf-quantile-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Quantile notation and units"@en ; dct:references ex:cf-quantile-symbols ; cd:authoredResource true .
  ex:cf-quantile-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cf-quantile1, ex:cf-quantile2 ; cd:authoredResource true .
  ex:cf-quantile1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "CDF versus inverse CDF"@en ; cd:body "CDF: choose a concentration threshold, read cumulative probability. Quantile: choose cumulative probability, read a concentration threshold. Both use the same distribution, in opposite directions."@en ; cd:authoredResource true .
  ex:cf-quantile2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Return to the 20 observations"@en ; cd:body "The empirical CDF first reaches 75% at 10.20 mg/L. This is a descriptive empirical threshold, not a known population 75% quantile. Generalized-inverse and interpolated sample-quantile conventions can differ."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-cdf-first> {
  ex:cf-experiment a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-experiment-h, ex:cf-experiment-v ; cd:narration "Start with observations, not a bell curve. Repeated measurements of one 10.0 mg/L nitrate standard do not all give the same result. The displayed values are fictional and sorted by value, not time. Ask for the twenty-first result. Its exact value is unknown; describing the existing sample cannot determine it. Under stable comparable measurement conditions, however, the past observations can inform probability statements about a new result. No normal model has been assumed, and twenty results do not establish stability or a known population distribution."@en ; cd:authoredResource true .
  ex:cf-experiment-title a cd:Interpretation ; skos:prefLabel "What will the next nitrate reading be"@en ; cd:authoredResource true .
  ex:cf-experiment-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-experiment-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-experiment-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-question-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-experiment-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-dots ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-cumulative a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-cumulative-h, ex:cf-cumulative-v, ex:cf-cumulative-f ; cd:narration "Recall the ECDF briefly rather than reteaching it. At threshold 10.20, fifteen of twenty readings are included, including the result exactly equal to 10.20. Move the optional threshold to see how observations accumulate and tied values make larger jumps. The observed fraction 75 percent is an estimate. The corresponding population question is the probability that a future result under the same stable conditions is at most this threshold. The CDF names that unknown probability function. Do not replace F by its empirical estimate as an exact equality, or imply that twenty results guarantee a 75 percent future rate."@en ; cd:authoredResource true .
  ex:cf-cumulative-title a cd:Interpretation ; skos:prefLabel "At most 10.20 mg/L: from 15 of 20 to a CDF"@en ; cd:authoredResource true .
  ex:cf-cumulative-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-cumulative-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-cumulative-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-ecdf ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-cumulative-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-cdf ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-interval-scene a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-interval-h, ex:cf-interval-f ; cd:narration "Ask about an entire concentration range. Subtract the cumulative probability at 9.80 from the cumulative probability at 10.20. This includes results greater than 9.80 and at most 10.20. With the same twenty readings, four are at most the lower endpoint and fifteen at most the upper, leaving eleven in the interval. The empirical estimate is 55 percent. The strict lower endpoint matters for rounded data and for discrete distributions: including 9.80 would include one additional observation. The population CDF identity works without selecting a named distribution family."@en ; cd:authoredResource true .
  ex:cf-interval-title a cd:Interpretation ; skos:prefLabel "Between two thresholds: subtract accumulated fractions"@en ; cd:authoredResource true .
  ex:cf-interval-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-interval-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-interval-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-ecdf ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-interval-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-interval ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-histogram a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-histogram-h, ex:cf-histogram-v, ex:cf-histogram-f ; cd:narration "Change the question from how much has accumulated to where results concentrate. Use exactly the same twenty observations, not a new sample. A bin's relative frequency depends on width; divide by that width to get density. The bin from 9.90 inclusive to 10.10 exclusive contains seven readings and has width 0.20 mg/L. Its density is 1.75 L/mg but its relative-frequency area is only 0.35. The histogram is empirical, with arbitrary authored bins. It is not proof of a population PDF or a fitted normal distribution. Next introduce a separate conceptual continuous model and explain its relation to its CDF."@en ; cd:authoredResource true .
  ex:cf-histogram-title a cd:Interpretation ; skos:prefLabel "Where do results cluster: divide frequency by bin width"@en ; cd:authoredResource true .
  ex:cf-histogram-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-histogram-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-histogram-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-hist ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-histogram-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-density ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-link-scene a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-link-h, ex:cf-link-v, ex:cf-link-f ; cd:narration "The conceptual triangular model is not fitted to the twenty readings, and no normal distribution is introduced here. Its density and cumulative curve describe the same theoretical distribution. High density means a steeper CDF; zero density means a flat CDF. The PDF is the derivative where it exists; the CDF is the accumulated integral of the PDF. These identities apply to absolutely continuous distributions, not to every CDF. In particular, differentiating an empirical step function does not produce an ordinary density for the unknown population."@en ; cd:authoredResource true .
  ex:cf-link-title a cd:Interpretation ; skos:prefLabel "PDF and CDF: local density versus accumulated probability"@en ; cd:authoredResource true .
  ex:cf-link-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-link-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-link-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-model-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-link-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-link ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-area-scene a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-area-h, ex:cf-area-c, ex:cf-area-f ; cd:narration "Provoke the mistake deliberately: a density height of 1.2 is not 120 percent probability. Its reciprocal concentration unit reveals the difference. Integrating over a concentration interval cancels units and gives a probability; the complete PDF integrates to one. In a density-based continuous model an infinitely precise point has probability zero. A rounded instrument display instead labels a range. For nearest-0.1 rounding, displayed 10.0 corresponds approximately to 9.95 through 10.05 mg/L, with endpoint allocation depending on the tie rule. This rounding example is distinct from the more finely reported twenty teaching readings. Quantization or atoms need not have a density, so qualify the idealization rather than claiming that every measurement display has zero point mass."@en ; cd:authoredResource true .
  ex:cf-area-title a cd:Interpretation ; skos:prefLabel "Height 1.2 is not 120 percent probability"@en ; cd:authoredResource true .
  ex:cf-area-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-area-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-area-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-round-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-area-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-area ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-discrete-scene a cd:SceneDefinition ; cd:focusConcept ex:probability-mass-function ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-discrete-h, ex:cf-discrete-t, ex:cf-discrete-f ; cd:narration "Change experiments explicitly. We now classify ten separate samples as positive or negative, rather than repeat one standard's concentration measurement. K counts positive results and can take only integers zero through ten. A PMF assigns mass to exact counts; a PDF instead gives density for a continuous model. Both have a CDF, and the general interval identity still uses a strict lower endpoint. Positive classifications are not automatically true contamination or prevalence. Merely counting ten samples does not establish a binomial law: the next example adds independence and a common positive-result probability."@en ; cd:authoredResource true .
  ex:cf-discrete-title a cd:Interpretation ; skos:prefLabel "Counts use masses, not density"@en ; cd:authoredResource true .
  ex:cf-discrete-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-discrete-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-discrete-t a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-compare ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-discrete-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-discrete ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-binomial a cd:SceneDefinition ; cd:focusConcept ex:bernoulli-trial ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-binomial-h, ex:cf-binomial-v, ex:cf-binomial-f ; cd:narration "Apply the common language to a first discrete family. Model ten independent assay classifications with the same 20 percent positive-result probability in each trial. That probability is an explicit teaching assumption, not an observed nitrate-standard rate or a measured contamination prevalence. Counting positives gives a binomial distribution. The bar at two is the probability of exactly two positives; adding all eleven masses gives one. To answer at most two, accumulate the first three masses instead. The full existing binomial workshop remains available as supporting material; this short bridge introduces the family without requiring its interactive scenes."@en ; cd:authoredResource true .
  ex:cf-binomial-title a cd:Interpretation ; skos:prefLabel "First discrete model: ten independent yes/no assays"@en ; cd:authoredResource true .
  ex:cf-binomial-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-binomial-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-binomial-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-d08a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-binomial-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-d08a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-quantile-scene a cd:SceneDefinition ; cd:focusConcept ex:theoretical-quantile ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:cf-quantile-h, ex:cf-quantile-c, ex:cf-quantile-f ; cd:narration "Keep the inverse CDF as a short bridge after the common CDF, PDF and PMF language. Input a probability and find the first threshold where the CDF reaches it. For the empirical step CDF of our twenty readings, the generalized-inverse 75 percent quantile is 10.20 mg/L. This is not known to be the population quantile, and interpolation-based sample quantiles may differ. At a discrete jump a CDF can exceed the requested probability. The same inversion later supplies standard-normal quantiles and inverse-transform Monte Carlo inputs. Next change coordinates with generic standardization before introducing the normal model."@en ; cd:authoredResource true .
  ex:cf-quantile-title a cd:Interpretation ; skos:prefLabel "Inverse CDF: which threshold reaches a chosen probability"@en ; cd:authoredResource true .
  ex:cf-quantile-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:cf-quantile-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-quantile-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:cf-quantile-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:cf-quantile-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-quantile ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
}
