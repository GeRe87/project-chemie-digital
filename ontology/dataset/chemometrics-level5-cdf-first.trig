  ex:cf-dots a cd:ChartDefinition ; skos:prefLabel "What will the 21st measurement be"@en ; cd:body "20 fictional repeats of one 10.0 mg/L nitrate standard. Equal values remain separate results; offsets only separate dots."@en ; cd:chartType cd:DotPlot ; cd:hasChartGroup ex:cf-dot-group ; cd:xAxisLabel "One standard, repeated measurements"@en ; cd:yAxisLabel "Nitrate result"@en ; cd:yAxisUnit "mg/L" ; cd:yAxisMinimum 9.4 ; cd:observationLabel "20 fictional readings" ; cd:authoredResource true .
  ex:cf-dot-group a cd:ChartGroup ; skos:prefLabel "One unchanged standard"@en ; cd:position 1 ; cd:usesDataset ex:cf-readings ; cd:authoredResource true .
  ex:cf-ecdf a cd:ChartDefinition ; skos:prefLabel "15 of 20 results are at most 10.20 mg/L"@en ; cd:body "Move threshold: 4/20 at 9.80; 15/20 at 10.20 mg/L. Ties enter together. Observed fractions estimate future probabilities under stable conditions."@en ; cd:chartType cd:ObservationExplorer ; cd:observationView "ecdf" ; cd:compactObservations true ; cd:hasObservationSeries ex:cf-series ; cd:thresholdMinimum 9.4 ; cd:thresholdMaximum 10.6 ; cd:thresholdInitial 10.2 ; cd:thresholdStep 0.05 ; cd:xAxisLabel "Nitrate threshold x"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Cumulative observed fraction"@en ; cd:authoredResource true .
  ex:cf-hist a cd:ChartDefinition ; skos:prefLabel "The same 20 results: area is relative frequency"@en ; cd:body "Fixed 0.20 mg/L bins, left closed and right open. The 9.90 to 10.10 bin contains 7/20 results: area 0.35, density height 1.75 L/mg. This histogram estimates local concentration of results; it is not an exact population PDF."@en ; cd:chartType cd:Histogram ; cd:usesDataset ex:cf-readings ; cd:binEdges ex:cf-edge0 ; cd:histogramNormalization "density" ; cd:xAxisLabel "Reported nitrate result"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Relative frequency density"@en ; cd:yAxisUnit "L/mg" ; cd:authoredResource true .
