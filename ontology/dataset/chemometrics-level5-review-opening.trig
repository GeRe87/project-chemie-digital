@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-opening> {
  ex:rv-n02-title a cd:Interpretation ; skos:prefLabel "Our route: observations, mechanisms and decisions"@en ; cd:authoredResource true .
  ex:rv-n03-title a cd:Interpretation ; skos:prefLabel "Recall binomial counts: masses, not density heights"@en ; cd:authoredResource true .
  ex:rv-n03-answer a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Model reminder: ten independent yes/no assays**, each with positive probability 0.20. Exactly two positives have probability about 30.2%. Each bar is a probability mass; add masses for several possible counts. A continuous density instead assigns probability to intervals through area. Many small signed contributions will connect these ideas in the normal chapter."@en ; cd:authoredResource true .
  ex:rv-n04-title a cd:Interpretation ; skos:prefLabel "One standard, twenty nitrate readings: what comes next?"@en ; cd:authoredResource true .
  ex:rv-n04-answer a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Illustrative dataset · nitrate IC · 20 repeated measurements · mg/L.** These fictional values describe one unchanged standard, not twenty water samples. We cannot predict the exact next reading. Ask instead which ranges contain many results. This descriptive warm-up is separate from the later six-result precision and CRM experiments."@en ; cd:authoredResource true .
  ex:rv-n05-title a cd:Interpretation ; skos:prefLabel "Move one threshold, then ask about an interval"@en ; cd:authoredResource true .
  ex:rv-n05-answer a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Same 20 illustrative readings; no population model fitted.** This empirical CDF is a staircase made from sample counts, estimating the population CDF introduced next. At most 10.20 mg/L includes 15 results; at most 9.80 includes four. Their difference counts eleven results, or 55%, excluding 9.80 and including 10.20. Move either threshold or switch back to one. Sample fractions estimate future probabilities only under comparable stable conditions."@en ; cd:authoredResource true .
  ex:rv-interval a cd:ChartDefinition ; skos:prefLabel "Count below a threshold or between two thresholds"@en ; cd:body "Same fictional nitrate standard, 20 repeats. The shaded concentration range is not area under the ECDF: subtract the two cumulative fractions. Tied readings enter together. The lower endpoint is excluded; the upper endpoint is included."@en ; cd:chartType cd:ObservationExplorer ; cd:observationView "ecdf" ; cd:compactObservations true ; cd:hasObservationSeries ex:cf-series ; cd:thresholdMinimum 9.4 ; cd:thresholdMaximum 10.6 ; cd:thresholdInitial 10.2 ; cd:lowerThresholdInitial 9.8 ; cd:thresholdStep 0.05 ; cd:xAxisLabel "Nitrate threshold"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Cumulative observed fraction"@en ; dct:references ex:cf-ecdf, ex:cf-interval ; cd:authoredResource true .
  ex:rv-n06-title a cd:Interpretation ; skos:prefLabel "Density height is not probability; area is"@en ; cd:authoredResource true .
  ex:rv-n06-answer a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Same illustrative dataset, now grouped into bins.** Initially seven of twenty results lie from 9.90 inclusive to 10.10 exclusive: 35%. The bin is 0.20 mg/L wide and its density height is 1.75 L/mg. Height can exceed one; the corresponding area is still only 35%. Change width or origin: the observations stay fixed but heights change. A histogram estimates a distribution; it does not prove a continuous model. A partial-bin area also assumes how observations are spread inside that bin, unlike counting the original data."@en ; cd:authoredResource true .
  ex:rv-density a cd:ChartDefinition ; skos:prefLabel "One dataset, adjustable bins, unchanged observations"@en ; cd:body "Illustrative nitrate IC data, n=20. Heights are relative-frequency density in L/mg; bin area is an observed fraction. All readings remain included when bins move. This is not a fitted normal PDF."@en ; cd:chartType cd:Histogram ; cd:usesDataset ex:cf-readings ; cd:binEdges ex:cf-edge0 ; cd:histogramNormalization "density" ; cd:allowBinAdjustment true ; cd:binWidthMinimum 0.05 ; cd:binWidthMaximum 0.4 ; cd:binWidthStep 0.05 ; cd:xAxisLabel "Nitrate result"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Relative frequency density"@en ; cd:yAxisUnit "L/mg" ; dct:references ex:cf-hist ; cd:authoredResource true .
  ex:rv-ecdf-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rv-ecdf-functions-entry ; cd:authoredResource true .
  ex:rv-ecdf-functions-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "R functions used in this reproduction"@en ; cd:body "c combines the readings in a vector. is.finite checks bounds; stopifnot rejects invalid input. Comparisons and & select readings in the stated interval. sum counts TRUE values; length supplies the denominator; mean of a logical vector gives its fraction. cat writes labeled results and a newline. ecdf constructs the empirical cumulative function; plot draws it. abline adds the two threshold lines; col and lty distinguish their colors and line types."@en ; cd:authoredResource true .
  ex:rv-density-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rv-density-functions-entry ; cd:authoredResource true .
  ex:rv-density-functions-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "R functions used in this reproduction"@en ; cd:body "c combines observations; seq creates equally spaced bin edges. hist with plot=FALSE computes counts and density; right=FALSE selects left-closed bins, with the outer endpoint included. head and tail align lower and upper edges. data.frame collects the columns; print displays them. length counts readings; sum totals counts or bin areas; diff computes bin widths. abs and stopifnot check numerical conservation within tolerance. plot draws the saved histogram; freq=FALSE requests density heights, not raw counts."@en ; cd:authoredResource true .
  ex:rv-ecdf-code a cd:CodeExample ; skos:prefLabel "Reproduce the two-threshold count"@en ; dct:hasPart ex:rv-ecdf-functions ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:cf-readings ; cd:code """# The same 20 fictional readings, not new simulation draws.
x <- c(9.55,9.65,9.75,9.80,9.85,9.90,9.90,9.95,9.95,10.00,
       10.00,10.05,10.10,10.15,10.20,10.25,10.30,10.35,10.40,10.50)
lower <- 9.80; upper <- 10.20
stopifnot(is.finite(lower),is.finite(upper),lower<=upper)
cat('At most upper:',sum(x<=upper),'of',length(x),'\\n')
cat('At most lower:',sum(x<=lower),'of',length(x),'\\n')
cat('Lower excluded, upper included:',sum(lower<x & x<=upper),
    'of',length(x),'fraction:',mean(lower<x & x<=upper),'\\n')
plot(ecdf(x),verticals=TRUE,xlab='Nitrate result (mg/L)',
     ylab='Observed cumulative fraction',main='Same fictional series')
abline(v=c(lower,upper),col=c('#6b2cb1','#176b90'),lty=c(2,1))
""" ; cd:authoredResource true .
  ex:rv-density-code a cd:CodeExample ; skos:prefLabel "Reproduce histogram heights and areas"@en ; dct:hasPart ex:rv-density-functions ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:cf-readings ; cd:code """# Initial slide bins. The browser's width/origin controls retain all observations.
x <- c(9.55,9.65,9.75,9.80,9.85,9.90,9.90,9.95,9.95,10.00,
       10.00,10.05,10.10,10.15,10.20,10.25,10.30,10.35,10.40,10.50)
edges <- seq(9.5,10.7,by=.2)
h <- hist(x,breaks=edges,right=FALSE,plot=FALSE)
print(data.frame(lower=head(edges,-1),upper=tail(edges,-1),
                 count=h$counts,density=h$density,area=h$counts/length(x)))
stopifnot(sum(h$counts)==length(x),abs(sum(h$density*diff(edges))-1)<1e-10)
plot(h,freq=FALSE,col='#8ecae6',xlab='Nitrate result (mg/L)',
     ylab='Density (L/mg)',main='Area is observed fraction')
""" ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-review-opening> {
  ex:rv-n02 a cd:SceneDefinition ; cd:focusConcept ex:l5-analytical-distributions ; dct:subject ex:l5-topic-functions ; dct:references ex:ix-opening ; cd:hasSceneItem ex:rv-n02-h, ex:rv-n02-c ; cd:narration "N02. The title is N01 and is supplied by the presentation renderer. Announce the entire route, including the transformed-normal lognormal branch, model checks and uncertainty propagation. This is a multi-session package. Ask how the random quantity changes from readings to estimates and decisions; do not promise that the whole package fits one ninety-minute meeting."@en ; cd:authoredResource true .
  ex:rv-n02-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rv-n02-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
   ex:rv-n02-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:p1-route ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n03 a cd:SceneDefinition ; cd:focusConcept ex:l5-analytical-distributions ; dct:subject ex:l5-topic-functions ; dct:references ex:cf-discrete-scene, ex:cf-binomial ; cd:hasSceneItem ex:rv-n03-h, ex:rv-n03-c, ex:rv-n03-v ; cd:narration "N03. Activate the preceding binomial material rather than teach a second isolated definition collection. Ten independent trials with fixed success probability form a count model. The plotted masses are exact model probabilities, not experimental frequencies or density heights. Recall that sums of small signed contributions will later connect this discrete starting point with a normal density approximation."@en ; cd:authoredResource true .
  ex:rv-n03-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rv-n03-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n03-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rv-n03-answer ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n03-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-d08a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n04 a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; dct:references ex:cf-experiment ; cd:hasSceneItem ex:rv-n04-h, ex:rv-n04-c, ex:rv-n04-v ; cd:narration "N04. Use the existing twenty fictional nitrate readings without changing their values. They are a descriptive warm-up, not the later six-result QC or CRM series. The display is sorted, not an acquisition-order record. Point out tied readings, then ask for an interval rather than an exact prediction. Stable future sampling is an assumption, not something established by this sample."@en ; cd:authoredResource true .
  ex:rv-n04-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rv-n04-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n04-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rv-n04-answer ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n04-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:cf-dots ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n05 a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; dct:references ex:cf-cumulative, ex:cf-interval-scene ; cd:hasSceneItem ex:rv-n05-h, ex:rv-n05-c, ex:rv-n05-v, ex:rv-n05-r ; cd:narration "N05. Start with the saved two-threshold state: fifteen at most the upper threshold, four at most the lower threshold, eleven strictly above the lower and at most the upper. Switch to a single threshold and back without changing the observations. Ties enter together. The highlighted horizontal range is not probability area under a CDF. Probability is the vertical difference of cumulative fractions. The browser experiment works without R; optional R reproduces the same calculation."@en ; cd:authoredResource true .
  ex:rv-n05-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rv-n05-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n05-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rv-n05-answer ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n05-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rv-interval ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n05-r a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:rv-ecdf-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:optionalCode true ; cd:authoredResource true .
  ex:rv-n06 a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; dct:references ex:cf-histogram, ex:cf-link-scene, ex:cf-area-scene ; cd:hasSceneItem ex:rv-n06-h, ex:rv-n06-c, ex:rv-n06-v, ex:rv-n06-r ; cd:narration "N06. Keep the same twenty observations and compare bin height with relative-frequency area. The starting bin from 9.90 to 10.10 contains seven readings. Change width and origin using the existing histogram controls. Every observation remains included, but height changes because concentration units matter. A future continuous PDF is a model of local concentration, and the CDF accumulates its area. Do not claim the step ECDF has an ordinary density derivative, or silently replace the data with a fitted normal model. Detailed definitions remain in the extended path; the normal chapter will introduce its own model at the analytical question where it is needed."@en ; cd:authoredResource true .
  ex:rv-n06-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:rv-n06-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n06-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:rv-n06-answer ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n06-v a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:rv-density ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:rv-n06-r a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:rv-density-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:optionalCode true ; cd:authoredResource true .
}

