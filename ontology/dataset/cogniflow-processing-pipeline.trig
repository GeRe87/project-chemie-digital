@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-processing-pipeline> {
  ex:cogniflow-processing-pipeline a cd:Concept ;
    skos:prefLabel "Compatible Processing Steps Form a Pipeline"@en ;
    cd:hasDefinition ex:def-cogniflow-processing-pipeline ;
    cd:authoredResource true .

  ex:def-cogniflow-processing-pipeline a cd:Definition ;
    cd:body "A ProcessingPipeline composes reusable ProcessingSteps by connecting semantically compatible output and input Ports. Each step exposes the same explicit interface pattern: Input, Parameter, and Output."@en ;
    cd:authoredResource true .

  ex:cogniflow-processing-pipeline-banner a cd:Interpretation ;
    cd:body """PROCESSING PIPELINE
compatible Ports connect reusable ProcessingSteps"""@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-processing-pipeline a cd:FlowDiagram ;
    skos:prefLabel "Composable analytical processing pipeline"@en ;
    cd:body "Four reusable ProcessingSteps form a pipeline because each output is semantically compatible with the following input."@en ;
    cd:hasDiagramNode ex:node-cogniflow-step-baseline,
      ex:node-cogniflow-step-detection,
      ex:node-cogniflow-step-integration,
      ex:node-cogniflow-step-grouping ;
    cd:hasDiagramEdge ex:edge-cogniflow-step-baseline-detection,
      ex:edge-cogniflow-step-detection-integration,
      ex:edge-cogniflow-step-integration-grouping ;
    cd:authoredResource true .

  ex:node-cogniflow-step-baseline a cd:DiagramNode ;
    skos:prefLabel """BASELINE CORRECTION
ProcessingStep
IN · chromatogram
PARAM · baseline window
OUT · corrected chromatogram"""@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:node-cogniflow-step-detection a cd:DiagramNode ;
    skos:prefLabel """PEAK DETECTION
ProcessingStep
IN · corrected chromatogram
PARAM · detection threshold
OUT · peak candidates"""@en ;
    cd:position 2 ;
    cd:authoredResource true .

  ex:node-cogniflow-step-integration a cd:DiagramNode ;
    skos:prefLabel """PEAK INTEGRATION
ProcessingStep
IN · peak candidates
PARAM · integration window
OUT · integrated peaks"""@en ;
    cd:position 3 ;
    cd:authoredResource true .

  ex:node-cogniflow-step-grouping a cd:DiagramNode ;
    skos:prefLabel """PEAK GROUPING
ProcessingStep
IN · integrated peaks
PARAM · RT tolerance
OUT · grouped features"""@en ;
    cd:position 4 ;
    cd:authoredResource true .

  ex:edge-cogniflow-step-baseline-detection a cd:DiagramEdge ;
    skos:prefLabel "corrected chromatogram"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-step-baseline ;
    cd:targetNode ex:node-cogniflow-step-detection ;
    cd:authoredResource true .

  ex:edge-cogniflow-step-detection-integration a cd:DiagramEdge ;
    skos:prefLabel "peak candidates"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-step-detection ;
    cd:targetNode ex:node-cogniflow-step-integration ;
    cd:authoredResource true .

  ex:edge-cogniflow-step-integration-grouping a cd:DiagramEdge ;
    skos:prefLabel "integrated peaks"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-step-integration ;
    cd:targetNode ex:node-cogniflow-step-grouping ;
    cd:authoredResource true .

  ex:cogniflow-processing-pipeline-note a cd:Interpretation ;
    cd:body "OUT PORT = NEXT IN PORT — SEMANTIC COMPATIBILITY MAKES THE PIPELINE COMPOSABLE"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-processing-pipeline-extension> {
  ex:path-step-cogniflow-processing-pipeline a cd:PathStep ;
    cd:position 14 ;
    cd:usesResource ex:cogniflow-processing-pipeline-banner,
      ex:diagram-cogniflow-processing-pipeline,
      ex:cogniflow-processing-pipeline-note ;
    cd:usesScene ex:scene-cogniflow-processing-pipeline ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-processing-pipeline> {
  ex:scene-cogniflow-processing-pipeline a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-processing-pipeline ;
    cd:hasSceneItem ex:scene-item-cogniflow-processing-pipeline-heading,
      ex:scene-item-cogniflow-processing-pipeline-banner,
      ex:scene-item-cogniflow-processing-pipeline-diagram,
      ex:scene-item-cogniflow-processing-pipeline-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-pipeline-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-processing-pipeline ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-pipeline-banner a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-processing-pipeline-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-pipeline-diagram a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:diagram-cogniflow-processing-pipeline ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-pipeline-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-processing-pipeline-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
