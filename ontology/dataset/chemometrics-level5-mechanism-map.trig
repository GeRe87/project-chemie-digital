@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-mechanism-map> {
 ex:map-normal-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-normal-context-entry ; cd:authoredResource true .
 ex:map-normal-context-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Normal: additive contributions"@en ; cd:body "- Independent normal contributions: exact.\n- Many small effects: approximation under suitable conditions."@en ; cd:authoredResource true .
 ex:map-normal-formula a cd:MathExpression ; cd:latex "Y=X_1+X_2+X_3+\\cdots" ; dct:hasPart ex:map-normal-legend ; cd:hasSymbol ex:map-normal-symbol ; cd:authoredResource true .
 ex:map-normal-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-normal-symbol-entry ; cd:authoredResource true .
 ex:map-normal-symbol-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A sum of additive random contributions"@en ; dct:references ex:map-normal-symbol ; cd:authoredResource true .
 ex:map-normal-symbol a cd:MathSymbol ; cd:symbol "additive contributions" ; cd:mathNotation "Y,X_1,X_2,X_3,+,\\cdots,=" ; cd:body "Y: random total; X with subscripts 1, 2, 3: random additive contributions, such as injection, flow and detector effects. Subscripts identify contributions, not powers. All use mg/L. Plus adds; dots continue a finite sum; equals defines Y. Independent normal contributions give an exact normal sum. Central-limit approximations need suitable conditions, including finite variances and no dominating contribution."@en ; cd:authoredResource true .

 ex:map-log-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-log-context-entry ; cd:authoredResource true .
 ex:map-log-context-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Lognormal: relative factors"@en ; cd:body "- Multiply positive relative factors.\n- A normal log-sum gives a lognormal product."@en ; cd:authoredResource true .
 ex:map-log-formula a cd:MathExpression ; cd:latex "Y=X_1\\cdot X_2\\cdot X_3\\cdots" ; dct:hasPart ex:map-log-legend ; cd:hasSymbol ex:map-log-symbol ; cd:authoredResource true .
 ex:map-log-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-log-symbol-entry ; cd:authoredResource true .
 ex:map-log-symbol-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A product of positive relative factors"@en ; dct:references ex:map-log-symbol ; cd:authoredResource true .
 ex:map-log-symbol a cd:MathSymbol ; cd:symbol "relative factors" ; cd:mathNotation "Y,X_1,X_2,X_3,\\cdot,\\cdots,=" ; cd:body "Y: positive random total relative factor. Each X is a positive dimensionless relative factor, not the concentration contribution in the normal card. Subscripts 1, 2, 3 identify factors. Centered dots multiply; the ellipsis continues a finite product; equals defines Y. A normal sum of natural-log factors gives a lognormal product; independent normal log factors suffice. Arbitrary products need not be lognormal. Multiply by a fixed reference concentration to recover concentration units."@en ; cd:authoredResource true .

 ex:map-chi-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-chi-context-entry ; cd:authoredResource true .
 ex:map-chi-context-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Chi-square: squared and scaled"@en ; cd:body "- Add independent squared standard normals.\n- Normal samples: scaled sample variance."@en ; cd:authoredResource true .
 ex:map-chi-formula a cd:MathExpression ; cd:latex "\\begin{gathered}Q=Z_1^2+\\cdots+Z_\\nu^2\\\\Q=\\frac{(n-1)S^2}{\\sigma^2}\\end{gathered}" ; dct:hasPart ex:map-chi-legend ; cd:hasSymbol ex:map-chi-symbol ; cd:authoredResource true .
 ex:map-chi-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-chi-symbol-entry ; cd:authoredResource true .
 ex:map-chi-symbol-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent squares and the normal-sample variance"@en ; dct:references ex:map-chi-symbol ; cd:authoredResource true .
 ex:map-chi-symbol a cd:MathSymbol ; cd:symbol "scaled variance" ; cd:mathNotation "Q,Z_1,Z_\\nu,\\nu,n,S^2,\\sigma^2,{}^2,+,-,/,=,\\cdots" ; cd:body "Q: unitless chi-square variable. Indexed Z: nu independent standard normals, each with mean zero and variance one; nu is a positive integer count of degrees of freedom. Squares, plus and dots sum all nu squared components. For n iid normal measurements, n at least two, S squared is sample variance about the estimated mean using divisor n minus one; sigma squared is positive true variance. Both use (mg/L) squared. Scaling gives unitless Q with nu equal to n minus one. Minus subtracts; fractions divide; juxtaposition multiplies; equals states identities. Independent Z components are orthonormal residual coordinates, not the dependent raw residuals."@en ; cd:authoredResource true .

 ex:map-t-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-t-context-entry ; cd:authoredResource true .
 ex:map-t-context-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Student-t: standardized means"@en ; cd:body "- Center the mean; use its estimated standard error.\n- Independent normal measurements."@en ; cd:authoredResource true .
 ex:map-t-formula a cd:MathExpression ; cd:latex "T=\\frac{\\bar X-\\mu}{S/\\sqrt n}" ; dct:hasPart ex:map-t-legend ; cd:hasSymbol ex:map-t-symbol ; cd:authoredResource true .
 ex:map-t-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-t-symbol-entry ; cd:authoredResource true .
 ex:map-t-symbol-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A random mean divided by its estimated standard error"@en ; dct:references ex:map-t-symbol ; cd:authoredResource true .
 ex:map-t-symbol a cd:MathSymbol ; cd:symbol "standardized means" ; cd:mathNotation "T,\\bar X,\\mu,S,n,-,/,\\sqrt{},=" ; cd:body "T: unitless random Student variable. Bar X: random sample mean, bar denoting averaging. Mu: fixed true mean. S: positive sample SD from the same n measurements, using variance divisor n minus one. Mean, mu and S use mg/L. Count n is at least two; measurements are independent and identically normal. Divide S by the positive square root of n for estimated standard error. Minus centers, fractions divide and equals defines T, with n minus one degrees of freedom."@en ; cd:authoredResource true .

 ex:map-f-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-f-context-entry ; cd:authoredResource true .
 ex:map-f-context-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "F: variance ratios"@en ; cd:body "- Two independent normal samples.\n- Normalize each variance by its true variance, then divide."@en ; cd:authoredResource true .
 ex:map-f-formula a cd:MathExpression ; cd:latex "F=\\frac{S_B^2/\\sigma_B^2}{S_A^2/\\sigma_A^2}" ; dct:hasPart ex:map-f-legend ; cd:hasSymbol ex:map-f-symbol ; cd:authoredResource true .
 ex:map-f-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:map-f-symbol-entry ; cd:authoredResource true .
 ex:map-f-symbol-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Normalize each independent variance estimate"@en ; dct:references ex:map-f-symbol ; cd:authoredResource true .
 ex:map-f-symbol a cd:MathSymbol ; cd:symbol "normalized variance ratio" ; cd:mathNotation "F,S_B^2,\\sigma_B^2,S_A^2,\\sigma_A^2,{}^2,/,=" ; cd:body "F: unitless random ratio. S squared: sample variance about its own estimated mean, using sample count minus one; sigma squared: positive true variance. All variances use (mg/L) squared. Subscripts identify independent groups B (numerator) and A (denominator); superscript two squares an SD. Inner divisions normalize variances; the outer fraction forms their ratio; equals defines F. Measurements within each group are iid normal; group means may differ. Ordered degrees of freedom are B count minus one, then A count minus one. Equal true variances cancel, giving the raw sample-variance ratio."@en ; cd:authoredResource true .

 ex:map-normal-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:map-normal-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:map-normal-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:map-normal-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:map-log-c a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:map-log-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:map-log-f a cd:SceneItem ; cd:position 5 ; cd:selectsResource ex:map-log-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:map-chi-c a cd:SceneItem ; cd:position 6 ; cd:selectsResource ex:map-chi-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:map-chi-f a cd:SceneItem ; cd:position 7 ; cd:selectsResource ex:map-chi-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:map-t-c a cd:SceneItem ; cd:position 8 ; cd:selectsResource ex:map-t-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:map-t-f a cd:SceneItem ; cd:position 9 ; cd:selectsResource ex:map-t-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:map-f-c a cd:SceneItem ; cd:position 10 ; cd:selectsResource ex:map-f-context ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:map-f-f a cd:SceneItem ; cd:position 11 ; cd:selectsResource ex:map-f-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:map-mechanisms-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-analytical-distributions ; dct:subject ex:l5-topic-map ; cd:hasSceneItem ex:al-map-h, ex:map-normal-c, ex:map-normal-f, ex:map-log-c, ex:map-log-f, ex:map-chi-c, ex:map-chi-f, ex:map-t-c, ex:map-t-f, ex:map-f-c, ex:map-f-f ; cd:narration "Review the five families through their random quantities and mechanisms: additive contributions, multiplicative relative factors, independent squared standardized components or scaled normal-sample variances, means standardized by estimated standard errors, and ratios of normalized independent sample variances. The same X notation is local to each example; do not multiply concentration units when describing relative factors. State the independence, normality and normalization conditions instead of claiming that any sum, product or variance ratio has the named distribution."@en ; cd:authoredResource true .
}
