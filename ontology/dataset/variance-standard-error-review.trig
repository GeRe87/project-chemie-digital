@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/mathematics/rules> {
  ex:rule-expectation-finite-sum a cd:MathematicalRule ; skos:prefLabel "Expectation of a finite sum"@en ; cd:ruleFormula ex:rule-expectation-finite-sum-formula ; cd:requiresAssumption ex:assumption-integrable, ex:assumption-finite-sum ; dct:hasPart ex:rule-expectation-addition ; cd:body "For a fixed finite number of integrable random quantities, apply expectation addition repeatedly. E[ΣY_i] = ΣE[Y_i]. Neither independence nor identical distribution is required. This finite-sum rule alone does not justify interchanging an infinite sum and expectation."@en ; cd:authoredResource true .
  ex:rule-expectation-finite-sum-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}Y_i]={\\textstyle\\sum_{i=1}^n}\\operatorname{E}[Y_i]" ; cd:hasSymbol ex:vr-E-symbol, ex:v-sum-symbol, ex:n-symbol, ex:vr-index-symbol, ex:rule-indexed-Y-symbol ; cd:authoredResource true .
  ex:rule-variance-constant a cd:MathematicalRule ; skos:prefLabel "Variance of a constant"@en ; cd:ruleFormula ex:rule-variance-constant-formula ; cd:requiresAssumption ex:assumption-fixed-scalars ; dct:hasPart ex:rule-variance-definition, ex:rule-expectation-constant ; cd:body "For a fixed real constant c, E[c] = c, so c−E[c] = 0 on every outcome. Its expected squared centered deviation is therefore zero."@en ; cd:authoredResource true .
  ex:rule-variance-constant-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(c)=0" ; cd:formulaLabel "A fixed constant has no spread"@en ; cd:hasSymbol ex:vm-var-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:rule-covariance-definition a cd:MathematicalRule ; skos:prefLabel "Covariance definition"@en ; cd:ruleFormula ex:rule-covariance-definition-formula ; cd:requiresAssumption ex:assumption-second-moment ; cd:body "For U and V with finite second moments, covariance is the expected product of their centered deviations. Positive covariance indicates joint movement in the same direction, negative covariance opposing movement. Independence implies zero covariance, but zero covariance does not generally imply independence."@en ; cd:authoredResource true .
  ex:rule-covariance-definition-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\operatorname{Cov}(U,V)&=\\operatorname{E}[(U-\\operatorname{E}[U])\\\\&\\qquad\\cdot(V-\\operatorname{E}[V])]\\end{aligned}" ; cd:formulaLabel "Expected product of centered deviations"@en ; cd:hasSymbol ex:rule-cov-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:vr-E-symbol ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/variance-standard-error-review> {
  ex:se-expectation-fixed a cd:MathExpression ; cd:formulaLabel "Constants, scaling and shifting"@en ; cd:latex "\\begin{gathered}\\operatorname{E}[c]=c\\\\\\operatorname{E}[aY+b]=a\\operatorname{E}[Y]+b\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:rule-c-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; dct:source ex:rule-expectation-constant, ex:rule-expectation-location-scale ; dct:hasPart ex:se-fixed-e-legend ; cd:authoredResource true .
  ex:se-fixed-e-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-fixed-e-symbols ; cd:authoredResource true .
  ex:se-fixed-e-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Affine expectation"@en ; cd:body "Finite expectations and fixed real coefficients."@en ; dct:references ex:vr-E-symbol, ex:rule-c-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-expectation-finite-sum-formula cd:formulaLabel "Linearity: expectation distributes over a finite sum"@en ; dct:hasPart ex:se-sum-e-legend .
  ex:se-sum-e-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-sum-e-symbols ; cd:authoredResource true .
  ex:se-sum-e-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Finite sum"@en ; cd:body "No independence is required."@en ; dct:references ex:vr-E-symbol, ex:v-sum-symbol, ex:n-symbol, ex:vr-index-symbol, ex:rule-indexed-Y-symbol ; cd:authoredResource true .
  ex:se-variance-fixed a cd:MathExpression ; cd:formulaLabel "Constants, scaling and shifting"@en ; cd:latex "\\begin{gathered}\\operatorname{Var}(c)=0\\\\\\operatorname{Var}(aY+b)=a^2\\operatorname{Var}(Y)\\end{gathered}" ; cd:hasSymbol ex:vm-var-symbol, ex:rule-c-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; dct:source ex:rule-variance-constant, ex:rule-variance-location-scale ; dct:hasPart ex:se-fixed-v-legend ; cd:authoredResource true .
  ex:se-fixed-v-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-fixed-v-symbols ; cd:authoredResource true .
  ex:se-fixed-v-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Affine variance"@en ; cd:body "Finite second moments and fixed coefficients."@en ; dct:references ex:vm-var-symbol, ex:rule-c-symbol, ex:rule-scale-symbol, ex:rule-shift-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:se-variance-joint a cd:MathExpression ; cd:formulaLabel "Covariance is the expected product of centered deviations"@en ; cd:latex "\\begin{aligned}\\operatorname{Var}(U+V)&=\\operatorname{Var}(U)+\\operatorname{Var}(V)\\\\&\\quad+2\\operatorname{Cov}(U,V)\\\\\\operatorname{Cov}(U,V)&=\\operatorname{E}[(U-\\operatorname{E}[U])\\\\&\\qquad\\cdot(V-\\operatorname{E}[V])]\\end{aligned}" ; cd:hasSymbol ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-cov-symbol, ex:vr-E-symbol ; dct:source ex:rule-variance-covariance, ex:rule-covariance-definition ; dct:hasPart ex:se-joint-legend ; cd:authoredResource true .
  ex:se-joint-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-joint-symbols ; cd:authoredResource true .
  ex:se-joint-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Joint finite moments"@en ; cd:body "Independent observations have zero covariance."@en ; dct:references ex:vm-var-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-cov-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:se-expectation-linearity a cd:MathExpression ; cd:formulaLabel "Addition extends to any fixed finite sum"@en ; cd:latex "\\begin{gathered}\\operatorname{E}[U+V]=\\operatorname{E}[U]+\\operatorname{E}[V]\\\\\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}Y_i]={\\textstyle\\sum_{i=1}^n}\\operatorname{E}[Y_i]\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:v-sum-symbol, ex:n-symbol, ex:vr-index-symbol, ex:rule-indexed-Y-symbol ; dct:source ex:rule-expectation-addition, ex:rule-expectation-finite-sum ; dct:hasPart ex:se-linearity-legend ; cd:authoredResource true .
  ex:se-linearity-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-linearity-symbols ; cd:authoredResource true .
  ex:se-linearity-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Finite linearity"@en ; cd:body "All quantities are integrable; n is fixed and finite."@en ; dct:references ex:vr-E-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:v-sum-symbol, ex:n-symbol, ex:vr-index-symbol, ex:rule-indexed-Y-symbol ; cd:authoredResource true .
  ex:rule-variance-constant-formula dct:hasPart ex:se-constant-legend .
  ex:se-constant-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-constant-symbols ; cd:authoredResource true .
  ex:se-constant-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Fixed constant"@en ; cd:body "The same c on every repetition."@en ; dct:references ex:vm-var-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:rule-covariance-definition-formula dct:hasPart ex:se-cov-legend .
  ex:se-cov-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-cov-symbols ; cd:authoredResource true .
  ex:se-cov-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Joint variation"@en ; cd:body "Both random quantities have finite second moments."@en ; dct:references ex:rule-cov-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:se-extreme-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-extreme-card ; cd:authoredResource true .
  ex:se-extreme-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: change one QC measurement"@en ; cd:body "• Start with **five QC A measurements**.\n• Replace only ==10.2 by 15.2 mg/L==.\n• Compare the **mean and spread** before and after."@en ; dct:source ex:dataset-qc-method-a, ex:v29-data ; cd:authoredResource true .

  ex:se-symbol a cd:MathSymbol ; cd:symbol "SE" ; cd:mathNotation "\\operatorname{SE}" ; cd:body "Standard error: the standard deviation of an estimator's sampling distribution. Here, random uncertainty of the sample mean under the stated sampling assumptions."@en ; cd:presentationDefinition "SD of the mean across repeated samples."@en ; cd:authoredResource true .
  ex:se-estimated-symbol a cd:MathSymbol ; cd:symbol "estimated SE" ; cd:mathNotation "\\widehat{\\operatorname{SE}}" ; cd:body "Estimated standard error, using the observed sample SD s in place of unknown population SD σ."@en ; cd:presentationDefinition "Estimated SE, using sample SD s."@en ; cd:authoredResource true .
  ex:sem-population-formula cd:formulaLabel "Random sampling uncertainty of the mean"@en ; cd:hasSymbol ex:se-symbol, ex:vr-Xbar-symbol, ex:sigma-symbol, ex:n-symbol ; dct:hasPart ex:se-pop-legend .
  ex:sem-estimated-formula cd:formulaLabel "Estimate the unknown standard error"@en ; cd:hasSymbol ex:se-estimated-symbol, ex:vr-Xbar-symbol, ex:s-symbol, ex:n-symbol ; dct:hasPart ex:se-est-legend .
  ex:se-pop-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-pop-symbols ; cd:authoredResource true .
  ex:se-pop-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Mean uncertainty"@en ; cd:body "Independent observations with common finite variance."@en ; dct:references ex:se-symbol, ex:vr-Xbar-symbol, ex:sigma-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:se-est-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-est-symbols ; cd:authoredResource true .
  ex:se-est-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Estimated mean uncertainty"@en ; cd:body "The observed s substitutes for unknown σ."@en ; dct:references ex:se-estimated-symbol, ex:vr-Xbar-symbol, ex:s-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:se-return-title a cd:Interpretation ; skos:prefLabel "Return to the Variance of the Sample Mean"@en ; cd:hasKeyPoint ex:se-return-k1, ex:se-return-k2 ; cd:authoredResource true .
  ex:se-return-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Earlier:** this term explained the gap between E[MSDₙ] and σ² when we fitted the mean."@en ; cd:authoredResource true .
  ex:se-return-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Now:** Var(X̄) describes how sample means scatter around μ over repeated samples. It is ==uncertainty information about the estimated mean==, not the known error of this one result."@en ; cd:authoredResource true .
  ex:se-sem-title a cd:Interpretation ; skos:prefLabel "From Measurement Spread to Uncertainty of the Mean"@en ; cd:hasKeyPoint ex:se-sem-k1, ex:se-sem-k2 ; cd:authoredResource true .
  ex:se-sem-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Notation:** Yᵢ names the same measurement variable as before; its mean is Ȳ. **SD** describes individual values; **SE** describes the mean."@en ; cd:authoredResource true .
  ex:se-sem-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Variance can describe data or quantify uncertainty of an estimator, including later model parameters. ==s/√n applies to this mean, not every estimator==. Correlation and systematic effects need separate treatment."@en ; cd:authoredResource true .
  ex:se-rate-title a cd:Interpretation ; skos:prefLabel "Standard Error Decreases as 1/√n"@en ; cd:hasKeyPoint ex:se-rate-k1, ex:se-rate-k2 ; cd:authoredResource true .
  ex:se-rate-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Square-root law:** at fixed population spread, four times as many independent observations halve the SE. Individual measurement spread does not shrink."@en ; cd:authoredResource true .
  ex:se-rate-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Scope:** independent observations with common finite variance. Correlation or systematic bias can leave ==uncertainty that averaging does not remove==."@en ; cd:authoredResource true .
  ex:se-rate-formula a cd:MathExpression ; cd:formulaLabel "Fixed σ; independent observations"@en ; cd:latex "\\begin{gathered}\\operatorname{SE}_n=\\frac{\\sigma}{\\sqrt n}\\quad\\xrightarrow[n\\to\\infty]{}0\\\\\\operatorname{SE}_{4n}=\\frac12\\operatorname{SE}_n\\end{gathered}" ; cd:hasSymbol ex:se-symbol, ex:sigma-symbol, ex:n-symbol ; dct:source ex:sem-population-formula ; dct:hasPart ex:se-rate-legend ; cd:authoredResource true .
  ex:se-rate-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-rate-symbols ; cd:authoredResource true .
  ex:se-rate-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Square-root scaling"@en ; cd:body "Subscript n denotes the sample size, not one observation."@en ; dct:references ex:se-symbol, ex:sigma-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:se-example-title a cd:Interpretation ; skos:prefLabel "Report a Mean with Its Estimated Standard Error"@en ; cd:hasKeyPoint ex:se-example-k1, ex:se-example-k2 ; cd:authoredResource true .
  ex:se-example-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Existing QC A:** 9.8, 10.0, 10.1, 9.9, 10.2 mg/L. Assuming iid repeats: n = 5, mean = 10.00 mg/L, s ≈ 0.158 mg/L."@en ; cd:authoredResource true .
  ex:se-example-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Label error bars:** here ± means ==one estimated SE==, not SD or a 95% confidence interval. It describes random repeatability uncertainty, not all measurement-uncertainty contributions."@en ; cd:authoredResource true .
  ex:se-example-formula a cd:MathExpression ; cd:formulaLabel "Mean ± one estimated SE; n = 5 iid QC repeats"@en ; cd:latex "\\begin{gathered}\\widehat{\\operatorname{SE}}(\\bar X)=\\frac{0.1581}{\\sqrt5}\\approx0.0707\\;\\mathrm{mg/L}\\\\\\boxed{\\bar x\\;\\pm\\;\\widehat{\\operatorname{SE}}(\\bar X)=(10.00\\pm0.07)\\;\\mathrm{mg/L}}\\end{gathered}" ; cd:hasSymbol ex:se-estimated-symbol, ex:vr-Xbar-symbol, ex:xbar-symbol ; dct:source ex:dataset-qc-method-a, ex:sem-estimated-formula ; dct:hasPart ex:se-example-legend ; cd:authoredResource true .
  ex:se-example-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:se-example-symbols ; cd:authoredResource true .
  ex:se-example-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed report"@en ; cd:body "State what ± denotes, the sample size and the measurement conditions."@en ; dct:references ex:se-estimated-symbol, ex:vr-Xbar-symbol, ex:xbar-symbol ; cd:authoredResource true .
}

