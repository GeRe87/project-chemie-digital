@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-experiments> {
  ex:ix-map-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-map-normal, ex:ix-map-lognormal, ex:ix-map-chi, ex:ix-map-t, ex:ix-map-f, ex:ix-map-checks ; cd:authoredResource true .
  ex:ix-map-normal a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Normal: individual measurements"@en ; cd:body "Many small additive random errors can motivate an approximately normal measurement model. We first learn PDF, CDF, quantiles and standardization. Normality is an assumption to assess, not a universal property of analytical results."@en ; cd:authoredResource true .
  ex:ix-map-lognormal a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Lognormal: multiplicative effects"@en ; cd:body "Compare repeat injections with complete LC-MS/MS preparations. Products become sums on a dimensionless log scale. This is a transformed-normal branch, not a prerequisite for chi-square."@en ; cd:authoredResource true .
  ex:ix-map-chi a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Chi-square: uncertain precision"@en ; cd:body "Repeat whole normal measurement series. Their variance estimates fluctuate. Compare nitrate repeatability with a fixed precision reference under explicit independence and normality assumptions."@en ; cd:authoredResource true .
  ex:ix-map-t a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "t: means with estimated standard error"@en ; cd:body "A new CRM series asks about bias. A random estimated SD changes the reference for the standardized mean. Connect the two-sided decision with its mean confidence interval."@en ; cd:authoredResource true .
  ex:ix-map-f a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "F: devices and calibration models"@en ; cd:body "Compare independent variance estimates, then nested calibration models. Track the ratio direction, both degrees of freedom and the assumptions supplying the reference law."@en ; cd:authoredResource true .
  ex:ix-map-checks a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "Further session: checks and uncertainty"@en ; cd:body "Use Q-Q, KS and Pearson to question models, then propagate input assumptions through a live dilution Monte Carlo case. Allow separate discussion and experiment time; this whole package is not a single 90-minute session."@en ; cd:authoredResource true .
  ex:ix-square-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-normal-to-square.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Schematic densities before and after squaring. A symmetric standard-normal variable has signed SD-unit values. Its square is nonnegative, strongly right-skewed and has density unbounded near zero. Minus two and plus two both give four; minus one half and plus one half both give one quarter. Density axes are per dimensionless axis unit. The graphic illustrates shapes, not sampled coordinates."@en ; cd:authoredResource true .
  ex:ix-standard a cd:MathExpression ; cd:formulaLabel "Change units, not the shape of a distribution"@en ; cd:latex "Z=\\frac{X-\\mu}{\\sigma}" ; cd:hasSymbol ex:ix-standard-symbols ; dct:hasPart ex:ix-standard-legend ; cd:authoredResource true .
  ex:ix-standard-symbols a cd:MathSymbol ; cd:symbol "standardized distance" ; cd:mathNotation "X,\\mu,\\sigma,Z,=,-,/" ; cd:body "X: random measurement; mu: its population mean; sigma: its finite positive population SD, in the same units as X. Subtract the mean and divide by SD; equals defines dimensionless Z. Its mean is zero and variance one. This does not imply normality."@en ; cd:authoredResource true .
  ex:ix-standard-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-standard-entry ; cd:authoredResource true .
  ex:ix-standard-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and operations"@en ; dct:references ex:ix-standard-symbols ; cd:authoredResource true .
  ex:ix-standard-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-standard-c1, ex:ix-standard-c2 ; cd:authoredResource true .
  ex:ix-standard-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "How far from the mean"@en ; cd:body "Subtracting the mean centers the scale. Dividing by the population SD measures distance in SD units. A value of +2 is two SDs above the mean; -2 is two SDs below."@en ; cd:authoredResource true .
  ex:ix-standard-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "A coordinate change, not a normality machine"@en ; cd:body "A standardized uniform variable stays uniform. A standardized normal variable is standard normal. Corresponding events keep their probabilities; density heights and axis units change."@en ; cd:authoredResource true .
  ex:ix-phi a cd:MathExpression ; cd:formulaLabel "Lowercase phi is density; uppercase Phi is accumulated probability"@en ; cd:latex "\\begin{gathered}Z\\sim\\mathcal N(0,1),\\quad\\varphi(z)=\\frac{e^{-z^2/2}}{\\sqrt{2\\pi}}\\\\\\Phi(z)=P(Z\\le z)=\\int_{-\\infty}^{z}\\varphi(t)\\,dt\\\\\\Phi(1)\\approx0.8413,\\quad\\Phi^{-1}(0.95)\\approx1.64485\\end{gathered}" ; cd:hasSymbol ex:ix-phi-symbols, ex:ix-phi-ops ; dct:hasPart ex:ix-phi-legend ; cd:authoredResource true .
  ex:ix-phi-symbols a cd:MathSymbol ; cd:symbol "standard-normal functions" ; cd:mathNotation "Z,z,t,\\mathcal N,\\varphi,\\Phi,\\Phi^{-1},P" ; cd:body "Z: standard-normal random variable, mean 0 and variance 1; z: an SD-unit threshold; t: integration variable. Lowercase phi: density per z-unit, not a probability. Uppercase Phi: dimensionless probability at or below z. Inverse Phi maps a probability to its z quantile. P denotes probability; all arguments are dimensionless."@en ; cd:authoredResource true .
  ex:ix-phi-ops a cd:MathSymbol ; cd:symbol "density and integration notation" ; cd:mathNotation "\\sim,=,\\le,\\int,-\\infty,dt,e,\\pi,\\sqrt{},{}^2,/,-,\\approx,{}^{-1}" ; cd:body "Tilde names the law; equality defines functions; at most selects the left tail. Integrate density from minus infinity to z; dt identifies the integration variable. e is the exponential base; pi is the circle constant. Square z, negate, divide by 2, exponentiate and divide by the positive square root of 2 times pi. Approximately marks rounding. Superscript -1 means inverse function, not reciprocal."@en ; cd:authoredResource true .
  ex:ix-phi-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-phi-entry ; cd:authoredResource true .
  ex:ix-phi-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Functions, axes and notation"@en ; dct:references ex:ix-phi-symbols, ex:ix-phi-ops ; cd:authoredResource true .
  ex:ix-series-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-series-a, ex:ix-series-b, ex:ix-series-c ; cd:authoredResource true .
  ex:ix-series-a a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Series A: SD 0.056 mg/L"@en ; cd:body "9.97, 10.04, 10.08, 9.93, 10.02, 9.96 mg/L. Mean 10.000 mg/L; sample variance 0.00316 (mg/L)²."@en ; cd:authoredResource true .
  ex:ix-series-b a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Series B: SD 0.086 mg/L"@en ; cd:body "9.86, 10.05, 10.01, 10.12, 9.98, 9.98 mg/L. Mean 10.000 mg/L; sample variance 0.00748 (mg/L)²."@en ; cd:authoredResource true .
  ex:ix-series-c a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Series C: SD 0.128 mg/L"@en ; cd:body "9.84, 10.19, 9.93, 10.11, 9.99, 9.94 mg/L. Mean 10.000 mg/L; sample variance 0.01648 (mg/L)². All three are illustrative series compatible with one stable normal method, not measured validation data."@en ; cd:authoredResource true .
  ex:ix-square a cd:MathExpression ; cd:formulaLabel "Squaring removes the sign and creates a new distribution"@en ; cd:latex "\\begin{gathered}Z\\sim\\mathcal N(0,1),\\quad Y=Z^2\\sim\\chi^2_1\\\\(-2)^2=(+2)^2=4\\\\(-0.5)^2=(+0.5)^2=0.25\\end{gathered}" ; cd:hasSymbol ex:ix-square-symbols ; dct:hasPart ex:ix-square-legend ; cd:authoredResource true .
  ex:ix-square-symbols a cd:MathSymbol ; cd:symbol "one squared normal component" ; cd:mathNotation "Z,Y,\\mathcal N(0,1),\\chi^2_1,\\sim,=,{}^2,+,-" ; cd:body "Z: standard normal, mean zero, variance one. Y: its square. Tilde names a law; chi squared with subscript 1 is the chi-square family with one independent squared component, or one df. Equality evaluates squares; plus and minus mark direction; parentheses group signed values. All quantities are dimensionless; Y is nonnegative, not symmetric."@en ; cd:authoredResource true .
  ex:ix-square-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-square-entry ; cd:authoredResource true .
  ex:ix-square-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Square and one degree of freedom"@en ; dct:references ex:ix-square-symbols ; cd:authoredResource true .
  ex:ix-square-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-square-c1 ; cd:authoredResource true .
  ex:ix-square-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Two sides of the bell become one nonnegative scale"@en ; cd:body "Equal distances above and below the mean become the same squared distance. Many normal draws lie near zero; large squared distances are rare. The new distribution has a long right tail. Its density diverges near zero, but the probability of exactly zero is still zero."@en ; cd:authoredResource true .
  ex:ix-sum a cd:MathExpression ; cd:formulaLabel "Independent squares and the general chi-square density"@en ; cd:latex "\\begin{gathered}X=\\sum_{i=1}^{k}Z_i^2\\sim\\chi^2_k\\\\f_k(x)=\\frac{x^{k/2-1}e^{-x/2}}{2^{k/2}\\Gamma(k/2)},\\quad x>0,\\;k>0\\\\\\Gamma(a)=\\int_0^\\infty t^{a-1}e^{-t}\\,dt,\\quad a>0\\end{gathered}" ; cd:hasSymbol ex:ix-sum-symbols, ex:ix-density-symbols, ex:ix-gamma-symbols ; dct:hasPart ex:ix-sum-legend ; cd:authoredResource true .
  ex:ix-sum-symbols a cd:MathSymbol ; cd:symbol "independent components and sum" ; cd:mathNotation "Z_i,i,k,\\sum,{}^2,+,\\sim,\\chi^2_k" ; cd:body "Each Z indexed by i is an independent standard-normal variable, mean zero and variance one. i counts components from 1 through positive integer k. Square each component and add; plus and the summation sign express addition. Tilde names the chi-square law; its subscript is the number of independent squared components. All variables and sums are dimensionless. Independence is essential."@en ; cd:authoredResource true .
  ex:ix-sum-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-sum-entry, ex:ix-density-entry, ex:ix-gamma-entry ; cd:authoredResource true .
  ex:ix-density-symbols a cd:MathSymbol ; cd:symbol "chi-square density" ; cd:mathNotation "X,x,f_k(x),k,e,\\Gamma(k/2),>,=,/,{}^{}" ; cd:body "X is the dimensionless sum; lowercase x is a concrete value. f subscript k is its probability density, not a point probability. k is the degrees of freedom: a positive integer for the independent-square construction, any positive real for the density family. The formula applies for x>0; density is zero for x<0 and there is no point mass at zero. e is Euler's number; Gamma(k/2) normalizes the area to one. Superscripts are powers; juxtaposition multiplies, the fraction divides, minus subtracts or negates, equals defines, and > means greater than. Parentheses group function arguments."@en ; cd:authoredResource true .
  ex:ix-gamma-symbols a cd:MathSymbol ; cd:symbol "Gamma function" ; cd:mathNotation "\\Gamma,a,t,\\int_0^\\infty,dt" ; cd:body "Capital Gamma is defined by this improper integral for positive real argument a; here a=k/2. t is a dimensionless integration variable, not the Student t distribution. The integral accumulates from zero to positive infinity; dt specifies integration with respect to t. All quantities are dimensionless. At a positive integer m, Gamma(m) equals (m-1) factorial."@en ; cd:authoredResource true .
  ex:ix-density-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Density, support and degrees of freedom"@en ; dct:references ex:ix-density-symbols ; cd:authoredResource true .
  ex:ix-gamma-entry a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "The normalizing Gamma function"@en ; dct:references ex:ix-gamma-symbols ; cd:authoredResource true .
  ex:ix-sum-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "What the subscript counts"@en ; dct:references ex:ix-sum-symbols ; cd:authoredResource true .
  ex:ix-sum-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-sum-c1 ; cd:authoredResource true .
  ex:ix-sum-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Construction first, sample variance next"@en ; cd:body "Independent squared standard normals construct the chi-square distribution; the Gamma function normalizes its density. The six IC residuals share an estimated mean and are dependent: count their independent directions before applying the construction."@en ; cd:authoredResource true .
  ex:ix-residual a cd:MathExpression ; cd:formulaLabel "The missing sixth residual is already determined"@en ; cd:latex "\\begin{gathered}r_i=x_i-\\bar x,\\quad\\sum_{i=1}^{6}r_i=0\\\\r_6=-(r_1+r_2+r_3+r_4+r_5)=+0.10\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:ix-residual-symbols ; dct:hasPart ex:ix-residual-legend ; cd:authoredResource true .
  ex:ix-residual-symbols a cd:MathSymbol ; cd:symbol "centered residual constraint" ; cd:mathNotation "r_i,x_i,\\bar x,i,\\sum,=,-,+" ; cd:body "r indexed by i: reading x indexed by i minus fitted mean bar x=10.05 mg/L. i runs 1 to 6; subscripts identify the reading. Residuals and their sum have mg/L units. Sum all six to obtain zero. The minus before parentheses negates the sum of the first five; plus marks a positive residual. Equality expresses the fitted-mean identity, not a separate measurement."@en ; cd:authoredResource true .
  ex:ix-residual-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-residual-entry ; cd:authoredResource true .
  ex:ix-residual-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Residuals, index and units"@en ; dct:references ex:ix-residual-symbols ; cd:authoredResource true .
  ex:ix-residual-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-residual-c1, ex:ix-residual-c2 ; cd:authoredResource true .
  ex:ix-residual-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Cover the last residual"@en ; cd:body "First five residuals: -0.10, +0.10, -0.20, +0.20, -0.10 mg/L. Ask the class for the sixth before reading the formula. Change one of the first five: the sixth must compensate."@en ; cd:authoredResource true .
  ex:ix-residual-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Why fit the mean rather than subtract the nominal 10"@en ; cd:body "The nominal concentration need not equal the method's expected result: bias is possible. We fit today's mean 10.05 mg/L. One fitted mean removes one residual direction. The six raw residuals are not five independent standard normals plus zero."@en ; cd:authoredResource true .
  ex:ix-bessel-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-bessel-c1, ex:ix-bessel-c2 ; cd:authoredResource true .
  ex:ix-bessel-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Unbiasedness"@en ; cd:body "With iid observations of finite variance, the n-minus-one divisor makes sample variance unbiased. Normality is not required."@en ; cd:authoredResource true .
  ex:ix-bessel-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "The exact law needs normality"@en ; cd:body "Independent normal readings leave five orthonormal residual coordinates. Dividing those coordinates by true SD gives independent standard normals. Their squared sum is chi-square-five. The six raw residuals are dependent."@en ; cd:authoredResource true .
  ex:ix-sample-law a cd:MathExpression ; cd:formulaLabel "The exact sample-variance law uses the true population variance"@en ; cd:latex "\\frac{\\sum_{i=1}^{n}(X_i-\\bar X)^2}{\\sigma^2}=\\frac{(n-1)S^2}{\\sigma^2}\\sim\\chi^2_{n-1}" ; cd:hasSymbol ex:ix-sample-symbols ; dct:hasPart ex:ix-sample-legend ; cd:authoredResource true .
  ex:ix-sample-symbols a cd:MathSymbol ; cd:symbol "random sample variance and exact law" ; cd:mathNotation "X_i,\\bar X,S^2,\\sigma^2,n,i,\\sum,-,{}^2,/,=,\\sim,\\chi^2_{n-1}" ; cd:body "X indexed by i: independent normal measurements with common mean and variance; bar X: their random fitted mean; n: sample size at least two, here six. Sum squared deviations over i from one through n. S squared: their sample variance using divisor n minus one; sigma squared: true population variance, both in (mg/L) squared. The fraction cancels units. Equality rewrites the same squared sum; juxtaposition multiplies. Tilde gives its chi-square law with n minus one df, here five. This is not the test statistic with fixed reference variance unless true and reference variances agree."@en ; cd:authoredResource true .
  ex:ix-sample-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-sample-entry ; cd:authoredResource true .
  ex:ix-sample-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Population variance, sample variance and degrees of freedom"@en ; dct:references ex:ix-sample-symbols ; cd:authoredResource true .
  ex:ix-size a cd:MathExpression ; cd:formulaLabel "More repeats stabilize the variance estimate, not the unscaled Q value"@en ; cd:latex "\\begin{gathered}E(Q)=n-1,\\quad\\operatorname{Var}(Q)=2(n-1)\\\\\\operatorname{Var}(S^2)=\\frac{2\\sigma^4}{n-1},\\quad\\frac{\\operatorname{SD}(S^2)}{E(S^2)}=\\sqrt{\\frac{2}{n-1}}\\end{gathered}" ; cd:hasSymbol ex:ix-size-symbols ; dct:hasPart ex:ix-size-legend ; cd:authoredResource true .
  ex:ix-size-symbols a cd:MathSymbol ; cd:symbol "uncertainty across complete repeated series" ; cd:mathNotation "Q,n,S^2,\\sigma,E,\\operatorname{Var},\\operatorname{SD},=,-,{}^2,{}^4,/,\\sqrt{}" ; cd:body "n: number of independent normally distributed measurement results, at least two. S squared: random sample variance in (mg/L) squared; sigma: true SD in mg/L. Q: centered squared sum divided by true variance, dimensionless (the test Q has this law at sigma=sigma0). E: expectation; Var: variance; SD: positive square root of variance. Juxtaposition multiplies; subtract one fitted mean, divide and take the positive root. Sigma to fourth power and Var(S squared) have (mg/L) to fourth-power units. The SD-to-expectation ratio is dimensionless; display it as a percentage."@en ; cd:authoredResource true .
  ex:ix-size-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-size-entry ; cd:authoredResource true .
  ex:ix-size-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random estimates, operations and units"@en ; dct:references ex:ix-size-symbols ; cd:authoredResource true .
  ex:ix-size-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-size-c1, ex:ix-size-c2 ; cd:authoredResource true .
  ex:ix-size-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Six repeats: 5 df"@en ; cd:body "True SD remains 0.10 mg/L. Mean Q is 5; variance of Q is 10. Relative SD of the sample variance is 63.2%. A single six-result variance estimate is noisy."@en ; cd:authoredResource true .
  ex:ix-size-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Thirty repeats: 29 df"@en ; cd:body "Same true SD. Mean Q is 29; variance of Q is 58. Relative SD of the sample variance falls to 26.3%. Compare sample variances on the same physical scale: growing Q is not evidence of growing method variance."@en ; cd:authoredResource true .
  ex:ix-outlook-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ix-outlook-c1, ex:ix-outlook-c2 ; cd:authoredResource true .
  ex:ix-outlook-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "One method versus a fixed precision reference"@en ; cd:body "Our six results gave a variance of 0.024 (mg/L)². The chi-square reference made that estimate interpretable: evidence of poorer repeatability at the chosen 5% level, conditional on the assumptions. It did not diagnose the cause."@en ; cd:authoredResource true .
  ex:ix-outlook-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "What if neither true variance is known"@en ; cd:body "How could we compare two independent analytical methods, each with an estimated variance? Their variance ratio motivates F. First, we use the same estimated-variance uncertainty to understand t inference about a mean: estimating its standard error changes the reference law."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-ic-experiments> {
  ex:ix-opening a cd:SceneDefinition ; cd:focusConcept ex:l5-analytical-distributions ; dct:subject ex:l5-topic-functions ; cd:hasSceneItem ex:ix-map-h, ex:ix-map-c ; cd:narration "Follow the random quantity, not a list of unrelated distribution names. Individual measurement errors motivate normal models. A whole series yields a random variance estimate, then a random mean with estimated standard error. Two independent series yield a variance ratio. Each new reference law solves an analytical question under explicit assumptions. Lognormal models and model checks remain part of the broader lecture; the final dilution Monte Carlo case combines input distributions in one measurement process."@en ; cd:authoredResource true .
  ex:ix-map-title a cd:Interpretation ; skos:prefLabel "Our route: measurements, models, decisions and uncertainty"@en ; cd:authoredResource true .
  ex:ix-map-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-map-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-map-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-map-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-standardization a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-z ; cd:hasSceneItem ex:ix-standard-h, ex:ix-standard-c, ex:ix-standard-f ; cd:narration "After PDF, CDF and inverse CDF, introduce a change of coordinates that will recur throughout the lecture. This definition uses the population mean and positive finite population SD. It is not a claim that all measurements are normal. Centering and scaling preserve corresponding event probabilities. Later, standardizing a sample mean with its estimated standard error will be a different random construction."@en ; cd:authoredResource true .
  ex:ix-standard-title a cd:Interpretation ; skos:prefLabel "Standardization: distance in standard-deviation units"@en ; cd:authoredResource true .
  ex:ix-standard-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-standard-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-standard-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-standard-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-standard-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-standard ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-phi-scene a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-z ; cd:hasSceneItem ex:ix-phi-h, ex:ix-phi-f ; cd:narration "We have motivated the normal model and transformed it to standard-normal coordinates. Name its density lowercase phi and its CDF uppercase Phi before using either in calculations. Phi is the integrated density, not a density height. The inverse CDF returns a threshold, not a reciprocal. The next control case uses the same functions in concentration units with mean 10.0 and SD 0.30 mg/L; that SD is distinct from the later IC precision reference 0.10 mg/L."@en ; cd:authoredResource true .
  ex:ix-phi-title a cd:Interpretation ; skos:prefLabel "Name the standard-normal PDF and CDF: phi and Phi"@en ; cd:authoredResource true .
  ex:ix-phi-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-phi-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-phi-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-phi ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-new-series a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-series-h, ex:ix-series-items ; cd:narration "The six observed IC results have raised a question, not established a diagnosis. Here are three illustrative new six-reading series. They share a constructed mean of 10.000 but give different variances and SDs; real repeated series would generally have different sample means too. All three could arise from one stable normal method. Sigma is fixed in that model, while the estimated s and s squared vary from sample to sample. Next repeat entire series, never just perturb an already computed variance."@en ; cd:authoredResource true .
  ex:ix-series-title a cd:Interpretation ; skos:prefLabel "Same method, different spreads"@en ; cd:authoredResource true .
  ex:ix-series-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-series-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-series-items a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-series-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-square-scene a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-square-h, ex:ix-square-v, ex:ix-square-f ; cd:narration "Return to a single standard-normal draw. Its sign gives direction, but variance uses squared distances. Both tails fold onto one nonnegative axis after squaring. The resulting one-df chi-square law is strongly right-skewed. Zero is in the support but has no point probability, just as any exact value of a continuous variable. The graphic is schematic; the formula specifies the exact law. We have not yet applied this to centered IC residuals."@en ; cd:authoredResource true .
  ex:ix-square-title a cd:Interpretation ; skos:prefLabel "From one normal draw to one squared distance"@en ; cd:authoredResource true .
  ex:ix-square-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-square-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-square-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-square-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-square-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-square-media ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-square-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-square ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-sum-scene a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-sum-h, ex:ix-sum-c, ex:ix-sum-f ; cd:narration "Generate independent standard normals, square each and add. Two terms give two df, three terms give three, and k independent components give k df. Independence is a mathematical condition, not supplied by writing different subscripts. The next residual experiment explains why six readings with an estimated mean do not give six independent squared components."@en ; cd:authoredResource true .
  ex:ix-sum-title a cd:Interpretation ; skos:prefLabel "Add independent squares to construct chi-square"@en ; cd:authoredResource true .
  ex:ix-sum-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-sum-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-sum-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-sum-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-sum-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-sum ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-residual-scene a cd:SceneDefinition ; cd:focusConcept ex:rev-df ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-residual-h, ex:ix-residual-c, ex:ix-residual-f ; cd:narration "Ask for the sixth residual using the first five. Their sum is minus 0.10, so the missing residual is plus 0.10 mg/L. The zero-sum identity uses all six values through their fitted mean; it does not recover an unknown raw measurement without that information. Changing one residual while retaining the zero-sum constraint forces compensation elsewhere. Five independent directions remain, not five independent raw residuals."@en ; cd:authoredResource true .
  ex:ix-residual-title a cd:Interpretation ; skos:prefLabel "Six residuals, but the sixth cannot vary freely"@en ; cd:authoredResource true .
  ex:ix-residual-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-residual-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-residual-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-residual-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-residual-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-residual ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-bessel-scene a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-bessel-h, ex:ix-bessel-c, ex:ix-bessel-f ; cd:narration "Keep unbiasedness and the full sampling law separate. The Bessel correction is not a normality theorem. An orthonormal change of coordinates preserves the residual squared norm; under the independent normal model, the five standardized residual coordinates are independent standard normals. This is the bridge from the construction to the exact chi-square-five reference. The denominator in this general law is true variance. Replacing it by the fixed QC reference gives that exact reference only at the null boundary."@en ; cd:authoredResource true .
  ex:ix-bessel-title a cd:Interpretation ; skos:prefLabel "Unbiased variance is not yet an exact chi-square law"@en ; cd:authoredResource true .
  ex:ix-bessel-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-bessel-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-bessel-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-bessel-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-bessel-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-sample-law ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-scene a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-size-h, ex:ix-size-c, ex:ix-size-f ; cd:narration "Hold true SD fixed at 0.10 mg/L and change only the number of independent repeats. Q changes scale with df: do not interpret its larger mean as worse precision. Compare sample variance on the physical scale, or relative to true variance. Its relative SD falls from about 63.2 percent with six readings to 26.3 percent with thirty. More repeats improve precision estimation but do not repair bias, drift or dependence."@en ; cd:authoredResource true .
  ex:ix-size-title a cd:Interpretation ; skos:prefLabel "What changes when six repeats become thirty"@en ; cd:authoredResource true .
  ex:ix-size-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-size-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-size-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-size-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ix-size ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-outlook a cd:SceneDefinition ; cd:focusConcept ex:al-chi-square ; dct:subject ex:l5-topic-chi ; cd:hasSceneItem ex:ix-outlook-h, ex:ix-outlook-c ; cd:narration "Close the original QC question before opening a new one. This known-reference test is conditional on normal independent readings and a fixed baseline SD. With two uncertain independent variance estimates, a ratio and an F reference are needed. Before that section, use the uncertainty of estimated variance to motivate t for the mean standardized using its estimated standard error. Raw sample means from normal observations remain normal; it is the studentized ratio that has the t law."@en ; cd:authoredResource true .
  ex:ix-outlook-title a cd:Interpretation ; skos:prefLabel "From one precision reference to two uncertain variances"@en ; cd:authoredResource true .
  ex:ix-outlook-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ix-outlook-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ix-outlook-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ix-outlook-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
