<https://w3id.org/project-chemie-digital/graph/scenes/level7-anova-intro> {
  ex:l7-intro-chart-07 a cd:ChartDefinition ;
    skos:prefLabel "Group means and the grand mean"@en ;
    cd:body "Each dot is one preparation. The mean markers show A at 94%, B at 98% and C at 93%. The horizontal line shows the mean of all 18 recoveries, 95%."@en ;
    cd:chartType cd:DotPlot ; cd:xAxisLabel "SPE method"@en ;
    cd:yAxisLabel "Recovery"@en ; cd:yAxisUnit "%" ;
    cd:hasChartGroup ex:l7-intro-mean-group-A, ex:l7-intro-mean-group-B, ex:l7-intro-mean-group-C ;
    cd:hasChartAnnotation ex:l7-intro-grand-mean-line ;
    cd:observationLabel "Sample preparations" ; cd:summaryLabel "Method mean" ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-grand-mean-result a cd:StatisticalResult ; cd:numericValue 95.0 ; cd:unit "%" ;
    cd:quantifiesProperty ex:arithmetic-mean ;
    cd:usesDataset ex:l7-spe-R-A, ex:l7-spe-R-B, ex:l7-spe-R-C ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-grand-mean-line a cd:ChartReferenceLine ; cd:position 1 ;
    cd:body "Grand mean"@en ; cd:referenceResult ex:l7-intro-grand-mean-result ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .

  ex:l7-intro-mean-group-A a cd:ChartGroup ; cd:position 1 ;
    skos:prefLabel "Method A"@en ; cd:usesDataset ex:l7-spe-R-A ;
    cd:summaryResult ex:l7-intro-mean-result-A ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-mean-result-A a cd:StatisticalResult ;
    cd:numericValue 94.0 ; cd:unit "%" ; cd:quantifiesProperty ex:arithmetic-mean ;
    cd:usesDataset ex:l7-spe-R-A ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .

  ex:l7-intro-mean-group-B a cd:ChartGroup ; cd:position 2 ;
    skos:prefLabel "Method B"@en ; cd:usesDataset ex:l7-spe-R-B ;
    cd:summaryResult ex:l7-intro-mean-result-B ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-mean-result-B a cd:StatisticalResult ;
    cd:numericValue 98.0 ; cd:unit "%" ; cd:quantifiesProperty ex:arithmetic-mean ;
    cd:usesDataset ex:l7-spe-R-B ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .

  ex:l7-intro-mean-group-C a cd:ChartGroup ; cd:position 3 ;
    skos:prefLabel "Method C"@en ; cd:usesDataset ex:l7-spe-R-C ;
    cd:summaryResult ex:l7-intro-mean-result-C ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-mean-result-C a cd:StatisticalResult ;
    cd:numericValue 93.0 ; cd:unit "%" ; cd:quantifiesProperty ex:arithmetic-mean ;
    cd:usesDataset ex:l7-spe-R-C ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .

  ex:l7-intro-scene07 a cd:SceneDefinition ;
    cd:focusConcept ex:arithmetic-mean ;
    cd:hasSceneItem ex:l7-intro-item-07-1, ex:l7-intro-item-07-2, ex:l7-intro-item-07-3 ;
    cd:narration "Keep the same eighteen dots in view. Each is one recovery measurement from a synthetic sample preparation, with six observations for each SPE method. An arithmetic mean adds the observations and divides by their count. The mean markers locate these averages: 94% for A, 98% for B and 93% for C. The horizontal line marks the grand mean of all eighteen observations, 95%. Because the groups have equal size, each method contributes equally to that overall average. With unequal group sizes, methods with more preparations contribute more to the grand mean. Next, we will use these same dots and centers to distinguish distances within groups from distances between group means and the grand mean."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-item-07-1 a cd:SceneItem ; cd:position 1 ; cd:language "en" ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:l7-heading-07 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-item-07-2 a cd:SceneItem ; cd:position 2 ; cd:language "en" ;
    cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ;
    cd:selectsResource ex:l7-intro-chart-07 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .

  ex:l7-intro-item-07-3 a cd:SceneItem ; cd:position 3 ; cd:language "en" ;
    cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:l7-intro-means-formula ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-means-formula a cd:MathExpression ; skos:prefLabel "How to calculate the means"@en ;
    cd:body "How to calculate the means"@en ;
    cd:latex "\\begin{aligned}\\bar{x}_i&=\\frac{1}{n_i}\\sum_{j=1}^{n_i}y_{ij}\\\\\\bar{x}&=\\frac{1}{N}\\sum_{i=1}^{k}n_i\\bar{x}_i,\\qquad N=\\sum_{i=1}^{k}n_i\\end{aligned}" ;
    <http://purl.org/dc/terms/hasPart> ex:l7-intro-means-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-means-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l7-intro-means-symbols ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-means-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and conventions"@en ;
    cd:body """- **$y_{ij}$**: Recovery (%) for independent preparation j in group i.
- **i**: Method index from 1 to k, in order A, B and C.
- **j**: Preparation index within a method, from 1 to $n_i$.
- **$n_i$; N**: Number of preparations in group i and total number of preparations.
- **k**: Number of groups (3 here).
- **$\\bar{x}_i$; $\\bar{x}$**: Group mean and grand mean recovery (%). A bar denotes an arithmetic mean.
- **Σ; =**: Sum over the shown indices and equality. Dividing by the count gives an average. The product $n_i$ $\\bar{x}_i$ is the total recovery for group i.

With equal group sizes, the grand mean is also the unweighted mean of the group means."""@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-intro-item-07-3, ex:l7-intro-means-formula, ex:l7-intro-means-legend, ex:l7-intro-means-symbols .

