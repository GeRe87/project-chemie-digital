  ex:l7-intro-scene13 a cd:SceneDefinition ;
    cd:focusConcept ex:l7-one-way-anova ;
    cd:hasSceneItem ex:l7-intro-f-ratio-heading-item, ex:l7-intro-f-ratio-item ;
    cd:narration "Start with the three preparation methods at their original settings. Increase MS between to spread the method means apart. Then increase MS within to widen the scatter around each method mean. Watch F rise with its numerator and fall with its denominator. The curve has 2 numerator and 15 denominator degrees of freedom. The shaded right tail begins at the observed F. At the initial settings, its area is approximately 0.00004484. The p-value is the upper-tail probability for the resulting F statistic under the equal-means hypothesis and the ANOVA assumptions. At zero within-group scatter the ratio is undefined."@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-intro-f-ratio-heading-item a cd:SceneItem ; cd:position 1 ; cd:language "en" ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:l7-heading-13 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
