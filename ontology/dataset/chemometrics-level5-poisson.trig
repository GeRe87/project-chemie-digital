<https://w3id.org/project-chemie-digital/graph/sources/poisson-model> {
  ex:l5-source-r-poisson a cd:Source ; dct:title "R stats: The Poisson Distribution" ; dct:creator "R Core Team" ; dct:identifier "l5-source-r-poisson" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Poisson.html> ; cd:supportsResource ex:l5-poisson-definition ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/knowledge/poisson-model> {
  ex:l5-poisson-formula cd:body "Poisson count probability is exponential minus lambda times lambda to k, divided by k factorial."@en .
  ex:l5-volume-formula cd:body "Expected detected count lambda equals constant detected-event intensity r times volume V. Expected count and variance both have numerical value lambda."@en .
  ex:l5-poisson-limit-formula cd:body "The binomial distributions converge to Poisson when n grows without bound, p tends to zero and n times p tends to a finite lambda."@en .
  ex:poisson-distribution a cd:Concept ; skos:prefLabel "Poisson distribution"@en ; cd:hasDefinition ex:l5-poisson-definition ; cd:authoredResource true .
  ex:l5-poisson-definition a cd:Definition ; cd:body "The Poisson model describes an event count in a fixed exposure under an idealized homogeneous, independent event process with constant intensity. The expected count and variance are numerically equal. The support is all nonnegative integers, not a fixed number of trials. Counts alone do not justify this model. Detected particle counts also depend on sampling, preparation and detection conditions."@en ; cd:hasSource ex:l5-source-r-poisson ; cd:authoredResource true .

  ex:l5-poisson-formula a cd:MathExpression ; cd:formulaLabel "Poisson count probabilities"@en ; cd:latex "P(K=k)=e^{-\\lambda}\\frac{\\lambda^k}{k!}" ; dct:hasPart ex:l5-poisson-legend ; cd:hasSymbol ex:l5-p-symbol-counts, ex:l5-p-symbol-lambda, ex:l5-p-symbol-probability, ex:l5-p-symbol-exp, ex:l5-p-symbol-factorial ; cd:hasSource ex:l5-source-r-poisson ; cd:authoredResource true .
  ex:l5-poisson-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-poisson-legend-entry ; cd:authoredResource true .
  ex:l5-poisson-legend-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-p-symbol-counts, ex:l5-p-symbol-lambda, ex:l5-p-symbol-probability, ex:l5-p-symbol-exp, ex:l5-p-symbol-factorial ; cd:authoredResource true .
  ex:l5-p-symbol-counts a cd:MathSymbol ; cd:symbol "K, k" ; cd:mathNotation "K,\\ k" ; cd:body "Random detected count and chosen nonnegative integer; no finite upper bound."@en ; cd:authoredResource true .
  ex:l5-p-symbol-lambda a cd:MathSymbol ; cd:symbol "lambda" ; cd:mathNotation "\\lambda" ; cd:body "Expected detected count in the fixed exposure, here 4 in 100 mL."@en ; cd:authoredResource true .
  ex:l5-p-symbol-probability a cd:MathSymbol ; cd:symbol "P(K=k)" ; cd:mathNotation "P(K=k)" ; cd:body "Probability of exactly k, dimensionless. Inner equality defines the event; outer equality states an identity."@en ; cd:authoredResource true .
  ex:l5-p-symbol-exp a cd:MathSymbol ; cd:symbol "e and powers" ; cd:mathNotation "e^{-\\lambda}\\lambda^k" ; cd:body "e: Euler's number. Superscripts are powers; minus negates lambda. Multiply adjacent factors; divide by k factorial."@en ; cd:authoredResource true .
  ex:l5-p-symbol-factorial a cd:MathSymbol ; cd:symbol "k factorial" ; cd:mathNotation "k!" ; cd:body "Factorial: product of integers from 1 to k; zero factorial is one."@en ; cd:authoredResource true .

  ex:l5-volume-formula a cd:MathExpression ; cd:formulaLabel "Exposure, expected count and variance"@en ; cd:latex "\\begin{gathered}\\lambda=rV\\\\E[K]=\\lambda,\\quad\\operatorname{Var}(K)=\\lambda\\end{gathered}" ; dct:hasPart ex:l5-volume-legend ; cd:hasSymbol ex:l5-volume-lambda, ex:l5-volume-rate, ex:l5-volume-exposure, ex:l5-volume-moments ; cd:hasSource ex:l5-source-r-poisson ; cd:authoredResource true .
  ex:l5-volume-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-volume-legend-entry ; cd:authoredResource true .
  ex:l5-volume-legend-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and units"@en ; dct:references ex:l5-volume-lambda, ex:l5-volume-rate, ex:l5-volume-exposure, ex:l5-volume-moments ; cd:authoredResource true .
  ex:l5-volume-moments a cd:MathSymbol ; cd:symbol "K, E, Var" ; cd:mathNotation "K,\\ E[\\cdot],\\ \\operatorname{Var}(\\cdot)" ; cd:body "K: random count. E: expectation in counts; Var: variance in squared counts. Brackets enclose the argument."@en ; cd:authoredResource true .
  ex:l5-volume-lambda a cd:MathSymbol ; cd:symbol "lambda" ; cd:mathNotation "\\lambda" ; cd:body "Expected detected particle count in volume V. The equals sign states the model relation, not a realized count."@en ; cd:authoredResource true .
  ex:l5-volume-rate a cd:MathSymbol ; cd:symbol "r" ; cd:mathNotation "r" ; cd:body "Constant detected-event intensity, here 0.04 particles per mL. This includes detection performance, not necessarily the true particle concentration."@en ; cd:authoredResource true .
  ex:l5-volume-exposure a cd:MathSymbol ; cd:symbol "V and multiplication" ; cd:mathNotation "V,\\ rV" ; cd:body "V is the examined volume in mL. Adjacent r and V multiply: particles per mL times mL gives an expected particle count."@en ; cd:authoredResource true .

  ex:l5-poisson-limit-formula a cd:MathExpression ; cd:formulaLabel "A rare-event limit, not a rule for every count"@en ; cd:latex "\\begin{gathered}n\\to\\infty,\\quad p\\to0,\\quad np\\to\\lambda\\\\\\operatorname{Bin}(n,p)\\Rightarrow\\operatorname{Pois}(\\lambda)\\end{gathered}" ; dct:hasPart ex:l5-poisson-limit-legend ; cd:hasSymbol ex:l5-limit-np, ex:l5-limit-lambda, ex:l5-limit-arrows, ex:l5-limit-models ; cd:hasSource ex:l5-source-r-poisson, ex:l5-source-r-binomial ; cd:authoredResource true .
  ex:l5-poisson-limit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-poisson-limit-entry ; cd:authoredResource true .
  ex:l5-poisson-limit-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-limit-np, ex:l5-limit-lambda, ex:l5-limit-arrows, ex:l5-limit-models ; cd:authoredResource true .
  ex:l5-limit-np a cd:MathSymbol ; cd:symbol "n, p, np" ; cd:mathNotation "n,\\ p,\\ np" ; cd:body "n is the independent trial count; p is the common success probability. Adjacent symbols multiply; np is the expected count."@en ; cd:authoredResource true .
  ex:l5-limit-lambda a cd:MathSymbol ; cd:symbol "lambda" ; cd:mathNotation "\\lambda" ; cd:body "Finite limiting expected count, held fixed as trials become numerous and individual successes rare. Counts and probabilities are dimensionless."@en ; cd:authoredResource true .
  ex:l5-limit-arrows a cd:MathSymbol ; cd:symbol "limit and convergence" ; cd:mathNotation "\\to,\\ \\infty,\\ \\Rightarrow" ; cd:body "The thin arrow means tends to; infinity denotes unbounded growth. The double arrow means convergence in distribution, not equality for finite n."@en ; cd:authoredResource true .
  ex:l5-limit-models a cd:MathSymbol ; cd:symbol "Bin, Pois" ; cd:mathNotation "\\operatorname{Bin}(n,p),\\ \\operatorname{Pois}(\\lambda)" ; cd:body "Bin and Pois name the binomial and Poisson distributions. Parentheses contain their parameters; zero is the limit of p."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-poisson> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:poisson-distribution .
  ex:l5-p07a-title a cd:Interpretation ; skos:prefLabel "Use a water volume to study particle intensity"@en ; cd:authoredResource true .
  ex:l5-p07a-context a cd:Interpretation ; cd:body "Filter a selected 100 mL portion to study detected particle intensity. Counts fluctuate; connecting the portion to the water body requires a justified sampling design."@en ; cd:authoredResource true .
  ex:l5-p07a-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-particle-filters.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Three constructed filter illustrations, each representing 100 mL, show 2, 4 and 6 detected particles. These illustrative counts are not measurements or a simulated dataset."@en ; cd:body "Three illustrative equal-volume counts: 2, 4 and 6 particles per 100 mL. Natural clustering, heterogeneous concentrations and detection errors can violate a Poisson model."@en ; cd:authoredResource true .
  ex:l5-p07b-title a cd:Interpretation ; skos:prefLabel "Counting variation limits an intensity estimate"@en ; cd:authoredResource true .
  ex:l5-p07c-title a cd:Interpretation ; skos:prefLabel "Relate the particle count to sampled volume"@en ; cd:authoredResource true .
  ex:l5-p07d-title a cd:Interpretation ; skos:prefLabel "Match the count model to the sampling unit"@en ; cd:authoredResource true .
  ex:l5-p07d-context a cd:Interpretation ; cd:body "Finding frequency uses selected binary units; detected intensity uses counts per exposure. The sampling unit determines what population quantity a count can inform."@en ; cd:authoredResource true .

  ex:l5-poisson-chart a cd:ChartDefinition ; skos:prefLabel "Poisson model: expected count 4 in 100 mL"@en ; cd:body "Mean 4, variance 4. Zero: 1.8316%; at least one: 98.1684%. The 17+ bar includes the entire remaining tail. Model probabilities, not measurements."@en ; cd:chartType cd:BarChart ; cd:xAxisLabel "Detected count"@en ; cd:yAxisLabel "Model probability"@en ; cd:usesDataset ex:l5-poisson-four-data ; cd:hasSource ex:l5-source-r-poisson ; cd:authoredResource true .
  ex:l5-volume-chart a cd:ChartDefinition ; skos:prefLabel "100 mL: expected count 4; 200 mL: expected count 8"@en ; cd:body "100 mL: mean and variance 4. 200 mL: mean and variance 8. Same detected-event intensity; one shared probability scale. The 17+ bars include the full tails."@en ; cd:chartType cd:BarChart ; cd:xAxisLabel "Detected count"@en ; cd:yAxisLabel "Model probability"@en ; cd:usesDataset ex:l5-poisson-volume-data ; cd:hasSource ex:l5-source-r-poisson ; cd:authoredResource true .
  ex:l5-poisson-four-data a cd:Dataset ; skos:prefLabel "Authored Poisson(4) probability table, percent, not observations of water"@en ; cd:unit "%" ; cd:derivedFromResource ex:l5-poisson-formula ; cd:hasObservation ex:l5-p4-0, ex:l5-p4-1, ex:l5-p4-2, ex:l5-p4-3, ex:l5-p4-4, ex:l5-p4-5, ex:l5-p4-6, ex:l5-p4-7, ex:l5-p4-8, ex:l5-p4-9, ex:l5-p4-10, ex:l5-p4-11, ex:l5-p4-12, ex:l5-p4-13, ex:l5-p4-14, ex:l5-p4-15, ex:l5-p4-16, ex:l5-p4-tail ; cd:authoredResource true .
  ex:l5-poisson-volume-data a cd:Dataset ; skos:prefLabel "Authored model probabilities for equal intensity and two volumes"@en ; cd:unit "%" ; cd:derivedFromResource ex:l5-poisson-formula, ex:l5-volume-formula ; cd:hasObservation ex:l5-p4-0, ex:l5-p4-1, ex:l5-p4-2, ex:l5-p4-3, ex:l5-p4-4, ex:l5-p4-5, ex:l5-p4-6, ex:l5-p4-7, ex:l5-p4-8, ex:l5-p4-9, ex:l5-p4-10, ex:l5-p4-11, ex:l5-p4-12, ex:l5-p4-13, ex:l5-p4-14, ex:l5-p4-15, ex:l5-p4-16, ex:l5-p4-tail, ex:l5-p8-0, ex:l5-p8-1, ex:l5-p8-2, ex:l5-p8-3, ex:l5-p8-4, ex:l5-p8-5, ex:l5-p8-6, ex:l5-p8-7, ex:l5-p8-8, ex:l5-p8-9, ex:l5-p8-10, ex:l5-p8-11, ex:l5-p8-12, ex:l5-p8-13, ex:l5-p8-14, ex:l5-p8-15, ex:l5-p8-16, ex:l5-p8-tail ; cd:authoredResource true .
