  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/authoredResource> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/hasSource> <https://w3id.org/project-chemie-digital/resource/l7-source-package> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/numericValue> "2"^^<http://www.w3.org/2001/XMLSchema#decimal> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/parameterKey> "view" .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/parameterMaximum> "2"^^<http://www.w3.org/2001/XMLSchema#decimal> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/parameterMinimum> "0"^^<http://www.w3.org/2001/XMLSchema#decimal> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/parameterStep> "1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-view> <https://w3id.org/project-chemie-digital/ontology/position> "3"^^<http://www.w3.org/2001/XMLSchema#integer> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/project-chemie-digital/ontology/ExperimentParameter> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <http://www.w3.org/2004/02/skos/core#prefLabel> "Within-group scatter"@en .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <https://w3id.org/project-chemie-digital/ontology/adjustableParameter> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <https://w3id.org/project-chemie-digital/ontology/authoredResource> "true"^^<http://www.w3.org/2001/XMLSchema#boolean> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <https://w3id.org/project-chemie-digital/ontology/hasSource> <https://w3id.org/project-chemie-digital/resource/l7-source-package> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <https://w3id.org/project-chemie-digital/ontology/numericValue> "1"^^<http://www.w3.org/2001/XMLSchema#decimal> .
  <https://w3id.org/project-chemie-digital/resource/l7-control-19-withinScale> <https://w3id.org/project-chemie-digital/ontology/parameterKey> "withinScale" .
