@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-presentation-specifications> {
  ex:cogniflow-presentation-specifications a cd:Concept ;
    skos:prefLabel "A Semantic Model for This Presentation"@en ;
    cd:hasDefinition ex:def-cogniflow-presentation-specifications ;
    cd:authoredResource true .

  ex:def-cogniflow-presentation-specifications a cd:Definition ;
    cd:body "The same semantics-first pattern can describe presentation elements: an InfoBox combines explicit text with a reusable Theme, while a concrete specification selects the actual message and visual theme."@en ;
    cd:authoredResource true .

  ex:cogniflow-presentation-grammar-banner a cd:Interpretation ;
    cd:body """PRESENTATION CONCEPT DOMAIN
one InfoBox · explicit Text · reusable Theme"""@en ;
    cd:authoredResource true .

  ex:cogniflow-presentation-cards a cd:Interpretation ;
    cd:body "A meta example in which the presentation describes one of its own visual building blocks."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-presentation-domain,
      ex:keypoint-cogniflow-infobox,
      ex:keypoint-cogniflow-infobox-specification ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-presentation-domain a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """CONCEPT DOMAIN
PRESENTATION
defines PresentationElement
InfoBox · Text
Theme · ThemeToken"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-infobox a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """INFO BOX
a PresentationElement

hasText → Text
usesTheme → Theme
Theme defines surface
border · typography · accent"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-infobox-specification a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """SPECIFICATION
PROCESSING UNIT INFO BOX

TEXT · "PROCESSING UNIT"
THEME · Eco City
PROJECTION · InfoBox
TYPE · Mono / bold"""@en ;
    cd:authoredResource true .

  ex:cogniflow-presentation-compatibility-note a cd:Interpretation ;
    cd:body "SAME SEMANTICS — DIFFERENT PROJECTIONS"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-presentation-specifications-extension> {
  ex:path-step-cogniflow-presentation-specifications a cd:PathStep ;
    cd:position 12 ;
    cd:usesResource ex:cogniflow-presentation-grammar-banner,
      ex:cogniflow-presentation-cards,
      ex:cogniflow-presentation-compatibility-note ;
    cd:usesScene ex:scene-cogniflow-presentation-specifications ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-presentation-specifications> {
  ex:scene-cogniflow-presentation-specifications a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-presentation-specifications ;
    cd:hasSceneItem ex:scene-item-cogniflow-presentation-specifications-heading,
      ex:scene-item-cogniflow-presentation-specifications-grammar,
      ex:scene-item-cogniflow-presentation-specifications-cards,
      ex:scene-item-cogniflow-presentation-specifications-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-presentation-specifications-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-presentation-specifications ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-presentation-specifications-grammar a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-presentation-grammar-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-presentation-specifications-cards a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-presentation-cards ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-presentation-specifications-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-presentation-compatibility-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
