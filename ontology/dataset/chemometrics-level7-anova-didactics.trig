# Scene types and pilot content roles.

<https://w3id.org/project-chemie-digital/graph/paths/level7-anova-intro-review> {
  # Point clouds: the lab observation answers the preceding comparison question.
  ex:l7-step-spread-lab cd:teachingObservation ex:l7-spread-observation ;
    cd:teachingTakeaway ex:l7-spread-takeaway .

  # Recovery table: the observed ratio answers only the sample-level part of the question.
  ex:l7-intro-step-08 cd:teachingHint ex:l7-intro-heading-08 .
  ex:l7-intro-step-12 cd:teachingPartialAnswer ex:l7-intro-takeaway-12 ;
    cd:teachingPartialAnswerTo ex:l7-intro-heading-06 .
  ex:l7-intro-step-11 cd:teachingTakeaway ex:l7-intro-takeaway-11 .
  ex:l7-treatment-observations-step cd:teachingHint ex:l7-treatment-observations-takeaway .

  # Tukey: separate the decision rule from the result for the two matrices.
  ex:l7-post-hoc-rule-step cd:teachingTakeaway ex:l7-post-hoc-rule-takeaway .
}

