  ex:l4-gap-data a cd:ComparisonStage ; cd:position 2 ; skos:prefLabel "Reveal observations"@en ; cd:comparisonMode "spread" ; cd:body "Equal summaries do not uniquely determine the empirical distribution."@en ; cd:allowSeriesOverlay true ; cd:hasKeyPoint ex:l4-opening-data-sd-guide ; cd:authoredResource true .

  ex:l4-needs-position a cd:ComparisonStage ; cd:position 1 ; skos:prefLabel "Position"@en ; cd:comparisonMode "rank" ; cd:body "Where do observations lie within the ordered data?"@en ; dct:references ex:order-statistic, ex:sample-quantile ; cd:authoredResource true .
