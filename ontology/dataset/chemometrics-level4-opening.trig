  ex:l4-shapes-overview a cd:ComparisonStage ; cd:position 1 ; skos:prefLabel "Same summaries, different shapes"@en ; cd:comparisonMode "distribution" ; cd:body "Vertical offsets separate observations. SD bars are not confidence intervals."@en ; cd:authoredResource true .
