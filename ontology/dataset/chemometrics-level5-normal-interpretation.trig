  ex:l5-n10c-reading a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "The tool we just used"@en ; cd:body "10.49 mg/L is a one-sided quantile of a specified analytical model. It does not estimate the water body's mean."@en ; cd:authoredResource true .
  ex:l5-n10c-mean a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "The target"@en ; cd:body "Estimate the water-body mean from selected water samples. Account for sample variation and lab error."@en ; cd:authoredResource true .
