  ex:l5-n11a-repeat a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Within one collected sample"@en ; cd:body "Repeated UV/Vis measurements describe analytical variation and possible bias, not coverage of the water body."@en ; cd:authoredResource true .
  ex:l5-n11a-sites a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Between selected water units"@en ; cd:body "Sources, transport and dilution add variation. Selection across locations and depths must match the target volume."@en ; cd:authoredResource true .
