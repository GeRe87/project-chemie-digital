  ex:l5-n11d-limits a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Preserve reporting limits"@en ; cd:body "Missing and below-limit results are not automatically true zeros. Keep censoring and detection information."@en ; cd:authoredResource true .
