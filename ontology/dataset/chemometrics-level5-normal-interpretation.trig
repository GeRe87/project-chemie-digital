<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-interpretation> {
  ex:measurement-versus-site-variation a cd:Concept ; skos:prefLabel "Measurement variation versus environmental variation"@en ; cd:hasDefinition ex:l5-n11-definition ; cd:authoredResource true .
  ex:l5-n11-definition a cd:Definition ; cd:body "Repeated measurements of one homogeneous sample reflect analytical variability under specified conditions. Concentrations across environmental sites also reflect heterogeneous sources and environmental processes. A normal analytical-error model does not imply a normal distribution across sites. Positivity and right skew alone do not establish a lognormal distribution."@en ; cd:authoredResource true .
  ex:l5-n10b-formula a cd:MathExpression ; cd:formulaLabel "The model's one-sided 95% threshold"@en ; cd:body "The 0.95 quantile equals the model mean plus the standard-normal 0.95 quantile times the standard deviation. Ten plus 1.64485 times 0.30 is approximately 10.49 milligrams per litre."@en ; cd:latex "\\begin{gathered}q_{0.95}=\\mu+z_{0.95}\\sigma\\\\\\approx10.0+1.64485\\cdot0.30\\\\\\approx10.49\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:l5-nq-threshold, ex:l5-nq-standard, ex:l5-nq-parameters, ex:l5-nq-operators ; dct:hasPart ex:l5-n10b-legend ; cd:hasSource ex:l5-source-r-normal ; cd:authoredResource true .
  ex:l5-n10b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-nq-entry ; cd:authoredResource true .
  ex:l5-nq-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and convention"@en ; dct:references ex:l5-nq-threshold, ex:l5-nq-standard, ex:l5-nq-parameters, ex:l5-nq-operators ; cd:authoredResource true .
  ex:l5-nq-threshold a cd:MathSymbol ; cd:symbol "q and probability index" ; cd:mathNotation "q_{0.95}" ; cd:body "Concentration threshold in mg/L with 95% model probability below it. The subscript 0.95 is a probability level, not an observation index."@en ; cd:authoredResource true .
  ex:l5-nq-standard a cd:MathSymbol ; cd:symbol "z quantile" ; cd:mathNotation "z_{0.95}" ; cd:body "Dimensionless standard-normal 95% quantile, about 1.64485. This is a one-sided threshold, not the central-95% multiplier."@en ; cd:authoredResource true .
  ex:l5-nq-parameters a cd:MathSymbol ; cd:symbol "mu and sigma" ; cd:mathNotation "\\mu,\\ \\sigma" ; cd:body "Specified mean 10.0 and SD 0.30, both in mg/L. Multiplied by dimensionless z, SD becomes a concentration offset."@en ; cd:authoredResource true .
  ex:l5-nq-operators a cd:MathSymbol ; cd:symbol "equality, addition and rounding" ; cd:mathNotation "=,\\ +,\\ \\cdot,\\ \\approx" ; cd:body "Add the mean to the quantile-times-SD product. Equality defines the exact quantile; approximation marks rounded values. mg/L means milligrams per litre."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-normal-interpretation> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:measurement-versus-site-variation .
  ex:l5-n10b-title a cd:Interpretation ; skos:prefLabel "Tool: a quantile is not a mean estimate"@en ; cd:authoredResource true .
  ex:l5-n10c-title a cd:Interpretation ; skos:prefLabel "Return to the unknown water-body mean"@en ; cd:authoredResource true .
  ex:l5-n11a-title a cd:Interpretation ; skos:prefLabel "Between-sample variation also matters"@en ; cd:authoredResource true .
  ex:l5-n11b-title a cd:Interpretation ; skos:prefLabel "First compare repeated measurements"@en ; cd:authoredResource true .
  ex:l5-n11c-title a cd:Interpretation ; skos:prefLabel "Then compare different sampling sites"@en ; cd:authoredResource true .
  ex:l5-n11d-title a cd:Interpretation ; skos:prefLabel "Different variation, a different model"@en ; cd:authoredResource true .

