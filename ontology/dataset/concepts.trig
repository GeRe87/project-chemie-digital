@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix cdm: <https://w3id.org/project-chemie-digital/meta/> .
@prefix graph: <https://w3id.org/project-chemie-digital/graph/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Reusable scientific and learning-resource vocabulary.
graph:concepts {
  cd:LearningDomain a cdm:ConceptDomain ;
    cdm:definesConcept cd:Concept, cd:LearningResource, cd:Definition,
      cd:MathExpression, cd:MathSymbol, cd:WorkedExample, cd:Exercise,
      cd:ExpectedResult, cd:AssessmentCriterion, cd:Interpretation, cd:UnitRule,
      cd:Misconception, cd:Correction, cd:Comparison, cd:Dataset, cd:Observation,
      cd:CalculationStep, cd:PitchResource, cd:KeyPoint, cd:Attribution,
       cd:FlowDiagram, cd:NetworkDiagram, cd:DiagramNode, cd:DiagramEdge, cd:DiagramGroup, cd:ChartDefinition,
      cd:ChartAnnotation, cd:ChartPointAnnotation, cd:ChartRangeAnnotation,
      cd:LearningPath, cd:PathStep,
      cd:Source, cd:PitchSource, cd:SceneDefinition, cd:SceneItem ;
    cdm:definesRelation cd:hasDefinition, cd:hasMathExpression, cd:hasSymbol,
      cd:hasExample, cd:hasExercise, cd:hasSource, cd:hasKeyPoint, cd:forTopic, cd:hasStep,
      cd:usesResource, cd:focusConcept, cd:hasSceneItem, cd:presentationPattern,
      cd:selectsResource, cd:communicativeRole, cd:prerequisite, cd:dependsOn,
      cd:derivedFrom, cd:quantifiesProperty, cd:hasInterpretation, cd:hasUnitRule,
      cd:contrastsWith, cd:hasMisconception, cd:hasCorrection, cd:usesDenominator,
      cd:hasExpectedResult, cd:hasAssessmentCriterion, cd:compares, cd:usesDataset,
      cd:hasObservation, cd:hasCalculationStep, cd:hasDiagram, cd:hasDiagramNode,
       cd:hasDiagramEdge, cd:hasDiagramGroup, cd:memberOfDiagramGroup, cd:sourceNode, cd:targetNode, cd:focusNode,
      cd:hasChartAnnotation, cd:targetObservation, cd:startObservation, cd:endObservation,
      cd:supportsResource, cd:usesScene ;
    cdm:definesAttribute cd:sourcePath, cd:position, cd:body, cd:latex,
      cd:symbol, cd:viewType, cd:authoredResource, cd:selectionPath, cd:language,
      cd:definitionScope, cd:formulaFamily, cd:numericValue, cd:unit,
       cd:chartType, cd:xAxisLabel, cd:yAxisLabel, cd:xAxisUnit, cd:yAxisUnit, cd:xValue, cd:visualRole ;
    cdm:definesControlledValue cd:HeadingRole, cd:QuotationRole,
      cd:CitationRole, cd:ConceptRole, cd:ComparisonRole, cd:FormulaRole,
      cd:SymbolRole, cd:StatementRole, cd:ExampleRole, cd:ExerciseRole,
      cd:KeyPointRole, cd:AttributionRole, cd:DiagramRole, cd:ChartRole,
      cd:BarChart, cd:LineChart, cd:DefinitionWithCitation .

  cd:Concept a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf skos:Concept .
  cd:LearningResource a rdfs:Class, cdm:ConceptDescriptor .
  cd:Definition a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:MathExpression a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:MathSymbol a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:WorkedExample a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Exercise a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:ExpectedResult a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:AssessmentCriterion a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Interpretation a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:UnitRule a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Misconception a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Correction a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Comparison a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Dataset a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Observation a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:CalculationStep a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:PitchResource a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:KeyPoint a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:Attribution a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:FlowDiagram a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:NetworkDiagram a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:FlowDiagram .
  cd:ChartDefinition a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:ChartAnnotation a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:LearningResource .
  cd:ChartPointAnnotation a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:ChartAnnotation .
  cd:ChartRangeAnnotation a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:ChartAnnotation .
  cd:DiagramNode a rdfs:Class, cdm:ConceptDescriptor .
  cd:DiagramEdge a rdfs:Class, cdm:ConceptDescriptor .
  cd:LearningPath a rdfs:Class, cdm:ConceptDescriptor .
  cd:PathStep a rdfs:Class, cdm:ConceptDescriptor .
  cd:Source a rdfs:Class, cdm:ConceptDescriptor .
  cd:PitchSource a rdfs:Class, cdm:ConceptDescriptor ; rdfs:subClassOf cd:Source .
  cd:SceneDefinition a rdfs:Class, cdm:ConceptDescriptor .
  cd:SceneItem a rdfs:Class, cdm:ConceptDescriptor .
  cd:CommunicativeRole a rdfs:Class .
  cd:PresentationPattern a rdfs:Class .

  cd:HeadingRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:QuotationRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:CitationRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:ConceptRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:ComparisonRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:FormulaRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:SymbolRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:StatementRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:ExampleRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:ExerciseRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:KeyPointRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:AttributionRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:DiagramRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:ChartRole a cd:CommunicativeRole, cdm:ControlledValue .
  cd:BarChart a cdm:ControlledValue .
  cd:LineChart a cdm:ControlledValue .
  cd:DefinitionWithCitation a cd:PresentationPattern, cdm:ControlledValue .

  cd:hasDefinition a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:Definition .
  cd:hasMathExpression a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:MathExpression .
  cd:hasSymbol a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:MathSymbol .
  cd:hasExample a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:WorkedExample .
  cd:hasExercise a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:Exercise .
  cd:hasSource a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Source .
  cd:hasKeyPoint a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:LearningResource ; rdfs:range cd:KeyPoint .
  cd:forTopic a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:LearningPath ; rdfs:range cd:Concept .
  cd:hasStep a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:LearningPath ; rdfs:range cd:PathStep .
  cd:usesResource a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:PathStep ; rdfs:range cd:LearningResource .
  cd:focusConcept a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:SceneDefinition ; rdfs:range cd:Concept .
  cd:hasSceneItem a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:SceneDefinition ; rdfs:range cd:SceneItem .
  cd:presentationPattern a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:SceneDefinition ; rdfs:range cd:PresentationPattern .
  cd:selectsResource a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:SceneItem .
  cd:communicativeRole a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:SceneItem ; rdfs:range cd:CommunicativeRole .
  cd:prerequisite a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:Concept .
  cd:dependsOn a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:derivedFrom a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:quantifiesProperty a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:hasInterpretation a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Interpretation .
  cd:hasUnitRule a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:UnitRule .
  cd:contrastsWith a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:hasMisconception a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Misconception .
  cd:hasCorrection a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Correction .
  cd:usesDenominator a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:hasExpectedResult a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:ExpectedResult .
  cd:hasAssessmentCriterion a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:AssessmentCriterion .
  cd:compares a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Concept .
  cd:usesDataset a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Dataset .
  cd:hasObservation a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:Observation .
  cd:hasChartAnnotation a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:ChartDefinition ; rdfs:range cd:ChartAnnotation .
  cd:targetObservation a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:ChartPointAnnotation ; rdfs:range cd:Observation .
  cd:startObservation a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:ChartRangeAnnotation ; rdfs:range cd:Observation .
  cd:endObservation a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:ChartRangeAnnotation ; rdfs:range cd:Observation .
  cd:hasCalculationStep a rdf:Property, cdm:RelationDescriptor ; rdfs:range cd:CalculationStep .
  cd:hasDiagram a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Concept ; rdfs:range cd:FlowDiagram .
  cd:hasDiagramNode a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:FlowDiagram ; rdfs:range cd:DiagramNode .
  cd:hasDiagramEdge a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:FlowDiagram ; rdfs:range cd:DiagramEdge .
  cd:sourceNode a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:DiagramEdge ; rdfs:range cd:DiagramNode .
  cd:targetNode a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:DiagramEdge ; rdfs:range cd:DiagramNode .
  cd:focusNode a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:FlowDiagram ; rdfs:range cd:DiagramNode .
  cd:hasDiagramGroup a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:FlowDiagram ; rdfs:range cd:DiagramGroup .
  cd:memberOfDiagramGroup a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:DiagramNode ; rdfs:range cd:DiagramGroup .
   cd:visualRole a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:string .
  cd:supportsResource a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:Source ; rdfs:range cd:LearningResource .
  cd:usesScene a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:PathStep ; rdfs:range cd:SceneDefinition .

  cd:sourcePath a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:PitchSource ; rdfs:range xsd:string .
  cd:position a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:integer .
  cd:body a rdf:Property, cdm:AttributeDescriptor ; rdfs:range rdf:langString .
  cd:latex a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:string .
  cd:symbol a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:string .
  cd:viewType a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:string .
  cd:authoredResource a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:boolean .
  cd:selectionPath a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:SceneItem ; rdfs:range xsd:string .
  cd:language a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:SceneItem ; rdfs:range xsd:language .
  cd:definitionScope a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:Definition ; rdfs:range xsd:string .
  cd:formulaFamily a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:MathExpression ; rdfs:range xsd:string .
  cd:numericValue a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:decimal .
  cd:unit a rdf:Property, cdm:AttributeDescriptor ; rdfs:range xsd:string .
  cd:chartType a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:ChartDefinition .
  cd:xAxisLabel a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:ChartDefinition ; rdfs:range rdf:langString .
  cd:yAxisLabel a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:ChartDefinition ; rdfs:range rdf:langString .
  cd:xAxisUnit a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:ChartDefinition ; rdfs:range xsd:string .
  cd:yAxisUnit a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:ChartDefinition ; rdfs:range xsd:string .
  cd:xValue a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:Observation ; rdfs:range xsd:decimal .
}
