  ex:l7-teaching-manova-null a cd:MathExpression ; skos:prefLabel "Compare joint population mean vectors"@en ; cd:body "Compare joint population mean vectors"@en ; cd:latex "\\boldsymbol\\mu_i=(\\mu_{i1},\\mu_{i2})^{\\mathsf T},\\qquad H_0:\\;\\boldsymbol\\mu_A=\\boldsymbol\\mu_B=\\boldsymbol\\mu_C" ; dct:hasPart ex:l7-teaching-manova-null-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-manova-null .
  ex:l7-teaching-manova-null-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-manova-null-symbol-1, ex:l7-teaching-manova-null-symbol-2 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-manova-null-legend .
  ex:l7-teaching-manova-null-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Response means"@en ; cd:body "μᵢ₁ and μᵢ₂ are population mean recoveries (%) for analytes 1 and 2 under method i. Bold μᵢ is their two-component vector; T denotes transpose to a column."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-manova-null-symbol-1 .
  ex:l7-teaching-manova-null-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Joint null"@en ; cd:body "H₀ says all three method vectors A, B and C are equal. The comma separates components and = denotes equality. Rejection does not locate an analyte or a pair."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-manova-null-symbol-2 .
  ex:l7-teaching-42-model-heading a cd:Interpretation ; skos:prefLabel "MANOVA: interpret the joint test"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-42-model-heading .
  ex:l7-teaching-42-model-conclusion a cd:Interpretation ; cd:body "The omnibus result concerns the two responses jointly. Follow up only with planned comparisons."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-42-model-conclusion .
