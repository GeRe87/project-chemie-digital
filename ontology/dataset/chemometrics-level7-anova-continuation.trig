  ex:l7-teaching-marginal-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Equal weights"@en ; cd:body "Each method has six preparations per matrix, so the two cells have equal weight. + adds the cell means, parentheses group their sum, / divides by two, = is equality, and % means percent."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
