  ex:l7-next-30-table-row-1-cell-4 a cd:TableCell ; cd:position 4 ; cd:body "6"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-30-table-row-2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:l7-next-30-table-row-2-cell-1, ex:l7-next-30-table-row-2-cell-2, ex:l7-next-30-table-row-2-cell-3, ex:l7-next-30-table-row-2-cell-4 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
