  ex:l7-next-26-table-row-1-cell-2 a cd:TableCell ; cd:position 2 ; cd:body "4"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-26-table-row-1-cell-3 a cd:TableCell ; cd:position 3 ; cd:body "[1.88, 6.12]"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
