<https://w3id.org/project-chemie-digital/graph/scenes/level7-anova-continuation> {
  ex:l7-teaching-15-b a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-teaching-15-table-b ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
