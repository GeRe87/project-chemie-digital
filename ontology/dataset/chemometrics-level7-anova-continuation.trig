  ex:l7-teaching-between a cd:MathExpression ; skos:prefLabel "Weight each group-mean departure"@en ; cd:body "Weight each group-mean departure"@en ; cd:latex "\\begin{aligned}SS_B&=\\sum_{i=1}^{k}n_i(\\bar y_i-\\bar y_{\\cdot\\cdot})^2\\\\&=6(94-95)^2+6(98-95)^2+6(93-95)^2\\\\&=6+54+24=84\\;\\mathrm{pp}^2\\end{aligned}" ; dct:hasPart ex:l7-teaching-between-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-between .
  ex:l7-teaching-between-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-between-symbol-1, ex:l7-teaching-between-symbol-2, ex:l7-teaching-between-symbol-3 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-between-legend .
  ex:l7-teaching-between-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Means and indices"@en ; cd:body "ȳᵢ is sample mean recovery (%) for method i; ȳ·· is grand mean recovery (%) over all 18 preparations. i runs from 1 to k = 3. nᵢ = 6 is the count for method i."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-between-symbol-1 .
  ex:l7-teaching-between-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Terms and units"@en ; cd:body "$SS_B$ is the between-method sum of squares. Subtraction gives a departure in percentage points (pp). Squaring gives pp²; weighting by the count nᵢ gives each method's contribution."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-between-symbol-2 .
  ex:l7-teaching-between-symbol-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Operations"@en ; cd:body "Σ adds contributions over the three methods; juxtaposition denotes multiplication, the exponent 2 squares, and + and = mean addition and equality."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-between-symbol-3 .
  ex:level7-anova-design a cd:MediaAsset ; skos:prefLabel "Choose the design before looking at results"@en ; cd:uri "/chemometrics/level7-anova-design.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Three SPE methods, each with six independent river-water preparations. The response is recovery in percent; predefine alpha and the null hypothesis."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-design .
  ex:level7-anova-decomposition a cd:MediaAsset ; skos:prefLabel "Two calculations, same total"@en ; cd:uri "/chemometrics/level7-anova-decomposition.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two independent calculation routes agree: sum squared deviations from the grand mean directly to obtain 114 pp squared, or add the between and within sums of 84 and 30."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-decomposition .
  ex:level7-anova-test-chain a cd:MediaAsset ; skos:prefLabel "From sums of squares to the p-value"@en ; cd:uri "/chemometrics/level7-anova-test-chain.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Divide method SS 84 by 2 to get 42 and residual SS 30 by 15 to get 2. F is 21; the upper tail under F with df 2,15 is 0.00004484."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-test-chain .
  ex:l7-teaching-test-chain a cd:MathExpression ; skos:prefLabel "Mean squares, F statistic and reference probability"@en ; cd:body "Mean squares, F statistic and reference probability"@en ; cd:latex "\\begin{aligned}MS_B &= SS_B/df_B=84/2=42\\;\\mathrm{pp}^2\\\\MS_W &= SS_W/df_W=30/15=2\\;\\mathrm{pp}^2\\\\ F_{\\rm obs}&=MS_B/MS_W=21\\\\p&=\\Pr(F^{*}_{2,15}\\ge 21\\mid H_0)\\approx 0.00004484\\end{aligned}" ; dct:hasPart ex:l7-teaching-test-chain-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-test-chain .
  ex:l7-teaching-test-chain-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-test-chain-symbol-1, ex:l7-teaching-test-chain-symbol-2, ex:l7-teaching-test-chain-symbol-3 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-test-chain-legend .
  ex:l7-teaching-test-chain-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "SS, df and MS"@en ; cd:body "SS is a sum of squares; df is degrees of freedom; MS is mean square. Subscripts B and W mark between-method and within-method residual variation. SS and MS use squared percentage points (pp²)."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-test-chain-symbol-1 .
  ex:l7-teaching-test-chain-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Observed and reference F"@en ; cd:body "$F_{\\mathrm{obs}}$ is the observed dimensionless ratio. $F^{*}_{2,15}$ denotes a random F statistic from the null reference distribution with numerator and denominator degrees of freedom 2 and 15."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-test-chain-symbol-2 .
  ex:l7-teaching-test-chain-symbol-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Probability and operators"@en ; cd:body "Pr is probability; H₀ is equality of population means under the classical model assumptions. The conditioning bar means given, ≥ means at least, / divides, = is equality and ≈ indicates rounding."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-test-chain-symbol-3 .
  ex:l7-teaching-17-calc-heading a cd:Interpretation ; skos:prefLabel "From sums of squares to F and p"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-17-calc-heading .
  ex:l7-teaching-17-calc-conclusion a cd:Interpretation ; cd:body "The F-test compares a method mean square of 42 with a residual mean square of 2."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-17-calc-conclusion .
  ex:l7-teaching-17-calc-focus a cd:Concept ; skos:prefLabel "From sums of squares to F and p"@en ; cd:hasDefinition ex:l7-teaching-17-calc-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-17-calc-focus .
  ex:l7-teaching-17-calc-definition a cd:Definition ; cd:body "The F-test compares a method mean square of 42 with a residual mean square of 2."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-17-calc-definition .
  ex:level7-anova-explained-question a cd:MediaAsset ; skos:prefLabel "What does the method account for?"@en ; cd:uri "/chemometrics/level7-anova-explained-question.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Eighteen river-water recoveries by method. One overall prediction uses the grand mean of 95 percent. The method model uses group means of 94, 98, and 93 percent, leaving spread around each group mean."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-explained-question .
  ex:l7-teaching-22-question-heading a cd:Interpretation ; skos:prefLabel "How much of the spread is associated with method?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-22-question-heading .
  ex:l7-teaching-22-question-conclusion a cd:Interpretation ; cd:body "Compare one overall recovery prediction with one prediction per method."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-22-question-conclusion .
  ex:l7-teaching-22-question-focus a cd:Concept ; skos:prefLabel "How much of the spread is associated with method?"@en ; cd:hasDefinition ex:l7-teaching-22-question-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-22-question-focus .
  ex:l7-teaching-22-question-definition a cd:Definition ; cd:body "Between-method variation is the part the fitted method model accounts for."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-22-question-definition .
  ex:level7-anova-tukey-range a cd:MediaAsset ; skos:prefLabel "Tukey’s reference: the studentized range distribution"@en ; cd:uri "/chemometrics/level7-anova-tukey-range.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "The studentized range distribution for three group means and 15 residual degrees of freedom is the null reference. The right tail from the observed B versus A statistic q = 6.928 has area 0.000532."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-tukey-range .
  ex:l7-teaching-tukey-adjusted a cd:MathExpression ; skos:prefLabel "Tukey HSD for equal group sizes"@en ; cd:body "Tukey HSD for equal group sizes"@en ; cd:latex "\\begin{aligned}\\Delta&=\\bar y_B-\\bar y_A=4\\;\\mathrm{pp}\\\\q&=\\frac{|\\Delta|}{\\sqrt{MS_W/n}}=\\frac{4}{\\sqrt{2/6}}\\approx 6.928\\\\p_{\\rm adj}&=\\Pr(Q_{k,\\nu}\\ge q)\\approx 0.000532\\end{aligned}" ; dct:hasPart ex:l7-teaching-tukey-adjusted-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-tukey-adjusted .
  ex:l7-teaching-tukey-adjusted-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-tukey-adjusted-symbol-1, ex:l7-teaching-tukey-adjusted-symbol-2, ex:l7-teaching-tukey-adjusted-symbol-3 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-tukey-adjusted-legend .
  ex:l7-teaching-tukey-adjusted-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Difference"@en ; cd:body "$\\bar{y}_A$ and $\\bar{y}_B$ are sample mean recoveries in percent; Δ is their signed difference in percentage points (pp). |Δ| takes the magnitude for a two-sided comparison."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-tukey-adjusted-symbol-1 .
  ex:l7-teaching-tukey-adjusted-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Pooled error and counts"@en ; cd:body "$MS_W$ = 2 pp² is the residual mean square; n = 6 is the common sample size; k = 3 is the number of group means, and ν = 15 is the residual degrees of freedom."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-tukey-adjusted-symbol-2 .
  ex:l7-teaching-tukey-adjusted-symbol-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Adjusted tail"@en ; cd:body "Lowercase q is the observed standardized gap for B versus A. Capital Q is the random largest standardized gap among k equal-sized group means under the common-mean null model, using a pooled error estimate with ν residual degrees of freedom. Pr is probability; $p_{\\mathrm{adj}}$ is the adjusted right-tail probability; ≥ means at least; √ is square root; fractions divide; = is equality and ≈ denotes rounding. Both q and Q are dimensionless."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-tukey-adjusted-symbol-3 .
  ex:l7-teaching-26-adjusted-heading a cd:Interpretation ; skos:prefLabel "Could any pair show a gap this large by chance?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-26-adjusted-heading .
  ex:l7-teaching-26-adjusted-conclusion a cd:Interpretation ; cd:body "For each observed pair, use the largest-gap distribution as the reference."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-26-adjusted-conclusion .
  ex:l7-teaching-26-adjusted-focus a cd:Concept ; skos:prefLabel "How does Tukey adjust p?"@en ; cd:hasDefinition ex:l7-teaching-26-adjusted-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-26-adjusted-focus .
  ex:l7-teaching-26-adjusted-definition a cd:Definition ; cd:body "Tukey’s adjusted p-value is the right-tail probability of the studentized range distribution at the observed q."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-26-adjusted-definition .
  ex:l7-teaching-marginal a cd:MathExpression ; skos:prefLabel "Average over the other factor"@en ; cd:body "Average over the other factor"@en ; cd:latex "\\begin{aligned}\\bar y_{i\\cdot}&=(\\bar y_{iR}+\\bar y_{iW})/2\\\\\\bar y_{B\\cdot}&=(98+86)/2=92\\%\\\\\\bar y_{\\cdot R}&=(\\bar y_{AR}+\\bar y_{BR}+\\bar y_{CR})/3\\\\&=(94+98+93)/3=95\\%\\end{aligned}" ; dct:hasPart ex:l7-teaching-marginal-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-marginal .
  ex:l7-teaching-marginal-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-marginal-symbol-1, ex:l7-teaching-marginal-symbol-2 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-marginal-legend .
  ex:l7-teaching-marginal-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Means by combination and by factor"@en ; cd:body "ȳᵢR and ȳᵢW are mean recoveries (%) for method i in river water and wastewater. The dot in ȳᵢ· averages over the matrices. The dot in ȳ·R averages over methods for river water. A, B and C label the methods."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-marginal-symbol-1 .
  ex:l7-teaching-marginal-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Equal weights"@en ; cd:body "Each method and matrix combination contains six preparations. + adds the means of the combinations, parentheses group the sum, / divides by the number of levels averaged (two matrices or three methods), = denotes equality, and % means percent."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-marginal-symbol-2 .
  ex:level7-anova-welch-groups a cd:MediaAsset ; skos:prefLabel "Why use Welch ANOVA?"@en ; cd:uri "/chemometrics/level7-anova-welch-groups.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Six independent illustrative recoveries per method. A and C have sample variance 3.5 pp squared; B has sample variance 56."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
