  ex:l7-teaching-40-example-focus a cd:Concept ; skos:prefLabel "Welch ANOVA: work through the weights"@en ; cd:hasDefinition ex:l7-teaching-40-example-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-40-example-focus .
