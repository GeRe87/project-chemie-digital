  ex:l7-next-31-heading a cd:Interpretation ; skos:prefLabel "Read the method and matrix averages"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-takeaway a cd:Interpretation ; cd:body "Read across for method averages and down for matrix averages."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-focus a cd:Concept ; skos:prefLabel "The main effect of method"@en ; cd:hasDefinition ex:l7-next-31-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-definition a cd:Definition ; cd:body "What does the average method effect describe? The method main effect compares recovery averaged equally across the two matrices in this balanced design."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-table a cd:TableDefinition ; skos:prefLabel "Average each method equally across the two matrices"@en ; cd:hasTableColumn ex:l7-next-31-table-col-1, ex:l7-next-31-table-col-2, ex:l7-next-31-table-col-3, ex:l7-next-31-table-col-4 ; cd:hasTableRow ex:l7-next-31-table-row-1, ex:l7-next-31-table-row-2, ex:l7-next-31-table-row-3 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
