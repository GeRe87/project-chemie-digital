  ex:l7-next-18-table-row-3 a cd:TableRow ; cd:position 3 ; cd:hasTableCell ex:l7-next-18-table-row-3-cell-1, ex:l7-next-18-table-row-3-cell-2, ex:l7-next-18-table-row-3-cell-3, ex:l7-next-18-table-row-3-cell-4, ex:l7-next-18-table-row-3-cell-5, ex:l7-next-18-table-row-3-cell-6 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
