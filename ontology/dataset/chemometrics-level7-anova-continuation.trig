  ex:l7-next-18-table-row-2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:l7-next-18-table-row-2-cell-1, ex:l7-next-18-table-row-2-cell-2, ex:l7-next-18-table-row-2-cell-3, ex:l7-next-18-table-row-2-cell-4, ex:l7-next-18-table-row-2-cell-5, ex:l7-next-18-table-row-2-cell-6 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
