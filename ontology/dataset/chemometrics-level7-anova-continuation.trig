  ex:l7-additive-table-heading a cd:Interpretation ; skos:prefLabel "Build the additive ANOVA table"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-additive-table-takeaway a cd:Interpretation ; cd:body "The additive model attributes 2.69% of the squared variation to method and 32.44% to matrix. Only matrix is significant here."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-additive-table-heading, ex:l7-additive-table-takeaway .
  ex:l7-additive-compare-heading a cd:Interpretation ; skos:prefLabel "Why does the method result change?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-additive-compare-takeaway a cd:Interpretation ; cd:body "Averaging across matrices brings the three method means close together."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-additive-compare-heading, ex:l7-additive-compare-takeaway .
  ex:l7-operator-assignment-heading a cd:Interpretation ; skos:prefLabel "Would regrouping by operator change what we see?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-operator-assignment-takeaway a cd:Interpretation ; cd:body "Each operator handles two methods, and each method is used by two operators."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-operator-assignment-heading, ex:l7-operator-assignment-takeaway .
  ex:l7-operator-compare-heading a cd:Interpretation ; skos:prefLabel "What changes when we regroup the recoveries?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-operator-compare-takeaway a cd:Interpretation ; cd:body "Regrouping changes the pattern of spread. Operator groups contain different mixes of methods, so this comparison cannot isolate an operator effect."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-operator-compare-heading, ex:l7-operator-compare-takeaway .
  ex:l7-operator-adjusted-heading a cd:Interpretation ; skos:prefLabel "What does operator add after method?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-operator-adjusted-takeaway a cd:Interpretation ; cd:body "Use the adjusted effect size to judge what a factor adds to the model."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-operator-adjusted-heading, ex:l7-operator-adjusted-takeaway .
  ex:l7-model-prediction-heading a cd:Interpretation ; skos:prefLabel "What does the model predict?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-prediction-takeaway a cd:Interpretation ; cd:body "One fitted value represents preparations in the same method–matrix combination."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-prediction-formula a cd:MathExpression ; skos:prefLabel "What does the model predict?"@en ; cd:body "What does the model predict?"@en ; cd:latex "e_{ijk}=y_{ijk}-\\hat y_{ij}" ; dct:hasPart ex:l7-model-prediction-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-prediction-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-model-prediction-symbol-1, ex:l7-model-prediction-symbol-2 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-model-prediction-heading, ex:l7-model-prediction-takeaway, ex:l7-model-prediction-formula, ex:l7-model-prediction-legend, ex:l7-model-prediction-symbol-1, ex:l7-model-prediction-symbol-2 .
  ex:l7-model-prediction-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed and fitted"@en ; cd:body "$y_{ijk}$ is one observed recovery (%). $\\hat{y}_{ij}$ is the predicted recovery (%) for its method–matrix combination."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-prediction-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Residual and notation"@en ; cd:body "$e_{ijk}$ is the residual in percentage points; i indexes method, j matrix, and k preparation. The hat denotes a fitted value. − means subtract, and = denotes equality."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-system-heading a cd:Interpretation ; skos:prefLabel "How do the six predictions fit together?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-system-takeaway a cd:Interpretation ; cd:body "Each equation uses the same grand mean and reuses shifts across combinations."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-system-formula a cd:MathExpression ; skos:prefLabel "How do the six predictions fit together?"@en ; cd:body "How do the six predictions fit together?"@en ; cd:latex "\\begin{aligned}\\hat y_{ij}&=\\mu+\\alpha_i+\\beta_j\\\\\\sum_i\\alpha_i&=0,\\qquad\\sum_j\\beta_j=0\\end{aligned}" ; dct:hasPart ex:l7-model-system-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-system-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-model-system-symbol-1, ex:l7-model-system-symbol-2 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-model-system-heading, ex:l7-model-system-takeaway, ex:l7-model-system-formula, ex:l7-model-system-legend, ex:l7-model-system-symbol-1, ex:l7-model-system-symbol-2 .
  ex:l7-model-system-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Shared terms"@en ; cd:body "$\\hat{y}_{ij}$ is fitted recovery (%) for method i in matrix j. $\\mu$ is the grand mean recovery (%). $\\alpha_i$ and $\\beta_j$ are the method and matrix shifts in percentage points."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-system-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Centered shifts"@en ; cd:body "$\\sum_i$ sums over the three methods and $\\sum_j$ over the two matrices. Each set of shifts adds to zero. The hat marks a fitted value, + adds shifts, and = denotes equality."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-pattern-heading a cd:Interpretation ; skos:prefLabel "Where does the additive fit miss?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-pattern-takeaway a cd:Interpretation ; cd:body "The observed method gap changes direction between matrices."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-pattern-formula a cd:MathExpression ; skos:prefLabel "Where does the additive fit miss?"@en ; cd:body "Where does the additive fit miss?"@en ; cd:latex "\\hat y_{Bj}-\\hat y_{Aj}=\\alpha_B-\\alpha_A" ; dct:hasPart ex:l7-model-pattern-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-pattern-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-model-pattern-symbol-1, ex:l7-model-pattern-symbol-2 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-model-pattern-heading, ex:l7-model-pattern-takeaway, ex:l7-model-pattern-formula, ex:l7-model-pattern-legend, ex:l7-model-pattern-symbol-1, ex:l7-model-pattern-symbol-2 .
  ex:l7-model-pattern-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Comparing two fits"@en ; cd:body "$\\hat{y}_{Bj}$ and $\\hat{y}_{Aj}$ are fitted recoveries (%) for methods B and A within the same matrix j. $\\alpha_B$ and $\\alpha_A$ are the corresponding method shifts (percentage points)."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-model-pattern-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Shared terms cancel"@en ; cd:body "The grand mean and the matrix shift are common to both predictions, so subtraction cancels them. The hat marks a fit, − subtracts, and = denotes equality."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level7-anova-continuation> {
  ex:l7-scene14 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-14-focus ; cd:hasSceneItem ex:l7-next-14-item-1, ex:l7-next-14-item-2, ex:l7-next-14-item-3 ; cd:narration "Before calculating variation, fix the question and the design. In this synthetic example, three methods each have six independent preparations, and the response is percent recovery. The null hypothesis says that the three population mean recoveries are equal; the alternative says that at least one differs. These statements concern population means, not whether the observed sample means happen to match. Set the significance level to 0.05 and specify the intended comparison family in advance. Check that preparation, rather than repeated injection, defines the independent unit. Next, we calculate variation within methods."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-14-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-14-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-14-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-design ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-14-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-14-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene15 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-15-focus ; cd:hasSceneItem ex:l7-next-15-item-1, ex:l7-next-15-item-2, ex:l7-next-15-item-3, ex:l7-teaching-15-b, ex:l7-teaching-15-c ; cd:narration "Open each of the three method tables. The method mean is stated above its observations: 94 percent for A, 98 for B, and 93 for C. Subtract only that method's mean, row by row. The signed residuals sum to zero, which is why we square them before adding. The squared residuals add to ten for each method. Adding the three totals gives a pooled residual sum of squares of thirty squared percentage points. The grand mean is not the reference for this calculation."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-15-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-15-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-15-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-15-table ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-15-item-3 a cd:SceneItem ; cd:position 5 ; cd:selectsResource ex:l7-next-15-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene16 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-16-focus ; cd:hasSceneItem ex:l7-next-16-item-1, ex:l7-next-16-item-2, ex:l7-next-16-item-3, ex:l7-teaching-16-formula ; cd:narration "Now shift from individual preparations to the three method means. The displayed means are 94, 98, and 93 percent, while the overall mean is 95 percent. Their deviations are minus one, plus three, and minus two percentage points. Squaring gives one, nine, and four. Multiply each by six because each method mean represents six independent preparations. The three contributions are therefore six, fifty-four, and twenty-four, totaling eighty-four squared percentage points. Check the weights in the contribution column: this is weighted variation, not simply the spread of three means. Next, combine between and within variation."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-16-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-16-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-16-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-16-table ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-16-item-3 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-16-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene17 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-17-focus ; cd:hasSceneItem ex:l7-next-17-item-1, ex:l7-next-17-item-2, ex:l7-next-17-item-3 ; cd:narration "Let's check the arithmetic in two ways. First, take each of the eighteen recoveries, subtract the grand mean, square the result, and add the squares. The total is 114 squared percentage points. Then use the two sums of squares we calculated on the previous slides: 84 between the methods and 30 within the methods. They also add to 114. The agreement checks that our two components account for the entire total. Next we'll divide by degrees of freedom and use those mean squares to calculate the F statistic."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-17-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-17-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-17-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-decomposition ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-17-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-17-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene18 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-18-focus ; cd:hasSceneItem ex:l7-next-18-item-1, ex:l7-next-18-item-2, ex:l7-next-18-item-3 ; cd:narration "The source rows tell us where the variation in recovery comes from: differences among method means, scatter among preparations within methods, and total variation. The sums of squares quantify those contributions. The degrees of freedom count the independent deviations available for each source. The mean squares put the sources on a per-degree-of-freedom scale. Here the between-method mean square is twenty-one times the within-method mean square. The p-value tells us how rarely equal population means would produce an F at least this large under the model assumptions. This result gives evidence that at least one method mean differs. Next, inspect the residuals."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-18-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-18-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-18-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-read-table ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-18-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-18-takeaway ; cd:revealOn ex:level7-anova-read-table ; cd:revealAtStage 4 ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-continuation-scene19 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-19-focus ; cd:hasSceneItem ex:l7-next-19-item-1, ex:l7-next-19-item-2, ex:l7-next-19-item-3 ; cd:narration "Now use the F distribution to give the observed ratio a scale. Its numerator degrees of freedom are two and its denominator degrees of freedom are fifteen. Locate the observed statistic at twenty-one, then follow the shaded area to its right. That area is approximately 0.00004484: under equal population means and the model assumptions, it is the probability of an F statistic at least this large. It is not the probability that the null hypothesis is true. Compare the area with the predefined 0.05 threshold, then examine whether the sampling and error assumptions justify that comparison."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-19-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-19-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-19-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-chart-19 ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-19-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-19-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene20 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-20-focus ; cd:hasSceneItem ex:l7-next-20-item-1, ex:l7-next-20-item-2, ex:l7-next-20-item-3 ; cd:narration "Before accepting the inference, return to how the measurements were generated. Six independent preparations can provide six experimental units; six injections from one preparation do not become six independent preparations. Use the preparation diagram to check this distinction first. The classical model also assumes errors centered on zero, a common error variance across methods, and normally distributed errors for the exact F reference. Independence mainly comes from design knowledge, not a normality plot. Next, use residual diagnostics to investigate model departures that the observed measurements can reveal."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-20-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-20-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-20-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-20 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-20-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-20-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene21 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-21-focus ; cd:hasSceneItem ex:l7-next-21-item-1, ex:l7-next-21-item-2, ex:l7-next-21-item-3 ; cd:narration "Take a preparation from Method A that measured 95.92 percent recovery against a fitted method mean of 94.00 percent. Its residual is plus 1.92 percentage points. The table shows all eighteen preparations, with one fitted value per method. The normal Q-Q plot compares the ordered decimal residuals with the reference line. The points broadly follow it. Compare this with the schematic heavy-tail example: the points in the middle stay near the line, but the left end falls far below it and the right end rises far above it. That pattern indicates more extreme residuals than a normal model would predict. The last view adds the Kolmogorov-Smirnov distance to a separately fitted normal curve. It is 0.110 for the river-water residuals and 0.248 for the schematic example. Each number is the largest vertical gap between two cumulative distributions. The simulated p-values are about 0.812 and 0.040, respectively. Each simulation refits the normal distribution. For the river-water data we also simulate three groups, round the recoveries as on the slide, and refit the group means before computing the residuals."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-21-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-21-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-21-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-21-visual ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-21-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-21-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene22 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-22-focus ; cd:hasSceneItem ex:l7-next-22-item-1, ex:l7-next-22-item-2, ex:l7-next-22-item-3, ex:l7-next-22-item-4 ; cd:narration "Compare two predictions for each preparation. If we predict the grand mean for every preparation, the residual sum of squares is 114. If we instead predict the mean of the preparation's own method, the residual sum is 30. The second model reduces the observed squared error by 84. Divide this reduction by the original error, 114, to obtain eta squared: 0.737. So the method model accounts for 73.7 percent of the observed spread on the sum-of-squares scale. To judge whether that matters in practice, compare the actual recovery differences with the analytical requirements."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-22-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-22-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-22-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-22-visual ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-22-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-22-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-22-item-4 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-22-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene23 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-23-focus ; cd:hasSceneItem ex:l7-next-23-item-1, ex:l7-next-23-item-2, ex:l7-next-23-item-3 ; cd:narration "Start with the design: three methods, each tested on six independent river-water preparations. The F statistic is 21 on 2 and 15 degrees of freedom, with p about 0.00004484. Under the model assumptions, that is evidence that at least one population mean differs. The fitted method means account for 73.7 percent of observed squared variation. This proportion is specific to these data and the fitted model. These results describe the river-water experiment. Next, use the same recoveries to ask whether a second grouping, by operator, would affect the interpretation."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-23-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-23-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-23-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-23 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-23-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-23-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene24 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-24-focus ; cd:hasSceneItem ex:l7-next-24-item-1, ex:l7-next-24-item-2, ex:l7-next-24-item-3 ; cd:narration "The omnibus ANOVA gives evidence that at least one method mean differs. Now we want to localize the effect by comparing A with B, A with C, and B with C. A t-test for one specified pair asks how surprising that pair’s difference would be by chance. When we look at all three pairs, our error criterion is the chance of even one false positive anywhere in that family. Think about how you would detect that event in a repeated experiment if all three population means were equal. The next slide isolates the quantity that answers this question."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-24-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-24-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-24-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-24 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-24-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-24-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene25 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-25-focus ; cd:hasSceneItem ex:l7-next-25-item-1, ex:l7-next-25-item-2, ex:l7-next-25-item-3 ; cd:narration "Imagine repeating the experiment with three populations that all have 95 percent mean recovery and the same variance. In every repeat, take six preparations per method and calculate the three sample means. In the first example, the most separated means are A and B. In the next, they are A and C. In the third, they are B and C. Keep the distance from the lowest mean to the highest, because that is the biggest gap among all three pairs in that experiment. Divide by the estimated standard error of one method mean. Across many repeats, these standardized maxima form the studentized range distribution."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-25-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-25-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-25-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-25 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-25-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-25-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene26 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-26-focus ; cd:hasSceneItem ex:l7-next-26-item-1, ex:l7-next-26-item-2, ex:l7-next-26-item-3, ex:l7-next-26-item-4 ; cd:narration "Use the same largest-gap reference to make simultaneous 95 percent intervals. The cutoff 3.673 leaves five percent of the standardized maxima beyond it for three methods and fifteen residual degrees of freedom. Multiply by the standard error of one method mean to return to the original recovery scale: 3.673 times 0.577 gives a half-width of 2.12 percentage points. Center the interval at the observed B-minus-A gap of four points. The result runs from 1.88 to 6.12. We reuse the same half-width for all three pairs because the groups have equal sample sizes."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-26-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-26-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-26-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-tukey-interval ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-26-item-4 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-tukey-interval-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-next-26-item-4 .
  ex:l7-next-26-item-3 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-26-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene27 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-27-focus ; cd:hasSceneItem ex:l7-next-27-item-1, ex:l7-next-27-item-2, ex:l7-next-27-item-3 ; cd:narration "Apply the same Tukey interval rule to all three directed differences. In each row, the dot is the observed gap and the horizontal line is its simultaneous confidence interval. B minus A is four percentage points and stays above zero. C minus B is minus five and stays below zero. C minus A is minus one and its interval crosses zero, leaving the direction unresolved. Because we chose the width from the largest-gap reference, the three intervals jointly target 95 percent coverage under the model. The next slide shows how Holm works directly with a family of raw p-values."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-27-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-27-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-27-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-27-visual ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-27-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-27-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene28 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-28-focus ; cd:hasSceneItem ex:l7-next-28-item-1, ex:l7-next-28-item-2, ex:l7-next-28-item-3 ; cd:narration "We already calculated two-sided pooled t-test p-values for the three pairs, with ten degrees of freedom per test. Holm starts by sorting them from smallest to largest: B versus C, B versus A, then A versus C. Multiply them by three, two, and one respectively, reflecting the number of tests still under consideration. At each position keep the largest product seen so far and cap it at one. Here the products already increase, giving adjusted p-values of about 0.000336, 0.001248 and 0.24874. Bonferroni multiplies every raw p-value by three. Holm can adjust other prespecified families of valid tests as well."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-28-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-28-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-28-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-28 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-28-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-28-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene29 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-29-focus ; cd:hasSceneItem ex:l7-next-29-item-1, ex:l7-next-29-item-2, ex:l7-next-29-item-3 ; cd:narration "As in one-way ANOVA, start at the grand mean and add an effect for the chosen method. Now add a second effect for the chosen water matrix. For method B in river water, the grand mean is 92.83 percent. Method B is about 0.83 percentage points below the grand mean when averaged over matrices, and river water is about 2.17 points above it when averaged over methods. Combining those three quantities using unrounded means predicts 94.17 percent. An additive fit applies the same river-water shift to every method. The next slide separates what this model explains from what remains."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-29-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-29-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-29-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-additive-fit ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-29-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-29-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene30 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-30-focus ; cd:hasSceneItem ex:l7-next-30-item-1, ex:l7-next-30-item-2, ex:l7-next-30-item-3 ; cd:narration "Start with the same 18 river-water preparations. Each method was tested on six independent preparations. Now add wastewater as a second level of the matrix factor. Repeat the same three preparation methods with six independent wastewater preparations per method. Crossing the factors gives six method-by-matrix combinations and 36 observations. We can now ask two kinds of question: which overall averages change, and whether the method comparison itself changes between matrices. Each method and matrix combination needs its own independent preparations so that we can separate those effects from the residual spread."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-30-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-30-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-30-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-factorial-grid ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-30-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-30-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene31 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-31-focus ; cd:hasSceneItem ex:l7-next-31-item-1, ex:l7-next-31-item-2, ex:l7-next-31-item-3, ex:l7-teaching-31-formula ; cd:narration "Each entry shows the mean of six independent recoveries. To get the marginal mean for a method, read across that row and give both matrices equal weight. For B, 98 and 86 percent average to 92 percent. A gives 93 and C gives 93.5. To get a matrix marginal mean, read down the column and give all three methods equal weight. Here river water averages 95 percent and wastewater 90.67 percent. Across all 36 preparations the grand mean is 92.83 percent. These averages summarize the two main effects in the balanced design. The next slide adds the two shifts to the grand mean to predict an individual recovery."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-31-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-marginal-means ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-31-item-3 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-31-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene32 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-32-focus ; cd:hasSceneItem ex:l7-next-32-item-1, ex:l7-next-32-item-2, ex:l7-next-32-item-3 ; cd:narration "Read the points as you did in the one-way example. Each dot is the measured recovery from one independent preparation. The left panel repeats the river-water groups. The right panel adds the same three methods in wastewater, on exactly the same recovery scale. Reveal the mean for each method in each matrix. Method B has a different mean in river water and in wastewater. As before, variation remains around each fitted mean. Next we will separate the variation associated with the two factors from what remains."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-32-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-two-way-observations ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-32-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene33 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-33-focus ; cd:hasSceneItem ex:l7-next-33-item-1, ex:l7-next-33-item-2, ex:l7-next-33-item-3 ; cd:narration "The additive analysis gives a p-value above 0.05 for method and below 0.05 for water matrix. The fitted equations give B and A the same gap in both matrices, while the observed gaps go in opposite directions. What if the effect of one factor changes when we change the other? Consider plant growth. A plant grows ten centimeters under the baseline conditions. Fertilizer alone adds four centimeters, and extra light alone adds three. If their effects add, we expect seventeen centimeters with both treatments. Growth of twenty-one centimeters is four above that expectation: synergy. Growth of fourteen is three below it: antagonism. These are two directions of departure from additivity. Now return to recovery and allow the method effect to vary with the water matrix."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-33-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-33-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-33-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-33-visual ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-33-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-33-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene34 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-34-focus ; cd:hasSceneItem ex:l7-next-34-item-1, ex:l7-next-34-item-2, ex:l7-next-34-item-3, ex:l7-next-34-item-4 ; cd:narration "As in one-way ANOVA, calculate total variation as the sum of squared distances of all observations from the grand mean. Here the total is 521. The three method averages give a method sum of squares of 14, and the two matrix averages give a matrix sum of squares of 169. A method mean averages across both matrices, and a matrix mean averages across all methods. Each mean is weighted by the number of preparations behind it. The additive prediction combines the grand mean with the method and matrix shifts. Residual SS sums the squared distances from those predictions. It is 338. In this balanced design, the three contributions add to the total. Start the ANOVA table with these three rows."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-34-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-34-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-34-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-two-way-ss ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-34-item-4 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-two-way-ss-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-next-34-item-4 .
  ex:l7-next-34-item-3 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-34-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene35 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-35-focus ; cd:hasSceneItem ex:l7-next-35-item-1, ex:l7-next-35-item-2, ex:l7-next-35-item-3, ex:l7-next-35-item-4 ; cd:narration "In the recovery study, label the factors A for preparation method and B for water matrix. In R model notation, A star B expands to the two main effects and their interaction. Open the formula tab to see how that term enters the model for an individual preparation. For method B in river water, the additive prediction is 94.17 percent. The six B preparations in river water average 98 percent, so the fitted interaction adds 3.83 percentage points for method B in river water. One preparation measured 98.06 percent. Its residual is the remaining 0.06 percentage points above the fitted mean."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-35-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-35-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-35-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-model-components ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-35-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-35-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-35-item-4 a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:l7-next-35-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene36 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-36-focus ; cd:hasSceneItem ex:l7-next-36-item-1, ex:l7-next-36-item-2, ex:l7-next-36-item-3 ; cd:narration "Keep the additive ANOVA open below the new table. In the balanced design the method and matrix sums of squares stay at 14 and 169. The upper table adds a row for method by matrix, with sum of squares 278. The lower table shows where that variation came from: the additive residual was 338, leaving 60 after fitting the interaction. Add the degrees of freedom and notice that two move from the residual to the interaction. With the new residual mean square of two, the interaction F ratio is 139 divided by two, or 69.5. Its p-value gives evidence that the method effect depends on water matrix."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-36-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-36-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-36-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-two-way-table ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-36-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-36-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene37 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-37-focus ; cd:hasSceneItem ex:l7-next-37-item-1, ex:l7-next-37-item-2, ex:l7-next-37-item-3 ; cd:narration "Start with the two overall method means: B is 92 percent and A is 93 percent. Now separate the two matrices. In river water, B has the higher observed recovery, by four percentage points. In wastewater, B has the lower observed recovery, by six. The interaction test gives evidence that the pattern of method differences depends on matrix. The two gaps shown are estimates. To make a claim about a particular pair within either matrix, estimate its uncertainty and use a planned adjustment if it is part of a family of comparisons."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-37-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-37-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-37-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-two-way-interpretation ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-37-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-37-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene38 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-38-focus ; cd:hasSceneItem ex:l7-next-38-item-1, ex:l7-next-38-item-2, ex:l7-next-38-item-3 ; cd:narration "Suppose we also set extraction temperature at two levels. Cross those temperatures with the same two matrices and three methods to obtain twelve conditions. A three-way model can represent the three main effects, the three pairwise interactions, and the three-way interaction. The last term asks whether the method-by-matrix interaction itself changes with temperature. Use independent preparations in each condition and plan enough replication. The factorial structure answers which effects we can estimate. For a single factor, we also need to consider how the variances and the scientific question guide the choice of test."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-38-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-38-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-38-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-more-factors ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-38-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-38-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene39 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-39-focus ; cd:hasSceneItem ex:l7-next-39-item-1, ex:l7-next-39-item-2, ex:l7-next-39-item-3 ; cd:narration "Start with the preparation, not a normality test. If we inject one preparation repeatedly, we still have one independent experimental unit. For independent groups and a mean comparison, ordinary ANOVA assumes a common error variance; Welch can allow different group variances. Kruskal–Wallis uses ranks and answers a different question. It is useful when a comparison on the rank scale is appropriate, but it does not automatically answer the question about means. Next we will look at independent groups with substantially different variances."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-39-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-39-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-39-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-visual-39 ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-39-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-39-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene40 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-40-focus ; cd:hasSceneItem ex:l7-next-40-item-1, ex:l7-next-40-item-2, ex:l7-next-40-item-3 ; cd:narration "These are new illustrative recoveries from six independent preparations per method. Method B's points are much more dispersed than A's or C's, even though the group sizes are equal. Ordinary ANOVA pools the error variance. Welch ANOVA still compares population means, but it allows unequal variances and gives less weight to a group whose mean is estimated less precisely. It also adjusts the reference degrees of freedom. Look first at the spread of B, then see how that changes its weight on the calculation slide. Welch does not correct dependence or an unsuitable experimental design."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-40-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-40-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-40-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-welch-groups ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-40-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-40-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene41 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-41-focus ; cd:hasSceneItem ex:l7-next-41-item-1, ex:l7-next-41-item-2, ex:l7-next-41-item-3 ; cd:narration "Start with a small separate example: two recoveries for each of three independent methods. Sort all six recoveries together, from 81 to 92 percent. The two 84s share positions two and three, so both receive rank 2.5. Now return the ranks to their original methods. Their sums are 3.5 for A, 6.5 for B, and 11 for C. A large rank sum means a method tends to appear higher in this ordered sample. Kruskal-Wallis checks how unusual the overall rank separation is under exchangeability. An interpretation in terms of medians needs comparable distribution shapes."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-41-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-41-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-41-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-pool-ranks ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-41-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-41-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene42 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-42-focus ; cd:hasSceneItem ex:l7-next-42-item-1, ex:l7-next-42-item-2, ex:l7-next-42-item-3 ; cd:narration "Each preparation is measured for two analytes. Keep those two recoveries together as a pair, so one dot represents one independent preparation rather than two. The horizontal axis shows analyte one and the vertical axis analyte two. Each SPE method has a center with two coordinates. MANOVA asks whether the population centers are the same as vectors. A shift can appear mostly in one coordinate or in a combination of both, and the correlation within groups matters. There is still only one explanatory factor, SPE method. The second measured response does not create a second experimental factor."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-42-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-42-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-42-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-manova-pairs ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-42-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-42-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene45 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-45-focus ; cd:hasSceneItem ex:l7-next-45-item-1, ex:l7-next-45-item-2, ex:l7-next-45-item-3 ; cd:narration "Give yourself a moment to choose the model for each case. In the first case, compare means for three independent methods within one matrix, assuming the classical error model is appropriate. A one-way ANOVA fits that question. In the second, each method is tested in both matrices, so a two-way model can test whether the method effect depends on matrix. In the third, we still want to compare means across independent methods, but the group variances differ. Welch ANOVA addresses that question. In each case, start with what counts as one independent preparation."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-45-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-45-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-45-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-review-cases ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-45-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-45-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene46 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-46-focus ; cd:hasSceneItem ex:l7-next-46-item-1, ex:l7-next-46-item-2, ex:l7-next-46-item-3 ; cd:narration "Now read the verified synthetic teaching output as evidence within a specified model. The balanced one-way example uses six independent preparations per method and reports F of 21 with 2 and 15 degrees of freedom, p approximately 0.0000448, and eta squared approximately 0.737. Identify this as evidence against equal method means, not proof that every pair differs. Ask for diagnostics and adjusted pairwise comparisons before naming differences. Separately, the two-way example has a significant method-by-matrix interaction, so marginal method effects are not within-matrix conclusions. Next, connect these reporting decisions to explained and unexplained variation."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-46-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-46-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-46-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l7-next-46-table ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-46-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-46-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-scene47 a cd:SceneDefinition ; cd:focusConcept ex:l7-next-47-focus ; cd:hasSceneItem ex:l7-next-47-item-1, ex:l7-next-47-item-2, ex:l7-next-47-item-3 ; cd:narration "Return to the river-water study. We started with one recovery per independent preparation and asked whether the preparation methods differ. F compared the variation associated with method to the residual variation. The residual plots checked features of the error model, and eta squared described the observed share of variation associated with method. Adding wastewater changed the scientific question because the method gap depended on matrix. When you report your own analysis, state the design, the model, the magnitude of the effect, and the comparisons that answer the analytical question."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-47-item-1 a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l7-next-47-heading ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-47-item-2 a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:level7-anova-model-checklist ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-47-item-3 a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l7-next-47-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
