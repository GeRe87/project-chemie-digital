  ex:level7-anova-kw-rank-sums a cd:MediaAsset ; skos:prefLabel "Kruskal–Wallis: the evidence is in the rank sums"@en ; cd:uri "/chemometrics/level7-anova-kw-rank-sums.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Rank sums are 3.5, 6.5 and 11.0. Correcting for tied ranks gives H 4.191. Of 90 equally likely allocations with two per group, 12 are as extreme, so exact p is 0.133."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:level7-anova-kw-rank-sums .
  ex:l7-teaching-kw-formula a cd:MathExpression ; skos:prefLabel "Rank sums, ties and the reference"@en ; cd:body "Rank sums, ties and the reference"@en ; cd:latex "\\begin{aligned}H_{\\rm raw}&=\\frac{12}{N(N+1)}\\sum_{i=1}^{k}\\frac{R_i^2}{n_i}-3(N+1)\\\\C&=1-\\frac{\\sum_j(t_j^3-t_j)}{N^3-N},& H&=H_{\\rm raw}/C\\end{aligned}" ; dct:hasPart ex:l7-teaching-kw-formula-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-kw-formula .
  ex:l7-teaching-kw-formula-legend a cd:DefinitionList ; skos:prefLabel "Symbols"@en ; cd:hasDefinitionListEntry ex:l7-teaching-kw-formula-symbol-1, ex:l7-teaching-kw-formula-symbol-2, ex:l7-teaching-kw-formula-symbol-3 ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-kw-formula-legend .
  ex:l7-teaching-kw-formula-symbol-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Ranks and counts"@en ; cd:body "Rᵢ is group i's pooled rank sum; nᵢ is its sample size; N = 6 is the total, and k = 3 is the group count. tⱼ is the number of values in tied set j."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-kw-formula-symbol-1 .
  ex:l7-teaching-kw-formula-symbol-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Statistic"@en ; cd:body "H_raw is the uncorrected statistic, C is the tie correction, and H is the dimensionless corrected statistic."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-kw-formula-symbol-2 .
  ex:l7-teaching-kw-formula-symbol-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Operations and reference"@en ; cd:body "Σ sums over groups or tied sets; fractions divide, powers 2 and 3 square and cube, parentheses group terms, juxtaposition multiplies, and +, −, = denote addition, subtraction and equality. Exact p counts equally likely label allocations at least as extreme under exchangeability."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-kw-formula-symbol-3 .
  ex:l7-teaching-41-example-heading a cd:Interpretation ; skos:prefLabel "Kruskal–Wallis: from ranks to the test"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-41-example-heading .
  ex:l7-teaching-41-example-conclusion a cd:Interpretation ; cd:body "The tied ranks give H = 4.191; the exact test gives p = 0.133 for this small example."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-41-example-conclusion .
