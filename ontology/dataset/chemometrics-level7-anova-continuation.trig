  ex:l7-next-32-heading a cd:Interpretation ; skos:prefLabel "What do the 36 recoveries look like?"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-takeaway a cd:Interpretation ; cd:body "Each method–matrix combination has six independent recoveries."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-focus a cd:Concept ; skos:prefLabel "The main effect of matrix"@en ; cd:hasDefinition ex:l7-next-32-definition ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-32-definition a cd:Definition ; cd:body "What does the average matrix effect describe? The matrix main effect compares recovery averaged equally across all three methods in this balanced design."@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
