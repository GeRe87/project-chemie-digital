  ex:l7-next-30-table-col-3 a cd:TableColumn ; cd:position 3 ; skos:prefLabel "Method B"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-next-30-table-col-4 a cd:TableColumn ; cd:position 4 ; skos:prefLabel "Method C"@en ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
