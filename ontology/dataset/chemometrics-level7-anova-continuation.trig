  ex:l7-teaching-manova-null a cd:MathExpression ; skos:prefLabel "Compare joint population mean vectors"@en ; cd:body "Compare joint population mean vectors"@en ; cd:latex "\\boldsymbol\\mu_i=(\\mu_{i1},\\mu_{i2})^{\\mathsf T},\\qquad H_0:\\;\\boldsymbol\\mu_A=\\boldsymbol\\mu_B=\\boldsymbol\\mu_C" ; dct:hasPart ex:l7-teaching-manova-null-legend ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-teaching-manova-null .
