@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/chemometrics-introduction> {
  # Slide 1 — title -----------------------------------------------------------
  ex:chemometrics-course-title a cd:Concept ;
    skos:prefLabel "Chemometrics & Applied Statistics"@en ;
    cd:hasDefinition ex:def-chemometrics-course-title ;
    cd:authoredResource true .

  ex:def-chemometrics-course-title a cd:Definition ;
    cd:body "The opening scene frames Chemometrics and Applied Statistics as the connection between analytical measurements, quantitative reasoning and defensible interpretation."@en ;
    cd:authoredResource true .

  ex:chemometrics-title-pillars a cd:Interpretation ;
    cd:body "Three recurring questions structure the course."@en ;
    cd:hasKeyPoint ex:chemometrics-title-pillar-understand,
      ex:chemometrics-title-pillar-uncertainty,
      ex:chemometrics-title-pillar-interpret ;
    cd:authoredResource true .

  ex:chemometrics-title-pillar-understand a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """UNDERSTAND DATA
Recognize structure, variation and assumptions in analytical measurements."""@en ;
    cd:authoredResource true .

  ex:chemometrics-title-pillar-uncertainty a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """QUANTIFY UNCERTAINTY
Separate variation, evidence and model limitations from apparent certainty."""@en ;
    cd:authoredResource true .

  ex:chemometrics-title-pillar-interpret a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """INTERPRET RESULTS
Turn calculations and models into conclusions that make chemical sense."""@en ;
    cd:authoredResource true .

  ex:chemometrics-title-attribution a cd:Attribution ;
    cd:body "Gerrit Renner · Analytical Data Science · Instrumental Analytical Chemistry"@en ;
    cd:authoredResource true .

  ex:chemometrics-title-takeaway a cd:Interpretation ;
    cd:body "UNIVERSITY OF DUISBURG-ESSEN · MASTER COURSE"@en ;
    cd:authoredResource true .

  # Slide 2 — course overview ------------------------------------------------
  ex:chemometrics-course-overview a cd:Concept ;
    skos:prefLabel "What is this course about?"@en ;
    cd:hasDefinition ex:def-chemometrics-course-overview ;
    cd:authoredResource true .

  ex:def-chemometrics-course-overview a cd:Definition ;
    cd:body "The course overview describes the purpose, scope and learning orientation of Chemometrics and Applied Statistics."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-banner a cd:Interpretation ;
    cd:body """CHEMOMETRICS = DATA + CHEMISTRY + DECISIONS
Quantitative methods become useful when they answer an analytical question."""@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-foundation a cd:Interpretation ;
    cd:body """METHOD + ASSUMPTIONS + INTERPRETATION
We do not just calculate — we ask what a method measures, what it assumes and what its result means."""@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-list a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:chemometrics-course-overview-statistics,
      ex:chemometrics-course-overview-chemometrics,
      ex:chemometrics-course-overview-analytical-context,
      ex:chemometrics-course-overview-reproducibility ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-statistics a cd:DefinitionListEntry ;
    cd:position 1 ;
    skos:prefLabel "Statistics"@en ;
    cd:body "Describe variation, distributions, uncertainty and evidence."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-chemometrics a cd:DefinitionListEntry ;
    cd:position 2 ;
    skos:prefLabel "Chemometrics"@en ;
    cd:body "Model complex and multivariate chemical data."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-analytical-context a cd:DefinitionListEntry ;
    cd:position 3 ;
    skos:prefLabel "Analytical context"@en ;
    cd:body "Connect methods to real measurements, instruments and chemical questions."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-reproducibility a cd:DefinitionListEntry ;
    cd:position 4 ;
    skos:prefLabel "Reproducibility"@en ;
    cd:body "Make calculations transparent, inspectable and repeatable."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-overview-takeaway a cd:Interpretation ;
    cd:body "FROM RAW MEASUREMENTS → DEFENSIBLE INTERPRETATION"@en ;
    cd:authoredResource true .

  # Slide 3 — lecturer -------------------------------------------------------
  ex:chemometrics-lecturer-context a cd:Concept ;
    skos:prefLabel "About the Lecturer"@en ;
    cd:hasDefinition ex:def-chemometrics-lecturer-context ;
    cd:authoredResource true .

  ex:def-chemometrics-lecturer-context a cd:Definition ;
    cd:body "The lecturer context introduces the teaching perspective and disciplinary background from which the course is presented."@en ;
    cd:authoredResource true .

  ex:attribution-chemometrics-gerrit-renner a cd:Attribution ;
    cd:body "Gerrit Renner — Analytical Data Science, Instrumental Analytical Chemistry, University of Duisburg-Essen"@en ;
    cd:authoredResource true .

  ex:chemometrics-lecturer-pillars a cd:Interpretation ;
    cd:body "The course is taught from three connected perspectives."@en ;
    cd:hasKeyPoint ex:chemometrics-lecturer-pillar-data-science,
      ex:chemometrics-lecturer-pillar-instrumental,
      ex:chemometrics-lecturer-pillar-research-teaching ;
    cd:authoredResource true .

  ex:chemometrics-lecturer-pillar-data-science a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """ANALYTICAL DATA SCIENCE
Algorithms, statistics and data workflows for analytical chemistry."""@en ;
    cd:authoredResource true .

  ex:chemometrics-lecturer-pillar-instrumental a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """INSTRUMENTAL ANALYTICAL CHEMISTRY
Complex signals, measurement systems and quantitative analytical data."""@en ;
    cd:authoredResource true .

  ex:chemometrics-lecturer-pillar-research-teaching a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """RESEARCH + TEACHING
Methods should be explainable, reproducible and connected to real analytical problems."""@en ;
    cd:authoredResource true .

  ex:chemometrics-lecturer-takeaway a cd:Interpretation ;
    cd:body "GERRIT RENNER · ANALYTICAL DATA SCIENCE · IAC · UNIVERSITY OF DUISBURG-ESSEN"@en ;
    cd:authoredResource true .

  # Slide 4 — course format --------------------------------------------------
  ex:chemometrics-course-format a cd:Concept ;
    skos:prefLabel "Lecture and Tutorial"@en ;
    cd:hasDefinition ex:def-chemometrics-course-format ;
    cd:authoredResource true .

  ex:def-chemometrics-course-format a cd:Definition ;
    cd:body "The course format describes how lecture, tutorial, reproducible computation, questions and discussion work together."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-banner a cd:Interpretation ;
    cd:body """LEARN → PRACTICE → REPRODUCE → DISCUSS
Each format has a distinct role in building statistical reasoning."""@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-foundation a cd:Interpretation ;
    cd:body """ONE METHOD — FOUR PERSPECTIVES
Concepts are taught together with assumptions, calculation, application and interpretation."""@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-list a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:chemometrics-course-format-lecture,
      ex:chemometrics-course-format-tutorial,
      ex:chemometrics-course-format-reproducible-computation,
      ex:chemometrics-course-format-questions ;
    cd:authoredResource true .

  ex:chemometrics-course-format-lecture a cd:DefinitionListEntry ;
    cd:position 1 ;
    skos:prefLabel "Lecture"@en ;
    cd:body "Concepts · assumptions · derivations · interpretation"@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-tutorial a cd:DefinitionListEntry ;
    cd:position 2 ;
    skos:prefLabel "Tutorial"@en ;
    cd:body "Exercises · calculations · discussion · transfer"@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-reproducible-computation a cd:DefinitionListEntry ;
    cd:position 3 ;
    skos:prefLabel "Reproducible computation"@en ;
    cd:body "Transparent code-based examples where computation helps understanding."@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-questions a cd:DefinitionListEntry ;
    cd:position 4 ;
    skos:prefLabel "Questions and discussion"@en ;
    cd:body "Compare reasoning · challenge assumptions · resolve open questions"@en ;
    cd:authoredResource true .

  ex:chemometrics-course-format-takeaway a cd:Interpretation ;
    cd:body "THE GOAL IS NOT FORMULA RECALL — IT IS REASONED DATA ANALYSIS"@en ;
    cd:authoredResource true .

  ex:diagram-chemometrics-course-format a cd:FlowDiagram ;
    skos:prefLabel "Course learning cycle"@en ;
    cd:body "Lecture introduces a method, tutorial turns it into practice, reproducible computation makes the calculation inspectable, and discussion tests the reasoning."@en ;
    cd:hasDiagramNode ex:node-chemometrics-format-lecture,
      ex:node-chemometrics-format-tutorial,
      ex:node-chemometrics-format-reproduce,
      ex:node-chemometrics-format-discuss ;
    cd:hasDiagramEdge ex:edge-chemometrics-format-1-2,
      ex:edge-chemometrics-format-2-3,
      ex:edge-chemometrics-format-3-4 ;
    cd:authoredResource true .

  ex:node-chemometrics-format-lecture a cd:DiagramNode ;
    cd:position 1 ;
    skos:prefLabel "LECTURE"@en ;
    cd:body "Concepts · assumptions · interpretation"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-format-tutorial a cd:DiagramNode ;
    cd:position 2 ;
    skos:prefLabel "TUTORIAL"@en ;
    cd:body "Exercises · calculations · transfer"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-format-reproduce a cd:DiagramNode ;
    cd:position 3 ;
    skos:prefLabel "REPRODUCE"@en ;
    cd:body "Transparent code · inspectable calculation"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-format-discuss a cd:DiagramNode ;
    cd:position 4 ;
    skos:prefLabel "DISCUSS"@en ;
    cd:body "Compare reasoning · challenge assumptions"@en ;
    cd:authoredResource true .

  ex:edge-chemometrics-format-1-2 a cd:DiagramEdge ;
    cd:position 1 ;
    skos:prefLabel "practice"@en ;
    cd:sourceNode ex:node-chemometrics-format-lecture ;
    cd:targetNode ex:node-chemometrics-format-tutorial ;
    cd:authoredResource true .

  ex:edge-chemometrics-format-2-3 a cd:DiagramEdge ;
    cd:position 2 ;
    skos:prefLabel "make reproducible"@en ;
    cd:sourceNode ex:node-chemometrics-format-tutorial ;
    cd:targetNode ex:node-chemometrics-format-reproduce ;
    cd:authoredResource true .

  ex:edge-chemometrics-format-3-4 a cd:DiagramEdge ;
    cd:position 3 ;
    skos:prefLabel "reflect"@en ;
    cd:sourceNode ex:node-chemometrics-format-reproduce ;
    cd:targetNode ex:node-chemometrics-format-discuss ;
    cd:authoredResource true .

  # Slide 5 — course roadmap -------------------------------------------------
  ex:chemometrics-course-roadmap a cd:Concept ;
    skos:prefLabel "Course Roadmap"@en ;
    cd:hasDefinition ex:def-chemometrics-course-roadmap ;
    cd:hasDiagram ex:diagram-chemometrics-course-roadmap ;
    cd:authoredResource true .

  ex:def-chemometrics-course-roadmap a cd:Definition ;
    cd:body "The course roadmap groups the main lecture topics into a progression from statistical foundations to multivariate analysis and machine learning."@en ;
    cd:authoredResource true .

  ex:diagram-chemometrics-course-roadmap a cd:FlowDiagram ;
    skos:prefLabel "Chemometrics course roadmap"@en ;
    cd:body "The course progresses from statistical foundations through inference, modeling and experimental design to multivariate analysis and machine learning."@en ;
    cd:hasDiagramNode ex:node-chemometrics-roadmap-foundations,
      ex:node-chemometrics-roadmap-inference,
      ex:node-chemometrics-roadmap-regression,
      ex:node-chemometrics-roadmap-doe,
      ex:node-chemometrics-roadmap-multivariate,
      ex:node-chemometrics-roadmap-machine-learning ;
    cd:hasDiagramEdge ex:edge-chemometrics-roadmap-1-2,
      ex:edge-chemometrics-roadmap-2-3,
      ex:edge-chemometrics-roadmap-3-4,
      ex:edge-chemometrics-roadmap-4-5,
      ex:edge-chemometrics-roadmap-5-6 ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-foundations a cd:DiagramNode ;
    cd:position 1 ;
    skos:prefLabel "STATISTICAL FOUNDATIONS"@en ;
    cd:body "Random variables · mean values · dispersion · distributions"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-inference a cd:DiagramNode ;
    cd:position 2 ;
    skos:prefLabel "INFERENCE"@en ;
    cd:body "Hypothesis testing · t-tests · ANOVA"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-regression a cd:DiagramNode ;
    cd:position 3 ;
    skos:prefLabel "REGRESSION + UNCERTAINTY"@en ;
    cd:body "Models · diagnostics · confidence · validation"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-doe a cd:DiagramNode ;
    cd:position 4 ;
    skos:prefLabel "DESIGN OF EXPERIMENTS"@en ;
    cd:body "Effects · interactions · optimization"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-multivariate a cd:DiagramNode ;
    cd:position 5 ;
    skos:prefLabel "MULTIVARIATE ANALYSIS"@en ;
    cd:body "Similarity · clustering · PCA"@en ;
    cd:authoredResource true .

  ex:node-chemometrics-roadmap-machine-learning a cd:DiagramNode ;
    cd:position 6 ;
    skos:prefLabel "MACHINE LEARNING"@en ;
    cd:body "Prediction · classification · validation"@en ;
    cd:authoredResource true .

  ex:edge-chemometrics-roadmap-1-2 a cd:DiagramEdge ;
    cd:position 1 ;
    skos:prefLabel "builds on"@en ;
    cd:sourceNode ex:node-chemometrics-roadmap-foundations ;
    cd:targetNode ex:node-chemometrics-roadmap-inference ;
    cd:authoredResource true .

  ex:edge-chemometrics-roadmap-2-3 a cd:DiagramEdge ;
    cd:position 2 ;
    skos:prefLabel "builds on"@en ;
    cd:sourceNode ex:node-chemometrics-roadmap-inference ;
    cd:targetNode ex:node-chemometrics-roadmap-regression ;
    cd:authoredResource true .

  ex:edge-chemometrics-roadmap-3-4 a cd:DiagramEdge ;
    cd:position 3 ;
    skos:prefLabel "builds on"@en ;
    cd:sourceNode ex:node-chemometrics-roadmap-regression ;
    cd:targetNode ex:node-chemometrics-roadmap-doe ;
    cd:authoredResource true .

  ex:edge-chemometrics-roadmap-4-5 a cd:DiagramEdge ;
    cd:position 4 ;
    skos:prefLabel "builds on"@en ;
    cd:sourceNode ex:node-chemometrics-roadmap-doe ;
    cd:targetNode ex:node-chemometrics-roadmap-multivariate ;
    cd:authoredResource true .

  ex:edge-chemometrics-roadmap-5-6 a cd:DiagramEdge ;
    cd:position 5 ;
    skos:prefLabel "builds on"@en ;
    cd:sourceNode ex:node-chemometrics-roadmap-multivariate ;
    cd:targetNode ex:node-chemometrics-roadmap-machine-learning ;
    cd:authoredResource true .

  # Slide 6 — introduction round --------------------------------------------
  ex:chemometrics-introduction-round a cd:Concept ;
    skos:prefLabel "Introduction Round"@en ;
    cd:hasDefinition ex:def-chemometrics-introduction-round ;
    cd:authoredResource true .

  ex:def-chemometrics-introduction-round a cd:Definition ;
    cd:body "The introduction round is a short opening activity for sharing background, prior experience and learning expectations."@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-banner a cd:Interpretation ;
    cd:body """YOUR TURN
Give the room a compact picture of where you are starting from."""@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-foundation a cd:Interpretation ;
    cd:body """FOUR SHORT PROMPTS
Keep it brief — the goal is context, not a complete biography."""@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-prompts a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:chemometrics-introduction-round-background,
      ex:chemometrics-introduction-round-statistics,
      ex:chemometrics-introduction-round-tools,
      ex:chemometrics-introduction-round-goal ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-background a cd:DefinitionListEntry ;
    cd:position 1 ;
    skos:prefLabel "Your background"@en ;
    cd:body "Study programme, discipline or scientific background."@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-statistics a cd:DefinitionListEntry ;
    cd:position 2 ;
    skos:prefLabel "Statistics & chemometrics"@en ;
    cd:body "What have you used before — if anything?"@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-tools a cd:DefinitionListEntry ;
    cd:position 3 ;
    skos:prefLabel "Data-analysis tools"@en ;
    cd:body "R, Python, spreadsheets or other tools you already know."@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-goal a cd:DefinitionListEntry ;
    cd:position 4 ;
    skos:prefLabel "Your goal"@en ;
    cd:body "One thing you would like to take away from this course."@en ;
    cd:authoredResource true .

  ex:chemometrics-introduction-round-takeaway a cd:Interpretation ;
    cd:body "YOUR STARTING POINT HELPS US CONNECT THE COURSE TO THE ROOM"@en ;
    cd:authoredResource true .

  # Retained long-form exercise for self-study/accessibility reuse -----------
  ex:exercise-chemometrics-introduction-round a cd:Exercise ;
    cd:body "Briefly introduce yourself: your study programme or scientific background, your previous experience with statistics or chemometrics, your experience with R or other data-analysis tools, and one thing you would like to take away from this course."@en ;
    cd:authoredResource true .
}
