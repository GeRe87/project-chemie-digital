@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/specifications/variance-review3> {
  ex:vs-model a cd:Interpretation ; skos:prefLabel "Known population for variance simulations"@en ; cd:body "Independent normal observations with population mean μ = 10 mg/L, population variance σ² = 5 (mg/L)², and population SD σ = √5 mg/L. The population is deliberately known for checking estimators. The illustrative Series A/B and the QC observations are separate teaching datasets, not records of these random draws."@en ; cd:hasCodeExample ex:vs-exp1-code, ex:vs-exp2-code, ex:vs-mc-code ; cd:authoredResource true .
  ex:vs-Delta-symbol a cd:MathSymbol ; cd:symbol "Δ" ; cd:body "Random sample mean minus fixed population mean. This common offset is shared by every observation in one sample; it is not an individual residual d_i."@en ; cd:authoredResource true .
  ex:vs-X-symbol a cd:MathSymbol ; cd:symbol "X" ; cd:body "One random observation from the population, before a specific value is observed."@en ; cd:authoredResource true .
  ex:vs-pop-formula cd:hasSymbol ex:vs-X-symbol .
  ex:vs-theory-formula cd:hasSymbol ex:vr-E-symbol, ex:vr-msd-symbol, ex:n-symbol .
  ex:vs-calc05 a cd:Interpretation ; cd:hasKeyPoint ex:vs-calc05-k ; dct:source ex:vr05 ; cd:authoredResource true .
  ex:vs-calc05-k a cd:KeyPoint ; cd:position 1 ; cd:body "A signed deviation gives direction and distance from the sample mean."@en ; cd:authoredResource true .
  ex:vs-calc06 a cd:Interpretation ; cd:hasKeyPoint ex:vs-calc06-k ; dct:source ex:vr06 ; cd:authoredResource true .
  ex:vs-calc06-k a cd:KeyPoint ; cd:position 1 ; cd:body "Deviations sum to zero: a fundamental property of the arithmetic mean."@en ; cd:authoredResource true .
  ex:vs-calc07 a cd:Interpretation ; cd:hasKeyPoint ex:vs-calc07-k ; dct:source ex:vr07 ; cd:authoredResource true .
  ex:vs-calc07-k a cd:KeyPoint ; cd:position 1 ; cd:body "Squared deviations do not cancel and therefore preserve information about spread."@en ; cd:authoredResource true .
  ex:vs-calc08 a cd:Interpretation ; cd:hasKeyPoint ex:vs-calc08-k ; dct:source ex:vr08 ; cd:authoredResource true .
  ex:vs-calc08-k a cd:KeyPoint ; cd:position 1 ; cd:body "MSD describes the average squared deviation per observation."@en ; cd:authoredResource true .
  ex:vs-dev-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-dev-l1, ex:vs-dev-l2 ; cd:authoredResource true .
  ex:vs-dev-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observation and center"@en ; cd:body "xᵢ: individual observation i; i: observation index. x̄: arithmetic sample mean."@en ; dct:references ex:xi-symbol, ex:xbar-symbol, ex:vr-index-symbol ; cd:authoredResource true .
  ex:vs-dev-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Signed deviation"@en ; cd:body "dᵢ: observation minus its sample mean. Positive is above, negative below. Values and deviations have the same unit, here mg/L."@en ; dct:references ex:vr-d-symbol ; cd:authoredResource true .
  ex:vs-cancel-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-cancel-l1, ex:vs-cancel-l2 ; cd:authoredResource true .
  ex:vs-cancel-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Values and count"@en ; cd:body "xᵢ: observation i; i: index; x̄: arithmetic sample mean. n: number of observations."@en ; cd:authoredResource true .
  ex:vs-cancel-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Summation identity"@en ; cd:body "Σ adds terms from i = 1 to n. Summing the same mean n times gives nx̄, which equals the sum of the observations. Their difference is zero."@en ; cd:authoredResource true .
  ex:vs-ss-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-ss-l1, ex:vs-ss-l2 ; cd:authoredResource true .
  ex:vs-ss-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Square each deviation"@en ; cd:body "xᵢ: observation i; i: index; x̄: sample mean; dᵢ: their signed difference. Superscript 2 denotes squaring."@en ; cd:authoredResource true .
  ex:vs-ss-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "SS: Sum of Squares"@en ; cd:body "n: observation count; Σ: sum from 1 to n. SS adds the squared deviations. Squaring mg/L produces the unit (mg/L)²."@en ; cd:authoredResource true .
  ex:vs-msd-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-msd-l1, ex:vs-msd-l2 ; cd:authoredResource true .
  ex:vs-msd-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Mean squared deviation"@en ; cd:body "MSD: mean squared deviation; SS: sum of squared deviations. xᵢ: observation i; i: index; x̄: sample mean; n: count; Σ: sum from 1 to n."@en ; cd:authoredResource true .
  ex:vs-msd-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Squared unit, not absolute distance"@en ; cd:body "The deviations are squared before averaging, so MSD has unit (mg/L)². Division by a count does not change that unit. MSD is not mean absolute distance."@en ; cd:authoredResource true .

  ex:vs-transition a cd:Interpretation ; cd:body "Descriptive MSD correctly describes observed values about their observed mean. If those values are sampled, using this statistic to estimate population variance introduces a new target and a question about bias. The descriptive statistic is not inherently erroneous."@en ; cd:hasKeyPoint ex:vs-transition-k ; dct:source ex:vr09, ex:vr10 ; cd:authoredResource true .
  ex:vs-transition-k a cd:KeyPoint ; cd:position 1 ; cd:body "μ is usually unknown; x̄ is estimated. How well does MSD estimate the unknown population variance?"@en ; cd:authoredResource true .
  ex:vs-pop-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\mu=\\operatorname{E}[X]\\\\\\sigma^2=\\operatorname{E}[(X-\\mu)^2]\\end{gathered}" ; dct:hasPart ex:vs-pop-legend ; cd:hasSymbol ex:mu-symbol, ex:vr-E-symbol, ex:vr-sigma2-symbol ; cd:authoredResource true .
  ex:vs-pop-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-pop-l1, ex:vs-pop-l2, ex:vs-pop-l3 ; cd:authoredResource true .
  ex:vs-pop-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Population quantity"@en ; cd:body "X: one random observation from the population. μ: its population mean. E: expectation under that population, not an average of the observed sample alone."@en ; cd:authoredResource true .
  ex:vs-pop-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Population variance"@en ; cd:body "σ²: expected squared distance from μ. Superscript 2 means square. Its unit is (mg/L)² when X has unit mg/L."@en ; cd:authoredResource true .
  ex:vs-pop-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "A new estimation question"@en ; cd:body "The laboratory usually does not know μ. x̄ is the sample mean fitted from observed values. MSD about x̄ is valid descriptively; its repeated-sampling behavior determines its quality as an estimator."@en ; cd:authoredResource true .

  ex:vs-exp1-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; dct:source ex:vs-model ; cd:code "# Prepared instructor demonstration\nset.seed(1901)\n# Preserve the original seeded drawing order\nsizes <- c(100, 50, 25, 10, 5, 3, 2)\ndraws1 <- do.call(rbind, lapply(sizes, function(n) {\n  t(replicate(5, {\n    x <- rnorm(n, 10, sqrt(5)); m <- mean(x)\n    c(n = n, xbar = m, MSD = mean((x-m)^2))\n  }))\n}))\ndraws1 <- draws1[order(draws1[, 'n']), ]\nround(draws1, 3)" ; cd:authoredResource true .
  ex:vs-exp2-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; dct:source ex:vs-model ; cd:code "# Prepared instructor demonstration: all n from 2 to 100\nset.seed(1902)\ndraws2 <- do.call(rbind, lapply(2:100, function(n) {\n  t(replicate(5, {\n    x <- rnorm(n, 10, sqrt(5)); m <- mean(x)\n    c(n = n, xbar = m, MSD = mean((x-m)^2))\n  }))\n}))\n# All 495 estimates remain in draws2; preview seven sizes\nround(draws2[draws2[, 'n'] %in% c(2,3,5,10,25,50,100), ], 3)" ; cd:authoredResource true .
  ex:vs-mc a cd:Interpretation ; skos:prefLabel "Many Repetitions Check Average Bias"@en ; cd:hasCodeExample ex:vs-mc-code ; dct:source ex:vs-model ; cd:authoredResource true .
  ex:vs-mc-task a cd:Exercise ; cd:body "Prepared instructor demonstration, not a student coding task. Use 5,000 independent samples at each displayed size and compare average MSD with the known population variance 5 (mg/L)². Seed 1903. These are reproducible Monte-Carlo approximations, not exact expectations. What could cause a persistent shortfall?"@en ; cd:hasCodeExample ex:vs-mc-code ; cd:authoredResource true .
  ex:vs-mc-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; dct:source ex:vs-model ; cd:code "# Prepared instructor demonstration\nset.seed(1903)\nmc <- t(sapply(c(2, 3, 5, 10, 25, 50, 100), function(n) {\n  z <- replicate(5000, {\n    x <- rnorm(n, 10, sqrt(5)); m <- mean(x)\n    c(xbar = m, MSD = mean((x-m)^2))\n  })\n  c(n = n, rowMeans(z))\n}))\nround(mc, 3)" ; cd:authoredResource true .
  ex:vs-exp1-view a cd:Interpretation ; skos:prefLabel "Five Estimates at Each Sample Size"@en ; cd:hasKeyPoint ex:vs-exp1-k ; dct:source ex:vs-exp1-code ; cd:authoredResource true .
  ex:vs-exp1-k a cd:KeyPoint ; cd:position 1 ; cd:body "Five repetitions show random variability, not reliable evidence of estimator bias."@en ; cd:authoredResource true .
  ex:vs-d100 a cd:Dataset ; cd:unit "(mg/L)²" ; dct:source ex:vs-exp1-code ; cd:hasObservation ex:vs-o100a, ex:vs-o100b, ex:vs-o100c, ex:vs-o100d, ex:vs-o100e ; cd:authoredResource true .
  ex:vs-d50 a cd:Dataset ; cd:unit "(mg/L)²" ; dct:source ex:vs-exp1-code ; cd:hasObservation ex:vs-o50a, ex:vs-o50b, ex:vs-o50c, ex:vs-o50d, ex:vs-o50e ; cd:authoredResource true .
