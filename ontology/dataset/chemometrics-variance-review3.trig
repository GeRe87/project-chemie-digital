  ex:vs-theory a cd:Interpretation ; skos:prefLabel "The Expected MSD Across Sample Sizes"@en ; cd:hasKeyPoint ex:vs-theory-k ; dct:source ex:vs-model ; cd:authoredResource true .
  ex:vs-theory-k a cd:KeyPoint ; cd:position 1 ; cd:body "Bias concerns an estimator's expectation. Five fluctuating estimates do not establish it."@en ; cd:authoredResource true .
  ex:vs-theory-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[\\mathrm{MSD}_n]=5\\,\\frac{n-1}{n}" ; dct:hasPart ex:vs-theory-legend ; cd:authoredResource true .
  ex:vs-theory-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-theory-l1, ex:vs-theory-l2 ; cd:authoredResource true .
  ex:vs-theory-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Expectation and sample size"@en ; cd:body "E: repeated-sampling expectation. MSDₙ: descriptive mean squared deviation in a sample of n independent observations, centered on its sample mean. n ranges from 2 to 100."@en ; cd:authoredResource true .
  ex:vs-theory-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Known population variance"@en ; cd:body "5 is the population variance in (mg/L)². Independent normal draws imply this theoretical expectation. It is not a curve fitted to the five-repeat results."@en ; cd:authoredResource true .
