  ex:vs-t5v a cd:TableCell ; cd:position 2 ; cd:body "4.000"@en ; cd:authoredResource true .
  ex:vs-t10n a cd:TableCell ; cd:position 1 ; cd:body "10"@en ; cd:authoredResource true .
  ex:vs-t10v a cd:TableCell ; cd:position 2 ; cd:body "4.500"@en ; cd:authoredResource true .
  ex:vs-t25n a cd:TableCell ; cd:position 1 ; cd:body "25"@en ; cd:authoredResource true .
  ex:vs-t25v a cd:TableCell ; cd:position 2 ; cd:body "4.800"@en ; cd:authoredResource true .
  ex:vs-t50n a cd:TableCell ; cd:position 1 ; cd:body "50"@en ; cd:authoredResource true .
  ex:vs-t50v a cd:TableCell ; cd:position 2 ; cd:body "4.900"@en ; cd:authoredResource true .
  ex:vs-t100n a cd:TableCell ; cd:position 1 ; cd:body "100"@en ; cd:authoredResource true .
  ex:vs-t100v a cd:TableCell ; cd:position 2 ; cd:body "4.950"@en ; cd:authoredResource true .
  ex:vs-theory-preview a cd:TableDefinition ; skos:prefLabel "Selected expected MSD values ((mg/L)²)"@en ; cd:hasTableColumn ex:vs-pc1, ex:vs-pc2 ; cd:hasTableRow ex:vs-pr1, ex:vs-pr2, ex:vs-pr3 ; dct:source ex:vs-theory-table ; cd:authoredResource true .
  ex:vs-pc1 a cd:TableColumn ; cd:position 1 ; skos:prefLabel "n"@en ; cd:authoredResource true .
  ex:vs-pc2 a cd:TableColumn ; cd:position 2 ; skos:prefLabel "Expected MSD"@en ; cd:authoredResource true .
  ex:vs-pr1 a cd:TableRow ; cd:position 1 ; cd:hasTableCell ex:vs-p11, ex:vs-p12 ; cd:authoredResource true .
  ex:vs-pr2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:vs-p21, ex:vs-p22 ; cd:authoredResource true .
  ex:vs-pr3 a cd:TableRow ; cd:position 3 ; cd:hasTableCell ex:vs-p31, ex:vs-p32 ; cd:authoredResource true .
  ex:vs-p11 a cd:TableCell ; cd:position 1 ; cd:body "2"@en ; cd:authoredResource true .
  ex:vs-p12 a cd:TableCell ; cd:position 2 ; cd:body "2.500"@en ; cd:authoredResource true .
  ex:vs-p21 a cd:TableCell ; cd:position 1 ; cd:body "10"@en ; cd:authoredResource true .
  ex:vs-p22 a cd:TableCell ; cd:position 2 ; cd:body "4.500"@en ; cd:authoredResource true .
  ex:vs-p31 a cd:TableCell ; cd:position 1 ; cd:body "100"@en ; cd:authoredResource true .
  ex:vs-p32 a cd:TableCell ; cd:position 2 ; cd:body "4.950"@en ; cd:authoredResource true .

  ex:vs-center-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-center-l1, ex:vs-center-l2, ex:vs-center-l3 ; cd:authoredResource true .
  ex:vs-center-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random observations and mean"@en ; cd:body "Xᵢ: random observation i; i: observation index. X̄: sample mean. μ: fixed population mean, usually unknown in the laboratory."@en ; cd:authoredResource true .
  ex:vs-center-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Δ is shared; dᵢ is individual"@en ; cd:body "Δ = X̄ − μ: common center shift for the whole sample. dᵢ = Xᵢ − X̄: residual of observation i. Both have measurement units, but they are different quantities."@en ; cd:authoredResource true .
  ex:vs-center-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Before and after observing"@en ; cd:body "Capital X denotes random quantities across samples. Realized observations and their mean use lowercase xᵢ and x̄. The same decomposition holds for observed values."@en ; cd:authoredResource true .
  ex:vs-expand-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-expand-l1, ex:vs-expand-l2 ; cd:authoredResource true .
  ex:vs-expand-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols"@en ; cd:body "Xᵢ: observation i; i: index; μ: population mean. dᵢ: residual about the sample mean. Δ: sample mean minus μ, shared within the sample."@en ; cd:authoredResource true .
  ex:vs-expand-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Three terms"@en ; cd:body "Superscript 2 means square. Multiplying dᵢ + Δ by itself gives a residual square, two equal cross-products and the offset square. Every term has squared measurement units."@en ; cd:authoredResource true .
  ex:vs-sum-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-sum-l1, ex:vs-sum-l2, ex:vs-sum-l3 ; cd:authoredResource true .
  ex:vs-sum-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observations and residuals"@en ; cd:body "Xᵢ: observation i; μ: population mean; dᵢ: Xᵢ minus the sample mean. Δ: sample mean minus μ."@en ; cd:authoredResource true .
  ex:vs-sum-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Sum every term"@en ; cd:body "n: observation count; i: index. Every Σ adds from i = 1 to n. Superscript 2 means square. The coefficient 2 comes from the two cross-products."@en ; cd:authoredResource true .
  ex:vs-sum-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "One common offset"@en ; cd:body "Δ is identical for all observations within one sample, so it can be taken outside the cross-term sum. Do not omit the sum of offset squares."@en ; cd:authoredResource true .
  ex:vs-simplify a cd:Interpretation ; skos:prefLabel "Simplifying the Summation"@en ; dct:source ex:vr-sum-formula ; cd:authoredResource true .
  ex:vs-simplify-formula a cd:MathExpression ; cd:latex "\\begin{gathered}{\\textstyle\\sum_{i=1}^{n}}d_i=0,\\qquad2\\Delta{\\textstyle\\sum_{i=1}^{n}}d_i=0\\\\{\\textstyle\\sum_{i=1}^{n}}\\Delta^2=n\\Delta^2\\\\{\\textstyle\\sum_{i=1}^{n}}(X_i-\\mu)^2={\\textstyle\\sum_{i=1}^{n}}d_i^2+n\\Delta^2\\end{gathered}" ; dct:hasPart ex:vv-simplify-legend ; cd:hasSymbol ex:vs-Delta-symbol, ex:vr-X-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:vs-simplify-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-simplify-l1, ex:vs-simplify-l2, ex:vs-simplify-l3 ; cd:authoredResource true .
  ex:vs-simplify-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Residual sum"@en ; cd:body "dᵢ: observation Xᵢ minus its fitted sample mean; i: index. Residuals sum to zero, so the cross term is zero too."@en ; cd:authoredResource true .
  ex:vs-simplify-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Same shift n times"@en ; cd:body "Δ: sample mean minus population mean μ. n: observation count. Σ sums from 1 to n; superscript 2 squares. Summing the same Δ² n times gives nΔ²."@en ; cd:authoredResource true .
  ex:vs-simplify-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Fitting the center reduces the sum"@en ; cd:body "The offset-square term is nonnegative. The sum of squares about the fitted mean is therefore no larger than about μ. Expectations will quantify the average reduction."@en ; cd:authoredResource true .
  ex:vs-expect-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-expect-l1, ex:vs-expect-l2, ex:vs-expect-l3 ; cd:authoredResource true .
  ex:vs-expect-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random quantities"@en ; cd:body "Xᵢ: observation i; i: index; n: count greater than 1. dᵢ: residual about the sample mean. Δ: sample mean minus population mean μ."@en ; cd:authoredResource true .
  ex:vs-expect-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Expectation and variance"@en ; cd:body "E: repeated-sampling expectation. σ²: population variance. Σ sums from i = 1 to n. Superscript 2 means square. MSDₙ: sum of squared residuals divided by n. Here σ² = 5 (mg/L)²."@en ; cd:authoredResource true .
  ex:vs-expect-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Use the preceding result"@en ; cd:body "Independent identical sampling with finite variance gives E[nΔ²] = σ². Subtract this from nσ² to get the expected residual sum of squares; divide by n for expected MSD. Normality is not required."@en ; cd:authoredResource true .
  ex:vs-variance-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vs-variance-l1, ex:vs-variance-l2, ex:vs-variance-l3 ; cd:authoredResource true .
  ex:vs-variance-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Sample residuals"@en ; cd:body "dᵢ: observation i minus the fitted sample mean; i: index; n: count greater than 1. Σ adds squared residuals from i = 1 to n."@en ; cd:authoredResource true .
  ex:vs-variance-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Remove average variance bias"@en ; cd:body "s²: sample variance; σ²: population variance; E: expectation. Under independent identical sampling with finite variance, the numerator averages (n−1)σ². Division by n−1 therefore targets σ²."@en ; cd:authoredResource true .
  ex:vs-variance-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Two separate ideas"@en ; cd:body "This expectation argument explains unbiased variance estimation. Residual degrees of freedom describe constraints and will be discussed next. Neither argument makes the square-root estimator s automatically unbiased."@en ; cd:authoredResource true .

  ex:vs-precision-cue a cd:Interpretation ; cd:hasKeyPoint ex:vs-precision-k ; cd:authoredResource true .
  ex:vs-precision-k a cd:KeyPoint ; cd:position 1 ; cd:body "Precision describes agreement under stated measurement conditions."@en ; cd:authoredResource true .
  ex:vs-conditions-cue a cd:Interpretation ; cd:hasKeyPoint ex:vs-conditions-k ; cd:authoredResource true .
  ex:vs-conditions-k a cd:KeyPoint ; cd:position 1 ; cd:body "Choose and report the measurement conditions before interpreting an SD."@en ; cd:authoredResource true .
  ex:vs-quality-cue a cd:Interpretation ; cd:hasKeyPoint ex:vs-quality-k ; cd:authoredResource true .
  ex:vs-quality-k a cd:KeyPoint ; cd:position 1 ; cd:body "A small SD alone does not establish closeness to the reference or method suitability."@en ; cd:authoredResource true .
  ex:vs-replicates-cue a cd:Interpretation ; cd:hasKeyPoint ex:vs-replicates-k ; cd:authoredResource true .
  ex:vs-replicates-k a cd:KeyPoint ; cd:position 1 ; cd:body "Measurement repetitions are not automatically independent experimental units."@en ; cd:authoredResource true .
}

