    cd:authoredResource true .

  ex:node-cogniflow-explicit-output a cd:DiagramNode ;
    skos:prefLabel "OUTPUT"@en ;
    cd:position 3 ;
    cd:authoredResource true .

  ex:edge-cogniflow-explicit-input-processing a cd:DiagramEdge ;
    skos:prefLabel "consumed by"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-explicit-input ;
    cd:targetNode ex:node-cogniflow-explicit-processing ;
    cd:authoredResource true .

  ex:edge-cogniflow-explicit-processing-output a cd:DiagramEdge ;
