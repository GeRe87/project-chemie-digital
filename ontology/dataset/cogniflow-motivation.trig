    cd:position 5 ;
    cd:body "environment"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-missing-dependencies a cd:KeyPoint ;
    cd:position 6 ;
    cd:body "dependencies"@en ;
    cd:authoredResource true .

  ex:cogniflow-snr-example-heading a cd:Interpretation ;
    cd:body "EXAMPLE: SIGNAL-TO-NOISE RATIO"@en ;
    cd:authoredResource true .

  ex:cogniflow-snr-example a cd:Interpretation ;
    cd:body "The same analytical term can hide different operational definitions."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-snr-height-sd,
      ex:keypoint-cogniflow-snr-height-rms,
      ex:keypoint-cogniflow-snr-height-ptp,
      ex:keypoint-cogniflow-snr-area-noise ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-snr-height-sd a cd:KeyPoint ;
    cd:position 1 ;
    cd:body "S/N = peak height / σ(noise)"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-snr-height-rms a cd:KeyPoint ;
    cd:position 2 ;
    cd:body "S/N = peak height / RMS(noise)"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-snr-height-ptp a cd:KeyPoint ;
    cd:position 3 ;
    cd:body "S/N = 2 × peak height / peak-to-peak noise"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-snr-area-noise a cd:KeyPoint ;
    cd:position 4 ;
    cd:body "S/N = peak area / noise estimate"@en ;
    cd:authoredResource true .

  ex:cogniflow-snr-example-note a cd:Interpretation ;
    cd:body "Same label — different operational definitions."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-fair-processing-gap a cd:FlowDiagram ;
    skos:prefLabel "FAIR data can still pass through opaque custom processing"@en ;
    cd:body "Well-described FAIR data can enter custom processing and produce a scientific result even when the processing context is not explicit."@en ;
    cd:hasDiagramNode ex:node-cogniflow-fair-instrument,
      ex:node-cogniflow-fair-data,
      ex:node-cogniflow-fair-processing,
      ex:node-cogniflow-fair-result ;
    cd:hasDiagramEdge ex:edge-cogniflow-fair-instrument-data,
      ex:edge-cogniflow-fair-data-processing,
      ex:edge-cogniflow-fair-processing-result ;
    cd:focusNode ex:node-cogniflow-fair-processing ;
    cd:authoredResource true .

  ex:node-cogniflow-fair-instrument a cd:DiagramNode ;
    skos:prefLabel "INSTRUMENT"@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:node-cogniflow-fair-data a cd:DiagramNode ;
    skos:prefLabel """FAIR / OPEN
DATA"""@en ;
    cd:position 2 ;
    cd:authoredResource true .

  ex:node-cogniflow-fair-processing a cd:DiagramNode ;
    skos:prefLabel "CUSTOM PROCESSING"@en ;
    cd:position 3 ;
    cd:visualRole "highlight" ;
    cd:authoredResource true .

  ex:node-cogniflow-fair-result a cd:DiagramNode ;
    skos:prefLabel "RESULT"@en ;
    cd:position 4 ;
    cd:authoredResource true .

  ex:edge-cogniflow-fair-instrument-data a cd:DiagramEdge ;
    skos:prefLabel "measurement"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-fair-instrument ;
    cd:targetNode ex:node-cogniflow-fair-data ;
    cd:authoredResource true .

  ex:edge-cogniflow-fair-data-processing a cd:DiagramEdge ;
    skos:prefLabel "processed by"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-fair-data ;
    cd:targetNode ex:node-cogniflow-fair-processing ;
    cd:authoredResource true .

  ex:edge-cogniflow-fair-processing-result a cd:DiagramEdge ;
    skos:prefLabel "produces"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-result ;
    cd:authoredResource true .

  ex:cogniflow-explicit-processing-context a cd:Concept ;
    skos:prefLabel "Make Nothing Important Implicit"@en ;
    cd:hasDefinition ex:def-cogniflow-explicit-processing-context ;
    cd:authoredResource true .

  ex:def-cogniflow-explicit-processing-context a cd:Definition ;
    cd:body "CogniFlow treats the processing context itself as digital scientific information that can be understood by humans and machines."@en ;
    cd:authoredResource true .

  ex:cogniflow-explicit-example-heading a cd:Interpretation ;
    cd:body "EXAMPLE: S/N CALCULATION"@en ;
    cd:authoredResource true .

  ex:cogniflow-explicit-example a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:keypoint-cogniflow-explicit-example-purpose,
      ex:keypoint-cogniflow-explicit-example-input,
      ex:keypoint-cogniflow-explicit-example-output,
      ex:keypoint-cogniflow-explicit-example-parameters,
      ex:keypoint-cogniflow-explicit-example-implementation,
      ex:keypoint-cogniflow-explicit-example-version ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-example-purpose a cd:DefinitionListEntry ;
    cd:position 1 ;
    skos:prefLabel "purpose"@en ;
    cd:body "quantify signal relative to background"@en ;
