  ex:cogniflow-fair-data-intro a cd:Concept ;
    skos:prefLabel "What FAIR Data Means in Practice"@en ;
    cd:hasDefinition ex:def-cogniflow-fair-data-intro ;
    cd:authoredResource true .

  ex:def-cogniflow-fair-data-intro a cd:Definition ;
    cd:body "FAIR data are well-described digital objects that can be found, accessed under clear conditions, interpreted across systems and reused with sufficient context."@en ;
    cd:authoredResource true .

  ex:cogniflow-fair-data-principles a cd:Interpretation ;
    cd:body "The FAIR principles describe four complementary properties of reusable scientific data."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-fair-findable,
      ex:keypoint-cogniflow-fair-accessible,
      ex:keypoint-cogniflow-fair-interoperable,
      ex:keypoint-cogniflow-fair-reusable ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-fair-findable a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """F — FINDABLE
Persistent identifier + searchable metadata"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-fair-accessible a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """A — ACCESSIBLE
Retrievable under clear access conditions"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-fair-interoperable a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """I — INTEROPERABLE
Structured formats + shared vocabularies"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-fair-reusable a cd:KeyPoint ;
    cd:position 4 ;
    cd:body """R — REUSABLE
Rich metadata + provenance + clear reuse conditions"""@en ;
    cd:authoredResource true .

  ex:cogniflow-fair-data-object-caption a cd:Interpretation ;
    cd:body """FAIR DATA OBJECT
Illustrative LC-HRMS dataset"""@en ;
    cd:authoredResource true .

  ex:code-cogniflow-fair-data-object a cd:CodeExample ;
    skos:prefLabel "Illustrative FAIR LC-HRMS data object"@en ;
    cd:code """Field	Example
Identifier	doi:10.xxxx/sample.017
Data file	sample_017.mzML
Format	mzML
Sample	River water extract
Instrument	UHPLC-QTOF-MS
Metadata	structured + searchable
Vocabulary	controlled terms
Access	HTTPS / repository
Reuse	license + provenance""" ;
    cd:programmingLanguage "tsv" ;
    cd:editable false ;
    cd:executable false ;
    cd:showsResource ex:cogniflow-fair-data-intro ;
    cd:authoredResource true .

  ex:cogniflow-fair-processing-gap a cd:Concept ;
    skos:prefLabel "FAIR Data Are Not FAIR Processing"@en ;
    cd:hasDefinition ex:def-cogniflow-fair-processing-gap ;
    cd:authoredResource true .

  ex:def-cogniflow-fair-processing-gap a cd:Definition ;
    cd:body "Open formats and rich metadata can make data FAIR while the processing that transforms them into a scientific result remains insufficiently described."@en ;
    cd:authoredResource true .

  ex:cogniflow-missing-processing-context-heading a cd:Interpretation ;
    cd:body "MISSING CONTEXT"@en ;
    cd:authoredResource true .

  ex:cogniflow-missing-processing-context a cd:Interpretation ;
    cd:body "The crucial scientific and technical context of custom processing is often missing or implicit."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-missing-algorithm,
      ex:keypoint-cogniflow-missing-implementation,
      ex:keypoint-cogniflow-missing-version,
      ex:keypoint-cogniflow-missing-parameters,
      ex:keypoint-cogniflow-missing-environment,
      ex:keypoint-cogniflow-missing-dependencies ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-missing-algorithm a cd:KeyPoint ;
    cd:position 1 ;
    cd:body "algorithm"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-missing-implementation a cd:KeyPoint ;
    cd:position 2 ;
    cd:body "implementation"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-missing-version a cd:KeyPoint ;
    cd:position 3 ;
    cd:body "version"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-missing-parameters a cd:KeyPoint ;
    cd:position 4 ;
    cd:body "parameters"@en ;
    cd:authoredResource true .

