  ex:keypoint-cogniflow-explicit-example-input a cd:DefinitionListEntry ;
    cd:position 2 ;
    skos:prefLabel "input"@en ;
    cd:body "peak height + defined noise window"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-example-output a cd:DefinitionListEntry ;
    cd:position 3 ;
    skos:prefLabel "output"@en ;
    cd:body "S/N value"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-example-parameters a cd:DefinitionListEntry ;
    cd:position 4 ;
    skos:prefLabel "parameters"@en ;
    cd:body "noise window + RMS estimator"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-example-implementation a cd:DefinitionListEntry ;
    cd:position 5 ;
    skos:prefLabel "implementation"@en ;
    cd:body "calculate_snr() in a named package"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-example-version a cd:DefinitionListEntry ;
    cd:position 6 ;
    skos:prefLabel "version"@en ;
    cd:body "exact package release or commit"@en ;
    cd:authoredResource true .

  ex:cogniflow-explicit-example-note a cd:Interpretation ;
    cd:body "Now the processing step is no longer a black box."@en ;
    cd:authoredResource true .

  ex:cogniflow-explicit-context-heading a cd:Interpretation ;
    cd:body "EXPLICIT CONTEXT"@en ;
    cd:authoredResource true .

  ex:cogniflow-explicit-context a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:keypoint-cogniflow-explicit-purpose,
      ex:keypoint-cogniflow-explicit-interface,
      ex:keypoint-cogniflow-explicit-parameters,
      ex:keypoint-cogniflow-explicit-implementation,
      ex:keypoint-cogniflow-explicit-version,
      ex:keypoint-cogniflow-explicit-provenance ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-purpose a cd:DefinitionListEntry ;
    cd:position 1 ;
    skos:prefLabel "purpose"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-interface a cd:DefinitionListEntry ;
    cd:position 2 ;
    skos:prefLabel "interface"@en ;
    cd:body "inputs + outputs"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-parameters a cd:DefinitionListEntry ;
    cd:position 3 ;
    skos:prefLabel "parameters"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-implementation a cd:DefinitionListEntry ;
    cd:position 4 ;
    skos:prefLabel "implementation"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-version a cd:DefinitionListEntry ;
    cd:position 5 ;
    skos:prefLabel "version"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-explicit-provenance a cd:DefinitionListEntry ;
    cd:position 6 ;
    skos:prefLabel "execution"@en ;
    cd:body "+ provenance"@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-explicit-processing-context a cd:FlowDiagram ;
    skos:prefLabel "Processing as an explicit digital object"@en ;
    cd:body "Input, processing and output remain the scientific flow while the scientific and technical context is represented explicitly beside it."@en ;
    cd:hasDiagramNode ex:node-cogniflow-explicit-input,
      ex:node-cogniflow-explicit-processing,
      ex:node-cogniflow-explicit-output ;
