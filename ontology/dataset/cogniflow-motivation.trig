@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-motivation> {
  ex:cogniflow-processing-black-box a cd:Concept ;
    skos:prefLabel "What Happened Between the Raw Data and This Result?"@en ;
    cd:hasDefinition ex:def-cogniflow-processing-black-box ;
    cd:authoredResource true .

  ex:def-cogniflow-processing-black-box a cd:Definition ;
    cd:body "A scientific result depends on a processing history that is often much less visible than the raw data and the result themselves."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-processing-black-box a cd:FlowDiagram ;
    skos:prefLabel "The hidden processing history"@en ;
    cd:body "Raw analytical data and a final result are connected by processing whose scientific and technical context is often implicit."@en ;
    cd:hasDiagramNode ex:node-cogniflow-black-box-raw,
      ex:node-cogniflow-black-box-processing,
      ex:node-cogniflow-black-box-result ;
    cd:hasDiagramEdge ex:edge-cogniflow-black-box-raw-processing,
      ex:edge-cogniflow-black-box-processing-result ;
    cd:focusNode ex:node-cogniflow-black-box-processing ;
    cd:authoredResource true .

  ex:node-cogniflow-black-box-raw a cd:DiagramNode ;
    skos:prefLabel "RAW SIGNAL"@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:node-cogniflow-black-box-processing a cd:DiagramNode ;
    skos:prefLabel "PROCESSING ?"@en ;
    cd:position 2 ;
    cd:visualRole "highlight" ;
    cd:authoredResource true .

  ex:node-cogniflow-black-box-result a cd:DiagramNode ;
    skos:prefLabel "RESULT"@en ;
    cd:position 3 ;
    cd:authoredResource true .

  ex:edge-cogniflow-black-box-raw-processing a cd:DiagramEdge ;
    skos:prefLabel "transformed by"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-black-box-raw ;
    cd:targetNode ex:node-cogniflow-black-box-processing ;
    cd:authoredResource true .

  ex:edge-cogniflow-black-box-processing-result a cd:DiagramEdge ;
    skos:prefLabel "produces"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-black-box-processing ;
    cd:targetNode ex:node-cogniflow-black-box-result ;
    cd:authoredResource true .

  ex:cogniflow-fair-processing-gap a cd:Concept ;
    skos:prefLabel "FAIR Data Are Not FAIR Processing"@en ;
    cd:hasDefinition ex:def-cogniflow-fair-processing-gap ;
    cd:authoredResource true .

  ex:def-cogniflow-fair-processing-gap a cd:Definition ;
    cd:body "Open formats and rich metadata can make data FAIR while the processing that transforms them into a scientific result remains insufficiently described."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-fair-processing-gap a cd:FlowDiagram ;
    skos:prefLabel "Where FAIRness can stop"@en ;
    cd:body "An instrument can produce well-described open data while the custom processing step still hides algorithm, version, parameters, environment and dependencies."@en ;
    cd:hasDiagramNode ex:node-cogniflow-fair-instrument,
      ex:node-cogniflow-fair-data,
      ex:node-cogniflow-fair-processing,
      ex:node-cogniflow-fair-result,
      ex:node-cogniflow-fair-algorithm,
      ex:node-cogniflow-fair-version,
      ex:node-cogniflow-fair-parameters,
      ex:node-cogniflow-fair-environment,
      ex:node-cogniflow-fair-dependencies ;
    cd:hasDiagramEdge ex:edge-cogniflow-fair-instrument-data,
      ex:edge-cogniflow-fair-data-processing,
      ex:edge-cogniflow-fair-processing-result,
      ex:edge-cogniflow-fair-processing-algorithm,
      ex:edge-cogniflow-fair-processing-version,
      ex:edge-cogniflow-fair-processing-parameters,
      ex:edge-cogniflow-fair-processing-environment,
      ex:edge-cogniflow-fair-processing-dependencies ;
    cd:focusNode ex:node-cogniflow-fair-processing ;
    cd:authoredResource true .

  ex:node-cogniflow-fair-instrument a cd:DiagramNode ;
    skos:prefLabel "INSTRUMENT"@en ;
    cd:position 1 ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-data a cd:DiagramNode ;
    skos:prefLabel "FAIR / OPEN DATA"@en ;
    cd:position 2 ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-processing a cd:DiagramNode ;
    skos:prefLabel "CUSTOM PROCESSING"@en ;
    cd:position 3 ;
    cd:visualRole "highlight" ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-result a cd:DiagramNode ;
    skos:prefLabel "RESULT"@en ;
    cd:position 4 ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-algorithm a cd:DiagramNode ;
    skos:prefLabel "Which algorithm?"@en ;
    cd:position 5 ;
    cd:visualRole "comparison" ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-version a cd:DiagramNode ;
    skos:prefLabel "Which version?"@en ;
    cd:position 6 ;
    cd:visualRole "comparison" ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-parameters a cd:DiagramNode ;
    skos:prefLabel "Which parameters?"@en ;
    cd:position 7 ;
    cd:visualRole "comparison" ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-environment a cd:DiagramNode ;
    skos:prefLabel "Which environment?"@en ;
    cd:position 8 ;
    cd:visualRole "comparison" ;
    cd:authoredResource true .
  ex:node-cogniflow-fair-dependencies a cd:DiagramNode ;
    skos:prefLabel "Which dependencies?"@en ;
    cd:position 9 ;
    cd:visualRole "comparison" ;
    cd:authoredResource true .

  ex:edge-cogniflow-fair-instrument-data a cd:DiagramEdge ;
    skos:prefLabel "measurement"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-fair-instrument ;
    cd:targetNode ex:node-cogniflow-fair-data ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-data-processing a cd:DiagramEdge ;
    skos:prefLabel "processed by"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-fair-data ;
    cd:targetNode ex:node-cogniflow-fair-processing ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-result a cd:DiagramEdge ;
    skos:prefLabel "produces"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-result ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-algorithm a cd:DiagramEdge ;
    skos:prefLabel "implicit context"@en ;
    cd:position 4 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-algorithm ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-version a cd:DiagramEdge ;
    skos:prefLabel "implicit context"@en ;
    cd:position 5 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-version ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-parameters a cd:DiagramEdge ;
    skos:prefLabel "implicit context"@en ;
    cd:position 6 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-parameters ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-environment a cd:DiagramEdge ;
    skos:prefLabel "implicit context"@en ;
    cd:position 7 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-environment ;
    cd:authoredResource true .
  ex:edge-cogniflow-fair-processing-dependencies a cd:DiagramEdge ;
    skos:prefLabel "implicit context"@en ;
    cd:position 8 ;
    cd:sourceNode ex:node-cogniflow-fair-processing ;
    cd:targetNode ex:node-cogniflow-fair-dependencies ;
    cd:authoredResource true .

  ex:cogniflow-explicit-processing-context a cd:Concept ;
    skos:prefLabel "Make Nothing Important Implicit"@en ;
    cd:hasDefinition ex:def-cogniflow-explicit-processing-context ;
    cd:authoredResource true .

  ex:def-cogniflow-explicit-processing-context a cd:Definition ;
    cd:body "CogniFlow treats the processing context itself as digital scientific information that can be understood by humans and machines."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-explicit-processing-context a cd:FlowDiagram, cd:NetworkDiagram ;
    skos:prefLabel "Processing as an explicit digital object"@en ;
    cd:body "Input, processing and output remain the scientific flow while purpose, interface, parameters, implementation, version and execution context become explicit machine-readable relationships."@en ;
    cd:hasDiagramNode ex:node-cogniflow-explicit-input,
      ex:node-cogniflow-explicit-processing,
      ex:node-cogniflow-explicit-output,
      ex:node-cogniflow-explicit-purpose,
      ex:node-cogniflow-explicit-interface,
      ex:node-cogniflow-explicit-parameters,
      ex:node-cogniflow-explicit-implementation,
      ex:node-cogniflow-explicit-version,
      ex:node-cogniflow-explicit-execution ;
    cd:hasDiagramGroup ex:diagram-group-cogniflow-explicit-flow,
      ex:diagram-group-cogniflow-explicit-context ;
    cd:hasDiagramEdge ex:edge-cogniflow-explicit-input-processing,
      ex:edge-cogniflow-explicit-processing-output,
      ex:edge-cogniflow-explicit-processing-purpose,
      ex:edge-cogniflow-explicit-processing-interface,
      ex:edge-cogniflow-explicit-processing-parameters,
      ex:edge-cogniflow-explicit-processing-implementation,
      ex:edge-cogniflow-explicit-processing-version,
      ex:edge-cogniflow-explicit-processing-execution ;
    cd:hasDiagramState ex:diagram-state-cogniflow-explicit-flow,
      ex:diagram-state-cogniflow-explicit-context ;
    cd:focusNode ex:node-cogniflow-explicit-processing ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-explicit-flow a cd:DiagramGroup ;
    skos:prefLabel "Scientific flow"@en ;
    cd:authoredResource true .
  ex:diagram-group-cogniflow-explicit-context a cd:DiagramGroup ;
    skos:prefLabel "Explicit processing context"@en ;
    cd:authoredResource true .

  ex:node-cogniflow-explicit-input a cd:DiagramNode ;
    skos:prefLabel "INPUT"@en ;
    cd:position 1 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-flow ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-processing a cd:DiagramNode ;
    skos:prefLabel "PROCESSING"@en ;
    cd:position 2 ;
    cd:visualRole "highlight" ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-flow ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-output a cd:DiagramNode ;
    skos:prefLabel "OUTPUT"@en ;
    cd:position 3 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-flow ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-purpose a cd:DiagramNode ;
    skos:prefLabel "What does it do?"@en ;
    cd:position 4 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-interface a cd:DiagramNode ;
    skos:prefLabel "What does it consume and produce?"@en ;
    cd:position 5 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-parameters a cd:DiagramNode ;
    skos:prefLabel "Which parameters?"@en ;
    cd:position 6 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-implementation a cd:DiagramNode ;
    skos:prefLabel "Which implementation?"@en ;
    cd:position 7 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-version a cd:DiagramNode ;
    skos:prefLabel "Which version?"@en ;
    cd:position 8 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .
  ex:node-cogniflow-explicit-execution a cd:DiagramNode ;
    skos:prefLabel "How was it executed?"@en ;
    cd:position 9 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:authoredResource true .

  ex:edge-cogniflow-explicit-input-processing a cd:DiagramEdge ;
    skos:prefLabel "consumed by"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-explicit-input ;
    cd:targetNode ex:node-cogniflow-explicit-processing ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-output a cd:DiagramEdge ;
    skos:prefLabel "produces"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-output ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-purpose a cd:DiagramEdge ;
    skos:prefLabel "purpose"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-purpose ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-interface a cd:DiagramEdge ;
    skos:prefLabel "interface"@en ;
    cd:position 4 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-interface ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-parameters a cd:DiagramEdge ;
    skos:prefLabel "parameters"@en ;
    cd:position 5 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-parameters ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-implementation a cd:DiagramEdge ;
    skos:prefLabel "implementation"@en ;
    cd:position 6 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-implementation ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-version a cd:DiagramEdge ;
    skos:prefLabel "version"@en ;
    cd:position 7 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-version ;
    cd:authoredResource true .
  ex:edge-cogniflow-explicit-processing-execution a cd:DiagramEdge ;
    skos:prefLabel "execution + provenance"@en ;
    cd:position 8 ;
    cd:sourceNode ex:node-cogniflow-explicit-processing ;
    cd:targetNode ex:node-cogniflow-explicit-execution ;
    cd:authoredResource true .

  ex:diagram-state-cogniflow-explicit-flow a cd:DiagramState ;
    cd:position 1 ;
    skos:prefLabel "Scientific flow"@en ;
    cd:activeDiagramNode ex:node-cogniflow-explicit-input,
      ex:node-cogniflow-explicit-processing,
      ex:node-cogniflow-explicit-output ;
    cd:activeDiagramEdge ex:edge-cogniflow-explicit-input-processing,
      ex:edge-cogniflow-explicit-processing-output ;
    cd:activeDiagramGroup ex:diagram-group-cogniflow-explicit-flow ;
    cd:focusDiagramNode ex:node-cogniflow-explicit-processing ;
    cd:authoredResource true .

  ex:diagram-state-cogniflow-explicit-context a cd:DiagramState ;
    cd:position 2 ;
    skos:prefLabel "Explicit processing context"@en ;
    cd:activeDiagramNode ex:node-cogniflow-explicit-input,
      ex:node-cogniflow-explicit-processing,
      ex:node-cogniflow-explicit-output,
      ex:node-cogniflow-explicit-purpose,
      ex:node-cogniflow-explicit-interface,
      ex:node-cogniflow-explicit-parameters,
      ex:node-cogniflow-explicit-implementation,
      ex:node-cogniflow-explicit-version,
      ex:node-cogniflow-explicit-execution ;
    cd:activeDiagramEdge ex:edge-cogniflow-explicit-input-processing,
      ex:edge-cogniflow-explicit-processing-output,
      ex:edge-cogniflow-explicit-processing-purpose,
      ex:edge-cogniflow-explicit-processing-interface,
      ex:edge-cogniflow-explicit-processing-parameters,
      ex:edge-cogniflow-explicit-processing-implementation,
      ex:edge-cogniflow-explicit-processing-version,
      ex:edge-cogniflow-explicit-processing-execution ;
    cd:activeDiagramGroup ex:diagram-group-cogniflow-explicit-flow,
      ex:diagram-group-cogniflow-explicit-context ;
    cd:focusDiagramGroup ex:diagram-group-cogniflow-explicit-context ;
    cd:contextDiagramGroup ex:diagram-group-cogniflow-explicit-flow ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-motivation-extension> {
  ex:path-step-cogniflow-processing-black-box a cd:PathStep ;
    cd:position 2 ;
    cd:usesResource ex:diagram-cogniflow-processing-black-box ;
    cd:usesScene ex:scene-cogniflow-processing-black-box ;
    cd:authoredResource true .

  ex:path-step-cogniflow-fair-processing-gap a cd:PathStep ;
    cd:position 3 ;
    cd:usesResource ex:diagram-cogniflow-fair-processing-gap ;
    cd:usesScene ex:scene-cogniflow-fair-processing-gap ;
    cd:authoredResource true .

  ex:path-step-cogniflow-explicit-processing-context a cd:PathStep ;
    cd:position 4 ;
    cd:usesResource ex:diagram-cogniflow-explicit-processing-context ;
    cd:usesScene ex:scene-cogniflow-explicit-processing-context ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-motivation> {
  ex:scene-cogniflow-processing-black-box a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-processing-black-box ;
    cd:hasSceneItem ex:scene-item-cogniflow-processing-black-box-heading,
      ex:scene-item-cogniflow-processing-black-box-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-black-box-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-processing-black-box ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-processing-black-box-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-processing-black-box ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-cogniflow-fair-processing-gap a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-fair-processing-gap ;
    cd:hasSceneItem ex:scene-item-cogniflow-fair-processing-gap-heading,
      ex:scene-item-cogniflow-fair-processing-gap-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-fair-processing-gap-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-fair-processing-gap ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-fair-processing-gap-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-fair-processing-gap ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-cogniflow-explicit-processing-context a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-explicit-processing-context ;
    cd:hasSceneItem ex:scene-item-cogniflow-explicit-processing-context-heading,
      ex:scene-item-cogniflow-explicit-processing-context-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-explicit-processing-context-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-explicit-processing-context ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-explicit-processing-context-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-explicit-processing-context ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
