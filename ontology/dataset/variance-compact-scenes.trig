<https://w3id.org/project-chemie-digital/graph/specifications/variance-compact-scenes> {
  ex:md-sum-zero dct:hasPart ex:cv-zero-legend .
  ex:cv-zero-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cv-zero-symbols ; cd:authoredResource true .
  ex:cv-zero-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Residual sum constraint"@en ; cd:body "Signed residuals from one fitted arithmetic mean."@en ; dct:references ex:vr-d-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:cv-zero-title a cd:Interpretation ; skos:prefLabel "Residuals Share One Exact Constraint"@en ; cd:hasKeyPoint ex:cv-zero-k ; cd:authoredResource true .
  ex:cv-zero-k a cd:KeyPoint ; cd:position 1 ; cd:body "Signed deviations from the mean of these same observations sum to zero. Squaring them will retain their size without cancellation."@en ; cd:authoredResource true .
  ex:cv-compare-title a cd:Interpretation ; skos:prefLabel "From Empirical MSD to Theoretical Variance"@en ; cd:hasKeyPoint ex:cv-compare-k1, ex:cv-compare-k2 ; cd:authoredResource true .
  ex:cv-compare-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "MSD describes this observed sample around its fitted mean. Lowercase xᵢ and x̄ are realized values."@en ; cd:authoredResource true .
  ex:cv-compare-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Variance describes the underlying random variable around its expectation. The generally unknown σ² is our estimation target."@en ; cd:authoredResource true .
  ex:cv-empirical-msd a cd:MathExpression ; cd:formulaLabel "Computed from observed measurements"@en ; cd:latex "\\mathrm{MSD}_n=\\frac1n{\\textstyle\\sum_{i=1}^n}(x_i-\\bar x)^2" ; cd:hasSymbol ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:xi-symbol, ex:xbar-symbol ; dct:hasPart ex:cv-empirical-legend ; dct:source ex:vr-msd-formula ; cd:authoredResource true .
  ex:cv-empirical-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cv-empirical-symbols ; cd:authoredResource true .
  ex:cv-empirical-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed sample"@en ; cd:body "The count, observations and their fitted mean are empirically available."@en ; dct:references ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:xi-symbol, ex:xbar-symbol ; cd:authoredResource true .
  ex:cv-population-summary a cd:MathExpression ; cd:formulaLabel "Defined by the underlying distribution"@en ; cd:latex "\\begin{aligned}\\mu&=\\operatorname{E}[X]\\\\\\operatorname{Var}(X)&=\\operatorname{E}[(X-\\operatorname{E}[X])^2]\\\\&=\\operatorname{E}[(X-\\mu)^2]=\\sigma^2\\end{aligned}" ; cd:hasSymbol ex:mu-symbol, ex:vr-E-symbol, ex:vs-X-symbol, ex:vm-var-symbol, ex:vr-sigma2-symbol ; dct:hasPart ex:bf-definition-legend ; dct:source ex:uq-pop-mean, ex:bf-variance-definition ; cd:authoredResource true .
  ex:cv-rules-title a cd:Interpretation ; skos:prefLabel "Variance Rules: Scaling and Covariance"@en ; cd:hasKeyPoint ex:cv-rules-k1, ex:cv-rules-k2 ; cd:authoredResource true .
  ex:cv-rules-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "A fixed shift preserves variance; scaling by a multiplies it by a². Finite second moments are assumed."@en ; cd:authoredResource true .
  ex:cv-rules-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Independent finite-variance variables have zero covariance. Expectation linearity applies to both dependent and independent terms with existing expectations."@en ; cd:authoredResource true .
  ex:cv-question-title a cd:Interpretation ; skos:prefLabel "Does the MSD Estimate the True Variance Without Bias?"@en ; cd:hasKeyPoint ex:cv-question-k1, ex:cv-question-k2 ; cd:authoredResource true .
  ex:cv-question-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Xᵢ and X̄ vary over hypothetical repeated samples. We seek the statistic's expectation across those samples."@en ; cd:authoredResource true .
  ex:cv-question-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "One MSD may be above or below σ². Systematic underestimation concerns its expectation; simulated averages only approximate that expectation."@en ; cd:authoredResource true .
  ex:cv-random-msd a cd:MathExpression ; cd:formulaLabel "Statistic across hypothetical samples"@en ; cd:latex "\\mathrm{MSD}_n=\\frac1n{\\textstyle\\sum_{i=1}^n}(X_i-\\bar X)^2" ; cd:hasSymbol ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:vr-Xbar-symbol ; dct:hasPart ex:cv-random-legend ; cd:authoredResource true .
  ex:cv-random-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cv-random-symbols ; cd:authoredResource true .
  ex:cv-random-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Repeated sampling"@en ; cd:body "The count stays fixed, but observations and their mean vary."@en ; dct:references ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:vr-Xbar-symbol ; cd:authoredResource true .
  ex:cv-question-equation a cd:MathExpression ; cd:formulaLabel "Compare the expected estimate with the unknown target"@en ; cd:latex "\\operatorname{E}[\\mathrm{MSD}_n]\\;\\overset{?}{=}\\;\\sigma^2" ; cd:hasSymbol ex:vr-E-symbol, ex:bf-msd-symbol, ex:vr-sigma2-symbol ; dct:hasPart ex:cv-question-legend ; cd:authoredResource true .
  ex:cv-question-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cv-question-symbols ; cd:authoredResource true .
  ex:cv-question-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Estimator and estimand"@en ; cd:body "The population variance is the target; the expectation describes the estimator's average."@en ; dct:references ex:vr-E-symbol, ex:bf-msd-symbol, ex:vr-sigma2-symbol ; cd:authoredResource true .
  ex:cv-algebra-title a cd:Interpretation ; skos:prefLabel "Where Does the MSD Shortfall Come From?"@en ; cd:authoredResource true .
  ex:cv-expect-title a cd:Interpretation ; skos:prefLabel "Average the Identity over Repeated Samples"@en ; cd:authoredResource true .
  ex:cv-helper-title a cd:Interpretation ; skos:prefLabel "The Needed Result: Variance of the Sample Mean"@en ; cd:hasKeyPoint ex:cv-helper-k1, ex:cv-helper-k2 ; cd:authoredResource true .
  ex:cv-helper-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Equal means, equal finite variances and pairwise zero covariance suffice. Independent identical sampling meets these conditions across distribution families."@en ; cd:authoredResource true .
  ex:cv-helper-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "This theoretical variance describes how means vary across samples. Open the derivation to connect it with the population variance and sampling assumptions."@en ; cd:authoredResource true .
  ex:cv-bias-title a cd:Interpretation ; skos:prefLabel "The MSD Is Too Small in Expectation"@en ; cd:hasKeyPoint ex:cv-bias-k1, ex:cv-bias-k2 ; cd:authoredResource true .
  ex:cv-bias-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Insert Var(X̄) = σ²/n into E[MSDₙ] = σ² − Var(X̄), then factor the common σ²."@en ; cd:authoredResource true .
  ex:cv-bias-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Under the preceding sampling assumptions, the estimator's expectation is (n−1)/n times the population variance. Individual estimates retain sampling variation."@en ; cd:authoredResource true .
  ex:cv-correct-title a cd:Interpretation ; skos:prefLabel "Bessel's Correction Removes the Systematic Bias"@en ; cd:authoredResource true .
  ex:cv-practical-title a cd:Interpretation ; skos:prefLabel "Use the Correction on Observed Measurements"@en ; cd:hasKeyPoint ex:cv-practical-k1, ex:cv-practical-k2 ; cd:authoredResource true .
  ex:cv-practical-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "S² denotes the statistic across samples; s² is its observed value. The practical calculation uses xᵢ, x̄ and n > 1, quantities available from the sample."@en ; cd:authoredResource true .
  ex:cv-practical-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Unbiasedness means that the estimator's expectation equals population variance under the stated assumptions. Each realized s² has sampling variation."@en ; cd:authoredResource true .
  ex:cv-df-title a cd:Interpretation ; skos:prefLabel "Degrees of Freedom: n−1 Free Residuals"@en ; cd:hasKeyPoint ex:cv-df-k1, ex:cv-df-k2 ; cd:authoredResource true .
  ex:cv-df-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "For Series A (9, 10, 13 mg/L), x̄ = 32/3 mg/L. Once the first two residuals are chosen, the third must complete the zero sum."@en ; cd:authoredResource true .
  ex:cv-df-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Fitting one mean leaves n−1 freely varying residuals. This count explains the constraint; the preceding expectation argument proves the bias correction."@en ; cd:authoredResource true .
  ex:cv-df-constraint a cd:MathExpression ; cd:formulaLabel "Residuals from the same fitted mean"@en ; cd:latex "\\begin{gathered}d_i=x_i-\\bar x\\\\\\sum_{i=1}^n d_i=0\\quad\\Rightarrow\\quad\\mathrm{df}=n-1\\end{gathered}" ; cd:hasSymbol ex:vr-d-symbol, ex:xi-symbol, ex:xbar-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol, ex:df-symbol ; dct:hasPart ex:vr-df-legend ; cd:authoredResource true .
  ex:cv-df-example a cd:MathExpression ; cd:formulaLabel "Three observations, two freely varying residuals"@en ; cd:latex "\\begin{gathered}d_3=-(d_1+d_2)\\\\d_1=-\\frac53,\\quad d_2=-\\frac23\\\\d_3=\\frac73\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:vr-d-symbol ; dct:source ex:vr-data-a ; dct:hasPart ex:cv-df-example-legend ; cd:authoredResource true .
  ex:cv-df-example-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:cv-df-example-symbols ; cd:authoredResource true .
  ex:cv-df-example-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed residuals"@en ; cd:body "The displayed residual values are in mg/L. Freely varying coordinates do not assert statistical independence."@en ; dct:references ex:vr-d-symbol ; cd:authoredResource true .
}

