  ex:mv-legend-growthG-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "100, 2"@en ; cd:body "Initial count 100; two equal periods lead to 1600 cells."@en ; cd:authoredResource true .
