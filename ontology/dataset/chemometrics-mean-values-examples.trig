  ex:mv-legend-expectation-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "P(X=x)"@en ; cd:body "Probability that X takes the value x. These model probabilities sum to 1 and weight the possible values; they are not observed sample frequencies."@en ; cd:authoredResource true .
