  ex:mv-legend-countG-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "G, ∛"@en ; cd:body "Geometric mean of three positive counts; ∛ is the cube root."@en ; cd:authoredResource true .
  ex:mv-legend-countG-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "10, 100, 10000"@en ; cd:body "Illustrative counts per 100 mL; result has the same unit."@en ; cd:authoredResource true .
