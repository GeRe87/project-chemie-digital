  ex:mean-geometric-log-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "LOGARITHMIC SCALE"@en ; cd:body "Average logarithms, then exponentiate.\nUse scientifically meaningful equal log weights.\nNot a universal rule for rates."@en ; cd:visualMotif "inference" ; cd:authoredResource true .
  ex:def-geometric-mean dct:hasPart ex:mean-geometric-product-cards, ex:mean-geometric-log-cards .
  ex:mean-geometric-log-card-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\ell&=\\frac{1}{n}\\sum_{i=1}^{n}\\ln x_i\\\\G&=\\exp(\\ell),\\quad x_i>0\\end{aligned}" ; cd:body "Ell is the arithmetic mean of the logarithms of n strictly positive observations. The geometric mean G is the exponential of ell."@en ; cd:derivedFromResource ex:geometric-mean-log-formula ; cd:authoredResource true .
