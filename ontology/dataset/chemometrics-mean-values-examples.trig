  ex:mean-lln-fn-seed a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "set.seed(seed)"@en ; cd:body "Fixes the pseudorandom sequence for reproducible comparisons."@en ; cd:authoredResource true .
  ex:mean-lln-fn-replicate a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "replicate(n, expr)"@en ; cd:body "Repeats the five-dice experiment 50,000 times."@en ; cd:authoredResource true .
  ex:mean-lln-fn-sample a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "sample(x, size, replace)"@en ; cd:body "Draws five fair-die outcomes for each experiment."@en ; cd:authoredResource true .
