  # Locally derived demonstrations reuse the established fair-dice/growth/speed cases.
  ex:mean-bridge-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-bridge-theory, ex:mean-bridge-observed ; cd:authoredResource true .
  ex:mean-bridge-theory a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "THEORETICAL EXPECTATION"@en ; cd:body "Fair-dice model: E[S] = 17.5.\nA probability-weighted, long-run average, not a required single outcome."@en ; cd:derivedFromResource ex:mean-dice-expectation-example ; cd:authoredResource true .
  ex:mean-bridge-observed a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "REAL OBSERVATIONS"@en ; cd:body "Five experiment sums: 10, 13, 18, 10, 23.\nFinite random outcomes; each observed sum is an integer."@en ; cd:derivedFromResource ex:mean-dice-sums ; cd:authoredResource true .
  ex:mean-bridge-question a cd:Exercise ; cd:body """- [?] Why are the results different?
- We can estimate the expected value from appropriately sampled real data."""@en ; cd:hasExpectedResult ex:mean-bridge-answer ; cd:authoredResource true .
  ex:mean-bridge-answer a cd:ExpectedResult ; cd:body "The theoretical expectation summarizes a distribution. Individual sums fluctuate and a finite sample does not have to equal 17.5. Under suitable sampling assumptions, a sample arithmetic mean estimates the model expectation; this does not validate the model from one sample."@en ; cd:derivedFromResource ex:sample-mean-estimator-interpretation, ex:mean-dice-expected ; cd:authoredResource true .

  ex:mean-growth-calculation-heading a cd:Interpretation ; skos:prefLabel "Preserve the growth product"@en ; cd:body "Preserve the growth product"@en ; cd:authoredResource true .
  ex:mean-growth-general-note a cd:Interpretation ; cd:body "For positive factors over equal periods, the constant factor G preserves their product: applying G n times gives the same final multiplier."@en ; cd:derivedFromResource ex:geometric-mean-product-formula ; cd:authoredResource true .
  ex:mean-growth-r-heading a cd:Interpretation ; skos:prefLabel "Reproduce growth in R"@en ; cd:body "Reproduce growth in R"@en ; cd:authoredResource true .
  ex:mean-growth-r-practice a cd:Exercise ; cd:body """**Start with 100 cells and growth factors 2 and 8 over two equal periods.**

- [!] Calculate the geometric factor and use it twice to reconstruct the final count."""@en ; cd:hasExpectedResult ex:mean-growth-r-result ; cd:hasCodeExample ex:mean-growth-r ; cd:derivedFromResource ex:mean-growth-example ; cd:authoredResource true .
  ex:mean-growth-r-result a cd:ExpectedResult ; cd:body "The geometric factor is 4; applying it for two periods gives 100 times 4 squared = 1600 cells."@en ; cd:authoredResource true .
  ex:mean-growth-r a cd:CodeExample ; cd:code "factors <- c(2, 8)\ng <- prod(factors)^(1 / length(factors))\nlist(geometric = g, final_cells = 100 * g^length(factors))" ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:derivedFromResource ex:mean-growth-example ; dct:hasPart ex:mean-growth-r-functions ; cd:authoredResource true .
  ex:mean-growth-r-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-growth-fn-c, ex:mean-growth-fn-prod, ex:mean-growth-fn-length, ex:mean-growth-fn-list ; cd:authoredResource true .
  ex:mean-growth-fn-c a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "c(...)"@en ; cd:body "Combines the two positive growth factors into a vector."@en ; cd:authoredResource true .
  ex:mean-growth-fn-prod a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "prod(x)"@en ; cd:body "Multiplies the factors to obtain their total multiplier."@en ; cd:authoredResource true .
  ex:mean-growth-fn-length a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "length(x)"@en ; cd:body "Counts the factors, here the two equal-duration periods."@en ; cd:authoredResource true .
  ex:mean-growth-fn-list a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "list(...)"@en ; cd:body "Returns the geometric factor and reconstructed final count together."@en ; cd:authoredResource true .

  ex:mean-speed-comparison-heading a cd:Interpretation ; skos:prefLabel "Which average preserves travel time?"@en ; cd:body "Which average preserves travel time?"@en ; cd:authoredResource true .
  ex:mean-speed-comparison-note a cd:Interpretation ; cd:body "The real journey takes 10 + 50 = 60 s. Neither candidate preserves that time for 200 m. These averages are defined, but answer different weighting or product questions."@en ; cd:derivedFromResource ex:mean-speed-calculation ; cd:authoredResource true .
  ex:mean-speed-arithmetic-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-speed-arithmetic-card ; cd:authoredResource true .
  ex:mean-speed-arithmetic-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "ARITHMETIC CANDIDATE"@en ; cd:body "Equal-distance sections are not equal-time weights."@en ; cd:authoredResource true .
  ex:mean-speed-geometric-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-speed-geometric-card ; cd:authoredResource true .
  ex:mean-speed-geometric-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "GEOMETRIC CANDIDATE"@en ; cd:body "Preserving a product of speeds does not preserve total travel time."@en ; cd:authoredResource true .
  ex:mean-speed-arithmetic-formula a cd:MathExpression ; cd:latex "\\begin{aligned}A&=(10+2)/2=6\\;\\mathrm{m/s}\\\\t_A&=200/6\\approx33.33\\;\\mathrm{s}\\end{aligned}" ; cd:body "The arithmetic speed is 6 metres per second. At that constant speed, 200 metres would take about 33.33 seconds rather than 60 seconds."@en ; cd:derivedFromResource ex:mean-speed-calculation ; dct:hasPart ex:mean-speed-arithmetic-legend ; cd:authoredResource true .
  ex:mean-speed-geometric-formula a cd:MathExpression ; cd:latex "\\begin{aligned}G&=\\sqrt{10\\times2}\\approx4.472\\;\\mathrm{m/s}\\\\t_G&=200/\\sqrt{20}\\approx44.72\\;\\mathrm{s}\\end{aligned}" ; cd:body "The geometric speed is square root of 20, about 4.472 metres per second. At that constant speed, 200 metres would take about 44.72 seconds rather than 60 seconds."@en ; cd:derivedFromResource ex:mean-speed-calculation ; dct:hasPart ex:mean-speed-geometric-legend ; cd:authoredResource true .
  ex:mean-speed-arithmetic-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-speed-A-legend-1, ex:mean-speed-A-legend-2 ; cd:authoredResource true .
  ex:mean-speed-A-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A"@en ; cd:body "Arithmetic average of the two speeds, in m/s."@en ; cd:authoredResource true .
  ex:mean-speed-A-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "t_A, 200 m"@en ; cd:body "Predicted journey time if both 100 m sections were travelled at A."@en ; cd:authoredResource true .
  ex:mean-speed-geometric-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-speed-G-legend-1, ex:mean-speed-G-legend-2 ; cd:authoredResource true .
  ex:mean-speed-G-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "G"@en ; cd:body "Geometric average of the two positive speeds, in m/s."@en ; cd:authoredResource true .
  ex:mean-speed-G-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "t_G, 200 m"@en ; cd:body "Predicted journey time at constant speed G over the total distance."@en ; cd:authoredResource true .

  ex:mean-speed-r-heading a cd:Interpretation ; skos:prefLabel "Reproduce the journey in R"@en ; cd:body "Reproduce the journey in R"@en ; cd:authoredResource true .
  ex:mean-speed-r-practice a cd:Exercise ; cd:body """**Travel two equal 100 m sections at 10 and 2 m/s.**

- [!] Calculate section times, total time and overall speed.
- [!] Check that the harmonic mean gives the same overall speed."""@en ; cd:hasExpectedResult ex:mean-speed-r-result ; cd:hasCodeExample ex:mean-speed-r ; cd:derivedFromResource ex:mean-speed-calculation ; cd:authoredResource true .
  ex:mean-speed-r-result a cd:ExpectedResult ; cd:body "Section times are 10 and 50 s; total time is 60 s. Overall speed and harmonic mean are both 10/3 m/s, approximately 3.333 m/s."@en ; cd:authoredResource true .
  ex:mean-speed-r a cd:CodeExample ; cd:code "speeds <- c(10, 2)\ndistances <- rep(100, 2)\ntimes <- distances / speeds\nlist(times_s = times, total_time_s = sum(times),\n     overall_m_s = sum(distances) / sum(times),\n     harmonic_m_s = 1 / mean(1 / speeds))" ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:derivedFromResource ex:mean-speed-calculation ; dct:hasPart ex:mean-speed-r-functions ; cd:authoredResource true .
  ex:mean-speed-r-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mean-speed-fn-c, ex:mean-speed-fn-rep, ex:mean-speed-fn-sum, ex:mean-speed-fn-mean, ex:mean-speed-fn-list ; cd:authoredResource true .
  ex:mean-speed-fn-c a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "c(...)"@en ; cd:body "Combines the two section speeds into a vector."@en ; cd:authoredResource true .
  ex:mean-speed-fn-rep a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "rep(x, times)"@en ; cd:body "Repeats 100 m twice to represent equal section distances."@en ; cd:authoredResource true .
  ex:mean-speed-fn-sum a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "sum(x)"@en ; cd:body "Adds section distances or travel times to their journey totals."@en ; cd:authoredResource true .
  ex:mean-speed-fn-mean a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "mean(x)"@en ; cd:body "Averages reciprocal speeds; taking its reciprocal gives the harmonic mean."@en ; cd:authoredResource true .
  ex:mean-speed-fn-list a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "list(...)"@en ; cd:body "Returns named times and speeds together, with units in their names."@en ; cd:authoredResource true .
