  ex:mean-layers-diagram a cd:FlowDiagram ; skos:prefLabel "Diffusion resistances in series"@en ; cd:body "Flux passes through two equal-thickness layers with equal area. At steady state the same flux crosses both; their resistances add."@en ; cd:hasDiagramNode ex:mean-layer-fast, ex:mean-layer-slow ; cd:hasDiagramEdge ex:mean-layer-flux ; cd:authoredResource true .
  ex:mean-layer-fast a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "LAYER 1"@en ; cd:body "D = 2 × 10^-6 m²/s\nThickness L, area A"@en ; cd:authoredResource true .
  ex:mean-layer-slow a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "LAYER 2"@en ; cd:body "D = 10^-8 m²/s\nThickness L, area A"@en ; cd:authoredResource true .
