@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-core> {
  ex:cogniflow-semantic-core a cd:Concept ;
    skos:prefLabel "CogniFlow Starts with Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-semantic-core ;
    cd:authoredResource true .

  ex:def-cogniflow-semantic-core a cd:Definition ;
    cd:body "CogniFlow uses a small Meta-TBox vocabulary to describe concept domains and the semantic terms they define."@en ;
    cd:authoredResource true .

  ex:cogniflow-meta-domain a cd:Interpretation ;
    cd:body """CONCEPT DOMAIN
Vocabulary scope that defines the semantic terms of one domain."""@en ;
    cd:authoredResource true .

  ex:cogniflow-meta-grammar a cd:Interpretation ;
    cd:body "The Meta-TBox provides a compact grammar that domain concept packages reuse."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-meta-concept,
      ex:keypoint-cogniflow-meta-attribute,
      ex:keypoint-cogniflow-meta-relation,
      ex:keypoint-cogniflow-meta-controlled-value,
      ex:keypoint-cogniflow-meta-shape ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-meta-concept a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """CONCEPT
central domain abstraction"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-meta-attribute a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """ATTRIBUTE
structured part of a concept"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-meta-relation a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """RELATION
explicit structural link"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-meta-controlled-value a cd:KeyPoint ;
    cd:position 4 ;
    cd:body """CONTROLLED VALUE
named allowed value"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-meta-shape a cd:KeyPoint ;
    cd:position 5 ;
    cd:body """SHAPE
validation rule"""@en ;
    cd:authoredResource true .

  ex:cogniflow-meta-domain-note a cd:Interpretation ;
    cd:body "ONE META-GRAMMAR → SEPARATE PACKAGE · SERVICE · PROCESSING DOMAINS"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-core-extension> {
  ex:path-step-cogniflow-semantic-core a cd:PathStep ;
    cd:position 6 ;
    cd:usesResource ex:cogniflow-meta-domain,
      ex:cogniflow-meta-grammar,
      ex:cogniflow-meta-domain-note ;
    cd:usesScene ex:scene-cogniflow-semantic-core ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-core> {
  ex:scene-cogniflow-semantic-core a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantic-core ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantic-core-heading,
      ex:scene-item-cogniflow-semantic-core-domain,
      ex:scene-item-cogniflow-semantic-core-grammar,
      ex:scene-item-cogniflow-semantic-core-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantic-core ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-domain a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-meta-domain ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-grammar a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-meta-grammar ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-meta-domain-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
