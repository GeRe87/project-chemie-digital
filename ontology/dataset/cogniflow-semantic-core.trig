@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-core> {
  ex:cogniflow-semantic-core a cd:Concept ;
    skos:prefLabel "CogniFlow Starts with Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-semantic-core ;
    cd:authoredResource true .

  ex:def-cogniflow-semantic-core a cd:Definition ;
    cd:body "CogniFlow is organized as a small core ontology surrounded by modular concept domains and concrete specification or implementation modules."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-semantic-core a cd:NetworkDiagram ;
    skos:prefLabel "CogniFlow semantic layers"@en ;
    cd:body "A focused core ontology surrounded by reusable concept-domain packages and concrete specification or implementation packages."@en ;
    cd:focusNode ex:node-cogniflow-semantic-core ;
    cd:hasDiagramGroup ex:group-cogniflow-semantic-concepts,
      ex:group-cogniflow-semantic-specifications ;
    cd:hasDiagramNode ex:node-cogniflow-semantic-core,
      ex:node-cogniflow-concept-service,
      ex:node-cogniflow-concept-workspace,
      ex:node-cogniflow-concept-processing,
      ex:node-cogniflow-concept-package,
      ex:node-cogniflow-concept-installation-profile,
      ex:node-cogniflow-spec-package-template,
      ex:node-cogniflow-spec-example-package,
      ex:node-cogniflow-spec-service-client,
      ex:node-cogniflow-spec-mcp-gateway,
      ex:node-cogniflow-spec-service-creator,
      ex:node-cogniflow-spec-runtime,
      ex:node-cogniflow-spec-workspace-store,
      ex:node-cogniflow-spec-bootstrap-core,
      ex:node-cogniflow-spec-bootstrap-instance,
      ex:node-cogniflow-spec-bootstrap-orchestrator,
      ex:node-cogniflow-spec-local-source,
      ex:node-cogniflow-spec-pypi-source ;
    cd:authoredResource true .

  ex:group-cogniflow-semantic-concepts a cd:DiagramGroup ;
    skos:prefLabel "CONCEPT LAYER"@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:group-cogniflow-semantic-specifications a cd:DiagramGroup ;
    skos:prefLabel "SPECIFICATION LAYER"@en ;
    cd:position 2 ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-core a cd:DiagramNode ;
    skos:prefLabel "CORE · cf_ontology"@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:node-cogniflow-concept-service a cd:DiagramNode ;
    skos:prefLabel "SERVICE · cf_concept_service"@en ;
    cd:position 2 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-concepts ;
    cd:authoredResource true .

  ex:node-cogniflow-concept-workspace a cd:DiagramNode ;
    skos:prefLabel "WORKSPACE · cf_concept_workspace"@en ;
    cd:position 3 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-concepts ;
    cd:authoredResource true .

  ex:node-cogniflow-concept-processing a cd:DiagramNode ;
    skos:prefLabel "DATA PROCESSING · cf_concept_processing · ProcessingUnit · ProcessingStep · ProcessingPipeline · Port · PortRole"@en ;
    cd:position 4 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-concepts ;
    cd:authoredResource true .

  ex:node-cogniflow-concept-package a cd:DiagramNode ;
    skos:prefLabel "PACKAGE · cf_concept_package · CfPackage · Manifest · Version · Role · Contributions"@en ;
    cd:position 5 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-concepts ;
    cd:authoredResource true .

  ex:node-cogniflow-concept-installation-profile a cd:DiagramNode ;
    skos:prefLabel "INSTALLATION PROFILE · cf_concept_installation_profile"@en ;
    cd:position 6 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-concepts ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-package-template a cd:DiagramNode ;
    skos:prefLabel "PKG TEMPLATE · cf_package_template_basic"@en ;
    cd:position 7 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-example-package a cd:DiagramNode ;
    skos:prefLabel "EXAMPLE PKG · cf_package_example_arithmetic"@en ;
    cd:position 8 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-service-client a cd:DiagramNode ;
    skos:prefLabel "SERVICE CLIENT · cf_service_client"@en ;
    cd:position 9 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-mcp-gateway a cd:DiagramNode ;
    skos:prefLabel "MCP GATEWAY · cf_service_mcp_server"@en ;
    cd:position 10 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-service-creator a cd:DiagramNode ;
    skos:prefLabel "SERVICE CREATOR · cf_service_creator"@en ;
    cd:position 11 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-runtime a cd:DiagramNode ;
    skos:prefLabel "RUNTIME · cf_runtime"@en ;
    cd:position 12 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-workspace-store a cd:DiagramNode ;
    skos:prefLabel "WORKSPACE STORE · cf_workspace_store"@en ;
    cd:position 13 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-bootstrap-core a cd:DiagramNode ;
    skos:prefLabel "BOOTSTRAP CORE · cf_bootstrap_core"@en ;
    cd:position 14 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-bootstrap-instance a cd:DiagramNode ;
    skos:prefLabel "BOOTSTRAP INSTANCE · cf_bootstrap_instance"@en ;
    cd:position 15 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-bootstrap-orchestrator a cd:DiagramNode ;
    skos:prefLabel "BOOTSTRAP ORCH. · cf_bootstrap_orchestrator"@en ;
    cd:position 16 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-local-source a cd:DiagramNode ;
    skos:prefLabel "LOCAL SOURCE · cf_bootstrap_source_local"@en ;
    cd:position 17 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-spec-pypi-source a cd:DiagramNode ;
    skos:prefLabel "PYPI SOURCE · cf_bootstrap_source_pypi"@en ;
    cd:position 18 ;
    cd:memberOfDiagramGroup ex:group-cogniflow-semantic-specifications ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-core-extension> {
  ex:path-step-cogniflow-semantic-core a cd:PathStep ;
    cd:position 8 ;
    cd:usesResource ex:diagram-cogniflow-semantic-core ;
    cd:usesScene ex:scene-cogniflow-semantic-core ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-core> {
  ex:scene-cogniflow-semantic-core a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantic-core ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantic-core-heading,
      ex:scene-item-cogniflow-semantic-core-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantic-core ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-semantic-core ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
