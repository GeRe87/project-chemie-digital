@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-core> {
  ex:cogniflow-semantic-core a cd:Concept ;
    skos:prefLabel "CogniFlow Starts with Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-semantic-core ;
    cd:authoredResource true .

  ex:def-cogniflow-semantic-core a cd:Definition ;
    cd:body "The heart of CogniFlow is a small semantic grammar for describing what things are and how they relate."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-semantic-core a cd:FlowDiagram, cd:NetworkDiagram ;
    skos:prefLabel "Concept, meaning and semantic scope"@en ;
    cd:body "A concept is described by attributes, explicit relationships and controlled meaning inside a shared Concept Domain."@en ;
    cd:hasDiagramNode ex:node-cogniflow-semantic-concept,
      ex:node-cogniflow-semantic-attributes,
      ex:node-cogniflow-semantic-relationships,
      ex:node-cogniflow-semantic-controlled-meaning,
      ex:node-cogniflow-semantic-domain ;
    cd:hasDiagramEdge ex:edge-cogniflow-semantic-concept-attributes,
      ex:edge-cogniflow-semantic-concept-relationships,
      ex:edge-cogniflow-semantic-concept-controlled,
      ex:edge-cogniflow-semantic-concept-domain ;
    cd:hasDiagramGroup ex:diagram-group-cogniflow-semantic-components,
      ex:diagram-group-cogniflow-semantic-domain ;
    cd:focusNode ex:node-cogniflow-semantic-concept ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-semantic-components a cd:DiagramGroup ;
    skos:prefLabel "Semantic components"@en ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-semantic-domain a cd:DiagramGroup ;
    skos:prefLabel "Concept domain"@en ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-concept a cd:DiagramNode ;
    skos:prefLabel """CONCEPT
Processing Unit"""@en ;
    cd:position 1 ;
    cd:visualRole "concept-core" ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-attributes a cd:DiagramNode ;
    skos:prefLabel """ATTRIBUTES
label
definition
version"""@en ;
    cd:position 2 ;
    cd:visualRole "attributes" ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-semantic-components ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-relationships a cd:DiagramNode ;
    skos:prefLabel """RELATIONSHIPS
consumes
produces
implemented by"""@en ;
    cd:position 3 ;
    cd:visualRole "relationships" ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-semantic-components ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-controlled-meaning a cd:DiagramNode ;
    skos:prefLabel """CONTROLLED MEANING
agreed terms
allowed values
validation"""@en ;
    cd:position 4 ;
    cd:visualRole "controlled-meaning" ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-semantic-components ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-domain a cd:DiagramNode ;
    skos:prefLabel """CONCEPT DOMAIN
shared vocabulary
scope of meaning"""@en ;
    cd:position 5 ;
    cd:visualRole "concept-domain" ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-semantic-domain ;
    cd:authoredResource true .

  ex:edge-cogniflow-semantic-concept-attributes a cd:DiagramEdge ;
    skos:prefLabel "described by"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-semantic-concept ;
    cd:targetNode ex:node-cogniflow-semantic-attributes ;
    cd:authoredResource true .

  ex:edge-cogniflow-semantic-concept-relationships a cd:DiagramEdge ;
    skos:prefLabel "connected by"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-semantic-concept ;
    cd:targetNode ex:node-cogniflow-semantic-relationships ;
    cd:authoredResource true .

  ex:edge-cogniflow-semantic-concept-controlled a cd:DiagramEdge ;
    skos:prefLabel "constrained by"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-semantic-concept ;
    cd:targetNode ex:node-cogniflow-semantic-controlled-meaning ;
    cd:authoredResource true .

  ex:edge-cogniflow-semantic-concept-domain a cd:DiagramEdge ;
    skos:prefLabel "defined within"@en ;
    cd:position 4 ;
    cd:sourceNode ex:node-cogniflow-semantic-concept ;
    cd:targetNode ex:node-cogniflow-semantic-domain ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-core-extension> {
  ex:path-step-cogniflow-semantic-core a cd:PathStep ;
    cd:position 6 ;
    cd:usesResource ex:diagram-cogniflow-semantic-core ;
    cd:usesScene ex:scene-cogniflow-semantic-core ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-core> {
  ex:scene-cogniflow-semantic-core a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantic-core ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantic-core-heading,
      ex:scene-item-cogniflow-semantic-core-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantic-core ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-core-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-semantic-core ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
