  ex:l8-media-model-workflow a cd:MediaAsset ; cd:uri "/chemometrics/level8/model-workflow.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A four-step horizontal workflow: choose known terms, build rows and columns, minimise squared residuals, read fitted values. Stages 1, 2, 3 reveal one subsequent step each. Uncertainty is deliberately left for the next appointment."@en ; cd:authoredResource true .
  ex:l8-media-model-workflow cd:hasSource ex:l8-source-author .
  ex:l8-source-author cd:supportsResource ex:l8-media-model-workflow .
  ex:l8-r-code a cd:CodeExample ; cd:code "x <- 0:4\ny <- c(1.10, 2.80, 5.20, 6.90, 9.00)\nfit <- lm(y ~ x)\ncoef(fit)                 # 1.02, 1.99\nfitted(fit)               # 1.02 3.01 5.00 6.99 8.98\nresiduals(fit)            # .08 -.21 .20 -.09 .02\nsum(residuals(fit)^2)     # 0.099\nmodel.matrix(fit)         # columns: (Intercept), x" ; cd:programmingLanguage "r" ; cd:editable false ; cd:executable false ; cd:authoredResource true .
  ex:l8-r-code cd:hasSource ex:l8-source-author .
  ex:l8-source-author cd:supportsResource ex:l8-r-code .
