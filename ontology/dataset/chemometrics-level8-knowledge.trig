  ex:l8-gram-design-heading a cd:Interpretation ; cd:body "Five inputs, three design columns"@en ; skos:prefLabel "Five inputs, three design columns"@en ; cd:authoredResource true .
  ex:l8-gram-design-takeaway a cd:Interpretation ; cd:body "Choose the model terms first. Each term gives one design column."@en ; skos:prefLabel "Choose the model terms first. Each term gives one design column."@en ; cd:authoredResource true .
  ex:l8-gram-design-takeaway cd:interpretsResource ex:l8-gram-design-media .
  ex:l8-gram-rule-heading a cd:Interpretation ; cd:body "From one squared length to XᵀX"@en ; skos:prefLabel "From one squared length to XᵀX"@en ; cd:authoredResource true .
  ex:l8-gram-rule-takeaway a cd:Interpretation ; cd:body "The diagonal contains squared lengths. Off-diagonal entries compare two different columns."@en ; skos:prefLabel "The diagonal contains squared lengths. Off-diagonal entries compare two different columns."@en ; cd:authoredResource true .
  ex:l8-gram-rule-takeaway cd:interpretsResource ex:l8-gram-rule-formula .
  ex:l8-gram-worked-heading a cd:Interpretation ; cd:body "Calculate XᵀX for the five inputs"@en ; skos:prefLabel "Calculate XᵀX for the five inputs"@en ; cd:authoredResource true .
  ex:l8-gram-worked-takeaway a cd:Interpretation ; cd:body "The matrix is symmetric because the order of two real columns in a dot product does not change the value."@en ; skos:prefLabel "The matrix is symmetric because the order of two real columns in a dot product does not change the value."@en ; cd:authoredResource true .
  ex:l8-gram-worked-takeaway cd:interpretsResource ex:l8-gram-worked-formula .
