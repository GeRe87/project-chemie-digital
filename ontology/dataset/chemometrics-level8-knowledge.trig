  ex:l8-drift-prediction-heading a cd:Interpretation ; cd:body "Back to the detector: predict the signal at 2.5 min"@en ; skos:prefLabel "Back to the detector: predict the signal at 2.5 min"@en ; cd:authoredResource true .
  ex:l8-drift-prediction-takeaway a cd:Interpretation ; cd:body "Read the fitted line between the observations at 2 and 3 min. This is interpolation."@en ; skos:prefLabel "Read the fitted line between the observations at 2 and 3 min. This is interpolation."@en ; cd:authoredResource true .
