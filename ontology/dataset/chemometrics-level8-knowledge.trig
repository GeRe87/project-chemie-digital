  ex:l8-basis-linear-takeaway a cd:Interpretation ; cd:body "The constant and x columns produce a straight line."@en ; skos:prefLabel "The constant and x columns produce a straight line."@en ; cd:authoredResource true .
  ex:l8-basis-linear-takeaway cd:interpretsResource ex:l8-basis-linear-media .
  ex:l8-basis-linear-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-linear.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, x. The curve is y = 1 + x. The constant and x columns produce a straight line."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-square-heading a cd:Interpretation ; cd:body "Design matrix: intercept and squared term"@en ; skos:prefLabel "Design matrix: intercept and squared term"@en ; cd:authoredResource true .
  ex:l8-basis-square-takeaway a cd:Interpretation ; cd:body "Replacing x by x² curves the graph and keeps two coefficients."@en ; skos:prefLabel "Replacing x by x² curves the graph and keeps two coefficients."@en ; cd:authoredResource true .
  ex:l8-basis-square-takeaway cd:interpretsResource ex:l8-basis-square-media .
  ex:l8-basis-square-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-square.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, x². The curve is y = 1 + 0.5x². Replacing x by x² curves the graph and keeps two coefficients."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-quadratic-heading a cd:Interpretation ; cd:body "Design matrix: intercept, x and x²"@en ; skos:prefLabel "Design matrix: intercept, x and x²"@en ; cd:authoredResource true .
  ex:l8-basis-quadratic-takeaway a cd:Interpretation ; cd:body "Each added power gives one more column and one more coefficient."@en ; skos:prefLabel "Each added power gives one more column and one more coefficient."@en ; cd:authoredResource true .
  ex:l8-basis-quadratic-takeaway cd:interpretsResource ex:l8-basis-quadratic-media .
  ex:l8-basis-quadratic-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-quadratic.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, x, x². The curve is y = 1 + x + 0.5x². Each added power gives one more column and one more coefficient."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-hyperbolic-heading a cd:Interpretation ; cd:body "Design matrix: combine sinh and cosh"@en ; skos:prefLabel "Design matrix: combine sinh and cosh"@en ; cd:authoredResource true .
  ex:l8-basis-hyperbolic-takeaway a cd:Interpretation ; cd:body "sinh is odd and cosh is even. Their weighted sum can be asymmetric."@en ; skos:prefLabel "sinh is odd and cosh is even. Their weighted sum can be asymmetric."@en ; cd:authoredResource true .
  ex:l8-basis-hyperbolic-takeaway cd:interpretsResource ex:l8-basis-hyperbolic-media .
  ex:l8-basis-hyperbolic-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-hyperbolic.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, sinh(x), cosh(x). The curve is y = 1 + sinh(x) + 0.5 cosh(x). sinh is odd and cosh is even. Their weighted sum can be asymmetric."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-exp-heading a cd:Interpretation ; cd:body "Design matrix: exponential column"@en ; skos:prefLabel "Design matrix: exponential column"@en ; cd:authoredResource true .
  ex:l8-basis-exp-takeaway a cd:Interpretation ; cd:body "The exponential column grows increasingly fast across this interval."@en ; skos:prefLabel "The exponential column grows increasingly fast across this interval."@en ; cd:authoredResource true .
  ex:l8-basis-exp-takeaway cd:interpretsResource ex:l8-basis-exp-media .
  ex:l8-basis-exp-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-exp.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, exp(x). The curve is y = 1 + 0.05 exp(x). The exponential column grows increasingly fast across this interval."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-log-heading a cd:Interpretation ; cd:body "Design matrix: logarithmic column"@en ; skos:prefLabel "Design matrix: logarithmic column"@en ; cd:authoredResource true .
  ex:l8-basis-log-takeaway a cd:Interpretation ; cd:body "A log input column gives a curve that rises and gradually flattens."@en ; skos:prefLabel "A log input column gives a curve that rises and gradually flattens."@en ; cd:authoredResource true .
  ex:l8-basis-log-takeaway cd:interpretsResource ex:l8-basis-log-media .
  ex:l8-basis-log-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-log.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, ln(x). The curve is y = 1 + ln(x). A log input column gives a curve that rises and gradually flattens."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-reciprocal-heading a cd:Interpretation ; cd:body "Design matrix: reciprocal column"@en ; skos:prefLabel "Design matrix: reciprocal column"@en ; cd:authoredResource true .
  ex:l8-basis-reciprocal-takeaway a cd:Interpretation ; cd:body "The positive reciprocal branch approaches the intercept as x increases."@en ; skos:prefLabel "The positive reciprocal branch approaches the intercept as x increases."@en ; cd:authoredResource true .
  ex:l8-basis-reciprocal-takeaway cd:interpretsResource ex:l8-basis-reciprocal-media .
  ex:l8-basis-reciprocal-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-reciprocal.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, 1/x. The curve is y = 1 + 2/x. The positive reciprocal branch approaches the intercept as x increases."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-sqrt-heading a cd:Interpretation ; cd:body "Design matrix: square-root column"@en ; skos:prefLabel "Design matrix: square-root column"@en ; cd:authoredResource true .
  ex:l8-basis-sqrt-takeaway a cd:Interpretation ; cd:body "Different columns change the curve. The coefficients still enter linearly."@en ; skos:prefLabel "Different columns change the curve. The coefficients still enter linearly."@en ; cd:authoredResource true .
  ex:l8-basis-sqrt-takeaway cd:interpretsResource ex:l8-basis-sqrt-media .
  ex:l8-basis-sqrt-media a cd:MediaAsset ; cd:uri "/chemometrics/level8/basis-sqrt.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Five input rows. The design columns are 1, √x. The curve is y = 1 + √x. Different columns change the curve. The coefficients still enter linearly."@en ; cd:hasSource ex:l8-source-author ; cd:authoredResource true .
  ex:l8-basis-gram-columns-heading a cd:Interpretation ; cd:body "What is inside XᵀX?"@en ; skos:prefLabel "What is inside XᵀX?"@en ; cd:authoredResource true .
  ex:l8-basis-gram-columns-takeaway a cd:Interpretation ; cd:body "Each entry is a dot product of two design columns. Adding a column adds a row and a column to XᵀX."@en ; skos:prefLabel "Each entry is a dot product of two design columns. Adding a column adds a row and a column to XᵀX."@en ; cd:authoredResource true .
  ex:l8-basis-gram-columns-takeaway cd:interpretsResource ex:l8-basis-gram-columns-formula .
  ex:l8-fixed-basis-coefficients-heading a cd:Interpretation ; cd:body "When is a model linear in its coefficients?"@en ; skos:prefLabel "When is a model linear in its coefficients?"@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-takeaway a cd:Interpretation ; cd:body "A design column must be known before fitting."@en ; skos:prefLabel "A design column must be known before fitting."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-takeaway cd:interpretsResource ex:l8-fixed-basis-coefficients-formula .
  ex:l8-basis-mixed-heading a cd:Interpretation ; cd:body "Design matrix: mix several functions"@en ; skos:prefLabel "Design matrix: mix several functions"@en ; cd:authoredResource true .
  ex:l8-basis-mixed-takeaway a cd:Interpretation ; cd:body "Each fixed function adds one column. The fitted coefficients still enter linearly."@en ; skos:prefLabel "Each fixed function adds one column. The fitted coefficients still enter linearly."@en ; cd:authoredResource true .
  ex:l8-basis-mixed-takeaway cd:interpretsResource ex:l8-basis-mixed-media .
  ex:l8-basis-column-limit-heading a cd:Interpretation ; cd:body "How many columns can we fit?"@en ; skos:prefLabel "How many columns can we fit?"@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-takeaway a cd:Interpretation ; cd:body "To keep at least one residual degree of freedom, use at most n − 1 independent columns."@en ; skos:prefLabel "To keep at least one residual degree of freedom, use at most n − 1 independent columns."@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-takeaway cd:interpretsResource ex:l8-basis-column-limit-formula .
