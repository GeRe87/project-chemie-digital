  ex:l8-media-row-dot-column cd:hasSource ex:l8-source-author .
  ex:l8-source-author cd:supportsResource ex:l8-media-row-dot-column .
  ex:l8-media-matrix-order a cd:MediaAsset ; cd:uri "/chemometrics/level8/matrix-order.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "The product AB is [[19,22],[43,50]]. Stage 1 adds BA = [[23,34],[31,46]]. Stage 2 adds entrywise product [[5,12],[21,32]], which is different again."@en ; cd:authoredResource true .
  ex:l8-media-matrix-order cd:hasSource ex:l8-source-author .
  ex:l8-source-author cd:supportsResource ex:l8-media-matrix-order .
