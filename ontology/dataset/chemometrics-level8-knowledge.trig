  ex:l8-five-point-matrix-heading a cd:Interpretation ; cd:body "Matrix Equations: evaluate a line at five points"@en ; skos:prefLabel "Matrix Equations: evaluate a line at five points"@en ; cd:authoredResource true .
  ex:l8-transpose-rules-heading a cd:Interpretation ; cd:body "Matrix Transpose: three useful rules"@en ; skos:prefLabel "Matrix Transpose: three useful rules"@en ; cd:authoredResource true .
  ex:l8-transpose-rules-takeaway a cd:Interpretation ; cd:body "Transpose a difference term by term. Reverse factor order in a product. Two transposes restore the original matrix."@en ; skos:prefLabel "Transpose a difference term by term. Reverse factor order in a product. Two transposes restore the original matrix."@en ; cd:authoredResource true .
  ex:l8-column-squares-heading a cd:Interpretation ; cd:body "Matrix Multiplication: sum the squares of a column"@en ; skos:prefLabel "Matrix Multiplication: sum the squares of a column"@en ; cd:authoredResource true .
  ex:l8-column-squares-takeaway a cd:Interpretation ; cd:body "A transposed column times itself gives a single sum of squares."@en ; skos:prefLabel "A transposed column times itself gives a single sum of squares."@en ; cd:authoredResource true .
  ex:l8-expand-squared-error-heading a cd:Interpretation ; cd:body "Least Squares: expand the squared error"@en ; skos:prefLabel "Least Squares: expand the squared error"@en ; cd:authoredResource true .
  ex:l8-expand-squared-error-takeaway a cd:Interpretation ; cd:body "The two mixed products are equal scalars, so they combine into one term."@en ; skos:prefLabel "The two mixed products are equal scalars, so they combine into one term."@en ; cd:authoredResource true .
  ex:l8-expand-squared-error-takeaway cd:interpretsResource ex:l8-expand-squared-error-formula .
  ex:l8-quadratic-gradient-heading a cd:Interpretation ; cd:body "Least Squares: where does the factor 2 come from?"@en ; skos:prefLabel "Least Squares: where does the factor 2 come from?"@en ; cd:authoredResource true .
  ex:l8-isolate-coefficients-heading a cd:Interpretation ; cd:body "Least Squares: isolate the coefficients"@en ; skos:prefLabel "Least Squares: isolate the coefficients"@en ; cd:authoredResource true .
  ex:l8-least-squares-solution-heading a cd:Interpretation ; cd:body "Ordinary Least Squares: the coefficient formula"@en ; skos:prefLabel "Ordinary Least Squares: the coefficient formula"@en ; cd:authoredResource true .
  ex:l8-least-squares-solution-takeaway a cd:Interpretation ; cd:body "Fit the coefficients, then evaluate the line at 2.5 minutes."@en ; skos:prefLabel "Fit the coefficients, then evaluate the line at 2.5 minutes."@en ; cd:authoredResource true .
  ex:l8-least-squares-solution-takeaway cd:interpretsResource ex:l8-least-squares-solution-formula .
