  ex:l8-source-nist-linear a cd:Source ; dct:title "NIST/SEMATECH e-Handbook 4.1.4.1: Linear Least Squares Regression"@en ; dct:creator "NIST/SEMATECH" ; dct:identifier "l8-source-nist-linear" ; dct:source <https://www.itl.nist.gov/div898/handbook/pmd/section1/pmd141.htm> ; cd:authoredResource true .
  ex:l8-source-nist-ls a cd:Source ; dct:title "NIST/SEMATECH e-Handbook 4.4.3.1: Least Squares"@en ; dct:creator "NIST/SEMATECH" ; dct:identifier "l8-source-nist-ls" ; dct:source <https://www.itl.nist.gov/div898/handbook/pmd/section4/pmd431.htm> ; cd:authoredResource true .
  ex:l8-source-mit a cd:Source ; dct:title "MIT OCW 18.06: Lecture 1, The geometry of linear equations"@en ; dct:creator "Gilbert Strang / MIT OpenCourseWare" ; dct:identifier "l8-source-mit" ; dct:source <https://ocw.mit.edu/courses/18-06-linear-algebra-spring-2010/resources/lecture-1-the-geometry-of-linear-equations/> ; cd:authoredResource true .
  ex:l8-source-author a cd:Source ; dct:title "Owner-specified synthetic teaching examples, Level 8 TERMIN 1"@en ; dct:creator "Local course author" ; dct:identifier "level8-owner-task-2026-11-19" ; cd:body "Synthetic worked data supplied in the local authoring task; no personal or measured laboratory data. Numerical checks are recorded in the local handoff."@en ; cd:authoredResource true .
  ex:l8-linear-regression a cd:Concept ; skos:prefLabel "Linear regression foundations"@en ; cd:body "A fixed design matrix combines known model terms with coefficients to describe observations by least squares."@en ; cd:authoredResource true .
  ex:l8-definition-matrix a cd:Definition ; skos:prefLabel "Matrix"@en ; cd:body "A rectangular arrangement of entries with an ordered row index and an ordered column index. Its shape is the number of rows by the number of columns."@en ; cd:authoredResource true .
  ex:l8-definition-design a cd:Definition ; skos:prefLabel "Design matrix"@en ; cd:body "A matrix with one row per observation and one column per known model term. The ordering of coefficient entries must match the ordering of its columns."@en ; cd:authoredResource true .
  ex:l8-definition-residual a cd:Definition ; skos:prefLabel "Residual"@en ; cd:body "Observed response minus fitted response for the same observation. A positive residual means the observation lies above its fitted value."@en ; cd:authoredResource true .
  ex:l8-definition-linear a cd:Definition ; skos:prefLabel "Linear in the coefficients"@en ; cd:body "The unknown coefficients enter only as a weighted sum of known model terms. Curvature in a predictor does not by itself make the coefficient problem nonlinear."@en ; cd:authoredResource true .
  ex:l8-linear-regression cd:hasDefinition ex:l8-definition-linear .
  ex:l8-definition-linear cd:hasSource ex:l8-source-nist-linear .
  ex:l8-source-nist-linear cd:supportsResource ex:l8-definition-linear .
