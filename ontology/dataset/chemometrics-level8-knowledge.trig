  ex:l8-basis-eight-rows-heading a cd:Interpretation ; cd:body "Design matrix: eight rows for seven coefficients"@en ; skos:prefLabel "Design matrix: eight rows for seven coefficients"@en ; cd:authoredResource true .
  ex:l8-basis-eight-rows-takeaway a cd:Interpretation ; cd:body "With rank seven, eight observed responses determine a unique least-squares fit."@en ; skos:prefLabel "With rank seven, eight observed responses determine a unique least-squares fit."@en ; cd:authoredResource true .
  ex:l8-basis-eight-rows-takeaway cd:interpretsResource ex:l8-basis-eight-rows-media .
