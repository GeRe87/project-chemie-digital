  ex:l8-xty-worked-takeaway a cd:Interpretation ; cd:body "The right-hand side has one dot product per design column."@en ; skos:prefLabel "The right-hand side has one dot product per design column."@en ; cd:authoredResource true .
  ex:l8-xty-worked-takeaway cd:interpretsResource ex:l8-xty-worked-formula .
