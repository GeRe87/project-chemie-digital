  ex:l8-media-inverse-check cd:hasSource ex:l8-source-author .
  ex:l8-source-author cd:supportsResource ex:l8-media-inverse-check .
  ex:l8-media-dependent-columns a cd:MediaAsset ; cd:uri "/chemometrics/level8/dependent-columns.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two parallel column arrows point in the same direction; the second is twice the first. Stage 1 adds two different coefficient choices with the same combined column, so the coefficients cannot be identified uniquely."@en ; cd:authoredResource true .
