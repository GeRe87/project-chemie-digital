@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/paths/chemometrics-random-variables-lecture> {
  # Stable legacy path identity; the authored Level 1 topic is now the broader Variables foundation.
  ex:path-chemometrics-random-variables-lecture a cd:LearningPath ;
    skos:prefLabel "Chemometrics Variables lecture path"@en ;
    cd:forTopic ex:variables-foundation, ex:variable,
      ex:variables-values-observations, ex:lake-sampling-replicates,
      ex:variability-randomness-uncertainty,
      ex:uvvis-variation-sources, ex:uvvis-additive-response-model,
      ex:general-additive-response-model, ex:model-function-families,
      ex:controlled-calibration-model, ex:concentration-context-roles,
      ex:variable-classification, ex:empirical-probability-distribution-distinction,
      ex:random-variable, ex:distribution ;
    cd:forLearningUnit ex:learning-unit-random-variables ;
    cd:hasStep ex:path-step-chemometrics-variables-title,
      ex:path-step-chemometrics-variable-definition,
      ex:path-step-chemometrics-variables-values-observations,
      ex:path-step-chemometrics-lake-sampling-replicates,
      ex:path-step-chemometrics-why-values-differ,
      ex:path-step-chemometrics-variation-sources,
      ex:path-step-chemometrics-additive-response-model,
      ex:path-step-chemometrics-general-additive-model,
      ex:path-step-chemometrics-model-function-families,
      ex:path-step-chemometrics-controlled-calibration,
      ex:path-step-chemometrics-context-roles,
      ex:path-step-chemometrics-variable-classification,
      ex:path-step-chemometrics-empirical-probability,
      ex:path-step-chemometrics-variables-checkpoint ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variables-title a cd:PathStep ;
    cd:position 1 ;
    cd:usesResource ex:variables-foundation ;
    cd:usesScene ex:scene-chemometrics-variables-title ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variable-definition a cd:PathStep ;
    cd:position 2 ;
    cd:usesResource ex:def-variable, ex:source-openstax-statistics ;
    cd:usesScene ex:scene-chemometrics-variable-definition ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variables-values-observations a cd:PathStep ;
    cd:position 3 ;
    cd:usesResource ex:media-uvvis-dilution-series,
      ex:variables-values-observations-intro,
      ex:table-uvvis-calibration-roles,
      ex:chart-uvvis-calibration-response ;
    cd:usesScene ex:scene-chemometrics-variables-values-observations ;
    cd:authoredResource true .

  ex:path-step-chemometrics-lake-sampling-replicates a cd:PathStep ;
    cd:position 4 ;
    cd:usesResource ex:media-lake-sampling-sites,
      ex:lake-sampling-replicates-intro,
      ex:table-lake-analyte-a-replicates,
      ex:chart-lake-analyte-a-replicates ;
    cd:usesScene ex:scene-chemometrics-lake-sampling-replicates ;
    cd:authoredResource true .

  ex:path-step-chemometrics-why-values-differ a cd:PathStep ;
    cd:position 5 ;
    cd:usesResource ex:variation-origins-cards,
      ex:why-values-differ-takeaway ;
    cd:usesScene ex:scene-chemometrics-why-values-differ ;
    cd:authoredResource true .


  ex:path-step-chemometrics-variation-sources a cd:PathStep ;
    cd:position 6 ;
    cd:usesResource ex:diagram-uvvis-variation-sources ;
    cd:usesScene ex:scene-chemometrics-variation-sources ;
    cd:authoredResource true .

  ex:path-step-chemometrics-additive-response-model a cd:PathStep ;
    cd:position 7 ;
    cd:usesResource ex:uvvis-additive-response-equation,
      ex:uvvis-additive-response-legend ;
    cd:usesScene ex:scene-chemometrics-additive-response-model ;
    cd:authoredResource true .


  ex:path-step-chemometrics-general-additive-model a cd:PathStep ;
    cd:position 8 ;
    cd:usesResource ex:general-additive-response-equation,
      ex:general-additive-response-legend ;
    cd:usesScene ex:scene-chemometrics-general-additive-model ;
    cd:authoredResource true .


  ex:path-step-chemometrics-model-function-families a cd:PathStep ;
    cd:position 9 ;
    cd:usesResource ex:diagram-model-function-families,
      ex:model-function-families-takeaway ;
    cd:usesScene ex:scene-chemometrics-model-function-families ;
    cd:authoredResource true .

  ex:path-step-chemometrics-controlled-calibration a cd:PathStep ;
    cd:position 10 ;
    cd:usesResource ex:controlled-calibration-intro,
      ex:controlled-calibration-formula,
      ex:chart-uvvis-calibration-response,
      ex:controlled-calibration-assumption ;
    cd:usesScene ex:scene-chemometrics-controlled-calibration ;
    cd:authoredResource true .

  ex:path-step-chemometrics-context-roles a cd:PathStep ;
    cd:position 11 ;
    cd:usesResource ex:concentration-context-intro,
      ex:concentration-context-cards,
      ex:concentration-context-takeaway ;
    cd:usesScene ex:scene-chemometrics-context-roles ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variable-classification a cd:PathStep ;
    cd:position 12 ;
    cd:usesResource ex:variable-classification-intro,
      ex:variable-classification-cards,
      ex:variable-classification-takeaway ;
    cd:usesScene ex:scene-chemometrics-variable-classification ;
    cd:authoredResource true .

  ex:path-step-chemometrics-empirical-probability a cd:PathStep ;
    cd:position 13 ;
    cd:usesResource ex:empirical-probability-intro,
      ex:distribution-comparison-cards,
      ex:chart-assigned-concentration-frequency,
      ex:assigned-frequency-takeaway ;
    cd:usesScene ex:scene-chemometrics-empirical-probability ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variables-checkpoint a cd:PathStep ;
    cd:position 14 ;
    cd:usesResource ex:poll-variable-randomness-check,
      ex:poll-variability-check,
      ex:poll-distribution-check,
      ex:expected-variable-randomness-check,
      ex:expected-variability-check,
      ex:expected-distribution-check ;
    cd:usesScene ex:scene-chemometrics-variables-checkpoint ;
    cd:authoredResource true .
}
