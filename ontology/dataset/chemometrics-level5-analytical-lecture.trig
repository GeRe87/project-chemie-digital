@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-analytical-lecture> {
  ex:l5-analytical-distributions a cd:Concept ; skos:prefLabel "Distributions in analytical measurement"@en ; cd:hasDefinition ex:al-definition ; cd:authoredResource true .
  ex:al-definition a cd:Definition ; cd:body "Probability distributions describe modeled variation of analytical quantities or sampling statistics. Their use requires a specified random quantity, parameters, assumptions and scope; a measured shape alone does not establish a model."@en ; cd:authoredResource true .
  ex:l5-monte-carlo a cd:Concept ; skos:prefLabel "Monte Carlo propagation of measurement uncertainty"@en ; cd:hasDefinition ex:mc-definition ; cd:authoredResource true .
  ex:mc-definition a cd:Definition ; cd:body "Repeated draws from a joint input uncertainty model are evaluated through a measurement equation to approximate its output distribution. The resulting coverage interval is conditional on that model, not automatically a frequentist confidence interval. Numerical Monte Carlo error is distinct from physical measurement uncertainty."@en ; cd:authoredResource true .
  ex:l5-topic-mc a skos:Concept ; skos:prefLabel "Application · Monte Carlo"@en ; cd:authoredResource true .
  ex:l5-topic-map a skos:Concept ; skos:prefLabel "Connections · Distribution families"@en ; cd:authoredResource true .
  ex:unit-level5-probability-models cd:hasFocusConcept ex:l5-analytical-distributions, ex:l5-monte-carlo .

  ex:al-overview a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-o1, ex:al-o2, ex:al-o3 ; cd:authoredResource true .
  ex:al-o1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Describe variation"@en ; cd:body "- PDF, CDF and inverse CDF.\n\n- Connect values, probabilities and thresholds."@en ; cd:authoredResource true .
  ex:al-o2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Analytical questions"@en ; cd:body "- Describe results and concentration variation.\n\n- Quantify uncertainty in means and variances."@en ; cd:authoredResource true .
  ex:al-o3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Check and simulate"@en ; cd:body "- Check models and connect the families.\n\n- Simulate a dilution measurement live."@en ; cd:authoredResource true .

  ex:al-functions-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-pdf-cdf.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Three views of a dimensionless uniform model from zero to one. PDF: horizontal axis value x, vertical axis density f(x), shaded rectangle probability. CDF: horizontal axis value x, vertical axis cumulative probability F(x). Inverse CDF: horizontal axis input probability u, vertical axis output quantile value Q(u). Axes express different quantities even where numerical coordinates match."@en ; cd:authoredResource true .
  ex:al-process-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-dilution-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Three analytical steps: pipette ten millilitres from a homogeneous collected sample, dilute to one hundred millilitres in a volumetric flask, then measure absorbance in a cuvette. The aim is concentration in the collected sample, not a water-body average. The three uncertain inputs are pipetted volume, final volume and absorbance."@en ; cd:authoredResource true .
  ex:al-map-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-distribution-map.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Distribution relationship map. Lognormal becomes normal after taking a log ratio to a reference. Independent standard-normal squares sum to chi-square. An independent standard normal divided by the square root of chi-square over its degrees of freedom gives t. The ratio of two independent chi-squares each divided by its own degrees of freedom gives F. This is a construction map, not an automatic choice of a model for data."@en ; cd:authoredResource true .

  ex:al-pdf a cd:MathExpression ; cd:formulaLabel "Density: an area is a probability"@en ; cd:latex "\\begin{gathered}P(a<X\\le b)=\\int_a^b f_X(x)\\,dx\\\\\\int_{-\\infty}^{\\infty}f_X(x)\\,dx=1\\end{gathered}" ; dct:hasPart ex:al-pdf-legend ; cd:hasSymbol ex:al-pdf-x, ex:al-pdf-bounds, ex:al-pdf-ops ; cd:authoredResource true .
  ex:al-pdf-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-pdf-entry ; cd:authoredResource true .
  ex:al-pdf-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Density and probability symbols"@en ; dct:references ex:al-pdf-x, ex:al-pdf-bounds, ex:al-pdf-ops ; cd:authoredResource true .
  ex:al-pdf-x a cd:MathSymbol ; cd:symbol "quantity and density" ; cd:mathNotation "X,\\ x,\\ f_X(x)" ; cd:body "X is a continuous quantity; x is a possible value on the horizontal axis. Subscript X identifies its density f on the vertical axis, per value unit. This Uniform(0,1) example is dimensionless. Density height is not point probability."@en ; cd:authoredResource true .
  ex:al-pdf-bounds a cd:MathSymbol ; cd:symbol "bounds and differential" ; cd:mathNotation "a,\\ b,\\ dx,\\ \\infty" ; cd:body "a and b are lower and upper value bounds, a less than b. dx integrates over value units; density times width gives dimensionless probability. Minus/plus infinity include the full real line; density is zero outside the uniform support from zero to one."@en ; cd:authoredResource true .
  ex:al-pdf-ops a cd:MathSymbol ; cd:symbol "probability and integration" ; cd:mathNotation "P,\\ <,\\ \\le,\\ \\int,\\ =" ; cd:body "P is dimensionless probability. Inequalities select an interval; an integral accumulates density area. Equality states equal quantities. Total area is one; any individual exact value has probability zero in a continuous model."@en ; cd:authoredResource true .
  ex:al-area-work a cd:MathExpression ; cd:formulaLabel "Uniform probability: rectangle width times density"@en ; cd:latex "\\begin{gathered}P(0.25<X\\le0.75)\\\\=(0.75-0.25)\\cdot1=0.50\\end{gathered}" ; dct:hasPart ex:al-area-legend ; cd:hasSymbol ex:al-area-symbol ; cd:authoredResource true .
  ex:al-area-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-area-entry ; cd:authoredResource true .
  ex:al-area-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Rectangle calculation"@en ; dct:references ex:al-area-symbol ; cd:authoredResource true .
  ex:al-area-symbol a cd:MathSymbol ; cd:symbol "interval and rectangle area" ; cd:mathNotation "P,\\ X,\\ <,\\ \\le,\\ =,\\ -,\\ \\cdot" ; cd:body "P is dimensionless probability for continuous Uniform(0,1) quantity X. Inequalities choose value bounds 0.25 and 0.75; their difference is rectangle width 0.50. Multiply by density height 1 per value unit to get probability 0.50, or 50 percent. Minus subtracts, dot multiplies, parentheses group and equals states equal probabilities. An exact point still has probability zero."@en ; cd:authoredResource true .

  ex:al-cdf a cd:MathExpression ; cd:formulaLabel "One interval, PDF area or CDF difference"@en ; cd:latex "\\begin{gathered}F_X(x)=P(X\\le x)=\\int_{-\\infty}^{x}f_X(t)\\,dt\\\\P(a<X\\le b)=F_X(b)-F_X(a)\\\\0.75-0.25=0.50\\end{gathered}" ; dct:hasPart ex:al-cdf-legend ; cd:hasSymbol ex:al-cdf-vars, ex:al-cdf-ops, ex:al-cdf-example ; cd:authoredResource true .
  ex:al-cdf-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-cdf-entry ; cd:authoredResource true .
  ex:al-cdf-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "CDF, area and example"@en ; dct:references ex:al-cdf-vars, ex:al-cdf-ops, ex:al-cdf-example ; cd:authoredResource true .
  ex:al-cdf-vars a cd:MathSymbol ; cd:symbol "cumulative distribution" ; cd:mathNotation "X,\\ x,\\ F_X,\\ f_X,\\ t,\\ dt" ; cd:body "X is a continuous quantity; x is the horizontal value threshold. Vertical F subscript X is dimensionless cumulative probability, not density. f is density per value unit; t is a dummy value variable, and dt integrates over it. Here X is dimensionless."@en ; cd:authoredResource true .
  ex:al-cdf-ops a cd:MathSymbol ; cd:symbol "bounds and operators" ; cd:mathNotation "a,\\ b,\\ P,\\ \\int,\\ -\\infty,\\ <,\\ \\le,\\ =,\\ -" ; cd:body "a and b are value bounds. P is probability; the integral accumulates density from minus infinity. Inequalities select the interval; equals states identities; minus subtracts CDF heights. For discrete models, subtracting F(a) excludes mass at a; an inclusive lower bound needs a left limit."@en ; cd:authoredResource true .
  ex:al-cdf-example a cd:MathSymbol ; cd:symbol "uniform-model probabilities" ; cd:mathNotation "0.75,\\ 0.25,\\ 0.50" ; cd:body "Uniform(0,1): F(0.75)=0.75 and F(0.25)=0.25. Subtract vertical probabilities to obtain 0.50, or 50 percent. This equals the PDF rectangle area, not area under the CDF."@en ; cd:authoredResource true .

  ex:al-inverse a cd:MathExpression ; cd:formulaLabel "Inverse CDF: start with a probability"@en ; cd:latex "\\begin{gathered}Q_X(u)=F_X^{-1}(u)=\\inf\\{x:F_X(x)\\ge u\\}\\\\Q_X(0.75)=0.75\\quad\\text{for Uniform}(0,1)\\end{gathered}" ; dct:hasPart ex:al-inverse-legend ; cd:hasSymbol ex:al-inverse-vars, ex:al-inverse-ops, ex:al-inverse-example ; cd:authoredResource true .
  ex:al-inverse-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-inverse-entry ; cd:authoredResource true .
  ex:al-inverse-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Quantile function and example"@en ; dct:references ex:al-inverse-vars, ex:al-inverse-ops, ex:al-inverse-example ; cd:authoredResource true .
  ex:al-inverse-vars a cd:MathSymbol ; cd:symbol "function and probability" ; cd:mathNotation "Q_X,\\ F_X^{-1},\\ u,\\ x,\\ X" ; cd:body "Q subscript X and F inverse denote X's quantile function, not reciprocal 1/F. Horizontal u is probability strictly between zero and one; vertical x is a value in X's units. Here X is dimensionless; axis roles still differ."@en ; cd:authoredResource true .
  ex:al-inverse-ops a cd:MathSymbol ; cd:symbol "generalized inverse" ; cd:mathNotation "\\inf,\\ \\{\\},\\ :,\\ \\ge,\\ =" ; cd:body "Infimum: smallest limiting threshold where the CDF reaches u. Braces and colon specify that set; greater than or equal handles jumps; equals identifies the function. The ordinary inverse applies where the CDF is continuous and strictly increasing."@en ; cd:authoredResource true .
  ex:al-inverse-example a cd:MathSymbol ; cd:symbol "numerical quantile" ; cd:mathNotation "0.75,\\ \\operatorname{Uniform}(0,1)" ; cd:body "Uniform from zero to one: probability 0.75 returns value 0.75. This numerical identity is not general. Plot endpoints show one-sided limits."@en ; cd:authoredResource true .

  ex:al-normal-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-n1, ex:al-n2, ex:al-n3 ; cd:authoredResource true .
  ex:al-n1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Analytical question"@en ; cd:body "- Repeat measurements of one nitrate sample.\n\n- Explain variation despite unchanged material."@en ; cd:authoredResource true .
  ex:al-n2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Model rationale"@en ; cd:body "- Many small additive error contributions.\n\n- A normal candidate, not proof from five points."@en ; cd:authoredResource true .
  ex:al-n3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Scope"@en ; cd:body "- Check stability, drift and dependence.\n\n- Repeatability does not establish accuracy."@en ; cd:authoredResource true .
  ex:al-normal-work a cd:MathExpression ; cd:formulaLabel "Use the density formula at the model centre"@en ; cd:latex "f_X(10)=\\frac{1}{0.30\\sqrt{2\\pi}}e^0\\approx1.3298\\;\\mathrm{L/mg}" ; dct:hasPart ex:al-normal-work-legend ; cd:hasSymbol ex:al-normal-work-symbol ; cd:authoredResource true .
  ex:al-normal-work-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-normal-work-entry ; cd:authoredResource true .
  ex:al-normal-work-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Density substitution"@en ; dct:references ex:al-normal-work-symbol ; cd:authoredResource true .
  ex:al-normal-work-symbol a cd:MathSymbol ; cd:symbol "normal density evaluation" ; cd:mathNotation "f_X(10),\\ 0.30,\\ \\sqrt{2\\pi},\\ e^0,\\ \\approx,\\ \\mathrm{L/mg}" ; cd:body "f subscript X at 10 evaluates concentration density at the mean 10 mg/L. SD is 0.30 mg/L. The square root is positive, pi is the circle constant, e is the natural exponential base and exponent zero arises because value equals mean. A fraction divides and juxtaposition multiplies. Equals is exact; approximately rounds the density to 1.3298 L/mg. This height is not a probability; it can exceed one."@en ; cd:authoredResource true .

  ex:al-log-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-l1, ex:al-l2, ex:al-l3 ; cd:authoredResource true .
  ex:al-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Analytical question"@en ; cd:body "- Preparation and dilution change concentrations by factors.\n\n- Describe the resulting positive variation."@en ; cd:authoredResource true .
  ex:al-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Model rationale"@en ; cd:body "- Logarithms turn products into sums.\n\n- Normal log ratios imply lognormal concentrations."@en ; cd:authoredResource true .
  ex:al-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Check applicability"@en ; cd:body "- Positivity alone is insufficient.\n\n- Check censoring and blanks; do not log zero."@en ; cd:authoredResource true .
  ex:al-log-work a cd:MathExpression ; cd:formulaLabel "Back-transform the target, not just the scale"@en ; cd:latex "\\begin{gathered}\\operatorname{Median}(X)=c_0e^m\\approx2.00\\;\\mathrm{mg/L}\\\\E[X]=c_0e^{m+s^2/2}\\approx2.65\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:l5-l12c-legend ; cd:hasSymbol ex:l5-lc-concentration, ex:l5-lc-parameters, ex:l5-lc-summaries, ex:l5-lc-operators ; cd:authoredResource true .

  ex:al-chi-work a cd:MathExpression ; cd:formulaLabel "95% interval for analytical variance"@en ; cd:latex "\\begin{gathered}\\left[\\frac{(n-1)s^2}{q_{0.975}},\\frac{(n-1)s^2}{q_{0.025}}\\right]\\\\\\approx\\left[\\frac{4(0.10)}{11.1433},\\frac{4(0.10)}{0.484419}\\right]\\\\\\approx[0.03590,\\ 0.82573]\\;(\\mathrm{mg/L})^2\\end{gathered}" ; dct:hasPart ex:al-chi-legend ; cd:hasSymbol ex:al-chi-data, ex:al-chi-quantiles, ex:al-chi-ops ; cd:authoredResource true .
  ex:al-chi-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-chi-entry ; cd:authoredResource true .
  ex:al-chi-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Variance interval under iid normal sampling"@en ; dct:references ex:al-chi-data, ex:al-chi-quantiles, ex:al-chi-ops ; cd:authoredResource true .
  ex:al-chi-data a cd:MathSymbol ; cd:symbol "laboratory data" ; cd:mathNotation "n,\\ s^2,\\ n-1" ; cd:body "Five iid normal lab measurements: n=5, observed variance s squared=0.10 (mg/L) squared. n minus one gives four degrees of freedom. Target: population analytical variance."@en ; cd:authoredResource true .
  ex:al-chi-quantiles a cd:MathSymbol ; cd:symbol "chi-square quantiles" ; cd:mathNotation "q_{0.975},\\ q_{0.025}" ; cd:body "Dimensionless chi-square quantiles with four degrees of freedom: 11.1432868 and 0.4844186. Subscripts are cumulative probabilities. Larger divisor gives the lower endpoint."@en ; cd:authoredResource true .
  ex:al-chi-ops a cd:MathSymbol ; cd:symbol "interval arithmetic" ; cd:mathNotation "[\\ ,\\ ],\\ /,\\ -,\\ \\approx" ; cd:body "Brackets include endpoints; fractions divide, minus subtracts, juxtaposition multiplies. Approximately flags rounded quantiles and endpoints, in (mg/L) squared. 95% coverage concerns repeated iid normal series, not individual results."@en ; cd:authoredResource true .

  ex:al-t-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-t1, ex:al-t2, ex:al-t3 ; cd:authoredResource true .
  ex:al-t1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Analytical question"@en ; cd:body "- Report a mean from five lab measurements.\n\n- Population SD is unknown."@en ; cd:authoredResource true .
  ex:al-t2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Why Student-t"@en ; cd:body "- Estimate SD from the same series.\n\n- Account for uncertainty in that estimated spread."@en ; cd:authoredResource true .
  ex:al-t3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Exact conditions"@en ; cd:body "- Independent, identically normal observations.\n\n- Mean and variance are independent under this model."@en ; cd:authoredResource true .

  ex:al-f-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-f1, ex:al-f2, ex:al-f3 ; cd:authoredResource true .
  ex:al-f1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Analytical question"@en ; cd:body "- Compare two methods' repeatability.\n\n- Is the variance difference beyond sampling variation?"@en ; cd:authoredResource true .
  ex:al-f2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Hypothetical design"@en ; cd:body "- Six independent normal results per method.\n\n- SDs: A 0.20, B 0.40 mg/L; independent series."@en ; cd:authoredResource true .
  ex:al-f3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Before seeing data"@en ; cd:body "- Prespecify whether B has greater variance.\n\n- Use a one-sided 5% reference under equal variances."@en ; cd:authoredResource true .
  ex:al-f-work a cd:MathExpression ; cd:formulaLabel "Evaluate a prespecified upper-tail comparison"@en ; cd:latex "\\begin{gathered}f=\\frac{s_B^2}{s_A^2}=\\frac{0.40^2}{0.20^2}=4\\\\F_{5,5}^{-1}(0.95)\\approx5.0503\\qquad4<5.0503\\end{gathered}" ; dct:hasPart ex:al-f-legend ; cd:hasSymbol ex:al-f-data, ex:al-f-ref, ex:al-f-ops ; cd:authoredResource true .
  ex:al-f-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-f-entry ; cd:authoredResource true .
  ex:al-f-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Variance ratio and ordered F reference"@en ; dct:references ex:al-f-data, ex:al-f-ref, ex:al-f-ops ; cd:authoredResource true .
  ex:al-f-data a cd:MathSymbol ; cd:symbol "observed ratio" ; cd:mathNotation "f,\\ s_B^2,\\ s_A^2" ; cd:body "Lowercase f is the observed variance ratio, not a density here. s with subscripts B and A is sample SD 0.40 and 0.20 mg/L; squaring gives variances in (mg/L) squared, whose ratio is dimensionless. Numerator B is specified in advance, not chosen because it is larger."@en ; cd:authoredResource true .
  ex:al-f-ref a cd:MathSymbol ; cd:symbol "F inverse CDF" ; cd:mathNotation "F_{5,5}^{-1}(0.95)" ; cd:body "95th percentile of the F law, not reciprocal F. Ordered degrees of freedom are numerator six minus one and denominator six minus one. The threshold about 5.0503 leaves 5 percent in the upper tail under equal population variances and independent normal series."@en ; cd:authoredResource true .
  ex:al-f-ops a cd:MathSymbol ; cd:symbol "arithmetic and decision" ; cd:mathNotation "=,\\ /,\\ \\approx,\\ <,\\ 4,\\ 5.0503" ; cd:body "Equals states identities; fraction divides squared SDs; approximately rounds the critical value; less than compares the observed ratio 4 with that threshold. Do not reject the equal-variance null in this prespecified one-sided example. Non-rejection does not prove equal precision, accuracy or method superiority."@en ; cd:authoredResource true .

  ex:al-tests a cd:DefinitionList ; cd:hasDefinitionListEntry ex:al-test1, ex:al-test2, ex:al-test3 ; cd:authoredResource true .
  ex:al-test1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "KS: continuous CDF"@en ; cd:body "- Compare empirical and model CDFs.\n\n- Classical reference: iid data and a fully specified continuous null."@en ; cd:authoredResource true .
  ex:al-test2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Pearson: category counts"@en ; cd:body "- Compare observed and expected counts.\n\n- Check expected counts and degrees of freedom for the approximation."@en ; cd:authoredResource true .
  ex:al-test3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Limits of model checks"@en ; cd:body "- Non-rejection is not proof of the model.\n\n- Fitting parameters changes calibration; fit does not establish independence."@en ; cd:authoredResource true .
}

