  ex:al-step05 a cd:PathStep ; cd:position 5 ; cd:usesScene ex:al-cumulative ; cd:usesResource ex:al-cdf, ex:al-uniform-cdf-chart ; cd:authoredResource true .
  ex:al-step06 a cd:PathStep ; cd:position 6 ; cd:usesScene ex:al-quantile ; cd:usesResource ex:al-inverse, ex:al-uniform-inverse-chart ; cd:authoredResource true .
