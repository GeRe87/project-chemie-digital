  ex:al-step10 a cd:PathStep ; cd:position 11 ; cd:usesScene ex:al-normal-probability ; cd:usesResource ex:al-control-probability-formula, ex:l5-n10a-chart ; cd:authoredResource true .
  ex:al-step11 a cd:PathStep ; cd:position 12 ; cd:usesScene ex:al-normal-inverse ; cd:usesResource ex:al-control-inverse-formula, ex:l5-n10b-chart ; cd:authoredResource true .
  ex:al-step12 a cd:PathStep ; cd:position 14 ; cd:usesScene ex:al-log-story ; cd:usesResource ex:al-log-cards ; cd:authoredResource true .
  ex:al-step13 a cd:PathStep ; cd:position 15 ; cd:usesScene ex:al-log-model ; cd:usesResource ex:l5-l12b-formula, ex:l5-l12b-chart ; cd:authoredResource true .
  ex:al-step14 a cd:PathStep ; cd:position 16 ; cd:usesScene ex:al-log-example ; cd:usesResource ex:al-log-work, ex:l5-l12c-chart ; cd:authoredResource true .
  ex:al-step15 a cd:PathStep ; cd:position 17 ; cd:usesScene ex:al-chi-story ; cd:usesResource ex:al-chi-cards ; cd:authoredResource true .
  ex:al-step16 a cd:PathStep ; cd:position 18 ; cd:usesScene ex:al-chi-model ; cd:usesResource ex:l5-t16a-formula, ex:l5-t16b-chart ; cd:authoredResource true .
  ex:al-step17 a cd:PathStep ; cd:position 19 ; cd:usesScene ex:al-chi-example ; cd:usesResource ex:al-chi-work ; cd:authoredResource true .
  ex:al-step18 a cd:PathStep ; cd:position 20 ; cd:usesScene ex:al-t-story ; cd:usesResource ex:al-t-cards ; cd:authoredResource true .
  ex:al-step19 a cd:PathStep ; cd:position 21 ; cd:usesScene ex:al-t-model ; cd:usesResource ex:l5-t16d-formula, ex:l5-t16d-chart ; cd:authoredResource true .
  ex:al-step20 a cd:PathStep ; cd:position 22 ; cd:usesScene ex:al-t-example ; cd:usesResource ex:l5-t16g-formula ; cd:authoredResource true .
  ex:al-step21 a cd:PathStep ; cd:position 23 ; cd:usesScene ex:al-f-story ; cd:usesResource ex:al-f-cards ; cd:authoredResource true .
  ex:al-step22 a cd:PathStep ; cd:position 24 ; cd:usesScene ex:al-f-model ; cd:usesResource ex:l5-f17b-formula, ex:l5-f17b-chart ; cd:authoredResource true .
  ex:al-step23 a cd:PathStep ; cd:position 25 ; cd:usesScene ex:al-f-example ; cd:usesResource ex:al-f-work ; cd:authoredResource true .
  ex:al-step24 a cd:PathStep ; cd:position 26 ; cd:usesScene ex:al-test-story ; cd:usesResource ex:al-tests ; cd:authoredResource true .
  ex:al-step25 a cd:PathStep ; cd:position 27 ; cd:usesScene ex:l5-g19a-scene ; cd:usesResource ex:l5-g19a-formula, ex:l5-g19a-chart ; cd:authoredResource true .
  ex:al-step26 a cd:PathStep ; cd:position 28 ; cd:usesScene ex:l5-g19c-scene ; cd:usesResource ex:l5-g19c-formula, ex:l5-g19c-chart ; cd:authoredResource true .
