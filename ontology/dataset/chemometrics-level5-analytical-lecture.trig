  ex:path-level5-analytical-distributions a cd:LearningPath ; skos:prefLabel "Analytical distributions: models, inference and Monte Carlo"@en ; cd:forLearningUnit ex:unit-level5-probability-models ; cd:forTopic ex:l5-analytical-distributions, ex:l5-monte-carlo ; cd:hasStep ex:al-step01, ex:al-step02, ex:al-step03, ex:al-step04, ex:al-step05, ex:al-step06, ex:al-step07, ex:al-step08, ex:al-step09, ex:al-step10, ex:al-step11, ex:al-step12, ex:al-step13, ex:al-step14, ex:al-step15, ex:al-step16, ex:al-step17, ex:al-step18, ex:al-step19, ex:al-step20, ex:al-step21, ex:al-step22, ex:al-step23, ex:al-step24, ex:al-step25, ex:al-step26, ex:al-step27, ex:al-step28, ex:al-step29, ex:al-step30, ex:al-step31 ; cd:authoredResource true .
