<https://w3id.org/project-chemie-digital/graph/knowledge/level5-screening-reserve> {
  ex:l5-screening-misclassification a cd:Concept ; skos:prefLabel "Observed positivity versus true-state prevalence"@en ; cd:hasDefinition ex:l5-v02-definition ; cd:authoredResource true .
  ex:l5-v02-definition a cd:Definition ; cd:body "A positive analytical finding is a decision about a signal, not an infallible statement of the true sample state. In a specified target population, observed positive-result probability combines sensitivity among true positives and false-positive probability among true negatives, weighted by their population proportions. It is generally different from true prevalence and from detection probability at a fixed concentration. Homogeneous test-performance probabilities are a teaching assumption, not a guarantee across concentrations, matrices or sampling schemes."@en ; cd:authoredResource true .
  ex:l5-v02a-formula a cd:MathExpression ; cd:formulaLabel "Combine the two routes to a positive finding"@en ; cd:body "Positive-result probability equals true prevalence times sensitivity plus true-negative prevalence times false-positive rate. Here 0.01 times 0.90 plus 0.99 times 0.05 gives 0.0585, or 5.85%."@en ; cd:latex "q=\\pi\\,\\mathrm{Se}+(1-\\pi)\\,\\mathrm{FPR}" ; dct:hasPart ex:l5-v02a-legend ; cd:hasSymbol ex:l5-v02a-q, ex:l5-v02a-prevalence, ex:l5-v02a-performance, ex:l5-v02a-operators ; cd:authoredResource true .
  ex:l5-v02a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-v02a-entry ; cd:authoredResource true .
  ex:l5-v02a-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, denominators and model assumptions"@en ; dct:references ex:l5-v02a-q, ex:l5-v02a-prevalence, ex:l5-v02a-performance, ex:l5-v02a-operators ; cd:authoredResource true .
  ex:l5-v02a-q a cd:MathSymbol ; cd:symbol "positive-result probability" ; cd:mathNotation "q" ; cd:body "Probability of a positive finding for a random sample from this target population. Here 0.0585, or 5.85%, not true-state prevalence."@en ; cd:authoredResource true .
  ex:l5-v02a-prevalence a cd:MathSymbol ; cd:symbol "true prevalence" ; cd:mathNotation "\\pi,\\ 1-\\pi" ; cd:body "Pi is the true-positive population proportion, here 0.01. Its complement 0.99 is the true-negative proportion; pi is not the circle constant here."@en ; cd:authoredResource true .
  ex:l5-v02a-performance a cd:MathSymbol ; cd:symbol "conditional test performance" ; cd:mathNotation "\\mathrm{Se},\\ \\mathrm{FPR}" ; cd:body "Se: positive finding given true positive, 0.90. FPR: positive finding given true negative, 0.05. Denominators are different true-state groups."@en ; cd:authoredResource true .
  ex:l5-v02a-operators a cd:MathSymbol ; cd:symbol "mixture arithmetic" ; cd:mathNotation "=,\\ +,\\ -,\\ (\\, )" ; cd:body "Multiply adjacent factors, add the two disjoint routes; subtract from 1 for the complement. All quantities are dimensionless probabilities. Fixed homogeneous performance is assumed."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-screening-reserve> {
  # Separate optional reserve offering. The main 64-scene path is not extended.
  ex:offering-level5-screening-reserve a cd:TeachingOffering ; skos:prefLabel "Level 5 optional reserve: screening decisions"@en ; cd:hasUnitPlacement ex:placement-level5-screening-reserve .
  ex:unit-level5-screening-reserve a cd:LearningUnit ; skos:prefLabel "Screening decisions: optional reserve"@en ; cd:hasFocusConcept ex:binary-analytical-finding, ex:l5-screening-misclassification .
  ex:placement-level5-screening-reserve a cd:UnitPlacement ; cd:position 1 ; cd:placesLearningUnit ex:unit-level5-screening-reserve .
  ex:l5-v01-title a cd:Interpretation ; skos:prefLabel "A finding is not the true sample state"@en ; cd:authoredResource true .
  ex:l5-v02a-title a cd:Interpretation ; skos:prefLabel "Correct interpretation needs assay performance"@en ; cd:authoredResource true .
  ex:l5-v02b-title a cd:Interpretation ; skos:prefLabel "Population groups explain false findings"@en ; cd:authoredResource true .
  ex:l5-v01-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-v01-state, ex:l5-v01-signal, ex:l5-v01-decision ; cd:authoredResource true .
  ex:l5-v01-state a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "True state"@en ; cd:body "The target analyte is present, or the true concentration exceeds a specified scientific threshold. Define which state is meant."@en ; cd:authoredResource true .
  ex:l5-v01-signal a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Analytical signal"@en ; cd:body "A continuous measured response with analytical variability and possible bias. It is not direct access to the true concentration."@en ; cd:authoredResource true .
  ex:l5-v01-decision a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Binary finding"@en ; cd:body "A predefined rule turns the signal into positive or negative. False positives and false negatives remain possible; negative does not prove absence."@en ; cd:authoredResource true .
  ex:l5-v02a-chart a cd:ChartDefinition ; skos:prefLabel "Specified model: true prevalence versus positive-finding probability"@en ; cd:body "Teaching assumptions: prevalence 1%, sensitivity 90%, false-positive rate 5%. Positive-result probability: 5.85%, not 1%."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-v02-proportions ; cd:xAxisLabel "Population quantity"@en ; cd:yAxisLabel "Population proportion"@en ; cd:yAxisUnit "%" ; cd:authoredResource true .
  ex:l5-v02-proportions a cd:Dataset ; skos:prefLabel "True prevalence and positive-finding probability, expressed as percentages"@en ; cd:derivedFromResource ex:l5-v02-model, ex:l5-v02a-formula ; cd:hasObservation ex:l5-v02-prevalence-percent, ex:l5-v02-positive-percent ; cd:authoredResource true .
  ex:l5-v02-prevalence-percent a cd:Observation ; cd:position 1 ; skos:prefLabel "Prevalence"@en ; cd:numericValue 1.0 ; cd:authoredResource true .
  ex:l5-v02-positive-percent a cd:Observation ; cd:position 2 ; skos:prefLabel "Test positive"@en ; cd:numericValue 5.85 ; cd:authoredResource true .
  ex:l5-v02b-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-v02b-tp, ex:l5-v02b-fn, ex:l5-v02b-fp, ex:l5-v02b-tn ; cd:authoredResource true .
  ex:l5-v02b-tp a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "True positive findings: 90"@en ; cd:body "Among 100 truly positive samples, sensitivity 90% gives 90 expected positive findings."@en ; cd:authoredResource true .
  ex:l5-v02b-fn a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "False negative findings: 10"@en ; cd:body "The other 10 of the 100 truly positive samples are expected negative findings: false-negative rate 10%."@en ; cd:authoredResource true .
  ex:l5-v02b-fp a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "False positive findings: 495"@en ; cd:body "Among 9,900 truly negative samples, false-positive rate 5% gives 495 expected positive findings."@en ; cd:authoredResource true .
  ex:l5-v02b-tn a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "True negative findings: 9,405"@en ; cd:body "Specificity 95% gives 9,405 expected negative findings. Total positive findings: 585, not the 100 truly positive samples."@en ; cd:authoredResource true .
  ex:l5-v02-model a cd:WorkedExample ; cd:body "Hypothetical homogeneous screening-performance model, not measured PFAS prevalence or a validated assay specification. Define true positivity by one chosen scientific target condition and a suitable reference standard. Target-population true prevalence is 0.01, sensitivity 0.90 and false-positive rate 0.05. Then false-negative rate is 0.10 and specificity 0.95. By the law of total probability, marginal positive-finding probability is 0.01*0.90 + 0.99*0.05 = 0.0585. For 10,000 randomly selected samples, expected true-positive/false-negative/false-positive/true-negative classification counts are 90/10/495/9405. These are model expectations, not an observed confusion matrix or guaranteed allocation. Total expected positives 585 and negatives 9415; total true positives 100 and true negatives 9900. Among the expected positive findings, the ratio 90/585 is about 15.38%; that is distinct from sensitivity, whose denominator is all truly positive samples. No new formula for predictive value is needed in this first reserve increment. The conditional test-performance groups have different denominators. Marginal positive counts can follow a binomial model only with a fixed number of independent units and common positive-result probability. The mixture identity for one randomly selected unit itself does not require independence across units. For repeat readings at a fixed concentration, detection probability depends on that concentration, procedure and matrix, not on an environmental-population prevalence. No legal threshold, method-performance claim, real prevalence estimate or deconvolution of prevalence from observed positivity is asserted."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/level5-screening-reserve> {
  ex:path-level5-screening-reserve a cd:LearningPath ; skos:prefLabel "Screening decisions: optional reserve"@en ; cd:forLearningUnit ex:unit-level5-screening-reserve ; cd:forTopic ex:binary-analytical-finding, ex:l5-screening-misclassification ; cd:hasStep ex:l5-v01-step, ex:l5-v02a-step, ex:l5-v02b-step ; cd:authoredResource true .
  ex:l5-v01-step a cd:PathStep ; cd:position 1 ; cd:usesScene ex:l5-v01-scene ; cd:usesResource ex:l5-v01-title, ex:l5-v01-cards ; cd:authoredResource true .
  ex:l5-v02a-step a cd:PathStep ; cd:position 2 ; cd:usesScene ex:l5-v02a-scene ; cd:usesResource ex:l5-v02a-title, ex:l5-v02a-chart, ex:l5-v02a-formula ; cd:authoredResource true .
  ex:l5-v02b-step a cd:PathStep ; cd:position 3 ; cd:usesScene ex:l5-v02b-scene ; cd:usesResource ex:l5-v02b-title, ex:l5-v02b-cards ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-screening-reserve> {
  ex:l5-v01-scene a cd:SceneDefinition ; cd:focusConcept ex:binary-analytical-finding ; cd:hasSceneItem ex:l5-v01-heading, ex:l5-v01-list ; cd:narration "Optional reserve: explain what a sample's finding can tell us about an unknown population state. Separate the defined true state, analytical signal and classification decision. Presence of one analyte and concentration above a scientific threshold are different definitions of positivity; specify the target and suitable reference standard. The continuous signal depends on variability, calibration, preparation and bias. A predefined rule maps it to a positive or negative finding; neither is infallible and negative does not prove absence. False positives and negatives are defined against the reference standard, not by treating the classification as truth. No legal safety limit is selected here. For environmental sampling, the observed finding proportion concerns the defined target population and its selection design. Repeating the same sample at fixed concentration instead characterizes detection probability at that concentration, matrix and conditions. Technical repeats do not create new independently sampled environmental units. The next reserve illustration explains why an observed positive proportion is not automatically true population prevalence."@en ; cd:authoredResource true .
  ex:l5-v02a-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-screening-misclassification ; cd:hasSceneItem ex:l5-v02a-heading, ex:l5-v02a-plot, ex:l5-v02a-math ; cd:narration "V02a, optional reserve. In a hypothetical target population, specify true prevalence one percent, sensitivity ninety percent and false-positive rate five percent. These are teaching assumptions, not measurements or a validated assay claim. A positive finding can come from a truly positive sample detected correctly or a truly negative sample classified incorrectly. The first contribution is one percent times ninety percent, or 0.9 percent of the population. The second is ninety-nine percent times five percent, or 4.95 percent. Add the disjoint contributions to obtain positive-result probability 5.85 percent. Sensitivity is conditioned on truly positive samples; false-positive rate is conditioned on truly negative samples. They do not share a denominator. The chart compares marginal positive-finding probability with true prevalence, not sensitivity with prevalence. The formula uses probabilities from zero to one, while the chart expresses them as percentages. Pi denotes prevalence, not the circle constant. Homogeneous sensitivity and false-positive rate are assumptions within these target groups; performance can vary with concentration, matrix, preparation or selection. The mixture identity for a random unit is the law of total probability. A binomial model for a count of positive findings additionally requires independent units with common positive-result probability and a fixed sample size."@en ; cd:authoredResource true .
  ex:l5-v02b-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-screening-misclassification ; cd:hasSceneItem ex:l5-v02b-heading, ex:l5-v02b-list ; cd:narration "V02b, optional reserve. Scale the same model to ten thousand randomly selected samples to make the denominators visible. One hundred are expected truly positive and ninety-nine hundred truly negative. Among the truly positive group, sensitivity ninety percent gives ninety expected positive findings and ten false negatives. Among the truly negative group, false-positive rate five percent gives four hundred ninety-five expected positive findings, leaving ninety-four hundred five true negatives. Specificity is ninety-five percent; the false-negative rate is ten percent. The four expected cells sum to ten thousand. Total positive findings are five hundred eighty-five, or 5.85 percent, even though true prevalence is one percent. The numerous true-negative samples explain why false positives can outnumber true positives when the target condition is rare. These are model expectations, not observed counts or a guaranteed allocation in a realized sample. Among expected positive findings, only ninety of five hundred eighty-five, about 15.38 percent, are truly positive in this scenario; do not confuse that denominator with sensitivity. No real-world performance, prevalence or regulatory conclusion follows. The population, true-state definition, reference standard and sampling process must be justified before applying these relationships to real analytical results."@en ; cd:authoredResource true .
  ex:l5-v01-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-v01-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v01-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-v01-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v02a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-v02a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v02a-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-v02a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v02a-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-v02a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v02b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-v02b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-v02b-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-v02b-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
