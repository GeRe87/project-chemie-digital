<https://w3id.org/project-chemie-digital/graph/shapes/unit-scale-factor> {
  cd:UnitScaleFactorShape a sh:NodeShape ; sh:targetSubjectsOf cd:unitScaleFactor ; sh:class cd:Dataset ;
    sh:property [ sh:path cd:unitScaleFactor ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:decimal ; sh:minExclusive 0 ],
    [ sh:path cd:derivedFromResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Dataset ],
    [ sh:path cd:unit ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:string ] .
}

<https://w3id.org/project-chemie-digital/graph/ontology/unit-scale-factor> {
  cd:LearningDomain cdm:definesAttribute cd:unitScaleFactor .
  cd:unitScaleFactor a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:Dataset ; rdfs:range xsd:decimal ; rdfs:comment "Multiply numeric values in the derivedFromResource dataset by this factor to express the same physical values in this dataset's unit."@en .
}
