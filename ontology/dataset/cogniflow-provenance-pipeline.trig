@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-provenance-pipeline> {
  ex:cogniflow-provenance-travels-with-data a cd:Concept ;
    skos:prefLabel "The Result Carries Its History"@en ;
    cd:hasDefinition ex:def-cogniflow-provenance-travels-with-data ;
    cd:authoredResource true .

  ex:def-cogniflow-provenance-travels-with-data a cd:Definition ;
    cd:body "A reusable scientific result keeps its input, processing identity and derivation history attached to the result itself."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-provenance-pipeline a cd:FlowDiagram ;
    skos:prefLabel "Provenance as part of the result"@en ;
    cd:body "Provenance is not a separate report added later. Each derived artifact keeps the input and processing context that produced it, so the final result remains traceable and reusable."@en ;
    cd:hasDiagramNode
      ex:node-cogniflow-prov-input,
      ex:node-cogniflow-prov-processing,
      ex:node-cogniflow-prov-derived,
      ex:node-cogniflow-prov-reusable ;
    cd:hasDiagramEdge
      ex:edge-cogniflow-prov-input-processing,
      ex:edge-cogniflow-prov-processing-derived,
      ex:edge-cogniflow-prov-derived-reusable ;
    cd:focusNode ex:node-cogniflow-prov-reusable ;
    cd:authoredResource true .

  ex:node-cogniflow-prov-input a cd:DiagramNode ;
    skos:prefLabel "INPUT DATA"@en ;
    cd:position 1 ; cd:authoredResource true .

  ex:node-cogniflow-prov-processing a cd:DiagramNode ;
    skos:prefLabel "PROCESSING · method + version + parameters"@en ;
    cd:position 2 ; cd:authoredResource true .

  ex:node-cogniflow-prov-derived a cd:DiagramNode ;
    skos:prefLabel "DERIVED ARTIFACT · linked to input + process"@en ;
    cd:position 3 ; cd:authoredResource true .

  ex:node-cogniflow-prov-reusable a cd:DiagramNode ;
    skos:prefLabel "REUSABLE RESULT · data + provenance"@en ;
    cd:position 4 ; cd:authoredResource true .

  ex:edge-cogniflow-prov-input-processing a cd:DiagramEdge ;
    skos:prefLabel "processed by"@en ; cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-prov-input ; cd:targetNode ex:node-cogniflow-prov-processing ;
    cd:authoredResource true .

  ex:edge-cogniflow-prov-processing-derived a cd:DiagramEdge ;
    skos:prefLabel "produces + records"@en ; cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-prov-processing ; cd:targetNode ex:node-cogniflow-prov-derived ;
    cd:authoredResource true .

  ex:edge-cogniflow-prov-derived-reusable a cd:DiagramEdge ;
    skos:prefLabel "packages with history"@en ; cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-prov-derived ; cd:targetNode ex:node-cogniflow-prov-reusable ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-provenance-pipeline-extension> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-provenance-pipeline .

  ex:path-step-cogniflow-provenance-pipeline a cd:PathStep ;
    cd:position 11 ;
    cd:usesResource ex:diagram-cogniflow-provenance-pipeline ;
    cd:usesScene ex:scene-cogniflow-provenance-pipeline ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-provenance-pipeline> {
  ex:scene-cogniflow-provenance-pipeline a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-provenance-travels-with-data ;
    cd:hasSceneItem ex:scene-item-cogniflow-provenance-heading,
      ex:scene-item-cogniflow-provenance-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-provenance-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-provenance-travels-with-data ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-provenance-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-provenance-pipeline ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
