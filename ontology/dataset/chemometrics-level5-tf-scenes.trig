@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/scenes/level5-tf-story> {
  ex:tf-crm-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-crm-h, ex:tf-crm-c ; cd:narration "Return to nitrate IC, but announce a fresh CRM study. Unlike the preceding known-variance QC comparison, the true repeatability SD is unknown. The negligible reference uncertainty assumption is a teaching simplification, not a rule for real certified materials."@en ; cd:authoredResource true .
  ex:tf-crm-title a cd:Interpretation ; skos:prefLabel "Is our nitrate method systematically high?"@en ; cd:authoredResource true .
  ex:tf-crm-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-crm-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-crm-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-crm ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-data-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-data-h, ex:tf-data-c ; cd:narration "These six deliberately constructed fictional results have exact mean 10.10 and sample SD 0.10 mg/L. Ask whether a 0.10 mg/L mean departure is persuasive without considering sample size and uncertainty. Preserve these exact A values for the later F comparison."@en ; cd:authoredResource true .
  ex:tf-data-title a cd:Interpretation ; skos:prefLabel "Six results: mean 10.10, sample SD 0.10 mg/L"@en ; cd:authoredResource true .
  ex:tf-data-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-data-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-data-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-data ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-known-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-known-h, ex:tf-known-f ; cd:narration "The mean has a normal sampling distribution for iid normal individuals. Centering at the null reference gives the standard-normal law only under that null. Sigma 0.10 is hypothetical here, not silently promoted from the observed sample SD."@en ; cd:authoredResource true .
  ex:tf-known-title a cd:Interpretation ; skos:prefLabel "Why not use the familiar normal reference?"@en ; cd:authoredResource true .
  ex:tf-known-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-known-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-known-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-known ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-estimated-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-estimated-h, ex:tf-estimated-f ; cd:narration "Replacing sigma by s is not just replacing a missing number. It changes the statistic's sampling law. The numerical standardized departure remains root six; the reference changes because the denominator is estimated."@en ; cd:authoredResource true .
  ex:tf-estimated-title a cd:Interpretation ; skos:prefLabel "Our denominator is an estimate"@en ; cd:authoredResource true .
  ex:tf-estimated-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-estimated-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-estimated-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-estimated ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-student-live a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-student-h, ex:tf-student-c ; cd:narration "Optional instructor experiment: generate ten thousand independent six-result normal series under the null. Each estimates its own mean and SD. First compare the histogram with the normal overlay, then the Student overlay. The console compares rejection frequencies without confusing them with exact population probabilities. A plot window does not discard simulated tails."@en ; cd:authoredResource true .
  ex:tf-student-title a cd:Interpretation ; skos:prefLabel "Repeat the six-result experiment 10,000 times"@en ; cd:authoredResource true .
  ex:tf-student-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-student-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-student-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-student-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-denominator-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-denominator-h, ex:tf-denominator-c ; cd:narration "Ask why extremes become more common although the underlying mean and SD stayed fixed. A small estimated SD supplies the mechanism. This is a sampling distribution of ratios, not evidence that individual normal measurements have become heavy-tailed."@en ; cd:authoredResource true .
  ex:tf-denominator-title a cd:Interpretation ; skos:prefLabel "Where do the heavier tails come from?"@en ; cd:authoredResource true .
  ex:tf-denominator-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-denominator-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-denominator-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-denominator ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-construction-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-construction-h, ex:tf-construction-f ; cd:narration "Combine the standard-normal mean departure and the chi-square variance result just established. Normal sampling supplies independence, not merely the marginal laws. Substitution cancels the unknown population SD, yielding the Student law. Under the tested null, center at the CRM reference."@en ; cd:authoredResource true .
  ex:tf-construction-title a cd:Interpretation ; skos:prefLabel "Normal divided by an independent variance factor"@en ; cd:authoredResource true .
  ex:tf-construction-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-construction-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-construction-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-construction ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-df-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-df-h, ex:tf-df-c ; cd:narration "Six observations estimate one mean, leaving five residual degrees of freedom. The t reference inherits those variance df. Increasing n stabilizes the SD estimate, bringing critical values toward the normal 1.95996. This table supports the discussion without needing live code."@en ; cd:authoredResource true .
  ex:tf-df-title a cd:Interpretation ; skos:prefLabel "Six observations, five residual degrees of freedom"@en ; cd:authoredResource true .
  ex:tf-df-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-df-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-df-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-df ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-df-live a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-df-live-h, ex:tf-df-live-c ; cd:narration "Optional instructor variation: use the five listed sample sizes while retaining the two-sided 5% error budget. Wider small-sample critical bounds reflect uncertainty in the estimated denominator, not a change of significance level."@en ; cd:authoredResource true .
  ex:tf-df-live-title a cd:Interpretation ; skos:prefLabel "What changes when we collect more results?"@en ; cd:authoredResource true .
  ex:tf-df-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-df-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-df-live-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-df-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-t-decision-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-t-decision-h, ex:tf-t-decision-c ; cd:narration "Answer the opening CRM question. The selected example deliberately makes the normal and t decisions differ at 5%. State non-rejection precisely: insufficient evidence is not proof of unbiasedness, and the p-value is not a posterior probability for the null."@en ; cd:authoredResource true .
  ex:tf-t-decision-title a cd:Interpretation ; skos:prefLabel "Not enough evidence of bias at 5%"@en ; cd:authoredResource true .
  ex:tf-t-decision-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-t-decision-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-t-decision-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-t-decision ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-ci-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; cd:hasSceneItem ex:tf-ci-h, ex:tf-ci-f ; cd:narration "The confidence interval is the inversion of the same family of two-sided t tests. The CRM reference remains barely inside. Coverage describes repeated use of the procedure for a fixed true mean, not a probability distribution for that mean or a prediction interval for individuals."@en ; cd:authoredResource true .
  ex:tf-ci-title a cd:Interpretation ; skos:prefLabel "Which population means remain compatible?"@en ; cd:authoredResource true .
  ex:tf-ci-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-ci-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-ci-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-ci ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-devices-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-devices-h, ex:tf-devices-c ; cd:narration "Device A is exactly the previous six-value series. Device B is a separate independent six-result series under comparable repeatability conditions. The display rows are not paired observations. Ask separately about closeness of the observed mean and the observed spread."@en ; cd:authoredResource true .
  ex:tf-devices-title a cd:Interpretation ; skos:prefLabel "Same device A, a second independent device B"@en ; cd:authoredResource true .
  ex:tf-devices-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-devices-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-devices-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-pair-data ; cd:communicativeRole cd:TableRole ; cd:selectionPath "cd:hasTableRow" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-ratio-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-ratio-h, ex:tf-ratio-f ; cd:narration "A has smaller observed spread, while B's observed mean is closer to ten. Neither fact establishes overall method quality. Fix ratio B/A before seeing results. We compare random variance estimates, not merely assert that the true variance ratio equals nine."@en ; cd:authoredResource true .
  ex:tf-ratio-title a cd:Interpretation ; skos:prefLabel "Compare variance estimates, not the means"@en ; cd:authoredResource true .
  ex:tf-ratio-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-ratio-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-ratio-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-ratio ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-live a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-f-live-h, ex:tf-f-live-c ; cd:narration "Generate ten thousand independent pairs under equal true variances, retaining distinct means to show equality of means is unnecessary. Observe ratios on both sides of one and a long right tail. A small denominator variance can produce a very large ratio. The finite display does not truncate the reference law."@en ; cd:authoredResource true .
  ex:tf-f-live-title a cd:Interpretation ; skos:prefLabel "What if the true device variances were equal?"@en ; cd:authoredResource true .
  ex:tf-f-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-f-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-live-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-f-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-construction-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-f-construction-h, ex:tf-f-construction-f ; cd:narration "Normalize both independent chi-square quantities by their own df. Under equal population variances, the population scale cancels and leaves B/A. Independence between groups and normal sampling within groups are distinct requirements. Means may differ."@en ; cd:authoredResource true .
  ex:tf-f-construction-title a cd:Interpretation ; skos:prefLabel "F combines two independent chi-square quantities"@en ; cd:authoredResource true .
  ex:tf-f-construction-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-f-construction-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-construction-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-f-law ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-df-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-f-df-h, ex:tf-f-df-c ; cd:narration "Use an unequal-size thought experiment to expose the order of df, which equal sample sizes can conceal. Keeping the ratio orientation fixed also prevents an incorrect lower-tail or doubled-tail calculation after sorting by observed variance."@en ; cd:authoredResource true .
  ex:tf-f-df-title a cd:Interpretation ; skos:prefLabel "Two df parameters, in a meaningful order"@en ; cd:authoredResource true .
  ex:tf-f-df-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-f-df-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-df-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-f-df ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-decision-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-f-decision-h, ex:tf-f-decision-c ; cd:narration "Use equal tail areas for the prespecified two-sided 5% comparison. The observed ratio nine lies above 7.14638. Interpret the result under the stated sampling model, without equating repeatability with overall analytical merit."@en ; cd:authoredResource true .
  ex:tf-f-decision-title a cd:Interpretation ; skos:prefLabel "Evidence of different repeatability variances"@en ; cd:authoredResource true .
  ex:tf-f-decision-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-f-decision-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-f-decision-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-f-decision ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-alpha-live a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-alpha-h, ex:tf-alpha-c ; cd:narration "Keep observations constant. Upper two-sided bounds at alpha 10%, 5% and 1% are 5.05033, 7.14638 and 14.93961. The observed ratio nine rejects at the first two levels but not at 1%. This is a sensitivity illustration, not permission to select alpha after seeing the result."@en ; cd:authoredResource true .
  ex:tf-alpha-title a cd:Interpretation ; skos:prefLabel "Change the error budget, not the data"@en ; cd:authoredResource true .
  ex:tf-alpha-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-alpha-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-alpha-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-alpha-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-square-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-square-h, ex:tf-square-f ; cd:narration "Square the t construction. The normal square is chi-square with one df and remains independent of the denominator. The CRM t squared gives six with df 1,5, not the devices' ratio nine with df 5,5. The upper F tail already includes both signs of the t departure."@en ; cd:authoredResource true .
  ex:tf-square-title a cd:Interpretation ; skos:prefLabel "Square a t variable and obtain an F variable"@en ; cd:authoredResource true .
  ex:tf-square-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-square-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-square-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-square ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-calibration-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-calibration-h, ex:tf-calibration-c ; cd:narration "Transfer from two devices to calibration. Both nested ordinary-least-squares models fit the same fixed concentrations and responses. Explain why a reduced RSS is guaranteed rather than sufficient evidence for useful curvature. The null concerns the extra coefficient, not equality of two device variances."@en ; cd:authoredResource true .
  ex:tf-calibration-title a cd:Interpretation ; skos:prefLabel "Does a quadratic calibration earn its extra term?"@en ; cd:authoredResource true .
  ex:tf-calibration-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-calibration-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-calibration-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-calibration ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-cal-live a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-cal-live-h, ex:tf-cal-live-c ; cd:narration "Optional instructor experiment: plot synthetic calibration points, both fits and their residuals. Compute the nested F statistic directly and check it against R anova. These constructed residuals illustrate arithmetic, not empirical confirmation of normal error assumptions. Set the curvature to zero as a comparison, not as a proof from one realization."@en ; cd:authoredResource true .
  ex:tf-cal-live-title a cd:Interpretation ; skos:prefLabel "Fit both models to the same twelve points"@en ; cd:authoredResource true .
  ex:tf-cal-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-cal-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-cal-live-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-cal-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-cal-law-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-cal-law-h, ex:tf-cal-law-f ; cd:narration "The independent chi-square pieces are the extra-term sum of squares and the complex-model residual sum of squares, not the two nested RSS values. Count intercepts: two coefficients versus three gives one numerator df and nine denominator df with twelve observations. Normal homoscedastic errors and fixed full-rank nested designs give the exact F law."@en ; cd:authoredResource true .
  ex:tf-cal-law-title a cd:Interpretation ; skos:prefLabel "Which two quadratic forms supply the F law?"@en ; cd:authoredResource true .
  ex:tf-cal-law-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-cal-law-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-cal-law-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-cal-law ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-assume-live a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-assume-live-h, ex:tf-assume-live-c ; cd:narration "Compare the same seeded normal errors with deliberate contamination and time drift. The reported reference p-values become nominal when the model is violated. One realization shows sensitivity but does not estimate a false-positive rate. The order plot highlights information a histogram would lose."@en ; cd:authoredResource true .
  ex:tf-assume-live-title a cd:Interpretation ; skos:prefLabel "Add an outlier or drift: can we trust the reference?"@en ; cd:authoredResource true .
  ex:tf-assume-live-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-assume-live-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-assume-live-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-assume-code ; cd:communicativeRole cd:CodeRole ; cd:selectionPath "cd:hasCodeExample" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-assumptions-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-assumptions-h, ex:tf-assumptions-c ; cd:narration "Restore the assumptions as part of the scientific conclusion, not a footnote. Neither normal-looking data nor a nonsignificant result can validate the design. Real reference uncertainty must be incorporated when not negligible."@en ; cd:authoredResource true .
  ex:tf-assumptions-title a cd:Interpretation ; skos:prefLabel "Exact distributions are conditional on the model"@en ; cd:authoredResource true .
  ex:tf-assumptions-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-assumptions-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-assumptions-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:tf-assumptions ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:tf-design-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; cd:hasSceneItem ex:tf-design-h, ex:tf-design-c ; cd:narration "Distinguish the present independent variance comparison from paired and independent mean comparisons. Welch and paired t answer different design-specific questions. Brown-Forsythe and resampling need their own conditions and cannot automatically repair drift or dependence."@en ; cd:authoredResource true .
  ex:tf-design-title a cd:Interpretation ; skos:prefLabel "Choose the test for the question and design"@en ; cd:authoredResource true .
  ex:tf-design-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:tf-design-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
