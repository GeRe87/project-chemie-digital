@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-monte-carlo> {
  ex:mc-equation a cd:MathExpression ; cd:formulaLabel "Measurement equation and nominal calculation"@en ; cd:latex "\\begin{gathered}C=\\frac{A-b}{a}\\frac{V_f}{V_p}\\\\C_0=\\frac{0.200-0.010}{0.095}\\frac{100.00}{10.00}=20.00\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:mc-equation-legend ; cd:hasSymbol ex:mc-concentration, ex:mc-calibration, ex:mc-volumes, ex:mc-arithmetic ; cd:authoredResource true .
  ex:mc-equation-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mc-equation-entry ; cd:authoredResource true .
  ex:mc-equation-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Dilution measurement symbols"@en ; dct:references ex:mc-concentration, ex:mc-calibration, ex:mc-volumes, ex:mc-arithmetic ; cd:authoredResource true .
  ex:mc-concentration a cd:MathSymbol ; cd:symbol "concentration" ; cd:mathNotation "C,\\ C_0" ; cd:body "C is concentration in the original homogeneous collected sample, in mg/L. Subscript zero denotes evaluation at nominal inputs, not a known true concentration or a water-body mean."@en ; cd:authoredResource true .
  ex:mc-calibration a cd:MathSymbol ; cd:symbol "signal and calibration" ; cd:mathNotation "A,\\ b,\\ a" ; cd:body "A is dimensionless absorbance, nominally 0.200. The assumed linear calibration has fixed intercept b=0.010 and positive fixed slope a=0.095 L/mg. Subtracting the intercept and dividing by slope gives diluted concentration. Calibration uncertainty and covariance are deliberately excluded from this teaching model."@en ; cd:authoredResource true .
  ex:mc-volumes a cd:MathSymbol ; cd:symbol "dilution volumes" ; cd:mathNotation "V_f,\\ V_p" ; cd:body "V subscript f is final flask volume, nominally 100.00 mL. V subscript p is pipetted sample volume, nominally 10.00 mL. Their ratio is the dimensionless dilution factor, nominally ten; positive volumes are required."@en ; cd:authoredResource true .
  ex:mc-arithmetic a cd:MathSymbol ; cd:symbol "equation arithmetic" ; cd:mathNotation "=,\\ -,\\ /,\\ \\mathrm{mg/L}" ; cd:body "Equals defines the measurement result; minus corrects the intercept; fraction bars divide; juxtaposition multiplies. Inserted numbers are nominal absorbance, calibration and volumes in the units stated here. Concentration is milligrams per litre. The calculation is conditional on this linear calibration and dilution model."@en ; cd:authoredResource true .

  ex:mc-inputs a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mc-input-a, ex:mc-input-p, ex:mc-input-f ; cd:authoredResource true .
  ex:mc-input-a a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Absorbance: normal"@en ; cd:body "- Centre 0.200, SD 0.003.\n\n- Assumed stable measurement-error model, not fitted from five values."@en ; cd:authoredResource true .
  ex:mc-input-p a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Pipette: uniform bounds"@en ; cd:body "- 9.98 to 10.02 mL, equally plausible.\n\n- Tolerance half-width is not an SD."@en ; cd:authoredResource true .
  ex:mc-input-f a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Flask: uniform bounds"@en ; cd:body "- 99.92 to 100.08 mL, equally plausible.\n\n- Independence of volumes and absorbance is an explicit assumption."@en ; cd:authoredResource true .

  ex:mc-inverse a cd:MathExpression ; cd:formulaLabel "Independent uniform numbers become model inputs"@en ; cd:latex "\\begin{gathered}A=0.200+0.003\\,\\Phi^{-1}(U_1)\\\\V_p=(9.98+0.04U_2)\\;\\mathrm{mL}\\\\V_f=(99.92+0.16U_3)\\;\\mathrm{mL}\\end{gathered}" ; dct:hasPart ex:mc-inverse-legend ; cd:hasSymbol ex:mc-uniforms, ex:mc-normal-transform, ex:mc-volume-transform ; cd:authoredResource true .
  ex:mc-inverse-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mc-inverse-entry ; cd:authoredResource true .
  ex:mc-inverse-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Inverse-transform inputs"@en ; dct:references ex:mc-uniforms, ex:mc-normal-transform, ex:mc-volume-transform ; cd:authoredResource true .
  ex:mc-uniforms a cd:MathSymbol ; cd:symbol "uniform draws" ; cd:mathNotation "U_1,\\ U_2,\\ U_3" ; cd:body "Three independent dimensionless Uniform(0,1) random quantities. Subscripts distinguish inputs, not powers or physical units. Fresh triples are used in each trial; reusing one uniform for all inputs would introduce dependence."@en ; cd:authoredResource true .
  ex:mc-normal-transform a cd:MathSymbol ; cd:symbol "normal inverse" ; cd:mathNotation "A,\\ \\Phi^{-1},\\ 0.200,\\ 0.003" ; cd:body "A is dimensionless absorbance. Phi inverse is the standard-normal quantile function, not a reciprocal. Multiplying that quantile by SD 0.003 and adding centre 0.200 generates the assumed normal input. The model has real-line support; its negative tail is negligible at this centre/SD but validity must still be checked."@en ; cd:authoredResource true .
  ex:mc-volume-transform a cd:MathSymbol ; cd:symbol "uniform volume transforms" ; cd:mathNotation "V_p,\\ V_f,\\ =,\\ +,\\ \\mathrm{mL}" ; cd:body "V p and V f are pipette and final volume in mL. The lower bounds are 9.98 and 99.92; widths 0.04 and 0.16 give upper bounds 10.02 and 100.08. Equals defines each input; plus adds, juxtaposition multiplies. All volume factors inside parentheses are numerical values in mL. These are bounded positive uniform models, not normal SDs."@en ; cd:authoredResource true .

  ex:mc-one a cd:MathExpression ; cd:formulaLabel "Trace one illustrative trial through the process"@en ; cd:latex "\\begin{gathered}(u_1,u_2,u_3)=(0.841345,0.25,0.75)\\\\(A,V_p,V_f)\\approx(0.203,9.99,100.04)\\\\C\\approx\\frac{0.203-0.010}{0.095}\\frac{100.04}{9.99}\\approx20.344\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:mc-one-legend ; cd:hasSymbol ex:mc-one-uniform, ex:mc-one-values, ex:mc-one-ops ; cd:authoredResource true .
  ex:mc-one-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mc-one-entry ; cd:authoredResource true .
  ex:mc-one-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "One-trial quantities and rounding"@en ; dct:references ex:mc-one-uniform, ex:mc-one-values, ex:mc-one-ops ; cd:authoredResource true .
  ex:mc-one-uniform a cd:MathSymbol ; cd:symbol "illustrative uniform triple" ; cd:mathNotation "u_1,u_2,u_3" ; cd:body "Lowercase u values are one deliberately chosen illustrative triple, not the first seeded live output. 0.841345 has a standard-normal quantile approximately one; the other fractions place volumes within their bounds. Subscripts identify different inputs."@en ; cd:authoredResource true .
  ex:mc-one-values a cd:MathSymbol ; cd:symbol "transformed inputs and output" ; cd:mathNotation "A,V_p,V_f,C" ; cd:body "Absorbance A is about 0.203, pipette V p is 9.99 mL and flask V f is 100.04 mL. Concentration C is in mg/L for the original collected sample. Calibration intercept 0.010 is dimensionless and slope 0.095 is L/mg. Volumes divide to a dimensionless ratio."@en ; cd:authoredResource true .
  ex:mc-one-ops a cd:MathSymbol ; cd:symbol "trial calculation" ; cd:mathNotation "(\\ ),\\ =,\\ \\approx,\\ -,\\ /" ; cd:body "Parentheses group ordered triples; commas separate entries. Equals identifies input values; approximately flags rounded transforms and result. Minus corrects absorbance and fraction bars divide. Juxtaposition multiplies. The rounded demonstration gives about 20.344 mg/L, not an additional measured concentration or a simulation summary."@en ; cd:authoredResource true .

  ex:mc-lab a cd:Exercise ; skos:prefLabel "Instructor live case: propagate dilution uncertainty"@en ; cd:body "**Run the complete process.** Each row uses three fresh pseudo-random numbers and the same measurement equation.\n\n- Start with **M = 10000** and inspect the first trial.\n- Compare the output histogram with its empirical CDF.\n- Increase M to **50000**, then change **signal_sd** only.\n\nMore trials stabilize the simulation, not the analytical method. Base R only; no package installation."@en ; cd:hasCodeExample ex:mc-code ; cd:authoredResource true .
  ex:mc-code a cd:CodeExample ; skos:prefLabel "Dilution Monte Carlo in base R"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-monte-carlo ; cd:code """# Teaching uncertainty models, not field evidence.
M <- 10000
signal_sd <- 0.003
# Park-Miller generator: reproducible protocol shared with fallback.
state <- 20261101
uniforms <- numeric(3 * M)
for (i in seq_along(uniforms)) {
  state <- (16807 * state) %% 2147483647
  uniforms[i] <- state / 2147483647
}
u <- matrix(uniforms, ncol = 3, byrow = TRUE)
absorbance <- 0.200 + signal_sd * qnorm(u[, 1])
pipette <- 9.98 + 0.04 * u[, 2]
flask <- 99.92 + 0.16 * u[, 3]
concentration <- (absorbance - 0.010) / 0.095 * flask / pipette
print(data.frame(A = absorbance[1], Vp = pipette[1],
                 Vf = flask[1], C = concentration[1]))
interval <- quantile(concentration, c(0.025, 0.975), type = 7)
print(c(mean = mean(concentration), sd = sd(concentration), interval))
par(mfrow = c(1, 2), mar = c(4, 4, 3, 1))
hist(concentration, breaks = 30, probability = TRUE,
     col = "#78b8c8", border = "white", main = "Simulated outputs",
     xlab = "Concentration (mg/L)", ylab = "Density (L/mg)")
abline(v = interval, col = "#9b3a28", lty = 2, lwd = 2)
plot(ecdf(concentration), main = "Output empirical CDF",
     xlab = "Concentration (mg/L)", ylab = "Cumulative fraction")
abline(h = c(0.025, 0.975), col = "#9b3a28", lty = 2)
""" ; cd:authoredResource true .

  ex:mc-limits a cd:DefinitionList ; cd:hasDefinitionListEntry ex:mc-limit1, ex:mc-limit2, ex:mc-limit3 ; cd:authoredResource true .
  ex:mc-limit1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "What the result covers"@en ; cd:body "An output uncertainty distribution conditional on the stated input models, measurement equation and independence assumptions."@en ; cd:authoredResource true .
  ex:mc-limit2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "What is deliberately missing"@en ; cd:body "Calibration slope/intercept uncertainty and covariance, bias, recovery, preparation effects beyond volumes, and environmental sampling."@en ; cd:authoredResource true .
  ex:mc-limit3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "What more trials change"@en ; cd:body "Numerical Monte Carlo error decreases. Physical measurement uncertainty does not. The central 95% simulated interval is not automatically a frequentist confidence interval."@en ; cd:authoredResource true .
}

