  ex:l4-hist-bimodal-chart-edge-11 rdf:first 70.0 ; rdf:rest rdf:nil .
  ex:l4-hist-bimodal-chart a cd:ChartDefinition ; cd:chartType cd:Histogram ; skos:prefLabel "100 synthetic two-cluster responses"@en ; cd:body "100 synthetic two-cluster responses. Equal-width bins: 4 a.u.; two occupied regions separated by a sparse middle."@en ; cd:usesDataset ex:l4-shapes-bimodal ; cd:xAxisLabel "Synthetic detector response"@en ; cd:xAxisUnit "a.u." ; cd:yAxisLabel "Observations per bin"@en ; cd:binEdges ex:l4-hist-bimodal-chart-edge-1 ; cd:histogramNormalization "count" ; cd:authoredResource true .
  ex:l4-histogram-intro-title a cd:Interpretation ; skos:prefLabel "Histograms: each bar represents a bin"@en ; cd:authoredResource true .
  ex:l4-histogram-intro-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Question**\n\nHow are 100 numerical readings distributed? Group adjacent values into **equal-width bins**, not unrelated categories."@en ; cd:authoredResource true .
  ex:l4-histogram-intro-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Read the bars**\n\n- Width: **5 a.u. per bin**.\n- Height: **observations in that interval**.\n- A bar is not one observation or the measured signal height."@en ; cd:authoredResource true .
  ex:l4-histogram-intro-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Check the boundaries**\n\nIntervals are [left,right); the last includes its right edge. ==Every observation is counted exactly once.=="@en ; cd:authoredResource true .
  ex:l4-histogram-reading-title a cd:Interpretation ; skos:prefLabel "Read a histogram: centre, spread and occupancy"@en ; cd:authoredResource true .
  ex:l4-histogram-reading-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Scenario**\n\n100 synthetic responses from repeated measurements of a control signal."@en ; cd:authoredResource true .
  ex:l4-histogram-reading-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Interpretation**\n\n- Centre near **50 a.u.**\n- Fewer observations in either tail.\n- Read **location, spread and symmetry together**."@en ; cd:authoredResource true .
  ex:l4-histogram-reading-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Limit**\n\n==Taller means more observations in this interval==, not higher concentration or proof of a population distribution."@en ; cd:authoredResource true .
  ex:l4-histogram-skewed-title a cd:Interpretation ; skos:prefLabel "Read a histogram: a long right tail"@en ; cd:authoredResource true .
  ex:l4-histogram-skewed-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Scenario**\n\nMany moderate synthetic responses, a few much larger ones."@en ; cd:authoredResource true .
  ex:l4-histogram-skewed-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Interpretation**\n\n- Bulk near the lower end.\n- **Long right tail**.\n- Mean **50** exceeds median **46.92 a.u.**"@en ; cd:authoredResource true .
  ex:l4-histogram-skewed-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Investigate, do not diagnose**\n\nSampling, mixtures or contamination may matter. ==A tail value is not automatically an error.== Time order is absent."@en ; cd:authoredResource true .
  ex:l4-histogram-bimodal-title a cd:Interpretation ; skos:prefLabel "Read a histogram: two occupied regions"@en ; cd:authoredResource true .
  ex:l4-histogram-bimodal-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Scenario**\n\n100 synthetic detector responses from two narrow groups."@en ; cd:authoredResource true .
  ex:l4-histogram-bimodal-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Interpretation**\n\n- Peaks near **40 and 60 a.u.**\n- Few observations near **50**.\n- One centre may sit in a gap."@en ; cd:authoredResource true .
  ex:l4-histogram-bimodal-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Next question**\n\nCheck **matrix, batch or method labels**. The plot suggests subgroups; it does not identify their cause or significance."@en ; cd:authoredResource true .
