  ex:l4-hist-skewed-chart a cd:ChartDefinition ; cd:chartType cd:Histogram ; skos:prefLabel "100 synthetic right-skewed responses"@en ; cd:body "100 synthetic right-skewed responses. Equal-width bins: 5 a.u.; do not confuse the upper tail with measurement failure."@en ; cd:usesDataset ex:l4-shapes-skewed ; cd:xAxisLabel "Synthetic detector response"@en ; cd:xAxisUnit "a.u." ; cd:yAxisLabel "Observations per bin"@en ; cd:binEdges ex:l4-hist-skewed-chart-edge-1 ; cd:histogramNormalization "count" ; cd:authoredResource true .
