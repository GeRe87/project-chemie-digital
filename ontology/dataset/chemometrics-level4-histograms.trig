@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Authored teaching content. This TriG is the sole semantic source, not generator input.
<https://w3id.org/project-chemie-digital/graph/specifications/level4-histogram-knowledge> {
  ex:histogram cd:prerequisite ex:sample ; skos:related ex:distribution .
  ex:histogram-2d cd:prerequisite ex:histogram .
  ex:histogram-bin-width cd:prerequisite ex:histogram .
  ex:histogram-density cd:prerequisite ex:histogram, ex:histogram-bin-width .
  ex:l4-hist-rules-formula a cd:MathExpression ; cd:formulaLabel "Starting rules, not an automatic verdict"@en ; cd:latex "\\begin{gathered}h_{FD}=2\\,\\mathrm{IQR}\\,n^{-1/3}\\\\h_{Scott}=3.5\\,s\\,n^{-1/3}\\\\k_{Sturges}=\\lceil1+\\log_2 n\\rceil\\end{gathered}" ; dct:hasPart ex:l4-hist-rules-formula-legend ; cd:hasSource ex:l4-source-r-histogram ; cd:authoredResource true .
  ex:l4-hist-density-formula a cd:MathExpression ; cd:formulaLabel "Unequal widths: use density so area represents frequency"@en ; cd:latex "\\begin{gathered}h_j=b_{j+1}-b_j\\\\d_j=\\frac{n_j}{n\\,h_j}\\\\d_jh_j=\\frac{n_j}{n},\\qquad\\sum_j d_jh_j=1\\end{gathered}" ; dct:hasPart ex:l4-hist-density-formula-legend ; cd:hasSource ex:l4-source-r-histogram ; cd:authoredResource true .
  ex:histogram a cd:Concept ; skos:prefLabel "Histogramm"@de, "histogram"@en ; cd:hasDefinition ex:l4-def-histogram ; cd:authoredResource true .
  ex:l4-def-histogram a cd:Definition ; cd:body "An empirical summary of numerical observations in adjacent value intervals (bins). Counts describe occupancy; with unequal widths, density heights ensure that bar areas represent relative frequencies."@en ; cd:hasSource ex:l4-source-nist-histogram ; cd:authoredResource true .
  ex:histogram-2d a cd:Concept ; skos:prefLabel "zweidimensionales Histogramm"@de, "two-dimensional histogram"@en ; cd:hasDefinition ex:l4-def-histogram-2d ; cd:authoredResource true .
  ex:l4-def-histogram-2d a cd:Definition ; cd:body "An empirical joint-frequency summary of paired numerical observations in rectangular cells formed from bins on each measurement axis."@en ; cd:hasSource ex:l4-source-ggplot-bin2d ; cd:authoredResource true .
  ex:histogram-bin-width a cd:Concept ; skos:prefLabel "Histogrammklassenbreite"@de, "histogram bin width"@en ; cd:hasDefinition ex:l4-def-histogram-bin-width ; cd:authoredResource true .
  ex:l4-def-histogram-bin-width a cd:Definition ; cd:body "The difference between adjacent numeric bin edges. Width and origin influence the displayed aggregation and must not be confused with sample size or measurement resolution."@en ; cd:hasSource ex:l4-source-nist-histogram ; cd:authoredResource true .
  ex:histogram-density a cd:Concept ; skos:prefLabel "Histogrammdichte"@de, "histogram density"@en ; cd:hasDefinition ex:l4-def-histogram-density ; cd:authoredResource true .
  ex:l4-def-histogram-density a cd:Definition ; cd:body "The sample count in a bin divided by the total count and that bin width. Its area equals the bin relative frequency; its unit is inverse to the measurement unit."@en ; cd:hasSource ex:l4-source-nist-histogram ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/sources/level4-histograms> {
  ex:l4-source-nist-histogram cd:supportsResource ex:l4-def-histogram, ex:l4-def-histogram-bin-width, ex:l4-def-histogram-density .
  ex:l4-source-r-histogram cd:supportsResource ex:l4-hist-rules-formula, ex:l4-hist-density-formula .
  ex:l4-source-ggplot-bin2d cd:supportsResource ex:l4-def-histogram-2d .
  ex:l4-source-nist-histogram a cd:Source ; dct:title "NIST/SEMATECH e-Handbook: Histogram" ; dct:creator "NIST" ; dct:identifier "l4-source-nist-histogram" ; dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/histogra.htm> ; cd:authoredResource true .
  ex:l4-source-r-histogram a cd:Source ; dct:title "R documentation: hist and nclass bin rules" ; dct:creator "R Core Team" ; dct:identifier "l4-source-r-histogram" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/graphics/html/hist.html> ; cd:authoredResource true .
  ex:l4-source-ggplot-bin2d a cd:Source ; dct:title "ggplot2: Two dimensional binning" ; dct:creator "ggplot2 authors" ; dct:identifier "l4-source-ggplot-bin2d" ; dct:source <https://ggplot2.tidyverse.org/reference/geom_bin_2d.html> ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/specifications/level4-histogram-teaching> {
  ex:l4-hist-adjustable-chart a cd:ChartDefinition ; cd:chartType cd:Histogram ; skos:prefLabel "Interactive bin width and origin"@en ; cd:body "Change width and origin, or choose a named starting rule. All 100 observations remain counted; the grid extends to cover the authored domain."@en ; cd:usesDataset ex:l4-shapes-normal ; cd:xAxisLabel "Synthetic detector response"@en ; cd:xAxisUnit "a.u." ; cd:yAxisLabel "Observations per bin"@en ; cd:binEdges ex:l4-hist-normal-chart-edge-1 ; cd:histogramNormalization "count" ; cd:allowBinAdjustment true ; cd:binWidthMinimum 0.5 ; cd:binWidthMaximum 60.0 ; cd:binWidthStep 0.01 ; cd:authoredResource true .
  ex:l4-box-extremes-chart-group a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Synthetic observations"@en ; cd:usesDataset ex:l4-large-tail ; cd:authoredResource true .
  ex:l4-box-extremes-chart a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "n=50"@en ; cd:body "n=50. Small points are all observations; the larger separate point is flagged by 1.5 IQR fences, not deleted."@en ; cd:xAxisLabel "Sample"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:hasChartGroup ex:l4-box-extremes-chart-group ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier 1.5 ; cd:showObservations true ; cd:authoredResource true .
  ex:l4-box-extremes-title a cd:Interpretation ; skos:prefLabel "Boxplots: extreme observations are separate points"@en ; cd:authoredResource true .
  ex:l4-box-extremes-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**50 synthetic river concentrations**: one at **90 mg/L**, the other 49 at 0.5–24.5 mg/L."@en ; cd:authoredResource true .
  ex:l4-box-extremes-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "Read the summary (mg/L):\n\n- **Quartiles:** Q₁ 6.625, median 12.75, Q₃ 18.875.\n- **Upper fence:** 37.25.\n- **Upper whisker:** 24.5, not 37.25 or 90."@en ; cd:authoredResource true .
  ex:l4-box-extremes-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "==Flagged does not mean diagnosed.==\n\nBefore interpreting **90 mg/L**, check:\n\n- Sample identity and sampling records.\n- Instrument records."@en ; cd:authoredResource true .
  ex:l4-box-symmetric-chart-group a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Synthetic observations"@en ; cd:usesDataset ex:l4-shapes-normal ; cd:authoredResource true .
  ex:l4-box-symmetric-chart a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "n=100"@en ; cd:body "n=100. Linearly interpolated quartiles and observed whiskers; small points show all responses, large separate points are flagged observations."@en ; cd:xAxisLabel "Sample"@en ; cd:yAxisLabel "Detector response"@en ; cd:yAxisUnit "a.u." ; cd:hasChartGroup ex:l4-box-symmetric-chart-group ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier 1.5 ; cd:showObservations true ; cd:authoredResource true .
  ex:l4-box-symmetric-title a cd:Interpretation ; skos:prefLabel "Boxplots: a roughly symmetric central pattern"@en ; cd:authoredResource true .
  ex:l4-box-symmetric-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**100 synthetic detector responses**; not a fitted population model."@en ; cd:authoredResource true .
  ex:l4-box-symmetric-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "Read the central pattern:\n\n- **Median:** 50 a.u., near the box centre.\n- **Quartiles:** about 43.32 and 56.68 a.u.\n\nComparable halves and whiskers are consistent with **central symmetry**."@en ; cd:authoredResource true .
  ex:l4-box-symmetric-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "==Not a normality test.==\n\nInspect the **small raw points**: they reveal tail detail that the box suppresses."@en ; cd:authoredResource true .
  ex:l4-box-skewed-chart-group a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Synthetic observations"@en ; cd:usesDataset ex:l4-shapes-skewed ; cd:authoredResource true .
  ex:l4-box-skewed-chart a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "n=100"@en ; cd:body "n=100. Linearly interpolated quartiles and observed whiskers; small points show all responses, large separate points are flagged observations."@en ; cd:xAxisLabel "Sample"@en ; cd:yAxisLabel "Detector response"@en ; cd:yAxisUnit "a.u." ; cd:hasChartGroup ex:l4-box-skewed-chart-group ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier 1.5 ; cd:showObservations true ; cd:authoredResource true .
  ex:l4-box-skewed-title a cd:Interpretation ; skos:prefLabel "Boxplots: a longer upper tail"@en ; cd:authoredResource true .
  ex:l4-box-skewed-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**100 synthetic right-skewed responses**, standardized to mean **50** and sample SD **10 a.u.**"@en ; cd:authoredResource true .
  ex:l4-box-skewed-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "Read the asymmetry:\n\n- **Median:** 46.92 a.u.\n- **Quartiles:** about 42.84 and 53.86 a.u.\n\nThe **upper box half and upper tail** are longer."@en ; cd:authoredResource true .
  ex:l4-box-skewed-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "==Large values are not automatically errors.==\n\nThey may be expected **tail observations**. The boxplot suggests asymmetry, but does not identify its cause."@en ; cd:authoredResource true .
  ex:l4-box-bimodal-chart-group a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Synthetic observations"@en ; cd:usesDataset ex:l4-shapes-bimodal ; cd:authoredResource true .
  ex:l4-box-bimodal-chart a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "n=100"@en ; cd:body "n=100. Linearly interpolated quartiles and observed whiskers; small points show all responses, large separate points are flagged observations."@en ; cd:xAxisLabel "Sample"@en ; cd:yAxisLabel "Detector response"@en ; cd:yAxisUnit "a.u." ; cd:hasChartGroup ex:l4-box-bimodal-chart-group ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier 1.5 ; cd:showObservations true ; cd:authoredResource true .
  ex:l4-box-bimodal-title a cd:Interpretation ; skos:prefLabel "Boxplots: two clusters can disappear inside one box"@en ; cd:authoredResource true .
  ex:l4-box-bimodal-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**100 synthetic detector responses** from two constructed clusters."@en ; cd:authoredResource true .
  ex:l4-box-bimodal-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "Read the gap:\n\n- **Median:** 50 a.u., between the clusters.\n- **Quartiles:** Q₁ about 40.22, Q₃ about 59.78 a.u.\n\nThe box spans a **sparsely occupied region**."@en ; cd:authoredResource true .
  ex:l4-box-bimodal-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "==One box can hide two modes.==\n\n- **Raw points** reveal the gap.\n- Check a **histogram** before calling the centre typical."@en ; cd:authoredResource true .
  ex:l4-box-uniform-chart-group a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Synthetic observations"@en ; cd:usesDataset ex:l4-shapes-uniform ; cd:authoredResource true .
  ex:l4-box-uniform-chart a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "n=100"@en ; cd:body "n=100. Linearly interpolated quartiles and observed whiskers; small points show all responses, large separate points are flagged observations."@en ; cd:xAxisLabel "Sample"@en ; cd:yAxisLabel "Detector response"@en ; cd:yAxisUnit "a.u." ; cd:hasChartGroup ex:l4-box-uniform-chart-group ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier 1.5 ; cd:showObservations true ; cd:authoredResource true .
  ex:l4-box-uniform-title a cd:Interpretation ; skos:prefLabel "Boxplots: symmetry does not imply a bell shape"@en ; cd:authoredResource true .
  ex:l4-box-uniform-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**100 evenly spaced synthetic responses**. Mean **50** and sample SD **10 a.u.** match the preceding examples."@en ; cd:authoredResource true .
  ex:l4-box-uniform-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "Read the symmetric box:\n\n- **Median:** 50 a.u.\n- **Quartiles:** about 41.47 and 58.53 a.u.\n\nHere it comes from **nearly flat occupancy**, not a bell-shaped sample."@en ; cd:authoredResource true .
  ex:l4-box-uniform-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "==Similar boxes do not imply similar distributions.==\n\nBoxplots summarize **ranks**. Inspect the observations and binning-based views as well."@en ; cd:authoredResource true .
