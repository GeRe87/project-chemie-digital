  ex:l4-hist-2d-chart-edge-4 rdf:first 3.0 ; rdf:rest ex:l4-hist-2d-chart-edge-5 .
  ex:l4-hist-2d-chart-edge-5 rdf:first 4.0 ; rdf:rest rdf:nil .
