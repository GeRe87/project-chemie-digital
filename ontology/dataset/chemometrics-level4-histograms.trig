  ex:l4-hist-origin-chart a cd:ChartDefinition ; cd:chartType cd:Histogram ; skos:prefLabel "Same 100 responses and width 4 a"@en ; cd:body "Same 100 responses and width 4 a.u., but bin origin shifted from 30 to 32 a.u. Compare the preceding sensible-width plot."@en ; cd:usesDataset ex:l4-shapes-bimodal ; cd:xAxisLabel "Synthetic detector response"@en ; cd:xAxisUnit "a.u." ; cd:yAxisLabel "Observations per bin"@en ; cd:binEdges ex:l4-hist-origin-chart-edge-1 ; cd:histogramNormalization "count" ; cd:authoredResource true .
  ex:l4-histogram-too-coarse-title a cd:Interpretation ; skos:prefLabel "Bin width too large: the structure is averaged away"@en ; cd:authoredResource true .
  ex:l4-histogram-too-coarse-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**One change**\n\nSame two-cluster data; now **one bin from 30 to 70 a.u.**"@en ; cd:authoredResource true .
  ex:l4-histogram-too-coarse-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**What survives?**\n\n- Count: **100**.\n- Gap and two occupied regions: **hidden**."@en ; cd:authoredResource true .
  ex:l4-histogram-too-coarse-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Verdict for this question**\n\n==Too coarse.== A correct count can still be an unhelpful view."@en ; cd:authoredResource true .
  ex:l4-histogram-too-fine-title a cd:Interpretation ; skos:prefLabel "Bin width too small: occupancy becomes fragmented"@en ; cd:authoredResource true .
  ex:l4-histogram-too-fine-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**One change**\n\nSame 100 responses; **400 bins**, width **0.1 a.u.**"@en ; cd:authoredResource true .
  ex:l4-histogram-too-fine-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**What dominates?**\n\n- Most counts: **0 or 1**.\n- Individual gaps and spikes.\n- Not hundreds of demonstrated subpopulations."@en ; cd:authoredResource true .
  ex:l4-histogram-too-fine-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Verdict for this question**\n\nToo little aggregation. ==More bins is not automatically more information.=="@en ; cd:authoredResource true .
  ex:l4-histogram-sensible-width-title a cd:Interpretation ; skos:prefLabel "A useful resolution: compare the same data again"@en ; cd:authoredResource true .
  ex:l4-histogram-sensible-width-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**One change**\n\nSame 100 responses; **ten bins of width 4 a.u.**, spanning 30–70 a.u."@en ; cd:authoredResource true .
  ex:l4-histogram-sensible-width-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**What can we see now?**\n\n- Two occupied regions.\n- A **sparse middle**.\n- Aggregation beyond individual spikes."@en ; cd:authoredResource true .
  ex:l4-histogram-sensible-width-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Still check alternatives**\n\nUseful here, not universally optimal. Compare **neighboring widths** and the instrument's resolution."@en ; cd:authoredResource true .
  ex:l4-histogram-origin-title a cd:Interpretation ; skos:prefLabel "Bin origin matters as well as width"@en ; cd:authoredResource true .
  ex:l4-histogram-origin-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**One change**\n\nWidth stays **4 a.u.**; move the first edge **30 → 32**. All 100 responses remain covered."@en ; cd:authoredResource true .
  ex:l4-histogram-origin-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Watch the boundaries**\n\nSome observations enter different bins and heights change. ==No measured value changed.=="@en ; cd:authoredResource true .
  ex:l4-histogram-origin-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Comparison rule**\n\nTrust features that survive reasonable changes. Compare groups with **common edges and compatible normalization**."@en ; cd:authoredResource true .
  ex:l4-hist-rules-formula-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-hist-rules-formula-symbols ; cd:authoredResource true .
  ex:l4-hist-rules-formula-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Names and symbols"@en ; cd:body "FD = Freedman–Diaconis; Scott = Scott's rule; Sturges = Sturges' rule. h: width; k: bin count; n: observations; s: sample SD. IQR uses linear interpolation."@en ; cd:authoredResource true .
  ex:l4-histogram-rules-title a cd:Interpretation ; skos:prefLabel "Bin rules are starting points"@en ; cd:authoredResource true .
  ex:l4-histogram-rules-intro a cd:Interpretation ; cd:body "Freedman–Diaconis (FD) uses IQR, Scott's rule uses SD, and Sturges' rule suggests a bin count."@en ; cd:authoredResource true .
  ex:l4-histogram-rules-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-histogram-rules-points-1, ex:l4-histogram-rules-points-2 ; cd:authoredResource true .
  ex:l4-histogram-rules-points-1 a cd:KeyPoint ; cd:position 1 ; cd:body "For h>0 start with **ceil((max−min)/h)** bins; convenient-edge rounding can change that count."@en ; cd:authoredResource true .
  ex:l4-histogram-rules-points-2 a cd:KeyPoint ; cd:position 2 ; cd:body "**IQR=0 gives FD width 0.** Handle ties/constant data explicitly; no rule is universally best."@en ; cd:authoredResource true .
  ex:l4-histogram-rule-example-title a cd:Interpretation ; skos:prefLabel "Apply a rule, then inspect neighboring choices"@en ; cd:authoredResource true .
  ex:l4-histogram-rule-example-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Explore the same 100 readings**\n\nSample SD **10**, linearly interpolated IQR **13.35**, observed span **51.59 a.u.** Change width and origin on the right."@en ; cd:authoredResource true .
  ex:l4-histogram-rule-example-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Starting rules**\n\n- **Freedman–Diaconis:** width ≈5.75.\n- **Scott:** width ≈7.54.\n- **Sturges:** 8 bins over the observed span."@en ; cd:authoredResource true .
  ex:l4-histogram-rule-example-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Try it**\n\nChoose a rule, move the sliders, then **Reset bins**. The covering grid may add a boundary bin. ==The count must stay 100.=="@en ; cd:authoredResource true .
  ex:l4-hist-density-formula-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-hist-density-formula-symbols ; cd:authoredResource true .
  ex:l4-hist-density-formula-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Reading the symbols"@en ; cd:body "b: edges; hⱼ: bin width; nⱼ: count; n: total. Density has inverse measurement units; bar area is the sample fraction."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-width-title a cd:Interpretation ; skos:prefLabel "Unequal bins: compare areas"@en ; cd:authoredResource true .
  ex:l4-histogram-variable-width-intro a cd:Interpretation ; cd:body "Equal widths are optional. Adaptive bins can be narrow in dense regions and wide in sparse tails."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-width-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-histogram-variable-width-points-1, ex:l4-histogram-variable-width-points-2 ; cd:authoredResource true .
  ex:l4-histogram-variable-width-points-1 a cd:KeyPoint ; cd:position 1 ; cd:body "Raw count heights would visually reward wide bins. Use **count / (n × bin width)** for relative-frequency density."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-width-points-2 a cd:KeyPoint ; cd:position 2 ; cd:body "The area of each bar is its sample fraction; total area is **1**. Density can exceed 1 without representing a probability above 100%."@en ; cd:authoredResource true .
  ex:l4-hist-adaptive-chart-edge-1 rdf:first 39.930215496246 ; rdf:rest ex:l4-hist-adaptive-chart-edge-2 .
  ex:l4-hist-adaptive-chart-edge-2 rdf:first 42.8350428083665 ; rdf:rest ex:l4-hist-adaptive-chart-edge-3 .
  ex:l4-hist-adaptive-chart-edge-3 rdf:first 46.9193129202395 ; rdf:rest ex:l4-hist-adaptive-chart-edge-4 .
  ex:l4-hist-adaptive-chart-edge-4 rdf:first 53.85876088150624 ; rdf:rest ex:l4-hist-adaptive-chart-edge-5 .
  ex:l4-hist-adaptive-chart-edge-5 rdf:first 93.688205573471 ; rdf:rest rdf:nil .
  ex:l4-hist-adaptive-chart a cd:ChartDefinition ; cd:chartType cd:Histogram ; skos:prefLabel "100 synthetic right-skewed responses"@en ; cd:body "100 synthetic right-skewed responses. Edges are minimum, linearly interpolated quartiles and maximum; each bin contains 25 observations. Unequal-width density heights preserve areas."@en ; cd:usesDataset ex:l4-shapes-skewed ; cd:xAxisLabel "Synthetic detector response"@en ; cd:xAxisUnit "a.u." ; cd:yAxisLabel "Relative-frequency density"@en ; cd:yAxisUnit "1/a.u." ; cd:binEdges ex:l4-hist-adaptive-chart-edge-1 ; cd:histogramNormalization "density" ; cd:authoredResource true .
  ex:l4-histogram-variable-construction-title a cd:Interpretation ; skos:prefLabel "Construct adaptive bins with quantile boundaries"@en ; cd:authoredResource true .
  ex:l4-histogram-variable-construction-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Return to 100 readings**\n\nAfter the worked construction, use min, linearly interpolated Q₁, median, Q₃ and max as adaptive boundaries."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-construction-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Edges and occupancy**\n\n- Edges ≈**39.93, 42.84, 46.92, 53.86, 93.69**.\n- **25 observations per bin**.\n- Different widths, different heights."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-construction-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Area check**\n\n==Each area is 25%.== Height is 0.25/width. Merge repeated quantile edges instead of creating zero-width bins."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-use-title a cd:Interpretation ; skos:prefLabel "Adaptive bins: resolve the bulk without overstating the tail"@en ; cd:authoredResource true .
  ex:l4-histogram-variable-use-intro a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Application**\n\nResolve a dense low-response region while summarizing a sparse long upper tail."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-use-reading-1 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Benefit**\n\n- Narrow bins near the bulk.\n- Fewer almost-empty tail bins.\n- The low last bar still has **25% area**."@en ; cd:authoredResource true .
  ex:l4-histogram-variable-use-reading-2 a cd:Interpretation ; cd:bodyFormat "markdown" ; cd:body "**Trade-off**\n\nWide bins hide tail detail. Disclose edges; use **common edges** for comparisons. Adaptive means data-dependent, not changing per observation."@en ; cd:authoredResource true .
  ex:l4-hist-lab-title a cd:Interpretation ; skos:prefLabel "R lab: change bin width, not the observations"@en ; cd:authoredResource true .
  ex:l4-hist-lab-task a cd:Exercise ; cd:body "Same **100 synthetic two-cluster responses**; only binning changes.\n\n- [!] **Run:** read both axes; inspect bin counts.\n- [!] **Change:** set **bin_width from 4 to 40**. Run again.\n- [?] **Explain:** which structure disappears without changing observations?\n\n==Check: all bin counts still sum to 100.==\n\nMay download ggplot2. Local execution; no learner-data upload."@en ; cd:authoredResource true .
  ex:l4-hist-lab-answer a cd:ExpectedResult ; cd:body "At width 4 the plot has 10 bins spanning 30–70 a.u. and shows two occupied regions; total count is 100. At width 40 one bin contains all 100 observations and hides the gap. No observation was changed or lost. For unequal widths, map y=after_stat(density) and supply explicit breaks; then bar area, not raw count height, represents relative frequency."@en ; cd:authoredResource true .
  ex:l4-hist-lab-task cd:hasExpectedResult ex:l4-hist-lab-answer ; cd:hasCodeExample ex:l4-hist-lab-code .
  ex:l4-hist-lab-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:histogram, ex:l4-shapes-bimodal ; cd:code "if (!requireNamespace(\"ggplot2\", quietly = TRUE)) {\n  if (requireNamespace(\"webr\", quietly = TRUE)) webr::install(\"ggplot2\")\n  else stop(\"Install ggplot2 first\")\n}\nlibrary(ggplot2)\nx <- c(\n  36.203861904595, 36.968344965996, 37.373171342811, 37.663249348955, 37.894944427129, 38.090935235275, 38.262750520860, 38.417100222768, 38.558256085355, 38.689118543731,\n  38.811755599904, 38.927699911254, 39.038123973652, 39.143949102676, 39.245916271163, 39.344633882841, 39.440611031230, 39.534281313527, 39.626020324213, 39.716158820762,\n  39.804992871389, 39.892791871197, 39.979805043931, 40.066266872452, 40.152401787581, 40.238428371541, 40.324563286669, 40.411025115191, 40.498038287925, 40.585837287733,\n  40.674671338359, 40.764809834908, 40.856548845594, 40.950219127892, 41.046196276280, 41.144913887958, 41.246881056446, 41.352706185469, 41.463130247867, 41.579074559217,\n  41.701711615390, 41.832574073766, 41.973729936353, 42.128079638261, 42.299894923847, 42.495885731992, 42.727580810167, 43.017658816310, 43.422485193125, 44.186968254526,\n  55.813031745474, 56.577514806875, 56.982341183690, 57.272419189833, 57.504114268008, 57.700105076153, 57.871920361739, 58.026270063647, 58.167425926234, 58.298288384610,\n  58.420925440783, 58.536869752133, 58.647293814531, 58.753118943554, 58.855086112042, 58.953803723720, 59.049780872108, 59.143451154406, 59.235190165092, 59.325328661641,\n  59.414162712267, 59.501961712075, 59.588974884809, 59.675436713331, 59.761571628459, 59.847598212419, 59.933733127548, 60.020194956069, 60.107208128803, 60.195007128611,\n  60.283841179238, 60.373979675787, 60.465718686473, 60.559388968770, 60.655366117159, 60.754083728837, 60.856050897324, 60.961876026348, 61.072300088746, 61.188244400096,\n  61.310881456269, 61.441743914645, 61.582899777232, 61.737249479140, 61.909064764725, 62.105055572871, 62.336750651045, 62.626828657189, 63.031655034004, 63.796138095405\n)\nbin_width <- 4\np <- ggplot(data.frame(x), aes(x)) +\n  geom_histogram(breaks = seq(30, 70, by = bin_width), closed = \"left\") +\n  labs(x = \"Synthetic detector response (a.u.)\", y = \"Count\") +\n  theme_minimal(base_size = 16)\nprint(p)\nb <- ggplot_build(p)$data[[1]]\nb[c(\"xmin\", \"xmax\", \"count\", \"density\")]\nsum(b$count)" ; dct:hasPart ex:l4-hist-lab-functions ; cd:authoredResource true .
  ex:l4-hist-lab-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-hist-lab-f1, ex:l4-hist-lab-f2 ; cd:authoredResource true .
  ex:l4-hist-lab-f1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "geom_histogram(breaks=..., closed=\"left\")"@en ; cd:body "Specify numeric edges and the interval closure explicitly; do not silently discard observations outside the edges."@en ; cd:authoredResource true .
  ex:l4-hist-lab-f2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "ggplot_build(p)$data[[1]]"@en ; cd:body "Inspect xmin/xmax, count and density; verify sum(count)=length(x)."@en ; cd:authoredResource true .
}
