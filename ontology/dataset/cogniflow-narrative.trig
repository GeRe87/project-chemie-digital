@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-narrative> {
  ex:cogniflow-coupling-problem a cd:Concept ;
    skos:prefLabel "A Common Analytical Workflow"@en ;
    cd:hasDefinition ex:def-cogniflow-coupling-problem ;
    cd:authoredResource true .

  ex:def-cogniflow-coupling-problem a cd:Definition ;
    cd:body "A typical analytical workflow moves from instrument analysis through measured data and an open format to reusable results."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-common-workflow a cd:FlowDiagram ;
    skos:prefLabel "Common workflow from analysis to results"@en ;
    cd:body "Vendor software produces measured data, which is converted into the open mzML format, and a custom script turns that into reusable results."@en ;
    cd:hasDiagramNode ex:node-cogniflow-common-analysis,
      ex:node-cogniflow-common-meas-data,
      ex:node-cogniflow-common-open-format,
      ex:node-cogniflow-common-results ;
    cd:hasDiagramEdge ex:edge-cogniflow-common-analysis-meas,
      ex:edge-cogniflow-common-meas-open,
      ex:edge-cogniflow-common-open-results ;
    cd:focusNode ex:node-cogniflow-common-open-format ;
    cd:authoredResource true .

  ex:node-cogniflow-common-analysis a cd:DiagramNode ; skos:prefLabel "Analysis"@en ; cd:position 1 ; cd:authoredResource true .
  ex:node-cogniflow-common-meas-data a cd:DiagramNode ; skos:prefLabel "meas Data"@en ; cd:position 2 ; cd:authoredResource true .
  ex:node-cogniflow-common-open-format a cd:DiagramNode ; skos:prefLabel "meas Data Open Format"@en ; cd:position 3 ; cd:authoredResource true .
  ex:node-cogniflow-common-results a cd:DiagramNode ; skos:prefLabel "results"@en ; cd:position 4 ; cd:authoredResource true .

  ex:edge-cogniflow-common-analysis-meas a cd:DiagramEdge ; skos:prefLabel "vendor Software"@en ; cd:position 1 ; cd:sourceNode ex:node-cogniflow-common-analysis ; cd:targetNode ex:node-cogniflow-common-meas-data ; cd:authoredResource true .
  ex:edge-cogniflow-common-meas-open a cd:DiagramEdge ; skos:prefLabel "mzML"@en ; cd:position 2 ; cd:sourceNode ex:node-cogniflow-common-meas-data ; cd:targetNode ex:node-cogniflow-common-open-format ; cd:authoredResource true .
  ex:edge-cogniflow-common-open-results a cd:DiagramEdge ; skos:prefLabel "custom Script"@en ; cd:position 3 ; cd:sourceNode ex:node-cogniflow-common-open-format ; cd:targetNode ex:node-cogniflow-common-results ; cd:authoredResource true .

  ex:cogniflow-take-home a cd:Concept ;
    skos:prefLabel "Take-Home"@en ;
    cd:hasDefinition ex:def-cogniflow-take-home ;
    cd:authoredResource true .

  ex:def-cogniflow-take-home a cd:Definition ;
    cd:body "Standardize the contract, not the implementation."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-decoupled,
      ex:keypoint-cogniflow-semantic,
      ex:keypoint-cogniflow-reproducible ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-decoupled a cd:KeyPoint ; cd:position 1 ; cd:body "DECOUPLED."@en ; cd:authoredResource true .
  ex:keypoint-cogniflow-semantic a cd:KeyPoint ; cd:position 2 ; cd:body "SEMANTIC."@en ; cd:authoredResource true .
  ex:keypoint-cogniflow-reproducible a cd:KeyPoint ; cd:position 3 ; cd:body "REPRODUCIBLE."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-narrative-extension> {
  ex:path-step-cogniflow-coupling-problem a cd:PathStep ;
    cd:position 2 ;
    cd:usesResource ex:diagram-cogniflow-common-workflow ;
    cd:usesScene ex:scene-cogniflow-coupling-problem ;
    cd:authoredResource true .

  ex:path-step-cogniflow-take-home a cd:PathStep ;
    cd:position 8 ;
    cd:usesResource ex:def-cogniflow-take-home ;
    cd:usesScene ex:scene-cogniflow-take-home ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-narrative> {
  ex:scene-cogniflow-coupling-problem a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-coupling-problem ;
    cd:hasSceneItem ex:scene-item-cogniflow-problem-heading,
      ex:scene-item-cogniflow-problem-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-problem-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:cogniflow-coupling-problem ; cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .

  ex:scene-item-cogniflow-problem-diagram a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:diagram-cogniflow-common-workflow ; cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .

  ex:scene-cogniflow-take-home a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-take-home ;
    cd:hasSceneItem ex:scene-item-cogniflow-take-home-heading,
      ex:scene-item-cogniflow-take-home-points,
      ex:scene-item-cogniflow-take-home-statement ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-heading a cd:SceneItem ;
    cd:position 1 ; cd:selectsResource ex:cogniflow-take-home ; cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-points a cd:SceneItem ;
    cd:position 2 ; cd:selectsResource ex:def-cogniflow-take-home ; cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-statement a cd:SceneItem ;
    cd:position 3 ; cd:selectsResource ex:def-cogniflow-take-home ; cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
}
