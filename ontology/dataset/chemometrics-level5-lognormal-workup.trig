  ex:lg-saved-chart a cd:ChartDefinition ; skos:prefLabel "One thousand simulated complete preparations"@en ; cd:body "Positive relative factors, fixed teaching protocol. Counts are not validation data or a fitted distribution. The saved realization has 100 of 1,000 results above 15 ng/L; finite frequency is not the exact model probability."@en ; cd:chartType cd:Histogram ; cd:usesDataset ex:lg-count-data ; cd:binEdges ex:lg-be0 ; cd:histogramNormalization "density" ; cd:xAxisLabel "Full-preparation result"@en ; cd:xAxisUnit "ng/L" ; cd:yAxisLabel "Simulated density"@en ; cd:yAxisUnit "L/ng" ; cd:authoredResource true .
