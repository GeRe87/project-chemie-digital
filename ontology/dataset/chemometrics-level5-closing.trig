@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/level5-closing> {
  ex:l5-e18a-title a cd:Interpretation ; skos:prefLabel "Report an estimate with its scope and uncertainty"@en ; cd:authoredResource true .
  ex:l5-e18b-title a cd:Interpretation ; skos:prefLabel "Do not turn a laboratory interval into a water claim"@en ; cd:authoredResource true .
  ex:l5-e18a-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-e18a-binary, ex:l5-e18a-counts, ex:l5-e18a-continuous, ex:l5-e18a-statistics ; cd:authoredResource true .
  ex:l5-e18a-binary a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Target and scope"@en ; cd:body "Volume-weighted mean nitrate concentration in the defined water body at the fixed survey time."@en ; cd:authoredResource true .
  ex:l5-e18a-counts a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Selection model"@en ; cd:body "Four independent, equal-chance draws of equal-volume units. Analytical error is isolated out in this simulation."@en ; cd:authoredResource true .
  ex:l5-e18a-continuous a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Simulated estimate: 5.18 mg/L"@en ; cd:body "Our sample mean estimates the target. The benchmark mean 10 mg/L is known only because this is a simulation."@en ; cd:authoredResource true .
  ex:l5-e18a-statistics a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Model sampling SD: 4.5 mg/L"@en ; cd:body "At size four, this describes estimator variation. It is not a confidence interval or total measurement uncertainty."@en ; cd:authoredResource true .
  ex:l5-e18b-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-e18b-data, ex:l5-e18b-sampling, ex:l5-e18b-model, ex:l5-e18b-decision ; cd:authoredResource true .
  ex:l5-e18b-data a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "The separate laboratory example"@en ; cd:body "Five repeats: mean 10.0, sample SD 0.316 mg/L. Its comparison with 9.5 mg/L concerns the analytical mean."@en ; cd:authoredResource true .
  ex:l5-e18b-sampling a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "One sample is not the water body"@en ; cd:body "Laboratory independence cannot establish representative selection of environmental samples, locations or depths."@en ; cd:authoredResource true .
  ex:l5-e18b-model a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "A conditional analytical interval"@en ; cd:body "The t interval assumes iid normal lab results. It does not include environmental sampling variation or systematic bias."@en ; cd:authoredResource true .
  ex:l5-e18b-decision a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "A complete investigation report"@en ; cd:body "State target, selection, estimate and uncertainty. Model checks do not certify representativeness; formal tests need a prespecified error rate."@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:hasStep ex:l5-e18a-step, ex:l5-e18b-step .
  ex:l5-e18a-step a cd:PathStep ; cd:position 69 ; cd:usesScene ex:l5-e18a-scene ; cd:usesResource ex:l5-e18a-title, ex:l5-e18a-cards ; cd:authoredResource true .
  ex:l5-e18b-step a cd:PathStep ; cd:position 70 ; cd:usesScene ex:l5-e18b-scene ; cd:usesResource ex:l5-e18b-title, ex:l5-e18b-cards ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-closing> {
  ex:l5-e18a-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; cd:hasSceneItem ex:l5-e18a-heading, ex:l5-e18a-list ; cd:narration "Return to the investigation rather than a catalogue of distributions. In the environmental sampling simulation, the target is the volume-weighted mean nitrate concentration at a fixed survey time in a defined water body. Four independent equal-chance draws of equal-volume units give our estimate 5.181410018887113 mg/L, about 5.18. The true model mean 10 mg/L is known only as a simulation benchmark. Population SD 9 mg/L gives a model sampling SD of the four-unit mean of 4.5 mg/L, as shown in C14. This is not an estimated confidence interval from four values or full environmental measurement uncertainty. No exact t interval is justified for this four-value lognormal sample. The simulation isolates sampling variation and assumes analytical error negligible; an actual investigation must justify its design, selection weights, dependence, analytical contributions and uncertainty method. Binomial concerns a fixed number of independent binary trials and positive-finding frequency; Poisson concerns counts in a defined exposure and detected intensity. Normal/lognormal describe different variation mechanisms; positivity and skewness alone do not establish lognormality. Means, variances and ratios have their own sampling distributions. The CLT concerns standardized means, not individual values becoming normal. Exact chi-square, Student-t and F results retain their normal-sampling conditions. Checking model fit remains a separate topic from validating the selection design: neither KS nor Pearson proves model truth, representativeness or accuracy. Our report must state the estimate, its target and the uncertainty actually covered."@en ; cd:authoredResource true .
  ex:l5-e18b-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-standard-error ; cd:hasSceneItem ex:l5-e18b-heading, ex:l5-e18b-list ; cd:narration "Keep the separate laboratory example in its proper scope. The five constructed nitrate laboratory repeats have mean 10.0 mg/L and sample SD about 0.316 mg/L. For a reference of 9.5 mg/L, the earlier iid-normal analytical t interval has endpoints about 9.60735 and 10.39265 mg/L; 9.5 is outside that conditional interval. This is not evidence that real measurements satisfy its assumptions, and it is not an interval for the water-body mean. It excludes environmental selection variation and systematic bias, and without bias control does not automatically cover the true concentration of the collected sample. A reference value may itself have uncertainty. The environmental estimate and this analytical example answer different questions and must not be combined as if they were one dataset. A complete field report specifies spatial/time scope, sampling design, estimate and justified uncertainty contributions. A small SE, a model-fit result or many laboratory repeats cannot establish representativeness. For a formal hypothesis test, prespecify target, reference, direction and error rate. Do not select the direction after seeing the result. The next session develops tests for means and variances. No additional test decision, p value or real monitoring claim is introduced here."@en ; cd:authoredResource true .
  ex:l5-e18a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-e18a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-e18a-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-e18a-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-e18b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-e18b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-e18b-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-e18b-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
}
