@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/specifications/level5-lecture-stages> {
  # Direct explanations. A single snapshot is a complete slide, not an interaction.
  ex:l5-b01-model cd:hasBinaryStage ex:l5-b01-s0 .
  ex:l5-b01-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 3 ; cd:body "Selected samples inform the population finding frequency. Each Bernoulli trial has two outcomes."@en ; cd:authoredResource true .

  ex:l5-b02-model cd:hasBinaryStage ex:l5-b02-s0, ex:l5-b02-s1, ex:l5-b02-s2 .
  ex:l5-b02-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 2 ; cd:binarySeriesRun 1 ; cd:body "One simulated survey gives one count. Different surveys can estimate different positive fractions."@en ; cd:authoredResource true .
  ex:l5-b02-s1 a cd:BinaryExperimentStage ; cd:position 2 ; cd:binaryRevealLevel 2 ; cd:binarySeriesRun 2 ; cd:body "A second independent series under unchanged assumptions produces another count."@en ; cd:authoredResource true .
  ex:l5-b02-s2 a cd:BinaryExperimentStage ; cd:position 3 ; cd:binaryRevealLevel 2 ; cd:binarySeriesRun 3 ; cd:body "Zero positives is possible even with a 20% per-sample positive probability."@en ; cd:authoredResource true .

  ex:l5-b03a-model cd:hasBinaryStage ex:l5-b03a-s0 .
  ex:l5-b03a-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 2 ; cd:body "Independence allows multiplication. This gives the probability of this one specified order."@en ; cd:authoredResource true .

  ex:l5-b03b-model cd:hasBinaryStage ex:l5-b03b-s0 .
  ex:l5-b03b-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 2 ; cd:body "Exactly two positives includes all 45 equally likely arrangements, not just one sequence."@en ; cd:authoredResource true .

  ex:l5-b04-model cd:hasBinaryStage ex:l5-b04-s0, ex:l5-b04-s1, ex:l5-b04-s2 .
  ex:l5-b04-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 1 ; cd:body "The model determines the centre and spread across repeated series, not a guaranteed result."@en ; cd:authoredResource true .
  ex:l5-b04-s1 a cd:BinaryExperimentStage ; cd:position 2 ; cd:binaryRevealLevel 1 ; cd:binaryStagePositiveProbability 0.5 ; cd:body "At 50%, positive and negative results are equally likely and the count distribution is symmetric."@en ; cd:authoredResource true .
  ex:l5-b04-s2 a cd:BinaryExperimentStage ; cd:position 3 ; cd:binaryRevealLevel 1 ; cd:binaryStageTrialCount 100 ; cd:body "At 20% with one hundred trials, absolute count variance grows; relative-frequency variance decreases."@en ; cd:authoredResource true .

  ex:l5-b05-model cd:hasBinaryStage ex:l5-b05-s0 .
  ex:l5-b05-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 1 ; cd:body "Zero findings leave the population frequency uncertain. The model probability is not a probability that absence is true."@en ; cd:authoredResource true .

  ex:l5-b06-model cd:hasBinaryStage ex:l5-b06-s0, ex:l5-b06-s1, ex:l5-b06-s2 .
  ex:l5-b06-s0 a cd:BinaryExperimentStage ; cd:position 1 ; cd:binaryRevealLevel 1 ; cd:binaryCaseIndex 0 ; cd:body "Independent samples from a defined population can support a binomial model."@en ; cd:authoredResource true .
  ex:l5-b06-s1 a cd:BinaryExperimentStage ; cd:position 2 ; cd:binaryRevealLevel 1 ; cd:binaryCaseIndex 1 ; cd:body "Technical repetitions do not become independent environmental samples."@en ; cd:authoredResource true .
  ex:l5-b06-s2 a cd:BinaryExperimentStage ; cd:position 3 ; cd:binaryRevealLevel 1 ; cd:binaryCaseIndex 2 ; cd:body "Unequal event probabilities violate the simple binomial model."@en ; cd:authoredResource true .
}
