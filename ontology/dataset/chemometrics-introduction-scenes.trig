@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-introduction> {
  # Slide 1 — hero title ------------------------------------------------------
  ex:scene-chemometrics-introduction-title a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-title ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-title-heading ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-title-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-title ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  # Slide 2 — centered definition with citation -----------------------------
  ex:scene-chemometrics-introduction-definition a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-definition ;
    cd:presentationPattern cd:DefinitionWithCitation ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-definition-heading,
      ex:scene-item-chemometrics-introduction-definition-body,
      ex:scene-item-chemometrics-introduction-definition-citation ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-definition-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-definition ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-definition-body a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:def-chemometrics-definition ;
    cd:communicativeRole cd:QuotationRole ;
    cd:selectionPath "cd:hasDefinition" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-definition-citation a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:source-iupac-goldbook-chemometrics ;
    cd:communicativeRole cd:CitationRole ;
    cd:selectionPath "cd:hasDefinition/cd:hasSource" ;
    cd:authoredResource true .

  # Slide 3 — analytical case study -----------------------------------------
  ex:scene-chemometrics-introduction-overview a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-overview ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-overview-heading,
      ex:scene-item-chemometrics-introduction-overview-problem,
      ex:scene-item-chemometrics-introduction-overview-table,
      ex:scene-item-chemometrics-introduction-overview-chart,
      ex:scene-item-chemometrics-introduction-overview-discussion ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-overview ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-problem a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:chemometrics-nitrate-case-problem ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-table a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:table-chemometrics-nitrate-replicates ;
    cd:communicativeRole cd:TableRole ;
    cd:selectionPath "cd:hasTableRow" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-chart a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:chart-chemometrics-nitrate-means ;
    cd:communicativeRole cd:ChartRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-discussion a cd:SceneItem ;
    cd:position 5 ;
    cd:selectsResource ex:chemometrics-nitrate-case-discussion ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .


  # Slide 4 — concept-specification ------------------------------------------
  ex:scene-chemometrics-introduction-lecturer a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-lecturer-context ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-lecturer-heading,
      ex:scene-item-chemometrics-introduction-lecturer-profile,
      ex:scene-item-chemometrics-introduction-lecturer-takeaway ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-lecturer-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-lecturer-context ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-lecturer-profile a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:chemometrics-lecturer-profile ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-lecturer-takeaway a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:chemometrics-lecturer-takeaway ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  # Slide 5 — paired-info-cards --------------------------------------------
  ex:scene-chemometrics-introduction-format a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-format ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-format-heading,
      ex:scene-item-chemometrics-introduction-format-banner,
      ex:scene-item-chemometrics-introduction-format-sessions ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-format-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-format ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-format-banner a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:chemometrics-course-format-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-format-sessions a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:chemometrics-course-format-sessions ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:language "en" ;
    cd:authoredResource true .

  # Slide 5 — diagram-stage --------------------------------------------------
  ex:scene-chemometrics-introduction-roadmap a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-roadmap ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-roadmap-heading,
      ex:scene-item-chemometrics-introduction-roadmap-diagram ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-roadmap-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-roadmap ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-roadmap-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-chemometrics-course-roadmap ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  # Slide 7 — prompt-card-grid ----------------------------------------------
  ex:scene-chemometrics-introduction-round a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-introduction-round ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-round-heading,
      ex:scene-item-chemometrics-introduction-round-prompts ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-round-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-introduction-round ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-round-prompts a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:chemometrics-introduction-round-prompts ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:language "en" ;
    cd:authoredResource true .
}
