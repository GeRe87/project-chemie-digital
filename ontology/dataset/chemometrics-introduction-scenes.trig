    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-problem a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:chemometrics-nitrate-case-problem ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-table a cd:SceneItem ;
