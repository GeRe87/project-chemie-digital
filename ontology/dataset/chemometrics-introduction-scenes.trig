@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .

<https://w3id.org/project-chemie-digital/graph/scenes/chemometrics-introduction> {
  # Slide 1 — hero title ------------------------------------------------------
  ex:scene-chemometrics-introduction-title a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-title ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-title-heading ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-title-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-title ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  # Slide 2 — analytical case study -----------------------------------------
  ex:scene-chemometrics-introduction-overview a cd:SceneDefinition ;
    cd:focusConcept ex:chemometrics-course-overview ;
    cd:hasSceneItem ex:scene-item-chemometrics-introduction-overview-heading,
      ex:scene-item-chemometrics-introduction-overview-problem,
      ex:scene-item-chemometrics-introduction-overview-table,
      ex:scene-item-chemometrics-introduction-overview-chart,
      ex:scene-item-chemometrics-introduction-overview-discussion,
      ex:scene-item-chemometrics-introduction-overview-takeaway ;
    cd:authoredResource true .

  ex:scene-item-chemometrics-introduction-overview-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:chemometrics-course-overview ;
