@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/sources/distribution-functions> {
  ex:l5-source-r-distributions a cd:Source ; dct:title "R stats: Distributions" ; dct:creator "R Core Team" ; dct:identifier "l5-source-r-distributions" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Distributions.html> ; cd:supportsResource ex:l5-pmf-definition, ex:l5-cdf-definition, ex:l5-pdf-definition, ex:l5-quantile-definition ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/knowledge/distribution-functions> {
  ex:probability-mass-function a cd:Concept ; skos:prefLabel "Probability mass function"@en ; cd:hasDefinition ex:l5-pmf-definition ; cd:authoredResource true .
  ex:cumulative-distribution-function a cd:Concept ; skos:prefLabel "Cumulative distribution function"@en ; cd:hasDefinition ex:l5-cdf-definition ; cd:authoredResource true .
  ex:probability-density-function a cd:Concept ; skos:prefLabel "Probability density function"@en ; cd:hasDefinition ex:l5-pdf-definition ; cd:authoredResource true .
  ex:theoretical-quantile a cd:Concept ; skos:prefLabel "Theoretical quantile"@en ; cd:hasDefinition ex:l5-quantile-definition ; cd:authoredResource true .
  ex:l5-pmf-definition a cd:Definition ; cd:body "A probability mass function assigns a probability to each possible discrete value. Its nonnegative masses sum to one over the complete support. For the preceding binomial and Poisson models, a bar height is the probability of exactly one integer count, not a density."@en ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-cdf-definition a cd:Definition ; cd:body "The cumulative distribution function gives the probability that a random result is at most a specified real threshold. It is nondecreasing and right-continuous, with limits zero and one. Discrete masses produce jumps. A theoretical model CDF is not an empirical CDF calculated from observations."@en ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-pdf-definition a cd:Definition ; cd:body "A continuous density is nonnegative and integrates to one. Interval probabilities are areas under it, whereas an exact single real value has probability zero. Density has reciprocal measurement units and its numerical height may exceed one. Rounding to a measurement resolution represents an interval, not a mathematical point."@en ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-quantile-definition a cd:Definition ; cd:body "For a probability strictly between zero and one, the theoretical quantile is the infimum of all real thresholds where the model CDF reaches or exceeds that probability. At a jump the CDF at the quantile can exceed the requested probability. This generalized inverse is not a particular empirical sample-quantile interpolation algorithm."@en ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .

  ex:l5-d08a-formula a cd:MathExpression ; cd:formulaLabel "Probability mass function (PMF)"@en ; cd:body "Exactly two positives has probability 0.301989888. Summing all binomial count probabilities from zero to ten gives one."@en ; cd:latex "\\begin{gathered}P(K=2)=0.301989888\\\\\\sum_{k=0}^{10}P(K=k)=1\\end{gathered}" ; dct:hasPart ex:l5-d08a-legend ; cd:hasSymbol ex:l5-da-count, ex:l5-da-prob, ex:l5-da-sum ; cd:hasSource ex:l5-source-r-binomial, ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-d08a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-da-entry ; cd:authoredResource true .
  ex:l5-da-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-da-count, ex:l5-da-prob, ex:l5-da-sum ; cd:authoredResource true .
  ex:l5-da-count a cd:MathSymbol ; cd:symbol "K, k" ; cd:mathNotation "K,\\ k" ; cd:body "K: random positive count in ten trials. k: a chosen integer from 0 to 10; 2 selects exactly two positives."@en ; cd:authoredResource true .
  ex:l5-da-prob a cd:MathSymbol ; cd:symbol "P and equality" ; cd:mathNotation "P(K=k)" ; cd:body "Dimensionless probability of the event inside parentheses. Inner equality defines that event; outer equalities state probabilities and normalization."@en ; cd:authoredResource true .
  ex:l5-da-sum a cd:MathSymbol ; cd:symbol "sum and support" ; cd:mathNotation "\\sum_{k=0}^{10}" ; cd:body "Add every integer-count probability from k = 0 through 10, including both endpoints. The total 1 is 100% probability."@en ; cd:authoredResource true .

  ex:l5-d08b-formula a cd:MathExpression ; cd:formulaLabel "CDF: accumulate all counts up to a threshold"@en ; cd:body "F of x is the probability that K is at most x. At threshold two, add the probabilities of zero, one and two positives."@en ; cd:latex "\\begin{gathered}F(x)=P(K\\le x)\\\\F(2)=\\sum_{k=0}^{2}P(K=k)=0.6777995264\\end{gathered}" ; dct:hasPart ex:l5-d08b-legend ; cd:hasSymbol ex:l5-db-function, ex:l5-db-count, ex:l5-db-operators, ex:l5-db-sum ; cd:hasSource ex:l5-source-r-distributions, ex:l5-source-r-binomial ; cd:authoredResource true .
  ex:l5-d08b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-db-entry ; cd:authoredResource true .
  ex:l5-db-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-db-function, ex:l5-db-count, ex:l5-db-operators, ex:l5-db-sum ; cd:authoredResource true .
  ex:l5-db-function a cd:MathSymbol ; cd:symbol "F, x" ; cd:mathNotation "F(x)" ; cd:body "Model CDF at real count threshold x. Its dimensionless value lies between 0 and 1; it stays constant between integer counts."@en ; cd:authoredResource true .
  ex:l5-db-count a cd:MathSymbol ; cd:symbol "K, k" ; cd:mathNotation "K,\\ k" ; cd:body "Random positive count and chosen integer count in ten independent trials, each with 20% positive probability."@en ; cd:authoredResource true .
  ex:l5-db-operators a cd:MathSymbol ; cd:symbol "P, comparison and equality" ; cd:mathNotation "P(K\\le x)" ; cd:body "P denotes probability; less than or equal includes the threshold. Equality inside an event selects a count; outer equalities give identities."@en ; cd:authoredResource true .
  ex:l5-db-sum a cd:MathSymbol ; cd:symbol "sum to two" ; cd:mathNotation "\\sum_{k=0}^{2}" ; cd:body "Add masses at 0, 1 and 2, including endpoints. This is cumulative probability, not the single mass at 2."@en ; cd:authoredResource true .

  ex:l5-d08c-formula a cd:MathExpression ; cd:formulaLabel "Probability density function (PDF)"@en ; cd:body "Interval probability is the integral of density between the bounds. An exact point has probability zero; the total density area is one."@en ; cd:latex "\\begin{gathered}P(a\\le X\\le b)=\\int_a^b f(x)\\,dx\\\\P(X=x)=0,\\quad\\int_{-\\infty}^{\\infty}f(x)\\,dx=1\\end{gathered}" ; dct:hasPart ex:l5-d08c-legend ; cd:hasSymbol ex:l5-dc-variable, ex:l5-dc-bounds, ex:l5-dc-density, ex:l5-dc-integral ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-d08c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-dc-entry ; cd:authoredResource true .
  ex:l5-dc-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and conventions"@en ; dct:references ex:l5-dc-variable, ex:l5-dc-bounds, ex:l5-dc-density, ex:l5-dc-integral ; cd:authoredResource true .
  ex:l5-dc-variable a cd:MathSymbol ; cd:symbol "X, x" ; cd:mathNotation "X,\\ x" ; cd:body "Random nitrate concentration estimate and a real concentration value, expressed numerically in mg/L. Exact points have zero probability in this continuous model."@en ; cd:authoredResource true .
  ex:l5-dc-bounds a cd:MathSymbol ; cd:symbol "a, b and comparison" ; cd:mathNotation "a,\\ b,\\ \\le" ; cd:body "Lower and upper bounds: 9.75 and 10.25 mg/L. Less than or equal includes endpoints; their individual probabilities are zero."@en ; cd:authoredResource true .
  ex:l5-dc-density a cd:MathSymbol ; cd:symbol "f" ; cd:mathNotation "f(x)" ; cd:body "Nonnegative density in L/mg, not a point probability. Height may exceed 1; area over all concentrations is 1."@en ; cd:authoredResource true .
  ex:l5-dc-integral a cd:MathSymbol ; cd:symbol "probability and integration" ; cd:mathNotation "P,\\ \\int,\\ dx,\\ -\\infty,\\ \\infty" ; cd:body "P: dimensionless probability. Integrate density times dx (mg/L). Infinite bounds cover the real line; equalities state identities. Zero is point probability, one the total."@en ; cd:authoredResource true .

  ex:l5-d08d-formula a cd:MathExpression ; cd:formulaLabel "The CDF difference gives interval probability"@en ; cd:body "For this continuous model, subtract the lower-bound CDF from the upper-bound CDF: 0.875 minus 0.125 equals 0.75."@en ; cd:latex "\\begin{gathered}F(x)=P(X\\le x)\\\\P(a\\le X\\le b)=F(b)-F(a)=0.75\\end{gathered}" ; dct:hasPart ex:l5-d08d-legend ; cd:hasSymbol ex:l5-dd-function, ex:l5-dd-bounds, ex:l5-dd-prob, ex:l5-dd-subtract ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-d08d-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-dd-entry ; cd:authoredResource true .
  ex:l5-dd-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-dd-function, ex:l5-dd-bounds, ex:l5-dd-prob, ex:l5-dd-subtract ; cd:authoredResource true .
  ex:l5-dd-function a cd:MathSymbol ; cd:symbol "F, x" ; cd:mathNotation "F(x)" ; cd:body "Dimensionless cumulative probability up to concentration threshold x in mg/L. This is a theoretical CDF, not an ECDF of measured samples."@en ; cd:authoredResource true .
  ex:l5-dd-bounds a cd:MathSymbol ; cd:symbol "X, a, b" ; cd:mathNotation "X,\\ a,\\ b" ; cd:body "X is the random concentration estimate. Bounds a = 9.75 and b = 10.25 mg/L match the density-area example."@en ; cd:authoredResource true .
  ex:l5-dd-prob a cd:MathSymbol ; cd:symbol "P, comparison and equality" ; cd:mathNotation "P(a\\le X\\le b)" ; cd:body "Dimensionless interval probability. Comparisons include endpoints; equalities give identities. This continuous model has zero endpoint masses."@en ; cd:authoredResource true .
  ex:l5-dd-subtract a cd:MathSymbol ; cd:symbol "CDF subtraction" ; cd:mathNotation "F(b)-F(a)" ; cd:body "Subtract cumulative probabilities: 0.875 minus 0.125 gives 0.75, or 75%. Do not subtract density heights."@en ; cd:authoredResource true .

  ex:l5-d08e-formula a cd:MathExpression ; cd:formulaLabel "Quantile: the first threshold reaching the probability"@en ; cd:body "The theoretical q quantile is the infimum of thresholds where F reaches q. In this binomial model the median is two, even though F of two exceeds one half."@en ; cd:latex "\\begin{gathered}Q(q)=\\inf\\{x:F(x)\\ge q\\}\\\\Q(0.5)=2,\\quad F(2)=0.6777995264\\end{gathered}" ; dct:hasPart ex:l5-d08e-legend ; cd:hasSymbol ex:l5-de-quantile, ex:l5-de-function, ex:l5-de-infimum, ex:l5-de-operators ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-d08e-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-de-entry ; cd:authoredResource true .
  ex:l5-de-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and conventions"@en ; dct:references ex:l5-de-quantile, ex:l5-de-function, ex:l5-de-infimum, ex:l5-de-operators ; cd:authoredResource true .
  ex:l5-de-quantile a cd:MathSymbol ; cd:symbol "Q, q" ; cd:mathNotation "Q(q)" ; cd:body "Theoretical model quantile at dimensionless probability 0 < q < 1. Here q = 0.5 selects the median; Q is a count, not a probability."@en ; cd:authoredResource true .
  ex:l5-de-function a cd:MathSymbol ; cd:symbol "F, x" ; cd:mathNotation "F(x)" ; cd:body "Binomial CDF at a real count threshold x. At 2 it reaches about 0.6778; at 1 it is about 0.3758."@en ; cd:authoredResource true .
  ex:l5-de-infimum a cd:MathSymbol ; cd:symbol "infimum and set" ; cd:mathNotation "\\inf\\{x:\\ldots\\}" ; cd:body "Greatest lower bound of the set of all real thresholds satisfying the condition after the colon. This is not sample-quantile interpolation."@en ; cd:authoredResource true .
  ex:l5-de-operators a cd:MathSymbol ; cd:symbol "comparison and equality" ; cd:mathNotation "\\ge,\\ =" ; cd:body "Greater than or equal allows a jump to exceed q. Equalities state the quantile and CDF values; F at a discrete quantile need not equal q."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-distribution-functions> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:probability-mass-function, ex:cumulative-distribution-function, ex:probability-density-function, ex:theoretical-quantile .
  ex:l5-d08a-title a cd:Interpretation ; skos:prefLabel "Tool: probabilities of sample counts"@en ; cd:authoredResource true .
  ex:l5-d08b-title a cd:Interpretation ; skos:prefLabel "Tool: accumulate count probabilities"@en ; cd:authoredResource true .
  ex:l5-d08c-title a cd:Interpretation ; skos:prefLabel "Tool: density for continuous quantities"@en ; cd:authoredResource true .
  ex:l5-d08d-title a cd:Interpretation ; skos:prefLabel "A probability range is not a mean interval"@en ; cd:authoredResource true .
  ex:l5-d08e-title a cd:Interpretation ; skos:prefLabel "Quantiles will help calibrate uncertainty"@en ; cd:authoredResource true .

  ex:l5-d08a-chart a cd:ChartDefinition ; skos:prefLabel "Binomial probability mass"@en ; cd:body "Ten independent trials, 20% positive probability each. Exactly two: 30.199%. All eleven masses sum to one."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:xAxisLabel "Positive count"@en ; cd:yAxisLabel "Probability"@en ; cd:usesDataset ex:l5-da-data ; cd:hasChartAnnotation ex:l5-da-focus ; cd:hasSource ex:l5-source-r-binomial ; cd:authoredResource true .
  ex:l5-da-focus a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:l5-da-2 ; cd:body "Exactly two positives"@en ; cd:authoredResource true .
  ex:l5-d08b-chart a cd:ChartDefinition ; skos:prefLabel "Theoretical binomial CDF"@en ; cd:body "At most two: 67.780%. Filled points show included CDF values; hollow points show left limits. This is not an empirical CDF."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "step-after" ; cd:showChartPoints true ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.0 ; cd:xAxisLabel "Count threshold"@en ; cd:yAxisLabel "CDF"@en ; cd:usesDataset ex:l5-db-data ; cd:hasChartAnnotation ex:l5-db-focus ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-db-focus a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:l5-db-2 ; cd:body "At most two: 67.78%"@en ; cd:authoredResource true .
  ex:l5-d08c-chart a cd:ChartDefinition ; skos:prefLabel "Constructed continuous nitrate model"@en ; cd:body "Area from 9.75 to 10.25 mg/L: 75%. Peak density: 2 L/mg, not 200% probability. Constructed illustration, not fitted measurements."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 2.2 ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-dc-data ; cd:hasChartAnnotation ex:l5-dc-area ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-dc-area a cd:ChartRangeAnnotation ; cd:position 1 ; cd:startObservation ex:l5-dc-a ; cd:endObservation ex:l5-dc-b ; cd:body "Interval area: 75%"@en ; cd:authoredResource true .
  ex:l5-d08d-chart a cd:ChartDefinition ; skos:prefLabel "Theoretical CDF of the constructed density"@en ; cd:body "Same interval: lower CDF 0.125, upper CDF 0.875; difference 0.75. The curve is sampled for drawing; marked values are exact."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.0 ; cd:xAxisLabel "Concentration threshold"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "CDF"@en ; cd:usesDataset ex:l5-dd-data ; cd:hasChartAnnotation ex:l5-dd-low, ex:l5-dd-high ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-dd-low a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:l5-dd-4 ; cd:body "Lower: 0.125"@en ; cd:authoredResource true .
  ex:l5-dd-high a cd:ChartPointAnnotation ; cd:position 2 ; cd:targetObservation ex:l5-dd-12 ; cd:body "Upper: 0.875"@en ; cd:authoredResource true .
  ex:l5-d08e-chart a cd:ChartDefinition ; skos:prefLabel "Binomial median as a CDF threshold"@en ; cd:body "The horizontal line marks 50%. The CDF first reaches it at count 2, jumping above 50%. Quantiles need not give exact CDF equality."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "step-after" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.0 ; cd:xAxisLabel "Count threshold"@en ; cd:yAxisLabel "CDF"@en ; cd:usesDataset ex:l5-db-data ; dct:hasPart ex:l5-de-level ; cd:hasChartAnnotation ex:l5-de-crossing ; cd:hasSource ex:l5-source-r-distributions ; cd:authoredResource true .
  ex:l5-de-crossing a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:l5-db-2 ; cd:body "Median count: 2"@en ; cd:authoredResource true .

  ex:l5-da-data a cd:Dataset ; skos:prefLabel "Authored binomial probabilities, not measured outcomes"@en ; cd:derivedFromResource ex:l5-binomial-formula ; cd:hasObservation ex:l5-da-0, ex:l5-da-1, ex:l5-da-2, ex:l5-da-3, ex:l5-da-4, ex:l5-da-5, ex:l5-da-6, ex:l5-da-7, ex:l5-da-8, ex:l5-da-9, ex:l5-da-10 ; cd:authoredResource true .
