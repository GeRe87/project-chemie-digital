  ex:l5-db-after a cd:Observation ; cd:position 13 ; cd:xValue 11.0 ; cd:numericValue 1.0 ; cd:authoredResource true .

  ex:l5-dc-data a cd:Dataset ; skos:prefLabel "Constructed normalized piecewise-linear density, not measured data"@en ; cd:body "A constructed triangular density on 9.5 to 10.5 mg/L, peaking at density 2 L/mg at 10 mg/L, with zero density outside. It is solely an area illustration, not a fitted model or an assertion about nitrate measurement errors."@en ; cd:derivedFromResource ex:l5-pdf-definition ; cd:hasObservation ex:l5-dc-left, ex:l5-dc-a, ex:l5-dc-peak, ex:l5-dc-b, ex:l5-dc-right ; cd:authoredResource true .
  ex:l5-dc-left a cd:Observation ; cd:position 1 ; cd:xValue 9.5 ; cd:numericValue 0.0 ; cd:authoredResource true .
  ex:l5-dc-a a cd:Observation ; cd:position 2 ; cd:xValue 9.75 ; cd:numericValue 1.0 ; cd:authoredResource true .
  ex:l5-dc-peak a cd:Observation ; cd:position 3 ; cd:xValue 10.0 ; cd:numericValue 2.0 ; cd:authoredResource true .
  ex:l5-dc-b a cd:Observation ; cd:position 4 ; cd:xValue 10.25 ; cd:numericValue 1.0 ; cd:authoredResource true .
  ex:l5-dc-right a cd:Observation ; cd:position 5 ; cd:xValue 10.5 ; cd:numericValue 0.0 ; cd:authoredResource true .

