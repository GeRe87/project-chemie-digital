  ex:l5-da-3 a cd:Observation ; cd:position 4 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "3"@en ; cd:numericValue 0.201326592000 ; cd:authoredResource true .
  ex:l5-da-4 a cd:Observation ; cd:position 5 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "4"@en ; cd:numericValue 0.088080384000 ; cd:authoredResource true .
  ex:l5-da-5 a cd:Observation ; cd:position 6 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "5"@en ; cd:numericValue 0.026424115200 ; cd:authoredResource true .
  ex:l5-da-6 a cd:Observation ; cd:position 7 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "6"@en ; cd:numericValue 0.005505024000 ; cd:authoredResource true .
  ex:l5-da-7 a cd:Observation ; cd:position 8 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "7"@en ; cd:numericValue 0.000786432000 ; cd:authoredResource true .
  ex:l5-da-8 a cd:Observation ; cd:position 9 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "8"@en ; cd:numericValue 0.000073728000 ; cd:authoredResource true .
  ex:l5-da-9 a cd:Observation ; cd:position 10 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "9"@en ; cd:numericValue 0.000004096000 ; cd:authoredResource true .
  ex:l5-da-10 a cd:Observation ; cd:position 11 ; skos:prefLabel "Binomial model"@en ; cd:groupLabel "10"@en ; cd:numericValue 0.000000102400 ; cd:authoredResource true .

  ex:l5-db-data a cd:Dataset ; skos:prefLabel "Theoretical binomial cumulative probabilities"@en ; cd:derivedFromResource ex:l5-da-data, ex:l5-d08b-formula ; cd:hasObservation ex:l5-db-before, ex:l5-db-0, ex:l5-db-1, ex:l5-db-2, ex:l5-db-3, ex:l5-db-4, ex:l5-db-5, ex:l5-db-6, ex:l5-db-7, ex:l5-db-8, ex:l5-db-9, ex:l5-db-10, ex:l5-db-after ; cd:authoredResource true .
