  ex:l5-db-0 a cd:Observation ; cd:position 2 ; cd:xValue 0.0 ; cd:numericValue 0.107374182400 ; cd:authoredResource true .
  ex:l5-db-1 a cd:Observation ; cd:position 3 ; cd:xValue 1.0 ; cd:numericValue 0.375809638400 ; cd:authoredResource true .
  ex:l5-db-2 a cd:Observation ; cd:position 4 ; cd:xValue 2.0 ; cd:numericValue 0.677799526400 ; cd:authoredResource true .
  ex:l5-db-3 a cd:Observation ; cd:position 5 ; cd:xValue 3.0 ; cd:numericValue 0.879126118400 ; cd:authoredResource true .
  ex:l5-db-4 a cd:Observation ; cd:position 6 ; cd:xValue 4.0 ; cd:numericValue 0.967206502400 ; cd:authoredResource true .
  ex:l5-db-5 a cd:Observation ; cd:position 7 ; cd:xValue 5.0 ; cd:numericValue 0.993630617600 ; cd:authoredResource true .
  ex:l5-db-6 a cd:Observation ; cd:position 8 ; cd:xValue 6.0 ; cd:numericValue 0.999135641600 ; cd:authoredResource true .
  ex:l5-db-7 a cd:Observation ; cd:position 9 ; cd:xValue 7.0 ; cd:numericValue 0.999922073600 ; cd:authoredResource true .
  ex:l5-db-8 a cd:Observation ; cd:position 10 ; cd:xValue 8.0 ; cd:numericValue 0.999995801600 ; cd:authoredResource true .
  ex:l5-db-9 a cd:Observation ; cd:position 11 ; cd:xValue 9.0 ; cd:numericValue 0.999999897600 ; cd:authoredResource true .
