  ex:path-level5-binomial-opening cd:forTopic ex:probability-mass-function, ex:cumulative-distribution-function, ex:probability-density-function, ex:theoretical-quantile ; cd:hasStep ex:l5-d08a-step, ex:l5-d08b-step, ex:l5-d08c-step, ex:l5-d08d-step, ex:l5-d08e-step .
  ex:l5-d08a-step a cd:PathStep ; cd:position 12 ; cd:usesScene ex:l5-d08a-scene ; cd:usesResource ex:l5-d08a-title, ex:l5-d08a-chart, ex:l5-d08a-formula ; cd:authoredResource true .
