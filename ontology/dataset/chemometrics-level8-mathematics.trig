  ex:l8-f-hadamard-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\ne,\\odot"@en ; cd:body "≠ means not equal. ⊙ denotes entrywise (Hadamard) multiplication of equally shaped matrices."@en ; dct:references ex:l8-symbol-neq ; cd:authoredResource true .
  ex:l8-symbol-ops a cd:MathSymbol ; cd:symbol "+,-,=,\\cdot" ; cd:mathNotation "+,-,=,\\cdot" ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; cd:authoredResource true .
  ex:l8-f-hadamard-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-hadamard-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-hadamard-entry-1, ex:l8-f-hadamard-entry-2, ex:l8-f-hadamard-entry-3 ; cd:authoredResource true .
  ex:l8-f-hadamard a cd:MathExpression ; cd:latex "\\begin{aligned}\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix}\\odot \\begin{bmatrix}5&6\\\\7&8\\end{bmatrix}&=\\begin{bmatrix}\\boxed{5}&12\\\\21&32\\end{bmatrix}\\\\1\\cdot5&=\\boxed{5}\\quad\\text{in the top-left entry}\\end{aligned}" ; cd:formulaLabel "Entrywise is a different operation"@en ; cd:hasSymbol ex:l8-symbol-A, ex:l8-symbol-neq, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-hadamard-legend ; cd:authoredResource true .
  ex:l8-symbol-A a cd:MathSymbol ; cd:symbol "A,B" ; cd:mathNotation "A,B" ; cd:body "Named numerical matrices; entries in the matrix examples are dimensionless. Matrix juxtaposition denotes row-by-column multiplication, not entrywise multiplication."@en ; cd:authoredResource true .
  ex:l8-f-inverse-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A,B"@en ; cd:body "Named numerical matrices; entries in the matrix examples are dimensionless. Matrix juxtaposition denotes row-by-column multiplication, not entrywise multiplication."@en ; dct:references ex:l8-symbol-A ; cd:authoredResource true .
  ex:l8-symbol-inv a cd:MathSymbol ; cd:symbol "{}^{-1}" ; cd:mathNotation "{}^{-1}" ; cd:body "Matrix inverse, not entrywise reciprocal: for a nonsingular square matrix, multiplication on either side gives the identity."@en ; cd:authoredResource true .
