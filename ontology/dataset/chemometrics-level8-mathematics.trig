  ex:l8-symbol-neq a cd:MathSymbol ; cd:symbol "\\ne,\\odot" ; cd:mathNotation "\\ne,\\odot" ; cd:body "≠ means not equal. ⊙ denotes entrywise (Hadamard) multiplication of equally shaped matrices."@en ; cd:authoredResource true .
  ex:l8-f-products-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\ne,\\odot"@en ; cd:body "≠ means not equal. ⊙ denotes entrywise (Hadamard) multiplication of equally shaped matrices."@en ; dct:references ex:l8-symbol-neq ; cd:authoredResource true .
