  ex:l8-symbol-T a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T}" ; cd:mathNotation "{}^{\\mathsf T}" ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; cd:authoredResource true .
  ex:l8-f-solution-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-symbol-inv a cd:MathSymbol ; cd:symbol "{}^{-1}" ; cd:mathNotation "{}^{-1}" ; cd:body "Matrix inverse, not entrywise reciprocal: for a nonsingular square matrix, multiplication on either side gives the identity."@en ; cd:authoredResource true .
