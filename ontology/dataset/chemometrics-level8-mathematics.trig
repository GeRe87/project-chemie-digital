  ex:l8-symbol-ops a cd:MathSymbol ; cd:symbol "+,-,=,\\cdot" ; cd:mathNotation "+,-,=,\\cdot" ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; cd:authoredResource true .
  ex:l8-f-scalar-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-scalar-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-scalar-entry-1, ex:l8-f-scalar-entry-2 ; cd:authoredResource true .
  ex:l8-f-scalar a cd:MathExpression ; cd:latex "\\begin{aligned}2\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix}&=\\begin{bmatrix}\\boxed{2\\cdot1}&2\\cdot2\\\\2\\cdot3&2\\cdot4\\end{bmatrix}\\\\&=\\begin{bmatrix}2&4\\\\6&8\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "A scalar multiplies every entry"@en ; cd:hasSymbol ex:l8-symbol-c, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-scalar-legend ; cd:authoredResource true .
  ex:l8-symbol-T a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T}" ; cd:mathNotation "{}^{\\mathsf T}" ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; cd:authoredResource true .
  ex:l8-f-transpose-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-symbol-ops a cd:MathSymbol ; cd:symbol "+,-,=,\\cdot" ; cd:mathNotation "+,-,=,\\cdot" ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; cd:authoredResource true .
  ex:l8-f-transpose-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-transpose-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-transpose-entry-1, ex:l8-f-transpose-entry-2 ; cd:authoredResource true .
  ex:l8-f-transpose a cd:MathExpression ; cd:latex "\\begin{bmatrix}\\boxed{1}&\\boxed{2}&\\boxed{3}\\\\4&5&6\\end{bmatrix}^{\\mathsf T}=\\begin{bmatrix}\\boxed{1}&4\\\\\\boxed{2}&5\\\\\\boxed{3}&6\\end{bmatrix}" ; cd:formulaLabel "2 × 3 becomes 3 × 2"@en ; cd:hasSymbol ex:l8-symbol-T, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-transpose-legend ; cd:authoredResource true .
  ex:l8-symbol-dims a cd:MathSymbol ; cd:symbol "m,n,p" ; cd:mathNotation "m,n,p" ; cd:body "Positive integer row, inner and column counts. In a shape m × n, the first count is rows and the second columns; × here separates dimensions."@en ; cd:authoredResource true .
  ex:l8-f-multiply-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "m,n,p"@en ; cd:body "Positive integer row, inner and column counts. In a shape m × n, the first count is rows and the second columns; × here separates dimensions."@en ; dct:references ex:l8-symbol-dims ; cd:authoredResource true .
  ex:l8-symbol-ops a cd:MathSymbol ; cd:symbol "+,-,=,\\cdot" ; cd:mathNotation "+,-,=,\\cdot" ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; cd:authoredResource true .
  ex:l8-f-multiply-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-multiply-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-multiply-entry-1, ex:l8-f-multiply-entry-2 ; cd:authoredResource true .
  ex:l8-f-multiply a cd:MathExpression ; cd:latex "\\begin{aligned}(m\\times\\boxed{n})(\\boxed{n}\\times p)&\\longrightarrow(m\\times p)\\\\(2\\times\\boxed{3})(\\boxed{3}\\times4)&\\longrightarrow(2\\times4)\\end{aligned}" ; cd:formulaLabel "Inner counts agree; outer counts remain"@en ; cd:hasSymbol ex:l8-symbol-dims, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-multiply-legend ; cd:authoredResource true .
  ex:l8-symbol-A a cd:MathSymbol ; cd:symbol "A,B" ; cd:mathNotation "A,B" ; cd:body "Named numerical matrices; entries in the matrix examples are dimensionless. Matrix juxtaposition denotes row-by-column multiplication, not entrywise multiplication."@en ; cd:authoredResource true .
