  ex:l8-f-criteria a cd:MathExpression ; cd:latex "\\begin{aligned}Q_{\\log}&=\\sum_i[\\ln(C_i/C_*)-\\widehat z_i]^2\\\\Q_{\\mathrm{raw}}&=\\sum_i(C_i-\\widehat C_i)^2\\end{aligned}" ; cd:formulaLabel "Different scale, different objective"@en ; cd:hasSymbol ex:l8-symbol-logsse, ex:l8-symbol-C, ex:l8-symbol-z, ex:l8-symbol-log, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-criteria-legend ; cd:authoredResource true .
  ex:l8-symbol-q a cd:MathSymbol ; cd:symbol "q,\\tau" ; cd:mathNotation "q,\\tau" ; cd:body "q is positive flow in mL/min; τ is residence time in min. The reciprocal 1/q has unit min/mL; q = 0 is outside the domain."@en ; cd:authoredResource true .
