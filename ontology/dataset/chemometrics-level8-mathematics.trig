  ex:l8-f-conditions-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-conditions-entry-1, ex:l8-f-conditions-entry-2, ex:l8-f-conditions-entry-3, ex:l8-f-conditions-entry-4, ex:l8-f-conditions-entry-5, ex:l8-f-conditions-entry-6, ex:l8-f-conditions-entry-7, ex:l8-f-conditions-entry-8, ex:l8-f-conditions-entry-9, ex:l8-f-conditions-entry-10 ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Q"@en ; cd:body "Sum of squared residuals for the candidate coefficients, in mV²."@en ; dct:references ex:l8-symbol-Q ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\beta_0"@en ; cd:body "Intercept, the predicted signal at zero time, in mV."@en ; dct:references ex:l8-symbol-b0 ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta_1"@en ; cd:body "Slope, the predicted signal change per unit time, in mV/min."@en ; dct:references ex:l8-symbol-b1 ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "\\partial Q / \\partial \\beta_j"@en ; cd:body "Rate of change of the cost as one coefficient varies and the other is held fixed. The subscript j indicates coefficient 0 or 1."@en ; dct:references ex:l8-symbol-deriv ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "=0"@en ; cd:body "The rate of change is zero. At the joint minimum both equations hold at the same coefficient pair."@en ; dct:references ex:l8-symbol-zero ; cd:authoredResource true .
  ex:l8-symbol-total-differential a cd:MathSymbol ; cd:symbol "\\mathrm dQ,\\ \\mathrm d\\beta_0,\\ \\mathrm d\\beta_1" ; cd:mathNotation "\\mathrm dQ,\\ \\mathrm d\\beta_0,\\ \\mathrm d\\beta_1" ; cd:body "First-order change in Q and the two independent coefficient increments. Their units here are mV², mV and mV/min, respectively."@en ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "\\mathrm dQ,\\ \\mathrm d\\beta_0,\\ \\mathrm d\\beta_1"@en ; cd:body "First-order change in Q and the two independent coefficient increments. Their units here are mV², mV and mV/min, respectively."@en ; dct:references ex:l8-symbol-total-differential ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "y_i"@en ; cd:body "Measured signal for observation i, in mV."@en ; dct:references ex:l8-symbol-y ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "x_i"@en ; cd:body "Measurement time for observation i, in min."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "\\sum_{i=1}^{n}"@en ; cd:body "Add one square for each observation. The index i runs from 1 to n. Here n = 5."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "(\\cdot)^2"@en ; cd:body "Square the entire residual. Each squared residual is expressed in mV²."@en ; dct:references ex:l8-symbol-sq ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-entry-11 a cd:DefinitionListEntry ; cd:position 11 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction and equality. Juxtaposed terms multiply. Parentheses and brackets group terms."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-minimum-two-coefficients-entry-1, ex:l8-minimum-two-coefficients-entry-2, ex:l8-minimum-two-coefficients-entry-3, ex:l8-minimum-two-coefficients-entry-4, ex:l8-minimum-two-coefficients-entry-5, ex:l8-minimum-two-coefficients-entry-6, ex:l8-minimum-two-coefficients-entry-7, ex:l8-minimum-two-coefficients-entry-8, ex:l8-minimum-two-coefficients-entry-9, ex:l8-minimum-two-coefficients-entry-10, ex:l8-minimum-two-coefficients-entry-11 ; cd:authoredResource true .
  ex:l8-minimum-two-coefficients-formula a cd:MathExpression ; cd:latex "\\begin{aligned}Q(\\beta_0,\\beta_1)&=\\sum_{i=1}^{n}[\\boxed{\\phantom{}y_i-\\beta_0-\\beta_1 x_i}]^2\\\\[.45em]\\mathrm dQ&=\\frac{\\partial Q}{\\partial\\beta_0}\\,\\mathrm d\\beta_0+\\frac{\\partial Q}{\\partial\\beta_1}\\,\\mathrm d\\beta_1\\\\[.45em]\\frac{\\partial Q}{\\partial\\beta_0}&=0,\\qquad \\frac{\\partial Q}{\\partial\\beta_1}=0\\end{aligned}" ; cd:formulaLabel "Squared error, total differential and minimum conditions"@en ; cd:hasSymbol ex:l8-symbol-Q, ex:l8-symbol-b0, ex:l8-symbol-b1, ex:l8-symbol-deriv, ex:l8-symbol-zero, ex:l8-symbol-total-differential, ex:l8-symbol-y, ex:l8-symbol-x, ex:l8-symbol-sum, ex:l8-symbol-sq, ex:l8-symbol-ops ; dct:hasPart ex:l8-minimum-two-coefficients-legend ; cd:authoredResource true .
  ex:l8-symbol-normal-matrix a cd:MathSymbol ; cd:symbol "M" ; cd:mathNotation "M" ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; cd:authoredResource true .
  ex:l8-symbol-normal-rhs a cd:MathSymbol ; cd:symbol "r" ; cd:mathNotation "r" ; cd:body "Known right-hand side: the sum of the signals and the sum of the time–signal products."@en ; cd:authoredResource true .
  ex:l8-symbol-det-display a cd:MathSymbol ; cd:symbol "\\det" ; cd:mathNotation "\\det" ; cd:body "Determinant. A nonzero value confirms that the matrix is invertible."@en ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "e_i"@en ; cd:body "Residual, measured signal minus the predicted signal at time i, in mV."@en ; dct:references ex:l8-symbol-e ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "y_i"@en ; cd:body "Measured signal for observation i in mV."@en ; dct:references ex:l8-symbol-y ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta_0"@en ; cd:body "Intercept in mV."@en ; dct:references ex:l8-symbol-b0 ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "\\beta_1"@en ; cd:body "Slope in mV/min."@en ; dct:references ex:l8-symbol-b1 ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "x_i"@en ; cd:body "Time of observation i in minutes."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "Q"@en ; cd:body "Sum of the squared residuals in mV²."@en ; dct:references ex:l8-symbol-Q ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "\\partial Q/\\partial\\beta_j"@en ; cd:body "Partial derivative of Q as just one coefficient, j = 0 or 1, varies."@en ; dct:references ex:l8-symbol-deriv ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "\\sum_i"@en ; cd:body "Add over all measured samples."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "i,n"@en ; cd:body "Index i identifies an observation; n is the number of observations, here 5."@en ; dct:references ex:l8-symbol-idx ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "0"@en ; cd:body "The corresponding derivative or sum equals zero."@en ; dct:references ex:l8-symbol-zero ; cd:authoredResource true .
  ex:l8-direct-conditions-entry-11 a cd:DefinitionListEntry ; cd:position 11 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-conditions-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-conditions-entry-1, ex:l8-direct-conditions-entry-2, ex:l8-direct-conditions-entry-3, ex:l8-direct-conditions-entry-4, ex:l8-direct-conditions-entry-5, ex:l8-direct-conditions-entry-6, ex:l8-direct-conditions-entry-7, ex:l8-direct-conditions-entry-8, ex:l8-direct-conditions-entry-9, ex:l8-direct-conditions-entry-10, ex:l8-direct-conditions-entry-11 ; cd:authoredResource true .
  ex:l8-direct-conditions a cd:MathExpression ; cd:latex "\\begin{aligned}e_i&=y_i-(\\beta_0+\\beta_1x_i)\\\\[.35em]\\frac{\\partial Q}{\\partial\\beta_0}&=-2\\sum_i e_i=0\\\\[.35em]\\frac{\\partial Q}{\\partial\\beta_1}&=-2\\sum_i x_i e_i=0\\end{aligned}" ; cd:formulaLabel "Differentiate each squared residual"@en ; cd:hasSymbol ex:l8-symbol-e, ex:l8-symbol-y, ex:l8-symbol-b0, ex:l8-symbol-b1, ex:l8-symbol-x, ex:l8-symbol-Q, ex:l8-symbol-deriv, ex:l8-symbol-sum, ex:l8-symbol-idx, ex:l8-symbol-zero, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-conditions-legend ; cd:authoredResource true .
  ex:l8-direct-collect-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "y_i"@en ; cd:body "Measured signal for observation i in mV."@en ; dct:references ex:l8-symbol-y ; cd:authoredResource true .
  ex:l8-direct-collect-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\beta_0"@en ; cd:body "Intercept in mV."@en ; dct:references ex:l8-symbol-b0 ; cd:authoredResource true .
  ex:l8-direct-collect-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta_1"@en ; cd:body "Slope in mV/min."@en ; dct:references ex:l8-symbol-b1 ; cd:authoredResource true .
  ex:l8-direct-collect-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "x_i"@en ; cd:body "Time of observation i in minutes."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-direct-collect-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\sum_i"@en ; cd:body "Add over all measured samples."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-direct-collect-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "i,n"@en ; cd:body "Index i identifies an observation; n is the number of observations, here 5."@en ; dct:references ex:l8-symbol-idx ; cd:authoredResource true .
  ex:l8-direct-collect-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "0"@en ; cd:body "The corresponding derivative or sum equals zero."@en ; dct:references ex:l8-symbol-zero ; cd:authoredResource true .
  ex:l8-direct-collect-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-collect-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-collect-entry-1, ex:l8-direct-collect-entry-2, ex:l8-direct-collect-entry-3, ex:l8-direct-collect-entry-4, ex:l8-direct-collect-entry-5, ex:l8-direct-collect-entry-6, ex:l8-direct-collect-entry-7, ex:l8-direct-collect-entry-8 ; cd:authoredResource true .
  ex:l8-direct-collect a cd:MathExpression ; cd:latex "\\begin{aligned}\\sum_i (y_i-\\beta_0-\\beta_1x_i)&=0\\\\ \\sum_i x_i(y_i-\\beta_0-\\beta_1x_i)&=0\\\\[.5em]n\\beta_0+\\Bigl(\\sum_i x_i\\Bigr)\\beta_1&=\\sum_i y_i\\\\ \\Bigl(\\sum_i x_i\\Bigr)\\beta_0+\\Bigl(\\sum_i x_i^2\\Bigr)\\beta_1&=\\sum_i x_i y_i\\end{aligned}" ; cd:formulaLabel "Substitute the residual, expand and collect terms"@en ; cd:hasSymbol ex:l8-symbol-y, ex:l8-symbol-b0, ex:l8-symbol-b1, ex:l8-symbol-x, ex:l8-symbol-sum, ex:l8-symbol-idx, ex:l8-symbol-zero, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-collect-legend ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "M"@en ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; dct:references ex:l8-symbol-normal-matrix ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "r"@en ; cd:body "Known right-hand side: the sum of the signals and the sum of the time–signal products."@en ; dct:references ex:l8-symbol-normal-rhs ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta,\\widehat\\beta"@en ; cd:body "Column of intercept and slope. A hat marks the fitted values. The units are mV and mV/min."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "\\beta_0"@en ; cd:body "Intercept in mV."@en ; dct:references ex:l8-symbol-b0 ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\beta_1"@en ; cd:body "Slope in mV/min."@en ; dct:references ex:l8-symbol-b1 ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "\\sum_i"@en ; cd:body "Add over all measured samples."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "i,n"@en ; cd:body "Index i identifies an observation; n is the number of observations, here 5."@en ; dct:references ex:l8-symbol-idx ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "x_i"@en ; cd:body "Time of observation i in minutes."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "y_i"@en ; cd:body "Measured signal for observation i in mV."@en ; dct:references ex:l8-symbol-y ; cd:authoredResource true .
  ex:l8-direct-matrix-entry-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-matrix-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-matrix-entry-1, ex:l8-direct-matrix-entry-2, ex:l8-direct-matrix-entry-3, ex:l8-direct-matrix-entry-4, ex:l8-direct-matrix-entry-5, ex:l8-direct-matrix-entry-6, ex:l8-direct-matrix-entry-7, ex:l8-direct-matrix-entry-8, ex:l8-direct-matrix-entry-9, ex:l8-direct-matrix-entry-10 ; cd:authoredResource true .
  ex:l8-direct-matrix a cd:MathExpression ; cd:latex "\\underbrace{\\begin{bmatrix}n&\\sum_i x_i\\\\ \\sum_i x_i&\\sum_i x_i^2\\end{bmatrix}}_{M}\\underbrace{\\begin{bmatrix}\\beta_0\\\\ \\beta_1\\end{bmatrix}}_{\\beta}=\\underbrace{\\begin{bmatrix}\\sum_i y_i\\\\ \\sum_i x_i y_i\\end{bmatrix}}_{r}" ; cd:formulaLabel "Two scalar equations become one matrix equation"@en ; cd:hasSymbol ex:l8-symbol-normal-matrix, ex:l8-symbol-normal-rhs, ex:l8-symbol-beta, ex:l8-symbol-b0, ex:l8-symbol-b1, ex:l8-symbol-sum, ex:l8-symbol-idx, ex:l8-symbol-x, ex:l8-symbol-y, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-matrix-legend ; cd:authoredResource true .
  ex:l8-direct-solve-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "M"@en ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; dct:references ex:l8-symbol-normal-matrix ; cd:authoredResource true .
  ex:l8-direct-solve-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "r"@en ; cd:body "Known right-hand side: the sum of the signals and the sum of the time–signal products."@en ; dct:references ex:l8-symbol-normal-rhs ; cd:authoredResource true .
  ex:l8-direct-solve-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta,\\widehat\\beta"@en ; cd:body "Column of intercept and slope. A hat marks the fitted values. The units are mV and mV/min."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-direct-solve-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "^{-1}"@en ; cd:body "Matrix inverse. It exists for this coefficient matrix because its determinant is nonzero."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-direct-solve-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "I"@en ; cd:body "Two by two identity matrix. It leaves the coefficient column unchanged."@en ; dct:references ex:l8-symbol-I ; cd:authoredResource true .
  ex:l8-direct-solve-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-solve-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-solve-entry-1, ex:l8-direct-solve-entry-2, ex:l8-direct-solve-entry-3, ex:l8-direct-solve-entry-4, ex:l8-direct-solve-entry-5, ex:l8-direct-solve-entry-6 ; cd:authoredResource true .
  ex:l8-direct-solve a cd:MathExpression ; cd:latex "\\begin{aligned}M\\widehat\\beta&=r\\\\[.4em]M^{-1}M\\widehat\\beta&=M^{-1}r\\\\[.4em]I\\widehat\\beta&=M^{-1}r\\\\[.4em]\\widehat\\beta&=\\boxed{M^{-1}r}\\end{aligned}" ; cd:formulaLabel "Left-multiply both sides by the inverse"@en ; cd:hasSymbol ex:l8-symbol-normal-matrix, ex:l8-symbol-normal-rhs, ex:l8-symbol-beta, ex:l8-symbol-inv, ex:l8-symbol-I, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-solve-legend ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "M"@en ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; dct:references ex:l8-symbol-normal-matrix ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "r"@en ; cd:body "Known right-hand side: the sum of the signals and the sum of the time–signal products."@en ; dct:references ex:l8-symbol-normal-rhs ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "x_i"@en ; cd:body "Time of observation i in minutes."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "y_i"@en ; cd:body "Measured signal for observation i in mV."@en ; dct:references ex:l8-symbol-y ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\sum_i"@en ; cd:body "Add over all measured samples."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "i,n"@en ; cd:body "Index i identifies an observation; n is the number of observations, here 5."@en ; dct:references ex:l8-symbol-idx ; cd:authoredResource true .
  ex:l8-direct-numbers-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-numbers-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-numbers-entry-1, ex:l8-direct-numbers-entry-2, ex:l8-direct-numbers-entry-3, ex:l8-direct-numbers-entry-4, ex:l8-direct-numbers-entry-5, ex:l8-direct-numbers-entry-6, ex:l8-direct-numbers-entry-7 ; cd:authoredResource true .
  ex:l8-direct-numbers a cd:MathExpression ; cd:latex "\\begin{aligned}n&=5,&\\sum_i x_i&=10,&\\sum_i x_i^2&=30\\\\ \\sum_i y_i&=25,&\\sum_i x_i y_i&=69.9\\\\[.55em]M&=\\begin{bmatrix}5&10\\\\10&30\\end{bmatrix},&r&=\\begin{bmatrix}25\\\\69.9\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Sum all five measurements in minutes and millivolts"@en ; cd:hasSymbol ex:l8-symbol-normal-matrix, ex:l8-symbol-normal-rhs, ex:l8-symbol-x, ex:l8-symbol-y, ex:l8-symbol-sum, ex:l8-symbol-idx, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-numbers-legend ; cd:authoredResource true .
  ex:l8-direct-inverse-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "M"@en ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; dct:references ex:l8-symbol-normal-matrix ; cd:authoredResource true .
  ex:l8-direct-inverse-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "^{-1}"@en ; cd:body "Matrix inverse. It exists for this coefficient matrix because its determinant is nonzero."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-direct-inverse-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\det"@en ; cd:body "Determinant. A nonzero value confirms that the matrix is invertible."@en ; dct:references ex:l8-symbol-det-display ; cd:authoredResource true .
  ex:l8-direct-inverse-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-inverse-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-inverse-entry-1, ex:l8-direct-inverse-entry-2, ex:l8-direct-inverse-entry-3, ex:l8-direct-inverse-entry-4 ; cd:authoredResource true .
  ex:l8-direct-inverse a cd:MathExpression ; cd:latex "\\begin{aligned}\\det(M)&=5\\cdot30-10\\cdot10=50\\\\[.45em]M^{-1}&=\\frac{1}{50}\\begin{bmatrix}30&-10\\\\-10&5\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Swap the diagonal entries, negate the others, divide by the determinant"@en ; cd:hasSymbol ex:l8-symbol-normal-matrix, ex:l8-symbol-inv, ex:l8-symbol-det-display, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-inverse-legend ; cd:authoredResource true .
  ex:l8-direct-fitted-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "M"@en ; cd:body "Two by two coefficient matrix of the two scalar regression equations. The known entries are n, the sum of the times, and the sum of squared times."@en ; dct:references ex:l8-symbol-normal-matrix ; cd:authoredResource true .
  ex:l8-direct-fitted-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "r"@en ; cd:body "Known right-hand side: the sum of the signals and the sum of the time–signal products."@en ; dct:references ex:l8-symbol-normal-rhs ; cd:authoredResource true .
  ex:l8-direct-fitted-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta,\\widehat\\beta"@en ; cd:body "Column of intercept and slope. A hat marks the fitted values. The units are mV and mV/min."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-direct-fitted-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "^{-1}"@en ; cd:body "Matrix inverse. It exists for this coefficient matrix because its determinant is nonzero."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-direct-fitted-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Adjacent factors multiply. Brackets arrange entries; a superscript 2 squares its term."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-fitted-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-fitted-entry-1, ex:l8-direct-fitted-entry-2, ex:l8-direct-fitted-entry-3, ex:l8-direct-fitted-entry-4, ex:l8-direct-fitted-entry-5 ; cd:authoredResource true .
  ex:l8-direct-fitted a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat\\beta&=M^{-1}r\\\\[.35em]&=\\frac{1}{50}\\begin{bmatrix}30&-10\\\\-10&5\\end{bmatrix}\\begin{bmatrix}25\\\\69.9\\end{bmatrix}\\\\[.35em]&=\\begin{bmatrix}1.02\\\\1.99\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Intercept 1.02 mV and slope 1.99 mV/min"@en ; cd:hasSymbol ex:l8-symbol-normal-matrix, ex:l8-symbol-normal-rhs, ex:l8-symbol-beta, ex:l8-symbol-inv, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-fitted-legend ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\beta,\\widehat\\beta"@en ; cd:body "Trial and fitted coefficient vectors. Here the two entries are intercept (mV) and slope (mV/min)."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "X"@en ; cd:body "Design matrix. The first column contains dimensionless ones; the second contains measured times in minutes."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, which interchanges rows and columns."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "y,X\\beta,e"@en ; cd:body "Measured signals, model predictions and residuals, each a column in mV. The residual is measured minus predicted."@en ; dct:references ex:l8-symbol-Y ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "{}^{-1}"@en ; cd:body "Inverse matrix. It exists here because the two design columns are independent."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "0"@en ; cd:body "Zero column: both residual products vanish at the least-squares minimum."@en ; dct:references ex:l8-symbol-zero ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "-,=,\\cdot"@en ; cd:body "Subtraction, equality and multiplication. Adjacent factors multiply in their written order. Parentheses group operations."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "I"@en ; cd:body "Identity matrix of the required size: multiplying by it leaves the coefficient column unchanged."@en ; dct:references ex:l8-symbol-I ; cd:authoredResource true .
  ex:l8-direct-design-link-entry-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "\\frac{\\partial Q}{\\partial\\beta}"@en ; cd:body "Column of partial derivatives, one for each coefficient. X and y stay fixed."@en ; dct:references ex:l8-matrix-ls-symbol-gradient ; cd:authoredResource true .
  ex:l8-direct-design-link-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-direct-design-link-entry-1, ex:l8-direct-design-link-entry-2, ex:l8-direct-design-link-entry-3, ex:l8-direct-design-link-entry-4, ex:l8-direct-design-link-entry-5, ex:l8-direct-design-link-entry-6, ex:l8-direct-design-link-entry-7, ex:l8-direct-design-link-entry-8, ex:l8-direct-design-link-entry-9, ex:l8-normal-inverse-generic-entry ; cd:authoredResource true .
  ex:l8-f-normal-residual-start a cd:MathExpression ; cd:latex "0=\\left.\\frac{\\partial Q}{\\partial\\beta}\\right|_{\\widehat\\beta}=2X^{\\mathsf T}X\\widehat\\beta-2X^{\\mathsf T}y" ; cd:formulaLabel "At the minimum the coefficient gradient is zero"@en ; cd:hasSymbol ex:l8-symbol-beta, ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-Y, ex:l8-symbol-zero, ex:l8-symbol-ops, ex:l8-matrix-ls-symbol-gradient ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-direct-design-link a cd:MathExpression ; cd:latex "\\begin{aligned} I\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\\\[.35em]\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\end{aligned}" ; cd:formulaLabel "The identity leaves the coefficient vector unchanged"@en ; cd:hasSymbol ex:l8-symbol-beta, ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-Y, ex:l8-symbol-inv, ex:l8-symbol-ops , ex:l8-symbol-I ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-normal-from-residuals a cd:MathematicalDerivation ; skos:prefLabel "Derive and solve the normal equation"@en ; cd:inputFormula ex:l8-f-normal-residual-start ; cd:resultFormula ex:l8-direct-design-link ; cd:hasDerivationStep ex:l8-normal-expand-step, ex:l8-normal-invert-step, ex:l8-normal-cancel-step ; dct:source ex:l8-source-nist-ls ; cd:authoredResource true .
  ex:l8-normal-expand-rule a cd:MathematicalRule ; skos:prefLabel "Divide by two and rearrange"@en ; cd:body "A common nonzero factor cancels from both sides of an equality. Then add X transpose y to both sides."@en ; cd:ruleFormula ex:l8-normal-half-gradient ; dct:source ex:l8-source-nist-ls ; cd:hasSource ex:l8-source-nist-ls ; cd:authoredResource true .
  ex:l8-normal-expand-explanation a cd:Interpretation ; cd:body "After cancelling the factor two, the fitted product minus the observed product is zero. Move the observed product to the right to obtain the normal equation."@en ; cd:applicationFormula ex:l8-f-normal ; cd:authoredResource true .
  ex:l8-normal-expand-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Divide by two and rearrange"@en ; cd:fromFormula ex:l8-f-normal-residual-start ; cd:toFormula ex:l8-f-normal ; cd:appliesRule ex:l8-normal-expand-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-normal-expand-explanation ; cd:authoredResource true .
  ex:l8-normal-inverse-identity a cd:MathExpression ; cd:latex "(X^{\\mathsf T}X)^{-1}(X^{\\mathsf T}X)=I" ; cd:formulaLabel "Inverse times the coefficient matrix gives the identity"@en ; cd:hasSymbol ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-I, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-normal-invert-rule a cd:MathematicalRule ; skos:prefLabel "Left-multiply by the inverse"@en ; cd:body "Multiply both sides by the same inverse, from the left. Keep the factor order on each side."@en ; cd:ruleFormula ex:l8-normal-equal-products ; dct:source ex:l8-source-nist-ls ; cd:hasSource ex:l8-source-nist-ls ; cd:authoredResource true .
  ex:l8-normal-invert-explanation a cd:Interpretation ; cd:body "Prepend the inverse to each side of the normal equation. The coefficient column stays at the far right of the left-hand side."@en ; cd:applicationFormula ex:l8-normal-left-multiplied ; cd:authoredResource true .
  ex:l8-normal-invert-step a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Left-multiply by the inverse"@en ; cd:fromFormula ex:l8-f-normal ; cd:toFormula ex:l8-normal-left-multiplied ; cd:appliesRule ex:l8-normal-invert-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-normal-invert-explanation ; cd:authoredResource true .
  ex:l8-normal-from-residuals-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-normal-from-residuals ; cd:firstDerivationStep ex:l8-normal-expand-step ; cd:lastDerivationStep ex:l8-normal-expand-step ; cd:usesLegend ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-f-conditions a cd:MathExpression ; cd:latex "\\begin{aligned}\\frac{\\partial Q}{\\partial\\beta_0}&=-2\\sum_i e_i=0\\\\\\frac{\\partial Q}{\\partial\\beta_1}&=-2\\sum_i x_i e_i=0\\end{aligned}" ; cd:formulaLabel "Two coefficients, two conditions"@en ; cd:hasSymbol ex:l8-symbol-deriv, ex:l8-symbol-Q, ex:l8-symbol-b0, ex:l8-symbol-b1, ex:l8-symbol-sum, ex:l8-symbol-x, ex:l8-symbol-e, ex:l8-symbol-idx, ex:l8-symbol-zero, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-conditions-legend ; cd:authoredResource true .
  ex:l8-symbol-X a cd:MathSymbol ; cd:symbol "X" ; cd:mathNotation "X" ; cd:body "Design matrix: 5 rows (observations), 2 columns (constant and time) for the drift line. The constant column is dimensionless; the time column has unit min."@en ; cd:authoredResource true .
  ex:l8-f-orthogonal-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X"@en ; cd:body "Design matrix: 5 rows (observations), 2 columns (constant and time) for the drift line. The constant column is dimensionless; the time column has unit min."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
