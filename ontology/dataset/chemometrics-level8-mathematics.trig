  ex:l8-matrix-squared-error-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "y_i,y"@en ; cd:body "Measured response for observation i and the column of all measured responses, in mV."@en ; dct:references ex:l8-matrix-ls-symbol-y ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "X"@en ; cd:body "Design matrix for the drift line, with one row per observation. Its columns are ones and measured times."@en ; dct:references ex:l8-matrix-ls-symbol-X ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "\\beta_0,\\beta_1,\\beta"@en ; cd:body "Trial intercept, trial slope and their column. The intercept is in mV and the slope in mV/min."@en ; dct:references ex:l8-matrix-ls-symbol-b ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Addition, subtraction, equality and multiplication. Parentheses group terms. The exponent 2 squares a value."@en ; dct:references ex:l8-matrix-ls-symbol-ops ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-matrix-squared-error-legend-1, ex:l8-matrix-squared-error-legend-2, ex:l8-matrix-squared-error-legend-3, ex:l8-matrix-squared-error-legend-4, ex:l8-matrix-squared-error-legend-5, ex:l8-matrix-squared-error-legend-6, ex:l8-matrix-squared-error-legend-7, ex:l8-matrix-squared-error-legend-8, ex:l8-matrix-squared-error-legend-9, ex:l8-matrix-squared-error-legend-10 ; cd:authoredResource true .
  ex:l8-matrix-squared-error-formula a cd:MathExpression ; cd:latex "Q=(y^{\\mathsf T}-\\beta^{\\mathsf T}X^{\\mathsf T})(y-X\\beta)" ; cd:formulaLabel "Apply the transpose to the left bracket"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-matrix-squared-error-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Q"@en ; cd:body "Sum of squared residuals, in mV²."@en ; dct:references ex:l8-matrix-ls-symbol-Q ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "y"@en ; cd:body "Column of measured responses, in mV."@en ; dct:references ex:l8-matrix-ls-symbol-y ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "X"@en ; cd:body "Design matrix. The two columns contain ones and measured times."@en ; dct:references ex:l8-matrix-ls-symbol-X ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: swap rows and columns."@en ; dct:references ex:l8-matrix-ls-symbol-T ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\beta"@en ; cd:body "Coefficient column: intercept followed by slope."@en ; dct:references ex:l8-matrix-ls-symbol-b ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "+,-,=,\\cdot,2,0"@en ; cd:body "Addition, subtraction, equality and multiplication. Factors next to one another multiply. Zero denotes no contribution to the derivative."@en ; dct:references ex:l8-matrix-ls-symbol-ops ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "\\frac{\\partial Q}{\\partial\\beta}"@en ; cd:body "Column of partial derivatives, one for each coefficient. X and y stay fixed."@en ; dct:references ex:l8-matrix-ls-symbol-gradient ; cd:authoredResource true .
  ex:l8-matrix-differential-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-matrix-differential-legend-1, ex:l8-matrix-differential-legend-2, ex:l8-matrix-differential-legend-3, ex:l8-matrix-differential-legend-4, ex:l8-matrix-differential-legend-5, ex:l8-matrix-differential-legend-6, ex:l8-matrix-differential-legend-7, ex:l8-matrix-differential-legend-8, ex:l8-matrix-differential-legend-9, ex:l8-matrix-differential-legend-10, ex:l8-matrix-differential-legend-11 ; cd:authoredResource true .
  ex:l8-matrix-differential-formula a cd:MathExpression ; cd:latex "\\frac{\\partial Q}{\\partial\\beta}=2X^{\\mathsf T}X\\beta-2X^{\\mathsf T}y" ; cd:formulaLabel "The coefficient gradient"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-gradient a cd:MathSymbol ; cd:symbol "\\frac{\\partial Q}{\\partial\\beta}" ; cd:mathNotation "\\frac{\\partial Q}{\\partial\\beta}" ; cd:body "Column of partial derivatives, one for each coefficient. X and y stay fixed."@en ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Q"@en ; cd:body "Sum of squared residuals, in mV²."@en ; dct:references ex:l8-matrix-ls-symbol-Q ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "y"@en ; cd:body "Column of measured responses, in mV."@en ; dct:references ex:l8-matrix-ls-symbol-y ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "X"@en ; cd:body "Design matrix. The two columns contain ones and measured times."@en ; dct:references ex:l8-matrix-ls-symbol-X ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: swap rows and columns."@en ; dct:references ex:l8-matrix-ls-symbol-T ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\beta"@en ; cd:body "Coefficient column: intercept followed by slope."@en ; dct:references ex:l8-matrix-ls-symbol-b ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "+,-,=,\\cdot,2,0"@en ; cd:body "Addition, subtraction, equality and multiplication. Factors next to one another multiply. Zero denotes no contribution to the derivative."@en ; dct:references ex:l8-matrix-ls-symbol-ops ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-expand-squared-error-legend-1, ex:l8-expand-squared-error-legend-2, ex:l8-expand-squared-error-legend-3, ex:l8-expand-squared-error-legend-4, ex:l8-expand-squared-error-legend-5, ex:l8-expand-squared-error-legend-6, ex:l8-expand-squared-error-legend-7, ex:l8-expand-squared-error-legend-8, ex:l8-expand-squared-error-legend-9, ex:l8-expand-squared-error-legend-10 ; cd:authoredResource true .
  ex:l8-expand-squared-error-formula a cd:MathExpression ; cd:latex "\\begin{aligned}Q={}&y^{\\mathsf T}y-2\\beta^{\\mathsf T}X^{\\mathsf T}y\\\\ &+\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta\\end{aligned}" ; cd:formulaLabel "Three terms remain"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-normal-half-gradient a cd:MathExpression ; cd:latex "X^{\\mathsf T}X\\widehat\\beta-X^{\\mathsf T}y=0" ; cd:formulaLabel "Cancel the common factor 2"@en ; cd:hasSymbol ex:l8-symbol-beta, ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-Y, ex:l8-symbol-zero, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-C a cd:MathSymbol ; cd:symbol "C" ; cd:mathNotation "C" ; cd:body "A third matrix in the distributive rule, with dimensions compatible with the indicated addition and multiplication."@en ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-s a cd:MathSymbol ; cd:symbol "s" ; cd:mathNotation "s" ; cd:body "Scalar: a single real number, represented here by a 1 by 1 matrix."@en ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "A"@en ; cd:body "First matrix or column in the rule."@en ; dct:references ex:l8-matrix-ls-symbol-A ; cd:authoredResource true .
  ex:l8-matrix-squared-error-legend-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "B"@en ; cd:body "Second compatible matrix or column in the rule."@en ; dct:references ex:l8-matrix-ls-symbol-B ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "A"@en ; cd:body "First matrix or column in the rule."@en ; dct:references ex:l8-matrix-ls-symbol-A ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "B"@en ; cd:body "Second compatible matrix or column in the rule."@en ; dct:references ex:l8-matrix-ls-symbol-B ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "C"@en ; cd:body "Third compatible matrix in the distributive rule."@en ; dct:references ex:l8-matrix-ls-symbol-C ; cd:authoredResource true .
  ex:l8-expand-squared-error-legend-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "s"@en ; cd:body "Scalar: a single number, unchanged by transposition."@en ; dct:references ex:l8-matrix-ls-symbol-s ; cd:authoredResource true .
  ex:l8-sse-algebra-residual-product a cd:MathExpression ; cd:latex "\\begin{aligned}Q&=\\sum_{i=1}^{n}e_i^2=e^{\\mathsf T}e\\\\&=(y-X\\beta)^{\\mathsf T}(y-X\\beta)\\end{aligned}" ; cd:formulaLabel "Insert the residual column"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-e, ex:l8-matrix-ls-symbol-sum, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-matrix-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-separate-products a cd:MathExpression ; cd:latex "\\begin{aligned}Q={}&y^{\\mathsf T}y-y^{\\mathsf T}X\\beta\\\\ &-\\beta^{\\mathsf T}X^{\\mathsf T}y+\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta\\end{aligned}" ; cd:formulaLabel "Four products, in the original factor order"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-transpose a cd:MathExpression ; cd:latex "\\begin{aligned}(A-B)^{\\mathsf T}&=A^{\\mathsf T}-B^{\\mathsf T}\\\\(AB)^{\\mathsf T}&=B^{\\mathsf T}A^{\\mathsf T}\\end{aligned}" ; cd:formulaLabel "Transpose the difference term by term and reverse the product"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-A, ex:l8-matrix-ls-symbol-B, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-matrix-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-transpose-application a cd:MathExpression ; cd:latex "\\begin{aligned}(y-X\\beta)^{\\mathsf T}&=y^{\\mathsf T}-(X\\beta)^{\\mathsf T}\\\\&=y^{\\mathsf T}-\\beta^{\\mathsf T}X^{\\mathsf T}\\end{aligned}" ; cd:formulaLabel "Transform only the left bracket"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-matrix-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-distribution a cd:MathExpression ; cd:latex "\\begin{aligned}(A-B)C&=AC-BC\\\\A(B-C)&=AB-AC\\end{aligned}" ; cd:formulaLabel "Distribute from either side"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-A, ex:l8-matrix-ls-symbol-B, ex:l8-matrix-ls-symbol-C, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-distribution-application a cd:MathExpression ; cd:latex "(y^{\\mathsf T}-\\beta^{\\mathsf T}X^{\\mathsf T})(-X\\beta)=-y^{\\mathsf T}X\\beta+\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta" ; cd:formulaLabel "Follow the two products containing the right-hand minus term"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-scalar a cd:MathExpression ; cd:latex "\\begin{aligned}(AB)^{\\mathsf T}&=B^{\\mathsf T}A^{\\mathsf T}\\\\ s^{\\mathsf T}&=s\\quad\\text{for a scalar }s\\end{aligned}" ; cd:formulaLabel "Reverse the factors, then use that the product is a scalar"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-A, ex:l8-matrix-ls-symbol-B, ex:l8-matrix-ls-symbol-s, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-sse-algebra-scalar-application a cd:MathExpression ; cd:latex "\\begin{aligned}(y^{\\mathsf T}X\\beta)^{\\mathsf T}&=\\beta^{\\mathsf T}X^{\\mathsf T}(y^{\\mathsf T})^{\\mathsf T}=\\beta^{\\mathsf T}X^{\\mathsf T}y\\\\ (y^{\\mathsf T}X\\beta)^{\\mathsf T}&=y^{\\mathsf T}X\\beta\\end{aligned}" ; cd:formulaLabel "Same transpose, two ways to evaluate it"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-ops ; dct:hasPart ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-matrix-squared-error-transpose-rule a cd:MathematicalRule ; skos:prefLabel "Transpose the left bracket"@en ; cd:body "Transposing a difference preserves the minus sign. Transposing a product reverses the factors."@en ; cd:ruleFormula ex:l8-sse-algebra-transpose ; cd:authoredResource true .
  ex:l8-matrix-squared-error-transpose-explanation a cd:Interpretation ; cd:body "X times beta is a column. Its transpose is the row beta transpose times X transpose. The right bracket stays a column, so their product is still one number."@en ; cd:applicationFormula ex:l8-sse-algebra-transpose-application ; cd:authoredResource true .
  ex:l8-matrix-squared-error-transpose-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Transpose the left bracket"@en ; cd:fromFormula ex:l8-sse-algebra-residual-product ; cd:toFormula ex:l8-matrix-squared-error-formula ; cd:appliesRule ex:l8-matrix-squared-error-transpose-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-matrix-squared-error-transpose-explanation ; cd:authoredResource true .
  ex:l8-matrix-squared-error-derivation a cd:MathematicalDerivation ; skos:prefLabel "Least Squares: write squared error as a matrix product"@en ; cd:inputFormula ex:l8-sse-algebra-residual-product ; cd:resultFormula ex:l8-matrix-squared-error-formula ; cd:hasDerivationStep ex:l8-matrix-squared-error-transpose-step ; cd:authoredResource true .
  ex:l8-matrix-squared-error-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-matrix-squared-error-derivation ; cd:firstDerivationStep ex:l8-matrix-squared-error-transpose-step ; cd:lastDerivationStep ex:l8-matrix-squared-error-transpose-step ; cd:usesLegend ex:l8-matrix-squared-error-legend ; cd:authoredResource true .
  ex:l8-expand-squared-error-distribute-rule a cd:MathematicalRule ; skos:prefLabel "Distribute without swapping factors"@en ; cd:body "Matrix multiplication distributes over subtraction on both sides. Each term from the left bracket stays to the left of its partner from the right bracket."@en ; cd:ruleFormula ex:l8-sse-algebra-distribution ; cd:authoredResource true .
  ex:l8-expand-squared-error-distribute-explanation a cd:Interpretation ; cd:body "Read the two products generated by the second term in the right bracket. The product of the two minus terms gives the positive quadratic term."@en ; cd:applicationFormula ex:l8-sse-algebra-distribution-application ; cd:authoredResource true .
  ex:l8-expand-squared-error-distribute-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Distribute without swapping factors"@en ; cd:fromFormula ex:l8-matrix-squared-error-formula ; cd:toFormula ex:l8-sse-algebra-separate-products ; cd:appliesRule ex:l8-expand-squared-error-distribute-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-expand-squared-error-distribute-explanation ; cd:authoredResource true .
  ex:l8-expand-squared-error-combine-rule a cd:MathematicalRule ; skos:prefLabel "Combine the equal mixed terms"@en ; cd:body "Apply the product rule repeatedly to reverse all three factors. A separate fact lets us identify the values: a scalar is its own transpose."@en ; cd:ruleFormula ex:l8-sse-algebra-scalar ; cd:authoredResource true .
  ex:l8-expand-squared-error-combine-explanation a cd:Interpretation ; cd:body "In the first line, reverse the order and transpose each factor. The second transpose of y returns y. In the second line, the entire original product has shape 1 by 1, so transposing it leaves the value unchanged. The two right-hand sides are therefore equal."@en ; cd:applicationFormula ex:l8-sse-algebra-scalar-application ; cd:authoredResource true .
  ex:l8-expand-squared-error-combine-step a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Combine the equal mixed terms"@en ; cd:fromFormula ex:l8-sse-algebra-separate-products ; cd:toFormula ex:l8-expand-squared-error-formula ; cd:appliesRule ex:l8-expand-squared-error-combine-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-expand-squared-error-combine-explanation ; cd:authoredResource true .
  ex:l8-expand-squared-error-derivation a cd:MathematicalDerivation ; skos:prefLabel "Least Squares: expand the squared error"@en ; cd:inputFormula ex:l8-matrix-squared-error-formula ; cd:resultFormula ex:l8-expand-squared-error-formula ; cd:hasDerivationStep ex:l8-expand-squared-error-distribute-step, ex:l8-expand-squared-error-combine-step ; cd:authoredResource true .
  ex:l8-expand-squared-error-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-expand-squared-error-derivation ; cd:firstDerivationStep ex:l8-expand-squared-error-distribute-step ; cd:lastDerivationStep ex:l8-expand-squared-error-combine-step ; cd:usesLegend ex:l8-expand-squared-error-legend ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-gradient-c a cd:MathSymbol ; cd:symbol "c" ; cd:mathNotation "c" ; cd:body "Constant term. It is unchanged when the coefficients vary."@en ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "c"@en ; cd:body "Constant term. It is unchanged when the coefficients vary."@en ; dct:references ex:l8-matrix-ls-symbol-gradient-c ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-gradient-a a cd:MathSymbol ; cd:symbol "a" ; cd:mathNotation "a" ; cd:body "Fixed column of the same length as the coefficient column."@en ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "a"@en ; cd:body "Fixed column of the same length as the coefficient column."@en ; dct:references ex:l8-matrix-ls-symbol-gradient-a ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-gradient-M a cd:MathSymbol ; cd:symbol "M" ; cd:mathNotation "M" ; cd:body "Fixed square matrix. In this calculation M is the symmetric matrix X transpose X."@en ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-10 a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "M"@en ; cd:body "Fixed square matrix. In this calculation M is the symmetric matrix X transpose X."@en ; dct:references ex:l8-matrix-ls-symbol-gradient-M ; cd:authoredResource true .
  ex:l8-matrix-ls-symbol-gradient-increment a cd:MathSymbol ; cd:symbol "\\mathrm d\\beta,\\mathrm d(\\beta^{\\mathsf T}M\\beta)" ; cd:mathNotation "\\mathrm d\\beta,\\mathrm d(\\beta^{\\mathsf T}M\\beta)" ; cd:body "Coefficient increment and the resulting first-order change in the quadratic term."@en ; cd:authoredResource true .
  ex:l8-matrix-differential-legend-11 a cd:DefinitionListEntry ; cd:position 11 ; skos:prefLabel "\\mathrm d\\beta,\\mathrm d(\\beta^{\\mathsf T}M\\beta)"@en ; cd:body "Coefficient increment and the resulting first-order change in the quadratic term."@en ; dct:references ex:l8-matrix-ls-symbol-gradient-increment ; cd:authoredResource true .
  ex:l8-matrix-differential-unprocessed a cd:MathExpression ; cd:latex "\\begin{aligned}\\frac{\\partial Q}{\\partial\\beta}&=\\frac{\\partial}{\\partial\\beta}\\bigl[y^{\\mathsf T}y -2\\beta^{\\mathsf T}X^{\\mathsf T}y\\\\&\\qquad +\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta\\bigr]\\end{aligned}" ; cd:formulaLabel "Differentiate the expanded squared error"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-without-constant a cd:MathExpression ; cd:latex "\\frac{\\partial Q}{\\partial\\beta}=\\frac{\\partial}{\\partial\\beta}\\bigl[-2\\beta^{\\mathsf T}X^{\\mathsf T}y+\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta\\bigr]" ; cd:formulaLabel "The constant contributes zero"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-without-linear-derivative a cd:MathExpression ; cd:latex "\\frac{\\partial Q}{\\partial\\beta}=-2X^{\\mathsf T}y+\\frac{\\partial}{\\partial\\beta}\\bigl(\\beta^{\\mathsf T}X^{\\mathsf T}X\\beta\\bigr)" ; cd:formulaLabel "Evaluate the linear term"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-constant-rule-formula a cd:MathExpression ; cd:latex "\\frac{\\partial}{\\partial\\beta}c=0" ; cd:formulaLabel "Differentiate the constant"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-c ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-constant-application a cd:MathExpression ; cd:latex "\\frac{\\partial}{\\partial\\beta}(y^{\\mathsf T}y)=0" ; cd:formulaLabel "Apply the rule to the squared error"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-c ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-constant-rule a cd:MathematicalRule ; skos:prefLabel "Differentiate the constant"@en ; cd:body "A constant has derivative zero."@en ; cd:ruleFormula ex:l8-matrix-differential-constant-rule-formula ; cd:authoredResource true .
  ex:l8-matrix-differential-constant-explanation a cd:Interpretation ; cd:body "The vector y is measured before fitting. None of its entries changes when beta changes, so its squared length contributes zero."@en ; cd:applicationFormula ex:l8-matrix-differential-constant-application ; cd:authoredResource true .
  ex:l8-matrix-differential-constant-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Differentiate the constant"@en ; cd:fromFormula ex:l8-matrix-differential-unprocessed ; cd:toFormula ex:l8-matrix-differential-without-constant ; cd:appliesRule ex:l8-matrix-differential-constant-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-matrix-differential-constant-explanation ; cd:authoredResource true .
  ex:l8-matrix-differential-linear-rule-formula a cd:MathExpression ; cd:latex "\\frac{\\partial}{\\partial\\beta}(\\beta^{\\mathsf T}a)=a" ; cd:formulaLabel "Differentiate the linear term"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-a ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-linear-application a cd:MathExpression ; cd:latex "\\frac{\\partial}{\\partial\\beta}(-2\\beta^{\\mathsf T}X^{\\mathsf T}y)=-2X^{\\mathsf T}y" ; cd:formulaLabel "Apply the rule to the squared error"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-a ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-linear-rule a cd:MathematicalRule ; skos:prefLabel "Differentiate the linear term"@en ; cd:body "A dot product with a fixed column is a weighted sum of the coefficients. Each partial derivative picks out one weight."@en ; cd:ruleFormula ex:l8-matrix-differential-linear-rule-formula ; cd:authoredResource true .
  ex:l8-matrix-differential-linear-explanation a cd:Interpretation ; cd:body "Here the weights are the two entries of minus two X transpose y. Both X and y stay fixed as the coefficients change."@en ; cd:applicationFormula ex:l8-matrix-differential-linear-application ; cd:authoredResource true .
  ex:l8-matrix-differential-linear-step a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Differentiate the linear term"@en ; cd:fromFormula ex:l8-matrix-differential-without-constant ; cd:toFormula ex:l8-matrix-differential-without-linear-derivative ; cd:appliesRule ex:l8-matrix-differential-linear-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-matrix-differential-linear-explanation ; cd:authoredResource true .
  ex:l8-matrix-differential-quadratic-rule-formula a cd:MathExpression ; cd:latex "\\frac{\\partial}{\\partial\\beta}(\\beta^{\\mathsf T}M\\beta)=(M+M^{\\mathsf T})\\beta" ; cd:formulaLabel "Differentiate the two β factors"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-M, ex:l8-matrix-ls-symbol-gradient-increment ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-quadratic-application a cd:MathExpression ; cd:latex "\\begin{aligned}\\mathrm d(\\beta^{\\mathsf T}M\\beta)&=(\\mathrm d\\beta)^{\\mathsf T}M\\beta+\\beta^{\\mathsf T}M\\mathrm d\\beta\\\\&=\\bigl[(M+M^{\\mathsf T})\\beta\\bigr]^{\\mathsf T}\\mathrm d\\beta\\\\[.45em]M=X^{\\mathsf T}X=M^{\\mathsf T}&\\quad\\Longrightarrow\\quad \\frac{\\partial}{\\partial\\beta}(\\beta^{\\mathsf T}M\\beta)=2X^{\\mathsf T}X\\beta\\end{aligned}" ; cd:formulaLabel "Apply the rule to the squared error"@en ; cd:hasSymbol ex:l8-matrix-ls-symbol-Q, ex:l8-matrix-ls-symbol-y, ex:l8-matrix-ls-symbol-X, ex:l8-matrix-ls-symbol-T, ex:l8-matrix-ls-symbol-b, ex:l8-matrix-ls-symbol-ops, ex:l8-matrix-ls-symbol-gradient, ex:l8-matrix-ls-symbol-gradient-M, ex:l8-matrix-ls-symbol-gradient-increment ; dct:hasPart ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-matrix-differential-quadratic-rule a cd:MathematicalRule ; skos:prefLabel "Differentiate the two β factors"@en ; cd:body "The product rule changes one copy of beta at a time. Transpose the first scalar contribution to put the coefficient increment on the right."@en ; cd:ruleFormula ex:l8-matrix-differential-quadratic-rule-formula ; cd:authoredResource true .
  ex:l8-matrix-differential-quadratic-explanation a cd:Interpretation ; cd:body "The coefficient of the increment is the gradient. Because X transpose X is symmetric, M and M transpose are the same. The two contributions are therefore each X transpose X beta, which explains the factor two."@en ; cd:applicationFormula ex:l8-matrix-differential-quadratic-application ; cd:authoredResource true .
  ex:l8-matrix-differential-quadratic-step a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Differentiate the two β factors"@en ; cd:fromFormula ex:l8-matrix-differential-without-linear-derivative ; cd:toFormula ex:l8-matrix-differential-formula ; cd:appliesRule ex:l8-matrix-differential-quadratic-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-matrix-differential-quadratic-explanation ; cd:authoredResource true .
  ex:l8-matrix-differential-derivation a cd:MathematicalDerivation ; skos:prefLabel "Differentiate the squared error term by term"@en ; cd:inputFormula ex:l8-matrix-differential-unprocessed ; cd:resultFormula ex:l8-matrix-differential-formula ; cd:hasDerivationStep ex:l8-matrix-differential-constant-step, ex:l8-matrix-differential-linear-step, ex:l8-matrix-differential-quadratic-step ; cd:authoredResource true .
  ex:l8-matrix-differential-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-matrix-differential-derivation ; cd:firstDerivationStep ex:l8-matrix-differential-constant-step ; cd:lastDerivationStep ex:l8-matrix-differential-linear-step ; cd:usesLegend ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-normal-left-multiplied a cd:MathExpression ; cd:latex "\\begin{gathered}\\underbrace{(X^{\\mathsf T}X)^{-1}(X^{\\mathsf T}X)}_{\\text{inverse times matrix}}\\,\\widehat\\beta\\\\[.28em]=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\end{gathered}" ; cd:formulaLabel "Keep the left factors in order"@en ; cd:hasSymbol ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-beta, ex:l8-symbol-Y, ex:l8-symbol-ops, ex:l8-symbol-I ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-normal-inverse-generic-entry a cd:DefinitionListEntry ; cd:position 10 ; skos:prefLabel "A,u,v"@en ; cd:body "An invertible square matrix A and compatible columns u and v."@en ; dct:references ex:l8-normal-inverse-generic-symbol ; cd:authoredResource true .
  ex:l8-normal-inverse-generic-symbol a cd:MathSymbol ; cd:symbol "A,u,v" ; cd:mathNotation "A,u,v" ; cd:body "An invertible square matrix A and compatible columns u and v."@en ; cd:authoredResource true .
  ex:l8-normal-equal-products a cd:MathExpression ; cd:latex "Au=v\\quad\\Longrightarrow\\quad A^{-1}(Au)=A^{-1}v" ; cd:formulaLabel "Multiply both sides from the same side"@en ; cd:hasSymbol ex:l8-normal-inverse-generic-symbol, ex:l8-symbol-inv, ex:l8-symbol-ops ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-normal-identity-application a cd:MathExpression ; cd:latex "\\bigl[(X^{\\mathsf T}X)^{-1}(X^{\\mathsf T}X)\\bigr]\\widehat\\beta=I\\widehat\\beta=\\widehat\\beta" ; cd:formulaLabel "Group the adjacent factors first"@en ; cd:hasSymbol ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-beta, ex:l8-symbol-Y, ex:l8-symbol-ops, ex:l8-symbol-I ; dct:hasPart ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-normal-cancel-rule a cd:MathematicalRule ; skos:prefLabel "Cancel to the identity"@en ; cd:body "An inverse times its matrix is the identity. Multiplication by the identity preserves a compatible column."@en ; cd:ruleFormula ex:l8-normal-inverse-identity ; cd:authoredResource true .
  ex:l8-normal-cancel-explanation a cd:Interpretation ; cd:body "The inverse and its matrix are adjacent on the left. Group them by associativity, replace their product by I, and multiply I by the coefficient column. The right-hand side has no matching matrix factor to cancel."@en ; cd:applicationFormula ex:l8-normal-identity-application ; cd:authoredResource true .
  ex:l8-normal-cancel-step a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Cancel to the identity"@en ; cd:fromFormula ex:l8-normal-left-multiplied ; cd:toFormula ex:l8-direct-design-link ; cd:appliesRule ex:l8-normal-cancel-rule ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:l8-normal-cancel-explanation ; cd:authoredResource true .
  ex:l8-quadratic-gradient-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-matrix-differential-derivation ; cd:firstDerivationStep ex:l8-matrix-differential-quadratic-step ; cd:lastDerivationStep ex:l8-matrix-differential-quadratic-step ; cd:usesLegend ex:l8-matrix-differential-legend ; cd:authoredResource true .
  ex:l8-isolate-coefficients-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:l8-normal-from-residuals ; cd:firstDerivationStep ex:l8-normal-invert-step ; cd:lastDerivationStep ex:l8-normal-cancel-step ; cd:usesLegend ex:l8-direct-design-link-legend ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat\\beta"@en ; cd:body "Fitted coefficient column. For the drift line it contains the intercept in mV and slope in mV/min."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "X"@en ; cd:body "Design matrix. For a straight line, the two columns contain ones and the observed times."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "y"@en ; cd:body "Column of observed signals, each in mV."@en ; dct:references ex:l8-symbol-Y ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: interchange rows and columns."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "{}^{-1}"@en ; cd:body "Matrix inverse. Here it exists when the columns of X are linearly independent."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "=,\\cdot"@en ; cd:body "Equality and multiplication. Adjacent factors multiply in their written order."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-least-squares-solution-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-least-squares-solution-legend-1, ex:l8-least-squares-solution-legend-2, ex:l8-least-squares-solution-legend-3, ex:l8-least-squares-solution-legend-4, ex:l8-least-squares-solution-legend-5, ex:l8-least-squares-solution-legend-6 ; cd:authoredResource true .
  ex:l8-least-squares-solution-formula a cd:MathExpression ; cd:latex "\\boxed{\\widehat\\beta=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y}" ; cd:formulaLabel "For linearly independent columns of X"@en ; cd:hasSymbol ex:l8-symbol-beta, ex:l8-symbol-X, ex:l8-symbol-Y, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-ops ; dct:hasPart ex:l8-least-squares-solution-legend ; cd:authoredResource true .
  ex:l8-symbol-gram-columns a cd:MathSymbol ; cd:symbol "\\mathbf{1},x" ; cd:mathNotation "\\mathbf{1},x" ; cd:body "The column of five ones and the column of five inputs."@en ; cd:authoredResource true .
  ex:l8-basis-gram-columns-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X"@en ; cd:body "Design matrix. Here it has five rows and columns 1 and x."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
  ex:l8-basis-gram-columns-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose swaps rows and columns."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-basis-gram-columns-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\mathbf{1},x"@en ; cd:body "Five ones and the five inputs 0, 1, 2, 3, 4."@en ; dct:references ex:l8-symbol-gram-columns ; cd:authoredResource true .
  ex:l8-basis-gram-columns-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "=,\\cdot"@en ; cd:body "Equality and matrix multiplication. Each entry sums the products of one row and one column."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-basis-gram-columns-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-basis-gram-columns-legend-1, ex:l8-basis-gram-columns-legend-2, ex:l8-basis-gram-columns-legend-3, ex:l8-basis-gram-columns-legend-4 ; cd:authoredResource true .
  ex:l8-basis-gram-columns-formula a cd:MathExpression ; cd:latex "\\begin{aligned}X&=\\begin{bmatrix}\\mathbf{1}&x\\end{bmatrix}\\\\[.55em]X^{\\mathsf T}X&=\\begin{bmatrix}\\mathbf{1}^{\\mathsf T}\\mathbf{1}&\\mathbf{1}^{\\mathsf T}x\\\\ x^{\\mathsf T}\\mathbf{1}&x^{\\mathsf T}x\\end{bmatrix}=\\begin{bmatrix}5&10\\\\10&30\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Use the five inputs from the straight-line example"@en ; cd:hasSymbol ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-gram-columns, ex:l8-symbol-ops ; dct:hasPart ex:l8-basis-gram-columns-legend ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-symbol-x a cd:MathSymbol ; cd:symbol "x" ; cd:mathNotation "x" ; cd:body "Known dimensionless input. Its transformed values form a design column."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "x"@en ; cd:body "Known dimensionless input. Its transformed values form a design column."@en ; dct:references ex:l8-fixed-basis-coefficients-symbol-x ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-symbol-coefficients a cd:MathSymbol ; cd:symbol "b_2,b_4" ; cd:mathNotation "b_2,b_4" ; cd:body "Unknown model coefficients. The subscripts distinguish the examples."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "b_2,b_4"@en ; cd:body "Unknown model coefficients. The subscripts distinguish the examples."@en ; dct:references ex:l8-fixed-basis-coefficients-symbol-coefficients ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-symbol-u a cd:MathSymbol ; cd:symbol "u" ; cd:mathNotation "u" ; cd:body "New coefficient equal to exp(b₂). It must be positive to correspond to a real b₂."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "u"@en ; cd:body "New coefficient equal to exp(b₂). It must be positive to correspond to a real b₂."@en ; dct:references ex:l8-fixed-basis-coefficients-symbol-u ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-symbol-functions a cd:MathSymbol ; cd:symbol "\\sinh,\\exp" ; cd:mathNotation "\\sinh,\\exp" ; cd:body "Hyperbolic sine and exponential functions."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "\\sinh,\\exp"@en ; cd:body "Hyperbolic sine and exponential functions."@en ; dct:references ex:l8-fixed-basis-coefficients-symbol-functions ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-symbol-operators a cd:MathSymbol ; cd:symbol "+,=,>,0" ; cd:mathNotation "+,=,>,0" ; cd:body "Addition, equality, and greater than zero. Juxtaposition indicates multiplication."@en ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "+,=,>,0"@en ; cd:body "Addition, equality, and greater than zero. Juxtaposition indicates multiplication."@en ; dct:references ex:l8-fixed-basis-coefficients-symbol-operators ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-fixed-basis-coefficients-legend-1, ex:l8-fixed-basis-coefficients-legend-2, ex:l8-fixed-basis-coefficients-legend-3, ex:l8-fixed-basis-coefficients-legend-4, ex:l8-fixed-basis-coefficients-legend-5 ; cd:authoredResource true .
  ex:l8-fixed-basis-coefficients-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\text{Fixed column:}&\\quad b_4\\sinh(x),\\quad b_2\\exp(x)\\\\[.55em]\\text{Column depends on coefficient:}&\\quad \\sinh(xb_4),\\quad \\exp(xb_2)\\\\[.55em]\\text{Reparameterise:}&\\quad \\exp(x+b_2)=\\exp(b_2)\\exp(x)\\\\[.25em]&\\quad =\\underbrace{u}_{\\text{linear coefficient}}\\,\\exp(x),\\qquad u=\\exp(b_2)>0\\end{aligned}" ; cd:formulaLabel "Look at where the unknown coefficient enters"@en ; cd:hasSymbol ex:l8-fixed-basis-coefficients-symbol-x, ex:l8-fixed-basis-coefficients-symbol-coefficients, ex:l8-fixed-basis-coefficients-symbol-u, ex:l8-fixed-basis-coefficients-symbol-functions, ex:l8-fixed-basis-coefficients-symbol-operators ; dct:hasPart ex:l8-fixed-basis-coefficients-legend ; cd:authoredResource true .
  ex:l8-basis-column-limit-symbol-1 a cd:MathSymbol ; cd:symbol "n" ; cd:mathNotation "n" ; cd:body "Number of observation rows."@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "n"@en ; cd:body "Number of observation rows."@en ; dct:references ex:l8-basis-column-limit-symbol-1 ; cd:authoredResource true .
  ex:l8-basis-column-limit-symbol-2 a cd:MathSymbol ; cd:symbol "p" ; cd:mathNotation "p" ; cd:body "Number of fitted coefficient columns, including the intercept if present."@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "p"@en ; cd:body "Number of fitted coefficient columns, including the intercept if present."@en ; dct:references ex:l8-basis-column-limit-symbol-2 ; cd:authoredResource true .
  ex:l8-basis-column-limit-symbol-3 a cd:MathSymbol ; cd:symbol "\\mathrm{df}_{\\mathrm{res}}" ; cd:mathNotation "\\mathrm{df}_{\\mathrm{res}}" ; cd:body "Residual degrees of freedom: the number of observation directions left after fitting independent columns."@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\mathrm{df}_{\\mathrm{res}}"@en ; cd:body "Residual degrees of freedom: the number of observation directions left after fitting independent columns."@en ; dct:references ex:l8-basis-column-limit-symbol-3 ; cd:authoredResource true .
  ex:l8-basis-column-limit-symbol-4 a cd:MathSymbol ; cd:symbol "=,-,\\leq" ; cd:mathNotation "=,-,\\leq" ; cd:body "Equality, subtraction, and less than or equal to."@en ; cd:authoredResource true .
  ex:l8-basis-column-limit-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "=,-,\\leq"@en ; cd:body "Equality, subtraction, and less than or equal to."@en ; dct:references ex:l8-basis-column-limit-symbol-4 ; cd:authoredResource true .
  ex:l8-basis-column-limit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-basis-column-limit-legend-1, ex:l8-basis-column-limit-legend-2, ex:l8-basis-column-limit-legend-3, ex:l8-basis-column-limit-legend-4 ; cd:authoredResource true .
  ex:l8-basis-column-limit-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\mathrm{df}_{\\mathrm{res}}&=n-p\\qquad\\text{for independent columns}\\\\[.5em]n=5,\\ p=4&:\\quad 5-4=1 \\quad\\text{residual degree left}\\\\[.35em]n=5,\\ p=5&:\\quad 5-5=0 \\quad\\text{exact interpolation}\\\\[.35em]n=5,\\ p=7&:\\quad \\text{no unique coefficient fit}\\end{aligned}" ; cd:formulaLabel "Five rows, three column counts"@en ; cd:hasSymbol ex:l8-basis-column-limit-symbol-1, ex:l8-basis-column-limit-symbol-2, ex:l8-basis-column-limit-symbol-3, ex:l8-basis-column-limit-symbol-4 ; dct:hasPart ex:l8-basis-column-limit-legend ; cd:authoredResource true .
  ex:l8-gram-symbol-e a cd:MathSymbol ; cd:symbol "e" ; cd:mathNotation "e" ; cd:body "Column of all residuals, one per observation."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-X a cd:MathSymbol ; cd:symbol "X" ; cd:mathNotation "X" ; cd:body "Design matrix whose columns are 1, x and the square root of x."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-c a cd:MathSymbol ; cd:symbol "c_j,c_k,j,k" ; cd:mathNotation "c_j,c_k,j,k" ; cd:body "Design columns j and k. Here column 1 contains ones, column 2 contains x and column 3 contains square roots."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-T a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T}" ; cd:mathNotation "{}^{\\mathsf T}" ; cd:body "Transpose, interchanging rows and columns."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-idx a cd:MathSymbol ; cd:symbol "e_i,c_{ij},i,n" ; cd:mathNotation "e_i,c_{ij},i,n" ; cd:body "Residual at row i and entry at row i of design column j. The row index runs from 1 to the sample count n."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-sum a cd:MathSymbol ; cd:symbol "\\sum_{i=1}^{n}" ; cd:mathNotation "\\sum_{i=1}^{n}" ; cd:body "Add across all n observation rows."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-mean a cd:MathSymbol ; cd:symbol "\\overline{x},\\overline{\\sqrt{x}}" ; cd:mathNotation "\\overline{x},\\overline{\\sqrt{x}}" ; cd:body "Arithmetic means of the input and square-root columns."@en ; cd:authoredResource true .
  ex:l8-gram-symbol-ops a cd:MathSymbol ; cd:symbol "+,=,\\cdot" ; cd:mathNotation "+,=,\\cdot" ; cd:body "Addition, equality and multiplication. Juxtaposition multiplies, and a power of 2 squares the term."@en ; cd:authoredResource true .
  ex:l8-gram-rule-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "e"@en ; cd:body "Column of all residuals, one per observation."@en ; dct:references ex:l8-gram-symbol-e ; cd:authoredResource true .
  ex:l8-gram-rule-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "X"@en ; cd:body "Design matrix whose columns are 1, x and the square root of x."@en ; dct:references ex:l8-gram-symbol-X ; cd:authoredResource true .
  ex:l8-gram-rule-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, interchanging rows and columns."@en ; dct:references ex:l8-gram-symbol-T ; cd:authoredResource true .
  ex:l8-gram-rule-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "c_j,c_k,j,k"@en ; cd:body "Design columns j and k. Here column 1 contains ones, column 2 contains x and column 3 contains square roots."@en ; dct:references ex:l8-gram-symbol-c ; cd:authoredResource true .
  ex:l8-gram-rule-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "e_i,c_{ij},i,n"@en ; cd:body "Residual at row i and entry at row i of design column j. The row index runs from 1 to the sample count n."@en ; dct:references ex:l8-gram-symbol-idx ; cd:authoredResource true .
  ex:l8-gram-rule-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "\\sum_{i=1}^{n}"@en ; cd:body "Add across all n observation rows."@en ; dct:references ex:l8-gram-symbol-sum ; cd:authoredResource true .
  ex:l8-gram-rule-legend-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "+,=,\\cdot"@en ; cd:body "Addition, equality and multiplication. Juxtaposition multiplies, and a power of 2 squares the term."@en ; dct:references ex:l8-gram-symbol-ops ; cd:authoredResource true .
  ex:l8-gram-rule-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-gram-rule-legend-1, ex:l8-gram-rule-legend-2, ex:l8-gram-rule-legend-3, ex:l8-gram-rule-legend-4, ex:l8-gram-rule-legend-5, ex:l8-gram-rule-legend-6, ex:l8-gram-rule-legend-7 ; cd:authoredResource true .
  ex:l8-gram-rule-formula a cd:MathExpression ; cd:latex "\\begin{aligned}e^{\\mathsf T}e&=\\sum_{i=1}^n e_i^2 &&\\text{one column, one squared length}\\\\[.65em](X^{\\mathsf T}X)_{jk}&=c_j^{\\mathsf T}c_k=\\sum_{i=1}^n c_{ij}c_{ik} &&\\text{one entry for every column pair}\\end{aligned}" ; cd:formulaLabel "A row of the transpose is one original design column"@en ; cd:hasSymbol ex:l8-gram-symbol-e, ex:l8-gram-symbol-X, ex:l8-gram-symbol-T, ex:l8-gram-symbol-c, ex:l8-gram-symbol-idx, ex:l8-gram-symbol-sum, ex:l8-gram-symbol-ops ; dct:hasPart ex:l8-gram-rule-legend ; cd:authoredResource true .
  ex:l8-gram-worked-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "c_j,c_k,j,k"@en ; cd:body "Design columns j and k. Here column 1 contains ones, column 2 contains x and column 3 contains square roots."@en ; dct:references ex:l8-gram-symbol-c ; cd:authoredResource true .
  ex:l8-gram-worked-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, interchanging rows and columns."@en ; dct:references ex:l8-gram-symbol-T ; cd:authoredResource true .
  ex:l8-gram-worked-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "X"@en ; cd:body "Design matrix whose columns are 1, x and the square root of x."@en ; dct:references ex:l8-gram-symbol-X ; cd:authoredResource true .
  ex:l8-gram-worked-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "+,=,\\cdot"@en ; cd:body "Addition, equality and multiplication. Juxtaposition multiplies, and a power of 2 squares the term."@en ; dct:references ex:l8-gram-symbol-ops ; cd:authoredResource true .
  ex:l8-gram-worked-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-gram-worked-legend-1, ex:l8-gram-worked-legend-2, ex:l8-gram-worked-legend-3, ex:l8-gram-worked-legend-4 ; cd:authoredResource true .
  ex:l8-gram-worked-formula a cd:MathExpression ; cd:latex "\\begin{aligned}c_2^{\\mathsf T}c_2&=1^2+4^2+9^2+16^2+25^2=979\\\\[.35em]c_2^{\\mathsf T}c_3&=1\\cdot1+4\\cdot2+9\\cdot3+16\\cdot4+25\\cdot5=225\\\\[.5em]X^{\\mathsf T}X&=\\begin{bmatrix}5&55&15\\\\55&979&225\\\\15&225&55\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Row and column order: constant, x, square root of x"@en ; cd:hasSymbol ex:l8-gram-symbol-c, ex:l8-gram-symbol-T, ex:l8-gram-symbol-X, ex:l8-gram-symbol-ops ; dct:hasPart ex:l8-gram-worked-legend ; cd:authoredResource true .
  ex:l8-xty-symbol-y a cd:MathSymbol ; cd:symbol "y" ; cd:mathNotation "y" ; cd:body "Column of measured responses in the same order as the rows of X."@en ; cd:authoredResource true .
  ex:l8-xty-worked-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X"@en ; cd:body "Design matrix from the previous slides. Its columns are ones, x and the square root of x."@en ; dct:references ex:l8-gram-symbol-X ; cd:authoredResource true .
  ex:l8-xty-worked-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, which swaps rows and columns. Each row of X transpose is one design column."@en ; dct:references ex:l8-gram-symbol-T ; cd:authoredResource true .
  ex:l8-xty-worked-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "y"@en ; cd:body "Column of five example measurements, in the same row order as the inputs."@en ; dct:references ex:l8-xty-symbol-y ; cd:authoredResource true .
  ex:l8-xty-worked-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "c_2"@en ; cd:body "The second design column, containing the five values of x."@en ; dct:references ex:l8-gram-symbol-c ; cd:authoredResource true .
  ex:l8-xty-worked-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "+,=,\\cdot"@en ; cd:body "Addition, equality and multiplication. A dot or juxtaposition denotes multiplication."@en ; dct:references ex:l8-gram-symbol-ops ; cd:authoredResource true .
  ex:l8-xty-worked-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-xty-worked-legend-1, ex:l8-xty-worked-legend-2, ex:l8-xty-worked-legend-3, ex:l8-xty-worked-legend-4, ex:l8-xty-worked-legend-5 ; cd:authoredResource true .
  ex:l8-xty-worked-formula a cd:MathExpression ; cd:latex "\\begin{aligned}X^{\\mathsf T}y&=\\begin{bmatrix}1&1&1&1&1\\\\1&4&9&16&25\\\\1&2&3&4&5\\end{bmatrix}\\begin{bmatrix}2\\\\3\\\\5\\\\6\\\\9\\end{bmatrix}=\\begin{bmatrix}25\\\\380\\\\92\\end{bmatrix}\\\\[.6em]c_2^{\\mathsf T}y&=1\\cdot2+4\\cdot3+9\\cdot5+16\\cdot6+25\\cdot9=380\\end{aligned}" ; cd:formulaLabel "Pair each design column with the same five observed responses"@en ; cd:hasSymbol ex:l8-gram-symbol-X, ex:l8-gram-symbol-T, ex:l8-xty-symbol-y, ex:l8-gram-symbol-c, ex:l8-gram-symbol-ops ; dct:hasPart ex:l8-xty-worked-legend ; cd:authoredResource true .
  ex:l8-inverse-symbol-X a cd:MathSymbol ; cd:symbol "X" ; cd:mathNotation "X" ; cd:body "Design matrix. Columns contain the chosen model terms evaluated at each input row."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-y a cd:MathSymbol ; cd:symbol "y" ; cd:mathNotation "y" ; cd:body "Column of measured responses."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-T a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T}" ; cd:mathNotation "{}^{\\mathsf T}" ; cd:body "Transpose, which swaps rows and columns."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-b a cd:MathSymbol ; cd:symbol "\\widehat\\beta" ; cd:mathNotation "\\widehat\\beta" ; cd:body "Column of fitted coefficients."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-inv a cd:MathSymbol ; cd:symbol "{}^{-1}" ; cd:mathNotation "{}^{-1}" ; cd:body "Matrix inverse, defined when the matrix is invertible."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-ops a cd:MathSymbol ; cd:symbol "=,\\ne,\\approx,\\cdot" ; cd:mathNotation "=,\\ne,\\approx,\\cdot" ; cd:body "Equality, inequality, approximation and multiplication. Juxtaposed factors multiply in their written order."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-G a cd:MathSymbol ; cd:symbol "G" ; cd:mathNotation "G" ; cd:body "Gram matrix X transpose X. It is symmetric positive definite if the columns of X are independent."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-r a cd:MathSymbol ; cd:symbol "r" ; cd:mathNotation "r" ; cd:body "Right-hand side of the normal equation, X transpose y."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-I a cd:MathSymbol ; cd:symbol "I" ; cd:mathNotation "I" ; cd:body "Identity matrix, which leaves a compatible column unchanged."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-entries a cd:MathSymbol ; cd:symbol "a,b,c,d" ; cd:mathNotation "a,b,c,d" ; cd:body "Entries of an arbitrary two-by-two matrix, read row by row."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-G2 a cd:MathSymbol ; cd:symbol "G_2" ; cd:mathNotation "G_2" ; cd:body "Gram matrix for the reduced design containing only the constant and x columns."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-det a cd:MathSymbol ; cd:symbol "\\det(G_2)" ; cd:mathNotation "\\det(G_2)" ; cd:body "Determinant of the two-by-two Gram matrix. A nonzero value permits inversion."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-L a cd:MathSymbol ; cd:symbol "L" ; cd:mathNotation "L" ; cd:body "Lower-triangular Cholesky factor, with positive diagonal and zeros above it. Its displayed entries are rounded."@en ; cd:authoredResource true .
  ex:l8-inverse-symbol-z a cd:MathSymbol ; cd:symbol "z" ; cd:mathNotation "z" ; cd:body "Intermediate column obtained by solving Lz = r."@en ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat\\beta"@en ; cd:body "Column of fitted coefficients."@en ; dct:references ex:l8-inverse-symbol-b ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "X"@en ; cd:body "Design matrix. Columns contain the chosen model terms evaluated at each input row."@en ; dct:references ex:l8-inverse-symbol-X ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, which swaps rows and columns."@en ; dct:references ex:l8-inverse-symbol-T ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "y"@en ; cd:body "Column of measured responses."@en ; dct:references ex:l8-inverse-symbol-y ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "{}^{-1}"@en ; cd:body "Matrix inverse, defined when the matrix is invertible."@en ; dct:references ex:l8-inverse-symbol-inv ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "=,\\ne,\\approx,\\cdot"@en ; cd:body "Equality, inequality, approximation and multiplication. Juxtaposed factors multiply in their written order."@en ; dct:references ex:l8-inverse-symbol-ops ; cd:authoredResource true .
  ex:l8-inverse-remaining-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-inverse-remaining-legend-1, ex:l8-inverse-remaining-legend-2, ex:l8-inverse-remaining-legend-3, ex:l8-inverse-remaining-legend-4, ex:l8-inverse-remaining-legend-5, ex:l8-inverse-remaining-legend-6 ; cd:authoredResource true .
  ex:l8-inverse-remaining-formula a cd:MathExpression ; cd:latex "\\widehat\\beta=\\underbrace{(\\overbrace{\\textcolor{teal}{X^{\\mathsf T}X}}^{\\textcolor{teal}{\\text{computed}}})^{\\textcolor{brown}{-1}}}_{\\textcolor{brown}{\\text{inverse still missing}}}\\;\\underbrace{\\textcolor{purple}{X^{\\mathsf T}y}}_{\\textcolor{purple}{\\text{computed}}}" ; cd:formulaLabel "The two products are already available"@en ; cd:hasSymbol ex:l8-inverse-symbol-b, ex:l8-inverse-symbol-X, ex:l8-inverse-symbol-T, ex:l8-inverse-symbol-y, ex:l8-inverse-symbol-inv, ex:l8-inverse-symbol-ops ; dct:hasPart ex:l8-inverse-remaining-legend ; cd:authoredResource true .
  ex:l8-drift-fit-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat\\beta"@en ; cd:body "Fitted coefficients in order: intercept in mV, then slope in mV/min."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-drift-fit-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "X"@en ; cd:body "Design matrix. Its columns are five ones and the measured times 0, 1, 2, 3 and 4 in minutes."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
  ex:l8-drift-fit-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "y"@en ; cd:body "The five detector readings 1.10, 2.80, 5.20, 6.90 and 9.00 in mV."@en ; dct:references ex:l8-symbol-Y ; cd:authoredResource true .
  ex:l8-drift-fit-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose, which swaps rows and columns."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-drift-fit-legend-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "{}^{-1}"@en ; cd:body "Matrix inverse. For this two-by-two matrix the determinant is 50."@en ; dct:references ex:l8-symbol-inv ; cd:authoredResource true .
  ex:l8-drift-fit-legend-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "=,\\cdot"@en ; cd:body "Equality and multiplication. Adjacent matrices or columns multiply in the written order."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-drift-fit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-drift-fit-legend-1, ex:l8-drift-fit-legend-2, ex:l8-drift-fit-legend-3, ex:l8-drift-fit-legend-4, ex:l8-drift-fit-legend-5, ex:l8-drift-fit-legend-6 ; cd:authoredResource true .
  ex:l8-drift-fit-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat\\beta&=\\underbrace{\\textcolor{teal}{\\begin{bmatrix}5&10\\\\10&30\\end{bmatrix}}^{\\textcolor{brown}{-1}}}_{\\text{inverse of }X^{\\mathsf T}X}\\quad\\underbrace{\\textcolor{purple}{\\begin{bmatrix}25\\\\69.9\\end{bmatrix}}}_{X^{\\mathsf T}y}\\\\[.7em]&=\\textcolor{brown}{\\frac{1}{50}\\begin{bmatrix}30&-10\\\\-10&5\\end{bmatrix}}\\textcolor{purple}{\\begin{bmatrix}25\\\\69.9\\end{bmatrix}}=\\begin{bmatrix}1.02\\\\1.99\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Apply the 2 × 2 inverse to the response cross-products"@en ; cd:hasSymbol ex:l8-symbol-beta, ex:l8-symbol-X, ex:l8-symbol-Y, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-ops ; dct:hasPart ex:l8-drift-fit-legend ; cd:authoredResource true .
  ex:l8-log-decay-transform-symbol-1 a cd:MathSymbol ; cd:symbol "C_i,C_{i+1},C_*" ; cd:mathNotation "C_i,C_{i+1},C_*" ; cd:body "Current and next positive concentrations in mg/L. The reference C* is 1 mg/L, so the ratios have no unit."@en ; cd:authoredResource true .
  ex:l8-log-decay-transform-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "C_i,C_{i+1},C_*"@en ; cd:body "Current and next positive concentrations in mg/L. The reference C* is 1 mg/L, so the ratios have no unit."@en ; dct:references ex:l8-log-decay-transform-symbol-1 ; cd:authoredResource true .
  ex:l8-log-decay-transform-symbol-2 a cd:MathSymbol ; cd:symbol "z_i,z_{i+1},z_1" ; cd:mathNotation "z_i,z_{i+1},z_1" ; cd:body "Unitless log responses. Index i marks the current sample, i+1 the next and 1 the first."@en ; cd:authoredResource true .
  ex:l8-log-decay-transform-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "z_i,z_{i+1},z_1"@en ; cd:body "Unitless log responses. Index i marks the current sample, i+1 the next and 1 the first."@en ; dct:references ex:l8-log-decay-transform-symbol-2 ; cd:authoredResource true .
  ex:l8-log-decay-transform-symbol-3 a cd:MathSymbol ; cd:symbol "\\ln" ; cd:mathNotation "\\ln" ; cd:body "Natural logarithm of a positive dimensionless ratio."@en ; cd:authoredResource true .
  ex:l8-log-decay-transform-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\ln"@en ; cd:body "Natural logarithm of a positive dimensionless ratio."@en ; dct:references ex:l8-log-decay-transform-symbol-3 ; cd:authoredResource true .
  ex:l8-log-decay-transform-symbol-4 a cd:MathSymbol ; cd:symbol "=,-,\\approx" ; cd:mathNotation "=,-,\\approx" ; cd:body "Equals, subtraction and approximately equals. Fraction bars divide. In the example, 19.60 and 1.00 are concentrations in the same unit."@en ; cd:authoredResource true .
  ex:l8-log-decay-transform-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "=,-,\\approx"@en ; cd:body "Equals, subtraction and approximately equals. Fraction bars divide. In the example, 19.60 and 1.00 are concentrations in the same unit."@en ; dct:references ex:l8-log-decay-transform-symbol-4 ; cd:authoredResource true .
  ex:l8-log-decay-transform-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-log-decay-transform-legend-1, ex:l8-log-decay-transform-legend-2, ex:l8-log-decay-transform-legend-3, ex:l8-log-decay-transform-legend-4 ; cd:authoredResource true .
  ex:l8-log-decay-transform-formula a cd:MathExpression ; cd:latex "\\begin{aligned} z_i &= \\ln\\!\\left(\\frac{C_i}{C_*}\\right) & z_1 &\\approx \\ln\\!\\left(\\frac{19.60}{1.00}\\right) \\approx 2.98 \\\\[.65em] z_{i+1}-z_i &= \\ln\\!\\left(\\frac{C_{i+1}}{C_i}\\right) && \\end{aligned}" ; cd:formulaLabel "Log-transform the response and keep time in minutes"@en ; cd:hasSymbol ex:l8-log-decay-transform-symbol-1, ex:l8-log-decay-transform-symbol-2, ex:l8-log-decay-transform-symbol-3, ex:l8-log-decay-transform-symbol-4 ; dct:hasPart ex:l8-log-decay-transform-legend ; cd:authoredResource true .
  ex:l8-log-decay-fit-symbol-1 a cd:MathSymbol ; cd:symbol "\\widehat z,\\widehat C" ; cd:mathNotation "\\widehat z,\\widehat C" ; cd:body "Fitted log response (unitless) and fitted concentration (mg/L). Hats mark fitted values."@en ; cd:authoredResource true .
  ex:l8-log-decay-fit-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat z,\\widehat C"@en ; cd:body "Fitted log response (unitless) and fitted concentration (mg/L). Hats mark fitted values."@en ; dct:references ex:l8-log-decay-fit-symbol-1 ; cd:authoredResource true .
  ex:l8-log-decay-fit-symbol-2 a cd:MathSymbol ; cd:symbol "C_*,t" ; cd:mathNotation "C_*,t" ; cd:body "Reference concentration of 1 mg/L and time in minutes. The log-scale intercept is ln(20); slope is −0.40 per minute."@en ; cd:authoredResource true .
  ex:l8-log-decay-fit-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "C_*,t"@en ; cd:body "Reference concentration of 1 mg/L and time in minutes. The log-scale intercept is ln(20); slope is −0.40 per minute."@en ; dct:references ex:l8-log-decay-fit-symbol-2 ; cd:authoredResource true .
  ex:l8-log-decay-fit-symbol-3 a cd:MathSymbol ; cd:symbol "\\ln,\\exp" ; cd:mathNotation "\\ln,\\exp" ; cd:body "Natural logarithm and its inverse, the exponential. Both function arguments are dimensionless."@en ; cd:authoredResource true .
  ex:l8-log-decay-fit-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\ln,\\exp"@en ; cd:body "Natural logarithm and its inverse, the exponential. Both function arguments are dimensionless."@en ; dct:references ex:l8-log-decay-fit-symbol-3 ; cd:authoredResource true .
  ex:l8-log-decay-fit-symbol-4 a cd:MathSymbol ; cd:symbol "=,-,{}^{-1}" ; cd:mathNotation "=,-,{}^{-1}" ; cd:body "Equality and subtraction. A min⁻¹ unit means per minute. Adjacent factors multiply."@en ; cd:authoredResource true .
  ex:l8-log-decay-fit-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "=,-,{}^{-1}"@en ; cd:body "Equality and subtraction. A min⁻¹ unit means per minute. Adjacent factors multiply."@en ; dct:references ex:l8-log-decay-fit-symbol-4 ; cd:authoredResource true .
  ex:l8-log-decay-fit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-log-decay-fit-legend-1, ex:l8-log-decay-fit-legend-2, ex:l8-log-decay-fit-legend-3, ex:l8-log-decay-fit-legend-4 ; cd:authoredResource true .
  ex:l8-log-decay-fit-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat z(t)&=\\ln(20)-0.40\\,\\mathrm{min}^{-1}t\\\\[.5em]\\widehat C(t)&=C_*\\exp\\!\\bigl(\\widehat z(t)\\bigr)\\\\&=20\\,\\mathrm{mg/L}\\,\\exp\\!\\bigl(-0.40\\,\\mathrm{min}^{-1}t\\bigr)\\end{aligned}" ; cd:formulaLabel "Fit the log response, then undo the logarithm"@en ; cd:hasSymbol ex:l8-log-decay-fit-symbol-1, ex:l8-log-decay-fit-symbol-2, ex:l8-log-decay-fit-symbol-3, ex:l8-log-decay-fit-symbol-4 ; dct:hasPart ex:l8-log-decay-fit-legend ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-symbol-1 a cd:MathSymbol ; cd:symbol "\\widehat y,D_B,D_C" ; cd:mathNotation "\\widehat y,D_B,D_C" ; cd:body "Fitted recovery in %. Dummy columns D_B and D_C equal 1 for their named method and 0 otherwise. Both are zero for method A."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat y,D_B,D_C"@en ; cd:body "Fitted recovery in %. Dummy columns D_B and D_C equal 1 for their named method and 0 otherwise. Both are zero for method A."@en ; dct:references ex:l8-anova-recovery-fit-symbol-1 ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-symbol-2 a cd:MathSymbol ; cd:symbol "94,4,1" ; cd:mathNotation "94,4,1" ; cd:body "The fitted baseline is 94%. Method B adds 4 percentage points and method C subtracts 1 percentage point."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "94,4,1"@en ; cd:body "The fitted baseline is 94%. Method B adds 4 percentage points and method C subtracts 1 percentage point."@en ; dct:references ex:l8-anova-recovery-fit-symbol-2 ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-symbol-3 a cd:MathSymbol ; cd:symbol "F,114,30,2,15" ; cd:mathNotation "F,114,30,2,15" ; cd:body "F compares residual sums of squares 114 (intercept only) and 30 (with method). The models differ by 2 degrees of freedom; the larger model has 15 residual degrees of freedom."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "F,114,30,2,15"@en ; cd:body "F compares residual sums of squares 114 (intercept only) and 30 (with method). The models differ by 2 degrees of freedom; the larger model has 15 residual degrees of freedom."@en ; dct:references ex:l8-anova-recovery-fit-symbol-3 ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-symbol-4 a cd:MathSymbol ; cd:symbol "+,-,=" ; cd:mathNotation "+,-,=" ; cd:body "Add, subtract and equal. Fraction bars divide. Parentheses group terms and adjacent factors multiply."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "+,-,="@en ; cd:body "Add, subtract and equal. Fraction bars divide. Parentheses group terms and adjacent factors multiply."@en ; dct:references ex:l8-anova-recovery-fit-symbol-4 ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-anova-recovery-fit-legend-1, ex:l8-anova-recovery-fit-legend-2, ex:l8-anova-recovery-fit-legend-3, ex:l8-anova-recovery-fit-legend-4 ; cd:authoredResource true .
  ex:l8-anova-recovery-fit-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat y&=94+4D_B-1D_C\\\\[.65em]F&=\\frac{(114-30)/2}{30/15}=21\\end{aligned}" ; cd:formulaLabel "Fit the group means and compare with a single overall mean"@en ; cd:hasSymbol ex:l8-anova-recovery-fit-symbol-1, ex:l8-anova-recovery-fit-symbol-2, ex:l8-anova-recovery-fit-symbol-3, ex:l8-anova-recovery-fit-symbol-4 ; dct:hasPart ex:l8-anova-recovery-fit-legend ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-symbol-1 a cd:MathSymbol ; cd:symbol "\\widehat y,\\beta_0,\\beta_c,\\beta_T" ; cd:mathNotation "\\widehat y,\\beta_0,\\beta_c,\\beta_T" ; cd:body "Fitted signal in mV. The intercept is in mV; the two slopes are in mV per mg/L and mV per °C."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\widehat y,\\beta_0,\\beta_c,\\beta_T"@en ; cd:body "Fitted signal in mV. The intercept is in mV; the two slopes are in mV per mg/L and mV per °C."@en ; dct:references ex:l8-multiple-regression-fit-symbol-1 ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-symbol-2 a cd:MathSymbol ; cd:symbol "c,T" ; cd:mathNotation "c,T" ; cd:body "Measured concentration in mg/L and measured temperature in °C."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "c,T"@en ; cd:body "Measured concentration in mg/L and measured temperature in °C."@en ; dct:references ex:l8-multiple-regression-fit-symbol-2 ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-symbol-3 a cd:MathSymbol ; cd:symbol "-1.00,2.00,0.10" ; cd:mathNotation "-1.00,2.00,0.10" ; cd:body "Fitted intercept, concentration slope and temperature slope, in that order."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "-1.00,2.00,0.10"@en ; cd:body "Fitted intercept, concentration slope and temperature slope, in that order."@en ; dct:references ex:l8-multiple-regression-fit-symbol-3 ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-symbol-4 a cd:MathSymbol ; cd:symbol "+,-,=" ; cd:mathNotation "+,-,=" ; cd:body "Addition, subtraction and equality. Adjacent factors multiply. The hat denotes a fitted value."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "+,-,="@en ; cd:body "Addition, subtraction and equality. Adjacent factors multiply. The hat denotes a fitted value."@en ; dct:references ex:l8-multiple-regression-fit-symbol-4 ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-multiple-regression-fit-legend-1, ex:l8-multiple-regression-fit-legend-2, ex:l8-multiple-regression-fit-legend-3, ex:l8-multiple-regression-fit-legend-4 ; cd:authoredResource true .
  ex:l8-multiple-regression-fit-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat y&=\\beta_0+\\beta_c c+\\beta_T T\\\\&=-1.00+2.00c+0.10T\\end{aligned}" ; cd:formulaLabel "Fit both predictors with ordinary least squares"@en ; cd:hasSymbol ex:l8-multiple-regression-fit-symbol-1, ex:l8-multiple-regression-fit-symbol-2, ex:l8-multiple-regression-fit-symbol-3, ex:l8-multiple-regression-fit-symbol-4 ; dct:hasPart ex:l8-multiple-regression-fit-legend ; cd:authoredResource true .
  ex:l8-multiple-regression-products-symbol-1 a cd:MathSymbol ; cd:symbol "X,y" ; cd:mathNotation "X,y" ; cd:body "Design matrix with six rows and columns for ones, concentration c (mg/L), and measured temperature T (°C). The six detector signals y are measured in mV."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-products-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X,y"@en ; cd:body "Design matrix with six rows and columns for ones, concentration c (mg/L), and measured temperature T (°C). The six detector signals y are measured in mV."@en ; dct:references ex:l8-multiple-regression-products-symbol-1 ; cd:authoredResource true .
  ex:l8-multiple-regression-products-symbol-2 a cd:MathSymbol ; cd:symbol "i,j,k" ; cd:mathNotation "i,j,k" ; cd:body "Row i identifies one of the six runs. Columns j and k identify one of the three predictors including the column of ones."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-products-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "i,j,k"@en ; cd:body "Row i identifies one of the six runs. Columns j and k identify one of the three predictors including the column of ones."@en ; dct:references ex:l8-multiple-regression-products-symbol-2 ; cd:authoredResource true .
  ex:l8-multiple-regression-products-symbol-3 a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T},\\sum,=" ; cd:mathNotation "{}^{\\mathsf T},\\sum,=" ; cd:body "Transpose swaps rows and columns. The sum runs over the six runs. Adjacent factors multiply. The equals sign gives the resulting entry."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-products-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T},\\sum,="@en ; cd:body "Transpose swaps rows and columns. The sum runs over the six runs. Adjacent factors multiply. The equals sign gives the resulting entry."@en ; dct:references ex:l8-multiple-regression-products-symbol-3 ; cd:authoredResource true .
  ex:l8-multiple-regression-products-symbol-4 a cd:MathSymbol ; cd:symbol "X_{ij},X_{ik},y_i" ; cd:mathNotation "X_{ij},X_{ik},y_i" ; cd:body "Values from the indicated columns in run i and its measured signal. Parenthesised products with subscripts denote entries of the result."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-products-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "X_{ij},X_{ik},y_i"@en ; cd:body "Values from the indicated columns in run i and its measured signal. Parenthesised products with subscripts denote entries of the result."@en ; dct:references ex:l8-multiple-regression-products-symbol-4 ; cd:authoredResource true .
  ex:l8-multiple-regression-products-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-multiple-regression-products-legend-1, ex:l8-multiple-regression-products-legend-2, ex:l8-multiple-regression-products-legend-3, ex:l8-multiple-regression-products-legend-4 ; cd:authoredResource true .
  ex:l8-multiple-regression-products-formula a cd:MathExpression ; cd:latex "\\begin{aligned}(X^{\\mathsf T}X)_{jk}&=\\sum_{i=1}^{6}X_{ij}X_{ik}\\\\[.45em](X^{\\mathsf T}y)_j&=\\sum_{i=1}^{6}X_{ij}y_i\\end{aligned}" ; cd:formulaLabel "Multiply the entries row by row, then add"@en ; cd:hasSymbol ex:l8-multiple-regression-products-symbol-1, ex:l8-multiple-regression-products-symbol-2, ex:l8-multiple-regression-products-symbol-3, ex:l8-multiple-regression-products-symbol-4 ; dct:hasPart ex:l8-multiple-regression-products-legend ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-symbol-1 a cd:MathSymbol ; cd:symbol "X,y" ; cd:mathNotation "X,y" ; cd:body "The six-run design matrix and measured detector signals in mV. Design columns are ones, concentration in mg/L, and measured temperature in °C."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X,y"@en ; cd:body "The six-run design matrix and measured detector signals in mV. Design columns are ones, concentration in mg/L, and measured temperature in °C."@en ; dct:references ex:l8-multiple-regression-coefficients-symbol-1 ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-symbol-2 a cd:MathSymbol ; cd:symbol "\\widehat\\beta" ; cd:mathNotation "\\widehat\\beta" ; cd:body "Fitted coefficients in this order: intercept (mV), concentration slope (mV per mg/L), and temperature slope (mV per °C)."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\widehat\\beta"@en ; cd:body "Fitted coefficients in this order: intercept (mV), concentration slope (mV per mg/L), and temperature slope (mV per °C)."@en ; dct:references ex:l8-multiple-regression-coefficients-symbol-2 ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-symbol-3 a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T},{}^{-1},=" ; cd:mathNotation "{}^{\\mathsf T},{}^{-1},=" ; cd:body "Transpose swaps rows and columns, −1 denotes the inverse of the whole square matrix, and equals gives the evaluated expression. Adjacent matrices or vectors multiply."@en ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T},{}^{-1},="@en ; cd:body "Transpose swaps rows and columns, −1 denotes the inverse of the whole square matrix, and equals gives the evaluated expression. Adjacent matrices or vectors multiply."@en ; dct:references ex:l8-multiple-regression-coefficients-symbol-3 ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-multiple-regression-coefficients-legend-1, ex:l8-multiple-regression-coefficients-legend-2, ex:l8-multiple-regression-coefficients-legend-3 ; cd:authoredResource true .
  ex:l8-multiple-regression-coefficients-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\\\[.6em]&=\\textcolor{teal}{\\begin{bmatrix}6&12&150\\\\12&28&300\\\\150&300&3900\\end{bmatrix}}^{-1}\\textcolor{purple}{\\begin{bmatrix}33\\\\74\\\\840\\end{bmatrix}}=\\begin{bmatrix}-1.00\\\\2.00\\\\0.10\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Apply the inverse to the three signal cross-products"@en ; cd:hasSymbol ex:l8-multiple-regression-coefficients-symbol-1, ex:l8-multiple-regression-coefficients-symbol-2, ex:l8-multiple-regression-coefficients-symbol-3 ; dct:hasPart ex:l8-multiple-regression-coefficients-legend ; cd:authoredResource true .
  ex:l8-anova-recovery-products-symbol-1 a cd:MathSymbol ; cd:symbol "X,y" ; cd:mathNotation "X,y" ; cd:body "Design matrix with columns for the intercept, method B, and method C. The vector contains the 18 original recovery measurements in %."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-products-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X,y"@en ; cd:body "Design matrix with columns for the intercept, method B, and method C. The vector contains the 18 original recovery measurements in %."@en ; dct:references ex:l8-anova-recovery-products-symbol-1 ; cd:authoredResource true .
  ex:l8-anova-recovery-products-symbol-2 a cd:MathSymbol ; cd:symbol "i,j,k" ; cd:mathNotation "i,j,k" ; cd:body "Row i refers to one preparation. Columns j and k select the intercept or one of the two method indicators."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-products-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "i,j,k"@en ; cd:body "Row i refers to one preparation. Columns j and k select the intercept or one of the two method indicators."@en ; dct:references ex:l8-anova-recovery-products-symbol-2 ; cd:authoredResource true .
  ex:l8-anova-recovery-products-symbol-3 a cd:MathSymbol ; cd:symbol "X_{ij},X_{ik},y_i" ; cd:mathNotation "X_{ij},X_{ik},y_i" ; cd:body "Two design entries in row i (0 or 1), and the measured recovery for that row."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-products-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "X_{ij},X_{ik},y_i"@en ; cd:body "Two design entries in row i (0 or 1), and the measured recovery for that row."@en ; dct:references ex:l8-anova-recovery-products-symbol-3 ; cd:authoredResource true .
  ex:l8-anova-recovery-products-symbol-4 a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T},\\sum,=" ; cd:mathNotation "{}^{\\mathsf T},\\sum,=" ; cd:body "Transpose swaps rows and columns. Sum over all 18 preparations. Adjacent factors multiply and equals gives the resulting entry. Subscripts on parenthesised products identify the entry."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-products-legend-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "{}^{\\mathsf T},\\sum,="@en ; cd:body "Transpose swaps rows and columns. Sum over all 18 preparations. Adjacent factors multiply and equals gives the resulting entry. Subscripts on parenthesised products identify the entry."@en ; dct:references ex:l8-anova-recovery-products-symbol-4 ; cd:authoredResource true .
  ex:l8-anova-recovery-products-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-anova-recovery-products-legend-1, ex:l8-anova-recovery-products-legend-2, ex:l8-anova-recovery-products-legend-3, ex:l8-anova-recovery-products-legend-4 ; cd:authoredResource true .
  ex:l8-anova-recovery-products-formula a cd:MathExpression ; cd:latex "\\begin{aligned}(X^{\\mathsf T}X)_{jk}&=\\sum_{i=1}^{18}X_{ij}X_{ik}\\\\[.45em](X^{\\mathsf T}y)_j&=\\sum_{i=1}^{18}X_{ij}y_i\\end{aligned}" ; cd:formulaLabel "Pair the design columns first, then pair them with the recovery vector"@en ; cd:hasSymbol ex:l8-anova-recovery-products-symbol-1, ex:l8-anova-recovery-products-symbol-2, ex:l8-anova-recovery-products-symbol-3, ex:l8-anova-recovery-products-symbol-4 ; dct:hasPart ex:l8-anova-recovery-products-legend ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-symbol-1 a cd:MathSymbol ; cd:symbol "X,y" ; cd:mathNotation "X,y" ; cd:body "Design matrix with columns for the intercept, B and C, and the 18 recoveries in %."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-legend-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "X,y"@en ; cd:body "Design matrix with columns for the intercept, B and C, and the 18 recoveries in %."@en ; dct:references ex:l8-anova-recovery-coefficients-symbol-1 ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-symbol-2 a cd:MathSymbol ; cd:symbol "\\widehat\\beta" ; cd:mathNotation "\\widehat\\beta" ; cd:body "Fitted coefficients in column order. First is the reference recovery for A (%). The second and third are differences from A (percentage points)."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-legend-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\widehat\\beta"@en ; cd:body "Fitted coefficients in column order. First is the reference recovery for A (%). The second and third are differences from A (percentage points)."@en ; dct:references ex:l8-anova-recovery-coefficients-symbol-2 ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-symbol-3 a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T},{}^{-1},=" ; cd:mathNotation "{}^{\\mathsf T},{}^{-1},=" ; cd:body "Transpose swaps rows and columns. The exponent −1 inverts the whole matrix. Adjacent matrices and vectors multiply. Equals gives the evaluated result."@en ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-legend-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "{}^{\\mathsf T},{}^{-1},="@en ; cd:body "Transpose swaps rows and columns. The exponent −1 inverts the whole matrix. Adjacent matrices and vectors multiply. Equals gives the evaluated result."@en ; dct:references ex:l8-anova-recovery-coefficients-symbol-3 ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-anova-recovery-coefficients-legend-1, ex:l8-anova-recovery-coefficients-legend-2, ex:l8-anova-recovery-coefficients-legend-3 ; cd:authoredResource true .
  ex:l8-anova-recovery-coefficients-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y=\\textcolor{teal}{\\begin{bmatrix}18&6&6\\\\6&6&0\\\\6&0&6\\end{bmatrix}}^{-1}\\textcolor{purple}{\\begin{bmatrix}1710\\\\588\\\\558\\end{bmatrix}}\\\\[.65em]&=\\frac{1}{6}\\begin{bmatrix}1&-1&-1\\\\-1&2&1\\\\-1&1&2\\end{bmatrix}\\begin{bmatrix}1710\\\\588\\\\558\\end{bmatrix}=\\begin{bmatrix}94\\\\4\\\\-1\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Substitute the two products, then apply the inverse"@en ; cd:hasSymbol ex:l8-anova-recovery-coefficients-symbol-1, ex:l8-anova-recovery-coefficients-symbol-2, ex:l8-anova-recovery-coefficients-symbol-3 ; dct:hasPart ex:l8-anova-recovery-coefficients-legend ; cd:authoredResource true .
