  ex:l8-f-vectors-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "A,A^{\\mathsf T}"@en ; cd:body "A is the 5 by 3 matrix and its transpose has 3 rows and 5 columns. The boxes trace the first row of A into the first column of its transpose."@en ; dct:references ex:l8-symbol-A ; cd:authoredResource true .
