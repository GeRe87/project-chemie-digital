  ex:l8-f-products-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-products-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-products-entry-1, ex:l8-f-products-entry-2, ex:l8-f-products-entry-3 ; cd:authoredResource true .
  ex:l8-f-products a cd:MathExpression ; cd:latex "\\begin{aligned}AB&=\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix}\\begin{bmatrix}5&6\\\\7&8\\end{bmatrix}=\\begin{bmatrix}19&22\\\\43&50\\end{bmatrix}\\\\BA&=\\begin{bmatrix}5&6\\\\7&8\\end{bmatrix}\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix}=\\begin{bmatrix}23&34\\\\31&46\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Order matters"@en ; cd:hasSymbol ex:l8-symbol-A, ex:l8-symbol-neq, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-products-legend ; cd:authoredResource true .
  ex:l8-symbol-A a cd:MathSymbol ; cd:symbol "A,B" ; cd:mathNotation "A,B" ; cd:body "Named numerical matrices; entries in the matrix examples are dimensionless. Matrix juxtaposition denotes row-by-column multiplication, not entrywise multiplication."@en ; cd:authoredResource true .
