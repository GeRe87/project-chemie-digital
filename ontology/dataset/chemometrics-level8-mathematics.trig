  ex:l8-f-add-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-add-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-add-entry-1, ex:l8-f-add-entry-2 ; cd:authoredResource true .
  ex:l8-f-add a cd:MathExpression ; cd:latex "\\begin{aligned}A&=\\begin{bmatrix}1&2\\\\3&4\\end{bmatrix},\\qquad B=\\begin{bmatrix}5&6\\\\7&8\\end{bmatrix}\\\\A+B&=\\begin{bmatrix}\\boxed{1+5}&2+6\\\\3+7&4+8\\end{bmatrix}=\\begin{bmatrix}6&8\\\\10&12\\end{bmatrix}\\\\A-B&=\\begin{bmatrix}\\boxed{1-5}&2-6\\\\3-7&4-8\\end{bmatrix}=\\begin{bmatrix}-4&-4\\\\-4&-4\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Add or subtract entries at matching positions"@en ; cd:hasSymbol ex:l8-symbol-A, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-add-legend ; cd:authoredResource true .
  ex:l8-symbol-c a cd:MathSymbol ; cd:symbol "c" ; cd:mathNotation "c" ; cd:body "A dimensionless scalar; cA multiplies every entry of A by c."@en ; cd:authoredResource true .
