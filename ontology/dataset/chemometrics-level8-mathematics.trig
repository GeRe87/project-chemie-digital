  ex:l8-f-dot-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-dot-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-dot-entry-1, ex:l8-f-dot-entry-2, ex:l8-f-dot-entry-3 ; cd:authoredResource true .
  ex:l8-f-dot a cd:MathExpression ; cd:latex "\\begin{aligned}A&=\\begin{bmatrix}\\textcolor{teal}{\\boxed{1}}&\\textcolor{teal}{\\boxed{2}}&\\textcolor{teal}{\\boxed{3}}\\\\4&5&6\\end{bmatrix},\\qquad B=\\begin{bmatrix}\\textcolor{purple}{\\boxed{2}}&1\\\\\\textcolor{purple}{\\boxed{0}}&3\\\\\\textcolor{purple}{\\boxed{1}}&2\\end{bmatrix}\\\\[.55em]AB&=\\begin{bmatrix}\\textcolor{brown}{\\boxed{\\textcolor{teal}{1}\\cdot\\textcolor{purple}{2}+\\textcolor{teal}{2}\\cdot\\textcolor{purple}{0}+\\textcolor{teal}{3}\\cdot\\textcolor{purple}{1}}}&1\\cdot1+2\\cdot3+3\\cdot2\\\\4\\cdot2+5\\cdot0+6\\cdot1&4\\cdot1+5\\cdot3+6\\cdot2\\end{bmatrix}\\\\[.35em]&=\\begin{bmatrix}\\textcolor{brown}{\\boxed{5}}&13\\\\14&31\\end{bmatrix}\\end{aligned}" ; cd:formulaLabel "Multiply a 2 × 3 matrix by a 3 × 2 matrix"@en ; cd:hasSymbol ex:l8-symbol-A, ex:l8-symbol-ij, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-dot-legend ; cd:authoredResource true .
  ex:l8-symbol-A a cd:MathSymbol ; cd:symbol "A,B" ; cd:mathNotation "A,B" ; cd:body "Named numerical matrices; entries in the matrix examples are dimensionless. Matrix juxtaposition denotes row-by-column multiplication, not entrywise multiplication."@en ; cd:authoredResource true .
