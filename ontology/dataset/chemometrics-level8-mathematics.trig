  ex:l8-f-derivative-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-derivative-entry-1, ex:l8-f-derivative-entry-2, ex:l8-f-derivative-entry-3, ex:l8-f-derivative-entry-4 ; cd:authoredResource true .
  ex:l8-f-derivative a cd:MathExpression ; cd:latex "\\frac{d}{da}(a-3)^2=2(a-3)=0\\quad\\Longrightarrow\\quad a=3" ; cd:formulaLabel "At the bowl bottom, the slope is zero"@en ; cd:hasSymbol ex:l8-symbol-deriv, ex:l8-symbol-a, ex:l8-symbol-sq, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-derivative-legend ; cd:authoredResource true .
