  ex:l8-f-conditions-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "\\sum_{i=1}^{n}"@en ; cd:body "Add one term for each observation i from 1 through n."@en ; dct:references ex:l8-symbol-sum ; cd:authoredResource true .
  ex:l8-symbol-x a cd:MathSymbol ; cd:symbol "x_i" ; cd:mathNotation "x_i" ; cd:body "Time for observation i, in min; the unindexed x is a selected time in the same unit."@en ; cd:authoredResource true .
  ex:l8-f-conditions-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "x_i"@en ; cd:body "Time for observation i, in min; the unindexed x is a selected time in the same unit."@en ; dct:references ex:l8-symbol-x ; cd:authoredResource true .
  ex:l8-symbol-e a cd:MathSymbol ; cd:symbol "e_i" ; cd:mathNotation "e_i" ; cd:body "Residual, observed minus fitted signal, in mV; e is the column of residuals."@en ; cd:authoredResource true .
  ex:l8-f-conditions-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "e_i"@en ; cd:body "Residual, observed minus fitted signal, in mV; e is the column of residuals."@en ; dct:references ex:l8-symbol-e ; cd:authoredResource true .
  ex:l8-symbol-idx a cd:MathSymbol ; cd:symbol "i,n" ; cd:mathNotation "i,n" ; cd:body "Observation index i runs from 1 to n; here n = 5, in increasing time order."@en ; cd:authoredResource true .
  ex:l8-f-conditions-entry-8 a cd:DefinitionListEntry ; cd:position 8 ; skos:prefLabel "i,n"@en ; cd:body "Observation index i runs from 1 to n; here n = 5, in increasing time order."@en ; dct:references ex:l8-symbol-idx ; cd:authoredResource true .
  ex:l8-symbol-zero a cd:MathSymbol ; cd:symbol "0" ; cd:mathNotation "0" ; cd:body "Zero scalar or zero column as dictated by shape. In Xᵀe the two components have units mV and min·mV, and each equals zero in its own unit."@en ; cd:authoredResource true .
  ex:l8-f-conditions-entry-9 a cd:DefinitionListEntry ; cd:position 9 ; skos:prefLabel "0"@en ; cd:body "Zero scalar or zero column as dictated by shape. In Xᵀe the two components have units mV and min·mV, and each equals zero in its own unit."@en ; dct:references ex:l8-symbol-zero ; cd:authoredResource true .
