  ex:l8-f-equations a cd:MathExpression ; cd:latex "\\begin{aligned}2u_1+u_2&=5,\\qquad u_1+u_2=3\\\\\\begin{bmatrix}2&1\\\\1&1\\end{bmatrix}\\begin{bmatrix}u_1\\\\u_2\\end{bmatrix}&=\\begin{bmatrix}5\\\\3\\end{bmatrix}\\\\Au&=b\\end{aligned}" ; cd:formulaLabel "The same equations, one matrix statement"@en ; cd:hasSymbol ex:l8-symbol-A, ex:l8-symbol-u, ex:l8-symbol-ij, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-equations-legend ; cd:authoredResource true .
