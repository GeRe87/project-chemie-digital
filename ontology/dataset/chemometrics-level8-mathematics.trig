  ex:l8-f-objective-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "\\beta,\\widehat\\beta"@en ; cd:body "Coefficient column ordered intercept then slope. Hats mark the least-squares solution: entries have units mV and mV/min respectively. Different coefficient entries need not share one unit."@en ; dct:references ex:l8-symbol-beta ; cd:authoredResource true .
  ex:l8-symbol-Y a cd:MathSymbol ; cd:symbol "y,\\widehat y,e" ; cd:mathNotation "y,\\widehat y,e" ; cd:body "Observed, fitted and residual columns of length 5, each in mV; e = y − ŷ. Superscript T transposes a column into a row."@en ; cd:authoredResource true .
  ex:l8-f-objective-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "y,\\widehat y,e"@en ; cd:body "Observed, fitted and residual columns of length 5, each in mV; e = y − ŷ. Superscript T transposes a column into a row."@en ; dct:references ex:l8-symbol-Y ; cd:authoredResource true .
  ex:l8-symbol-X a cd:MathSymbol ; cd:symbol "X" ; cd:mathNotation "X" ; cd:body "Design matrix: 5 rows (observations), 2 columns (constant and time) for the drift line. The constant column is dimensionless; the time column has unit min."@en ; cd:authoredResource true .
  ex:l8-f-objective-entry-4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "X"@en ; cd:body "Design matrix: 5 rows (observations), 2 columns (constant and time) for the drift line. The constant column is dimensionless; the time column has unit min."@en ; dct:references ex:l8-symbol-X ; cd:authoredResource true .
  ex:l8-symbol-T a cd:MathSymbol ; cd:symbol "{}^{\\mathsf T}" ; cd:mathNotation "{}^{\\mathsf T}" ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; cd:authoredResource true .
  ex:l8-f-objective-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "{}^{\\mathsf T}"@en ; cd:body "Transpose: swap rows and columns. (AB)ᵀ reverses the multiplication order to BᵀAᵀ."@en ; dct:references ex:l8-symbol-T ; cd:authoredResource true .
  ex:l8-symbol-norm a cd:MathSymbol ; cd:symbol "\\lVert e\\rVert_2^2" ; cd:mathNotation "\\lVert e\\rVert_2^2" ; cd:body "Squared Euclidean length: sum of squared residual entries, equal to eᵀe. The subscript 2 names this norm, not an observation index."@en ; cd:authoredResource true .
  ex:l8-f-objective-entry-6 a cd:DefinitionListEntry ; cd:position 6 ; skos:prefLabel "\\lVert e\\rVert_2^2"@en ; cd:body "Squared Euclidean length: sum of squared residual entries, equal to eᵀe. The subscript 2 names this norm, not an observation index."@en ; dct:references ex:l8-symbol-norm ; cd:authoredResource true .
  ex:l8-symbol-ops a cd:MathSymbol ; cd:symbol "+,-,=,\\cdot" ; cd:mathNotation "+,-,=,\\cdot" ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; cd:authoredResource true .
  ex:l8-f-objective-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "+,-,=,\\cdot"@en ; cd:body "Plus adds, minus subtracts, equals asserts equality; juxtaposition, a centred dot or × between numerical entries multiplies. Parentheses group terms; brackets arrange matrix entries. Bare numerical constants are dimensionless unless the stated measurement coordinates give units."@en ; dct:references ex:l8-symbol-ops ; cd:authoredResource true .
  ex:l8-f-objective-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-objective-entry-1, ex:l8-f-objective-entry-2, ex:l8-f-objective-entry-3, ex:l8-f-objective-entry-4, ex:l8-f-objective-entry-5, ex:l8-f-objective-entry-6, ex:l8-f-objective-entry-7 ; cd:authoredResource true .
  ex:l8-f-objective a cd:MathExpression ; cd:latex "Q(\\beta)=e^{\\mathsf T}e=\\lVert e\\rVert_2^2,\\quad e=y-X\\beta" ; cd:formulaLabel "Minimise the squared length"@en ; cd:hasSymbol ex:l8-symbol-Q, ex:l8-symbol-beta, ex:l8-symbol-Y, ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-norm, ex:l8-symbol-ops ; dct:hasPart ex:l8-f-objective-legend ; cd:authoredResource true .
  ex:l8-symbol-deriv a cd:MathSymbol ; cd:symbol "\\partial,\\frac{d}{da}" ; cd:mathNotation "\\partial,\\frac{d}{da}" ; cd:body "Partial differentiation changes one coefficient while holding other coefficients and all data fixed; d/da is the ordinary scalar derivative with respect to a."@en ; cd:authoredResource true .
  ex:l8-f-derivative-entry-1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "\\partial,\\frac{d}{da}"@en ; cd:body "Partial differentiation changes one coefficient while holding other coefficients and all data fixed; d/da is the ordinary scalar derivative with respect to a."@en ; dct:references ex:l8-symbol-deriv ; cd:authoredResource true .
  ex:l8-symbol-a a cd:MathSymbol ; cd:symbol "a" ; cd:mathNotation "a" ; cd:body "A dimensionless trial scalar in the derivative warm-up; not a matrix entry in this scene."@en ; cd:authoredResource true .
  ex:l8-f-derivative-entry-2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "a"@en ; cd:body "A dimensionless trial scalar in the derivative warm-up; not a matrix entry in this scene."@en ; dct:references ex:l8-symbol-a ; cd:authoredResource true .
