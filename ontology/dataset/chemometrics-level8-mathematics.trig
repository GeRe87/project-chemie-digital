  ex:l8-f-isolate-beta-entry-7 a cd:DefinitionListEntry ; cd:position 7 ; skos:prefLabel "I"@en ; cd:body "The identity matrix for the two coefficients. Its product with the coefficient column equals that column."@en ; dct:references ex:l8-symbol-I ; cd:authoredResource true .
  ex:l8-f-isolate-beta-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l8-f-isolate-beta-entry-1, ex:l8-f-isolate-beta-entry-2, ex:l8-f-isolate-beta-entry-3, ex:l8-f-isolate-beta-entry-4, ex:l8-f-isolate-beta-entry-5, ex:l8-f-isolate-beta-entry-6, ex:l8-f-isolate-beta-entry-7 ; cd:authoredResource true .
  ex:l8-f-isolate-beta a cd:MathExpression ; cd:latex "\\begin{aligned} X^{\\mathsf T}X\\widehat\\beta&=X^{\\mathsf T}y\\\\[.4em](X^{\\mathsf T}X)^{-1}(X^{\\mathsf T}X)\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\\\[.4em]I\\widehat\\beta&=(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y\\\\[.4em]\\widehat\\beta&=\\boxed{(X^{\\mathsf T}X)^{-1}X^{\\mathsf T}y}\\end{aligned}" ; cd:formulaLabel "Left-multiply by the inverse when it exists"@en ; cd:hasSymbol ex:l8-symbol-X, ex:l8-symbol-T, ex:l8-symbol-inv, ex:l8-symbol-beta, ex:l8-symbol-Y, ex:l8-symbol-ops, ex:l8-symbol-I ; dct:hasPart ex:l8-f-isolate-beta-legend ; cd:authoredResource true .
