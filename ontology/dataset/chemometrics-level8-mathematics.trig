  ex:l8-symbol-ij a cd:MathSymbol ; cd:symbol "i,j,k" ; cd:mathNotation "i,j,k" ; cd:body "Row index i, column index j, and inner-product index k; each runs over the valid rows/columns indicated by the matrix shape."@en ; cd:authoredResource true .
