  ex:l8-symbol-beta a cd:MathSymbol ; cd:symbol "\\beta,\\widehat\\beta" ; cd:mathNotation "\\beta,\\widehat\\beta" ; cd:body "Coefficient column ordered intercept then slope. Hats mark the least-squares solution: entries have units mV and mV/min respectively. Different coefficient entries need not share one unit."@en ; cd:authoredResource true .
