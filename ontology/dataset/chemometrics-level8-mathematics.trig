  ex:l8-f-solution-entry-5 a cd:DefinitionListEntry ; cd:position 5 ; skos:prefLabel "y,\\widehat y,e"@en ; cd:body "Observed, fitted and residual columns of length 5, each in mV; e = y − ŷ. Superscript T transposes a column into a row."@en ; dct:references ex:l8-symbol-Y ; cd:authoredResource true .
