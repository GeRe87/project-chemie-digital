  ex:l8-f-conditions-entry-3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "\\beta_0"@en ; cd:body "Candidate intercept, in mV; a fitted coefficient is marked with a hat."@en ; dct:references ex:l8-symbol-b0 ; cd:authoredResource true .
  ex:l8-symbol-b1 a cd:MathSymbol ; cd:symbol "\\beta_1" ; cd:mathNotation "\\beta_1" ; cd:body "Candidate slope, in mV/min; a fitted coefficient is marked with a hat."@en ; cd:authoredResource true .
