@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-architecture> {
  ex:cogniflow-service-architecture a cd:Concept ;
    skos:prefLabel "One Interface. Specialized Providers."@en ;
    cd:hasDefinition ex:def-cogniflow-service-architecture ;
    cd:authoredResource true .

  ex:def-cogniflow-service-architecture a cd:Definition ;
    cd:body "CogniFlow keeps one stable MCP-facing interface while specialized providers can evolve, move or be replaced independently."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-service-architecture a cd:FlowDiagram, cd:NetworkDiagram ;
    skos:prefLabel "Decoupled CogniFlow service architecture"@en ;
    cd:body "The request path stays stable from consumer to MCP server to orchestrator. Semantics, data and artifact/provenance capabilities remain separate providers behind that contract."@en ;
    cd:hasDiagramNode ex:node-cogniflow-actors,
      ex:node-cogniflow-mcp,
      ex:node-cogniflow-orchestrator,
      ex:node-cogniflow-semantic-store,
      ex:node-cogniflow-data-store,
      ex:node-cogniflow-artifact-store ;
    cd:hasDiagramEdge ex:edge-cogniflow-actors-mcp,
      ex:edge-cogniflow-mcp-orchestrator,
      ex:edge-cogniflow-orchestrator-semantics,
      ex:edge-cogniflow-orchestrator-data,
      ex:edge-cogniflow-orchestrator-artifacts ;
    cd:hasDiagramGroup ex:diagram-group-cogniflow-interface,
      ex:diagram-group-cogniflow-orchestration,
      ex:diagram-group-cogniflow-providers ;
    cd:hasDiagramState ex:diagram-state-cogniflow-architecture-interface,
      ex:diagram-state-cogniflow-architecture-providers ;
    cd:focusNode ex:node-cogniflow-mcp ;
    cd:authoredResource true .

  ex:node-cogniflow-actors a cd:DiagramNode ;
    skos:prefLabel "User / AI Agent"@en ;
    cd:position 1 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-interface ;
    cd:authoredResource true .

  ex:node-cogniflow-mcp a cd:DiagramNode ;
    skos:prefLabel "MCP Server"@en ;
    cd:position 2 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-interface ;
    cd:authoredResource true .

  ex:node-cogniflow-orchestrator a cd:DiagramNode ;
    skos:prefLabel "CogniFlow Orchestrator"@en ;
    cd:position 3 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-orchestration ;
    cd:authoredResource true .

  ex:node-cogniflow-semantic-store a cd:DiagramNode ;
    skos:prefLabel "Semantic Provider"@en ;
    cd:position 4 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-providers ;
    cd:authoredResource true .

  ex:node-cogniflow-data-store a cd:DiagramNode ;
    skos:prefLabel "Data Provider"@en ;
    cd:position 5 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-providers ;
    cd:authoredResource true .

  ex:node-cogniflow-artifact-store a cd:DiagramNode ;
    skos:prefLabel "Artifact + Provenance Provider"@en ;
    cd:position 6 ;
    cd:memberOfDiagramGroup ex:diagram-group-cogniflow-providers ;
    cd:authoredResource true .

  ex:edge-cogniflow-actors-mcp a cd:DiagramEdge ;
    skos:prefLabel "request"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-actors ;
    cd:targetNode ex:node-cogniflow-mcp ;
    cd:authoredResource true .

  ex:edge-cogniflow-mcp-orchestrator a cd:DiagramEdge ;
    skos:prefLabel "dispatch"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-mcp ;
    cd:targetNode ex:node-cogniflow-orchestrator ;
    cd:authoredResource true .

  ex:edge-cogniflow-orchestrator-semantics a cd:DiagramEdge ;
    skos:prefLabel "semantics"@en ;
    cd:position 3 ;
    cd:sourceNode ex:node-cogniflow-orchestrator ;
    cd:targetNode ex:node-cogniflow-semantic-store ;
    cd:authoredResource true .

  ex:edge-cogniflow-orchestrator-data a cd:DiagramEdge ;
    skos:prefLabel "data"@en ;
    cd:position 4 ;
    cd:sourceNode ex:node-cogniflow-orchestrator ;
    cd:targetNode ex:node-cogniflow-data-store ;
    cd:authoredResource true .

  ex:edge-cogniflow-orchestrator-artifacts a cd:DiagramEdge ;
    skos:prefLabel "artifacts"@en ;
    cd:position 5 ;
    cd:sourceNode ex:node-cogniflow-orchestrator ;
    cd:targetNode ex:node-cogniflow-artifact-store ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-interface a cd:DiagramGroup ;
    skos:prefLabel "Interface"@en ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-orchestration a cd:DiagramGroup ;
    skos:prefLabel "Orchestration"@en ;
    cd:authoredResource true .

  ex:diagram-group-cogniflow-providers a cd:DiagramGroup ;
    skos:prefLabel "Specialized providers"@en ;
    cd:authoredResource true .

  ex:diagram-state-cogniflow-architecture-interface a cd:DiagramState ;
    skos:prefLabel "Stable interface"@en ;
    cd:activeDiagramNode ex:node-cogniflow-actors, ex:node-cogniflow-mcp, ex:node-cogniflow-orchestrator ;
    cd:activeDiagramEdge ex:edge-cogniflow-actors-mcp, ex:edge-cogniflow-mcp-orchestrator ;
    cd:activeDiagramGroup ex:diagram-group-cogniflow-interface, ex:diagram-group-cogniflow-orchestration ;
    cd:focusDiagramGroup ex:diagram-group-cogniflow-interface ;
    cd:contextDiagramGroup ex:diagram-group-cogniflow-orchestration ;
    cd:authoredResource true .

  ex:diagram-state-cogniflow-architecture-providers a cd:DiagramState ;
    skos:prefLabel "Specialized providers"@en ;
    cd:activeDiagramNode ex:node-cogniflow-actors, ex:node-cogniflow-mcp, ex:node-cogniflow-orchestrator,
      ex:node-cogniflow-semantic-store, ex:node-cogniflow-data-store, ex:node-cogniflow-artifact-store ;
    cd:activeDiagramEdge ex:edge-cogniflow-actors-mcp, ex:edge-cogniflow-mcp-orchestrator,
      ex:edge-cogniflow-orchestrator-semantics, ex:edge-cogniflow-orchestrator-data, ex:edge-cogniflow-orchestrator-artifacts ;
    cd:activeDiagramGroup ex:diagram-group-cogniflow-interface, ex:diagram-group-cogniflow-orchestration, ex:diagram-group-cogniflow-providers ;
    cd:focusDiagramGroup ex:diagram-group-cogniflow-providers ;
    cd:contextDiagramGroup ex:diagram-group-cogniflow-interface, ex:diagram-group-cogniflow-orchestration ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-architecture-extension> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-architecture .

  ex:path-step-cogniflow-architecture a cd:PathStep ;
    cd:position 4 ;
    cd:usesResource ex:diagram-cogniflow-service-architecture ;
    cd:usesScene ex:scene-cogniflow-service-architecture ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-architecture> {
  ex:scene-cogniflow-service-architecture a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-service-architecture ;
    cd:hasSceneItem ex:scene-item-cogniflow-architecture-heading,
      ex:scene-item-cogniflow-architecture-diagram ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-architecture-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-service-architecture ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-architecture-diagram a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:diagram-cogniflow-service-architecture ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
