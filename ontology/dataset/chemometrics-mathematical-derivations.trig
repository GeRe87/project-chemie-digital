  ex:md-zero-section-2 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:derivation-residual-zero ; cd:firstDerivationStep ex:md-zero-2 ; cd:lastDerivationStep ex:md-zero-2 ; cd:usesLegend ex:md-sum-legend ; cd:authoredResource true .
