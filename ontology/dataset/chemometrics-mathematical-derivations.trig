  ex:md-bessel-section-1 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:derivation-bessel ; cd:firstDerivationStep ex:md-bessel-1 ; cd:lastDerivationStep ex:md-bessel-1 ; cd:usesLegend ex:md-bessel-legend ; cd:authoredResource true .
