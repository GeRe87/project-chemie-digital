<https://w3id.org/project-chemie-digital/graph/mathematics/chemometrics-derivations> {
  # Atomic equations link to the preserved earlier multi-line explanations.
  ex:md-sum-input a cd:MathExpression ; cd:latex "\\sum_{i=1}^n d_i=\\sum_{i=1}^n(x_i-\\bar x)" ; cd:hasSymbol ex:vr-d-symbol, ex:xi-symbol, ex:xbar-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vr-dev-formula, ex:vr-cancel-formula ; cd:authoredResource true .
  ex:md-sum-split a cd:MathExpression ; cd:latex "\\sum_{i=1}^n d_i=\\sum_{i=1}^n x_i-n\\bar x" ; cd:hasSymbol ex:vr-d-symbol, ex:xi-symbol, ex:xbar-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vr-cancel-formula ; cd:authoredResource true .
  ex:md-sum-zero a cd:MathExpression ; cd:latex "\\sum_{i=1}^n d_i=0" ; cd:hasSymbol ex:vr-d-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vr-cancel-formula ; cd:authoredResource true .
  ex:md-centers a cd:MathExpression ; cd:latex "X_i-\\mu=d_i+\\Delta" ; cd:hasSymbol ex:vr-X-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:vs-Delta-symbol, ex:vr-index-symbol ; dct:source ex:vr-center-formula ; cd:authoredResource true .
  ex:md-cross-zero a cd:MathExpression ; cd:latex "\\sum_{i=1}^n(X_i-\\mu)^2=\\sum_{i=1}^n d_i^2+\\sum_{i=1}^n\\Delta^2" ; cd:hasSymbol ex:vr-X-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:vs-Delta-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vs-simplify-formula ; cd:authoredResource true .
  ex:md-decomposition a cd:MathExpression ; cd:latex "\\sum_{i=1}^n(X_i-\\mu)^2=\\sum_{i=1}^n d_i^2+n\\Delta^2" ; cd:hasSymbol ex:vr-X-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:vs-Delta-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vs-simplify-formula ; cd:authoredResource true .
  ex:md-mean-moments a cd:MathExpression ; cd:latex "\\begin{gathered}\\operatorname{E}[\\bar X]=\\mu\\\\\\operatorname{Var}(\\bar X)=\\frac{\\sigma^2}{n}\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:vr-Xbar-symbol, ex:mu-symbol, ex:vm-var-symbol, ex:vr-sigma2-symbol, ex:n-symbol ; dct:source ex:vm-helper-formula ; cd:authoredResource true .
  ex:md-shift-variance a cd:MathExpression ; cd:latex "\\operatorname{E}[\\Delta^2]=\\operatorname{E}[(\\bar X-\\mu)^2]=\\frac{\\sigma^2}{n}" ; cd:hasSymbol ex:vr-E-symbol, ex:vs-Delta-symbol, ex:vr-Xbar-symbol, ex:mu-symbol, ex:vr-sigma2-symbol, ex:n-symbol ; dct:source ex:vm-helper-formula ; cd:authoredResource true .
  ex:md-shift-expectation a cd:MathExpression ; cd:latex "n\\operatorname{E}[\\Delta^2]=\\sigma^2" ; cd:hasSymbol ex:vr-E-symbol, ex:vs-Delta-symbol, ex:n-symbol, ex:vr-sigma2-symbol ; dct:source ex:vm-helper-formula ; cd:authoredResource true .
  ex:md-expectation-split a cd:MathExpression ; cd:latex "\\begin{aligned}\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}(X_i-\\mu)^2]&=\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}d_i^2]\\\\&\\quad+n\\operatorname{E}[\\Delta^2]\\end{aligned}" ; cd:formulaLabel "Average the two contributions over repeated samples"@en ; cd:hasSymbol ex:vr-E-symbol, ex:vr-X-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:vs-Delta-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; dct:source ex:vr-expect-formula ; cd:authoredResource true .
  ex:md-insert-moments a cd:MathExpression ; cd:latex "n\\sigma^2=\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}d_i^2]+\\sigma^2" ; cd:hasSymbol ex:n-symbol, ex:vr-sigma2-symbol, ex:vr-E-symbol, ex:vr-d-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; dct:source ex:vr-expect-formula ; cd:authoredResource true .
  ex:md-residual-expectation a cd:MathExpression ; cd:latex "\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}d_i^2]=(n-1)\\sigma^2" ; cd:hasSymbol ex:n-symbol, ex:vr-sigma2-symbol, ex:vr-E-symbol, ex:vr-d-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; dct:source ex:vr-expect-formula ; cd:authoredResource true .
  ex:md-count-shift-application a cd:MathExpression ; cd:latex "\\underbrace{\\Delta^2+\\Delta^2+\\cdots+\\Delta^2}_{n\\text{ terms}}=n\\Delta^2" ; cd:hasSymbol ex:vs-Delta-symbol, ex:n-symbol ; cd:authoredResource true .
  ex:md-scale-shift-application a cd:MathExpression ; cd:latex "\\operatorname{E}[n\\Delta^2]=n\\operatorname{E}[\\Delta^2]=n\\frac{\\sigma^2}{n}=\\sigma^2" ; cd:hasSymbol ex:vr-E-symbol, ex:n-symbol, ex:vs-Delta-symbol, ex:vr-sigma2-symbol ; cd:authoredResource true .
  ex:md-normalize-application a cd:MathExpression ; cd:latex "\\operatorname{E}\\!\\left[\\frac{\\sum_{i=1}^n d_i^2}{n-1}\\right]=\\frac{(n-1)\\sigma^2}{n-1}=\\sigma^2" ; cd:hasSymbol ex:vr-E-symbol, ex:n-symbol, ex:vr-d-symbol, ex:vr-index-symbol, ex:v-sum-symbol, ex:vr-sigma2-symbol ; dct:source ex:vr-variance-formula ; cd:authoredResource true .

  ex:derivation-residual-zero a cd:MathematicalDerivation ; skos:prefLabel "Why deviations about the arithmetic mean sum to zero"@en ; cd:inputFormula ex:vr-dev-formula ; cd:resultFormula ex:md-sum-zero ; cd:hasDerivationStep ex:md-zero-1, ex:md-zero-2, ex:md-zero-3 ; cd:authoredResource true .
  ex:md-zero-1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Sum both sides over the observations"@en ; cd:fromFormula ex:vr-dev-formula ; cd:toFormula ex:md-sum-input ; cd:appliesRule ex:rule-sum-equalities ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:md-zero-explanation-1 ; cd:authoredResource true .
  ex:md-zero-2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Split the sum; count the same mean n times"@en ; cd:fromFormula ex:md-sum-input ; cd:toFormula ex:md-sum-split ; cd:appliesRule ex:rule-subtract-constant-sum ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:md-zero-explanation-2 ; cd:authoredResource true .
  ex:md-zero-3 a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Insert the definition of the arithmetic mean"@en ; cd:fromFormula ex:md-sum-split ; cd:toFormula ex:md-sum-zero ; cd:appliesRule ex:rule-mean-definition ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:md-zero-explanation-3 ; cd:authoredResource true .
  ex:md-zero-explanation-1 a cd:Interpretation ; cd:body "For each observation, dᵢ = xᵢ − x̄.\nAdd these equalities for i = 1 through n. The result sums the left-hand residuals and the right-hand deviations.\nThis implication needs no probability assumption. It does not say that one summed equation can recover all individual observations."@en ; cd:applicationFormula ex:md-sum-input ; cd:authoredResource true .
  ex:md-zero-explanation-2 a cd:Interpretation ; cd:body "Use aᵢ = xᵢ and c = x̄ in the general rule.\nDistribute the sum over subtraction. Within this observed sample, the same fitted mean is subtracted at every index. Its sum is n times x̄.\nThe fitted mean may change between samples, but not between indices within one sample."@en ; cd:applicationFormula ex:md-sum-split ; cd:authoredResource true .
  ex:md-zero-explanation-3 a cd:Interpretation ; cd:body "The arithmetic mean is the sum of the observations divided by their count. Thus n times x̄ is exactly that same sum.\nSubstitute this equality into the difference of sums. A quantity minus itself is zero.\nThis is an exact property of the arithmetic mean, not merely a statement that residuals average to zero across repeated samples."@en ; cd:applicationFormula ex:md-sum-zero ; cd:authoredResource true .

  ex:derivation-bessel a cd:MathematicalDerivation ; skos:prefLabel "From fitted residuals to unbiased sample variance"@en ; cd:inputFormula ex:md-centers ; cd:resultFormula ex:vr-variance-formula ; cd:hasDerivationStep ex:md-bessel-1, ex:md-bessel-2, ex:md-bessel-3, ex:md-bessel-4, ex:md-bessel-5, ex:md-bessel-6, ex:md-bessel-7, ex:md-bessel-8 ; cd:authoredResource true .
  ex:md-bessel-1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Square both sides and expand"@en ; cd:fromFormula ex:md-centers ; cd:toFormula ex:vr-expand-formula ; cd:appliesRule ex:rule-binomial-square ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:md-bessel-explanation-1 ; cd:authoredResource true .
  ex:md-bessel-2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Sum both sides; distribute and factor"@en ; cd:fromFormula ex:vr-expand-formula ; cd:toFormula ex:vr-sum-formula ; cd:appliesRule ex:rule-sum-three-terms ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:md-bessel-explanation-2 ; cd:authoredResource true .
  ex:md-bessel-3 a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Insert the zero sum of residuals"@en ; cd:fromFormula ex:vr-sum-formula ; cd:toFormula ex:md-cross-zero ; cd:appliesRule ex:rule-residual-zero ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:md-bessel-explanation-3 ; cd:authoredResource true .
  ex:md-bessel-4 a cd:DerivationStep ; cd:position 4 ; skos:prefLabel "Sum the shared squared shift"@en ; cd:fromFormula ex:md-cross-zero ; cd:toFormula ex:md-decomposition ; cd:appliesRule ex:rule-sum-constant ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:md-bessel-explanation-4 ; cd:authoredResource true .
  ex:md-bessel-5 a cd:DerivationStep ; cd:position 5 ; skos:prefLabel "Average both sides over repeated samples"@en ; cd:fromFormula ex:md-decomposition ; cd:toFormula ex:md-expectation-split ; cd:appliesRule ex:rule-expectation-affine ; cd:transformationKind cd:StatisticalTransformation ; cd:requiresAssumption ex:assumption-iid-finite ; cd:hasExplanation ex:md-bessel-explanation-5 ; cd:authoredResource true .
  ex:md-bessel-6 a cd:DerivationStep ; cd:position 6 ; skos:prefLabel "Insert the established moment results"@en ; cd:fromFormula ex:md-expectation-split ; cd:toFormula ex:md-insert-moments ; cd:appliesRule ex:rule-population-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:requiresAssumption ex:assumption-iid-finite ; cd:hasExplanation ex:md-bessel-explanation-6 ; cd:authoredResource true .
  ex:md-bessel-7 a cd:DerivationStep ; cd:position 7 ; skos:prefLabel "Subtract the offset contribution"@en ; cd:fromFormula ex:md-insert-moments ; cd:toFormula ex:md-residual-expectation ; cd:appliesRule ex:rule-isolate-term ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:md-bessel-explanation-7 ; cd:authoredResource true .
  ex:md-bessel-8 a cd:DerivationStep ; cd:position 8 ; skos:prefLabel "Divide by n−1; define sample variance"@en ; cd:fromFormula ex:md-residual-expectation ; cd:toFormula ex:vr-variance-formula ; cd:appliesRule ex:rule-expectation-factor ; cd:transformationKind cd:StatisticalTransformation ; cd:requiresAssumption ex:assumption-iid-finite, ex:assumption-n-more-one ; cd:hasExplanation ex:md-bessel-explanation-8 ; cd:authoredResource true .
  ex:md-bessel-explanation-1 a cd:Interpretation ; cd:body "The individual residual is dᵢ = Xᵢ − X̄. The common shift is Δ = X̄ − μ. Their sum gives Xᵢ − μ.\nSquare each side, then use the binomial identity with a = dᵢ and b = Δ.\nSquaring an equality gives a consequence; sign information would be needed to reverse squaring in general."@en ; cd:applicationFormula ex:vr-expand-formula ; cd:authoredResource true .
  ex:md-bessel-explanation-2 a cd:Interpretation ; cd:body "Sum the observation-wise equality from i = 1 to n.\nDistribute the sum over all three terms. In the general rule use aᵢ = dᵢ², bᵢ = dᵢ, c = 2Δ and q = Δ².\nThe coefficient 2Δ is common to every observation, so it moves outside the cross-term sum. Keep the last sum explicit for now."@en ; cd:applicationFormula ex:vr-sum-formula ; cd:authoredResource true .
  ex:md-bessel-explanation-3 a cd:Interpretation ; cd:body "These residuals were formed about their own sample arithmetic mean. Their sum is exactly zero.\nSubstituting Σdᵢ = 0 makes the entire cross term 2ΔΣdᵢ equal to zero.\nThe individual residuals and their squared sum are not zero. Only the signed residual sum vanishes."@en ; cd:applicationFormula ex:md-cross-zero ; cd:authoredResource true .
  ex:md-bessel-explanation-4 a cd:Interpretation ; cd:body "Within one sample, Δ = X̄ − μ does not depend on the observation index i. Its square is therefore also index-independent.\nUse c = Δ² in the rule for summing a constant: the same value is added n times.\nΔ is still random across repeated samples. Being constant with respect to i does not make it fixed across samples."@en ; cd:applicationFormula ex:md-count-shift-application ; cd:authoredResource true .
  ex:md-bessel-explanation-5 a cd:Interpretation ; cd:body "Now pass from a within-sample identity to a statement about repeated sampling.\nTake expectations on both sides and use linearity on the residual-square sum plus the shared-shift term.\nFinite variance makes the required expectations finite. Independence is needed for later sample-mean moments, not for linearity itself."@en ; cd:applicationFormula ex:md-expectation-split ; cd:authoredResource true .
  ex:md-bessel-explanation-6 a cd:Interpretation ; cd:body "About the fixed population mean, each observation has expected squared deviation σ². The finite sum therefore has expectation nσ².\nUse the separately established auxiliary result E[nΔ²] = σ² for the shared-shift term.\nThese substitutions rely on the sampling assumptions and the preceding auxiliary result, not on algebra alone."@en ; cd:applicationFormula ex:md-insert-moments ; dct:source ex:derivation-mean-shift ; cd:authoredResource true .
  ex:md-bessel-explanation-7 a cd:Interpretation ; cd:body "In the general rearrangement use a = nσ², b = E[Σdᵢ²] and c = σ².\nSubtract σ² from both sides. The difference nσ² − σ² factors as (n−1)σ².\nThis step is algebraic once the preceding statistical moment results have been established."@en ; cd:applicationFormula ex:md-residual-expectation ; cd:authoredResource true .
  ex:md-bessel-explanation-8 a cd:Interpretation ; cd:body "The expected residual sum of squares is (n−1)σ². Divide the statistic by the fixed positive count n−1.\nUse c = 1/(n−1) in linearity of expectation, then define that normalized statistic as s². Its expectation is σ².\nIn contrast, dividing by n gives the descriptive MSD, whose expectation is (n−1)σ²/n. This does not make descriptive MSD erroneous. Residual degrees of freedom are a separate constraint argument; the square root s is not automatically unbiased."@en ; cd:applicationFormula ex:md-normalize-application ; dct:source ex:vs-theory-formula ; cd:authoredResource true .

  ex:derivation-mean-shift a cd:MathematicalDerivation ; skos:prefLabel "The expected squared shift of the sample mean"@en ; cd:inputFormula ex:md-mean-moments ; cd:resultFormula ex:md-shift-expectation ; cd:hasDerivationStep ex:md-shift-1, ex:md-shift-2 ; cd:authoredResource true .
  ex:md-shift-1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Use variance about the expected mean"@en ; cd:fromFormula ex:md-mean-moments ; cd:toFormula ex:md-shift-variance ; cd:appliesRule ex:rule-variance-definition ; cd:transformationKind cd:StatisticalTransformation ; cd:requiresAssumption ex:assumption-iid-finite ; cd:hasExplanation ex:md-shift-explanation-1 ; cd:authoredResource true .
  ex:md-shift-2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Multiply the expectation by fixed n"@en ; cd:fromFormula ex:md-shift-variance ; cd:toFormula ex:md-shift-expectation ; cd:appliesRule ex:rule-expectation-factor ; cd:transformationKind cd:StatisticalTransformation ; cd:requiresAssumption ex:assumption-iid-finite ; cd:hasExplanation ex:md-shift-explanation-2 ; cd:authoredResource true .
  ex:md-shift-explanation-1 a cd:Interpretation ; cd:body "For iid observations with finite variance, the sample mean has expectation μ and variance σ²/n. These are the required auxiliary moment results, not a new topic about confidence intervals.\nInsert Y = X̄ into the variance definition. Because E(X̄) = μ, the expected squared shift from μ equals Var(X̄).\nUppercase X̄ denotes the random sample mean; lowercase x̄ denotes a realized value."@en ; cd:applicationFormula ex:md-shift-variance ; cd:authoredResource true .
  ex:md-shift-explanation-2 a cd:Interpretation ; cd:body "Set Y = Δ² and c = n in the expectation-factor rule. The sample size is fixed across repetitions.\nMultiply the established expectation σ²/n by n; the factors n cancel.\nDo not pull the random quantity Δ outside expectation. Only the fixed coefficient n is moved."@en ; cd:applicationFormula ex:md-scale-shift-application ; cd:authoredResource true .

  ex:md-sum-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:md-sl1, ex:md-sl2 ; cd:authoredResource true .
  ex:md-sl1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed sample"@en ; cd:body "xᵢ: observation i; x̄: arithmetic sample mean; dᵢ: xᵢ − x̄. n: count; i: index; Σ: sum from 1 to n."@en ; dct:references ex:xi-symbol, ex:xbar-symbol, ex:vr-d-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:md-sl2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "General rule placeholders"@en ; cd:body "aᵢ and bᵢ: arbitrary indexed terms; c: the same constant at every index. The rule applies to this sample, without a probability assumption."@en ; dct:references ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol ; cd:authoredResource true .
  ex:md-bessel-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:md-bl1, ex:md-bl2, ex:md-bl3 ; cd:authoredResource true .
  ex:md-bl1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observations and centers"@en ; cd:body "Xᵢ: random observation i; X̄: sample mean; μ: population mean; dᵢ = Xᵢ − X̄; Δ = X̄ − μ. Lowercase xᵢ, x̄ are realized values."@en ; dct:references ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:xi-symbol, ex:xbar-symbol, ex:mu-symbol, ex:vr-d-symbol, ex:vs-Delta-symbol, ex:vr-delta-symbol ; cd:authoredResource true .
  ex:md-bl2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Counts and moments"@en ; cd:body "n > 1: count; i: index; Σ: sum from 1 to n. E: expectation; Var: variance; σ²: population variance; s²: sample variance."@en ; dct:references ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol, ex:vr-E-symbol, ex:vm-var-symbol, ex:vr-sigma2-symbol, ex:vr-s2-symbol ; cd:authoredResource true .
  ex:md-bl3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "General rule placeholders"@en ; cd:body "a, b, c, q: scalar placeholders; aᵢ, bᵢ: indexed terms. U, V, Y: random quantities. A constant moved outside Σ or E is fixed for that operation."@en ; dct:references ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol, ex:rule-q-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-Y-symbol ; cd:authoredResource true .

