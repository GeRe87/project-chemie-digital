  ex:md-bessel-section-3 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:derivation-bessel ; cd:firstDerivationStep ex:md-bessel-3 ; cd:lastDerivationStep ex:md-bessel-3 ; cd:usesLegend ex:md-bessel-legend ; cd:authoredResource true .
  ex:md-bessel-section-4 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:derivation-bessel ; cd:firstDerivationStep ex:md-bessel-4 ; cd:lastDerivationStep ex:md-bessel-4 ; cd:usesLegend ex:md-bessel-legend ; cd:authoredResource true .
