<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-experiments> {
 ex:rx-devices a cd:ChartDefinition ; skos:prefLabel "The retained CRM device A and an independent device B"@en ; cd:body "Every fictional measurement result is shown, including ties. A: mean 10.10, sample SD 0.10 mg/L. B: mean 10.00, sample SD 0.30 mg/L. The groups are independent, not paired observations. Variance ratio B/A is nine; closeness of means is a different question."@en ; cd:chartType cd:DotPlot ; cd:xAxisLabel "Independent device group"@en ; cd:yAxisLabel "Nitrate concentration"@en ; cd:yAxisUnit "mg/L" ; cd:hasChartGroup ex:rx-device-a, ex:rx-device-b ; cd:authoredResource true .
 ex:rx-device-a a cd:ChartGroup ; skos:prefLabel "Device A, same CRM series"@en ; cd:position 1 ; cd:usesDataset ex:rx-data-a ; cd:authoredResource true .
 ex:rx-device-b a cd:ChartGroup ; skos:prefLabel "Device B, independent series"@en ; cd:position 2 ; cd:usesDataset ex:rx-data-b ; cd:authoredResource true .
 ex:rx-ecdf a cd:ChartDefinition ; skos:prefLabel "The same seeded normal stream: empirical steps and a fixed model"@en ; cd:body "Change the prefix length and compare the two cumulative curves. The default 1,000 results have empirical fraction 0.978 at 10.20 mg/L, against model probability 0.977249868."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "ecdf" ; cd:hasExperimentParameter ex:rx-M, ex:rx-mu, ex:rx-sigma, ex:rx-seed, ex:rx-threshold ; cd:xAxisLabel "Individual nitrate result (mg/L)"@en ; cd:yAxisLabel "Cumulative fraction or probability"@en ; cd:authoredResource true .
 ex:rx-signed a cd:ChartDefinition ; skos:prefLabel "Increase independent signed effects, hold total SD fixed"@en ; cd:body "Predict the central mass before increasing the number of fair contributions from four toward 200. Overlay 0 hides and 1 shows the normal reference."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "signed" ; cd:hasExperimentParameter ex:rx-n4, ex:rx-sigma, ex:rx-overlay ; cd:xAxisLabel "Standardized total"@en ; cd:yAxisLabel "Mass divided by grid spacing"@en ; cd:authoredResource true .
 ex:rx-normal a cd:ChartDefinition ; skos:prefLabel "One threshold links standardized distance, density and cumulative probability"@en ; cd:body "Hypothetical known method parameters, not estimates from the nitrate samples. Move the concentration threshold. Inverse 1 instead chooses the upper-tail rate first."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:rx-inverse ; cd:xAxisLabel "Concentration"@en ; cd:yAxisLabel "Density or cumulative probability"@en ; cd:authoredResource true .
 ex:rx-means a cd:ChartDefinition ; skos:prefLabel "Individual results and independent averages on one concentration axis"@en ; cd:body "Change readings per average without changing individual method precision. The average becomes more stable, not less biased."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "means" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-n6 ; cd:xAxisLabel "Concentration (mg/L)"@en ; cd:yAxisLabel "Density (L/mg)"@en ; cd:authoredResource true .
 ex:rx-factors a cd:ChartDefinition ; skos:prefLabel "Absolute steps and relative factors are different mechanisms"@en ; cd:body "Mode 0: alternate equal absolute changes. Mode 1: repeat a relative factor. Mode 2: alternate a factor and its reciprocal. Both panels show the same positive values."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "factors" ; cd:hasExperimentParameter ex:rx-start, ex:rx-factor, ex:rx-delta, ex:rx-steps, ex:rx-mode ; cd:xAxisLabel "Step"@en ; cd:yAxisLabel "Concentration or log ratio"@en ; cd:authoredResource true .
 ex:rx-lognormal a cd:ChartDefinition ; skos:prefLabel "Normal log ratios, right-skewed positive concentrations"@en ; cd:body "Assumed median 10 ng/L and dimensionless log SD 0.30. Change log spread, inspect centers, then choose a threshold or an upper-tail rate. Inverse 1 selects the rate first."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "lognormal" ; cd:hasExperimentParameter ex:rx-reference, ex:rx-logsd, ex:rx-logthreshold, ex:rx-alpha05, ex:rx-inverse ; cd:xAxisLabel "Concentration (ng/L)"@en ; cd:yAxisLabel "Density or cumulative probability"@en ; cd:authoredResource true .
 ex:rx-squares a cd:ChartDefinition ; skos:prefLabel "Add independent squared standard-normal components"@en ; cd:body "Start with one component, then two and five. Sign disappears; the nonnegative sum moves and changes shape. The number of independent components supplies the degrees of freedom."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "squares" ; cd:hasExperimentParameter ex:rx-df, ex:rx-M, ex:rx-seed ; cd:xAxisLabel "Squared standardized sum"@en ; cd:yAxisLabel "Density"@en ; cd:authoredResource true .
 ex:rx-variance a cd:ChartDefinition ; skos:prefLabel "New complete series, new sample variance"@en ; cd:body "Assumed stable normal method with true SD 0.10 mg/L. Each simulated series estimates its own mean and variance. Hold six measurements fixed before comparing larger series."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "variance" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-observed ; cd:xAxisLabel "Sample variance ((mg/L) squared)"@en ; cd:yAxisLabel "Density"@en ; cd:authoredResource true .
 ex:rx-student a cd:ChartDefinition ; skos:prefLabel "Each mean is divided by its own estimated standard error"@en ; cd:body "Repeated independent normal series under a zero mean departure. The observed CRM departure is separately 0.10 mg/L with estimated SD 0.10 mg/L. Changing n is a hypothetical design comparison."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "student" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-departure, ex:rx-observedSd ; cd:xAxisLabel "Studentized mean departure"@en ; cd:yAxisLabel "Density"@en ; cd:authoredResource true .
 ex:rx-f a cd:ChartDefinition ; skos:prefLabel "Independent variance estimates form a random ratio"@en ; cd:body "Simulate independent normal groups with equal true variances. Observed B/A ratio is separately nine. Reverse 1 uses A/B and swaps the ordered numerator and denominator degrees of freedom."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "f-ratio" ; cd:hasExperimentParameter ex:rx-nA, ex:rx-nB, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-ratio, ex:rx-alpha05, ex:rx-reverse ; cd:xAxisLabel "Prespecified variance ratio"@en ; cd:yAxisLabel "Density"@en ; cd:authoredResource true .
 ex:rx-stress a cd:ChartDefinition ; skos:prefLabel "Stress the assumptions, not merely the p-value"@en ; cd:body "Mode 0 keeps both groups stable, mode 1 adds one outlier to B, mode 2 adds an acquisition-order drift to B. Inspect the ordered results before interpreting the nominal test."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "stress" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-sigma, ex:rx-seed, ex:rx-mode, ex:rx-mu, ex:rx-outlier, ex:rx-drift ; cd:xAxisLabel "Acquisition order"@en ; cd:yAxisLabel "Result (mg/L)"@en ; cd:authoredResource true .
 ex:rx-calibration a cd:ChartDefinition ; skos:prefLabel "Same calibration observations, nested linear and quadratic fits"@en ; cd:body "Twelve fixed concentrations from zero to ten mg/L, constructed response with curvature and fixed noise. The quadratic display switch does not replace the observations or refit another dataset."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "calibration" ; cd:hasExperimentParameter ex:rx-quadratic ; cd:usesDataset ex:rx-cal-data ; cd:xAxisLabel "Calibration concentration (mg/L)"@en ; cd:yAxisLabel "Response or residual"@en ; cd:authoredResource true .
 ex:rx-pearson a cd:ChartDefinition ; skos:prefLabel "Expected particle counts and two constructed outcomes"@en ; cd:body "One hundred independently classified particles; five fixed exhaustive categories. Mode 0 shows departing counts, mode 1 compatible counts. Expected counts and total stay fixed."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "pearson" ; cd:hasExperimentParameter ex:rx-pearson-mode ; cd:usesDataset ex:rx-pearson-data ; cd:xAxisLabel "Prespecified category"@en ; cd:yAxisLabel "Particle count"@en ; cd:authoredResource true .
 ex:rx-dilution a cd:ChartDefinition ; skos:prefLabel "Propagate absorbance and two volume uncertainties without R"@en ; cd:body "Source 0 combines all inputs, source 1 varies absorbance only, source 2 varies volumes only. The saved initial state is 10,000 trials with seed 20261101. All modes consume the same three uniform draws per trial."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "dilution" ; cd:hasExperimentParameter ex:rx-Mmc, ex:rx-seedmc, ex:rx-signal, ex:rx-signalSd, ex:rx-slope, ex:rx-intercept, ex:rx-pipette, ex:rx-pipetteHalf, ex:rx-flask, ex:rx-flaskHalf, ex:rx-source ; cd:xAxisLabel "Collected-sample concentration (mg/L)"@en ; cd:yAxisLabel "Simulated density (L/mg)"@en ; cd:authoredResource true .

