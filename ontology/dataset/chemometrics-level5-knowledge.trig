# Active Level 5 resources; original RDF identities and named graphs preserved.
@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/distribution-functions> {
  ex:cumulative-distribution-function rdf:type cd:Concept ;
    skos:prefLabel "Cumulative distribution function"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-cdf-definition .
  ex:l5-cdf-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The cumulative distribution function gives the probability that a random result is at most a specified real threshold. It is nondecreasing and right-continuous, with limits zero and one. Discrete masses produce jumps. A theoretical model CDF is not an empirical CDF calculated from observations."@en ;
    cd:hasSource ex:l5-source-r-distributions .
  ex:l5-pdf-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "A continuous density is nonnegative and integrates to one. Interval probabilities are areas under it, whereas an exact single real value has probability zero. Density has reciprocal measurement units and its numerical height may exceed one. Rounding to a measurement resolution represents an interval, not a mathematical point."@en ;
    cd:hasSource ex:l5-source-r-distributions .
  ex:l5-pmf-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "A probability mass function assigns a probability to each possible discrete value. Its nonnegative masses sum to one over the complete support. For the preceding binomial and Poisson models, a bar height is the probability of exactly one integer count, not a density."@en ;
    cd:hasSource ex:l5-source-r-distributions .
  ex:l5-quantile-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "For a probability strictly between zero and one, the theoretical quantile is the infimum of all real thresholds where the model CDF reaches or exceeds that probability. At a jump the CDF at the quantile can exceed the requested probability. This generalized inverse is not a particular empirical sample-quantile interpolation algorithm."@en ;
    cd:hasSource ex:l5-source-r-distributions .
  ex:probability-density-function rdf:type cd:Concept ;
    skos:prefLabel "Probability density function"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-pdf-definition .
  ex:theoretical-quantile rdf:type cd:Concept ;
    skos:prefLabel "Theoretical quantile"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-quantile-definition .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-analytical-lecture> {
  ex:al-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Probability distributions describe modeled variation of analytical quantities or sampling statistics. Their use requires a specified random quantity, parameters, assumptions and scope; a measured shape alone does not establish a model."@en .
  ex:l5-analytical-distributions rdf:type cd:Concept ;
    skos:prefLabel "Distributions in analytical measurement"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:al-definition .
  ex:l5-topic-map rdf:type skos:Concept ;
    skos:prefLabel "Connections · Distribution families"@en ;
    cd:authoredResource "true"^^xsd:boolean .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-clt> {
  ex:l5-c14d-entry dct:references ex:l5-c14d-limit ;
    dct:references ex:l5-c14d-mean ;
    dct:references ex:l5-c14d-parameters ;
    dct:references ex:l5-c14d-standard ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols and limiting statement"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-c14d-formula dct:hasPart ex:l5-c14d-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The square root of n times the sample mean minus mu, divided by sigma, converges in distribution to standard normal as n increases."@en ;
    cd:formulaLabel "Convergence in distribution, not exact finite-sample normality"@en ;
    cd:hasSymbol ex:l5-c14d-limit ;
    cd:hasSymbol ex:l5-c14d-mean ;
    cd:hasSymbol ex:l5-c14d-parameters ;
    cd:hasSymbol ex:l5-c14d-standard ;
    cd:latex "\\frac{\\sqrt n(\\bar X_n-\\mu)}{\\sigma}\\xrightarrow{\\mathcal D}\\mathcal N(0,1)" .
  ex:l5-c14d-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-c14d-entry .
  ex:l5-c14d-limit rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Arrow D means convergence in distribution as n increases. The limit is normal with mean 0 and variance 1, not an exact identity at n = 64."@en ;
    cd:mathNotation "\\xrightarrow{\\mathcal D},\\ \\mathcal N(0,1)" ;
    cd:symbol "distributional limit" .
  ex:l5-c14d-mean rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Random mean of n independent identically distributed individuals. The positive integer subscript n grows in the limit; the plot uses n = 64."@en ;
    cd:mathNotation "\\bar X_n,\\ n" ;
    cd:symbol "mean and sample size" .
  ex:l5-c14d-parameters rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Finite individual mean and positive finite SD. Here 10 and 9 mg/L. The denominator is population SD, not an estimated sample SD."@en ;
    cd:mathNotation "\\mu,\\ \\sigma" ;
    cd:symbol "population parameters" .
  ex:l5-c14d-standard rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Subtract the mean, multiply by the positive square root of n, divide by SD. Units cancel: standardized means are dimensionless."@en ;
    cd:mathNotation "\\sqrt n(\\bar X_n-\\mu)/\\sigma" ;
    cd:symbol "centering and scaling" .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-distribution-relations> {
  ex:al-chi-square rdf:type cd:Concept ;
    skos:prefLabel "Chi-square distribution"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:al-chi-square-definition .
  ex:al-chi-square-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The sum of squares of independent standard-normal quantities has a chi-square distribution, with degrees of freedom equal to the number of squared quantities. Under iid normal sampling this gives the exact law of sample size minus one times sample variance divided by population variance."@en .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-f-distribution> {
  ex:l5-f-distribution rdf:type cd:Concept ;
    skos:prefLabel "F reference for ratios of independent normal-sample variances"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-f17-definition .
  ex:l5-f17-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "An F variable is the ratio of two independent chi-square variables, each divided by its own degrees of freedom. For two independent samples, each iid normal, the sample-variance ratio has an F reference under equal population variances, with numerator sample size minus one and denominator sample size minus one degrees of freedom, in that order. An observed ratio alone does not establish different population precisions. The classical variance comparison is sensitive to nonnormality."@en .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-experiment-code> {
  ex:ix-simulation rdf:type cd:CodeExample ;
    skos:prefLabel "Repeat complete normal measurement series"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Hypothetical stable method. No field or validation data.
# First change M: 100, 1000, 10000. Later change n: 6, 30.
M <- 100; n <- 6; sigma <- 0.10; mu <- 10
stopifnot(M %in% c(100, 1000, 10000), n >= 2, n <= 100,
          n == as.integer(n), sigma > 0)
state <- 20261101
S2 <- numeric(M)
first <- numeric(n)
for (j in seq_len(M)) {
  x <- numeric(n)
  for (i in seq_len(n)) {
    state <- (16807 * state) %% 2147483647
    x[i] <- mu + sigma * qnorm(state / 2147483647)
  }
  if (j == 1) first <- x
  S2[j] <- sum((x - mean(x))^2) / (n - 1)
}
cat('First series (mg/L):', format(first, digits=8), '\\n')
cat('M:', M, 'n:', n, 'df:', n-1, '\\n')
cat('Mean sample variance:', mean(S2), '(mg/L)^2\\n')
cat('Relative SD, empirical:', sd(S2)/mean(S2),
    'theoretical:', sqrt(2/(n-1)), '\\n')
cat('Count at least observed variance 0.024:', sum(S2 >= 0.024), '\\n')
old <- par(mfrow=c(1,2), mar=c(5,4,3,1))
plot(seq_len(M), S2, pch=16, cex=0.35, col='#176b90',
     xlab='Independent series number', ylab='Sample variance ((mg/L)^2)',
     main=paste(M, 'complete series'), ylim=c(0,max(0.064,S2)))
abline(h=sigma^2, col='#a63d21', lty=2)
breaks <- seq(0, max(0.064, ceiling(max(S2)/0.002)*0.002), by=0.002)
hist(S2, breaks=breaks, right=FALSE, probability=TRUE, col='#8ecae6',
     xlab='Sample variance ((mg/L)^2)', ylab='Density per (mg/L)^2',
     main=paste('n =', n), xlim=c(0,max(breaks)))
abline(v=0.024, col='#a63d21', lwd=2)
par(old)
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:al-chi-square .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-experiments> {
  ex:ix-density-entry dct:references ex:ix-density-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Density, support and degrees of freedom"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "2"^^xsd:integer .
  ex:ix-density-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **X**: Random chi-square variable (dimensionless).
- **x**: Concrete value of X (dimensionless).
- **fₖ(x)**: Probability density at x for k degrees of freedom.
- **k**: Degrees of freedom; a positive real parameter of the density family.
- **e**: Base of the natural exponential.
- **Γ(k/2)**: Gamma function evaluated at k/2; part of the density normalization.
- **Powers**: Superscripts raise their bases to the stated exponents.
- **Multiplication, /, −**: Adjacent factors multiply; fractions divide; minus subtracts or negates.
- **>, =**: Greater than; equality defining the density.

Domain: x > 0. Density is zero for x < 0, and the probability of exactly zero is zero. The independent-square construction uses integer k. Parentheses group function arguments; total density area is one."""@en ;
    cd:mathNotation "X,x,f_k(x),k,e,\\Gamma(k/2),>,=,/,{}^{}" ;
    cd:symbol "chi-square density" .
  ex:ix-gamma-entry dct:references ex:ix-gamma-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "The normalizing Gamma function"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "3"^^xsd:integer .
  ex:ix-gamma-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Γ(a)**: Gamma function at positive real argument a.
- **a**: Dimensionless argument; here k/2.
- **t**: Dimensionless integration variable.
- **∫₀∞**: Integral over t from zero to positive infinity.
- **dt**: Infinitesimal increment of t.
- **tᵃ⁻¹, e⁻ᵗ**: A power of t and the natural exponential with exponent −t.

All quantities are dimensionless. For a positive integer m, Γ(m) = (m − 1) factorial."""@en ;
    cd:mathNotation "\\Gamma,a,t,\\int_0^\\infty,dt" ;
    cd:symbol "Gamma function" .
  ex:ix-series-a rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Series A: SD 0.056 mg/L"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "9.97, 10.04, 10.08, 9.93, 10.02, 9.96 mg/L. Mean 10.000 mg/L; sample variance 0.00316 (mg/L)²."@en ;
    cd:position "1"^^xsd:integer .
  ex:ix-series-b rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Series B: SD 0.086 mg/L"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "9.86, 10.05, 10.01, 10.12, 9.98, 9.98 mg/L. Mean 10.000 mg/L; sample variance 0.00748 (mg/L)²."@en ;
    cd:position "2"^^xsd:integer .
  ex:ix-series-c rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Series C: SD 0.128 mg/L"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "9.84, 10.19, 9.93, 10.11, 9.99, 9.94 mg/L. Mean 10.000 mg/L; sample variance 0.01648 (mg/L)². All three are illustrative series compatible with one stable normal method, not measured validation data."@en ;
    cd:position "3"^^xsd:integer .
  ex:ix-series-cards rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ix-series-a ;
    cd:hasDefinitionListEntry ex:ix-series-b ;
    cd:hasDefinitionListEntry ex:ix-series-c .
  ex:ix-size dct:hasPart ex:ix-size-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "More repeats stabilize the sample-variance estimate"@en ;
    cd:hasSymbol ex:ix-size-symbols ;
    cd:latex "\\begin{gathered}E(Q)=n-1,\\quad\\operatorname{Var}(Q)=2(n-1)\\\\\\operatorname{Var}(S^2)=\\frac{2\\sigma^4}{n-1},\\quad\\frac{\\operatorname{SD}(S^2)}{E(S^2)}=\\sqrt{\\frac{2}{n-1}}\\end{gathered}" .
  ex:ix-size-entry dct:references ex:ix-size-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Random estimates, operations and units"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ix-size-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ix-size-entry .
  ex:ix-size-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **n**: Number of independent Normal measurement results, at least two.
- **S²**: Random sample variance ((mg/L)²).
- **σ**: True population SD (mg/L).
- **Q**: Centred squared sum divided by true variance (dimensionless).
- **E**: Expectation; E(S²) has units (mg/L)².
- **Var**: Variance; Var(S²) has units (mg/L)⁴.
- **SD**: Positive square root of variance; SD(S²) has units (mg/L)².
- **n − 1**: Degrees of freedom after estimating one mean.
- **Powers, √, /, =**: Exponentiation, positive square root, division and equality; adjacent factors multiply.

SD(S²) / E(S²) is a dimensionless relative SD, displayed as a percentage. The QC statistic has this reference law at σ = σ₀."""@en ;
    cd:mathNotation "Q,n,S^2,\\sigma,E,\\operatorname{Var},\\operatorname{SD},=,-,{}^2,{}^4,/,\\sqrt{}" ;
    cd:symbol "uncertainty across complete repeated series" .
  ex:ix-square dct:hasPart ex:ix-square-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Squaring removes the sign and creates a new distribution"@en ;
    cd:hasSymbol ex:ix-square-symbols ;
    cd:latex "\\begin{gathered}Z\\sim\\mathcal N(0,1),\\quad Y=Z^2\\sim\\chi^2_1\\\\(-2)^2=(+2)^2=4\\\\(-0.5)^2=(+0.5)^2=0.25\\end{gathered}" .
  ex:ix-square-entry dct:references ex:ix-square-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Square and one degree of freedom"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ix-square-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ix-square-entry .
  ex:ix-square-media rdf:type cd:MediaAsset ;
    dct:description "The left density describes signed standard-Normal values; the right density describes their squares. Both -2 and +2 map to 4, folding the two tails onto one nonnegative axis."@en ;
    cd:alternativeText "Schematic densities before and after squaring. A symmetric standard-normal variable has signed SD-unit values. Its square is nonnegative, strongly right-skewed and has density unbounded near zero. Minus two and plus two both give four; minus one half and plus one half both give one quarter. Density axes are per dimensionless axis unit."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-normal-to-square.svg"^^xsd:anyURI .
  ex:ix-square-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Z**: Standard-normal random variable; mean zero and variance one.
- **Y**: Square of Z; a nonnegative random variable.
- **N(0, 1)**: Normal distribution with mean zero and variance one.
- **χ²₁**: Chi-square distribution with one degree of freedom.
- **∼**: Follows the named distribution.
- **², =**: Squaring; equality evaluating or defining a value.
- **+, −**: Signs indicating direction before squaring.

All quantities are dimensionless. Parentheses group signed values; squaring folds both tails onto the nonnegative axis."""@en ;
    cd:mathNotation "Z,Y,\\mathcal N(0,1),\\chi^2_1,\\sim,=,{}^2,+,-" ;
    cd:symbol "one squared normal component" .
  ex:ix-sum dct:hasPart ex:ix-sum-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Independent squares and the general chi-square density"@en ;
    cd:hasSymbol ex:ix-density-symbols ;
    cd:hasSymbol ex:ix-gamma-symbols ;
    cd:hasSymbol ex:ix-sum-symbols ;
    cd:latex "\\begin{gathered}X=\\sum_{i=1}^{k}Z_i^2\\sim\\chi^2_k\\\\f_k(x)=\\frac{x^{k/2-1}e^{-x/2}}{2^{k/2}\\Gamma(k/2)},\\quad x>0,\\;k>0\\\\\\Gamma(a)=\\int_0^\\infty t^{a-1}e^{-t}\\,dt,\\quad a>0\\end{gathered}" .
  ex:ix-sum-entry dct:references ex:ix-sum-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "What the subscript counts"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ix-sum-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ix-density-entry ;
    cd:hasDefinitionListEntry ex:ix-gamma-entry ;
    cd:hasDefinitionListEntry ex:ix-sum-entry .
  ex:ix-sum-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Zᵢ**: Standard-normal component i, with mean zero and variance one.
- **i**: Component index, from 1 through k.
- **k**: Positive integer number of independent components.
- **Σ, +**: Add the squared components.
- **²**: Square each component.
- **χ²ₖ**: Chi-square distribution with k degrees of freedom.
- **∼**: Follows the stated distribution.

Condition: the Zᵢ are independent. All variables and their squared sum are dimensionless."""@en ;
    cd:mathNotation "Z_i,i,k,\\sum,{}^2,+,\\sim,\\chi^2_k" ;
    cd:symbol "independent components and sum" .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-precision> {
  ex:ic-case rdf:type cd:WorkedExample ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Hypothetical IC nitrate repeatability check supplied for teaching. Fixed known reference SD sigma0=0.10 mg/L. Six independent repeats of a homogeneous sample: 9.95,10.15,9.85,10.25,9.95,10.15 mg/L; mean 10.05. Squared deviations sum to 0.12 (mg/L)^2; sample variance 0.024; SD 0.1549193338 mg/L. Prespecify alpha=0.05 and alternative sigma>sigma0. Q=12 has chi-square with 5 df at sigma=sigma0 under iid normal observations. For smaller sigma, Q is scaled smaller, so the boundary is least favorable for the composite null sigma<=sigma0. Cutoff 11.07049769351635; upper tail at 12 is 0.03478778050624185. Reject at 5% under these assumptions. This is evidence of poorer repeatability, not bias, a column-failure diagnosis or sample-release authorization. If the reference SD has material estimation uncertainty, this known-reference calibration is insufficient: account for its df using an appropriate independent variance comparison or another justified method."@en .
  ex:ic-decision dct:hasPart ex:ic-decision-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "One-sided test of deterioration in repeatability"@en ;
    cd:hasSymbol ex:ic-decision-ops ;
    cd:hasSymbol ex:ic-decision-quantile ;
    cd:hasSymbol ex:ic-decision-values ;
    cd:latex "\\begin{gathered}H_0:\\sigma\\le\\sigma_0,\\quad H_1:\\sigma>\\sigma_0\\\\q=12>\\chi^2_{5;0.95}\\approx11.07\\\\p=P_{\\sigma=\\sigma_0}(Q\\ge12)\\approx0.03479\\end{gathered}" .
  ex:ic-decision-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-decision-context1 .
  ex:ic-decision-context1 rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Is this spread unusual under unchanged precision"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Q = 12 exceeds the 5% cutoff 11.07; its boundary-model upper tail is 3.48%. This indicates increased spread under the stated assumptions. Investigating the analytical system is a separate step."@en ;
    cd:position "1"^^xsd:integer .
  ex:ic-decision-entry dct:references ex:ic-decision-ops ;
    dct:references ex:ic-decision-quantile ;
    dct:references ex:ic-decision-values ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Hypotheses, threshold and tail probability"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ic-decision-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-decision-entry .
  ex:ic-decision-ops rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **:**: Introduces the statement of a hypothesis.
- **≤, >, ≥**: At most, greater than and at least.
- **=, ≈**: Equality and approximate equality.
- **α**: Prespecified significance level, 0.05.

For σ below σ₀, the upper-tail rejection probability is smaller. Calibration at σ = σ₀ therefore controls the composite null."""@en ;
    cd:mathNotation ":,\\le,>,\\ge,=,\\approx" ;
    cd:symbol "decision notation" .
  ex:ic-decision-quantile rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **q**: Observed QC statistic, 12.
- **Q**: Random statistic under the boundary model.
- **χ²₅;₀.₉₅**: 95th percentile of chi-square with five degrees of freedom.
- **P**: Probability under the null boundary σ = σ₀.
- **p**: Upper-tail probability P(Q ≥ q) under that boundary.

All these quantities are dimensionless. The p-value is a probability about the statistic under the stated model."""@en ;
    cd:mathNotation "q,Q,\\chi^2_{5;0.95},p,P" ;
    cd:symbol "upper-tail comparison" .
  ex:ic-decision-values rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **H₀**: True repeatability SD is at most the reference SD.
- **H₁**: True repeatability SD exceeds the reference SD.
- **σ**: True repeatability SD (mg/L).
- **σ₀**: Known reference SD, 0.10 mg/L; subscript 0 identifies the reference.

The comparison concerns repeatability spread."""@en ;
    cd:mathNotation "H_0,H_1,\\sigma,\\sigma_0" ;
    cd:symbol "hypotheses and SD" .
  ex:ic-law dct:hasPart ex:ic-law-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Reference law when true SD equals the validated reference"@en ;
    cd:hasSymbol ex:ic-law-ops ;
    cd:hasSymbol ex:ic-law-values ;
    cd:latex "Q=\\frac{(n-1)S^2}{\\sigma_0^2}\\sim\\chi^2_{n-1}=\\chi^2_5\\quad(\\sigma=\\sigma_0)" .
  ex:ic-law-entry dct:references ex:ic-law-ops ;
    dct:references ex:ic-law-values ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Random variance reference and boundary condition"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ic-law-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-law-entry .
  ex:ic-law-ops rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Subtract one fitted mean: n-1=5 df. Square SD and divide as shown; juxtaposition multiplies. Equality defines Q and identifies the df-five family; tilde names its law. Exact only for iid normal results at sigma=sigma0; below that boundary Q is scaled smaller."@en ;
    cd:mathNotation "-,{}^2,/,=,\\sim,\\chi^2_{n-1}" ;
    cd:symbol "law and degrees of freedom" .
  ex:ic-law-values rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Q varies across new six-result series; observed q is 12. n=6; S squared is random sample variance. Sigma is fixed true method SD; sigma0=0.10 mg/L is reference SD. Both SDs have mg/L units; Q is dimensionless."@en ;
    cd:mathNotation "Q,n,S^2,\\sigma,\\sigma_0" ;
    cd:symbol "random series statistic" .
  ex:ic-process-media rdf:type cd:MediaAsset ;
    dct:description "Six independent nitrate measurements of one homogeneous sample form the precision check. The independently known reference SD is 0.10 mg/L."@en ;
    cd:alternativeText "Known-reference IC precision check: reference repeatability SD 0.10 mg/L and six independent nitrate measurements on the same homogeneous water sample. Chi-square compares the scaled squared-deviation sum with repeated-series variation to assess the observed precision."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-ic-precision-process.svg"^^xsd:anyURI .
  ex:ic-q dct:hasPart ex:ic-q-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Same squared deviations, scaled by the reference variance"@en ;
    cd:hasSymbol ex:ic-q-ops ;
    cd:hasSymbol ex:ic-q-values ;
    cd:latex "q=\\sum_{i=1}^{6}\\left(\\frac{x_i-\\bar x}{\\sigma_0}\\right)^2=\\frac{0.12}{0.10^2}=12" .
  ex:ic-q-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-q-context1 .
  ex:ic-q-context1 rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Put the observed spread on the reference scale"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Scaling by an independently known reference SD makes squared residuals comparable across concentration units. Estimating one mean links the residuals and leaves five independent degrees of freedom in a six-result sample."@en ;
    cd:position "1"^^xsd:integer .
  ex:ic-q-entry dct:references ex:ic-q-ops ;
    dct:references ex:ic-q-values ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Reference scaling"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ic-q-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-q-entry .
  ex:ic-q-ops rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Σ**: Add all six indexed terms.
- **i**: Measurement index, from 1 through 6.
- **−**: Subtract the sample mean from a measurement.
- **/, ²**: Divide by the reference SD, then square the ratio.
- **=**: Rewrites the same calculation; parentheses group each ratio.

The squared-deviation sum is 0.12 (mg/L)². Dividing by (0.10 mg/L)² cancels the units and gives q = 12."""@en ;
    cd:mathNotation "\\sum,i,-,/,{}^2,=" ;
    cd:symbol "squared scaled residuals" .
  ex:ic-q-values rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **q**: Observed statistic for this series (dimensionless).
- **xᵢ**: IC measurement result i (mg/L).
- **x̄**: Sample mean, 10.05 mg/L; the bar denotes averaging.
- **σ₀**: Independently known reference SD, 0.10 mg/L; subscript 0 labels the reference."""@en ;
    cd:mathNotation "q,x_i,\\bar x,\\sigma_0" ;
    cd:symbol "observed statistic" .
  ex:ic-readings rdf:type cd:Dataset ;
    skos:prefLabel "Six constructed IC nitrate repeats"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:derivedFromResource ex:ic-case ;
    cd:hasObservation ex:ic-x1 ;
    cd:hasObservation ex:ic-x2 ;
    cd:hasObservation ex:ic-x3 ;
    cd:hasObservation ex:ic-x4 ;
    cd:hasObservation ex:ic-x5 ;
    cd:hasObservation ex:ic-x6 ;
    cd:unit "mg/L" .
  ex:ic-residual-media rdf:type cd:MediaAsset ;
    dct:description "The six residuals are divided by the reference SD of 0.10 mg/L, squared and added in measurement order. Their squared standardized values sum to 12."@en ;
    cd:alternativeText "In original measurement order, subtract fitted mean 10.05 mg/L and divide by fixed reference SD 0.10 mg/L. Scaled residuals are -1, 1, -2, 2, -1, 1; their squares are 1, 1, 4, 4, 1, 1, summing to 12. The centered residuals satisfy a zero-sum constraint."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-ic-residual-squares.svg"^^xsd:anyURI .
  ex:ic-spread dct:hasPart ex:ic-spread-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Sample spread versus the known reference SD"@en ;
    cd:hasSymbol ex:ic-spread-ops ;
    cd:hasSymbol ex:ic-spread-reference ;
    cd:hasSymbol ex:ic-spread-values ;
    cd:latex "\\begin{gathered}s^2=\\frac{\\sum_{i=1}^{6}(x_i-\\bar x)^2}{6-1}=0.024\\;(\\mathrm{mg/L})^2\\\\s\\approx0.155\\;\\mathrm{mg/L},\\quad\\sigma_0=0.10\\;\\mathrm{mg/L}\\end{gathered}" .
  ex:ic-spread-entry dct:references ex:ic-spread-ops ;
    dct:references ex:ic-spread-reference ;
    dct:references ex:ic-spread-values ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Data, divisor and units"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:ic-spread-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:ic-spread-entry .
  ex:ic-spread-ops rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **i**: Measurement index, from 1 through 6.
- **Σ**: Add all indexed squared deviations.
- **−, ², /**: Subtraction, squaring and division.
- **√**: Positive square root.
- **=, ≈**: Equality and approximate equality.

Estimating one sample mean leaves divisor 6 − 1 = 5."""@en ;
    cd:mathNotation "\\sum,i,-,{}^2,/,=,\\sqrt{},\\approx" ;
    cd:symbol "calculation" .
  ex:ic-spread-reference rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **σ₀**: Reference SD, 0.10 mg/L, known independently.

Subscript 0 identifies the reference; the reference value comes from outside this sample."""@en ;
    cd:mathNotation "\\sigma_0" ;
    cd:symbol "reference SD" .
  ex:ic-spread-values rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **xᵢ**: Measurement i (mg/L).
- **x̄**: Sample mean, 10.05 mg/L; the bar denotes averaging.
- **s²**: Observed sample variance ((mg/L)²).
- **s**: Observed sample SD, the positive square root of s² (mg/L)."""@en ;
    cd:mathNotation "x_i,\\bar x,s^2,s" ;
    cd:symbol "sample spread" .
  ex:ic-x1 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "9.95"^^xsd:decimal ;
    cd:position "1"^^xsd:integer .
  ex:ic-x2 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.15"^^xsd:decimal ;
    cd:position "2"^^xsd:integer .
  ex:ic-x3 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "9.85"^^xsd:decimal ;
    cd:position "3"^^xsd:integer .
  ex:ic-x4 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.25"^^xsd:decimal ;
    cd:position "4"^^xsd:integer .
  ex:ic-x5 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "9.95"^^xsd:decimal ;
    cd:position "5"^^xsd:integer .
  ex:ic-x6 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.15"^^xsd:decimal ;
    cd:position "6"^^xsd:integer .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ks> {
  ex:l5-g19b-distance rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Subtract CDFs and take absolute value, allowing discrepancies in either direction. Equality defines dimensionless D, between 0 and 1."@en ;
    cd:mathNotation "D_n,\\ |\\cdot|,\\ -,\\ =" ;
    cd:symbol "two-sided distance" .
  ex:l5-g19b-empirical rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Observed fraction at or below threshold x, based on n = 5 concentrations. Its values are dimensionless; thresholds use mg/L."@en ;
    cd:mathNotation "F_n(x),\\ n" ;
    cd:symbol "empirical CDF" .
  ex:l5-g19b-entry dct:references ex:l5-g19b-distance ;
    dct:references ex:l5-g19b-empirical ;
    dct:references ex:l5-g19b-null ;
    dct:references ex:l5-g19b-sup ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols and fixed reference"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-g19b-formula dct:hasPart ex:l5-g19b-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The two-sided KS statistic is the supremum, over all real thresholds, of the absolute difference between empirical and specified model CDFs."@en ;
    cd:formulaLabel "Largest vertical CDF discrepancy"@en ;
    cd:hasSource ex:l5-source-nist-ks ;
    cd:hasSymbol ex:l5-g19b-distance ;
    cd:hasSymbol ex:l5-g19b-empirical ;
    cd:hasSymbol ex:l5-g19b-null ;
    cd:hasSymbol ex:l5-g19b-sup ;
    cd:latex "D_n=\\sup_{x\\in\\mathbb R}|F_n(x)-F_0(x)|" .
  ex:l5-g19b-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-g19b-entry .
  ex:l5-g19b-null rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Null CDF fixed before these data: normal, mean 10 mg/L and SD 0.50 mg/L. Subscript 0 identifies the null, not a sample size."@en ;
    cd:mathNotation "F_0(x)" ;
    cd:symbol "specified model CDF" .
  ex:l5-g19b-sup rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Least upper bound over every real threshold x. Membership and R mean all real values, not only a finite plotting grid."@en ;
    cd:mathNotation "\\sup_{x\\in\\mathbb R}" ;
    cd:symbol "supremum over thresholds" .
  ex:l5-g19c-entry dct:references ex:l5-g19c-model ;
    dct:references ex:l5-g19c-operators ;
    dct:references ex:l5-g19c-order ;
    dct:references ex:l5-g19c-sides ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, indices and jump limits"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-g19c-formula dct:hasPart ex:l5-g19c-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "For sorted distinct values and a continuous model, check empirical right-hand values minus model CDF and model CDF minus empirical left-hand values. The maximum of both sets is about 0.144578."@en ;
    cd:formulaLabel "Check both sides of every empirical jump"@en ;
    cd:hasSource ex:l5-source-nist-ks ;
    cd:hasSymbol ex:l5-g19c-model ;
    cd:hasSymbol ex:l5-g19c-operators ;
    cd:hasSymbol ex:l5-g19c-order ;
    cd:hasSymbol ex:l5-g19c-sides ;
    cd:latex "\\begin{gathered}D^+=\\max_i\\left(\\frac{i}{n}-F_0(x_{(i)})\\right)\\\\D^-=\\max_i\\left(F_0(x_{(i)})-\\frac{i-1}{n}\\right)\\\\D_n=\\max(D^+,D^-)\\approx0.144578\\end{gathered}" .
  ex:l5-g19c-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-g19c-entry .
  ex:l5-g19c-model rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Fixed model CDF at rank i; empirical value just after the jump and its left limit just before. All three are dimensionless."@en ;
    cd:mathNotation "F_0(x_{(i)}),\\ i/n,\\ (i-1)/n" ;
    cd:symbol "model and jump sides" .
  ex:l5-g19c-operators rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Check all five ranks, subtract and divide as shown, then take maxima. Equalities define statistics; approximation rounds the dimensionless result."@en ;
    cd:mathNotation "\\max_i,\\ -,\\ /,\\ =,\\ \\approx" ;
    cd:symbol "maximum and arithmetic" .
  ex:l5-g19c-order rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Parenthesized index is sorted rank, not a power. Here i runs 1 to n = 5; concentrations are in mg/L."@en ;
    cd:mathNotation "x_{(i)},\\ i,\\ n" ;
    cd:symbol "sorted concentrations" .
  ex:l5-g19c-sides rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Superscripts label upward and downward discrepancies, not powers or signed final distances. Both maxima are about 0.144578 here; D is the larger."@en ;
    cd:mathNotation "D^+,\\ D^-,\\ D_n" ;
    cd:symbol "directional maxima" .
  ex:l5-kolmogorov-smirnov rdf:type cd:Concept ;
    skos:prefLabel "One-sample Kolmogorov-Smirnov goodness-of-fit test"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-ks-definition .
  ex:l5-ks-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The two-sided one-sample Kolmogorov-Smirnov statistic is the supremum absolute vertical distance between the empirical CDF and a specified reference CDF. For iid observations under a fully specified continuous null distribution, its classical null calibration depends on sample size, not the shape of that CDF. Estimating parameters from the same observations, discreteness, ties, censoring or dependence requires suitable calibration rather than unmodified classical critical values. Failure to reject does not establish that the model is true."@en ;
    cd:hasSource ex:l5-source-nist-ks .
  ex:l5-source-nist-ks dct:creator "NIST/SEMATECH" ;
    dct:identifier "l5-source-nist-ks" ;
    dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/eda35g.htm> ;
    dct:title "NIST/SEMATECH e-Handbook: Kolmogorov-Smirnov Goodness-of-Fit Test" ;
    rdf:type cd:Source ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:supportsResource ex:l5-g19b-formula ;
    cd:supportsResource ex:l5-g19c-formula ;
    cd:supportsResource ex:l5-ks-definition .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal> {
  ex:l5-l12b-formula dct:hasPart ex:l5-l12b-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Define U as the natural logarithm of positive concentration X divided by a reference concentration. U follows a normal model with log-ratio mean m and variance s squared."@en ;
    cd:formulaLabel "Normal on the log scale"@en ;
    cd:hasSource ex:l5-source-r-lognormal ;
    cd:hasSymbol ex:l5-lb-concentration ;
    cd:hasSymbol ex:l5-lb-log ;
    cd:hasSymbol ex:l5-lb-notation ;
    cd:hasSymbol ex:l5-lb-parameters ;
    cd:latex "\\begin{gathered}U=\\ln(X/c_0)\\sim\\mathcal{N}(m,s^2)\\\\X>0,\\quad s>0\\end{gathered}" .
  ex:l5-l12b-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-lb-entry .
  ex:l5-l12c-formula dct:hasPart ex:l5-l12c-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The population median and geometric mean equal the reference concentration times exp of m. The arithmetic expectation equals the reference times exp of m plus half the log variance."@en ;
    cd:formulaLabel "Population median and mean are different"@en ;
    cd:hasSource ex:l5-source-r-lognormal ;
    cd:hasSymbol ex:l5-lc-concentration ;
    cd:hasSymbol ex:l5-lc-operators ;
    cd:hasSymbol ex:l5-lc-parameters ;
    cd:hasSymbol ex:l5-lc-summaries ;
    cd:latex "\\begin{gathered}\\operatorname{Median}(X)=G(X)=c_0e^m\\\\E[X]=c_0e^{m+s^2/2}\\end{gathered}" .
  ex:l5-l12c-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-lc-entry .
  ex:l5-lb-concentration rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Positive concentration X in mg/L; fixed reference c with subscript 0 is 1 mg/L. Division cancels units before taking a logarithm."@en ;
    cd:mathNotation "X,\\ c_0" ;
    cd:symbol "X and reference" .
  ex:l5-lb-entry dct:references ex:l5-lb-concentration ;
    dct:references ex:l5-lb-log ;
    dct:references ex:l5-lb-notation ;
    dct:references ex:l5-lb-parameters ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, units and convention"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-lb-log rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "U is the dimensionless log ratio; ln is the natural logarithm. Negative log ratios are valid for concentrations below the reference."@en ;
    cd:mathNotation "U,\\ \\ln" ;
    cd:symbol "U and ln" .
  ex:l5-lb-notation rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Equality defines U; / divides; tilde means distributed as; N denotes normal. Greater than zero requires positive concentration and log SD."@en ;
    cd:mathNotation "=,\\ /,\\ \\sim,\\ \\mathcal{N},\\ >" ;
    cd:symbol "model and operators" .
  ex:l5-lb-parameters rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Log-ratio mean m = 0.69315 and SD s = 0.75 here, both dimensionless. The second normal parameter is variance, not concentration SD."@en ;
    cd:mathNotation "m,\\ s,\\ s^2" ;
    cd:symbol "m, s and variance" .
  ex:l5-lc-concentration rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Random positive concentration X; reference c with subscript 0 is fixed at 1 mg/L. Multiplying by this reference restores concentration units."@en ;
    cd:mathNotation "X,\\ c_0" ;
    cd:symbol "X and reference" .
  ex:l5-lc-entry dct:references ex:l5-lc-concentration ;
    dct:references ex:l5-lc-operators ;
    dct:references ex:l5-lc-parameters ;
    dct:references ex:l5-lc-summaries ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, population targets and units"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-lc-operators rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "e is the natural exponential base. Equality states identities; + adds half the log variance; /2 divides by two. Juxtaposition multiplies; exponents are dimensionless."@en ;
    cd:mathNotation "e,\\ =,\\ +,\\ /,\\ s^2" ;
    cd:symbol "exponential and arithmetic" .
  ex:l5-lc-parameters rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Mean and positive SD of the natural log of X/reference, both dimensionless: m = 0.69315 and s = 0.75. Squaring s gives log variance."@en ;
    cd:mathNotation "m,\\ s" ;
    cd:symbol "m and s" .
  ex:l5-lc-summaries rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Population median and geometric mean G: 2.00 mg/L. Arithmetic expectation E: about 2.65 mg/L. These are model quantities, not sample estimates."@en ;
    cd:mathNotation "\\operatorname{Median},\\ G,\\ E" ;
    cd:symbol "Median, G and E" .
  ex:l5-lognormal-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "A positive concentration follows a lognormal model when the natural logarithm of its ratio to a fixed positive reference concentration is normally distributed. The normal parameters describe the dimensionless log ratio, not the concentration itself. Multiplicative influences can motivate such a model, but positivity, right skew or a log transformation alone does not establish it."@en ;
    cd:hasSource ex:l5-source-r-lognormal .
  ex:lognormal-concentration-model rdf:type cd:Concept ;
    skos:prefLabel "Lognormal concentration model"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-lognormal-definition .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal-workup> {
  ex:lg-definition dct:hasPart ex:lg-definition-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Normal log ratio, lognormal concentration"@en ;
    cd:hasSource ex:l5-source-r-lognormal ;
    cd:hasSymbol ex:lg-definition-symbols ;
    cd:latex "\\begin{gathered}Y=\\ln(X/x_{\\mathrm{ref}})\\sim\\mathcal N(\\mu_L,\\sigma_L^2)\\\\X=x_{\\mathrm{ref}}e^Y\\end{gathered}" .
  ex:lg-definition-entry dct:references ex:lg-definition-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Log parameters are dimensionless and the reference restores units"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:lg-definition-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:lg-definition-entry .
  ex:lg-definition-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **X**: Positive random concentration (ng/L).
- **$x_{ref}$**: Fixed positive reference concentration, 10 ng/L; subscript ref means reference.
- **$Y$**: Natural log ratio $\\ln(X / x_{ref})$, dimensionless.
- **$μ_L$**: Mean of the log ratio, dimensionless; subscript L identifies the log scale.
- **$σ_L$**: Positive SD of the log ratio, dimensionless.
- **$N, ∼$**: Normal distribution; follows that distribution. Its second parameter is variance $σ_L^2$.
- **ln, e**: Natural logarithm and the base of the natural exponential.
- **/, ², =**: Division, squaring and equality defining the transforms.

Here $μ_L = 0$ and $σ_L = 0.30$, giving median 10 ng/L. Multiplying the exponentiated ratio by the reference restores concentration units."""@en ;
    cd:mathNotation "X,Y,x_{\\mathrm{ref}},\\mu_L,\\sigma_L,\\ln,e,{}^2,\\mathcal N,\\sim,/,=" ;
    cd:symbol "the transformed normal model" .
  ex:lg-log-scale dct:hasPart ex:lg-log-scale-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "The same three concentrations become equally spaced log ratios"@en ;
    cd:hasSymbol ex:lg-log-scale-symbols ;
    cd:latex "\\begin{gathered}\\ln(8/10)\\approx-0.22314\\\\\\ln(10/10)=0\\\\\\ln(12.5/10)\\approx+0.22314\\end{gathered}" .
  ex:lg-log-scale-entry dct:references ex:lg-log-scale-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Never take a logarithm of an unreferenced dimensional value"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:lg-log-scale-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:lg-log-scale-entry .
  ex:lg-log-scale-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **ln**: Natural logarithm of a dimensionless ratio.
- **/**: Divide a concentration by the reference 10 ng/L; all concentrations use ng/L.
- **−, +**: Direction below or above zero on the log-ratio scale.
- **=, ≈**: Equality and approximate equality.

The concentrations are 8, 10 and 12.5 ng/L. Reciprocal ratios 0.8 and 1.25 give opposite log values. Equal multiplicative ratios become equal log-scale distances; a Normal log-scale law is a separate model condition."""@en ;
    cd:mathNotation "\\ln,/,-,+,=,\\approx" ;
    cd:symbol "log ratios and reciprocal symmetry" .
  ex:lg-process-cards rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:lg-process1 ;
    cd:hasDefinitionListEntry ex:lg-process2 .
  ex:lg-process1 rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "A: repeat the instrument step"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Organic trace analyte by LC-MS/MS, in ng/L. Reinject one prepared homogeneous control. The simplified instrument model uses mainly additive error."@en ;
    cd:position "1"^^xsd:integer .
  ex:lg-process2 rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "B: repeat the complete preparation"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Independently extract, concentrate and analyse aliquots from one homogeneous sample. Relative step-to-step effects motivate a multiplicative candidate model."@en ;
    cd:position "2"^^xsd:integer .
  ex:lg-quantile dct:hasPart ex:lg-quantile-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "A model upper threshold with a five-percent per-result tail"@en ;
    cd:hasSymbol ex:lg-quantile-symbols ;
    cd:latex "\\begin{gathered}z_{0.95}=\\Phi^{-1}(0.95)\\approx1.64485\\\\x_{0.95}=x_{\\mathrm{ref}}\\exp(\\mu_L+\\sigma_L z_{0.95})\\\\\\approx16.38\\;\\mathrm{ng/L}\\end{gathered}" .
  ex:lg-quantile-entry dct:references ex:lg-quantile-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Inverse CDF first, exponentiation second"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:lg-quantile-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:lg-quantile-entry .
  ex:lg-quantile-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **z₀.₉₅**: Standard-normal 95th percentile (dimensionless).
- **x₀.₉₅**: Corresponding concentration percentile (ng/L); subscript 0.95 is the cumulative probability.
- **$x_{ref}$**: Reference concentration, 10 ng/L.
- **$μ_L$**: Log-ratio mean, 0; subscript L denotes the log scale.
- **$σ_L$**: Log-ratio SD, 0.30 (dimensionless).
- **Φ⁻¹**: Inverse standard-normal CDF, mapping cumulative probability to a z value.
- **exp**: Natural exponential, applied to the dimensionless log-scale value.
- **+, =, ≈**: Addition, equality and approximate equality; adjacent factors multiply.

The unrounded quantile is 16.3796740847 ng/L. This is a per-result model threshold; rounding, resolution and estimated parameters matter when constructing a real rule."""@en ;
    cd:mathNotation "z_{0.95},x_{0.95},x_{\\mathrm{ref}},\\mu_L,\\sigma_L,\\Phi^{-1},\\exp,+,=,\\approx" ;
    cd:symbol "model quantile and back-transformation" .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal-workup-code> {
  ex:lg-compare-code rdf:type cd:CodeExample ;
    skos:prefLabel "Instrument-only and independent complete preparations"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Separate fictional series, not paired validation measurements.
# Relative factors are NOT literal unbounded extraction recoveries.
M <- 1000; steps <- 3; factor_model <- 'normal'
x0 <- 10; sd_instrument <- 0.10; sigma_L <- 0.30; state <- 20261103
stopifnot(M>=10,M<=10000,steps>=1,steps<=200,
          factor_model %in% c('normal','binary'))
A <- numeric(M); B <- numeric(M); log_total <- numeric(M)
for(j in seq_len(M)) {
  state <- (16807*state) %% 2147483647
  A[j] <- x0+sd_instrument*qnorm(state/2147483647)
  contributions <- numeric(steps)
  for(i in seq_len(steps)) {
    state <- (16807*state) %% 2147483647
    u <- state/2147483647
    contributions[i] <- sigma_L/sqrt(steps) *
      if(factor_model=='normal') qnorm(u) else if(u<0.5) -1 else 1
  }
  log_total[j] <- sum(contributions)
  B[j] <- x0*prod(exp(contributions))
}
cat('Instrument mean and SD (ng/L):',mean(A),sd(A),'\\n')
cat('Preparation mean (ng/L):',mean(B),'log SD:',sd(log_total),'\\n')
cat('Preparation count above 15 ng/L:',sum(B>15),'of',M,'\\n')
edges_B <- seq(0,max(36,ceiling(max(B)/2)*2),by=2)
hB <- hist(B,breaks=edges_B,right=FALSE,plot=FALSE)
cat('Preparation bin counts:',hB$counts,'\\n')
cat('Normal log factors: exact lognormal. Binary log factors: finite discrete model.\\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
hist(A,breaks=seq(floor(min(A)/.05)*.05,ceiling(max(A)/.05)*.05,by=.05),
     right=FALSE,probability=TRUE,col='#8ecae6',main='A: instrument only',
     xlab='Result (ng/L)',ylab='Density (L/ng)')
plot(hB,freq=FALSE,col='#8ecae6',main='B: complete preparation',
     xlab='Result (ng/L)',ylab='Density (L/ng)')
par(old)
cat('Panel ranges differ; the concentration units are the same.\\n')
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:lognormal-concentration-model .
  ex:lg-environment-code rdf:type cd:CodeExample ;
    skos:prefLabel "One hundred river sites: candidate, mixture and censored observations"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# New population: between-site concentrations, NOT technical repeats.
M <- 100; mode <- 'candidate'; x_ref <- 10; sigma_site <- 0.60
loq <- 5; state <- 20261103
stopifnot(mode %in% c('candidate','mixture','censored'))
log_ratio <- numeric(M)
for(i in seq_len(M)) {
  state <- (16807*state) %% 2147483647
  log_ratio[i] <- sigma_site*qnorm(state/2147483647)
}
if(mode=='mixture') {
  for(i in seq_len(M)) {
    state <- (16807*state) %% 2147483647
    if(state/2147483647<.30) log_ratio[i] <- log_ratio[i]+1.2
  }
}
latent <- x_ref*exp(log_ratio)
observed <- latent
if(mode=='censored') observed[latent<loq] <- NA_real_
cat('Mode:',mode,'sites:',M,'censored:',sum(is.na(observed)),'\\n')
if(mode=='censored') cat('Plots show detections only: selection-biased, NOT model validation.\\n')
kept <- observed[!is.na(observed)]
stopifnot(all(kept>0))
logged <- log(kept/x_ref)
old <- par(mfrow=c(1,3),mar=c(5,4,3,1))
hist(kept,probability=TRUE,col='#8ecae6',main=paste(mode,'sites'),
     xlab='Concentration (ng/L)',ylab='Observed density (L/ng)')
hist(logged,probability=TRUE,col='#8ecae6',main='Same retained values, log ratios',
     xlab='Natural log ratio',ylab='Density per log-ratio unit')
qqnorm(logged,pch=16,cex=.6,col='#176b90',main='Normal Q-Q of log ratios')
qqline(logged,col='#a63d21',lwd=2)
par(old)
cat('A Q-Q plot does not establish independence. No zero substitution or log(0).\\n')
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:lognormal-concentration-model .
  ex:lg-transform-code rdf:type cd:CodeExample ;
    skos:prefLabel "Exponentiate normal log ratios and compare log spreads"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Fixed median 10 ng/L; log SD changes, not the reference units.
M <- 10000; x_ref <- 10; mu_L <- 0; sigma_L <- 0.30; state <- 20261103
stopifnot(M>=100,M<=10000,x_ref>0,sigma_L>0,sigma_L<=1)
Y <- numeric(M)
for(i in seq_len(M)) {
  state <- (16807*state) %% 2147483647
  Y[i] <- mu_L+sigma_L*qnorm(state/2147483647)
}
X <- x_ref*exp(Y)
model_mode <- x_ref*exp(mu_L-sigma_L^2)
model_median <- x_ref*exp(mu_L)
model_mean <- x_ref*exp(mu_L+sigma_L^2/2)
cat('Population mode, median, mean (ng/L):',model_mode,model_median,model_mean,'\\n')
cat('Sample geometric mean (ng/L):',x_ref*exp(mean(log(X/x_ref))),'\\n')
cat('Upper probability above 15 ng/L:',pnorm((log(15/x_ref)-mu_L)/sigma_L,lower.tail=FALSE),'\\n')
q95 <- x_ref*exp(mu_L+sigma_L*qnorm(.95))
cat('Population 95th percentile (ng/L):',format(q95,digits=12),'\\n')
old <- par(mfrow=c(1,3),mar=c(5,4,3,1))
hist(Y,probability=TRUE,col='#8ecae6',main='Normal log ratios',
     xlab='Y: natural log ratio',ylab='Density per log-ratio unit')
curve(dnorm(x,mu_L,sigma_L),add=TRUE,col='#a63d21',lwd=2)
hist(X,probability=TRUE,col='#8ecae6',main='Exponentiated results',
     xlab='Concentration (ng/L)',ylab='Density (L/ng)')
curve(dlnorm(x/x_ref,meanlog=mu_L,sdlog=sigma_L)/x_ref,
      add=TRUE,col='#a63d21',lwd=2)
grid <- seq(.01,35,length.out=1000)
spreads <- c(.15,.30,.60); colors <- c('#176b90','#a63d21','#5c469c')
densities <- sapply(spreads,function(s) dlnorm(grid/x_ref,mu_L,s)/x_ref)
matplot(grid,densities,type='l',lty=1,col=colors,lwd=2,
        xlab='Concentration (ng/L)',ylab='Density (L/ng)',main='Same median, different log SD')
legend('topright',legend=spreads,col=colors,lty=1,bty='n',title='Log SD')
par(old)
cat('The comparison-density window ends at 35; tails and moments are not truncated.\\n')
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:lognormal-concentration-model .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal-workup-visuals> {
  ex:lg-process-media rdf:type cd:MediaAsset ;
    dct:description "Path A reinjects one prepared control; path B repeats extraction, concentration and analysis on independent aliquots. The paths distinguish instrument variation from variation of the complete preparation."@en ;
    cd:alternativeText "Two repeat experiments for an organic trace analyte in ng/L by LC-MS/MS. A reinjects one prepared homogeneous control solution. B splits a homogeneous water sample into independent aliquots, each undergoing extraction, concentration and instrumental analysis. Relative influences in B motivate a multiplicative candidate model."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-lognormal-workup-process.svg"^^xsd:anyURI .
  ex:lg-scales-media rdf:type cd:MediaAsset ;
    dct:description "The concentrations 8, 10 and 12.5 ng/L have unequal gaps on the linear axis. Relative to 10 ng/L, their natural log ratios have equal gaps on either side of zero."@en ;
    cd:alternativeText "Concentrations 8, 10 and 12.5 ng/L on a linear axis have gaps 2 and 2.5 ng/L. On a natural-log-ratio axis relative to 10 ng/L they lie at minus 0.22314, zero and plus 0.22314, with equal gaps. Reciprocal factors 0.8 and 1.25 become opposite additive log steps."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-lognormal-ratio-scales.svg"^^xsd:anyURI .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-mechanism-map> {
  ex:map-chi-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "6"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:map-chi-context .
  ex:map-chi-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-chi-context-entry .
  ex:map-chi-context-entry rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Chi-square: squared and scaled"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- Add independent squared standard normals.
- Normal samples: scaled sample variance."""@en ;
    cd:position "1"^^xsd:integer .
  ex:map-chi-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "7"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:map-chi-formula .
  ex:map-chi-formula dct:hasPart ex:map-chi-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasSymbol ex:map-chi-symbol ;
    cd:latex "\\begin{gathered}Q=Z_1^2+\\cdots+Z_\\nu^2\\\\Q=\\frac{(n-1)S^2}{\\sigma^2}\\end{gathered}" .
  ex:map-chi-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-chi-symbol-entry .
  ex:map-chi-symbol rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Q**: Chi-square random variable (dimensionless).
- **Zᵢ**: Independent standard-normal component i, with mean zero and variance one.
- **$ν$**: Positive integer number of degrees of freedom; the last component is $Z_ν$.
- **n**: Number of independent, identically distributed Normal measurements, at least two.
- **S²**: Sample variance about the estimated mean, using divisor n − 1 ((mg/L)²).
- **σ²**: Positive true population variance ((mg/L)²).
- **², +, …**: Squaring, addition and continuation through all ν components.
- **−, /, =**: Subtraction, division and equality; adjacent factors multiply.

For sample variance, ν = n − 1. Scaling cancels concentration units. Independent Z components correspond to orthonormal residual coordinates; the raw centred residuals share the fitted mean."""@en ;
    cd:mathNotation "Q,Z_1,Z_\\nu,\\nu,n,S^2,\\sigma^2,{}^2,+,-,/,=,\\cdots" ;
    cd:symbol "scaled variance" .
  ex:map-chi-symbol-entry dct:references ex:map-chi-symbol ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Independent squares and the normal-sample variance"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:map-f-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "10"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:map-f-context .
  ex:map-f-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-f-context-entry .
  ex:map-f-context-entry rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "F: variance ratios"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- Two independent normal samples.
- Normalize each variance by its true variance, then divide."""@en ;
    cd:position "1"^^xsd:integer .
  ex:map-f-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "11"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:map-f-formula .
  ex:map-f-formula dct:hasPart ex:map-f-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasSymbol ex:map-f-symbol ;
    cd:latex "F=\\frac{S_B^2/\\sigma_B^2}{S_A^2/\\sigma_A^2}" .
  ex:map-f-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-f-symbol-entry .
  ex:map-f-symbol rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **F**: Random normalized variance ratio (dimensionless).
- **$S_B^2, S_A^2$**: Random sample variances in groups B and A ($\\mathrm{(mg/L)^2}$).
- **$σ_B^2, σ_A^2$**: Corresponding positive true population variances ($\\mathrm{(mg/L)^2}$).
- **A, B**: Independent groups; B supplies the numerator and A the denominator.
- **²**: Squaring an SD to obtain variance.
- **/, =**: Inner fractions normalize each variance; the outer fraction forms the ratio; equality defines F.

Within each group, measurements are independent and identically Normal; group means may differ. Each sample variance uses its fitted mean and divisor sample count minus one. Ordered degrees of freedom are B count minus one, then A count minus one. Equal true variances cancel."""@en ;
    cd:mathNotation "F,S_B^2,\\sigma_B^2,S_A^2,\\sigma_A^2,{}^2,/,=" ;
    cd:symbol "normalized variance ratio" .
  ex:map-f-symbol-entry dct:references ex:map-f-symbol ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Normalize each independent variance estimate"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:map-log-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "4"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:map-log-context .
  ex:map-log-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-log-context-entry .
  ex:map-log-context-entry rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Lognormal: relative factors"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- Multiply positive relative factors.
- A normal log-sum gives a lognormal product."""@en ;
    cd:position "1"^^xsd:integer .
  ex:map-log-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "5"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:map-log-formula .
  ex:map-log-formula dct:hasPart ex:map-log-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasSymbol ex:map-log-symbol ;
    cd:latex "Y=X_1\\cdot X_2\\cdot X_3\\cdots" .
  ex:map-log-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-log-symbol-entry .
  ex:map-log-symbol rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Y**: Positive random total relative factor (dimensionless).
- **X₁, X₂, X₃**: Positive random relative factors (dimensionless); subscripts identify the factors.
- **·**: Multiplication of factors.
- **…, =**: Continuation of the finite product; equality defining Y.

Condition: the sum of natural-log factors is Normal; independent Normal log factors suffice. Multiplying Y by a fixed reference concentration restores concentration units."""@en ;
    cd:mathNotation "Y,X_1,X_2,X_3,\\cdot,\\cdots,=" ;
    cd:symbol "relative factors" .
  ex:map-log-symbol-entry dct:references ex:map-log-symbol ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "A product of positive relative factors"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:map-mechanisms-scene dct:subject ex:l5-topic-map ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:l5-analytical-distributions ;
    cd:hasSceneItem ex:al-map-h ;
    cd:hasSceneItem ex:map-chi-c ;
    cd:hasSceneItem ex:map-chi-f ;
    cd:hasSceneItem ex:map-f-c ;
    cd:hasSceneItem ex:map-f-f ;
    cd:hasSceneItem ex:map-log-c ;
    cd:hasSceneItem ex:map-log-f ;
    cd:hasSceneItem ex:map-normal-c ;
    cd:hasSceneItem ex:map-normal-f ;
    cd:hasSceneItem ex:map-t-c ;
    cd:hasSceneItem ex:map-t-f ;
    cd:narration "The five families describe different constructions: Normal models for suitable additive effects; Lognormal models for products of relative factors with a Normal log sum; chi-square for independent squared standard Normals or scaled Normal-sample variances; Student for centred means divided by estimated standard errors; and F for ratios of independent normalized variances. Each construction has its stated sampling assumptions."@en .
  ex:map-normal-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:map-normal-context .
  ex:map-normal-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-normal-context-entry .
  ex:map-normal-context-entry rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Normal: additive contributions"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- Independent normal contributions: exact.
- Many small effects: approximation under suitable conditions."""@en ;
    cd:position "1"^^xsd:integer .
  ex:map-normal-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:map-normal-formula .
  ex:map-normal-formula dct:hasPart ex:map-normal-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasSymbol ex:map-normal-symbol ;
    cd:latex "Y=X_1+X_2+X_3+\\cdots" .
  ex:map-normal-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-normal-symbol-entry .
  ex:map-normal-symbol rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Y**: Random total concentration contribution (mg/L).
- **X₁, X₂, X₃**: Random additive contributions, such as injection, flow and detector effects (mg/L).
- **1, 2, 3**: Subscripts identifying the contributions.
- **+**: Addition.
- **…, =**: Continuation of the finite sum; equality defining Y.

Independent Normal contributions give an exact Normal sum. A central-limit approximation requires suitable conditions, including finite variances and control of the individual contributions relative to the total variation."""@en ;
    cd:mathNotation "Y,X_1,X_2,X_3,+,\\cdots,=" ;
    cd:symbol "additive contributions" .
  ex:map-normal-symbol-entry dct:references ex:map-normal-symbol ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "A sum of additive random contributions"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:map-t-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "8"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:map-t-context .
  ex:map-t-context rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-t-context-entry .
  ex:map-t-context-entry rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Student-t: standardized means"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- Center the mean; use its estimated standard error.
- Independent normal measurements."""@en ;
    cd:position "1"^^xsd:integer .
  ex:map-t-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "9"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:map-t-formula .
  ex:map-t-formula dct:hasPart ex:map-t-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasSymbol ex:map-t-symbol ;
    cd:latex "T=\\frac{\\bar X-\\mu}{S/\\sqrt n}" .
  ex:map-t-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:map-t-symbol-entry .
  ex:map-t-symbol rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **T**: Random Student variable (dimensionless).
- **X̄**: Random sample mean (mg/L); the bar denotes averaging.
- **μ**: Fixed true population mean (mg/L).
- **S**: Positive sample SD from the same measurements (mg/L).
- **n**: Sample count, at least two.
- **S / √n**: Estimated standard error of the mean (mg/L); the square root is positive.
- **−, /, =**: Centre the mean, divide its departure by the standard error, and define T.

Condition: independent, identically distributed Normal measurements. Sample variance uses divisor n − 1, giving n − 1 Student degrees of freedom."""@en ;
    cd:mathNotation "T,\\bar X,\\mu,S,n,-,/,\\sqrt{},=" ;
    cd:symbol "standardized means" .
  ex:map-t-symbol-entry dct:references ex:map-t-symbol ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "A random mean divided by its estimated standard error"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-model-check-story> {
  ex:rev-check-protocol rdf:type cd:WorkedExample ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Two constructed teaching samples, each n=5, are compared with a normal model fixed before either sample: mean 10 mg/L, SD 0.50 mg/L. A: 9.4, 9.8, 10.0, 10.2, 10.6 mg/L. B: 10.3, 10.31, 10.32, 10.33, 12.0 mg/L, a deliberately right-skewed departure. Neither set proves a population family. Q-Q probabilities are (i-0.5)/5 for sorted rank i. Corresponding normal quantiles are 9.3592242172277, 9.73779974364598, 10.0, 10.26220025635402, 10.6407757827723 mg/L. For KS check both jump sides, not just included ECDF values. A has D=0.14457825838967642; B has D=0.7257468822499269 at the left side of the first jump (10.3 mg/L). Both use exact n=5 two-sided fixed-continuous-null cutoff 0.5632751983660635 at alpha 0.05. A is not rejected, B is rejected. The figures use the same samples for both Q-Q and KS, but visual compatibility is not proof of normality. If parameters are fitted to these data, use suitable Lilliefors or refitted-bootstrap calibration instead of this classical table. Fixed affine transformation of both data and model preserves KS distance. Standardizing with estimated parameters does not restore classical calibration."@en .
  ex:rev-ks-code rdf:type cd:CodeExample ;
    skos:prefLabel "The same exact critical value with base R uniroot"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """n <- 5; a <- 0.05  # sample size; upper-tail level
tail <- function(d) { k <- 0:floor(n*(1-d))
  2*d*sum(choose(n,k)*(d+k/n)^(k-1)*(1-d-k/n)^(n-k)) }
uniroot(function(d) tail(d)-a, c(.500001,.999999), tol=1e-12)$root
# 0.5632751984. Exact shortcut here requires d above 0.5.""" ;
    cd:editable "false"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:l5-kolmogorov-smirnov .
  ex:rev-ks-media dct:references ex:rev-check-protocol ;
    dct:description "The ECDFs and fixed Normal CDF use common concentration axes. Marked vertical gaps include both sides of each jump: the largest gaps are 0.144578 for A and 0.725747 for B."@en ;
    dct:references ex:rev-qq-a ;
    dct:references ex:rev-qq-b ;
    rdf:type cd:MediaAsset ;
    cd:alternativeText "ECDF steps and the same fixed normal CDF overlaid on common concentration and cumulative-probability axes. A's largest vertical gap is 0.144578. B's largest gap is 0.725747 just before its first observation 10.3 mg/L. Vertical segments mark discrepancies; open and filled points distinguish left limits and included values. Both samples use their original concentration scale."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-ks-overlay-pair.svg"^^xsd:anyURI .
  ex:rev-pearson-code rdf:type cd:CodeExample ;
    skos:prefLabel "The same chi-square critical value in base R"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """qchisq(1 - 0.05, df = 4)  # 9.487729
pchisq(11.6, df = 4, lower.tail = FALSE)  # 0.02058737
# Upper-tail 5% in the table = cumulative 95% for qchisq.""" ;
    cd:editable "false"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:l5-pearson-gof .
  ex:rev-qa1 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "9.4"^^xsd:decimal ;
    cd:position "1"^^xsd:integer ;
    cd:xValue "9.3592242172277"^^xsd:decimal .
  ex:rev-qa2 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "9.8"^^xsd:decimal ;
    cd:position "2"^^xsd:integer ;
    cd:xValue "9.73779974364598"^^xsd:decimal .
  ex:rev-qa3 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.0"^^xsd:decimal ;
    cd:position "3"^^xsd:integer ;
    cd:xValue "10.0"^^xsd:decimal .
  ex:rev-qa4 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.2"^^xsd:decimal ;
    cd:position "4"^^xsd:integer ;
    cd:xValue "10.26220025635402"^^xsd:decimal .
  ex:rev-qa5 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.6"^^xsd:decimal ;
    cd:position "5"^^xsd:integer ;
    cd:xValue "10.6407757827723"^^xsd:decimal .
  ex:rev-qb1 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.3"^^xsd:decimal ;
    cd:position "1"^^xsd:integer ;
    cd:xValue "9.3592242172277"^^xsd:decimal .
  ex:rev-qb2 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.31"^^xsd:decimal ;
    cd:position "2"^^xsd:integer ;
    cd:xValue "9.73779974364598"^^xsd:decimal .
  ex:rev-qb3 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.32"^^xsd:decimal ;
    cd:position "3"^^xsd:integer ;
    cd:xValue "10.0"^^xsd:decimal .
  ex:rev-qb4 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "10.33"^^xsd:decimal ;
    cd:position "4"^^xsd:integer ;
    cd:xValue "10.26220025635402"^^xsd:decimal .
  ex:rev-qb5 rdf:type cd:Observation ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "12.0"^^xsd:decimal ;
    cd:position "5"^^xsd:integer ;
    cd:xValue "10.6407757827723"^^xsd:decimal .
  ex:rev-qq rdf:type cd:Concept ;
    skos:prefLabel "Normal quantile-quantile plot"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:rev-qq-def .
  ex:rev-qq-a rdf:type cd:Dataset ;
    skos:prefLabel "Q-Q pairs, compatible constructed sample A"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:derivedFromResource ex:rev-check-protocol ;
    cd:hasObservation ex:rev-qa1 ;
    cd:hasObservation ex:rev-qa2 ;
    cd:hasObservation ex:rev-qa3 ;
    cd:hasObservation ex:rev-qa4 ;
    cd:hasObservation ex:rev-qa5 ;
    cd:unit "mg/L" .
  ex:rev-qq-b rdf:type cd:Dataset ;
    skos:prefLabel "Q-Q pairs, deliberately skewed constructed sample B"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:derivedFromResource ex:rev-check-protocol ;
    cd:hasObservation ex:rev-qb1 ;
    cd:hasObservation ex:rev-qb2 ;
    cd:hasObservation ex:rev-qb3 ;
    cd:hasObservation ex:rev-qb4 ;
    cd:hasObservation ex:rev-qb5 ;
    cd:unit "mg/L" .
  ex:rev-qq-def rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "A normal Q-Q plot pairs ordered observations with normal theoretical quantiles at explicitly chosen plotting probabilities. Approximate linearity is descriptive evidence about normal shape, not a hypothesis-test decision. Against a fully specified normal model, agreement should be near the identity line in common units. A fitted location-scale line answers a different shape question."@en ;
    cd:hasSource ex:rev-source-qq .
  ex:rev-qq-entry dct:references ex:rev-qq-symbol1 ;
    dct:references ex:rev-qq-symbol2 ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Q-Q coordinates and convention"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:rev-qq-formula dct:hasPart ex:rev-qq-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Pair a theoretical quantile with each sorted result"@en ;
    cd:hasSymbol ex:rev-qq-symbol1 ;
    cd:hasSymbol ex:rev-qq-symbol2 ;
    cd:latex "p_i=\\frac{i-0.5}{n},\\quad (q_i,x_{(i)})=(F_0^{-1}(p_i),x_{(i)})" .
  ex:rev-qq-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:rev-qq-entry .
  ex:rev-qq-media dct:references ex:rev-qq-a ;
    dct:description "Both Q-Q panels compare ordered concentrations with quantiles of the same fixed Normal model. A stays close to the identity line; B bends strongly toward its extreme upper observation."@en ;
    dct:references ex:rev-qq-b ;
    rdf:type cd:MediaAsset ;
    cd:alternativeText "Two normal Q-Q plots on common concentration axes. Each x coordinate is the fixed normal-model quantile at a midpoint rank probability; y is sorted observed concentration. Sample A follows the identity line closely. Sample B has four nearly equal values and one extreme upper value, producing a pronounced bend and departure from the fixed model."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-qq-pair.svg"^^xsd:anyURI .
  ex:rev-qq-reading rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:rev-qq-reading1 .
  ex:rev-qq-reading1 rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Read the pattern before calculating a test"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Comparison with a fixed model assesses location, scale and shape together. Fitting a straight line adjusts location and scale to inspect shape. Five observations provide limited evidence about a population distribution."@en ;
    cd:position "1"^^xsd:integer .
  ex:rev-qq-symbol1 rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **i**: Sorted observation rank, from 1 through n.
- **n**: Sample count, 5 here.
- **pᵢ**: Midpoint plotting probability at rank i (dimensionless).
- **−, /**: Subtract 0.5 from the rank, then divide by n.

The formula specifies the midpoint plotting convention; pᵢ is a plotting probability."""@en ;
    cd:mathNotation "i,n,p_i" ;
    cd:symbol "rank and plotting probability" .
  ex:rev-qq-symbol2 rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **qᵢ**: Horizontal theoretical quantile at probability pᵢ (mg/L).
- **x₍ᵢ₎**: Vertical sorted observation at rank i (mg/L).
- **F₀⁻¹**: Inverse of the fixed model CDF; subscript 0 identifies the specified model.
- **( , ), =**: Ordered coordinate pair and equality defining it.

Superscript −1 denotes the inverse function."""@en ;
    cd:mathNotation "q_i,x_{(i)},F_0^{-1}" ;
    cd:symbol "theoretical and observed quantiles" .
  ex:rev-source-qq dct:creator "NIST/SEMATECH" ;
    dct:identifier "rev-source-qq" ;
    dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/normprpl.htm> ;
    dct:title "NIST/SEMATECH: Normal Probability Plot" ;
    rdf:type cd:Source ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:supportsResource ex:rev-qq-def .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal> {
  ex:l5-n09c-formula dct:hasPart ex:l5-n09c-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The normal density has a normalizing factor and an exponential of minus one half the squared standardized distance from the mean."@en ;
    cd:formulaLabel "The normal probability density"@en ;
    cd:hasSource ex:l5-source-r-normal ;
    cd:hasSymbol ex:l5-nc-constants ;
    cd:hasSymbol ex:l5-nc-location ;
    cd:hasSymbol ex:l5-nc-operators ;
    cd:hasSymbol ex:l5-nc-value ;
    cd:latex "f(x)=\\frac{1}{\\sigma\\sqrt{2\\pi}}\\exp\\!\\left(-\\frac{(x-\\mu)^2}{2\\sigma^2}\\right)" .
  ex:l5-n09c-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-nc-entry .
  ex:l5-n10a-formula dct:hasPart ex:l5-n10a-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Standardize by subtracting the mean and dividing by the standard deviation. The threshold 10.45 becomes 1.5. The probability above it is one minus Phi of 1.5, about 6.68 percent."@en ;
    cd:formulaLabel "A result 1.5 standard deviations above the mean"@en ;
    cd:hasSource ex:l5-source-r-normal ;
    cd:hasSymbol ex:l5-nt-cdf ;
    cd:hasSymbol ex:l5-nt-operators ;
    cd:hasSymbol ex:l5-nt-reading ;
    cd:hasSymbol ex:l5-nt-standard ;
    cd:latex "\\begin{gathered}Z=\\frac{X-\\mu}{\\sigma},\\quad z=\\frac{10.45-10.0}{0.30}=1.5\\\\P(X>10.45)=1-\\Phi(1.5)\\approx6.68\\%\\end{gathered}" .
  ex:l5-n10a-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-nt-entry .
  ex:l5-nc-constants rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Pi is about 3.14159; exp is the natural exponential; the root is the positive square root. Constants 1 and 2 are dimensionless."@en ;
    cd:mathNotation "\\pi,\\ \\exp,\\ \\sqrt{2\\pi}" ;
    cd:symbol "pi, exponential and root" .
  ex:l5-nc-entry dct:references ex:l5-nc-constants ;
    dct:references ex:l5-nc-location ;
    dct:references ex:l5-nc-operators ;
    dct:references ex:l5-nc-value ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, operators and units"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-nc-location rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Mean 10.0 mg/L and positive SD 0.30 mg/L here. Sigma squared is variance, in (mg/L) squared."@en ;
    cd:mathNotation "\\mu,\\ \\sigma" ;
    cd:symbol "mu, sigma" .
  ex:l5-nc-operators rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Equality defines f. Subtract, square, divide by twice the variance, then negate: a dimensionless exponent. Multiply by the prefactor to normalize area."@en ;
    cd:mathNotation "(x-\\mu)^2/(2\\sigma^2)" ;
    cd:symbol "equality and arithmetic" .
  ex:l5-nc-value rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Density in L/mg at concentration x in mg/L, not point probability. Areas are probabilities; total area on the real line is one."@en ;
    cd:mathNotation "f(x)" ;
    cd:symbol "f, x" .
  ex:l5-normal-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "A normal distribution is a continuous model with a real mean and a strictly positive standard deviation. Its density is symmetric about the mean and integrates to one. Normal measurement errors are an assumption to check, not a universal property of chemical measurements. Repeated technical measurements of the same homogeneous sample and variation across environmental sites are different populations."@en ;
    cd:hasSource ex:l5-source-r-normal .
  ex:l5-nt-cdf rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "P denotes event probability; Phi is the standard-normal CDF, giving left-tail probability. One minus Phi gives the right tail."@en ;
    cd:mathNotation "P,\\ \\Phi" ;
    cd:symbol "P, Phi" .
  ex:l5-nt-entry dct:references ex:l5-nt-cdf ;
    dct:references ex:l5-nt-operators ;
    dct:references ex:l5-nt-reading ;
    dct:references ex:l5-nt-standard ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, units and probability"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-nt-operators rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Subtract and divide to standardize; > means above. Equalities are exact identities; approximation and percent give rounded probability, not a confidence interval."@en ;
    cd:mathNotation "=,\\ -,\\ /,\\ >,\\ \\approx,\\ \\%" ;
    cd:symbol "operators and percent" .
  ex:l5-nt-reading rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "One future measurement result; mean 10.0 and SD 0.30, all in mg/L. Threshold 10.45 is in mg/L; the units cancel in the ratio."@en ;
    cd:mathNotation "X,\\ \\mu,\\ \\sigma" ;
    cd:symbol "X, mu, sigma" .
  ex:l5-nt-standard rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Dimensionless standardized random measurement result and threshold. Z is standard normal: mean 0, variance 1. Lowercase z = 1.5 is not a probability."@en ;
    cd:mathNotation "Z,\\ z" ;
    cd:symbol "Z, z" .
  ex:normal-measurement-model rdf:type cd:Concept ;
    skos:prefLabel "Normal model for repeated measurements"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-normal-definition .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-code> {
  ex:nn-ecdf-code rdf:type cd:CodeExample ;
    skos:prefLabel "Observed step CDF versus the fixed theoretical normal CDF"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Same deterministic 1000-draw sample as the saved histogram.
M <- 1000; mu <- 10.00; sigma <- 0.10; state <- 20261102
x <- numeric(M)
for(i in seq_len(M)) {
  state <- (16807*state) %% 2147483647
  x[i] <- mu+sigma*qnorm(state/2147483647)
}
Fn <- ecdf(x)
cat('Observed fractions at 9.80, 10.00, 10.20:',Fn(c(9.8,10,10.2)),'\\n')
cat('Theoretical CDF at 10.20:',pnorm(10.2,mu,sigma),'\\n')
cat('Observed upper fraction:',mean(x>10.2),'\\n')
plot(Fn,verticals=FALSE,do.points=FALSE,col='#176b90',lwd=2,
     main='1000 observations versus an assumed model',
     xlab='Nitrate threshold (mg/L)',ylab='Cumulative probability')
curve(pnorm(x,mean=mu,sd=sigma),add=TRUE,col='#a63d21',lwd=2)
legend('topleft',c('Empirical step CDF','Fixed theoretical CDF'),
       col=c('#176b90','#a63d21'),lty=1,bty='n')
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:normal-measurement-model .
  ex:nn-readings-code rdf:type cd:CodeExample ;
    skos:prefLabel "More individual measurements, then deliberately change the error model"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Fictional normal generator, not fitted control or validation data.
# Start with M = 20, 50, 100, 1000 and mode = 'stable'.
M <- 20; mode <- 'stable'
mu <- 10.00; sigma <- 0.10; state <- 20261102
stopifnot(M %in% c(20,50,100,1000),
          mode %in% c('stable','drift','interference','censored'))
x <- numeric(M)
for (i in seq_len(M)) {
  state <- (16807 * state) %% 2147483647
  x[i] <- mu + sigma * qnorm(state/2147483647)
}
if (mode == 'drift') x <- x + seq(0,0.30,length.out=M)
if (mode == 'interference') {
  for (i in seq_len(M)) {
    state <- (16807 * state) %% 2147483647
    if (state/2147483647 < 0.02) x[i] <- x[i] + 0.50
  }
}
# Artificial reporting threshold for the demonstration, NOT a nitrate LOD.
report_limit <- 9.95
if (mode == 'censored') x <- pmax(report_limit,x)
edges <- seq(min(9.60,floor(min(x)/0.05)*0.05),
             max(10.40,ceiling(max(x)/0.05)*0.05),by=0.05)
h <- hist(x,breaks=edges,right=FALSE,plot=FALSE)
cat('M:',M,'mode:',mode,'mean:',mean(x),'sample SD:',sd(x),'\\n')
cat('Counts at most 9.80, 10.00, 10.20:',
    sum(x<=9.8),sum(x<=10),sum(x<=10.2),'\\n')
cat('Histogram counts:',h$counts,'\\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
plot(seq_len(M),x,pch=16,cex=0.6,col='#176b90',
     xlab='Acquisition order',ylab='Nitrate result (mg/L)',main=mode)
plot(h,freq=FALSE,col='#8ecae6',main=paste(M,'results'),
     xlab='Nitrate result (mg/L)',ylab='Density (L/mg)')
par(old)
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:normal-measurement-model .
  ex:nn-threshold-code rdf:type cd:CodeExample ;
    skos:prefLabel "$z$, $\\varphi$, $\\Phi$ and an upper limit"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:code """# Fixed known model. Change limit, mu or sigma; no parameter estimation.
mu <- 10.00; sigma <- 0.10; limit <- 10.20; alpha <- 0.01
stopifnot(is.finite(mu),is.finite(limit),is.finite(sigma),sigma>0,
          alpha>0,alpha<1)
z <- (limit-mu)/sigma
phi <- dnorm(z); Phi <- pnorm(z)
upper <- pnorm(z,lower.tail=FALSE)
eta_star <- qnorm(1-alpha); x_star <- mu+sigma*eta_star
cat('z-score:',z,'\\n')
cat('phi: density per z-unit, NOT a probability:',phi,'\\n')
cat('Phi: probability at or below limit:',Phi,'\\n')
cat('Above limit:',100*upper,'%\\n')
cat('Upper',100*alpha,'% threshold (mg/L):',format(x_star,digits=12),'\\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
grid <- seq(-4,4,length.out=801)
plot(grid,dnorm(grid),type='l',col='#176b90',lwd=2,
     xlab='Standardized threshold z',ylab='Density per z-unit',main='Lowercase phi')
cut <- max(-4,min(4,z)); left <- seq(-4,cut,length.out=400)
polygon(c(-4,left,cut),c(0,dnorm(left),0),col='#8ecae6',border=NA)
abline(v=z,col='#a63d21',lty=2)
plot(grid,pnorm(grid),type='l',col='#176b90',lwd=2,ylim=c(0,1),
     xlab='Standardized threshold z',ylab='Cumulative probability',main='Uppercase Phi')
abline(v=z,h=Phi,col='#a63d21',lty=2)
par(old)
cat('Graphs show z -4 to 4; probabilities use the full normal law.\\n')
""" ;
    cd:editable "true"^^xsd:boolean ;
    cd:executable "true"^^xsd:boolean ;
    cd:programmingLanguage "r" ;
    cd:showsResource ex:normal-measurement-model .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-story> {
  ex:nn-bands dct:hasPart ex:nn-bands-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Derive the familiar coverage rule from the CDF"@en ;
    cd:hasSymbol ex:nn-bands-symbols ;
    cd:latex "\\begin{gathered}P(a\\le Z\\le b)=\\Phi(b)-\\Phi(a)\\\\P(-k\\le Z\\le k)=2\\Phi(k)-1\\end{gathered}" .
  ex:nn-bands-entry dct:references ex:nn-bands-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symmetry and two-sided coverage"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-bands-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-bands-entry .
  ex:nn-bands-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Z**: Standard-normal random variable.
- **a, b**: Ordered interval bounds (dimensionless).
- **k**: Positive symmetric distance from zero, in SD units.
- **P**: Probability.
- **Φ**: Standard-normal CDF, giving cumulative probability.
- **≤**: Includes each interval endpoint; each exact value has probability zero.
- **−, +, =**: Subtraction, addition and equality.
- **2Φ(k)**: Two times Φ(k); adjacent quantities multiply.

Subtract the lower CDF from the upper. Symmetry gives central coverage 2Φ(k) − 1, leaving one tail on each side."""@en ;
    cd:mathNotation "Z,a,b,k,\\Phi,P,\\le,-,+,=,2" ;
    cd:symbol "central probability versus upper tail" .
  ex:nn-cdf dct:hasPart ex:nn-cdf-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "The normal density has no elementary antiderivative. Its CDF is an antiderivative expressed using the special error function erf. Scaling the argument by the square root of two and applying the half-offset gives the standard-normal CDF, with its integration constant fixed by probability zero at minus infinity. The error function itself is not the normal CDF and is not a probability."@en ;
    cd:formulaLabel "The normal-density antiderivative uses the error function"@en ;
    cd:hasSymbol ex:nn-cdf-symbols ;
    cd:hasSymbol ex:nn-erf-symbols ;
    cd:latex "\\begin{gathered}\\Phi(z)=P(Z\\le z)\\\\=\\int_{-\\infty}^{z}\\varphi(t)\\,dt\\\\=\\frac12\\left[1+\\operatorname{erf}\\!\\left(\\frac{z}{\\sqrt2}\\right)\\right]\\\\\\operatorname{erf}(u)=\\frac{2}{\\sqrt\\pi}\\int_0^u e^{-t^2}\\,dt\\\\\\Phi(2)\\approx0.9772499\\end{gathered}" .
  ex:nn-cdf-entry dct:references ex:nn-cdf-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Density versus cumulative probability"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-cdf-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-cdf-entry ;
    cd:hasDefinitionListEntry ex:nn-erf-entry .
  ex:nn-cdf-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Φ(z)**: Standard-normal cumulative probability at z; a special case of F.
- **φ(t)**: Standard-normal density at t; a special case of f.
- **Z**: Standard-normal random variable.
- **z**: Concrete standardized threshold, 2 here (dimensionless).
- **t**: Dimensionless integration variable.
- **P, ≤**: Probability; at or below the threshold.
- **∫, −∞, dt**: Integrate from minus infinity up to z; dt is the increment of t.
- **=, ≈**: Equality and approximate equality.

The CDF slope equals the density where the derivative exists. All quantities use the standardized, dimensionless scale."""@en ;
    cd:mathNotation "\\Phi,\\varphi,z,Z,t,P,\\le,\\int,-\\infty,dt,=,\\approx" ;
    cd:symbol "accumulated left-tail probability" .
  ex:nn-decision dct:hasPart ex:nn-decision-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Choose an upper threshold for a one-percent per-result false-alarm rate"@en ;
    cd:hasSymbol ex:nn-decision-symbols ;
    cd:latex "\\begin{gathered}z^*=\\Phi^{-1}(0.99)\\approx2.32635\\\\x^*=\\mu+z^*\\sigma\\\\\\approx10.23263\\;\\mathrm{mg/L}\\end{gathered}" .
  ex:nn-decision-entry dct:references ex:nn-decision-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Inverse function, units and per-result calibration"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-decision-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-decision-entry .
  ex:nn-decision-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Φ, Φ⁻¹**: Standard-normal CDF and its inverse quantile function.
- **z***: Chosen standardized threshold (dimensionless), here the 0.99 quantile.
- **x***: Corresponding concentration threshold (mg/L).
- **μ**: Known expectation, 10.00 mg/L.
- **σ**: Known SD, 0.10 mg/L.
- *****: Superscript star identifying a chosen threshold.
- **+, =, ≈**: Addition, equality and approximate equality; adjacent factors multiply.

Superscript −1 denotes the inverse function. Under the model, 1% of individual results exceed the unrounded threshold; the displayed 10.233 mg/L is rounded."""@en ;
    cd:mathNotation "\\Phi,\\Phi^{-1},z^*,x^*,\\mu,\\sigma,{}^*,=,+,\\approx" ;
    cd:symbol "inverse CDF and decision threshold" .
  ex:nn-devices dct:hasPart ex:nn-devices-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "Same 10.20 mg/L result, different statistical distances"@en ;
    cd:hasSymbol ex:nn-devices-symbols ;
    cd:latex "\\begin{gathered}z_A=\\frac{10.20-10.00}{0.10}=2\\\\z_B=\\frac{10.20-10.00}{0.20}=1\\end{gathered}" .
  ex:nn-devices-entry dct:references ex:nn-devices-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Same units, different reference spreads"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-devices-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-devices-entry .
  ex:nn-devices-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **$z_A$**: Standardized distance for method A, equal to 2 (dimensionless).
- **$z_B$**: Standardized distance for method B, equal to 1 (dimensionless).
- **A, B**: Method-identifying subscripts.
- **−, /, =**: Subtract expectation, divide by that method's SD, and evaluate the distance.

Both Normal models have known expectation 10.00 mg/L and result 10.20 mg/L. Their known SDs are 0.10 mg/L for A and 0.20 mg/L for B; concentration units cancel in each ratio."""@en ;
    cd:mathNotation "z_A,z_B,A,B,=,-,/" ;
    cd:symbol "two methods with different precision" .
  ex:nn-erf-entry dct:references ex:nn-erf-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Error function and Gaussian antiderivative"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "2"^^xsd:integer .
  ex:nn-erf-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **erf(u)**: Error function at dimensionless argument u.
- **u**: Upper integration limit in the definition of erf.
- **t, dt**: Dimensionless integration variable and its infinitesimal increment.
- **∫₀ᵘ**: Integrate from zero to u.
- **e⁻ᵗ²**: Natural exponential with exponent −t².
- **π**: Circle constant.
- **√**: Positive square root.
- **2 / √π**: Normalizing factor in the definition of erf.
- **z / √2**: Scaled standardized threshold used as the erf argument.
- **½, 1, +**: Multiply the grouped expression by one half after adding one.
- **( ), [ ]**: Group the stated operations.

All quantities here are dimensionless. The error function erf provides the special-function representation of the standard-normal density's antiderivative. Integrating from minus infinity fixes the CDF normalization."""@en ;
    cd:mathNotation "\\operatorname{erf},u,t,e,{}^2,\\pi,\\sqrt{},\\frac12,1,+,0,2,\\int,dt" ;
    cd:symbol "error function" .
  ex:nn-eta dct:hasPart ex:nn-eta-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "A fixed normal model, independent of the six illustrative readings"@en ;
    cd:hasSymbol ex:nn-eta-symbols ;
    cd:latex "\\begin{gathered}X\\sim\\mathcal N(10.00,0.10^2)\\\\Z=\\frac{X-\\mu}{\\sigma}\\sim\\mathcal N(0,1),\\quad z=\\frac{x-\\mu}{\\sigma}\\\\f_X(x)=\\frac{1}{\\sigma}\\varphi(z)\\end{gathered}" .
  ex:nn-eta-entry dct:references ex:nn-eta-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Z, z, density scaling and the variance convention"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-eta-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-eta-entry .
  ex:nn-eta-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "X: random result; x: one value; mu=10.00 mg/L and sigma=0.10 mg/L: independently specified known expectation and positive SD. Normal notation uses variance as its second parameter, in (mg/L) squared. Uppercase Z is the standardized random variable; lowercase z is a concrete dimensionless value, not a third function. Standard-normal N(0,1) has mean zero and variance one. Phi lowercase is standard-normal density; f with subscript X is concentration density in L/mg. The factor one over sigma changes density units. Tilde names the law; equality defines/scales the quantities. Subtract, divide and square as shown."@en ;
    cd:mathNotation "X,x,\\mu,\\sigma,Z,z,f_X,\\varphi,\\mathcal N,\\sim,=,-,/,{}^2" ;
    cd:symbol "measurement scale and standard-normal scale" .
  ex:nn-phi dct:hasPart ex:nn-phi-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "$\\varphi$ is the standard-Normal density"@en ;
    cd:hasSymbol ex:nn-phi-symbols ;
    cd:latex "\\varphi(z)=\\frac{1}{\\sqrt{2\\pi}}e^{-z^2/2}" .
  ex:nn-phi-entry dct:references ex:nn-phi-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Phi is a function; z is its argument"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-phi-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-phi-entry .
  ex:nn-phi-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **φ(z)**: Standard-normal density per dimensionless z-unit.
- **z**: Concrete standardized value, in SD units.
- **e**: Base of the natural exponential.
- **π**: Circle constant.
- **z², −, /**: Square z, negate it and divide by two in the exponent.
- **√(2π)**: Positive square root of two times π; the density's normalizing denominator.
- **=**: Equality defining the density.

The density is symmetric around zero, where it is maximal, and has total area one. Probabilities are areas over intervals."""@en ;
    cd:mathNotation "\\varphi,z,e,\\pi,\\sqrt{},{}^2,-,/,=" ;
    cd:symbol "density and standardized argument" .
  ex:nn-tail dct:hasPart ex:nn-tail-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:formulaLabel "A two-SD upper threshold can trigger by chance"@en ;
    cd:hasSymbol ex:nn-tail-symbols ;
    cd:latex "\\begin{gathered}\\varphi(2)\\approx0.05399\\\\P(X>10.20)=1-\\Phi(2)\\\\\\approx0.02275\\end{gathered}" .
  ex:nn-tail-entry dct:references ex:nn-tail-symbols ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Upper-tail probability: 2.28%"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:nn-tail-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:nn-tail-entry .
  ex:nn-tail-symbols rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **X**: Normal random concentration (mg/L), with mean 10.00 mg/L and SD 0.10 mg/L.
- **z**: Standardized threshold, 2 at concentration 10.20 mg/L.
- **φ(2)**: Density at z = 2, per dimensionless z-unit.
- **Φ(2)**: Cumulative probability at z = 2.
- **P, >**: Probability of exceeding the stated threshold.
- **−, /, =, ≈**: Subtraction, division, equality and approximate equality.

Subtracting Φ(2) from total probability one gives the upper-tail probability, about 2.275%."""@en ;
    cd:mathNotation "X,z,\\varphi,\\Phi,P,>,=,-,/,\\approx" ;
    cd:symbol "upper-tail calculation and density trap" .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-visuals> {
  ex:nn-process-media rdf:type cd:MediaAsset ;
    dct:description "One homogeneous nitrate control passes repeatedly through injection, separation, detection and concentration reporting. The arrows locate contributions to variation along the same measurement path."@en ;
    cd:alternativeText "One homogeneous nitrate control passes repeatedly through injection, an IC separation column, detector and concentration reporting. Small variations in injection, flow, temperature and electronics contribute to variation in the reported results."@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:mediaType "image/svg+xml" ;
    cd:uri "/chemometrics/level5-normal-ic-process.svg"^^xsd:anyURI .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-pearson> {
  ex:l5-p20-definition rdf:type cd:Definition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Pearson's goodness-of-fit statistic sums squared observed-minus-expected category counts divided by their positive expected counts. For iid categorical observations with a fixed total, fixed exhaustive categories and fully specified positive category probabilities, its large-sample null reference is chi-square with category count minus one degrees of freedom. This is an approximation, unlike the exact normal-sample variance law. Sparse expected counts, fitted parameters, adaptive categories and dependent sampling require justified adjustments or alternative calibration. Rejection concerns the specified category probabilities, not identification of an alternative distribution or measurement bias."@en ;
    cd:hasSource ex:l5-source-nist-pearson .
  ex:l5-p20a-entry dct:references ex:l5-p20a-expectation ;
    dct:references ex:l5-p20a-index ;
    dct:references ex:l5-p20a-probability ;
    dct:references ex:l5-p20a-total ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols, counts and class convention"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-p20a-expectation rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **Eⱼ**: Expected particle count in category j under the fixed null model (count)."""@en ;
    cd:mathNotation "E_j" ;
    cd:symbol "expected category count" .
  ex:l5-p20a-formula dct:hasPart ex:l5-p20a-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Multiply the fixed total of 100 particles by each predeclared category probability: 0.10, 0.20, 0.40, 0.20, 0.10. Expected counts are 10, 20, 40, 20 and 10."@en ;
    cd:formulaLabel "Expected counts come from the specified model"@en ;
    cd:hasSymbol ex:l5-p20a-expectation ;
    cd:hasSymbol ex:l5-p20a-index ;
    cd:hasSymbol ex:l5-p20a-probability ;
    cd:hasSymbol ex:l5-p20a-total ;
    cd:latex "E_j=n p_j" .
  ex:l5-p20a-index rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **j**: Category index, from 1 through 5.

The diameter categories are below 5, 5 to below 10, 10 to below 20, 20 to below 40, and at least 40 micrometres. Each finite lower bound is included."""@en ;
    cd:mathNotation "j" ;
    cd:symbol "category index" .
  ex:l5-p20a-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-p20a-entry .
  ex:l5-p20a-probability rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **pⱼ**: Prespecified probability of category j (dimensionless).

The five fixed probabilities are 0.10, 0.20, 0.40, 0.20 and 0.10; their sum is one."""@en ;
    cd:mathNotation "p_j" ;
    cd:symbol "specified probability" .
  ex:l5-p20a-total rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body """- **n**: Fixed total of independently classified particles, 100.
- **=**: Equality defining an expected count.
- **npⱼ**: Multiplication of total n by category probability pⱼ."""@en ;
    cd:mathNotation "n,\\ =" ;
    cd:symbol "fixed sample size" .
  ex:l5-p20b-arithmetic rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Subtract, square, divide by the expected count, then sum. Equalities define and evaluate the statistic. Squaring removes the sign of each departure."@en ;
    cd:mathNotation "-,\\ {}^2,\\ /,\\ =" ;
    cd:symbol "difference and weighting" .
  ex:l5-p20b-counts rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Observed counts 4, 12, 44, 24, 16; null expected counts 10, 20, 40, 20, 10. Counts, not percentages or diameters; all expected values are positive."@en ;
    cd:mathNotation "O_j,\\ E_j" ;
    cd:symbol "observed and expected" .
  ex:l5-p20b-entry dct:references ex:l5-p20b-arithmetic ;
    dct:references ex:l5-p20b-counts ;
    dct:references ex:l5-p20b-index ;
    dct:references ex:l5-p20b-statistic ;
    rdf:type cd:DefinitionListEntry ;
    skos:prefLabel "Symbols and weighting"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer .
  ex:l5-p20b-formula dct:hasPart ex:l5-p20b-legend ;
    rdf:type cd:MathExpression ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Pearson Q is the sum over categories of observed minus expected count squared, divided by expected count. Contributions 3.6, 3.2, 0.4, 0.8 and 3.6 sum to 11.6."@en ;
    cd:formulaLabel "Add the five weighted squared discrepancies"@en ;
    cd:hasSource ex:l5-source-nist-pearson ;
    cd:hasSymbol ex:l5-p20b-arithmetic ;
    cd:hasSymbol ex:l5-p20b-counts ;
    cd:hasSymbol ex:l5-p20b-index ;
    cd:hasSymbol ex:l5-p20b-statistic ;
    cd:latex "Q=\\sum_{j=1}^{k}\\frac{(O_j-E_j)^2}{E_j}=11.6" .
  ex:l5-p20b-index rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "j labels each predeclared size band. k = 5 exhaustive, mutually exclusive categories. Add all five contributions, including any observed-zero class."@en ;
    cd:mathNotation "j,\\ k,\\ \\sum_{j=1}^{k}" ;
    cd:symbol "sum and classes" .
  ex:l5-p20b-legend rdf:type cd:DefinitionList ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinitionListEntry ex:l5-p20b-entry .
  ex:l5-p20b-statistic rdf:type cd:MathSymbol ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Nonnegative dimensionless discrepancy, here 11.6. A large value challenges the specified category probabilities, not a particular alternative model."@en ;
    cd:mathNotation "Q" ;
    cd:symbol "Pearson statistic" .
  ex:l5-pearson-gof rdf:type cd:Concept ;
    skos:prefLabel "Pearson chi-square goodness-of-fit test for category probabilities"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:hasDefinition ex:l5-p20-definition .
  ex:l5-source-nist-pearson dct:creator "NIST/SEMATECH" ;
    dct:identifier "l5-source-nist-pearson" ;
    dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/eda35f.htm> ;
    dct:title "NIST/SEMATECH e-Handbook: Chi-Square Goodness-of-Fit Test" ;
    rdf:type cd:Source ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:supportsResource ex:l5-p20-definition ;
    cd:supportsResource ex:l5-p20a-formula ;
    cd:supportsResource ex:l5-p20b-formula .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-experiments> {
  ex:rx-M rdf:type cd:ExperimentParameter ;
    skos:prefLabel "Simulated complete series"@en ;
    cd:adjustableParameter "true"^^xsd:boolean ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "1000.0"^^xsd:decimal ;
    cd:parameterKey "M" ;
    cd:parameterMaximum "10000.0"^^xsd:decimal ;
    cd:parameterMinimum "2.0"^^xsd:decimal ;
    cd:parameterStep "1.0"^^xsd:decimal ;
    cd:position "8"^^xsd:integer .
  ex:rx-alpha01 rdf:type cd:ExperimentParameter ;
    skos:prefLabel "Chosen upper-tail rate"@en ;
    cd:adjustableParameter "true"^^xsd:boolean ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "0.01"^^xsd:decimal ;
    cd:parameterKey "alpha" ;
    cd:parameterMaximum "0.20"^^xsd:decimal ;
    cd:parameterMinimum "0.001"^^xsd:decimal ;
    cd:parameterStep "0.001"^^xsd:decimal ;
    cd:position "5"^^xsd:integer .
  ex:rx-alpha05 rdf:type cd:ExperimentParameter ;
    skos:prefLabel "Prespecified tail / error rate"@en ;
    cd:adjustableParameter "true"^^xsd:boolean ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:numericValue "0.05"^^xsd:decimal ;
    cd:parameterKey "alpha" ;
    cd:parameterMaximum "0.20"^^xsd:decimal ;
    cd:parameterMinimum "0.01"^^xsd:decimal ;
    cd:parameterStep "0.01"^^xsd:decimal ;
    cd:position "5"^^xsd:integer .
  ex:rx-device-a rdf:type cd:ChartGroup ;
    skos:prefLabel "Device A, same CRM series"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "1"^^xsd:integer ;
    cd:usesDataset ex:rx-data-a .
  ex:rx-device-b rdf:type cd:ChartGroup ;
    skos:prefLabel "Device B, independent series"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:position "2"^^xsd:integer ;
    cd:usesDataset ex:rx-data-b .
  ex:rx-devices rdf:type cd:ChartDefinition ;
    skos:prefLabel "The retained CRM device A and an independent device B"@en ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:body "Every fictional measurement result is shown, including ties. A: mean 10.10, sample SD 0.10 mg/L. B: mean 10.00, sample SD 0.30 mg/L. The two groups are independent. The sample-variance ratio B/A is nine."@en ;
    cd:chartType cd:DotPlot ;
