@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-distribution-relations> {
  ex:al-chi-square a cd:Concept ; skos:prefLabel "Chi-square distribution"@en ; cd:hasDefinition ex:al-chi-square-definition ; cd:authoredResource true .
  ex:al-chi-square-definition a cd:Definition ; cd:body "The sum of squares of independent standard-normal quantities has a chi-square distribution, with degrees of freedom equal to the number of squared quantities. Under iid normal sampling this gives the exact law of sample size minus one times sample variance divided by population variance."@en ; cd:authoredResource true .
  ex:unit-level5-probability-models cd:hasFocusConcept ex:al-chi-square .
  ex:al-map-media dct:references ex:al-distribution-relations .
  ex:al-distribution-relations a cd:FlowDiagram ; skos:prefLabel "Constructions connecting analytical distribution families"@en ; cd:body "These transformations require the stated scaling and independence. They are not evidence that a measured sample follows any distribution."@en ; cd:hasDiagramNode ex:al-map-normal, ex:al-map-lognormal, ex:al-map-chi, ex:al-map-t, ex:al-map-f ; cd:hasDiagramEdge ex:al-map-edge1, ex:al-map-edge2, ex:al-map-edge3, ex:al-map-edge4, ex:al-map-edge5 ; cd:authoredResource true .
  ex:al-map-normal a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Normal"@en ; dct:references ex:normal-measurement-model ; cd:authoredResource true .
  ex:al-map-lognormal a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Lognormal"@en ; dct:references ex:lognormal-concentration-model ; cd:authoredResource true .
  ex:al-map-chi a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Chi-square"@en ; dct:references ex:al-chi-square, ex:l5-t16a-formula, ex:l5-t16b-formula ; cd:authoredResource true .
  ex:al-map-t a cd:DiagramNode ; cd:position 4 ; skos:prefLabel "Student-t"@en ; dct:references ex:l5-t16d-formula ; cd:authoredResource true .
  ex:al-map-f a cd:DiagramNode ; cd:position 5 ; skos:prefLabel "F"@en ; dct:references ex:l5-f17c-formula ; cd:authoredResource true .
  ex:al-map-edge1 a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:al-map-lognormal ; cd:targetNode ex:al-map-normal ; skos:prefLabel "Take the natural log of the positive quantity divided by its reference."@en ; cd:authoredResource true .
  ex:al-map-edge2 a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:al-map-normal ; cd:targetNode ex:al-map-chi ; skos:prefLabel "Square and sum independent standard-normal quantities; their number gives degrees of freedom."@en ; cd:authoredResource true .
  ex:al-map-edge3 a cd:DiagramEdge ; cd:position 3 ; cd:sourceNode ex:al-map-normal ; cd:targetNode ex:al-map-t ; skos:prefLabel "Use a standard-normal numerator independent of the chi-square denominator."@en ; cd:authoredResource true .
  ex:al-map-edge4 a cd:DiagramEdge ; cd:position 4 ; cd:sourceNode ex:al-map-chi ; cd:targetNode ex:al-map-t ; skos:prefLabel "Divide that independent normal by the square root of chi-square divided by its degrees of freedom."@en ; cd:authoredResource true .
  ex:al-map-edge5 a cd:DiagramEdge ; cd:position 5 ; cd:sourceNode ex:al-map-chi ; cd:targetNode ex:al-map-f ; skos:prefLabel "Divide two independent chi-square quantities, each first divided by its own degrees of freedom; keep numerator and denominator order."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/sources/level5-analytical-lecture> {
  ex:al-source-uniform a cd:Source ; dct:title "R stats: The Uniform Distribution" ; dct:creator "R Core Team" ; dct:identifier "al-source-uniform" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Uniform.html> ; cd:supportsResource ex:mc-inverse ; cd:authoredResource true .
  ex:al-source-mc a cd:Source ; dct:title "JCGM 101:2008, Evaluation of measurement data: Propagation of distributions using a Monte Carlo method" ; dct:creator "Joint Committee for Guides in Metrology" ; dct:identifier "JCGM-101-2008" ; dct:source <https://www.bipm.org/documents/20126/2071204/JCGM_101_2008_E.pdf> ; cd:supportsResource ex:mc-definition ; cd:authoredResource true .
  ex:mc-definition cd:hasSource ex:al-source-mc .
  ex:mc-inverse cd:hasSource ex:al-source-uniform, ex:l5-source-r-normal .
  ex:al-pdf cd:hasSource ex:l5-source-r-distributions .
  ex:al-cdf cd:hasSource ex:l5-source-r-distributions .
  ex:al-inverse cd:hasSource ex:l5-source-r-distributions .
  ex:al-log-work cd:hasSource ex:l5-source-r-lognormal .
}
