 ex:pc-n09 dct:type ex:v3-role-experiment ; dct:isPartOf ex:v3-session-I ; dct:extent "1 + 3 min, planning estimate, not measured"@en .
 ex:pc-n10 dct:type ex:v3-role-experiment ; dct:isPartOf ex:v3-session-I ; dct:extent "2 + 4 min, planning estimate, not measured"@en .
