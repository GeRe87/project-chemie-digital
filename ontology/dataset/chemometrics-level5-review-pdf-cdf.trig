@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-pdf-cdf> {
 ex:pc-questions-title a cd:Interpretation ; skos:prefLabel "Which questions can a probability distribution answer?"@en ; cd:authoredResource true .
 ex:pc-questions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:pc-range, ex:pc-below, ex:pc-inverse ; cd:authoredResource true .
 ex:pc-range a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "How often in a range?"@en ; cd:body "Choose a concentration interval. A density model gives its probability through area, not through curve height."@en ; cd:authoredResource true .
 ex:pc-below a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "How much is below a limit?"@en ; cd:body "A cumulative distribution adds probability up to a threshold. Observed cumulative fractions estimate it; the population model is not the sample."@en ; cd:authoredResource true .
 ex:pc-inverse a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Which limit gives a chosen probability?"@en ; cd:body "Reverse the cumulative question to find a quantile. PDF, CDF and quantiles are tools; Normal, Lognormal, chi-square, Student and F are model families."@en ; cd:authoredResource true .
 ex:pc-density-title a cd:Interpretation ; skos:prefLabel "From a histogram to a probability density"@en ; cd:authoredResource true .
 ex:pc-linked-title a cd:Interpretation ; skos:prefLabel "PDF and CDF: two views of the same distribution"@en ; cd:authoredResource true .
 ex:pc-process-info a cd:Interpretation ; cd:body "Repeat measurements of one homogeneous nitrate sample. Injection, flow, temperature and electronics can each perturb a result. A finite measurement series does not establish a population law. Next explore an explicitly assumed model, then distinguish its PDF from the histogram."@en ; cd:authoredResource true .
 ex:pc-growth-info a cd:Interpretation ; cd:body "Simulation, not laboratory measurements: hold model expectation 10.00 mg/L and SD 0.10 mg/L fixed. Grow the sample from 20 to 1,000. This generator assumes normally distributed measurement results; it does not prove normality of a real method. Next overlay its theoretical density and ask what density area means."@en ; cd:authoredResource true .
 ex:pc-density a cd:ChartDefinition ; skos:prefLabel "Finite histogram versus an assumed population density"@en ; cd:body "Nitrate illustration: 1,000 simulated results under a stated model, not laboratory measurements. The smooth curve is a model PDF. Narrow the selected interval and compare area, not height. The bounded flat alternative shows that the tools are not specific to a bell curve."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "distribution" ; cd:hasExperimentParameter ex:pc-location, ex:pc-scale, ex:pc-threshold0, ex:pc-width, ex:pc-probability-fixed, ex:p1-Mreference, ex:p1-seed-reference, ex:pc-view0, ex:pc-family ; cd:xAxisLabel "Nitrate result (mg/L)"@en ; cd:yAxisLabel "Empirical and model density"@en ; cd:authoredResource true .
 ex:pc-linked a cd:ChartDefinition ; skos:prefLabel "One shared threshold links area and accumulation"@en ; cd:body "- Move one threshold in both plots.\n- PDF: shaded area. CDF: the same probability as a height.\n- Reverse the question: choose p, then find its concentration limit."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "distribution" ; cd:hasExperimentParameter ex:pc-location, ex:pc-scale, ex:pc-threshold, ex:pc-width-fixed, ex:pc-probability, ex:p1-Mreference, ex:p1-seed-reference, ex:pc-view1, ex:pc-family ; cd:xAxisLabel "Shared threshold (mg/L)"@en ; cd:yAxisLabel "Probability density and cumulative probability"@en ; cd:authoredResource true .
 ex:pc-location a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "location" ; skos:prefLabel "Assumed model expectation (mg/L)"@en ; cd:numericValue 10.0 ; cd:parameterMinimum 10.0 ; cd:parameterMaximum 10.0 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:pc-scale a cd:ExperimentParameter ; cd:position 2 ; cd:parameterKey "scale" ; skos:prefLabel "Assumed model SD (mg/L)"@en ; cd:numericValue 0.10 ; cd:parameterMinimum 0.10 ; cd:parameterMaximum 0.10 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:pc-threshold0 a cd:ExperimentParameter ; cd:position 3 ; cd:parameterKey "threshold" ; skos:prefLabel "Interval center (mg/L)"@en ; cd:numericValue 10.0 ; cd:parameterMinimum 9.80 ; cd:parameterMaximum 10.20 ; cd:parameterStep 0.01 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:pc-threshold a cd:ExperimentParameter ; cd:position 3 ; cd:parameterKey "threshold" ; skos:prefLabel "Shared concentration threshold (mg/L)"@en ; cd:numericValue 10.10 ; cd:parameterMinimum 9.60 ; cd:parameterMaximum 10.40 ; cd:parameterStep 0.01 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:pc-width a cd:ExperimentParameter ; cd:position 4 ; cd:parameterKey "width" ; skos:prefLabel "Interval half-width (mg/L)"@en ; cd:numericValue 0.10 ; cd:parameterMinimum 0.01 ; cd:parameterMaximum 0.20 ; cd:parameterStep 0.01 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:pc-width-fixed a cd:ExperimentParameter ; cd:position 4 ; cd:parameterKey "width" ; skos:prefLabel "Unused interval half-width in cumulative view (mg/L)"@en ; cd:numericValue 0.10 ; cd:parameterMinimum 0.10 ; cd:parameterMaximum 0.10 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:pc-probability a cd:ExperimentParameter ; cd:position 5 ; cd:parameterKey "probability" ; skos:prefLabel "Chosen cumulative probability p"@en ; cd:numericValue 0.95 ; cd:parameterMinimum 0.01 ; cd:parameterMaximum 0.99 ; cd:parameterStep 0.01 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:pc-probability-fixed a cd:ExperimentParameter ; cd:position 5 ; cd:parameterKey "probability" ; skos:prefLabel "Quantile question reserved for the next scene"@en ; cd:numericValue 0.95 ; cd:parameterMinimum 0.95 ; cd:parameterMaximum 0.95 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:pc-family a cd:ExperimentParameter ; cd:position 6 ; cd:parameterKey "family" ; skos:prefLabel "Model: 0 smooth bell, 1 bounded flat"@en ; cd:numericValue 0.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 1.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:pc-view0 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Histogram and interval area"@en ; cd:numericValue 0.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 0.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:pc-view1 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Question: 1 probability from threshold, 2 threshold from p"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 2.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .

 ex:pc-area a cd:MathExpression ; cd:formulaLabel "Probability is model density integrated over an interval"@en ; cd:latex "P(a\\le X\\le b)=\\int_a^b f(x)\\,dx=F(b)-F(a)" ; cd:hasSymbol ex:pc-area-symbol ; dct:hasPart ex:pc-area-legend ; cd:authoredResource true .
 ex:pc-area-symbol a cd:MathSymbol ; cd:symbol "interval probability and density area" ; cd:mathNotation "P,a,b,X,\\le,\\int,f(x),dx,F,=,-" ; cd:body "X: random individual nitrate result, not a mean; x: concentration coordinate; a and b: ordered bounds, all in mg/L. P: probability; less-than-or-equal includes endpoints, which have zero point probability for this density model. f(x): model density in L/mg, not a histogram height. The integral adds density times infinitesimal concentration increments dx from a to b. Area is unitless. F: cumulative probability; subtract its lower value from its upper value. Equals links the same event. Density is nonnegative with total area one."@en ; cd:authoredResource true .
 ex:pc-area-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:pc-area-entry ; cd:authoredResource true .
 ex:pc-area-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Result, interval, integral and units"@en ; dct:references ex:pc-area-symbol ; cd:authoredResource true .
 ex:pc-functions a cd:MathExpression ; cd:formulaLabel "Accumulate · read the local slope · reverse the question"@en ; cd:latex "\\begin{gathered}F(x)=P(X\\le x)=\\int_{-\\infty}^{x}f(t)\\,dt\\\\f(x)=F'(x)\\quad\\text{where the derivative exists}\\\\x_p=F^{-1}(p)\\end{gathered}" ; cd:hasSymbol ex:pc-functions-symbol, ex:pc-quantile-symbol ; dct:hasPart ex:pc-functions-legend ; cd:authoredResource true .
 ex:pc-functions-symbol a cd:MathSymbol ; cd:symbol "general PDF and CDF" ; cd:mathNotation "F(x),P,X,\\le,\\int,-\\infty,f(t),dt,F',=" ; cd:body "X: random concentration; x: threshold, both mg/L. F(x)=P(X at most x): unitless cumulative probability. For an absolutely continuous model, integrate density f(t) in L/mg from negative infinity to x. t is a dummy concentration coordinate; dt is its infinitesimal increment. Minus infinity means no finite lower bound, not negative probability. The prime differentiates with respect to x; the slope equals f where this derivative relation holds, not automatically at density discontinuities. Equals links the expressions. Every distribution has a CDF; not every distribution has a PDF."@en ; cd:authoredResource true .
 ex:pc-functions-symbol cd:presentationDefinition "- X: random concentration; x: threshold; t: integration coordinate (mg/L).\n- f: density (L/mg); F and P: unitless probabilities at or below x.\n- Integral: accumulate from unbounded lower limit to x; dt: concentration increment.\n- For an absolutely continuous model, prime means derivative with respect to x; equals links the expressions. The density relation holds where defined, not automatically at discontinuities."@en .
 ex:pc-quantile-symbol a cd:MathSymbol ; cd:symbol "quantile as the reversed cumulative question" ; cd:mathNotation "x_p,F^{-1},p" ; cd:body "p is a chosen probability strictly between zero and one; subscript p labels concentration quantile x p in mg/L. F inverse is not reciprocal F. The generalized inverse is the greatest lower bound of thresholds whose cumulative probability is at least p. For continuous strictly increasing F it agrees with the usual inverse. This definition remains meaningful when F is not strictly increasing. p=0.95 means 95% at or below the limit in the continuous examples, not above it."@en ; cd:authoredResource true .
 ex:pc-quantile-symbol cd:presentationDefinition "- p: chosen probability strictly between zero and one.\n- Subscript p labels concentration quantile x p (mg/L).\n- F inverse: quantile function, not reciprocal F; usual inverse for continuous strictly increasing F.\n- In these continuous models, p=0.95 means 95% at or below the limit."@en .
 ex:pc-functions-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:pc-functions-entry, ex:pc-quantile-entry ; cd:authoredResource true .
 ex:pc-functions-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Accumulation and local slope"@en ; dct:references ex:pc-functions-symbol ; cd:authoredResource true .
 ex:pc-quantile-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Cumulative probability to concentration"@en ; dct:references ex:pc-quantile-symbol ; cd:authoredResource true .
 ex:pc-phi-chart a cd:ChartDefinition ; skos:prefLabel "The standard-normal density is one particular PDF"@en ; cd:body "Generic f becomes lowercase phi for the standard-normal family. Many small independent additive influences may motivate a bell-shaped approximation under suitable conditions. This is not a universal measurement law or proof from a histogram."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:usesDataset ex:l5-c14-standard-normal ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.42 ; cd:xAxisLabel "Standardized coordinate z"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Standard-normal PDF phi"@en ; cd:yAxisUnit "per z-unit" ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-review-pdf-cdf> {
 ex:pc-n03 a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; dct:references ex:cf-readings ; cd:hasSceneItem ex:pc-n03-h, ex:pc-n03-c ; cd:narration "Start with three analytical questions: how often in an interval, how much below a limit, and which limit gives a chosen probability? Introduce nitrate repeatability through the instrument process, then distinguish a finite simulated histogram from a population PDF and CDF. The named distribution families come later. The twenty-reading dotplot, empirical threshold warm-up and adjustable-bin scene are retained as optional extended material, not required here."@en ; cd:authoredResource true .
 ex:pc-n03-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:pc-questions-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n03-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-questions ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n07 a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-functions ; dct:references ex:rv-n07 ; cd:hasSceneItem ex:rv-n07-h, ex:pc-n07-c, ex:rv-n07-v ; cd:narration "N07. Keep the nitrate repeatability question, without introducing another six-reading dataset. Point to small disturbances along the instrument process. They can motivate an additive model, but do not establish independence or normality. The next histogram is a stated simulation model, not newly collected evidence."@en ; cd:authoredResource true .
 ex:pc-n07-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-process-info ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n08 a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; dct:references ex:rv-n08 ; cd:hasSceneItem ex:rv-n08-h, ex:pc-n08-c, ex:rv-n08-v, ex:rv-n08-r ; cd:narration "N08. Grow the same seeded simulation prefix from twenty to fifty, one hundred and one thousand results under fixed model parameters. Normality is an assumption of this generator, not a conclusion from the original twenty measurements. More simulations show the assumed shape more clearly, not better physical precision. Next distinguish an empirical histogram from the model's theoretical density; no combinatorial detour is needed."@en ; cd:authoredResource true .
 ex:pc-n08-c a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-growth-info ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n09 a cd:SceneDefinition ; cd:focusConcept ex:probability-density-function ; dct:subject ex:l5-topic-functions ; dct:references ex:rv-n06, ex:rv-n08 ; cd:hasSceneItem ex:pc-n09-h, ex:pc-n09-v, ex:pc-n09-f ; cd:narration "These thousand results are explicitly simulated under an assumed model, not laboratory measurements. Overlay the population density on its finite histogram. Narrow the chosen interval without confusing density height with probability. A histogram estimates a density; it does not become an exact PDF just by drawing thinner bins. The same tools also apply to the bounded flat alternative. Neither the optional twenty-reading warm-up nor a binomial construction is required."@en ; cd:authoredResource true .
 ex:pc-n09-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:pc-density-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n09-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-density ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n09-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:pc-area ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n10 a cd:SceneDefinition ; cd:focusConcept ex:cumulative-distribution-function ; dct:subject ex:l5-topic-functions ; dct:references ex:pc-n09, ex:theoretical-quantile ; cd:hasSceneItem ex:pc-n10-h, ex:pc-n10-v, ex:pc-n10-f ; cd:narration "N10. Move one shared threshold and watch left density area become the CDF ordinate. Ask where the CDF is steepest, then connect its local slope to the PDF wherever the derivative exists. Reverse the question: choose cumulative probability 0.95 and read the quantile. The generalized inverse is not a reciprocal. Show the bounded flat model briefly to establish that these tools are not specific to the Normal family. Only next identify phi and Phi as standard-normal special cases."@en ; cd:authoredResource true .
 ex:pc-n10-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:pc-linked-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n10-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-linked ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n10-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:pc-functions ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:pc-n11 a cd:SceneDefinition ; cd:focusConcept ex:normal-measurement-model ; dct:subject ex:l5-topic-normal ; dct:references ex:nn-phi-scene, ex:pc-n10 ; cd:hasSceneItem ex:nn-phi-h, ex:pc-n11-v, ex:nn-phi-f ; cd:narration "N11. The class already knows general f and F. Now identify the standard-normal PDF as one particular f, written lowercase phi. Many sufficiently small additive influences can motivate an approximate normal law when appropriate central-limit conditions hold; dominant, dependent or heavy-tailed effects require care. A combinatorial binomial derivation is optional extended material, not a prerequisite. Phi lowercase is density, not a point probability. The next scenes define the standardized coordinate and specialize F to uppercase Phi."@en ; cd:authoredResource true .
 ex:pc-n11-v a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:pc-phi-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
}
