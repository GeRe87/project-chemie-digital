@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-v3> {
 ex:v3-four-chart a cd:ChartDefinition ; skos:prefLabel "One extreme route versus six cancellation routes"@en ; cd:body "Four signs in acquisition order: ++++ gives one extreme route. Zero has six routes: ++--, +-+-, +--+, -++-, -+-+, --++. Each sign adds or subtracts the same amount. The central mass is six of sixteen, not one combination."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:nn-four-data ; cd:hasChartAnnotation ex:v3-four-center ; cd:xAxisLabel "Total error (multiples of a)"@en ; cd:yAxisLabel "Probability mass"@en ; cd:authoredResource true .
 ex:v3-four-center a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:nn-four2 ; cd:body "Six cancellation routes"@en ; cd:authoredResource true .
 ex:v3-eta a cd:MathExpression ; cd:formulaLabel "Random standardized variable Z, observed standardized value z"@en ; cd:latex "\\begin{gathered}X\\sim\\mathcal N(\\mu,\\sigma^2),\\quad Z=\\frac{X-\\mu}{\\sigma}\\sim\\mathcal N(0,1)\\\\z=\\frac{x-\\mu}{\\sigma}=\\frac{10.20-10.00}{0.10}=2\\end{gathered}" ; cd:hasSymbol ex:v3-eta-symbol ; dct:hasPart ex:v3-eta-legend ; cd:authoredResource true .
 ex:v3-eta-symbol a cd:MathSymbol ; cd:symbol "standardized result" ; cd:mathNotation "X,Z,z,x,\\mu,\\sigma,\\mathcal N,\\sim,{}^2,=,-,/" ; cd:body "X is a random nitrate result; lowercase x is one concrete value, here 10.20 mg/L. The model expectation mu is 10.00 mg/L and its known positive SD sigma is 0.10 mg/L. Normal N uses mean and variance, so sigma squared has (mg/L) squared units. Uppercase Z is the standardized random variable with mean zero and variance one. Lowercase z is the concrete dimensionless z-score, here two. Subtract the expectation, then divide by SD; mg/L units cancel. Tilde names the distribution; equals defines or evaluates, minus subtracts, the fraction divides and the exponent squares. Standardizing a nonnormal variable does not make it normal."@en ; cd:authoredResource true .
 ex:v3-eta-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-eta-entry ; cd:authoredResource true .
 ex:v3-eta-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Result, expectation and known SD"@en ; dct:references ex:v3-eta-symbol ; cd:authoredResource true .
 ex:v3-normal-coordinate a cd:ChartDefinition ; skos:prefLabel "First locate the result in known SD units"@en ; cd:body "Where is 10.20 mg/L relative to expectation 10.00 and known SD 0.10 mg/L? It is two SD above the expectation. How often should that happen? Keep this probability question open."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:rx-inverse, ex:v3-view5 ; cd:xAxisLabel "Concentration (mg/L)"@en ; cd:yAxisLabel "Normal density"@en ; cd:authoredResource true .
 ex:v3-observation-stress a cd:ChartDefinition ; skos:prefLabel "Inspect acquisition order before choosing a probability model"@en ; cd:body "Can one stable normal model describe these results? Compare stable acquisition, one added outlier and drift on a common concentration window. No test decision is needed here."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "stress" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-sigma, ex:rx-seed, ex:rx-mode, ex:rx-mu, ex:rx-outlier, ex:rx-drift, ex:p1-view1 ; cd:xAxisLabel "Acquisition order"@en ; cd:yAxisLabel "Nitrate result (mg/L)"@en ; cd:authoredResource true .
 ex:v3-calibration-comparison a cd:ChartDefinition ; skos:prefLabel "Does adding curvature remove the residual pattern?"@en ; cd:body "Same twelve observations and residual scale. Compare linear and quadratic residuals before testing the added coefficient. A lower residual sum of squares is necessary, not sufficient justification."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "calibration" ; cd:hasExperimentParameter ex:rx-quadratic, ex:p1-view2 ; cd:usesDataset ex:rx-cal-data ; cd:xAxisLabel "Calibration concentration (mg/L)"@en ; cd:yAxisLabel "Residual response"@en ; cd:authoredResource true .
 ex:v3-view5 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Coordinate-only teaching view"@en ; cd:numericValue 5.0 ; cd:parameterMinimum 5.0 ; cd:parameterMaximum 5.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-signed-grown cd:hasExperimentParameter ex:v3-comp4 .
 ex:v3-comp4 a cd:ExperimentParameter ; cd:position 19 ; cd:parameterKey "comparisonN" ; skos:prefLabel "Comparison number of signed contributions"@en ; cd:numericValue 200.0 ; cd:parameterMinimum 200.0 ; cd:parameterMaximum 200.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .

 ex:v3-t-construction a cd:MathExpression ; cd:formulaLabel "An independent estimated denominator removes the unknown SD"@en ; cd:latex "\\begin{gathered}Z=\\frac{(\\bar X-\\mu)\\sqrt n}{\\sigma}\\sim\\mathcal N(0,1)\\\\Q/\\nu=S^2/\\sigma^2,\\quad Q\\sim\\chi^2_\\nu,\\quad\\nu=n-1\\\\T=\\frac{Z}{\\sqrt{Q/\\nu}}=\\frac{(\\bar X-\\mu)\\sqrt n/\\sigma}{S/\\sigma}=\\frac{\\bar X-\\mu}{S/\\sqrt n}\\sim t_\\nu\\end{gathered}" ; cd:hasSymbol ex:tf-construction-symbol, ex:v3-t-operation ; dct:hasPart ex:v3-t-legend ; cd:authoredResource true .
 ex:v3-t-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-t-base-entry, ex:v3-t-operation-entry ; cd:authoredResource true .
 ex:v3-t-base-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent normal and chi-square pieces"@en ; dct:references ex:tf-construction-symbol ; cd:authoredResource true .
 ex:v3-t-operation-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Cancel the same positive scale"@en ; dct:references ex:v3-t-operation ; cd:authoredResource true .
 ex:v3-t-operation a cd:MathSymbol ; cd:symbol "normal reference and scale cancellation" ; cd:mathNotation "\\mathcal N,0,1,\\sqrt{},/" ; cd:body "Normal N(0,1) has dimensionless mean zero and variance one. Positive sample and population SDs make the square root of S squared over sigma squared equal S over sigma. Divide numerator and denominator by the same positive scale: sigma cancels. Independence of Z and Q follows from iid normal sampling, not from cancellation alone."@en ; cd:authoredResource true .

 ex:v3-calculation a cd:MathExpression ; cd:formulaLabel "From the same residual sums of squares to the F statistic"@en ; cd:latex "\\begin{gathered}F=\\frac{(\\mathrm{RSS}_s-\\mathrm{RSS}_c)/(p_c-p_s)}{\\mathrm{RSS}_c/(n-p_c)}\\sim F_{p_c-p_s,n-p_c}\\quad(H_0)\\\\f=\\frac{(0.581971-0.064939)/(3-2)}{0.064939/(12-3)}\\approx71.66\\end{gathered}" ; cd:hasSymbol ex:tf-cal-law-symbol, ex:v3-calculation-symbol ; dct:hasPart ex:v3-calculation-legend ; cd:authoredResource true .
 ex:v3-calculation-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-calculation-base-entry, ex:v3-calculation-entry ; cd:authoredResource true .
 ex:v3-calculation-base-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Same observations, nested full-rank OLS models"@en ; dct:references ex:tf-cal-law-symbol ; cd:authoredResource true .
 ex:v3-calculation-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "One extra coefficient, one numerator degree of freedom"@en ; dct:references ex:v3-calculation-symbol ; cd:authoredResource true .
 ex:v3-calculation-symbol a cd:MathSymbol ; cd:symbol "observed nested-model calculation" ; cd:mathNotation "f,\\approx" ; cd:body "Lowercase f is the observed unitless ratio; approximately equals marks rounded RSS inputs and a rounded result. Simple and complex RSS are 0.581971 and 0.064939 in squared response units. One added quadratic coefficient gives 3 minus 2 equals one numerator df; twelve observations minus three fitted coefficients leave nine denominator df. Under the null the added-term and complex-residual quadratic forms are independent; the two RSS values themselves are not."@en ; cd:authoredResource true .

 ex:v3-pearson-sum a cd:MathExpression ; cd:formulaLabel "Square each count discrepancy, weight it, then add"@en ; cd:latex "\\begin{gathered}q=\\sum_{j=1}^{5}\\frac{(O_j-E_j)^2}{E_j}\\\\\\frac{(4-10)^2}{10}=3.6\\\\q=3.6+3.2+0.4+0.8+3.6=11.6\\end{gathered}" ; cd:hasSymbol ex:v3-pearson-symbol ; dct:hasPart ex:v3-pearson-legend ; cd:authoredResource true .
 ex:v3-pearson-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-pearson-entry ; cd:authoredResource true .
 ex:v3-pearson-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Five fixed categories, four count directions"@en ; dct:references ex:v3-pearson-symbol ; cd:authoredResource true .
 ex:v3-pearson-symbol a cd:MathSymbol ; cd:symbol "Pearson weighted count discrepancies" ; cd:mathNotation "q,\\sum,j,O_j,E_j,=,-,+,/,{}^2" ; cd:body "q is the observed unitless Pearson statistic, whose approximate null reference is chi-square with four df. Index j runs over the five fixed diameter categories; O and E are observed and expected counts, not concentrations. In the first category O is 4 and E is 10. Subtract, square the discrepancy, divide by the positive expected count and sum all five contributions. Equals gives the calculation; plus adds contributions. The fixed total 100 removes one independent count direction; no category probabilities are fitted. Independent classifications, exhaustive prespecified categories and adequate expected counts are needed for this approximation."@en ; cd:authoredResource true .

 ex:v3-residual-question a cd:MathExpression ; cd:formulaLabel "First find the missing sixth residual"@en ; cd:latex "\\begin{gathered}r_i=x_i-\\bar x,\\quad\\sum_{i=1}^{6}r_i=0\\\\(r_1,r_2,r_3,r_4,r_5)=(-0.10,+0.10,-0.20,+0.20,-0.10)\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:ix-residual-symbols, ex:v3-zero-sum-symbol ; dct:hasPart ex:v3-residual-legend ; cd:authoredResource true .
 ex:v3-residual-answer a cd:MathExpression ; cd:formulaLabel "One constraint leaves five independent directions"@en ; cd:latex "r_6=-(r_1+r_2+r_3+r_4+r_5)=+0.10\\;\\mathrm{mg/L}" ; cd:hasSymbol ex:ix-residual-symbols, ex:v3-zero-sum-symbol ; dct:hasPart ex:v3-residual-legend ; cd:authoredResource true .
 ex:v3-residual-derivation a cd:MathematicalDerivation ; skos:prefLabel "Discover the residual constraint"@en ; cd:inputFormula ex:v3-residual-question ; cd:resultFormula ex:v3-residual-answer ; cd:hasDerivationStep ex:v3-residual-step ; cd:authoredResource true .
 ex:v3-residual-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Add the first five, then negate their sum"@en ; cd:fromFormula ex:v3-residual-question ; cd:toFormula ex:v3-residual-answer ; cd:appliesRule ex:v3-zero-sum-rule ; cd:hasExplanation ex:v3-residual-explanation ; cd:transformationKind cd:EquivalentTransformation ; cd:authoredResource true .
 ex:v3-zero-sum-rule a cd:MathematicalRule ; skos:prefLabel "Isolate one term of a zero sum"@en ; cd:body "Move the sum of all other terms to the opposite side. This is an algebraic constraint, not an independence assumption."@en ; cd:ruleFormula ex:v3-zero-sum-formula ; cd:authoredResource true .
 ex:v3-zero-sum-formula a cd:MathExpression ; cd:latex "a+b=0\\quad\\Longrightarrow\\quad b=-a" ; cd:hasSymbol ex:v3-zero-sum-symbol ; dct:hasPart ex:v3-zero-sum-legend ; cd:authoredResource true .
 ex:v3-zero-sum-symbol a cd:MathSymbol ; cd:symbol "zero-sum rearrangement" ; cd:mathNotation "a,b,0,+,=,-,\\Longrightarrow" ; cd:body "a is the sum of the first five residuals and b the sixth, both in mg/L. Zero is their total. Add, negate and equate as shown; the arrow means implies. No random independence is asserted."@en ; cd:authoredResource true .
 ex:v3-zero-sum-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-zero-sum-entry ; cd:authoredResource true .
 ex:v3-zero-sum-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Rearrange the sum"@en ; dct:references ex:v3-zero-sum-symbol ; cd:authoredResource true .
 ex:v3-residual-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:v3-residual-base-entry, ex:v3-residual-rule-entry ; cd:authoredResource true .
 ex:v3-residual-base-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Residuals, index and units"@en ; dct:references ex:ix-residual-symbols ; cd:authoredResource true .
 ex:v3-residual-rule-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Zero-sum operation"@en ; dct:references ex:v3-zero-sum-symbol ; cd:authoredResource true .
 ex:v3-residual-explanation a cd:Interpretation ; cd:body "The first five residuals sum to minus 0.10 mg/L. The sixth must be plus 0.10 mg/L to preserve the zero-sum constraint. Changing any of the first five forces compensation. This leaves five independent residual directions, not five mutually independent raw residuals."@en ; cd:applicationFormula ex:v3-residual-answer ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-review-v3> {
 ex:v3-n12-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:v3-eta ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:v3-residual-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:v3-residual-derivation ; cd:firstDerivationStep ex:v3-residual-step ; cd:lastDerivationStep ex:v3-residual-step ; cd:usesLegend ex:v3-residual-legend ; cd:authoredResource true .
 ex:v3-n37 a cd:SceneDefinition ; cd:focusConcept ex:rev-df ; dct:subject ex:l5-topic-chi ; dct:references ex:ix-residual-scene ; cd:hasSceneItem ex:ix-residual-h, ex:v3-n37-d ; cd:narration "Ask for the sixth residual before advancing the derivation. The first five sum to minus 0.10 mg/L, so the sixth is plus 0.10. The PDF retains the question and answer together. Fitting the mean constrains all six residuals: there are five independent residual directions, not five independent raw residuals."@en ; cd:authoredResource true .
 ex:v3-n37-d a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:v3-residual-section ; cd:communicativeRole cd:DerivationRole ; cd:selectionPath "cd:partOfDerivation" ; cd:language "en" ; cd:authoredResource true .
 ex:v3-n45 a cd:SceneDefinition ; cd:focusConcept ex:l5-student-t ; dct:subject ex:l5-topic-t ; dct:references ex:tf-construction-scene ; cd:hasSceneItem ex:tf-construction-h, ex:v3-n45-f ; cd:narration "Read three compact stages: standardized mean Z; normalized variance Q over nu; their quotient T. In the last line the same positive sigma divides numerator and denominator, so it cancels. Iid normal sampling supplies the required independence. This constructs a distribution around the true mean; cancellation does not make the estimated SD a known population SD."@en ; cd:authoredResource true .
 ex:v3-n45-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:v3-t-construction ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:v3-n57 a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; dct:subject ex:l5-topic-f ; dct:references ex:tf-cal-law-scene ; cd:hasSceneItem ex:tf-cal-law-h, ex:v3-n57-f ; cd:narration "Connect the residual comparison to the actual test. Improvement 0.581971 minus 0.064939 pays for one added coefficient. Remaining RSS divided by nine estimates error variance. Their ratio is about 71.66, with ordered df one and nine and upper-tail p about 0.00001406. The independent pieces are added-term and complex-residual sums of squares, not the two nested RSS values."@en ; cd:authoredResource true .
 ex:v3-n57-f a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:v3-calculation ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
 ex:v3-n63-f a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:v3-pearson-sum ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
}
