<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-story-bridge> {
  ex:ic-question-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-question1, ex:ic-question2, ex:ic-question3 ; cd:authoredResource true .
  ex:ic-question1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A description is not yet a decision"@en ; cd:body "- The sample SD describes these six readings.\n\n- Being above 0.10 mg/L does not by itself prove that true precision has worsened."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-question2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "An unchanged method can give a larger estimate"@en ; cd:body "- Six new readings give a different sample SD.\n\n- Even when true SD stays 0.10 mg/L, estimated spread sometimes lies above it."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-question3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "The question our calculation must answer"@en ; cd:body "- Under unchanged precision, how often would six readings give at least this much spread?\n\n- We need a reference for chance variation before making a test decision."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-scale-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-scale1, ex:ic-scale2, ex:ic-scale3 ; cd:authoredResource true .
  ex:ic-scale1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Keep the original question"@en ; cd:body "- Our variance estimate is 0.024 (mg/L)².\n\n- How rare is at least this much spread if true SD is still 0.10 mg/L?"@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-scale2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "A known reference on a common scale"@en ; cd:body "- Multiply the sample variance by five residual df and divide by reference variance.\n\n- Under independent normal errors at the reference SD, this squared-deviation sum has the chi-square-five law."@en ; cd:visualMotif "multiple-inputs" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-scale3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Scaling does not create evidence"@en ; cd:body "- Comparing variance 0.024 or its scaled value 12 gives the same upper-tail probability.\n\n- Chi-square supplies the calibrated reference, not an extra measurement or an arbitrary rejection rule."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-variance-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-variance-context1 ; cd:authoredResource true .
  ex:ic-variance-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Why the observed variance alone cannot settle the question"@en ; cd:body "True SD stays 0.10 mg/L in every simulated series, but the variance estimates differ. Today's 0.024 (mg/L)² must be compared with this chance variation, not merely with the reference variance 0.010 (mg/L)²."@en ; cd:authoredResource true .
  ex:ic-variance-chart a cd:ChartDefinition ; skos:prefLabel "Unchanged true precision: 10,000 different sample variances"@en ; cd:body "Six new normal readings per series, true SD always 0.10 mg/L. Bars show sample variances, not concentrations or Q. The same simulation will later be expressed on the chi-square scale. Teaching simulation, not validation measurements."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:ic-variance-counts ; cd:binEdges ex:ic-ve0 ; cd:xAxisLabel "Estimated sample variance"@en ; cd:xAxisUnit "(mg/L)²" ; cd:yAxisLabel "Simulated density"@en ; cd:yAxisUnit "per (mg/L)²" ; cd:authoredResource true .
  ex:ic-variance-counts a cd:Dataset ; skos:prefLabel "The same simulated series, shown on the unscaled variance axis"@en ; cd:unit "(mg/L)²" ; cd:binCounts ex:ic-count0 ; cd:derivedFromResource ex:ic-simulation-code, ex:ic-case ; cd:authoredResource true .
  ex:ic-ve0 rdf:first 0.000 ; rdf:rest ex:ic-ve1 .
  ex:ic-ve1 rdf:first 0.002 ; rdf:rest ex:ic-ve2 .
  ex:ic-ve2 rdf:first 0.004 ; rdf:rest ex:ic-ve3 .
  ex:ic-ve3 rdf:first 0.006 ; rdf:rest ex:ic-ve4 .
  ex:ic-ve4 rdf:first 0.008 ; rdf:rest ex:ic-ve5 .
  ex:ic-ve5 rdf:first 0.010 ; rdf:rest ex:ic-ve6 .
  ex:ic-ve6 rdf:first 0.012 ; rdf:rest ex:ic-ve7 .
  ex:ic-ve7 rdf:first 0.014 ; rdf:rest ex:ic-ve8 .
  ex:ic-ve8 rdf:first 0.016 ; rdf:rest ex:ic-ve9 .
  ex:ic-ve9 rdf:first 0.018 ; rdf:rest ex:ic-ve10 .
  ex:ic-ve10 rdf:first 0.020 ; rdf:rest ex:ic-ve11 .
  ex:ic-ve11 rdf:first 0.022 ; rdf:rest ex:ic-ve12 .
  ex:ic-ve12 rdf:first 0.024 ; rdf:rest ex:ic-ve13 .
  ex:ic-ve13 rdf:first 0.026 ; rdf:rest ex:ic-ve14 .
  ex:ic-ve14 rdf:first 0.028 ; rdf:rest ex:ic-ve15 .
  ex:ic-ve15 rdf:first 0.030 ; rdf:rest ex:ic-ve16 .
  ex:ic-ve16 rdf:first 0.032 ; rdf:rest ex:ic-ve17 .
  ex:ic-ve17 rdf:first 0.034 ; rdf:rest ex:ic-ve18 .
  ex:ic-ve18 rdf:first 0.036 ; rdf:rest ex:ic-ve19 .
  ex:ic-ve19 rdf:first 0.038 ; rdf:rest ex:ic-ve20 .
  ex:ic-ve20 rdf:first 0.040 ; rdf:rest ex:ic-ve21 .
  ex:ic-ve21 rdf:first 0.042 ; rdf:rest ex:ic-ve22 .
  ex:ic-ve22 rdf:first 0.044 ; rdf:rest ex:ic-ve23 .
  ex:ic-ve23 rdf:first 0.046 ; rdf:rest ex:ic-ve24 .
