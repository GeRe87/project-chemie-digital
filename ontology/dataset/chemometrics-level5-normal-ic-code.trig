@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-code> {
  ex:nn-readings-code a cd:CodeExample ; skos:prefLabel "More individual measurements, then deliberately change the error model"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:normal-measurement-model ; cd:code """# Fictional normal generator, not fitted control or validation data.
# Start with M = 20, 50, 100, 1000 and mode = 'stable'.
M <- 20; mode <- 'stable'
mu <- 10.00; sigma <- 0.10; state <- 20261102
stopifnot(M %in% c(20,50,100,1000),
          mode %in% c('stable','drift','interference','censored'))
x <- numeric(M)
for (i in seq_len(M)) {
  state <- (16807 * state) %% 2147483647
  x[i] <- mu + sigma * qnorm(state/2147483647)
}
if (mode == 'drift') x <- x + seq(0,0.30,length.out=M)
if (mode == 'interference') {
  for (i in seq_len(M)) {
    state <- (16807 * state) %% 2147483647
    if (state/2147483647 < 0.02) x[i] <- x[i] + 0.50
  }
}
# Artificial reporting threshold for the demonstration, NOT a nitrate LOD.
report_limit <- 9.95
if (mode == 'censored') x <- pmax(report_limit,x)
edges <- seq(min(9.60,floor(min(x)/0.05)*0.05),
             max(10.40,ceiling(max(x)/0.05)*0.05),by=0.05)
h <- hist(x,breaks=edges,right=FALSE,plot=FALSE)
cat('M:',M,'mode:',mode,'mean:',mean(x),'sample SD:',sd(x),'\\n')
cat('Counts at most 9.80, 10.00, 10.20:',
    sum(x<=9.8),sum(x<=10),sum(x<=10.2),'\\n')
cat('Histogram counts:',h$counts,'\\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
plot(seq_len(M),x,pch=16,cex=0.6,col='#176b90',
     xlab='Acquisition order',ylab='Nitrate result (mg/L)',main=mode)
plot(h,freq=FALSE,col='#8ecae6',main=paste(M,'results'),
     xlab='Nitrate result (mg/L)',ylab='Density (L/mg)')
par(old)
""" ; cd:authoredResource true .
  ex:nn-binomial-code a cd:CodeExample ; skos:prefLabel "From independent signed effects to a normal approximation"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:normal-measurement-model ; cd:code """# Exact finite distributions, not a random simulation.
# Change n from 4 to 16, 50, 200. Only later enable the reference curve.
n <- 4; show_reference <- FALSE; sigma <- 0.10
stopifnot(n %in% c(4,16,50,200),sigma>0)
k <- 0:n
mass <- dbinom(k,size=n,prob=0.5)
a <- sigma/sqrt(n)
error <- a*(2*k-n)
z <- error/sigma
spacing <- 2/sqrt(n)
height <- mass/spacing
cat('n:',n,'single contribution a (mg/L):',a,'\\n')
cat('Total probability:',sum(mass),'total error variance:',
    sum(mass*error^2),'(mg/L)^2\\n')
cat('Standardized mean:',sum(mass*z),
    'variance:',sum(mass*z^2),'\\n')
if(n==4) cat('Combination counts:',round(mass*16),'\\n')
plot(z,height,type='n',xlim=c(-4,4),
     ylim=c(0,max(height,dnorm(0))*1.1),
     xlab='Standardized total error z',ylab='Mass / z-step width',
     main=paste(n,'signed contributions'))
rect(z-spacing/2,0,z+spacing/2,height,
     col='#8ecae6',border='#176b90')
if(show_reference) curve(dnorm(x),add=TRUE,col='#a63d21',lwd=2)
mtext('Central z window shown; printed sums include every count.',side=3,cex=0.65)
""" ; cd:authoredResource true .
  ex:nn-threshold-code a cd:CodeExample ; skos:prefLabel "z, lowercase phi, uppercase Phi and an upper limit"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:normal-measurement-model ; cd:code """# Fixed known model. Change limit, mu or sigma; no parameter estimation.
mu <- 10.00; sigma <- 0.10; limit <- 10.20; alpha <- 0.01
stopifnot(is.finite(mu),is.finite(limit),is.finite(sigma),sigma>0,
          alpha>0,alpha<1)
z <- (limit-mu)/sigma
phi <- dnorm(z); Phi <- pnorm(z)
upper <- pnorm(z,lower.tail=FALSE)
eta_star <- qnorm(1-alpha); x_star <- mu+sigma*eta_star
cat('z-score:',z,'\\n')
cat('phi: density per z-unit, NOT a probability:',phi,'\\n')
cat('Phi: probability at or below limit:',Phi,'\\n')
cat('Above limit:',100*upper,'%\\n')
cat('Upper',100*alpha,'% threshold (mg/L):',format(x_star,digits=12),'\\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
grid <- seq(-4,4,length.out=801)
plot(grid,dnorm(grid),type='l',col='#176b90',lwd=2,
     xlab='Standardized threshold z',ylab='Density per z-unit',main='Lowercase phi')
cut <- max(-4,min(4,z)); left <- seq(-4,cut,length.out=400)
polygon(c(-4,left,cut),c(0,dnorm(left),0),col='#8ecae6',border=NA)
abline(v=z,col='#a63d21',lty=2)
plot(grid,pnorm(grid),type='l',col='#176b90',lwd=2,ylim=c(0,1),
     xlab='Standardized threshold z',ylab='Cumulative probability',main='Uppercase Phi')
abline(v=z,h=Phi,col='#a63d21',lty=2)
par(old)
cat('Graphs show z -4 to 4; probabilities use the full normal law.\\n')
""" ; cd:authoredResource true .
  ex:nn-ecdf-code a cd:CodeExample ; skos:prefLabel "Observed step CDF versus the fixed theoretical normal CDF"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:normal-measurement-model ; cd:code """# Same deterministic 1000-draw sample as the saved histogram.
M <- 1000; mu <- 10.00; sigma <- 0.10; state <- 20261102
x <- numeric(M)
for(i in seq_len(M)) {
  state <- (16807*state) %% 2147483647
  x[i] <- mu+sigma*qnorm(state/2147483647)
}
Fn <- ecdf(x)
cat('Observed fractions at 9.80, 10.00, 10.20:',Fn(c(9.8,10,10.2)),'\\n')
cat('Theoretical CDF at 10.20:',pnorm(10.2,mu,sigma),'\\n')
cat('Observed upper fraction:',mean(x>10.2),'\\n')
plot(Fn,verticals=FALSE,do.points=FALSE,col='#176b90',lwd=2,
     main='1000 observations versus an assumed model',
     xlab='Nitrate threshold (mg/L)',ylab='Cumulative probability')
curve(pnorm(x,mean=mu,sd=sigma),add=TRUE,col='#a63d21',lwd=2)
legend('topleft',c('Empirical step CDF','Fixed theoretical CDF'),
       col=c('#176b90','#a63d21'),lty=1,bty='n')
""" ; cd:authoredResource true .
  ex:nn-means-code a cd:CodeExample ; skos:prefLabel "Repeat single readings and complete six-reading averages"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:normal-measurement-model ; cd:code """# Known normal model; each mean uses fresh independent readings.
M <- 10000; n <- 6; mu <- 10.00; sigma <- 0.10; state <- 20261102
stopifnot(M>=100,M<=10000,n>=1,n<=100,n==as.integer(n))
draw <- function() {
  state <<- (16807*state) %% 2147483647
  mu+sigma*qnorm(state/2147483647)
}
single <- numeric(M); means <- numeric(M)
for(j in seq_len(M)) {
  single[j] <- draw()
  values <- numeric(n)
  for(i in seq_len(n)) values[i] <- draw()
  means[j] <- mean(values)
}
cat('Empirical SD, individual and mean:',sd(single),sd(means),'\\n')
cat('Theoretical SD, individual and mean:',sigma,sigma/sqrt(n),'\\n')
edges <- seq(min(9.5,floor(min(single,means)/0.02)*0.02),
             max(10.5,ceiling(max(single,means)/0.02)*0.02),by=0.02)
h1 <- hist(single,breaks=edges,right=FALSE,plot=FALSE)
h2 <- hist(means,breaks=edges,right=FALSE,plot=FALSE)
top <- max(h1$density,h2$density,dnorm(mu,mu,sigma/sqrt(n)))*1.1
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
plot(h1,freq=FALSE,ylim=c(0,top),col='#8ecae6',main='Individual results',
     xlab='Nitrate result (mg/L)',ylab='Density (L/mg)')
curve(dnorm(x,mu,sigma),add=TRUE,col='#a63d21',lwd=2)
plot(h2,freq=FALSE,ylim=c(0,top),col='#8ecae6',main=paste('Means of',n),
     xlab='Mean nitrate result (mg/L)',ylab='Density (L/mg)')
curve(dnorm(x,mu,sigma/sqrt(n)),add=TRUE,col='#a63d21',lwd=2)
par(old)
""" ; cd:authoredResource true .
  ex:nn-growth-task a cd:Exercise ; cd:body "Optional instructor experiment: run 20, 50, 100 and 1,000 stable results. Describe the histogram before naming a distribution. Its generator is a specified teaching model, not a fit to the six opening readings. Do not change the error mode yet. The next slide provides the saved 1,000-result fallback."@en ; cd:authoredResource true .
  ex:nn-binomial-task a cd:Exercise ; cd:body "Optional experiment: change contributions from 4 to 16, 50, 200. Each step gets smaller so total SD stays 0.10 mg/L. Compare mass divided by standardized spacing, not a mass height with a density. Finite models stay discrete. Enable the normal reference only after discussing the shape. Many iid finite-variance effects justify a CLT approximation; a dominant effect or shared source may not."@en ; cd:authoredResource true .
  ex:nn-threshold-task a cd:Exercise ; cd:body "Optional experiment: move the concentration threshold, then compare SD 0.10 and 0.20 mg/L at the same 10.20 result. Read z, density phi, cumulative probability Phi and upper-tail probability separately. Finally enter a proposed upper 1% limit and compare it with the inverse-CDF result. Static calculations on the surrounding slides remain usable without R."@en ; cd:authoredResource true .
  ex:nn-ecdf-task a cd:Exercise ; cd:body "Overlay the empirical step CDF of 1,000 simulated individual results with the assumed theoretical CDF. Saved replay: 978/1,000 are at most 10.20 mg/L, versus theoretical 97.725%; 22/1,000 exceed it. Why are they not identical? Finite samples fluctuate even under the generating model. Neither curve is a confidence band or a fitted-model goodness-of-fit test."@en ; cd:authoredResource true .
  ex:nn-means-task a cd:Exercise ; cd:body "Optional experiment: repeat a single result and a mean of six fresh independent results 10,000 times. Compare histograms on the same physical and density scales. Increase readings per mean, keeping individual SD fixed. More readings narrow the sampling distribution of the mean, not the method's individual-error distribution. Static theoretical SE: 0.040825 mg/L for six readings."@en ; cd:authoredResource true .
  ex:nn-limits-task a cd:Exercise ; cd:body "Optional critical experiment: set M=1,000 and compare stable, drift, interference and censored modes one at a time. Inspect acquisition order and histogram together. Which assumption changed? The artificial reporting cutoff 9.95 mg/L is a teaching device, not an actual nitrate detection limit or a recommended substitution rule. The following cards provide a noninteractive interpretation."@en ; cd:authoredResource true .
}
