<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-sample-comparison> {
  ex:ted-scene-sample-comparison a cd:SceneDefinition ; cd:focusConcept ex:ted-sample-calibration-comparison ; cd:hasSceneItem ex:ted-sample-heading, ex:ted-sample-chart-item, ex:ted-sample-bullets ;
    cd:narration "First show Influent and Effluent evaluated with one local 15-standard fit each. Next reveal the same sample evaluations averaged across eleven fitted windows at offsets minus five through plus five. For each replicate, inverse-predict SBR mass from marker area, divide by its measured sample mass and convert micrograms per microgram to micrograms per milligram. The local estimates average three replicates. The ensemble averages eleven three-replicate means; it does not fit eleven predictors or average regression coefficients. The supplied code selects middle windows of balanced calibrant order, with one-position center shift for Influent. This is not independently verified matching to calendar measurement sessions. Whiskers are mean plus/minus descriptive standard error: across three replicates locally, versus across eleven strongly overlapping window means for the ensemble. Those are different sampling units, so a smaller ensemble bar is not proof of lower measurement uncertainty or better precision. No statistical significance, matrix equivalence or causal treatment effect is claimed. Source: supplied sample-robustness code, sample triplicates and the same 44 calibrants from the prior slide."@en ; cd:authoredResource true .
  ex:ted-sample-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-sample-calibration-comparison ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-sample-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-sample-comparison-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-sample-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-sample-comparison-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
