<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-sample-comparison> {
  ex:ted-sample-calibration-comparison a cd:Concept ; skos:prefLabel "One calibration or eleven neighboring fits?"@en ;
    cd:hasDefinition ex:ted-sample-calibration-definition ; cd:hasSource ex:ted-source-workshop-samples ; cd:authoredResource true .
  ex:ted-sbr-content-result a cd:Concept ; skos:prefLabel "Normalized SBR mass content"@en ;
    cd:hasDefinition ex:ted-sample-calibration-definition ; cd:authoredResource true .
  ex:ted-sample-calibration-definition a cd:Definition ;
    cd:body "For each sample replicate, a linear mass/area calibration predicts SBR mass from its measured marker area. Divide by sample mass and convert to micrograms SBR per milligram sample. The local result is the mean of three normalized replicate results. The neighboring-fit result averages eleven such replicate means from 15-standard windows with start offsets minus five through plus five. This is an ensemble of simple regressions, not multiple-predictor regression or averaging regression coefficients. In the supplied code the neighboring windows refer to the balanced calibrant order, not to independently selected chronological measurement sessions. Local standard error is across three replicates; the ensemble display uses standard error across eleven strongly overlapping window means. These are different sampling units. The latter is descriptive sensitivity to the selected windows, not independent measurement uncertainty, a confidence interval or evidence of better precision, matrix equivalence or drift correction."@en ;
    cd:hasSource ex:ted-source-workshop-samples ; cd:authoredResource true .
  ex:ted-sample-comparison-points a cd:Interpretation ; cd:body "Compare the same samples under different calibration evaluations."@en ; cd:hasKeyPoint ex:ted-sample-p1, ex:ted-sample-p2, ex:ted-sample-p3 ; cd:authoredResource true .
  ex:ted-sample-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Local:** one fit per sample"@en ; cd:authoredResource true .
  ex:ted-sample-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**±5:** mean across 11 window fits"@en ; cd:authoredResource true .
  ex:ted-sample-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Overlapping windows are not independent=="@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-sample-comparison> {
  ex:ted-source-workshop-samples a cd:Source ; dct:title "Renner workshop microplastics: sample robustness comparison" ; dct:creator "Gerrit Renner" ;
    dct:identifier "renner_workshop_microplastics.html#sample-robustness; sampleRobustnessSamples; evaluateSampleWindow; buildSampleRobustnessSeries; buildSampleRobustnessSummary" ;
    dct:hasVersion "sha256:29cfc1ceeadcd3a870ad2ca41ef6930ec2ce537dc8297dca5f07407a5c23472f" ;
    dct:description "Supplied sample triplicates and mass normalizers, and the original middle-window/centerShift selection. Results use all 44 previously transcribed calibrants in balanced order. No calendar-date session matching is inferred. The old claim that neighboring-window standard errors establish more realistic uncertainty is not adopted."@en ;
    cd:supportsResource ex:ted-sample-calibration-definition, ex:ted-in-input, ex:ted-out-input, ex:ted-in-local-data, ex:ted-out-local-data, ex:ted-in-ensemble-data, ex:ted-out-ensemble-data ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/data/talks-ted-sample-comparison> {
  # Scientific inputs and a reproducible recipe. Input xValue = sample mass in µg;
  # numericValue = marker area in the same source units as the calibration pairs.
  # localWindowStart is one-based. Factor 1000 converts µg/µg to µg/mg.
  ex:ted-in-input a cd:Dataset ; skos:prefLabel "Influent sample triplicates"@en ; cd:unit "source units" ; cd:sampleMassUnit "µg" ;
    cd:usesCalibrationDataset ex:ted-calibration-pairs ; cd:localWindowStart 16 ; cd:calibrationWindowSize 15 ; cd:neighborRadius 5 ; cd:normalizationFactor 1000.0 ;
    cd:hasObservation ex:ted-in-raw1, ex:ted-in-raw2, ex:ted-in-raw3 ; cd:hasSource ex:ted-source-workshop-samples ; cd:authoredResource true .
  ex:ted-in-raw1 a cd:Observation ; cd:position 1 ; cd:xValue 4074.2 ; cd:numericValue 11827.0 ; cd:authoredResource true .
  ex:ted-in-raw2 a cd:Observation ; cd:position 2 ; cd:xValue 4087.6 ; cd:numericValue 10695.0 ; cd:authoredResource true .
  ex:ted-in-raw3 a cd:Observation ; cd:position 3 ; cd:xValue 3992.7 ; cd:numericValue 13545.0 ; cd:authoredResource true .
  ex:ted-out-input a cd:Dataset ; skos:prefLabel "Effluent sample triplicates"@en ; cd:unit "source units" ; cd:sampleMassUnit "µg" ;
    cd:usesCalibrationDataset ex:ted-calibration-pairs ; cd:localWindowStart 15 ; cd:calibrationWindowSize 15 ; cd:neighborRadius 5 ; cd:normalizationFactor 1000.0 ;
    cd:hasObservation ex:ted-out-raw1, ex:ted-out-raw2, ex:ted-out-raw3 ; cd:hasSource ex:ted-source-workshop-samples ; cd:authoredResource true .
  ex:ted-out-raw1 a cd:Observation ; cd:position 1 ; cd:xValue 3978.2 ; cd:numericValue 9422.0 ; cd:authoredResource true .
  ex:ted-out-raw2 a cd:Observation ; cd:position 2 ; cd:xValue 4014.1 ; cd:numericValue 10165.0 ; cd:authoredResource true .
  ex:ted-out-raw3 a cd:Observation ; cd:position 3 ; cd:xValue 4084.1 ; cd:numericValue 10119.0 ; cd:authoredResource true .

