  ex:ted-in-local-mean a cd:StatisticalResult ; cd:numericValue 15.687291305338027 ; cd:unit "µg/mg" ; cd:quantifiesProperty ex:ted-sbr-content-result ; cd:usesDataset ex:ted-in-local-data ; cd:authoredResource true .
  ex:ted-out-local-mean a cd:StatisticalResult ; cd:numericValue 13.649277025894788 ; cd:unit "µg/mg" ; cd:quantifiesProperty ex:ted-sbr-content-result ; cd:usesDataset ex:ted-out-local-data ; cd:authoredResource true .
  ex:ted-in-ensemble-mean a cd:StatisticalResult ; cd:numericValue 15.306105243334441 ; cd:unit "µg/mg" ; cd:quantifiesProperty ex:ted-sbr-content-result ; cd:usesDataset ex:ted-in-ensemble-data ; cd:authoredResource true .
  ex:ted-out-ensemble-mean a cd:StatisticalResult ; cd:numericValue 12.9337750200244 ; cd:unit "µg/mg" ; cd:quantifiesProperty ex:ted-sbr-content-result ; cd:usesDataset ex:ted-out-ensemble-data ; cd:authoredResource true .
