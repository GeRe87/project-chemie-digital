  ex:ted-out-l1 a cd:Observation ; cd:position 1 ; cd:numericValue 13.30639656141782 ; cd:authoredResource true .
  ex:ted-out-l2 a cd:Observation ; cd:position 2 ; cd:numericValue 13.964015147183238 ; cd:authoredResource true .
