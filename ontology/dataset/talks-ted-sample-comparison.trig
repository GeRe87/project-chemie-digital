<https://w3id.org/project-chemie-digital/graph/paths/talk-microplastics-ted-gc-ms> {
  ex:path-talk-microplastics-ted-gc-ms cd:forTopic ex:ted-sample-calibration-comparison ; cd:hasStep ex:ted-step-sample-comparison .
  ex:ted-step-sample-comparison a cd:PathStep ; cd:position 13 ; cd:usesResource ex:ted-sample-comparison-chart, ex:ted-sample-comparison-points ; cd:usesScene ex:ted-scene-sample-comparison ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-sample-comparison> {
  ex:ted-scene-sample-comparison a cd:SceneDefinition ; cd:focusConcept ex:ted-sample-calibration-comparison ; cd:hasSceneItem ex:ted-sample-heading, ex:ted-sample-chart-item, ex:ted-sample-bullets ;
    cd:narration "Show Influent and Effluent evaluated with one local 15-standard fit each. For each replicate, inverse-predict SBR mass from marker area, divide by its measured sample mass and convert micrograms per microgram to micrograms per milligram. Each estimate averages three normalized replicates. The supplied code selects middle windows in balanced calibrant order, with a one-position center shift for Influent; this is not independently verified matching to calendar sessions. Whiskers show mean plus or minus descriptive standard error across three replicates, not a confidence interval or full measurement-uncertainty budget. No significance, matrix equivalence or causal treatment effect is claimed. Only local fits are shown. Source: supplied sample triplicates and the same 44 calibrants from the prior slide."@en ; cd:authoredResource true .
  ex:ted-sample-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-sample-calibration-comparison ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-sample-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-sample-comparison-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-sample-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-sample-comparison-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
