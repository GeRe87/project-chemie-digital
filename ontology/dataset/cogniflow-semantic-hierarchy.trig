@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-hierarchy> {
  ex:cogniflow-semantic-hierarchy a cd:Concept ;
    skos:prefLabel "A Hierarchy of Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-semantic-hierarchy ;
    cd:authoredResource true .

  ex:def-cogniflow-semantic-hierarchy a cd:Definition ;
    cd:body "CogniFlow separates semantic responsibility into three layers: the core provides the meta-grammar, concept domains define reusable vocabulary with that grammar, and specifications use that vocabulary to describe concrete concepts."@en ;
    cd:authoredResource true .

  ex:cogniflow-semantic-hierarchy-intro a cd:Interpretation ;
    cd:body "Each layer defines the language available to the layer below."@en ;
    cd:authoredResource true .

  ex:diagram-cogniflow-semantic-hierarchy a cd:FlowDiagram ;
    skos:prefLabel "Core, concepts and specifications"@en ;
    cd:body "A three-level semantic hierarchy from the core meta-grammar through reusable concepts to concrete specifications."@en ;
    cd:hasDiagramNode ex:node-cogniflow-hierarchy-core,
      ex:node-cogniflow-hierarchy-concepts,
      ex:node-cogniflow-hierarchy-specifications ;
    cd:hasDiagramEdge ex:edge-cogniflow-hierarchy-core-concepts,
      ex:edge-cogniflow-hierarchy-concepts-specifications ;
    cd:authoredResource true .

  ex:node-cogniflow-hierarchy-core a cd:DiagramNode ;
    skos:prefLabel """CORE
defines the terms used
to define Concepts"""@en ;
    cd:position 1 ;
    cd:authoredResource true .

  ex:node-cogniflow-hierarchy-concepts a cd:DiagramNode ;
    skos:prefLabel """CONCEPTS
define the terms used
within Concepts"""@en ;
    cd:position 2 ;
    cd:authoredResource true .

  ex:node-cogniflow-hierarchy-specifications a cd:DiagramNode ;
    skos:prefLabel """SPECIFICATIONS
specify concrete Concepts"""@en ;
    cd:position 3 ;
    cd:authoredResource true .

  ex:edge-cogniflow-hierarchy-core-concepts a cd:DiagramEdge ;
    skos:prefLabel "defines vocabulary for"@en ;
    cd:position 1 ;
    cd:sourceNode ex:node-cogniflow-hierarchy-core ;
    cd:targetNode ex:node-cogniflow-hierarchy-concepts ;
    cd:authoredResource true .

  ex:edge-cogniflow-hierarchy-concepts-specifications a cd:DiagramEdge ;
    skos:prefLabel "used by"@en ;
    cd:position 2 ;
    cd:sourceNode ex:node-cogniflow-hierarchy-concepts ;
    cd:targetNode ex:node-cogniflow-hierarchy-specifications ;
    cd:authoredResource true .

  ex:cogniflow-semantic-hierarchy-footer a cd:Interpretation ;
    cd:body "META-GRAMMAR → DOMAIN VOCABULARY → CONCRETE SPECIFICATION"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-hierarchy> {
  ex:path-step-cogniflow-semantic-hierarchy a cd:PathStep ;
    cd:position 9 ;
    cd:usesResource ex:cogniflow-semantic-hierarchy-intro,
      ex:diagram-cogniflow-semantic-hierarchy,
      ex:cogniflow-semantic-hierarchy-footer ;
    cd:usesScene ex:scene-cogniflow-semantic-hierarchy ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-hierarchy> {
  ex:scene-cogniflow-semantic-hierarchy a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantic-hierarchy ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantic-hierarchy-heading,
      ex:scene-item-cogniflow-semantic-hierarchy-intro,
      ex:scene-item-cogniflow-semantic-hierarchy-diagram,
      ex:scene-item-cogniflow-semantic-hierarchy-footer ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-hierarchy-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantic-hierarchy ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-hierarchy-intro a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-semantic-hierarchy-intro ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-hierarchy-diagram a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:diagram-cogniflow-semantic-hierarchy ;
    cd:communicativeRole cd:DiagramRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-hierarchy-footer a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-semantic-hierarchy-footer ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
