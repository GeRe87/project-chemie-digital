@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-source> {
  ex:cogniflow-semantics-as-source a cd:Concept ;
    skos:prefLabel "Interfaces Need Shared Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-semantics-as-source ;
    cd:authoredResource true .

  ex:def-cogniflow-semantics-as-source a cd:Definition ;
    cd:body "CogniFlow makes scientific meaning machine-readable so data, services and views can share one semantic contract."@en ;
    cd:authoredResource true .

  ex:chart-cogniflow-replicate-peak-area a cd:ChartDefinition ;
    skos:prefLabel "Peak area across repeated injections"@en ;
    cd:body "Synthetic repeated-injection peak areas used to demonstrate semantic projection; values are illustrative rather than measured experimental data."@en ;
    cd:chartType cd:BarChart ;
    cd:xAxisLabel "Injection"@en ;
    cd:yAxisLabel "Peak area"@en ;
    cd:yAxisUnit "a.u." ;
    cd:usesDataset ex:dataset-cogniflow-replicate-peak-area ;
    cd:authoredResource true .

  ex:dataset-cogniflow-replicate-peak-area a cd:Dataset ;
    skos:prefLabel "Illustrative repeated injections"@en ;
    cd:hasObservation ex:cogniflow-peak-area-injection-1,
      ex:cogniflow-peak-area-injection-2,
      ex:cogniflow-peak-area-injection-3,
      ex:cogniflow-peak-area-injection-4 ;
    cd:authoredResource true .

  ex:cogniflow-peak-area-injection-1 a cd:Observation ;
    skos:prefLabel "Injection 1"@en ;
    cd:position 1 ; cd:numericValue 98.6 ; cd:authoredResource true .

  ex:cogniflow-peak-area-injection-2 a cd:Observation ;
    skos:prefLabel "Injection 2"@en ;
    cd:position 2 ; cd:numericValue 100.3 ; cd:authoredResource true .

  ex:cogniflow-peak-area-injection-3 a cd:Observation ;
    skos:prefLabel "Injection 3"@en ;
    cd:position 3 ; cd:numericValue 99.5 ; cd:authoredResource true .

  ex:cogniflow-peak-area-injection-4 a cd:Observation ;
    skos:prefLabel "Injection 4"@en ;
    cd:position 4 ; cd:numericValue 101.1 ; cd:authoredResource true .

  ex:code-cogniflow-chart-semantics a cd:CodeExample ;
    skos:prefLabel "One machine-readable scientific meaning"@en ;
    cd:code """@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

ex:chart-cogniflow-replicate-peak-area a cd:ChartDefinition ;
    cd:usesDataset ex:dataset-cogniflow-replicate-peak-area .

ex:dataset-cogniflow-replicate-peak-area a cd:Dataset ;
    cd:hasObservation ex:cogniflow-peak-area-injection-2 .

ex:cogniflow-peak-area-injection-2 a cd:Observation ;
    skos:prefLabel "Injection 2"@en ;
    cd:numericValue 100.3 .""" ;
    cd:programmingLanguage "trig" ;
    cd:editable false ;
    cd:executable false ;
    cd:showsResource ex:chart-cogniflow-replicate-peak-area,
      ex:dataset-cogniflow-replicate-peak-area,
      ex:cogniflow-peak-area-injection-2 ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-source-extension> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-semantics-as-source .

  ex:path-step-cogniflow-semantics-as-source a cd:PathStep ;
    cd:position 12 ;
    cd:usesResource ex:code-cogniflow-chart-semantics ;
    cd:usesScene ex:scene-cogniflow-semantics-as-source ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-source> {
  ex:scene-cogniflow-semantics-as-source a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantics-as-source ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantics-heading,
      ex:scene-item-cogniflow-semantics-code ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantics-as-source ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-code a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:code-cogniflow-chart-semantics ;
    cd:communicativeRole cd:CodeRole ;
    cd:selectionPath "cd:hasCodeExample" ;
    cd:language "en" ;
    cd:authoredResource true .
}
