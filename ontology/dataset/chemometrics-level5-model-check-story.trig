@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-model-check-story> {
  ex:rev-qq a cd:Concept ; skos:prefLabel "Normal quantile-quantile plot"@en ; cd:hasDefinition ex:rev-qq-def ; cd:authoredResource true .
  ex:rev-qq-def a cd:Definition ; cd:body "A normal Q-Q plot pairs ordered observations with normal theoretical quantiles at explicitly chosen plotting probabilities. Approximate linearity is descriptive evidence about normal shape, not a hypothesis-test decision. Against a fully specified normal model, agreement should be near the identity line in common units. A fitted location-scale line answers a different shape question."@en ; cd:hasSource ex:rev-source-qq ; cd:authoredResource true .
  ex:rev-source-qq a cd:Source ; dct:title "NIST/SEMATECH: Normal Probability Plot" ; dct:creator "NIST/SEMATECH" ; dct:identifier "rev-source-qq" ; dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/normprpl.htm> ; cd:supportsResource ex:rev-qq-def ; cd:authoredResource true .
  ex:unit-level5-probability-models cd:hasFocusConcept ex:rev-qq .
  ex:rev-check-protocol a cd:WorkedExample ; cd:body "Two constructed teaching samples, each n=5, are compared with a normal model fixed before either sample: mean 10 mg/L, SD 0.50 mg/L. A: 9.4, 9.8, 10.0, 10.2, 10.6 mg/L. B: 10.3, 10.31, 10.32, 10.33, 12.0 mg/L, a deliberately right-skewed departure. Neither set proves a population family. Q-Q probabilities are (i-0.5)/5 for sorted rank i. Corresponding normal quantiles are 9.3592242172277, 9.73779974364598, 10.0, 10.26220025635402, 10.6407757827723 mg/L. For KS check both jump sides, not just included ECDF values. A has D=0.14457825838967642; B has D=0.7257468822499269 at the left side of the first jump (10.3 mg/L). Both use exact n=5 two-sided fixed-continuous-null cutoff 0.5632751983660635 at alpha 0.05. A is not rejected, B is rejected. The figures use the same samples for both Q-Q and KS, but visual compatibility is not proof of normality. If parameters are fitted to these data, use suitable Lilliefors or refitted-bootstrap calibration instead of this classical table. Fixed affine transformation of both data and model preserves KS distance. Standardizing with estimated parameters does not restore classical calibration."@en ; cd:authoredResource true .
  ex:rev-qq-a a cd:Dataset ; skos:prefLabel "Q-Q pairs, compatible constructed sample A"@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:rev-check-protocol ; cd:hasObservation ex:rev-qa1, ex:rev-qa2, ex:rev-qa3, ex:rev-qa4, ex:rev-qa5 ; cd:authoredResource true .
  ex:rev-qa1 a cd:Observation ; cd:position 1 ; cd:xValue 9.3592242172277 ; cd:numericValue 9.4 ; cd:authoredResource true .
  ex:rev-qa2 a cd:Observation ; cd:position 2 ; cd:xValue 9.73779974364598 ; cd:numericValue 9.8 ; cd:authoredResource true .
  ex:rev-qa3 a cd:Observation ; cd:position 3 ; cd:xValue 10.0 ; cd:numericValue 10.0 ; cd:authoredResource true .
  ex:rev-qa4 a cd:Observation ; cd:position 4 ; cd:xValue 10.26220025635402 ; cd:numericValue 10.2 ; cd:authoredResource true .
  ex:rev-qa5 a cd:Observation ; cd:position 5 ; cd:xValue 10.6407757827723 ; cd:numericValue 10.6 ; cd:authoredResource true .
  ex:rev-qq-b a cd:Dataset ; skos:prefLabel "Q-Q pairs, deliberately skewed constructed sample B"@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:rev-check-protocol ; cd:hasObservation ex:rev-qb1, ex:rev-qb2, ex:rev-qb3, ex:rev-qb4, ex:rev-qb5 ; cd:authoredResource true .
  ex:rev-qb1 a cd:Observation ; cd:position 1 ; cd:xValue 9.3592242172277 ; cd:numericValue 10.3 ; cd:authoredResource true .
  ex:rev-qb2 a cd:Observation ; cd:position 2 ; cd:xValue 9.73779974364598 ; cd:numericValue 10.31 ; cd:authoredResource true .
  ex:rev-qb3 a cd:Observation ; cd:position 3 ; cd:xValue 10.0 ; cd:numericValue 10.32 ; cd:authoredResource true .
  ex:rev-qb4 a cd:Observation ; cd:position 4 ; cd:xValue 10.26220025635402 ; cd:numericValue 10.33 ; cd:authoredResource true .
  ex:rev-qb5 a cd:Observation ; cd:position 5 ; cd:xValue 10.6407757827723 ; cd:numericValue 12.0 ; cd:authoredResource true .
  ex:rev-qq-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-qq-pair.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; dct:references ex:rev-qq-a, ex:rev-qq-b ; cd:alternativeText "Two normal Q-Q plots on common concentration axes. Each x coordinate is the fixed normal-model quantile at a midpoint rank probability; y is sorted observed concentration. Sample A follows the identity line closely. Sample B has four nearly equal values and one extreme upper value, producing a pronounced bend and disagreement with the fixed model. Five values cannot establish a population distribution."@en ; cd:authoredResource true .
  ex:rev-ks-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-ks-overlay-pair.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; dct:references ex:rev-check-protocol, ex:rev-qq-a, ex:rev-qq-b ; cd:alternativeText "ECDF steps and the same fixed normal CDF overlaid on common concentration and cumulative-probability axes. A's largest vertical gap is 0.144578. B's largest gap is 0.725747 just before its first observation 10.3 mg/L. Vertical segments mark discrepancies; open and filled points distinguish left limits and included values. No estimated standardization was used."@en ; cd:authoredResource true .
  ex:rev-qq-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-qq-context1 ; cd:authoredResource true .
  ex:rev-qq-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Would these data look plausible under the normal model"@en ; cd:body "Use the same samples for Q-Q and KS. A: 9.4, 9.8, 10.0, 10.2, 10.6 mg/L. B: 10.3, 10.31, 10.32, 10.33, 12.0 mg/L. Model fixed beforehand: mean 10, SD 0.50 mg/L."@en ; cd:authoredResource true .
  ex:rev-qq-formula a cd:MathExpression ; cd:formulaLabel "Pair a theoretical quantile with each sorted result"@en ; cd:latex "p_i=\\frac{i-0.5}{n},\\quad (q_i,x_{(i)})=(F_0^{-1}(p_i),x_{(i)})" ; dct:hasPart ex:rev-qq-legend ; cd:hasSymbol ex:rev-qq-symbol1, ex:rev-qq-symbol2 ; cd:authoredResource true .
  ex:rev-qq-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-qq-entry ; cd:authoredResource true .
  ex:rev-qq-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Q-Q coordinates and convention"@en ; dct:references ex:rev-qq-symbol1, ex:rev-qq-symbol2 ; cd:authoredResource true .
  ex:rev-qq-symbol1 a cd:MathSymbol ; cd:symbol "rank and plotting probability" ; cd:mathNotation "i,n,p_i" ; cd:body "i is sorted rank 1 to n=5; p indexed by i is a dimensionless midpoint plotting probability, not a p value. Subtract 0.5 then divide by n; this convention is stated, not a unique empirical-quantile rule."@en ; cd:authoredResource true .
  ex:rev-qq-symbol2 a cd:MathSymbol ; cd:symbol "theoretical and observed quantiles" ; cd:mathNotation "q_i,x_{(i)},F_0^{-1}" ; cd:body "q is horizontal theoretical quantile from the inverse fixed normal CDF; x with parenthesized rank is the vertical sorted result, both mg/L. Parentheses form a coordinate pair; equals defines it. Superscript minus one means inverse, not reciprocal."@en ; cd:authoredResource true .
  ex:rev-qq-reading a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-qq-reading1 ; cd:authoredResource true .
  ex:rev-qq-reading1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Read the pattern before calculating a test"@en ; cd:body "A lies close to the identity line for this fixed model. B bends sharply. A fitted straight line checks shape with adjustable location and scale; it is not the same fixed-model comparison. Neither plot alone proves normality."@en ; cd:authoredResource true .
  ex:rev-ks-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-ks-context1 ; cd:authoredResource true .
  ex:rev-ks-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Overlay the cumulative functions, then measure vertically"@en ; cd:body "ECDF: count at or below the threshold divided by 5. CDF: fixed-model probability. Check both jump sides. Maximum gaps: A 0.144578; B 0.725747. Distances, not p values."@en ; cd:authoredResource true .
  ex:rev-ks-scale-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-ks-scale1, ex:rev-ks-scale2, ex:rev-ks-scale3 ; cd:authoredResource true .
  ex:rev-ks-scale1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Same units are sufficient"@en ; cd:body "- ECDF and CDF can both use mg/L.\n\n- No mandatory standardization: the vertical gap is between probabilities."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-ks-scale2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Known location and scale"@en ; cd:body "- Transform each value using the fixed mean 10 and SD 0.50.\n\n- Compare that ECDF with standard normal. The KS distance is unchanged."@en ; cd:visualMotif "nonlinear-curve" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-ks-scale3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Parameters estimated here"@en ; cd:body "- Estimating mean and SD makes the reference follow the data.\n\n- Use suitable Lilliefors or refitted-bootstrap calibration, not the classical fixed-CDF table."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-ks-lookup a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-ks-lookup1 ; cd:authoredResource true .
  ex:rev-ks-lookup1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Read row n=5, column upper-tail alpha=0.05"@en ; cd:body "Exact two-sided one-sample KS, fixed continuous CDF: cutoff 0.563275. A: 0.144578 is below it, do not reject. B: 0.725747 is above it, reject. Non-rejection is not proof of normality."@en ; cd:authoredResource true .
  ex:rev-ks-code a cd:CodeExample ; skos:prefLabel "The same exact critical value with base R uniroot"@en ; cd:programmingLanguage "r" ; cd:editable false ; cd:executable false ; cd:showsResource ex:l5-kolmogorov-smirnov ; cd:code "n <- 5; a <- 0.05  # sample size; upper-tail level\ntail <- function(d) { k <- 0:floor(n*(1-d))\n  2*d*sum(choose(n,k)*(d+k/n)^(k-1)*(1-d-k/n)^(n-k)) }\nuniroot(function(d) tail(d)-a, c(.500001,.999999), tol=1e-12)$root\n# 0.5632751984. Exact shortcut here requires d above 0.5." ; cd:authoredResource true .
  ex:rev-pearson-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-pearson-context1 ; cd:authoredResource true .
  ex:rev-pearson-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Do the particle-size counts match the stated proportions"@en ; cd:body "New study: 100 particles, five fixed exhaustive bands, probabilities 0.10, 0.20, 0.40, 0.20, 0.10. No parameters fitted. Expected counts 10, 20, 40, 20, 10; compare observed counts, not diameter values."@en ; cd:authoredResource true .
  ex:rev-pearson-calc a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-pearson-calc1 ; cd:authoredResource true .
  ex:rev-pearson-calc1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Which discrepancies contribute to the test"@en ; cd:body "Observed counts 4, 12, 44, 24, 16. First band: a difference of -6 gives squared discrepancy 36, divided by expectation 10 gives 3.6. Add all five contributions to obtain 11.6. This is not the repeatability-variance statistic."@en ; cd:authoredResource true .
  ex:rev-pearson-lookup a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-pearson-lookup1 ; cd:authoredResource true .
  ex:rev-pearson-lookup1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Read row df=4, column upper-tail alpha=0.05"@en ; cd:body "Five category counts minus one fixed-total constraint gives 4 df. Cutoff 9.487729. Observed 11.6 exceeds it: reject these proportions. Chi-square is an approximate count-test reference, unlike the exact normal-sample variance law."@en ; cd:authoredResource true .
  ex:rev-pearson-code a cd:CodeExample ; skos:prefLabel "The same chi-square critical value in base R"@en ; cd:programmingLanguage "r" ; cd:editable false ; cd:executable false ; cd:showsResource ex:l5-pearson-gof ; cd:code "qchisq(1 - 0.05, df = 4)  # 9.487729\npchisq(11.6, df = 4, lower.tail = FALSE)  # 0.02058737\n# Upper-tail 5% in the table = cumulative 95% for qchisq." ; cd:authoredResource true .
  ex:rev-pearson-compare a cd:DefinitionList ; cd:hasDefinitionListEntry ex:rev-pearson-good, ex:rev-pearson-bad, ex:rev-pearson-limits ; cd:authoredResource true .
  ex:rev-pearson-good a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Compatible counts"@en ; cd:body "- 9, 21, 39, 21, 10; total 100.\n\n- Weighted discrepancy 0.225 is below 9.487729: do not reject. Compatibility is not proof."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-pearson-bad a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Departing counts"@en ; cd:body "- 4, 12, 44, 24, 16; total 100.\n\n- Weighted discrepancy 11.6 is above 9.487729: reject the specified proportions, not every possible model."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:rev-pearson-limits a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Same reference, different data"@en ; cd:body "- Both examples use the same expected counts and 4 df.\n\n- Fixed classes, iid sampling and adequate expected counts matter. Fitting or sparse expectations needs justified recalibration."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
}
