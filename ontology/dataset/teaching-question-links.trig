@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix cdm: <https://w3id.org/project-chemie-digital/meta/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
<https://w3id.org/project-chemie-digital/graph/schema/teaching-question-links> {
  cd:guidingQuestion a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:PathStep ; rdfs:range cd:Interpretation .
  cd:answersGuidingQuestion a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:PathStep ; rdfs:range cd:Interpretation .
  cd:answerResource a rdf:Property, cdm:RelationDescriptor ; rdfs:domain cd:PathStep ; rdfs:range cd:Interpretation .
}
<https://w3id.org/project-chemie-digital/graph/shapes/teaching-question-links> {
  cd:GuidingQuestionStepShape a sh:NodeShape ; sh:targetSubjectsOf cd:guidingQuestion ;
    sh:class cd:PathStep ; sh:property [ sh:path cd:guidingQuestion ; sh:maxCount 1 ; sh:class cd:Interpretation ] .
  cd:AnswerStepShape a sh:NodeShape ; sh:targetSubjectsOf cd:answersGuidingQuestion, cd:answerResource ;
    sh:class cd:PathStep ;
    sh:property [ sh:path cd:answersGuidingQuestion ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Interpretation ] ;
    sh:property [ sh:path cd:answerResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:Interpretation ] .
}
