<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ks> {
  ex:l5-kolmogorov-smirnov a cd:Concept ; skos:prefLabel "One-sample Kolmogorov-Smirnov goodness-of-fit test"@en ; cd:hasDefinition ex:l5-ks-definition ; cd:authoredResource true .
  ex:l5-ks-definition a cd:Definition ; cd:body "The two-sided one-sample Kolmogorov-Smirnov statistic is the supremum absolute vertical distance between the empirical CDF and a specified reference CDF. For iid observations under a fully specified continuous null distribution, its classical null calibration depends on sample size, not the shape of that CDF. Estimating parameters from the same observations, discreteness, ties, censoring or dependence requires suitable calibration rather than unmodified classical critical values. Failure to reject does not establish that the model is true."@en ; cd:hasSource ex:l5-source-nist-ks ; cd:authoredResource true .
  ex:l5-source-nist-ks a cd:Source ; dct:title "NIST/SEMATECH e-Handbook: Kolmogorov-Smirnov Goodness-of-Fit Test" ; dct:creator "NIST/SEMATECH" ; dct:identifier "l5-source-nist-ks" ; dct:source <https://www.itl.nist.gov/div898/handbook/eda/section3/eda35g.htm> ; cd:supportsResource ex:l5-ks-definition, ex:l5-g19b-formula, ex:l5-g19c-formula ; cd:authoredResource true .
  ex:l5-g19a-formula a cd:MathExpression ; cd:formulaLabel "Count values at or below the threshold"@en ; cd:body "The empirical CDF at x is the number of observed values at most x divided by sample size. It is right-continuous and jumps by one fifth at each of these five distinct values."@en ; cd:latex "F_n(x)=\\frac{\\#\\{i:x_i\\le x\\}}{n}" ; dct:hasPart ex:l5-g19a-legend ; cd:hasSymbol ex:l5-g19a-function, ex:l5-g19a-values, ex:l5-g19a-count, ex:l5-g19a-units ; cd:authoredResource true .
  ex:l5-g19a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-g19a-entry ; cd:authoredResource true .
  ex:l5-g19a-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and empirical convention"@en ; dct:references ex:l5-g19a-function, ex:l5-g19a-values, ex:l5-g19a-count, ex:l5-g19a-units ; cd:authoredResource true .
  ex:l5-g19a-function a cd:MathSymbol ; cd:symbol "empirical CDF" ; cd:mathNotation "F_n(x)" ; cd:body "Observed fraction at or below x. Subscript n is sample size, here 5. This empirical step function is not a fitted smooth density."@en ; cd:authoredResource true .
  ex:l5-g19a-values a cd:MathSymbol ; cd:symbol "values and index" ; cd:mathNotation "x_i,\\ i,\\ x" ; cd:body "Observed concentration i, index 1 through 5, and threshold x. Values and threshold have mg/L units; each observation contributes once."@en ; cd:authoredResource true .
  ex:l5-g19a-count a cd:MathSymbol ; cd:symbol "counting and inclusion" ; cd:mathNotation "\\#,\\ \\{\\},\\ :,\\ \\le" ; cd:body "Hash counts indices in the set satisfying the condition after the colon. Less than or equal includes the value at the jump: right-continuity."@en ; cd:authoredResource true .
  ex:l5-g19a-units a cd:MathSymbol ; cd:symbol "normalization" ; cd:mathNotation "n,\\ /,\\ =" ; cd:body "Divide the count by size n. Equality defines a dimensionless fraction between 0 and 1; each distinct observed value adds 0.2 here."@en ; cd:authoredResource true .
  ex:l5-g19b-formula a cd:MathExpression ; cd:formulaLabel "Largest vertical CDF discrepancy"@en ; cd:body "The two-sided KS statistic is the supremum, over all real thresholds, of the absolute difference between empirical and specified model CDFs."@en ; cd:latex "D_n=\\sup_{x\\in\\mathbb R}|F_n(x)-F_0(x)|" ; dct:hasPart ex:l5-g19b-legend ; cd:hasSymbol ex:l5-g19b-empirical, ex:l5-g19b-null, ex:l5-g19b-sup, ex:l5-g19b-distance ; cd:hasSource ex:l5-source-nist-ks ; cd:authoredResource true .
  ex:l5-g19b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-g19b-entry ; cd:authoredResource true .
  ex:l5-g19b-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and fixed reference"@en ; dct:references ex:l5-g19b-empirical, ex:l5-g19b-null, ex:l5-g19b-sup, ex:l5-g19b-distance ; cd:authoredResource true .
  ex:l5-g19b-empirical a cd:MathSymbol ; cd:symbol "empirical CDF" ; cd:mathNotation "F_n(x),\\ n" ; cd:body "Observed fraction at or below threshold x, based on n = 5 concentrations. Its values are dimensionless; thresholds use mg/L."@en ; cd:authoredResource true .
  ex:l5-g19b-null a cd:MathSymbol ; cd:symbol "specified model CDF" ; cd:mathNotation "F_0(x)" ; cd:body "Null CDF fixed before these data: normal, mean 10 mg/L and SD 0.50 mg/L. Subscript 0 identifies the null, not a sample size."@en ; cd:authoredResource true .
  ex:l5-g19b-sup a cd:MathSymbol ; cd:symbol "supremum over thresholds" ; cd:mathNotation "\\sup_{x\\in\\mathbb R}" ; cd:body "Least upper bound over every real threshold x. Membership and R mean all real values, not only a finite plotting grid."@en ; cd:authoredResource true .
  ex:l5-g19b-distance a cd:MathSymbol ; cd:symbol "two-sided distance" ; cd:mathNotation "D_n,\\ |\\cdot|,\\ -,\\ =" ; cd:body "Subtract CDFs and take absolute value, allowing discrepancies in either direction. Equality defines dimensionless D, between 0 and 1."@en ; cd:authoredResource true .
  ex:l5-g19c-formula a cd:MathExpression ; cd:formulaLabel "Check both sides of every empirical jump"@en ; cd:body "For sorted distinct values and a continuous model, check empirical right-hand values minus model CDF and model CDF minus empirical left-hand values. The maximum of both sets is about 0.144578."@en ; cd:latex "\\begin{gathered}D^+=\\max_i\\left(\\frac{i}{n}-F_0(x_{(i)})\\right)\\\\D^-=\\max_i\\left(F_0(x_{(i)})-\\frac{i-1}{n}\\right)\\\\D_n=\\max(D^+,D^-)\\approx0.144578\\end{gathered}" ; dct:hasPart ex:l5-g19c-legend ; cd:hasSymbol ex:l5-g19c-order, ex:l5-g19c-model, ex:l5-g19c-sides, ex:l5-g19c-operators ; cd:hasSource ex:l5-source-nist-ks ; cd:authoredResource true .
  ex:l5-g19c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-g19c-entry ; cd:authoredResource true .
  ex:l5-g19c-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, indices and jump limits"@en ; dct:references ex:l5-g19c-order, ex:l5-g19c-model, ex:l5-g19c-sides, ex:l5-g19c-operators ; cd:authoredResource true .
  ex:l5-g19c-order a cd:MathSymbol ; cd:symbol "sorted concentrations" ; cd:mathNotation "x_{(i)},\\ i,\\ n" ; cd:body "Parenthesized index is sorted rank, not a power. Here i runs 1 to n = 5; concentrations are in mg/L."@en ; cd:authoredResource true .
  ex:l5-g19c-model a cd:MathSymbol ; cd:symbol "model and jump sides" ; cd:mathNotation "F_0(x_{(i)}),\\ i/n,\\ (i-1)/n" ; cd:body "Fixed model CDF at rank i; empirical value just after the jump and its left limit just before. All three are dimensionless."@en ; cd:authoredResource true .
  ex:l5-g19c-sides a cd:MathSymbol ; cd:symbol "directional maxima" ; cd:mathNotation "D^+,\\ D^-,\\ D_n" ; cd:body "Superscripts label upward and downward discrepancies, not powers or signed final distances. Both maxima are about 0.144578 here; D is the larger."@en ; cd:authoredResource true .
  ex:l5-g19c-operators a cd:MathSymbol ; cd:symbol "maximum and arithmetic" ; cd:mathNotation "\\max_i,\\ -,\\ /,\\ =,\\ \\approx" ; cd:body "Check all five ranks, subtract and divide as shown, then take maxima. Equalities define statistics; approximation rounds the dimensionless result."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-ks> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:l5-kolmogorov-smirnov .
  ex:l5-g19a-title a cd:Interpretation ; skos:prefLabel "Check the model supporting our analysis"@en ; cd:authoredResource true .
  ex:l5-g19b-title a cd:Interpretation ; skos:prefLabel "Compare sample evidence with a fixed model"@en ; cd:authoredResource true .
  ex:l5-g19c-title a cd:Interpretation ; skos:prefLabel "Measure model discrepancy, not mean error"@en ; cd:authoredResource true .
  ex:l5-g19d-title a cd:Interpretation ; skos:prefLabel "Non-rejection is not representativeness"@en ; cd:authoredResource true .
  ex:l5-g19e-title a cd:Interpretation ; skos:prefLabel "Fitting parameters changes model checking"@en ; cd:authoredResource true .
  ex:l5-g19a-chart a cd:ChartDefinition ; skos:prefLabel "Empirical CDF of five new constructed concentrations"@en ; cd:body "New values: 9.4, 9.8, 10.0, 10.2, 10.6 mg/L. Included points and left limits."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "step-after" ; cd:showChartPoints true ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.0 ; cd:usesDataset ex:l5-g19-ecdf ; cd:xAxisLabel "Concentration threshold"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Cumulative fraction"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-g19b-chart a cd:ChartDefinition ; skos:prefLabel "Prespecified normal CDF, not estimated from the five values"@en ; cd:body "Model fixed before data: mean 10, SD 0.50 mg/L. Not a representativeness check."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 1.0 ; cd:usesDataset ex:l5-g19-model ; cd:xAxisLabel "Concentration threshold"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Cumulative fraction"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-g19c-chart a cd:ChartDefinition ; skos:prefLabel "Computed CDF gaps at sorted concentrations"@en ; cd:body "Largest gap: 0.144578. A model discrepancy, not uncertainty in the mean."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints true ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.16 ; cd:usesDataset ex:l5-g19-plus ; dct:hasPart ex:l5-g19-minus ; cd:xAxisLabel "Sorted concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "CDF gap"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-g19d-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-g19d-observed, ex:l5-g19d-critical, ex:l5-g19d-decision, ex:l5-g19d-meaning ; cd:authoredResource true .
  ex:l5-g19d-observed a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed distance: 0.144578"@en ; cd:body "Both sides of all five empirical jumps have been checked. This is a CDF distance, not a p value."@en ; cd:authoredResource true .
  ex:l5-g19d-critical a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Exact 5% cutoff: 0.563275"@en ; cd:body "For five iid observations and a fully specified continuous null. Reject only above this finite-sample cutoff."@en ; cd:authoredResource true .
  ex:l5-g19d-decision a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Do not reject at 5%"@en ; cd:body "The observed distance is below the prespecified rejection cutoff for this fixed normal model."@en ; cd:authoredResource true .
  ex:l5-g19d-meaning a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Not proof of representativeness"@en ; cd:body "Five values give limited discrimination. Non-rejection verifies neither the sampling design nor normality, independence or analytical accuracy."@en ; cd:authoredResource true .
  ex:l5-g19-calibration a cd:Dataset ; skos:prefLabel "Observed KS statistic and exact n-five critical distance"@en ; cd:derivedFromResource ex:l5-g19-protocol ; cd:hasObservation ex:l5-g19-distance, ex:l5-g19-cutoff ; cd:authoredResource true .
  ex:l5-g19-distance a cd:Observation ; cd:position 1 ; skos:prefLabel "Observed D"@en ; cd:numericValue 0.14457825838967642 ; cd:authoredResource true .
  ex:l5-g19-cutoff a cd:Observation ; cd:position 2 ; skos:prefLabel "5% cutoff"@en ; cd:numericValue 0.5632751983660635 ; cd:authoredResource true .
  ex:l5-g19e-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-g19e-fitted, ex:l5-g19e-discrete, ex:l5-g19e-sampling, ex:l5-g19e-interpretation ; cd:authoredResource true .
  ex:l5-g19e-fitted a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Parameters fitted here"@en ; cd:body "Classical fixed-CDF cutoffs no longer apply unchanged. Use a suitable correction or bootstrap that refits every simulated sample."@en ; cd:authoredResource true .
  ex:l5-g19e-discrete a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Ties or discrete data"@en ; cd:body "Binomial counts, rounding, censoring and grouping change calibration. Do not reuse the continuous-null cutoff without justification."@en ; cd:authoredResource true .
  ex:l5-g19e-sampling a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Dependence or selection"@en ; cd:body "The standard result assumes iid sampling. Drift, dependence and selective data removal require a different analysis."@en ; cd:authoredResource true .
  ex:l5-g19e-interpretation a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Not rejected is not verified"@en ; cd:body "A small sample can miss important departures. KS is not especially tail-sensitive and does not prove independence, accuracy or model truth."@en ; cd:authoredResource true .
  ex:l5-g19-protocol a cd:WorkedExample ; cd:bodyFormat "markdown" ; cd:body """A new constructed five-reading sample, distinct from S15, has concentrations 9.4, 9.8, 10.0, 10.2 and 10.6 mg/L. For this hypothetical one-sample two-sided test, prescribe a normal CDF with mean 10 mg/L and SD 0.50 mg/L before seeing the sample, with iid sampling and significance level 0.05. Neither parameter is estimated from these five readings. Their matching sample mean is a coincidence of construction, not fitting; sample SD is about 0.447214 mg/L, not the specified population SD.

Compute normal CDF as 0.5*(1+erf((x-10)/(0.50*sqrt(2)))). Model values at the sorted readings are 0.11506967022170844, 0.3445782583896764, 0.5, 0.6554217416103236 and 0.8849303297782916. Empirical right values are 0.2, 0.4, 0.6, 0.8 and 1; left limits are 0, 0.2, 0.4, 0.6 and 0.8. Compare both jump sides, not just absolute differences after each jump or a finite display grid. Upward maximum is at 10.2 mg/L and downward maximum at 9.8 mg/L, both 0.1445782583896764 to floating precision.

The exact n=5 continuous-null two-sided 5% cutoff is 0.5632751983660635, not the asymptotic 1.36/sqrt(n) approximation. For distances d greater than one half, the two one-sided crossing events are disjoint. The exact two-sided survival probability is twice the one-sided Smirnov tail: 2*d times the sum over integer k=0 through floor(n*(1-d)) of choose(n,k)*(d+k/n)^(k-1)*(1-d-k/n)^(n-k). Solving this finite expression for tail 0.05 yields the authored cutoff. This identity is used only for calibration at that cutoff, not for a p value at the smaller observed D.

```python
import math
def exact_large_distance_tail(d, n=5):
    if not 0.5 < d < 1:
        raise ValueError("This exact two-sided shortcut requires d above one half")
    return 2*d*sum(math.comb(n,k)*(d+k/n)**(k-1)*(1-d-k/n)**(n-k)
                   for k in range(math.floor(n*(1-d))+1))
lo, hi = 0.500000000001, 0.999999999999
for _ in range(70):
    mid = (lo+hi)/2
    if exact_large_distance_tail(mid) > 0.05:
        lo = mid
    else:
        hi = mid
```

The observed D is below the cutoff: do not reject this prespecified model at 5%. This neither estimates a probability that the null is true nor verifies normality from five values. No p value is claimed. Normal CDF coordinates are theoretical samples joined linearly for drawing; test calculations use analytic values, not the drawing. ECDF coordinates use a right-continuous step renderer. Separate ECDF/model figures retain identical axes because interpolation is a chart-level shared capability; do not apply step interpolation to the smooth model or linear interpolation to the ECDF. The display window is 9 to 11 mg/L, not the normal support. Gap-chart lines merely join five computed discrepancies; they are not CDFs or observations. For parameters estimated from these data, use appropriately calibrated procedures, such as an applicable Lilliefors correction or a parametric bootstrap with re-estimation in every replicate. Discrete, rounded, censored and dependent cases require their own justification."""@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:forTopic ex:l5-kolmogorov-smirnov ; cd:hasStep ex:l5-g19a-step, ex:l5-g19b-step, ex:l5-g19c-step, ex:l5-g19d-step, ex:l5-g19e-step .
  ex:l5-g19a-step a cd:PathStep ; cd:position 59 ; cd:usesScene ex:l5-g19a-scene ; cd:usesResource ex:l5-g19a-title, ex:l5-g19a-chart, ex:l5-g19a-formula ; cd:authoredResource true .
  ex:l5-g19b-step a cd:PathStep ; cd:position 60 ; cd:usesScene ex:l5-g19b-scene ; cd:usesResource ex:l5-g19b-title, ex:l5-g19b-chart, ex:l5-g19b-formula ; cd:authoredResource true .
  ex:l5-g19c-step a cd:PathStep ; cd:position 61 ; cd:usesScene ex:l5-g19c-scene ; cd:usesResource ex:l5-g19c-title, ex:l5-g19c-chart, ex:l5-g19c-formula ; cd:authoredResource true .
  ex:l5-g19d-step a cd:PathStep ; cd:position 62 ; cd:usesScene ex:l5-g19d-scene ; cd:usesResource ex:l5-g19d-title, ex:l5-g19d-cards ; cd:authoredResource true .
  ex:l5-g19e-step a cd:PathStep ; cd:position 63 ; cd:usesScene ex:l5-g19e-scene ; cd:usesResource ex:l5-g19e-title, ex:l5-g19e-cards ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-ks> {
  ex:l5-g19a-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; cd:hasSceneItem ex:l5-g19a-heading, ex:l5-g19a-plot, ex:l5-g19a-math ; cd:narration "Our estimate and uncertainty rely on assumptions. Model checking is one supporting task, distinct from validating representative environmental selection. For a separate constructed illustration use concentrations 9.4, 9.8, 10.0, 10.2 and 10.6 mg/L, not the earlier environmental sample or laboratory repeats. Their empirical CDF is the fraction at or below a threshold. It is zero below the first value, increases by one fifth at each distinct value, and is one beyond the largest. Filled points include each jump; open points show left limits. At 9.8 mg/L the fraction is 0.4 and the left limit 0.2. No histogram bins or fitted density are needed. The empirical steps do not imply a discrete population. Keep the 9 to 11 mg/L and zero-to-one axes for the next slide, which compares this evidence with a prespecified model. Even a good comparison cannot establish representativeness."@en ; cd:authoredResource true .
  ex:l5-g19b-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; cd:hasSceneItem ex:l5-g19b-heading, ex:l5-g19b-plot, ex:l5-g19b-math ; cd:narration "G19b. Specify the null model before the data: a normal population with mean 10 mg/L and SD 0.50 mg/L. The null hypothesis is that iid observations follow this complete CDF; the alternative is a departure somewhere in that CDF. The parameters are fixed, not estimated from the five observations. Use the same axes as the empirical CDF. The smooth theoretical CDF has tails outside the window and is not forced to zero or one at the display boundaries. The two-sided one-sample KS statistic is the largest absolute vertical separation over all real thresholds. It compares cumulative probabilities, not density heights or horizontal concentration differences. The separate plots avoid applying empirical step interpolation to the smooth model. Calculation uses the analytic model CDF, not a plotting grid or the approximate line segments."@en ; cd:authoredResource true .
  ex:l5-g19c-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; cd:hasSceneItem ex:l5-g19c-heading, ex:l5-g19c-plot, ex:l5-g19c-math ; cd:narration "Check both sides of each empirical jump to quantify model discrepancy, not error of the environmental mean estimate. Model CDF values at the five sorted concentrations are approximately 0.115070, 0.344578, 0.500000, 0.655422 and 0.884930. Empirical right values are 0.2, 0.4, 0.6, 0.8 and 1; left limits zero, 0.2, 0.4, 0.6 and 0.8. Solid gaps are empirical right minus model; dashed gaps are model minus empirical left. Both directional maxima are about 0.144578, at 10.2 and 9.8 mg/L respectively. Their larger value is the two-sided D. Superscripts label directions, not powers. The plot joins computed gaps, not raw concentrations or another CDF. Checking only the included side can miss the largest discrepancy; the formula examines all ranks on both sides. Next calibrate that distance under the specified continuous null."@en ; cd:authoredResource true .
  ex:l5-g19d-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; cd:hasSceneItem ex:l5-g19d-heading, ex:l5-g19d-list ; cd:narration "G19d. A discrepancy needs calibration. Prespecify a five percent significance level for this two-sided one-sample test. For five iid observations from a fully specified continuous null CDF, the exact finite-sample KS critical distance is about 0.563275. Reject only when observed D exceeds it. The observed distance, about 0.144578, is below that cutoff, so do not reject this fixed normal model at five percent. The cutoff controls the probability of rejecting a true fully specified model under the iid assumptions; it is not a probability that this model is true. The large cutoff illustrates limited discrimination with only five observations. It does not verify normality, physical sampling independence or measurement accuracy. We use an exact finite-sample critical value, not the large-sample 1.36 divided by square root of size approximation. No observed p value is reported. The authored finite-sum protocol reproduces the cutoff without using the plotting grid."@en ; cd:authoredResource true .
  ex:l5-g19e-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-kolmogorov-smirnov ; cd:hasSceneItem ex:l5-g19e-heading, ex:l5-g19e-list ; cd:narration "G19e. The classical distribution-free KS calibration requires iid sampling and a completely specified continuous null CDF. If the normal mean and SD are estimated from these same data, the reference follows the sample and classical fixed-CDF cutoffs are no longer valid unchanged. An applicable Lilliefors procedure or a properly designed parametric bootstrap can address a fitted normal model; every bootstrap replicate must repeat the parameter fitting and the same statistic calculation. Other fitted families need their own calibration. Discrete counts, measurement rounding with ties, grouping and censoring require procedures matching the observation process. Dependence, drift and selection of observations also break the simple iid reference. KS generally places less emphasis on tail departures than dedicated tail-sensitive procedures. Failure to reject with five observations does not establish the model or rule out important departures. It also does not certify environmental representativeness, calibration accuracy or independence. Pearson's chi-square comparison of observed and expected category counts is the next separate addition, not silently substituted for the KS statistic here."@en ; cd:authoredResource true .
  ex:l5-g19a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-g19a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19a-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-g19a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19a-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-g19a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-g19b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19b-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-g19b-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19b-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-g19b-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19c-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-g19c-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-g19c-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-g19c-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
