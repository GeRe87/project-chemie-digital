  ex:cv-mean-proof a cd:MathematicalDerivation ; skos:prefLabel "Variance of the sample mean: full derivation"@en ; cd:inputFormula ex:cv-mean-definition ; cd:resultFormula ex:bf-var3 ; cd:hasDerivationStep ex:cv-m1, ex:cv-m2, ex:cv-m3, ex:cv-m4, ex:cv-m5, ex:cv-m6, ex:cv-m7, ex:cv-m8, ex:cv-m9 ; cd:authoredResource true .
  ex:cv-m1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Apply expectation to the mean's defining equality"@en ; cd:fromFormula ex:cv-mean-definition ; cd:toFormula ex:bf-mean-e0 ; cd:appliesRule ex:rule-expectation-equality ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex1 ; cd:authoredResource true .
  ex:cv-m2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Distribute E over the finite average"@en ; cd:fromFormula ex:bf-mean-e0 ; cd:toFormula ex:bf-mean-e1 ; cd:appliesRule ex:rule-expectation-finite-average ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:bf-mean-ex1 ; cd:authoredResource true .
  ex:cv-m3 a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Insert the common expectation μ"@en ; cd:fromFormula ex:bf-mean-e1 ; cd:toFormula ex:bf-mean-e2 ; cd:appliesRule ex:rule-common-moments ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:bf-mean-ex2 ; cd:authoredResource true .
  ex:cv-m4 a cd:DerivationStep ; cd:position 4 ; skos:prefLabel "Use the general variance definition for the sample mean"@en ; cd:fromFormula ex:bf-mean-e2 ; cd:toFormula ex:cv-mean-general-variance ; cd:appliesRule ex:rule-variance-definition ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex4 ; cd:authoredResource true .
  ex:cv-m5 a cd:DerivationStep ; cd:position 5 ; skos:prefLabel "Replace E[X̄] by the established μ"@en ; cd:fromFormula ex:cv-mean-general-variance ; cd:toFormula ex:cv-mean-centered-variance ; cd:appliesRule ex:rule-substitute-equality ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex5 ; cd:authoredResource true .
  ex:cv-m6 a cd:DerivationStep ; cd:position 6 ; skos:prefLabel "Evaluate variance using the mean's defining average"@en ; cd:fromFormula ex:cv-mean-centered-variance ; cd:toFormula ex:bf-var0 ; cd:appliesRule ex:rule-mean-definition ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex6 ; cd:authoredResource true .
  ex:cv-m7 a cd:DerivationStep ; cd:position 7 ; skos:prefLabel "Square the scale factor 1/n"@en ; cd:fromFormula ex:bf-var0 ; cd:toFormula ex:bf-var1 ; cd:appliesRule ex:rule-variance-scaling ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:bf-var-ex1 ; cd:authoredResource true .
  ex:cv-m8 a cd:DerivationStep ; cd:position 8 ; skos:prefLabel "Add variances because cross covariances are zero"@en ; cd:fromFormula ex:bf-var1 ; cd:toFormula ex:bf-var2 ; cd:appliesRule ex:rule-variance-uncorrelated-sum ; cd:requiresAssumption ex:assumption-common-observation-moments, ex:assumption-pairwise-uncorrelated ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex8 ; cd:authoredResource true .
  ex:cv-m9 a cd:DerivationStep ; cd:position 9 ; skos:prefLabel "Insert n equal finite variances and simplify"@en ; cd:fromFormula ex:bf-var2 ; cd:toFormula ex:bf-var3 ; cd:appliesRule ex:rule-common-moments ; cd:requiresAssumption ex:assumption-common-observation-moments, ex:assumption-pairwise-uncorrelated ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-mex9 ; cd:authoredResource true .
  ex:cv-mex1 a cd:Interpretation ; cd:body "Start from the random sample mean, a fixed-size average of the Xᵢ. Equal integrable random quantities have equal expectations. Independence is not needed for this operation."@en ; cd:applicationFormula ex:bf-mean-e0 ; cd:authoredResource true .
  ex:cv-mex4 a cd:Interpretation ; cd:body "After determining E[X̄], define the variance of that random mean by its expected squared deviation from E[X̄]. Finite second moments make this definition applicable."@en ; cd:applicationFormula ex:cv-mean-general-variance ; cd:authoredResource true .
  ex:cv-mex5 a cd:Interpretation ; cd:body "The preceding expectation calculation established E[X̄] = μ under common expectations. Substitute μ in the centering term. We did not estimate or observe the unknown population mean through this symbolic calculation."@en ; cd:applicationFormula ex:cv-mean-centered-variance ; cd:authoredResource true .
  ex:cv-mex6 a cd:Interpretation ; cd:body "The mean is the finite sum divided by n. Substitute that definition inside Var to evaluate the variance of the sum using the previously introduced rules. The preceding centered-square expression explains why this variance is the expected squared mean error."@en ; cd:applicationFormula ex:bf-var0 ; cd:authoredResource true .
  ex:cv-mex8 a cd:Interpretation ; cd:body "The general variance of a sum includes pairwise covariance terms. They vanish for pairwise uncorrelated observations. Independent, identically distributed finite-variance observations are sufficient, but the weaker common-moment and zero-covariance conditions already prove this result."@en ; cd:applicationFormula ex:bf-var2 ; cd:authoredResource true .
  ex:cv-mex9 a cd:Interpretation ; cd:body "Each observation has variance σ², so the sum is nσ². The squared divisor is n². Therefore Var(X̄) = nσ²/n² = σ²/n. No normality assumption is used. For correlated observations additional covariance terms would remain."@en ; cd:applicationFormula ex:bf-var3 ; cd:authoredResource true .
  ex:cv-ms1 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m1 ; cd:lastDerivationStep ex:cv-m1 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms2 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m2 ; cd:lastDerivationStep ex:cv-m2 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms3 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m3 ; cd:lastDerivationStep ex:cv-m3 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms4 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m4 ; cd:lastDerivationStep ex:cv-m4 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms5 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m5 ; cd:lastDerivationStep ex:cv-m5 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms6 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m6 ; cd:lastDerivationStep ex:cv-m6 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms7 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m7 ; cd:lastDerivationStep ex:cv-m7 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms8 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m8 ; cd:lastDerivationStep ex:cv-m8 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-ms9 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-mean-proof ; cd:firstDerivationStep ex:cv-m9 ; cd:lastDerivationStep ex:cv-m9 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .

  ex:cv-expected-expanded a cd:MathExpression ; cd:formulaLabel "Apply E using linearity of a finite average"@en ; cd:latex "\\begin{aligned}\\operatorname{E}[\\mathrm{MSD}_n]&=\\frac1n\\sum_i\\operatorname{E}[(X_i-\\mu)^2]\\\\&\\quad-\\operatorname{E}[(\\bar X-\\mu)^2]\\end{aligned}" ; cd:hasSymbol ex:vr-E-symbol, ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:mu-symbol, ex:vr-Xbar-symbol ; dct:source ex:cv-identity, ex:rule-expectation-finite-average ; cd:authoredResource true .
  ex:cv-expected-result a cd:MathExpression ; cd:formulaLabel "Only the variance of the fitted mean remains"@en ; cd:latex "\\operatorname{E}[\\mathrm{MSD}_n]=\\sigma^2-\\operatorname{Var}(\\bar X)" ; cd:hasSymbol ex:vr-E-symbol, ex:bf-msd-symbol, ex:vr-sigma2-symbol, ex:vm-var-symbol, ex:vr-Xbar-symbol ; cd:authoredResource true .
  ex:cv-expected-application a cd:MathExpression ; cd:latex "\\begin{gathered}\\operatorname{E}[(X_i-\\mu)^2]=\\sigma^2\\\\\\operatorname{E}[(\\bar X-\\mu)^2]=\\operatorname{Var}(\\bar X)\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:vr-X-symbol, ex:mu-symbol, ex:vr-sigma2-symbol, ex:vr-Xbar-symbol, ex:vm-var-symbol ; cd:authoredResource true .
  ex:cv-expectation a cd:MathematicalDerivation ; skos:prefLabel "Average the MSD identity and recognize variance"@en ; cd:inputFormula ex:cv-expected-expanded ; cd:resultFormula ex:cv-expected-result ; cd:hasDerivationStep ex:cv-e-step ; cd:authoredResource true .
  ex:cv-e-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Recognize expected centered squares as variances"@en ; cd:fromFormula ex:cv-expected-expanded ; cd:toFormula ex:cv-expected-result ; cd:appliesRule ex:rule-variance-definition ; cd:requiresAssumption ex:assumption-common-observation-moments ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-e-ex ; cd:authoredResource true .
  ex:cv-e-ex a cd:Interpretation ; cd:body "Linearity gives the displayed expectation of the finite squared-distance average; it needs no independence. Each population-centered squared observation has expectation σ². The sample mean has expectation μ under the common-mean condition, so its expected squared shift is Var(X̄). The arithmetic average of n copies of σ² is σ². The complete sample-mean argument is available with the next result."@en ; cd:applicationFormula ex:cv-expected-application ; dct:source ex:cv-mean-proof, ex:rule-expectation-finite-average ; cd:authoredResource true .
  ex:cv-expectation-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-expectation ; cd:firstDerivationStep ex:cv-e-step ; cd:lastDerivationStep ex:cv-e-step ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .

  ex:cv-corrected a cd:MathExpression ; cd:formulaLabel "Correct the systematic bias from fitting the same sample mean"@en ; cd:latex "\\begin{gathered}S^2:=\\frac{n}{n-1}\\mathrm{MSD}_n\\\\\\boxed{\\operatorname{E}[S^2]=\\sigma^2}\\end{gathered}" ; cd:hasSymbol ex:random-sample-variance-symbol, ex:n-symbol, ex:bf-msd-symbol, ex:vr-E-symbol, ex:vr-sigma2-symbol ; cd:authoredResource true .
  ex:cv-correction-application a cd:MathExpression ; cd:latex "\\operatorname{E}[S^2]=\\frac{n}{n-1}\\operatorname{E}[\\mathrm{MSD}_n]=\\frac{n}{n-1}\\frac{n-1}{n}\\sigma^2=\\sigma^2" ; cd:hasSymbol ex:random-sample-variance-symbol, ex:n-symbol, ex:bf-msd-symbol, ex:vr-E-symbol, ex:vr-sigma2-symbol ; cd:authoredResource true .
  ex:cv-correction a cd:MathematicalDerivation ; skos:prefLabel "Bessel's correction"@en ; cd:inputFormula ex:bf-e-bias ; cd:resultFormula ex:cv-corrected ; cd:hasDerivationStep ex:cv-c-step ; cd:authoredResource true .
  ex:cv-c-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Multiply by the reciprocal bias factor, for n > 1"@en ; cd:fromFormula ex:bf-e-bias ; cd:toFormula ex:cv-corrected ; cd:appliesRule ex:rule-expectation-factor ; cd:requiresAssumption ex:assumption-common-observation-moments, ex:assumption-pairwise-uncorrelated, ex:assumption-n-more-one ; cd:transformationKind cd:StatisticalTransformation ; cd:hasExplanation ex:cv-c-ex ; cd:authoredResource true .
  ex:cv-c-ex a cd:Interpretation ; cd:body "Define the random statistic S² by multiplying MSDₙ by the fixed reciprocal n/(n−1). Linearity moves that coefficient outside E and the factors cancel. S² is unbiased under the stated assumptions. Its observed value s² is not generally exactly σ², and the square root is not automatically unbiased."@en ; cd:applicationFormula ex:cv-correction-application ; cd:authoredResource true .
  ex:cv-correction-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-correction ; cd:firstDerivationStep ex:cv-c-step ; cd:lastDerivationStep ex:cv-c-step ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
}
