  ex:cv-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Sample, population and general rule symbols"@en ; cd:body "Lowercase values describe one observed sample. Uppercase quantities vary across hypothetical samples. General rule placeholders are explained with each operation."@en ; dct:references ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol, ex:vr-sigma2-symbol, ex:bf-msd-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol, ex:vr-E-symbol, ex:vm-var-symbol, ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol, ex:rule-abar-symbol, ex:rule-U-symbol, ex:rule-V-symbol, ex:rule-Y-symbol, ex:rule-indexed-Y-symbol, ex:rule-m-symbol, ex:rule-v-symbol, ex:xi-symbol, ex:xbar-symbol, ex:vr-s2-symbol, ex:random-sample-variance-symbol ; cd:authoredResource true .
  ex:md-sum-zero cd:hasDerivationDetail ex:derivation-residual-zero .

  ex:cv-difference a cd:MathExpression ; cd:formulaLabel "Compare the fitted center with the population center"@en ; cd:latex "X_i-\\bar X=(X_i-\\mu)-(\\bar X-\\mu)" ; cd:hasSymbol ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol ; cd:authoredResource true .
  ex:cv-square a cd:MathExpression ; cd:latex "\\begin{aligned}(X_i-\\bar X)^2&=(X_i-\\mu)^2\\\\&\\quad-2(X_i-\\mu)(\\bar X-\\mu)\\\\&\\quad+(\\bar X-\\mu)^2\\end{aligned}" ; cd:hasSymbol ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol ; cd:authoredResource true .
  ex:cv-summed a cd:MathExpression ; cd:latex "\\begin{aligned}\\frac1n\\sum_i(X_i-\\bar X)^2&=\\frac1n\\sum_i(X_i-\\mu)^2\\\\&\\quad-\\frac2n(\\bar X-\\mu)\\sum_i(X_i-\\mu)\\\\&\\quad+(\\bar X-\\mu)^2\\end{aligned}" ; cd:hasSymbol ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol ; cd:authoredResource true .
  ex:cv-collected a cd:MathExpression ; cd:latex "\\begin{aligned}\\frac1n\\sum_i(X_i-\\bar X)^2&=\\frac1n\\sum_i(X_i-\\mu)^2\\\\&\\quad-2(\\bar X-\\mu)^2+(\\bar X-\\mu)^2\\end{aligned}" ; cd:hasSymbol ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol ; cd:authoredResource true .
  ex:cv-identity a cd:MathExpression ; cd:formulaLabel "Fitting the mean removes a nonnegative squared shift"@en ; cd:latex "\\boxed{\\begin{aligned}\\mathrm{MSD}_n&=\\frac1n\\sum_{i=1}^n(X_i-\\mu)^2\\\\&\\quad-(\\bar X-\\mu)^2\\end{aligned}}" ; cd:hasSymbol ex:bf-msd-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-index-symbol, ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:mu-symbol ; cd:hasDerivationDetail ex:cv-algebra-proof ; cd:authoredResource true .
  ex:cv-algebra-proof a cd:MathematicalDerivation ; skos:prefLabel "Full algebra: why fitting the mean removes a squared shift"@en ; cd:inputFormula ex:cv-difference ; cd:resultFormula ex:cv-identity ; cd:hasDerivationStep ex:cv-alg1, ex:cv-alg2, ex:cv-alg3, ex:cv-alg4 ; cd:authoredResource true .
  ex:cv-alg1 a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Square the centered difference and expand"@en ; cd:fromFormula ex:cv-difference ; cd:toFormula ex:cv-square ; cd:appliesRule ex:rule-binomial-square ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:cv-alg-ex1 ; cd:authoredResource true .
  ex:cv-alg2 a cd:DerivationStep ; cd:position 2 ; skos:prefLabel "Sum, divide by n and factor index-independent terms"@en ; cd:fromFormula ex:cv-square ; cd:toFormula ex:cv-summed ; cd:appliesRule ex:rule-sum-three-terms ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:cv-alg-ex2 ; cd:authoredResource true .
  ex:cv-alg3 a cd:DerivationStep ; cd:position 3 ; skos:prefLabel "Insert the sum of population-centered distances"@en ; cd:fromFormula ex:cv-summed ; cd:toFormula ex:cv-collected ; cd:appliesRule ex:rule-fixed-center-sum ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:cv-alg-ex3 ; cd:authoredResource true .
  ex:cv-alg4 a cd:DerivationStep ; cd:position 4 ; skos:prefLabel "Combine the squared shifts and identify the MSD"@en ; cd:fromFormula ex:cv-collected ; cd:toFormula ex:cv-identity ; cd:appliesRule ex:rule-mean-centered-squares ; cd:transformationKind cd:EquivalentTransformation ; cd:hasExplanation ex:cv-alg-ex4 ; cd:authoredResource true .
  ex:cv-alg-ex1 a cd:Interpretation ; cd:body "Use a = Xᵢ−μ and b = −(X̄−μ) in the binomial identity. Squaring an equality gives a consequence; we do not claim to recover all signs by reversing this step."@en ; cd:applicationFormula ex:cv-square ; cd:authoredResource true .
  ex:cv-alg-ex2 a cd:Interpretation ; cd:body "Distribute the finite sum over the three terms, then divide by the positive n. The same X̄−μ occurs at every index, so it factors out of the cross term. Its squared last term is added n times; the divisor n cancels that count. This is deterministic within each realization."@en ; cd:applicationFormula ex:cv-summed ; dct:source ex:rule-pull-sum-constant, ex:rule-sum-constant ; cd:authoredResource true .
  ex:cv-alg-ex3 a cd:Interpretation ; cd:body "Σ(Xᵢ−μ) = ΣXᵢ−nμ = n(X̄−μ), because X̄ is the mean of these same observations. Substitute that sum into the cross term: −(2/n)(X̄−μ)n(X̄−μ) = −2(X̄−μ)²."@en ; cd:applicationFormula ex:cv-collected ; cd:authoredResource true .
  ex:cv-alg-ex4 a cd:Interpretation ; cd:body "The coefficients of the shared squared shift are −2 and +1, leaving −1. The left side is the defining MSD about the fitted sample mean. The result is exact for every sample. It does not by itself prove the estimator's average bias."@en ; cd:applicationFormula ex:cv-identity ; cd:authoredResource true .
  ex:cv-algebra-s1 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-algebra-proof ; cd:firstDerivationStep ex:cv-alg1 ; cd:lastDerivationStep ex:cv-alg1 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-algebra-s2 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-algebra-proof ; cd:firstDerivationStep ex:cv-alg2 ; cd:lastDerivationStep ex:cv-alg2 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-algebra-s3 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-algebra-proof ; cd:firstDerivationStep ex:cv-alg3 ; cd:lastDerivationStep ex:cv-alg3 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .
  ex:cv-algebra-s4 a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-algebra-proof ; cd:firstDerivationStep ex:cv-alg4 ; cd:lastDerivationStep ex:cv-alg4 ; cd:usesLegend ex:cv-legend ; cd:authoredResource true .

  ex:cv-main-algebra a cd:MathematicalDerivation ; skos:prefLabel "Find the source of the MSD shortfall"@en ; cd:inputFormula ex:cv-difference ; cd:resultFormula ex:cv-identity ; cd:hasDerivationStep ex:cv-main-algebra-step ; cd:authoredResource true .
  ex:cv-main-algebra-step a cd:DerivationStep ; cd:position 1 ; skos:prefLabel "Square, sum and collect the centered terms"@en ; cd:fromFormula ex:cv-difference ; cd:toFormula ex:cv-identity ; cd:appliesRule ex:rule-mean-centered-squares ; cd:transformationKind cd:ImpliedTransformation ; cd:hasExplanation ex:cv-main-algebra-ex ; cd:authoredResource true .
  ex:cv-main-algebra-ex a cd:Interpretation ; cd:body "Centering at the fitted arithmetic mean removes a nonnegative squared shift. The result is an exact identity, not an average statement. Open the full algebra detail for each expansion and summation operation. The population mean is ordinarily unknown; this identity explains the estimator, rather than giving a formula that requires knowing μ."@en ; cd:applicationFormula ex:cv-identity ; dct:source ex:cv-algebra-proof ; cd:authoredResource true .
  ex:cv-main-algebra-section a cd:MathematicalDerivationSection ; cd:partOfDerivation ex:cv-main-algebra ; cd:firstDerivationStep ex:cv-main-algebra-step ; cd:lastDerivationStep ex:cv-main-algebra-step ; cd:usesLegend ex:cv-legend ; cd:hasDerivationDetail ex:cv-algebra-proof ; cd:authoredResource true .

  ex:cv-mean-definition a cd:MathExpression ; cd:latex "\\bar X=\\frac1n\\sum_{i=1}^nX_i" ; cd:hasSymbol ex:vr-Xbar-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol, ex:vr-X-symbol ; cd:authoredResource true .
  ex:cv-mean-general-variance a cd:MathExpression ; cd:latex "\\operatorname{Var}(\\bar X)=\\operatorname{E}[(\\bar X-\\operatorname{E}[\\bar X])^2]" ; cd:hasSymbol ex:vm-var-symbol, ex:vr-Xbar-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:cv-mean-centered-variance a cd:MathExpression ; cd:latex "\\operatorname{Var}(\\bar X)=\\operatorname{E}[(\\bar X-\\mu)^2]" ; cd:hasSymbol ex:vm-var-symbol, ex:vr-Xbar-symbol, ex:vr-E-symbol, ex:mu-symbol ; cd:authoredResource true .
  ex:cv-mean-result a cd:MathExpression ; cd:formulaLabel "Variance of the sample mean"@en ; cd:latex "\\boxed{\\operatorname{Var}(\\bar X)=\\frac{\\sigma^2}{n}}" ; cd:hasSymbol ex:vm-var-symbol, ex:vr-Xbar-symbol, ex:vr-sigma2-symbol, ex:n-symbol ; cd:hasDerivationDetail ex:cv-mean-proof ; dct:source ex:bf-var3 ; dct:hasPart ex:cv-mean-legend ; cd:authoredResource true .
