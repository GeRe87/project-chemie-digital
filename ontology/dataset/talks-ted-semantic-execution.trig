  ex:ted-sem-markers a cd:DiagramNode ; cd:position 4 ; skos:prefLabel "Select markers"@en ; cd:body "ProcessingStep\nIN: components\nOUT: marker areas"@en ; cd:visualMotif "marker-selection" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-polymer-markers ; cd:authoredResource true .
  ex:ted-sem-calibrate a cd:DiagramNode ; cd:position 5 ; skos:prefLabel "Calibrate"@en ; cd:body "ProcessingStep\nIN: marker areas\nOUT: polymer content"@en ; cd:visualMotif "regression" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-running-calibration ; cd:authoredResource true .
