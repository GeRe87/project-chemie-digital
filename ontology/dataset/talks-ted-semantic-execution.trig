  ex:ted-sem-connect2 a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:ted-sem-peaks ; cd:targetNode ex:ted-sem-components ; skos:prefLabel "features"@en ; cd:authoredResource true .
  ex:ted-sem-connect3 a cd:DiagramEdge ; cd:position 3 ; cd:sourceNode ex:ted-sem-components ; cd:targetNode ex:ted-sem-markers ; skos:prefLabel "components"@en ; cd:authoredResource true .
  ex:ted-sem-connect4 a cd:DiagramEdge ; cd:position 4 ; cd:sourceNode ex:ted-sem-markers ; cd:targetNode ex:ted-sem-calibrate ; skos:prefLabel "marker areas"@en ; cd:authoredResource true .

  ex:ted-automatic-execution-flow a cd:NetworkDiagram ; skos:prefLabel "Event-driven execution and completed-report storage"@en ; cd:body "The pipeline is the execution schema followed by the engine, not another processing service. A completed measurement and saved file produce a ready event. The handler starts the engine; when the report is ready, it registers completion and initiates storage in the data server. This proposed complete automation system is still under development, not yet available and not a live integration."@en ; cd:focusNode ex:ted-auto-engine ; cd:hasDiagramNode ex:ted-auto-events, ex:ted-auto-engine, ex:ted-auto-run, ex:ted-auto-instrument, ex:ted-auto-pipeline, ex:ted-auto-data-server ; cd:hasDiagramEdge ex:ted-auto-trigger, ex:ted-auto-execute, ex:ted-auto-ready-edge, ex:ted-auto-definition-edge, ex:ted-auto-feedback, ex:ted-auto-store ; cd:hasSource ex:ted-source-semantic-execution ; cd:authoredResource true .
  ex:ted-auto-events a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Event handler"@en ; cd:body "Registers ready events\nTriggers run or storage"@en ; cd:visualRole "control" ; cd:visualMotif "event-handler" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-event-execution ; cd:authoredResource true .
  ex:ted-auto-engine a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Execution engine"@en ; cd:body "Follows the pipeline\nRuns configured tools"@en ; cd:visualRole "process" ; cd:visualMotif "execution-engine" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-event-execution ; cd:authoredResource true .
  ex:ted-auto-run a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Reports"@en ; cd:body "Results + provenance\nReport completed"@en ; cd:visualRole "output" ; cd:visualMotif "workflow-results" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-semantic-pipeline ; cd:authoredResource true .
  ex:ted-auto-instrument a cd:DiagramNode ; cd:position 4 ; skos:prefLabel "Measurement data"@en ; cd:body "Measurement done\nFile saved"@en ; cd:visualRole "input" ; cd:visualMotif "measurement-ready" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ted-auto-pipeline a cd:DiagramNode ; cd:position 5 ; skos:prefLabel "Pipeline schema"@en ; cd:body "Defines the steps\nand connections"@en ; cd:visualRole "specification" ; cd:visualMotif "processing-composition" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ted-auto-data-server a cd:DiagramNode ; cd:position 6 ; skos:prefLabel "Data server"@en ; cd:body "Completed reports\nLinked provenance"@en ; cd:visualRole "storage" ; cd:visualMotif "data-server" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ted-auto-ready-edge a cd:DiagramEdge ; cd:position 3 ; cd:sourceNode ex:ted-auto-instrument ; cd:targetNode ex:ted-auto-events ; skos:prefLabel "ready"@en ; cd:authoredResource true .
  ex:ted-auto-definition-edge a cd:DiagramEdge ; cd:position 4 ; cd:sourceNode ex:ted-auto-pipeline ; cd:targetNode ex:ted-auto-engine ; skos:prefLabel "schema"@en ; cd:visualRole "reference" ; cd:authoredResource true .
  ex:ted-auto-feedback a cd:DiagramEdge ; cd:position 5 ; cd:sourceNode ex:ted-auto-run ; cd:targetNode ex:ted-auto-events ; skos:prefLabel "report ready"@en ; cd:authoredResource true .
  ex:ted-auto-store a cd:DiagramEdge ; cd:position 6 ; cd:sourceNode ex:ted-auto-events ; cd:targetNode ex:ted-auto-data-server ; skos:prefLabel "store report"@en ; cd:authoredResource true .
  ex:ted-auto-completed a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Measurement completed"@en ; cd:body "Acquisition has ended"@en ; cd:authoredResource true .
  ex:ted-auto-saved a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "File fully saved"@en ; cd:body "Confirm data are available\nDo not process a partial file"@en ; cd:authoredResource true .
  ex:ted-auto-ready a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Ready event"@en ; cd:body "Identify measurement + file\nTrigger the configured workflow"@en ; cd:authoredResource true .
  ex:ted-auto-definition a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Read the pipeline"@en ; cd:body "Standardized description\nSteps, ports and connections"@en ; cd:authoredResource true .
  ex:ted-auto-bindings a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "Check and resolve"@en ; cd:body "Validate declared interfaces\nResolve configured implementations"@en ; cd:authoredResource true .
  ex:ted-auto-start a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Start the run"@en ; cd:body "Use the selected revision\nApply explicit parameters"@en ; cd:authoredResource true .
  ex:ted-auto-steps a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Execute bound steps"@en ; cd:body "Import → peaks → components\nSelect markers → calibrate"@en ; cd:authoredResource true .
  ex:ted-auto-results a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "Publish results"@en ; cd:body "Identified output artifacts\nPolymer-content results"@en ; cd:authoredResource true .
  ex:ted-auto-provenance a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Record provenance"@en ; cd:body "Input, pipeline and run IDs\nParameters + software versions"@en ; cd:authoredResource true .
