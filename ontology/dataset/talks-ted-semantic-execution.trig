  ex:ted-sem-connect3 a cd:DiagramEdge ; cd:position 3 ; cd:sourceNode ex:ted-sem-components ; cd:targetNode ex:ted-sem-markers ; skos:prefLabel "components"@en ; cd:authoredResource true .
  ex:ted-sem-connect4 a cd:DiagramEdge ; cd:position 4 ; cd:sourceNode ex:ted-sem-markers ; cd:targetNode ex:ted-sem-calibrate ; skos:prefLabel "marker areas"@en ; cd:authoredResource true .

  ex:ted-automatic-execution-flow a cd:FlowDiagram ; skos:prefLabel "Event server, execution engine and pipeline run"@en ; cd:body "Control path: a completed measurement and fully saved file produce a ready event. The engine loads the standardized pipeline and executes its configured steps. This schematic is not a live deployment demonstration."@en ; cd:hasDiagramNode ex:ted-auto-events, ex:ted-auto-engine, ex:ted-auto-run ; cd:hasDiagramEdge ex:ted-auto-trigger, ex:ted-auto-execute ; cd:hasSource ex:ted-source-semantic-execution ; cd:authoredResource true .
  ex:ted-auto-events a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Event server"@en ; cd:body "Measurement ended\nFile fully saved → ready event"@en ; cd:visualMotif "event-server" ; cd:visualMotifRole "highlight" ; dct:hasPart ex:ted-auto-completed, ex:ted-auto-saved, ex:ted-auto-ready ; dct:references ex:ted-event-execution ; cd:authoredResource true .
  ex:ted-auto-engine a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Execution engine"@en ; cd:body "Read pipeline + resolve steps\nStart the configured workflow"@en ; cd:visualMotif "execution-engine" ; cd:visualMotifRole "highlight" ; dct:hasPart ex:ted-auto-definition, ex:ted-auto-bindings, ex:ted-auto-start ; dct:references ex:ted-event-execution ; cd:authoredResource true .
  ex:ted-auto-run a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Pipeline execution"@en ; cd:body "Identified results\nRun + parameter provenance"@en ; cd:visualMotif "workflow-results" ; cd:visualMotifRole "highlight" ; dct:hasPart ex:ted-auto-steps, ex:ted-auto-results, ex:ted-auto-provenance ; dct:references ex:ted-semantic-pipeline ; cd:authoredResource true .
  ex:ted-auto-completed a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Measurement completed"@en ; cd:body "Acquisition has ended"@en ; cd:authoredResource true .
  ex:ted-auto-saved a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "File fully saved"@en ; cd:body "Confirm data are available\nDo not process a partial file"@en ; cd:authoredResource true .
  ex:ted-auto-ready a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Ready event"@en ; cd:body "Identify measurement + file\nTrigger the configured workflow"@en ; cd:authoredResource true .
  ex:ted-auto-definition a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Read the pipeline"@en ; cd:body "Standardized description\nSteps, ports and connections"@en ; cd:authoredResource true .
  ex:ted-auto-bindings a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "Check and resolve"@en ; cd:body "Validate declared interfaces\nResolve configured implementations"@en ; cd:authoredResource true .
  ex:ted-auto-start a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Start the run"@en ; cd:body "Use the selected revision\nApply explicit parameters"@en ; cd:authoredResource true .
  ex:ted-auto-steps a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "Execute bound steps"@en ; cd:body "Import → peaks → components\nSelect markers → calibrate"@en ; cd:authoredResource true .
  ex:ted-auto-results a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "Publish results"@en ; cd:body "Identified output artifacts\nPolymer-content results"@en ; cd:authoredResource true .
  ex:ted-auto-provenance a cd:DiagramNodePart ; cd:position 3 ; skos:prefLabel "Record provenance"@en ; cd:body "Input, pipeline and run IDs\nParameters + software versions"@en ; cd:authoredResource true .
  ex:ted-auto-trigger a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:ted-auto-events ; cd:targetNode ex:ted-auto-engine ; skos:prefLabel "trigger"@en ; cd:authoredResource true .
  ex:ted-auto-execute a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:ted-auto-engine ; cd:targetNode ex:ted-auto-run ; skos:prefLabel "execute"@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/paths/talk-microplastics-ted-gc-ms> {
  ex:path-talk-microplastics-ted-gc-ms cd:forTopic ex:ted-semantic-pipeline, ex:ted-event-execution ; cd:hasStep ex:ted-step-semantic-pipeline, ex:ted-step-automatic-execution .
  ex:ted-step-semantic-pipeline a cd:PathStep ; cd:position 20 ; cd:usesResource ex:ted-semantic-pipeline-flow ; cd:usesScene ex:ted-scene-semantic-pipeline ; cd:authoredResource true .
  ex:ted-step-automatic-execution a cd:PathStep ; cd:position 21 ; cd:usesResource ex:ted-automatic-execution-flow, ex:ted-automatic-run-points ; cd:usesScene ex:ted-scene-automatic-execution ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-semantic-execution> {
  ex:ted-scene-semantic-pipeline a cd:SceneDefinition ; cd:focusConcept ex:ted-semantic-pipeline ; cd:hasSceneItem ex:ted-semantic-pipeline-heading, ex:ted-semantic-pipeline-item ; cd:narration "Now apply the shared model to our TED data processing. Rather than hard-coding one tool around one fixed sequence, describe every task as a ProcessingStep with explicit inputs, outputs and parameters. Each step is a ProcessingUnit; their compatible connections form a composite ProcessingPipeline. The main data path is GQD files to EICs, features, components, marker areas and polymer-content results. Bind the actual implementations separately. qPeaks window sizes, fitting settings, marker definitions and calibration choices remain declared configuration. External calibration also needs the calibration data/model and sample metadata required for normalization. A provider can be changed only if its interface and scientific behavior satisfy the declared contract; this is not automatic interchangeability or FAIR compliance by syntax alone. This slide describes the workflow, it does not deploy a new pipeline."@en ; cd:authoredResource true .
  ex:ted-semantic-pipeline-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-semantic-pipeline ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-semantic-pipeline-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-semantic-pipeline-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-scene-automatic-execution a cd:SceneDefinition ; cd:focusConcept ex:ted-event-execution ; cd:hasSceneItem ex:ted-automatic-heading, ex:ted-automatic-item, ex:ted-automatic-bullets ; cd:narration "The standardized description is separate from execution. We have developed an engine that can start such a pipeline through its configured implementations. Couple it to an event manager/server and processing can start automatically after acquisition ends and the file is completely saved and available. The server emits a ready event identifying that measurement and file. The engine loads the chosen pipeline revision, checks its interface/configuration and resolves the implementations, then starts the connected steps. The run produces identified outputs and records input, pipeline, parameters and software-version provenance. A file-created event alone must not be treated as a completed measurement: readiness, access permissions, duplicate events, retries and failures need explicit handling in a real installation. The diagram explains the author-described capability and architecture, not a live integration or a guarantee of exactly-once execution. Event arrows trigger a run; output-to-input port connections inside the pipeline carry the processing data. This separation lets the same semantic pipeline be started manually or automatically without rewriting the scientific steps."@en ; cd:authoredResource true .
  ex:ted-automatic-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-event-execution ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-automatic-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-automatic-execution-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-automatic-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-automatic-run-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
