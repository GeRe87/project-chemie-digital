<https://w3id.org/project-chemie-digital/graph/specifications/level6-revision> {
 ex:l6r-t-section-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-t-comparisons.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A mean against a fixed reference, or two estimated means: schematic introduction to t-tests."@en ; cd:authoredResource true .
 ex:l6r-f-section-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-f-section.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two schematic measurement series on the same concentration scale have the same mean: method A is widely spread and method B is tightly clustered. The F-test section starts with a comparison of scatter, not means. Positions are illustrative, not the worked dataset."@en ; cd:authoredResource true .
 ex:l6r-hypothesis a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-h0, ex:l6r-h1 ; cd:authoredResource true .
 ex:l6r-h0 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "H₀: THE STARTING POPULATION CLAIM"@en ; cd:body "- A claim about a **population parameter**, e.g., the **mean amoxicillin concentration**.\n- **H₀** includes equality: equal, at or below, or at or above.\n- Calculate a **test statistic** from the observations to check **H₀**."@en ; cd:authoredResource true .
 ex:l6r-h1 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "H₁: THE COMPETING POPULATION CLAIM"@en ; cd:body "- **H₁** describes the competing claim: different, above or below.\n- Example: the **population mean** exceeds an analytical limit.\n- Rejection supports **H₁** under the stated sampling model."@en ; cd:authoredResource true .
 ex:l6r-tree-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-decision-trees.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A single decision tree starts at H₀: population mean at or below the reference. Positive means rejecting H₀ and claiming an exceedance; negative means not rejecting H₀. The true population state splits each decision into true positive, false positive (type I), false negative (type II) or true negative. Bottle and alarm thumbnails accompany the four outcomes."@en ; cd:authoredResource true .
 ex:l6r-lake-title a cd:Interpretation ; skos:prefLabel "Same lake, different burden of evidence"@en ; cd:authoredResource true .
 ex:l6r-lake-model a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-lake-a, ex:l6r-lake-b ; cd:authoredResource true .
 ex:l6r-lake-a a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "SAME MEASUREMENT MODEL"@en ; cd:body "- Hypothetical minimum: **10 cm**; four independent Normal readings.\n- Known population SD **0.5 cm**; standard error **0.25 cm**.\n- One-sided alpha **5%**: Normal cutoff **1.645 standard errors**. Add/subtract this margin from 10 cm."@en ; cd:authoredResource true .
 ex:l6r-lake-b a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "DIFFERENT GO THRESHOLDS"@en ; cd:body "- A: go only if the sample mean exceeds **10.411 cm**.\n- B: go unless the sample mean falls below **9.589 cm**.\n- These are decision probabilities, not physical collapse probabilities. Thickness-only model, not crossing advice."@en ; cd:authoredResource true .
 ex:l6r-t-section a cd:Interpretation ; skos:prefLabel "t-Tests"@en ; cd:authoredResource true .
 ex:l6r-f-section a cd:Interpretation ; skos:prefLabel "F-Tests"@en ; cd:authoredResource true .
 ex:l6r-recovery-title a cd:Interpretation ; skos:prefLabel "Can we demonstrate mean recovery above the 80% minimum?"@en ; cd:authoredResource true .
 ex:l6r-river-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-river-independent.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Independent upstream and downstream diclofenac samples around an industrial park; separate sites supply the two regions."@en ; dct:description "- **Separate sites**; **common variance** needs prior scientific justification."@en ; cd:authoredResource true .
 ex:l6r-reactor-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-batch-oxidation.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A stirred oxidation reactor is sampled before and at the end of treatment. Samples share a batch identity. Six independent batches supply six before-minus-end differences."@en ; dct:description "- Each independent batch supplies one linked before/end pair."@en ; cd:authoredResource true .
 ex:l6r-reactor-title a cd:Interpretation ; skos:prefLabel "Paired t-test: before and after batch oxidation"@en ; cd:authoredResource true .
 ex:l6r-instruments-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-nir-hplc.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "NIR sensor and HPLC-MS measure one pollutant in separate independent preparation sets from homogeneous reference material: five versus six preparations. Shared samples measured on both systems would instead require pairing."@en ; dct:description "- NIR: near-infrared sensing. HPLC-MS: liquid chromatography with mass spectrometry.\n- Separate preparation sets can have different variances."@en ; cd:authoredResource true .
 ex:l6r-welch-title a cd:Interpretation ; skos:prefLabel "Welch t-test: NIR sensor versus HPLC-MS"@en ; cd:authoredResource true .
 ex:l6r-practice-title a cd:Interpretation ; skos:prefLabel "No p-hacking: decide the question before collecting data"@en ; cd:authoredResource true .
 ex:l6r-practice a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-practice1, ex:l6r-practice2, ex:l6r-practice3, ex:l6r-practice4 ; cd:authoredResource true .
 ex:l6r-practice1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "1 · HYPOTHESIS"@en ; cd:body "Name the population claim, direction, endpoint and planned test-family."@en ; cd:authoredResource true .
 ex:l6r-practice2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "2 · EXPERIMENT"@en ; cd:body "Plan independent units, sampling, sample size and analysis before outcomes are known."@en ; cd:authoredResource true .
 ex:l6r-practice3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "3 · TEST"@en ; cd:body "Check assumptions and apply the prespecified procedure. Do not search tests until p is small."@en ; cd:authoredResource true .
 ex:l6r-practice4 a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "4 · CONCLUSION"@en ; cd:body "Report all planned results, effect and uncertainty. Label exploratory changes honestly."@en ; cd:authoredResource true .
 ex:l6r-multi-question a cd:Interpretation ; skos:prefLabel "One water sample, three claims: is the overall risk still 5%?"@en ; cd:authoredResource true .
 ex:l6r-multi-case a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-multi1, ex:l6r-multi2 ; cd:authoredResource true .
 ex:l6r-multi1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A PLANNED TEST-FAMILY"@en ; cd:body "- Replicate independent preparations from one water sample.\n- Three claims: mean **chloride**, **bromate** and **phosphate** each below its own illustrative limit.\n- For each: H₀ at or above its limit; H₁ below. Alpha **5% per test**."@en ; cd:authoredResource true .
 ex:l6r-multi2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "WHAT COUNTS AS A FALSE CLAIM?"@en ; cd:body "- Target: **at least one false below-limit claim** among the three.\n- If all three nulls are true and tests are **independent**, how often does that happen?\n- One **joint claim** that all three pass is a different decision. The limits here are illustrative."@en ; cd:authoredResource true .
 ex:l6r-multi-answer a cd:Interpretation ; skos:prefLabel "Three 5% tests: a 14.26% chance of at least one false rejection"@en ; cd:authoredResource true .
 ex:l6r-multi-calculation a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-multicalc1, ex:l6r-multicalc2 ; cd:authoredResource true .
 ex:l6r-multicalc1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "ASSUME INDEPENDENT TESTS, ALL NULLS TRUE"@en ; cd:body "- No false rejection in one test: **95%**.\n- No false rejection in all three: **0.95 × 0.95 × 0.95 = 0.857375**.\n- At least one: **1 − 0.857375 = 0.142625**, about **14.26%**."@en ; cd:authoredResource true .
 ex:l6r-multicalc2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "SHARED SAMPLES CAN MAKE TESTS DEPENDENT"@en ; cd:body "- **14.26%** applies to this **independence model**.\n- Shared preparation errors can **link the three tests**.\n- **Bonferroni** also controls family-wise error for dependent tests."@en ; cd:authoredResource true .
 ex:l6r-f-intro a cd:Interpretation ; skos:prefLabel "Compare variances first, then compare calibration models"@en ; cd:authoredResource true .
 ex:l6r-f-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-f1, ex:l6r-f2 ; cd:authoredResource true .
 ex:l6r-f1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "TWO METHOD VARIANCES"@en ; cd:body "- H₀: population variances equal; H₁: method A varies more.\n- As in Level 5, divide the two estimated variances.\n- Under equality and independent Normal sampling, this ratio has an F reference."@en ; cd:authoredResource true .
 ex:l6r-f2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "TWO NESTED MODELS"@en ; cd:body "- Later: constant response versus a concentration slope.\n- Both models use the same calibration standards.\n- Compare added explained variation with remaining error, not two raw variances."@en ; cd:authoredResource true .
 ex:l6r-precision-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-precision-study.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Six independent preparations per method. SD A 0.20 and B 0.10 mg/L; SD ratio two becomes variance ratio four. Independent Normal errors support the exact F reference."@en ; dct:description "- H₀: equal variances; H₁: A greater than B. Keep A on top and use the upper F tail."@en ; cd:authoredResource true .
 ex:l6r-calibration-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-calibration-models.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Schematic flat response model versus a model adding a concentration slope, fitted to the same standards. Dots illustrate geometry, not the raw observations of a worked numerical test."@en ; cd:authoredResource true .
 ex:l6r-calibration-title a cd:Interpretation ; skos:prefLabel "One calibration dataset, two models"@en ; cd:authoredResource true .
 ex:l6r-known-art a cd:MediaAsset ; cd:uri "/chemometrics/level6-known-variance.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Six independent concentration measurements versus known target SD 0.10 mg/L. It is a fixed target, not estimated from another sample."@en ; dct:description "- Schematic setup: independent Normal measurements against a fixed known variance target."@en ; cd:authoredResource true .
 ex:l6r-signed-title a cd:Interpretation ; skos:prefLabel "Wilcoxon signed ranks: do paired measurements show a shift?"@en ; cd:authoredResource true .
 ex:l6r-effect-title a cd:Interpretation ; skos:prefLabel "Cohen's d: mean difference relative to within-group spread"@en ; cd:authoredResource true .
 ex:l6r-effect-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-effect1, ex:l6r-effect2 ; cd:authoredResource true .
 ex:l6r-effect1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "REUSE NIR VERSUS HPLC-MS"@en ; cd:body "- Mean difference, NIR minus HPLC-MS: **−5 µg/L**.\n- Pooled descriptive SD: **2.981 µg/L**; Cohen's d **−1.677**.\n- Negative means NIR reads lower. Unequal spreads still motivated Welch for the mean test."@en ; cd:authoredResource true .
 ex:l6r-effect2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "ROUGH MAGNITUDE GUIDES, NOT CHEMICAL LIMITS"@en ; cd:body "- Absolute d: below **0.2** negligible; **0.2 to below 0.5** small.\n- **0.5 to below 0.8** medium; **0.8 or more** large.\n- Context and uncertainty matter; these conventions do not establish analytical relevance."@en ; cd:hasSource ex:l6r-source-effects ; cd:authoredResource true .
 ex:l6r-cliff-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l6r-cliff1, ex:l6r-cliff2 ; cd:authoredResource true .
 ex:l6r-cliff1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "OUR EXAMPLE: DELTA −0.778"@en ; cd:body "- X wins 0, loses 7 and ties 2: **−7/9**.\n- Negative: X tends to be smaller. Absolute delta **0.778** is large by the convention below.\n- Nine comparisons reuse six observations; uncertainty follows the original units."@en ; cd:authoredResource true .
 ex:l6r-cliff2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "CONVENTIONAL ABSOLUTE-DELTA BANDS"@en ; cd:body "- Below **0.147** negligible; **0.147 to below 0.33** small.\n- **0.33 to below 0.474** medium; **0.474 or more** large.\n- These bands describe **effect magnitude**. Significance and assay relevance use their own criteria."@en ; cd:hasSource ex:l6r-source-effects ; cd:authoredResource true .
 ex:l6r-grubbs-title a cd:Interpretation ; skos:prefLabel "Grubbs test: compare G with its critical value"@en ; cd:authoredResource true .
 ex:l6r-grubbs-result a cd:Interpretation ; cd:body "**G = 2.0219 exceeds G critical = 1.8871** at two-sided alpha 5%. Flag 12.5 mg/L under the one-outlier Normal model. Keep the raw value and investigate; rejection does not identify an error or permit automatic deletion."@en ; cd:bodyFormat "markdown" ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/sources/level6-statistical-tests> {
 ex:l6r-source-effects a cd:Source ; dct:title "effsize R manual: Cohen's d and Cliff's delta magnitude conventions" ; dct:creator "Marco Torchiano" ; dct:identifier "effsize-0.8.1-magnitude" ; dct:source <https://search.r-project.org/CRAN/refmans/effsize/html/cohen.d.html>, <https://search.r-project.org/CRAN/refmans/effsize/html/cliff.delta.html> ; cd:supportsResource ex:l6r-effect2, ex:l6r-cliff2 ; cd:authoredResource true .
}
