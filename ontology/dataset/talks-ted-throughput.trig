@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-throughput> {
  ex:ted-measurement-bottleneck a cd:Concept ; skos:prefLabel "Measurement time is the bottleneck"@en ;
    cd:hasDefinition ex:ted-bottleneck-definition ; cd:hasSource ex:ted-source-workshop-schedule ; cd:authoredResource true .
  ex:ted-bottleneck-definition a cd:Definition ;
    cd:body "The author-supplied workshop models six runs, alternating three samples and three blanks. In its serial scenario, TGA extraction takes 30 minutes, TGA cleaning 22 minutes, thermal desorption/focusing 6 minutes, GC-MS 42 minutes and post-run 5 minutes. One serial cycle takes 105 minutes and six take 630 minutes. These are schedule-model values from the earlier talk, not newly measured throughput, and are not a universal TED method."@en ;
    cd:hasSource ex:ted-source-workshop-schedule ; cd:authoredResource true .
  ex:ted-nested-measurement a cd:Concept ; skos:prefLabel "Nest the instrument cycles"@en ;
    cd:hasDefinition ex:ted-nesting-definition ; cd:dependsOn ex:ted-measurement-bottleneck ; cd:hasSource ex:ted-source-workshop-schedule ; cd:authoredResource true .
  ex:ted-nesting-definition a cd:Definition ;
    cd:body "In the workshop's nested baseline, TGA extraction takes 30 minutes and cleaning/reset 38 minutes; TGA runs start every 68 minutes. GC-MS begins after extraction, while TGA cleaning continues, and its 53-minute sequence leaves 15-minute gaps. The last of six runs ends at 423 minutes. With the optimized TGA program, extraction takes 20 minutes and reset 30 minutes; TGA starts every 50 minutes and GC-MS every 53 minutes from minute 20. The batch ends at 338 minutes, 85 minutes earlier than the nested baseline and 292 minutes earlier than serial execution. The serial and nested scenarios have different TGA cleaning durations in the supplied model, so the first reduction must not be attributed to overlap alone. Physical transfer, sorbent availability and buffering are assumptions of the supplied schedule; this comparison is not a validated scheduler or a general throughput guarantee."@en ;
    cd:hasSource ex:ted-source-workshop-schedule ; cd:authoredResource true .
  ex:ted-heating-rate-study a cd:Concept ; skos:prefLabel "Optimize heating, preserve reproducibility"@en ;
    cd:hasDefinition ex:ted-heating-rate-definition ; cd:hasSource ex:ted-source-workshop-heating ; cd:authoredResource true .
  ex:ted-heating-rate-definition a cd:Definition ;
    cd:body "The supplied workshop credits Rajshree Jeewon's 2026 Master Thesis, Environmental Toxicology, University of Duisburg-Essen, IAC. Its code describes five values as approximately digitized from Figure 11: heating rates 10, 12.5, 15, 17.5 and 20 degrees Celsius per minute correspond to method-standard-deviation values 34.6, 27.0, 25.3, 29.2 and 34.1. The lowest sampled value occurs at 15 degrees Celsius per minute for the SBR marker response. The underlying thesis and raw replicate data were not supplied, and the source talk does not state a physical unit for the response axis. This chart preserves that source scale and does not infer uncertainty, statistical significance, a universal optimum or a numerical link to the extraction/reset durations. The old talk's fitted quadratic and its 14.9 optimum are not reproduced as independently established evidence."@en ;
    cd:hasSource ex:ted-source-workshop-heating ; cd:authoredResource true .

  ex:ted-bottleneck-points a cd:Interpretation ; cd:body "Six serial runs consume the instrument day."@en ;
    cd:hasKeyPoint ex:ted-bottleneck-p1, ex:ted-bottleneck-p2, ex:ted-bottleneck-p3 ; cd:authoredResource true .
  ex:ted-bottleneck-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**6 runs:** 3 samples + 3 blanks"@en ; cd:authoredResource true .
  ex:ted-bottleneck-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**S** = sample · **B** = blank"@en ; cd:authoredResource true .
  ex:ted-bottleneck-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Serial total: 630 min (10.5 h)=="@en ; cd:authoredResource true .
  ex:ted-nesting-points a cd:Interpretation ; cd:body "Overlap work and reduce the thermal-program bottleneck."@en ;
    cd:hasKeyPoint ex:ted-nesting-p1, ex:ted-nesting-p2, ex:ted-nesting-p3 ; cd:authoredResource true .
  ex:ted-nesting-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Overlap** TGA reset and GC-MS"@en ; cd:authoredResource true .
  ex:ted-nesting-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Earlier transfer:** 30 → 20 min"@en ; cd:authoredResource true .
  ex:ted-nesting-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Batch: 630 → 423 → 338 min=="@en ; cd:authoredResource true .
  ex:ted-heating-rate-points a cd:Interpretation ; cd:body "Balance heating speed and marker-response reproducibility."@en ;
    cd:hasKeyPoint ex:ted-rate-p1, ex:ted-rate-p2, ex:ted-rate-p3 ; cd:authoredResource true .
  ex:ted-rate-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**SBR marker:** response reproducibility matters"@en ; cd:authoredResource true .
  ex:ted-rate-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "==Lowest sampled value: 15 °C/min=="@en ; cd:authoredResource true .
  ex:ted-rate-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "**Credit:** Rajshree Jeewon · Master Thesis, 2026"@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-throughput> {
  ex:ted-source-workshop-schedule a cd:Source ; dct:title "Renner workshop microplastics: measurement-time schedule model" ;
    dct:hasVersion "sha256:29cfc1ceeadcd3a870ad2ca41ef6930ec2ce537dc8297dca5f07407a5c23472f" ;
    dct:creator "Gerrit Renner" ; dct:identifier "renner_workshop_microplastics.html#measurement-time-focus; timeGanttModel" ;
    dct:description "Author-supplied earlier HTML talk, inspected locally. Serial, baseline and optimized schedule constants and six-run sequence are transcribed into RDF; its CSS, SVG coordinates and JavaScript renderer are not imported. Schedule estimates, not raw measurements. Original serial and nested TGA cleaning durations differ."@en ;
    cd:supportsResource ex:ted-bottleneck-definition, ex:ted-nesting-definition, ex:ted-schedule-serial, ex:ted-schedule-nested, ex:ted-schedule-optimized ; cd:authoredResource true .
  ex:ted-source-workshop-heating a cd:Source ; dct:title "Renner workshop microplastics: TGA heating-rate reproducibility study" ;
    dct:hasVersion "sha256:29cfc1ceeadcd3a870ad2ca41ef6930ec2ce537dc8297dca5f07407a5c23472f" ;
    dct:creator "Gerrit Renner" ; dct:identifier "renner_workshop_microplastics.html#tga-heating-rate-optimization; renderHeatingRateOptimumChart" ;
    dct:description "Secondary source supplied by the author. Credits Rajshree Jeewon, Master Thesis, Environmental Toxicology, University of Duisburg-Essen, IAC, 2026, Figure 11. Five approximate digitized values are retained; the underlying thesis and raw data were not available. Response-axis unit is not specified in this HTML. No copied quadratic fit or inferred uncertainty."@en ;
    cd:supportsResource ex:ted-heating-rate-definition, ex:ted-heating-rate-data ; cd:authoredResource true .
}

