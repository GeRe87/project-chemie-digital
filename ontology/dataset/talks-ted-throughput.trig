  ex:ted-phase-clean-38 a cd:TimelineInterval ; cd:position 2 ; cd:startOffset 30.0 ; cd:duration 38.0 ; cd:intervalCategory ex:ted-cat-reset ; cd:authoredResource true .
  ex:ted-phase-extract-20 a cd:TimelineInterval ; cd:position 1 ; cd:startOffset 0.0 ; cd:duration 20.0 ; cd:intervalCategory ex:ted-cat-extraction ; cd:authoredResource true .
  ex:ted-phase-clean-30 a cd:TimelineInterval ; cd:position 2 ; cd:startOffset 20.0 ; cd:duration 30.0 ; cd:intervalCategory ex:ted-cat-reset ; cd:authoredResource true .
  ex:ted-phase-desorb a cd:TimelineInterval ; cd:position 1 ; cd:startOffset 0.0 ; cd:duration 6.0 ; cd:intervalCategory ex:ted-cat-desorb ; cd:authoredResource true .
  ex:ted-phase-gc a cd:TimelineInterval ; cd:position 2 ; cd:startOffset 6.0 ; cd:duration 42.0 ; cd:intervalCategory ex:ted-cat-gc ; cd:authoredResource true .
