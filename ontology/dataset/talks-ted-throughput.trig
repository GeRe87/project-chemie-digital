  ex:ted-optimized-gc a cd:TimelineLane ; cd:position 2 ; skos:prefLabel "GC-MS"@en ; cd:startOffset 20.0 ; cd:repeatEvery 53.0 ; cd:hasTimelineInterval ex:ted-phase-desorb, ex:ted-phase-gc, ex:ted-phase-post ; cd:authoredResource true .

