<https://w3id.org/project-chemie-digital/graph/media/eh26-validation-comparison> {
  <https://w3id.org/project-chemie-digital/resource/eh26-pipeline-validation> a <https://w3id.org/project-chemie-digital/ontology/MediaAsset> ; <http://www.w3.org/2004/02/skos/core#prefLabel> "Validate the pipeline plan before execution, then record the run"@en ;
    <https://w3id.org/project-chemie-digital/ontology/uri> "/talks/eh26-pipeline-validation.svg"^^<http://www.w3.org/2001/XMLSchema#anyURI> ; <https://w3id.org/project-chemie-digital/ontology/mediaType> "image/svg+xml" ;
    <https://w3id.org/project-chemie-digital/ontology/alternativeText> "Extracting ion traces, detecting peaks, integrating markers and calibrating mass creates three interfaces. Before execution, RDF describes the plan and SHACL checks the declared interfaces. During execution, record actual inputs, settings, versions and step timestamps."@en ; <https://w3id.org/project-chemie-digital/ontology/authoredResource> true ; <https://w3id.org/project-chemie-digital/ontology/hasSource> <https://w3id.org/project-chemie-digital/resource/ted-source-shacl-slide> .
  <https://w3id.org/project-chemie-digital/resource/ted-source-shacl-slide> <https://w3id.org/project-chemie-digital/ontology/supportsResource> <https://w3id.org/project-chemie-digital/resource/eh26-pipeline-validation> .
}
