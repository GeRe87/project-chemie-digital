@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-normal-ic-story> {
  ex:nn-case-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-case1, ex:nn-case2 ; cd:authoredResource true .
  ex:nn-case1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Same nitrate control, same IC method"@en ; cd:body "Nominal concentration: 10.00 mg/L. First illustrative readings: 10.03, 9.95, 10.08, 9.98, 10.12, 9.94 mg/L. Which one is the true concentration?"@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:nn-case2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Four different quantities"@en ; cd:body "Nominal concentration describes the control. The method's expectation includes possible bias. An individual result varies. The sample mean summarizes the readings; it is not automatically the truth."@en ; cd:authoredResource true .
  ex:nn-model a cd:MathExpression ; cd:formulaLabel "Repeated results combine a method expectation and random deviations"@en ; cd:latex "X_i=\\mu+\\varepsilon_i" ; cd:hasSymbol ex:nn-model-symbols ; dct:hasPart ex:nn-model-legend ; cd:authoredResource true .
  ex:nn-model-symbols a cd:MathSymbol ; cd:symbol "measurement model" ; cd:mathNotation "X_i,\\mu,\\varepsilon_i,i,=,+" ; cd:body "X indexed by i: random nitrate result on repeat i; mu: method expectation, not necessarily the nominal control value; epsilon indexed by i: zero-mean random deviation. All have mg/L units. Plus adds expectation and deviation; equality defines the model. Independent repeats with one stable common variance are assumed for the simulations, not established by six values."@en ; cd:authoredResource true .
  ex:nn-model-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-model-entry ; cd:authoredResource true .
  ex:nn-model-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Expectation is not automatically the target"@en ; dct:references ex:nn-model-symbols ; cd:authoredResource true .
  ex:nn-model-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-model1, ex:nn-model2 ; cd:authoredResource true .
  ex:nn-model1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Describe before naming a law"@en ; cd:body "Increase the repeat count from 20 to 50, 100 and 1,000. Look for concentration near the center and less frequent large deviations. Do not overlay a theoretical curve yet."@en ; cd:authoredResource true .
  ex:nn-model2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "A histogram does not explain its own shape"@en ; cd:body "Why are small total errors common? Could several small effects compensate each other? A bell-like appearance motivates a model; it does not prove independence, normality or absence of bias."@en ; cd:authoredResource true .
  ex:nn-errors a cd:MathExpression ; cd:formulaLabel "Count positive contributions, then convert the count to a total error"@en ; cd:latex "\\begin{gathered}K\\sim\\operatorname{Bin}(n,0.5)\\\\E=a(2K-n),\\quad a=\\frac{\\sigma}{\\sqrt n}\\\\Z_n=\\frac{E}{a\\sqrt n}=\\frac{2K-n}{\\sqrt n}\\end{gathered}" ; cd:hasSymbol ex:nn-errors-symbols ; dct:hasPart ex:nn-errors-legend ; cd:authoredResource true .
  ex:nn-errors-symbols a cd:MathSymbol ; cd:symbol "independent signed contributions" ; cd:mathNotation "K,n,a,E,\\sigma,Z_n,\\operatorname{Bin},\\sim,=,+,-,/,\\sqrt{}" ; cd:body "n: number of independent equiprobable plus/minus-a contributions; K: random count of positive signs, binomial with n trials and probability 0.5. E: random total error in mg/L. a: positive step size in mg/L; sigma=0.10 mg/L: fixed total SD. Scaling a by inverse root n keeps total variance constant. Uppercase Z subscript n: dimensionless standardized random total, still discrete for finite n; lowercase z would denote one realized value. Juxtaposition multiplies; subtract, divide and take positive roots as shown; equals rewrites identities, tilde names the law."@en ; cd:authoredResource true .
  ex:nn-errors-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-errors-entry ; cd:authoredResource true .
  ex:nn-errors-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Count, signed error, scaling and units"@en ; dct:references ex:nn-errors-symbols ; cd:authoredResource true .
  ex:nn-four-chart a cd:ChartDefinition ; skos:prefLabel "Four influences: compensation has more combinations"@en ; cd:body "Four independent fair signs give 16 equally likely combinations: 1, 4, 6, 4, 1. Cancellation is common; extremes are rare. This is a simplified error model, not validation data."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:nn-four-data ; cd:xAxisLabel "Total error (multiples of a)"@en ; cd:yAxisLabel "Probability mass"@en ; cd:authoredResource true .
  ex:nn-four-data a cd:Dataset ; skos:prefLabel "Exact four-contribution binomial masses"@en ; cd:derivedFromResource ex:nn-errors ; cd:hasObservation ex:nn-four0, ex:nn-four1, ex:nn-four2, ex:nn-four3, ex:nn-four4 ; cd:authoredResource true .
   ex:nn-four0 a cd:Observation ; cd:position 1 ; skos:prefLabel "-4a"@en ; cd:groupLabel "-4a"@en ; cd:numericValue 0.0625 ; cd:authoredResource true .
   ex:nn-four1 a cd:Observation ; cd:position 2 ; skos:prefLabel "-2a"@en ; cd:groupLabel "-2a"@en ; cd:numericValue 0.25 ; cd:authoredResource true .
   ex:nn-four2 a cd:Observation ; cd:position 3 ; skos:prefLabel "0"@en ; cd:groupLabel "0"@en ; cd:numericValue 0.375 ; cd:authoredResource true .
   ex:nn-four3 a cd:Observation ; cd:position 4 ; skos:prefLabel "+2a"@en ; cd:groupLabel "+2a"@en ; cd:numericValue 0.25 ; cd:authoredResource true .
   ex:nn-four4 a cd:Observation ; cd:position 5 ; skos:prefLabel "+4a"@en ; cd:groupLabel "+4a"@en ; cd:numericValue 0.0625 ; cd:authoredResource true .
  ex:nn-phi a cd:MathExpression ; cd:formulaLabel "Lowercase phi is the standard-normal density"@en ; cd:latex "\\varphi(z)=\\frac{1}{\\sqrt{2\\pi}}e^{-z^2/2}" ; cd:hasSymbol ex:nn-phi-symbols ; dct:hasPart ex:nn-phi-legend ; cd:authoredResource true .
  ex:nn-phi-symbols a cd:MathSymbol ; cd:symbol "density and standardized argument" ; cd:mathNotation "\\varphi,z,e,\\pi,\\sqrt{},{}^2,-,/,=" ; cd:body "Lowercase phi: standard-normal PDF per dimensionless z-unit; lowercase z: a concrete standardized value in SD units, not a probability. e: exponential base; pi: circle constant. Square z, negate, divide by two and exponentiate; divide by the positive square root of two times pi. Equality defines the density. It is symmetric, maximal at zero, decreases with distance and has total area one. Its height is not the probability of an exact value."@en ; cd:authoredResource true .
  ex:nn-phi-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-phi-entry ; cd:authoredResource true .
  ex:nn-phi-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Phi is a function; z is its argument"@en ; dct:references ex:nn-phi-symbols ; cd:authoredResource true .
  ex:nn-phi-chart a cd:ChartDefinition ; skos:prefLabel "The standard-normal density on the z scale"@en ; cd:body "The limiting density is smooth; each finite binomial model remains discrete. Stirling's approximation can motivate this limit in a mathematical extension. Here we use the central-limit argument, not an asserted full derivation."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:usesDataset ex:l5-c14-standard-normal ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.42 ; cd:xAxisLabel "Standardized distance z"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Density phi(z)"@en ; cd:yAxisUnit "per z-unit" ; cd:authoredResource true .
  ex:nn-eta a cd:MathExpression ; cd:formulaLabel "A fixed normal model, independent of the six illustrative readings"@en ; cd:latex "\\begin{gathered}X\\sim\\mathcal N(10.00,0.10^2)\\\\Z=\\frac{X-\\mu}{\\sigma}\\sim\\mathcal N(0,1),\\quad z=\\frac{x-\\mu}{\\sigma}\\\\f_X(x)=\\frac{1}{\\sigma}\\varphi(z)\\end{gathered}" ; cd:hasSymbol ex:nn-eta-symbols ; dct:hasPart ex:nn-eta-legend ; cd:authoredResource true .
  ex:nn-eta-symbols a cd:MathSymbol ; cd:symbol "measurement scale and standard-normal scale" ; cd:mathNotation "X,x,\\mu,\\sigma,Z,z,f_X,\\varphi,\\mathcal N,\\sim,=,-,/,{}^2" ; cd:body "X: random result; x: one value; mu=10.00 mg/L and sigma=0.10 mg/L: independently specified known expectation and positive SD. Normal notation uses variance as its second parameter, in (mg/L) squared. Uppercase Z is the standardized random variable; lowercase z is a concrete dimensionless value, not a third function. Standard-normal N(0,1) has mean zero and variance one. Phi lowercase is standard-normal density; f with subscript X is concentration density in L/mg. The factor one over sigma changes density units. Tilde names the law; equality defines/scales the quantities. Subtract, divide and square as shown."@en ; cd:authoredResource true .
  ex:nn-eta-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-eta-entry ; cd:authoredResource true .
  ex:nn-eta-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Z, z, density scaling and the variance convention"@en ; dct:references ex:nn-eta-symbols ; cd:authoredResource true .
  ex:nn-eta-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-eta1, ex:nn-eta2 ; cd:authoredResource true .
  ex:nn-eta1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Read distance in SD units"@en ; cd:body "10.00 mg/L: z 0. 10.10: z +1. 10.20: z +2. 9.70: z -3. Positive and negative signs give direction from the method expectation."@en ; cd:authoredResource true .
  ex:nn-eta2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Recall the earlier coordinate tool"@en ; cd:body "Standardization alone never makes arbitrary data normal. Under this normal model, uppercase Z is standard normal. Lowercase z is the realized argument supplied to phi and Phi."@en ; cd:authoredResource true .
  ex:nn-devices a cd:MathExpression ; cd:formulaLabel "Same 10.20 mg/L result, different statistical distances"@en ; cd:latex "\\begin{gathered}z_A=\\frac{10.20-10.00}{0.10}=2\\\\z_B=\\frac{10.20-10.00}{0.20}=1\\end{gathered}" ; cd:hasSymbol ex:nn-devices-symbols ; dct:hasPart ex:nn-devices-legend ; cd:authoredResource true .
  ex:nn-devices-symbols a cd:MathSymbol ; cd:symbol "two methods with different precision" ; cd:mathNotation "z_A,z_B,A,B,=,-,/" ; cd:body "Subscripts A and B identify two normal methods with the same known expectation 10.00 mg/L. Both report 10.20 mg/L; SD is 0.10 for A and 0.20 mg/L for B. Subtract expectation and divide by the method's SD; units cancel. z A is two and z B one. Equality evaluates the concrete standardized distances, not probabilities. The result is farther into A's upper tail."@en ; cd:authoredResource true .
  ex:nn-devices-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-devices-entry ; cd:authoredResource true .
  ex:nn-devices-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Same units, different reference spreads"@en ; dct:references ex:nn-devices-symbols ; cd:authoredResource true .
  ex:nn-devices-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-device1, ex:nn-device2 ; cd:authoredResource true .
  ex:nn-device1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Device A: SD 0.10 mg/L"@en ; cd:body "A +0.20 mg/L deviation is two SDs above expectation. Under A's model it is less usual than under B's model."@en ; cd:authoredResource true .
  ex:nn-device2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Device B: SD 0.20 mg/L"@en ; cd:body "The same deviation is only one SD. Compare tail probabilities on the standardized scale, not raw density heights across differently scaled devices."@en ; cd:authoredResource true .
  ex:nn-cdf a cd:MathExpression ; cd:formulaLabel "The normal-density antiderivative uses the error function"@en ; cd:latex "\\begin{gathered}\\Phi(z)=P(Z\\le z)\\\\=\\int_{-\\infty}^{z}\\varphi(t)\\,dt\\\\=\\frac12\\left[1+\\operatorname{erf}\\!\\left(\\frac{z}{\\sqrt2}\\right)\\right]\\\\\\operatorname{erf}(u)=\\frac{2}{\\sqrt\\pi}\\int_0^u e^{-t^2}\\,dt\\\\\\Phi(2)\\approx0.9772499\\end{gathered}" ; cd:body "The normal density has no elementary antiderivative. Its CDF is an antiderivative expressed using the special error function erf. Scaling the argument by the square root of two and applying the half-offset gives the standard-normal CDF, with its integration constant fixed by probability zero at minus infinity. The error function itself is not the normal CDF and is not a probability."@en ; cd:hasSymbol ex:nn-cdf-symbols, ex:nn-erf-symbols ; dct:hasPart ex:nn-cdf-legend ; cd:authoredResource true .
  ex:nn-cdf-symbols a cd:MathSymbol ; cd:symbol "accumulated left-tail probability" ; cd:mathNotation "\\Phi,\\varphi,z,Z,t,P,\\le,\\int,-\\infty,dt,=,\\approx" ; cd:body "Uppercase Phi: standard-normal CDF, dimensionless, a special case of general F. Lowercase phi: its density, a special case of general f. Z: standard-normal random variable; lowercase z: a concrete standardized threshold, here two; t: dimensionless integration variable. P denotes probability; at most includes the threshold. Integrate density from minus infinity to z; dt identifies the integration variable. Equals states the definition; approximately rounds. A steep CDF means high density, not high point probability."@en ; cd:authoredResource true .
  ex:nn-cdf-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-cdf-entry, ex:nn-erf-entry ; cd:authoredResource true .
  ex:nn-cdf-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Density versus cumulative probability"@en ; dct:references ex:nn-cdf-symbols ; cd:authoredResource true .
  ex:nn-erf-entry a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Error function and Gaussian antiderivative"@en ; dct:references ex:nn-erf-symbols ; cd:authoredResource true .
  ex:nn-erf-symbols a cd:MathSymbol ; cd:symbol "error function" ; cd:mathNotation "\\operatorname{erf},u,t,e,{}^2,\\pi,\\sqrt{},\\frac12,1,+,0,2,\\int,dt" ; cd:body "erf is the special error function, not an inverse function or a probability. Lowercase u is its dimensionless argument; t is a dimensionless dummy integration variable, reused independently in each integral. The integral runs from zero to u and dt identifies its integration variable. e is the base of the natural exponential; minus t squared is its exponent. Pi is the circle constant; square roots are positive. The factor two divided by the square root of pi normalizes erf. In the CDF identity, divide standardized threshold z by the square root of two, evaluate erf, add one and multiply by one half; parentheses and square brackets group these operations. All arguments, integrals and function values here are dimensionless. Phi is an antiderivative of the standard-normal density phi; the displayed lower limit minus infinity fixes its probability normalization. There is no elementary antiderivative of the Gaussian density. erf supplies a special-function representation, not a new distributional assumption."@en ; cd:authoredResource true .
  ex:nn-tail a cd:MathExpression ; cd:formulaLabel "A two-SD upper threshold can trigger by chance"@en ; cd:latex "\\begin{gathered}\\varphi(2)\\approx0.05399\\\\P(X>10.20)=1-\\Phi(2)\\\\\\approx0.02275\\end{gathered}" ; cd:hasSymbol ex:nn-tail-symbols ; dct:hasPart ex:nn-tail-legend ; cd:authoredResource true .
  ex:nn-tail-symbols a cd:MathSymbol ; cd:symbol "upper-tail calculation and density trap" ; cd:mathNotation "X,z,\\varphi,\\Phi,P,>,=,-,/,\\approx" ; cd:body "X: normal concentration, mean 10.00 and SD 0.10 mg/L; 10.20 mg/L: upper threshold. Subtract mean and divide by SD to get dimensionless z two. Lowercase phi at two is density per z-unit, not 5.40% probability. Uppercase Phi at two is left-tail probability; subtract from total probability one to obtain the upper tail 2.275%. P and greater-than select that tail; equality evaluates, approximately rounds."@en ; cd:authoredResource true .
  ex:nn-tail-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-tail-entry ; cd:authoredResource true .
  ex:nn-tail-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "2.28% upper tail is not 5.40% density"@en ; dct:references ex:nn-tail-symbols ; cd:authoredResource true .
  ex:nn-tail-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-tail1 ; cd:authoredResource true .
  ex:nn-tail1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Expected alarms under a stable model"@en ; cd:body "About 2.28% of independent individual results exceed 10.20 mg/L even when this model is correct. An exceedance alone does not diagnose a fault. This statistical control threshold is not a regulatory or chemical specification limit."@en ; cd:authoredResource true .
  ex:nn-decision a cd:MathExpression ; cd:formulaLabel "Choose an upper threshold for a one-percent per-result false-alarm rate"@en ; cd:latex "\\begin{gathered}z^*=\\Phi^{-1}(0.99)\\approx2.32635\\\\x^*=\\mu+z^*\\sigma\\\\\\approx10.23263\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:nn-decision-symbols ; dct:hasPart ex:nn-decision-legend ; cd:authoredResource true .
  ex:nn-decision-symbols a cd:MathSymbol ; cd:symbol "inverse CDF and decision threshold" ; cd:mathNotation "\\Phi,\\Phi^{-1},z^*,x^*,\\mu,\\sigma,{}^*,=,+,\\approx" ; cd:body "Phi: standard-normal CDF; inverse Phi maps cumulative probability 0.99 to dimensionless threshold z star. Superscript star marks a chosen threshold; minus-one means inverse function, not reciprocal. x star: corresponding concentration threshold; mu=10.00 mg/L; sigma=0.10 mg/L, treated as known. Multiply z star by SD and add expectation. Equals defines the quantities; approximately rounds. Under the model, one percent of individual results exceed the unrounded threshold. A displayed rounded 10.233 is approximate, not exact one-percent calibration."@en ; cd:authoredResource true .
  ex:nn-decision-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-decision-entry ; cd:authoredResource true .
  ex:nn-decision-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Inverse function, units and per-result calibration"@en ; dct:references ex:nn-decision-symbols ; cd:authoredResource true .
  ex:nn-rule-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-rule1, ex:nn-rule2 ; cd:authoredResource true .
  ex:nn-rule1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A probability target becomes a concentration threshold"@en ; cd:body "Use the 99th percentile for an upper 1% rule. Approximate threshold: 10.233 mg/L. Instrument resolution and rounding must be accounted for before using a real rule."@en ; cd:authoredResource true .
  ex:nn-rule2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "One result is not a whole monitoring campaign"@en ; cd:body "The 1% rate is per individual result under the fixed normal model. Repeated checks increase the chance of at least one alarm. Estimated parameters and real operating limits require separate calibration and approval."@en ; cd:authoredResource true .
  ex:nn-bands a cd:MathExpression ; cd:formulaLabel "Derive the familiar coverage rule from the CDF"@en ; cd:latex "\\begin{gathered}P(a\\le Z\\le b)=\\Phi(b)-\\Phi(a)\\\\P(-k\\le Z\\le k)=2\\Phi(k)-1\\end{gathered}" ; cd:hasSymbol ex:nn-bands-symbols ; dct:hasPart ex:nn-bands-legend ; cd:authoredResource true .
  ex:nn-bands-symbols a cd:MathSymbol ; cd:symbol "central probability versus upper tail" ; cd:mathNotation "Z,a,b,k,\\Phi,P,\\le,-,+,=,2" ; cd:body "Z: standard normal; a and b: ordered dimensionless bounds; positive k: symmetric distance in SD units. P denotes probability; Phi is the standard-normal CDF. Comparisons include endpoints, each with zero point probability. Subtract lower CDF from upper; symmetry gives twice Phi(k) minus one. Equality states identities, juxtaposition multiplies. The central interval loses both tails, unlike a single upper threshold."@en ; cd:authoredResource true .
  ex:nn-bands-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-bands-entry ; cd:authoredResource true .
  ex:nn-bands-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symmetry and two-sided coverage"@en ; dct:references ex:nn-bands-symbols ; cd:authoredResource true .
  ex:nn-bands-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-band1, ex:nn-band2, ex:nn-band3 ; cd:authoredResource true .
  ex:nn-band1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Within one SD"@en ; cd:body "68.27% central coverage: 9.90 to 10.10 mg/L."@en ; cd:authoredResource true .
  ex:nn-band2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Within two SDs"@en ; cd:body "95.45% central coverage: 9.80 to 10.20 mg/L. About 2.28% lies in each excluded tail, not 4.55% in the upper tail alone."@en ; cd:authoredResource true .
  ex:nn-band3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Within three SDs"@en ; cd:body "99.73% central coverage: 9.70 to 10.30 mg/L. These are model intervals for individual results, not confidence intervals for a mean."@en ; cd:authoredResource true .
  ex:nn-means a cd:MathExpression ; cd:formulaLabel "Averaging narrows the sampling distribution"@en ; cd:latex "\\begin{gathered}\\operatorname{Var}(\\bar X)=\\frac{\\sigma^2}{n}\\\\\\sigma_{\\bar X}=\\frac{\\sigma}{\\sqrt n}\\\\\\bar X\\sim\\mathcal N(\\mu,\\sigma^2/n)\\\\n=6:\\quad\\sigma_{\\bar X}\\approx0.040825\\;\\mathrm{mg/L}\\end{gathered}" ; cd:hasSymbol ex:nn-means-symbols ; dct:hasPart ex:nn-means-legend ; cd:authoredResource true .
  ex:nn-means-symbols a cd:MathSymbol ; cd:symbol "sampling distribution of the mean" ; cd:mathNotation "\\bar X,\\mu,\\sigma,\\sigma_{\\bar X},n,\\operatorname{Var},\\mathcal N,\\sim,{}^2,/,\\sqrt{},=,\\approx,:" ; cd:body "Bar X: random mean of n independent readings with common expectation mu=10.00 mg/L and variance sigma squared; sigma=0.10 mg/L. Sigma subscript bar X: true SD of that mean, or standard error, in mg/L. Var denotes variance in (mg/L) squared. Divide individual variance by n, take the positive square root. The variance identity needs independence/common variance; the exact normal law additionally requires normal readings and holds for every n. Tilde names the law; its second parameter is variance. Equality gives identities, colon selects n six, approximately rounds. Individual SD stays 0.10."@en ; cd:authoredResource true .
  ex:nn-means-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-means-entry ; cd:authoredResource true .
  ex:nn-means-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Individual variation versus standard error"@en ; dct:references ex:nn-means-symbols ; cd:authoredResource true .
  ex:nn-means-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-means1 ; cd:authoredResource true .
  ex:nn-means1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Repeat the whole sampling experiment"@en ; cd:body "Compare many single results with many means of six fresh independent readings. Both center at 10.00 mg/L; means vary less. Averaging does not remove constant bias or dependence."@en ; cd:authoredResource true .
  ex:nn-limits-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-limit1, ex:nn-limit2, ex:nn-limit3 ; cd:authoredResource true .
  ex:nn-limit1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Drift: the mean changes with time"@en ; cd:body "A pooled histogram can hide a changing method. Inspect acquisition order, not only its apparent distribution. One stable common expectation no longer describes every reading."@en ; cd:authoredResource true .
  ex:nn-limit2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Occasional interference: a different error process"@en ; cd:body "Rare shifted observations create a mixture or heavy tails. Many small effects do not guarantee that a dominant disturbance vanishes."@en ; cd:authoredResource true .
  ex:nn-limit3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Reporting near a detection limit"@en ; cd:body "Censoring or replacing results at a reporting threshold changes the observed distribution. A pile-up at that threshold is not a normal density, and not proof that the latent errors are skewed."@en ; cd:authoredResource true .
  ex:nn-bridge-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:nn-bridge1, ex:nn-bridge2 ; cd:authoredResource true .
  ex:nn-bridge1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Predict individual results"@en ; cd:body "Under the fixed normal model: z measures distance, phi gives density, Phi accumulates probability, inverse Phi selects a threshold."@en ; cd:authoredResource true .
  ex:nn-bridge2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Now estimate precision"@en ; cd:body "A new six-reading QC series gives SD 0.155 mg/L against reference 0.10 mg/L. Could chance explain that? The variance estimate itself is random."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/data/level5-normal-ic-story> {
  ex:nn-intro-data a cd:Dataset ; skos:prefLabel "Six illustrative IC readings, not parameter estimates for the later model"@en ; cd:unit "mg/L" ; cd:hasObservation ex:nn-intro1, ex:nn-intro2, ex:nn-intro3, ex:nn-intro4, ex:nn-intro5, ex:nn-intro6 ; cd:authoredResource true .
  ex:nn-intro1 a cd:Observation ; cd:position 1 ; cd:numericValue 10.03 ; cd:authoredResource true .
  ex:nn-intro2 a cd:Observation ; cd:position 2 ; cd:numericValue 9.95 ; cd:authoredResource true .
  ex:nn-intro3 a cd:Observation ; cd:position 3 ; cd:numericValue 10.08 ; cd:authoredResource true .
  ex:nn-intro4 a cd:Observation ; cd:position 4 ; cd:numericValue 9.98 ; cd:authoredResource true .
