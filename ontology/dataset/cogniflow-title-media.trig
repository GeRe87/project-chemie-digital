@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-standardized-data-processing> {
  ex:organization-ude a cd:Organization ;
    skos:prefLabel "University of Duisburg-Essen"@en ;
    cd:hasLogo ex:media-ude-logo ;
    cd:authoredResource true .

  ex:media-ude-logo a cd:MediaAsset ;
    cd:uri "https://www.uni-due.de/portal/4/images/UDE-logo-claim.svg"^^xsd:anyURI ;
    cd:mediaType "image/svg+xml" ;
    cd:alternativeText "University of Duisburg-Essen logo with the claim Offen im Denken"@en ;
    cd:authoredResource true .

  ex:organization-iuta a cd:Organization ;
    skos:prefLabel "Institut für Umwelt & Energie, Technik & Analytik e. V. (IUTA)"@de ;
    skos:prefLabel "Institut für Umwelt & Energie, Technik & Analytik e. V. (IUTA)"@en ;
    skos:altLabel "IUTA"@de, "IUTA"@en ;
    cd:hasLogo ex:media-iuta-logo ;
    cd:authoredResource true .

  ex:media-iuta-logo a cd:MediaAsset ;
    cd:uri "https://jrf.nrw/fileadmin/uploads/2023/04/iuta-logo_schrift-rechts-300x148.png"^^xsd:anyURI ;
    cd:mediaType "image/png" ;
    cd:alternativeText "Logo of the Institut für Umwelt & Energie, Technik & Analytik e. V. (IUTA)"@en ;
    cd:authoredResource true .

  ex:organization-munv a cd:Organization ;
    skos:prefLabel "Ministerium für Umwelt, Naturschutz und Verkehr des Landes Nordrhein-Westfalen"@de ;
    skos:prefLabel "Ministry for Environment, Nature Conservation and Transport of North Rhine-Westphalia"@en ;
    cd:hasLogo ex:media-munv-logo ;
    cd:authoredResource true .

  ex:media-munv-logo a cd:MediaAsset ;
    cd:uri "https://www.regionale-suedwestfalen.com/wp-content/uploads/2023/01/Foerderlogo-MUNV-300x62.jpeg"^^xsd:anyURI ;
    cd:mediaType "image/jpeg" ;
    cd:alternativeText "Logo of the Ministry for Environment, Nature Conservation and Transport of North Rhine-Westphalia"@en ;
    cd:authoredResource true .

  ex:attribution-cogniflow-gerrit-renner
    cd:affiliatedWith ex:organization-ude .

  ex:attribution-cogniflow-ricardo-cunha
    cd:affiliatedWith ex:organization-iuta .

  ex:cogniflow-standardized-data-processing
    cd:fundedBy ex:organization-munv .

  ex:attribution-cogniflow-funding a cd:Attribution ;
    cd:body "Funding"@en ;
    cd:fundingSource ex:organization-munv ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-standardized-data-processing> {
  ex:path-step-cogniflow-title
    cd:usesResource ex:attribution-cogniflow-funding .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-standardized-data-processing> {
  ex:scene-cogniflow-title
    cd:hasSceneItem ex:scene-item-cogniflow-title-funding .

  ex:scene-item-cogniflow-title-funding a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:attribution-cogniflow-funding ;
    cd:communicativeRole cd:AttributionRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
