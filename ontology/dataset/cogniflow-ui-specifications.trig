@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-ui-specifications> {
  ex:cogniflow-ui-specifications a cd:Concept ;
    skos:prefLabel "A Semantic Model for Web Interfaces"@en ;
    cd:hasDefinition ex:def-cogniflow-ui-specifications ;
    cd:authoredResource true .

  ex:def-cogniflow-ui-specifications a cd:Definition ;
    cd:body "The same semantics-first pattern can describe user interfaces: a reusable SidebarMenu defines structural relationships, while a concrete CogniFlow sidebar specification selects buttons, labels, icons, and a presentation mode."@en ;
    cd:authoredResource true .

  ex:cogniflow-ui-grammar-banner a cd:Interpretation ;
    cd:body """WEB INTERFACE CONCEPT DOMAIN
one SidebarMenu · explicit IconButtons · Compact or Full"""@en ;
    cd:authoredResource true .

  ex:cogniflow-ui-cards a cd:Interpretation ;
    cd:body "Illustrative Web UI example showing the same concept-to-specification pattern used for data processing."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-ui-domain,
      ex:keypoint-cogniflow-sidebar-menu,
      ex:keypoint-cogniflow-sidebar-specification ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-ui-domain a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """CONCEPT DOMAIN
WEB INTERFACE
defines UIComponent
SidebarMenu · IconButton
Label · ViewMode
Compact · Full"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-sidebar-menu a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """SIDEBAR MENU
a UIComponent

hasButton → IconButton
IconButton hasIcon
IconButton hasLabel
hasViewMode → ViewMode"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-sidebar-specification a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """SPECIFICATION
COGNIFLOW SIDEBAR

ITEM · icon + label
VIEWMODE · Compact / Full
COMPACT · icon visible
FULL · icon + label visible"""@en ;
    cd:authoredResource true .

  ex:cogniflow-ui-compatibility-note a cd:Interpretation ;
    cd:body "THE CONCEPT DEFINES THE STRUCTURE — THE SPECIFICATION PROVIDES THE CONCRETE INTERFACE"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-ui-specifications-extension> {
  ex:path-step-cogniflow-ui-specifications a cd:PathStep ;
    cd:position 11 ;
    cd:usesResource ex:cogniflow-ui-grammar-banner,
      ex:cogniflow-ui-cards,
      ex:cogniflow-ui-compatibility-note ;
    cd:usesScene ex:scene-cogniflow-ui-specifications ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-ui-specifications> {
  ex:scene-cogniflow-ui-specifications a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-ui-specifications ;
    cd:hasSceneItem ex:scene-item-cogniflow-ui-specifications-heading,
      ex:scene-item-cogniflow-ui-specifications-grammar,
      ex:scene-item-cogniflow-ui-specifications-cards,
      ex:scene-item-cogniflow-ui-specifications-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-ui-specifications-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-ui-specifications ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-ui-specifications-grammar a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-ui-grammar-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-ui-specifications-cards a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-ui-cards ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-ui-specifications-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-ui-compatibility-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
