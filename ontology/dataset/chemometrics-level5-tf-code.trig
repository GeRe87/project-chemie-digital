@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-tf-code> {
  ex:tf-student-code a cd:CodeExample ; skos:prefLabel "Repeated means with known versus estimated SE"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-student-t ; cd:code """# Under the mean null. Generating SD is known to the simulation only.
set.seed(20261104)
M <- 10000; n <- 6; mu0 <- 10; sigma <- 0.10
stopifnot(n>=3,n<=100,M>=100,M<=100000,sigma>0)
X <- matrix(rnorm(M*n,mu0,sigma),nrow=M)
means <- rowMeans(X); spreads <- apply(X,1,sd)
Z <- (means-mu0)/(sigma/sqrt(n))
T <- (means-mu0)/(spreads/sqrt(n))
cut <- qt(.975,n-1)
cat('n, df, positive critical t:',n,n-1,cut,'\n')
cat('Rejection fractions, known SE normal / estimated SE normal / t:',
    mean(abs(Z)>qnorm(.975)),mean(abs(T)>qnorm(.975)),mean(abs(T)>cut),'\n')
cat('Largest absolute t and its estimated SD:',max(abs(T)),spreads[which.max(abs(T))],'\n')
# Plot window only: all M draws remain in calculations, including tails.
h <- hist(T,breaks=seq(floor(min(T)),ceiling(max(T)),by=.2),plot=FALSE)
plot(h,freq=FALSE,xlim=c(-5,5),col='#8ecae6',border='white',
     main='Studentized means: n = 6 by default',xlab='Dimensionless statistic',ylab='Density')
curve(dnorm(x),add=TRUE,col='#b45309',lwd=3)
curve(dt(x,n-1),add=TRUE,col='#0369a1',lwd=3)
legend('topright',c('Standard normal','Student t'),col=c('#b45309','#0369a1'),lwd=3)
""" ; cd:authoredResource true .
  ex:tf-df-code a cd:CodeExample ; skos:prefLabel "Increase count without changing the population"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-student-t ; cd:code """n <- 6 # Try 4, 6, 10, 30, 100.
stopifnot(n %in% c(4,6,10,30,100))
cat('n, df, critical t, normal:',n,n-1,qt(.975,n-1),qnorm(.975),'\n')
grid <- seq(-5,5,length.out=501)
plot(grid,dt(grid,n-1),type='l',lwd=3,col='#0369a1',
     xlab='Dimensionless statistic',ylab='Density',main='Same 5% two-sided level')
lines(grid,dnorm(grid),col='#b45309',lwd=3)
abline(v=c(-1,1)*qt(.975,n-1),lty=2,col='#0369a1')
legend('topright',c('Student t','Standard normal'),col=c('#0369a1','#b45309'),lwd=3)
""" ; cd:authoredResource true .
  ex:tf-f-code a cd:CodeExample ; skos:prefLabel "Independent normal series, equal true variances"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-f-distribution ; cd:code """set.seed(20261105)
M <- 10000; nA <- 6; nB <- 6; sigma <- .10
stopifnot(nA>=3,nB>=3,nA<=100,nB<=100,M>=100,M<=100000,sigma>0)
# Means need not agree. Each sample variance uses its own fitted mean.
A <- matrix(rnorm(M*nA,10.10,sigma),nrow=M)
B <- matrix(rnorm(M*nB,10.00,sigma),nrow=M)
vA <- apply(A,1,var); vB <- apply(B,1,var)
ratios <- vB/vA # Fixed B/A, NEVER reorder by observed size.
dfB <- nB-1; dfA <- nA-1
bounds <- qf(c(.025,.975),dfB,dfA)
cat('Ordered numerator B, denominator A df:',dfB,dfA,'\n')
cat('Bounds:',bounds,'fraction below one:',mean(ratios<1),'\n')
cat('Two-sided null rejection fraction:',mean(ratios<bounds[1] | ratios>bounds[2]),'\n')
cat('Largest ratio and its denominator variance:',max(ratios),vA[which.max(ratios)],'\n')
# Long tails retained in counts; plotting window ends at 15, not the distribution.
h <- hist(ratios,breaks=c(seq(0,15,by=.25),max(15.25,max(ratios)+1)),plot=FALSE)
plot(h,freq=FALSE,xlim=c(0,15),ylim=c(0,.85),col='#8ecae6',border='white',
     main='Independent sample variance ratios B/A',xlab='Dimensionless variance ratio',ylab='Density')
curve(df(x,dfB,dfA),from=.001,to=15,add=TRUE,col='#0369a1',lwd=3)
abline(v=c(bounds,9),lty=c(2,2,1),col=c('#64748b','#64748b','#b45309'))
""" ; cd:authoredResource true .
  ex:tf-alpha-code a cd:CodeExample ; skos:prefLabel "Same observations, different prespecified error budgets"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-f-distribution ; cd:code """alpha <- .05 # Compare .10, .05, .01, not a post-hoc search for significance.
stopifnot(alpha %in% c(.10,.05,.01))
A <- c(9.95,10.05,10.10,10.10,10.15,10.25)
B <- c(9.55,9.85,10.00,10.00,10.15,10.45)
f <- var(B)/var(A); d1 <- length(B)-1; d2 <- length(A)-1
p <- min(1,2*min(pf(f,d1,d2),pf(f,d1,d2,lower.tail=FALSE)))
bounds <- qf(c(alpha/2,1-alpha/2),d1,d2)
cat('Mean A/B:',mean(A),mean(B),'SD A/B:',sd(A),sd(B),'\n')
cat('Fixed B/A:',f,'bounds:',bounds,'two-sided p:',p,'reject:',p<alpha,'\n')
plot(seq(.001,15,length.out=500),df(seq(.001,15,length.out=500),d1,d2),
     type='l',lwd=3,col='#0369a1',xlab='B/A variance ratio',ylab='Density',main='Choose alpha before seeing results')
abline(v=c(bounds,f),lty=c(2,2,1),col=c('#64748b','#64748b','#b45309'))
""" ; cd:authoredResource true .
  ex:tf-cal-code a cd:CodeExample ; skos:prefLabel "Nested calibration models on identical synthetic observations"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-f-distribution ; cd:code """# Fixed design; constructed noise illustrates calculation, not validation evidence.
x <- seq(0,10,length.out=12) # mg/L, assumed error-free here
curvature <- .025 # Try zero; one realization cannot establish error rates.
noise <- c(-.12,.08,.03,-.06,.10,-.02,-.09,.05,.02,-.08,.11,-.04)
y <- 1+2*x+curvature*x^2+noise # response, arbitrary units
simple <- lm(y~x); complex <- lm(y~x+I(x^2))
rssS <- sum(resid(simple)^2); rssC <- sum(resid(complex)^2)
pS <- length(coef(simple)); pC <- length(coef(complex)); n <- length(y)
addedSS <- rssS-rssC
f <- (addedSS/(pC-pS))/(rssC/(n-pC))
p <- pf(f,pC-pS,n-pC,lower.tail=FALSE)
cat('RSS simple / complex:',rssS,rssC,'added SS:',addedSS,'\n')
cat('Ordered df:',pC-pS,n-pC,'F:',f,'upper-tail p:',p,'\n')
print(anova(simple,complex))
cat('The RSS values are dependent; under the null, added SS and complex residual SS are independent.\n')
old <- par(mfrow=c(1,2),mar=c(5,4,3,1))
plot(x,y,xlab='Concentration (mg/L)',ylab='Response (a.u.)',main='Same calibration points')
lines(x,fitted(simple),col='#b45309',lwd=2); lines(x,fitted(complex),col='#0369a1',lwd=2)
legend('topleft',c('Linear','Quadratic'),col=c('#b45309','#0369a1'),lwd=2)
plot(x,resid(simple),ylim=range(c(resid(simple),resid(complex))),
     xlab='Concentration (mg/L)',ylab='Residual (a.u.)',main='Residual structure')
points(x,resid(complex),pch=17,col='#0369a1'); abline(h=0,lty=2)
par(old)
""" ; cd:authoredResource true .
  ex:tf-assume-code a cd:CodeExample ; skos:prefLabel "Stress the error model, not just the decision threshold"@en ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l5-student-t, ex:l5-f-distribution ; cd:code """set.seed(20261106)
mode <- 'normal' # Try 'outlier' and 'drift'.
stopifnot(mode %in% c('normal','outlier','drift'))
A <- 10+rnorm(6,0,.10); B <- 10+rnorm(6,0,.10)
if(mode=='outlier') B[6] <- B[6]+.8
if(mode=='drift') {A <- A+seq(0,.5,length.out=6); B <- B+seq(0,.5,length.out=6)}
t <- (mean(A)-10)/(sd(A)/sqrt(length(A)))
f <- var(B)/var(A)
ptwo <- 2*pt(-abs(t),5)
pfTwo <- min(1,2*min(pf(f,5,5),pf(f,5,5,lower.tail=FALSE)))
cat('Mode:',mode,'t:',t,'nominal two-sided p:',ptwo,'B/A F:',f,'nominal two-sided p:',pfTwo,'\n')
cat('Under contamination or drift these reference p-values need not be calibrated.\n')
cat('One changed realization demonstrates sensitivity, not a measured Type I error rate.\n')
plot(1:6,A,type='b',ylim=range(c(A,B)),xlab='Acquisition order',ylab='Nitrate (mg/L)',main=paste('Error model:',mode))
lines(1:6,B,type='b',pch=17,col='#0369a1'); abline(h=10,lty=2)
legend('topleft',c('A','B'),pch=c(1,17),col=c('black','#0369a1'))
""" ; cd:authoredResource true .
}
