@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix cdm: <https://w3id.org/project-chemie-digital/meta/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
<https://w3id.org/project-chemie-digital/graph/ontology/optional-material> {
 cd:LearningDomain cdm:definesAttribute cd:optionalMaterial .
 cd:optionalMaterial a rdf:Property, cdm:AttributeDescriptor ; rdfs:domain cd:SceneItem ; rdfs:range xsd:boolean ; rdfs:label "Optional supporting material"@en .
}
<https://w3id.org/project-chemie-digital/graph/shapes/optional-material> {
 cd:OptionalMaterialShape a sh:NodeShape ; sh:targetSubjectsOf cd:optionalMaterial ; sh:class cd:SceneItem ;
  sh:property [ sh:path cd:optionalMaterial ; sh:minCount 1 ; sh:maxCount 1 ; sh:datatype xsd:boolean ] ;
  sh:property [ sh:path cd:communicativeRole ; sh:hasValue cd:MediaRole ] ;
  sh:property [ sh:path cd:selectsResource ; sh:minCount 1 ; sh:maxCount 1 ; sh:class cd:MediaAsset ] ;
  sh:property [ sh:path cd:revealAtStage ; sh:maxCount 0 ] ;
  sh:property [ sh:path cd:revealOn ; sh:maxCount 0 ] .
}
