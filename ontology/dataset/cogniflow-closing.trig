@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-closing> {
  ex:cogniflow-closing a cd:Concept ;
    skos:prefLabel "Thank you for your attention"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-standardized-data-processing> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-closing .

  ex:path-step-cogniflow-closing a cd:PathStep ;
    cd:position 16 ;
    cd:usesResource ex:cogniflow-closing ;
    cd:usesScene ex:scene-cogniflow-closing ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-closing> {
  ex:scene-cogniflow-closing a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-closing ;
    cd:hasSceneItem ex:scene-item-cogniflow-closing-heading ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-closing-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-closing ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .
}
