  ex:vm-helper a cd:Interpretation ; skos:prefLabel "The Expected Squared Shift of the Mean"@en ; dct:source ex:vr-expect-formula ; cd:authoredResource true .
  ex:vm-var-symbol a cd:MathSymbol ; cd:symbol "Var" ; cd:body "Variance: expected squared deviation of a random quantity from its expectation."@en ; cd:authoredResource true .
  ex:vm-helper-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\operatorname{E}[\\bar X]=\\mu,\\qquad\\operatorname{Var}(\\bar X)=\\frac{\\sigma^2}{n}\\\\\\operatorname{E}[(\\bar X-\\mu)^2]=\\frac{\\sigma^2}{n}\\\\\\Delta=\\bar X-\\mu\\quad\\Longrightarrow\\quad\\operatorname{E}[n\\Delta^2]=\\sigma^2\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:vr-Xbar-symbol, ex:mu-symbol, ex:vm-var-symbol, ex:vr-sigma2-symbol, ex:n-symbol, ex:vs-Delta-symbol ; dct:hasPart ex:vv-helper-legend ; cd:authoredResource true .
  ex:vm-helper-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vm-hl1, ex:vm-hl2, ex:vm-hl3 ; cd:authoredResource true .
  ex:vm-hl1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random mean and fixed parameters"@en ; cd:body "X̄: random sample mean before observing data; observed value: x̄. μ: fixed population mean; σ²: finite population variance; n: sample size greater than 1."@en ; cd:authoredResource true .
  ex:vm-hl2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Expectation and variance"@en ; cd:body "E: repeated-sampling expectation; Var: expected squared distance from that expectation. Independent, identically distributed observations give E(X̄) = μ and Var(X̄) = σ²/n."@en ; cd:authoredResource true .
  ex:vm-hl3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "The needed offset term"@en ; cd:body "Δ = X̄ − μ: shared random shift. Since E(X̄) = μ, its expected square is Var(X̄). Multiply by fixed n to obtain σ². This is the auxiliary result needed for Bessel's correction; normality is not required."@en ; cd:authoredResource true .

  ex:vm-recap a cd:Interpretation ; skos:prefLabel "Theory Explains the Monte Carlo Shortfall"@en ; cd:hasKeyPoint ex:vm-rk1, ex:vm-rk2 ; dct:source ex:vr-expect-formula, ex:vs-mc-code ; cd:authoredResource true .
  ex:vm-rk1 a cd:KeyPoint ; cd:position 1 ; cd:body "The derived expectation explains downward bias. A small sample's MSD is also more variable; five individual estimates cannot reliably establish bias."@en ; cd:authoredResource true .
  ex:vm-rk2 a cd:KeyPoint ; cd:position 2 ; cd:body "Theory is exact under the sampling assumptions. Seed-1903 means from 5,000 samples per n are finite approximations, rounded to three decimals."@en ; cd:authoredResource true .
  ex:vm-compare a cd:TableDefinition ; skos:prefLabel "Expected MSD versus empirical average ((mg/L)²)"@en ; cd:hasTableColumn ex:vm-cc1, ex:vm-cc2, ex:vm-cc3 ; cd:hasTableRow ex:vm-cr2, ex:vm-cr3, ex:vm-cr5, ex:vm-cr10, ex:vm-cr25, ex:vm-cr50, ex:vm-cr100 ; dct:source ex:vs-theory-table, ex:vm-emp-table ; cd:authoredResource true .
