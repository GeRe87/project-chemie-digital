  ex:vm-empirical a cd:Interpretation ; skos:prefLabel "Many Samples: An Empirical Shortfall"@en ; cd:hasKeyPoint ex:vm-e1, ex:vm-e2, ex:vm-e3 ; dct:source ex:vs-model, ex:vs-mc-code ; cd:authoredResource true .
  ex:vm-e1 a cd:KeyPoint ; cd:position 1 ; cd:body "Known variance: 5 (mg/L)². Average MSD remains below it, especially at small n."@en ; cd:authoredResource true .
  ex:vm-e2 a cd:KeyPoint ; cd:position 2 ; cd:body "Seed 1903; 5,000 independent samples per size. Finite Monte-Carlo averages approximate, rather than equal, expectations."@en ; cd:authoredResource true .
  ex:vm-e3 a cd:KeyPoint ; cd:position 3 ; cd:body "Bias is a systematic error in expectation, not each estimate's random error. Why does fitting the mean reduce the squared deviations?"@en ; cd:authoredResource true .
