@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-standardized-data-processing> {
  ex:cogniflow-standardized-data-processing a cd:Concept ;
    skos:prefLabel "Standardized Data Processing - Project CogniFlow"@en ;
    cd:hasDefinition ex:def-cogniflow-standardized-data-processing ;
    cd:authoredResource true .

  ex:def-cogniflow-standardized-data-processing a cd:Definition ;
    cd:body "Standardized Data Processing - Project CogniFlow"@en ;
    cd:authoredResource true .

  ex:attribution-cogniflow-gerrit-renner a cd:Attribution ;
    cd:body "Gerrit Renner — Instrumental Analytical Chemistry, University of Duisburg-Essen"@en ;
    cd:authoredResource true .

  ex:attribution-cogniflow-ricardo-cunha a cd:Attribution ;
    cd:body "Ricardo Cunha — IUTA"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/courses/cogniflow-standardized-data-processing> {
  ex:teaching-offering-cogniflow-standardized-data-processing a cd:TeachingOffering ;
    skos:prefLabel "Standardized Data Processing - Project CogniFlow"@en ;
    cd:hasUnitPlacement ex:unit-placement-cogniflow-standardized-data-processing .

  ex:learning-unit-cogniflow-standardized-data-processing a cd:LearningUnit ;
    skos:prefLabel "Project CogniFlow presentation"@en ;
    cd:hasFocusConcept ex:cogniflow-standardized-data-processing .

  ex:unit-placement-cogniflow-standardized-data-processing a cd:UnitPlacement ;
    cd:position 1 ;
    cd:placesLearningUnit ex:learning-unit-cogniflow-standardized-data-processing .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-standardized-data-processing> {
  ex:path-cogniflow-standardized-data-processing a cd:LearningPath ;
    skos:prefLabel "Project CogniFlow presentation path"@en ;
    cd:forTopic ex:cogniflow-standardized-data-processing ;
    cd:forLearningUnit ex:learning-unit-cogniflow-standardized-data-processing ;
    cd:hasStep ex:path-step-cogniflow-title ;
    cd:authoredResource true .

  ex:path-step-cogniflow-title a cd:PathStep ;
    cd:position 1 ;
    cd:usesResource ex:attribution-cogniflow-gerrit-renner,
      ex:attribution-cogniflow-ricardo-cunha ;
    cd:usesScene ex:scene-cogniflow-title ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-standardized-data-processing> {
  ex:scene-cogniflow-title a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-standardized-data-processing ;
    cd:hasSceneItem ex:scene-item-cogniflow-title-heading,
      ex:scene-item-cogniflow-title-gerrit-renner,
      ex:scene-item-cogniflow-title-ricardo-cunha ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-title-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-standardized-data-processing ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-title-gerrit-renner a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:attribution-cogniflow-gerrit-renner ;
    cd:communicativeRole cd:AttributionRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-title-ricardo-cunha a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:attribution-cogniflow-ricardo-cunha ;
    cd:communicativeRole cd:AttributionRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
