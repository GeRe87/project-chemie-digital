@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

# Canonical Level 4 scientific knowledge only. No teaching paths, scenes, rendering or new predicates.
<https://w3id.org/project-chemie-digital/graph/specifications/level4-distribution-shape> {
  ex:statistical-parameter a cd:Concept ; skos:prefLabel "statistischer Populationsparameter"@de, "population parameter"@en ; skos:related ex:distribution, ex:sample ; cd:hasDefinition ex:l4-def-statistical-parameter ; cd:authoredResource true .
  ex:l4-def-statistical-parameter a cd:Definition ; cd:body "A fixed characteristic of a specified population distribution, generally unknown when only a sample is observed. It is not the realized value of a sample statistic."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:sample-descriptor a cd:Concept ; skos:prefLabel "deskriptive Stichprobenkennzahl"@de, "sample descriptive statistic"@en ; skos:related ex:sample, ex:statistical-parameter ; cd:hasDefinition ex:l4-def-sample-descriptor ; cd:authoredResource true .
  ex:l4-def-sample-descriptor a cd:Definition ; cd:body "A function of the observed sample that summarizes those observations. Its descriptive definition alone does not make it an unbiased estimator of a population parameter."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:statistical-estimator a cd:Concept ; skos:prefLabel "statistischer Schätzer"@de, "statistical estimator"@en ; skos:related ex:sample-descriptor, ex:statistical-parameter ; cd:hasDefinition ex:l4-def-statistical-estimator ; cd:authoredResource true .
  ex:l4-def-statistical-estimator a cd:Definition ; cd:body "A sample-dependent rule intended to infer a specified population parameter under an explicit sampling model; target, assumptions and finite-sample properties must be stated separately."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:quantile-estimation-method a cd:Concept ; skos:prefLabel "Quantilberechnungsverfahren"@de, "sample-quantile calculation convention"@en ; skos:related ex:sample-quantile ; cd:hasDefinition ex:l4-def-quantile-estimation-method ; cd:authoredResource true .
  ex:l4-def-quantile-estimation-method a cd:Definition ; cd:body "A specified rule for turning sorted observations and a probability p into a sample quantile. Different conventions can return different results for the same sample."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:order-statistic a cd:Concept ; skos:prefLabel "Ordnungsstatistik"@de, "order statistic"@en ; cd:prerequisite ex:sample ; cd:hasDefinition ex:l4-def-order-statistic ; cd:hasMathExpression ex:l4-formula-order-statistic ; cd:authoredResource true .
  ex:l4-def-order-statistic a cd:Definition ; cd:body "The value at a specified rank after ordering n observed real values nondecreasingly; ties are retained and rank starts at one."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:empirical-cdf a cd:Concept ; skos:prefLabel "empirische Verteilungsfunktion"@de, "empirical cumulative distribution function"@en ; cd:prerequisite ex:order-statistic ; skos:related ex:distribution ; cd:hasDefinition ex:l4-def-empirical-cdf ; cd:hasMathExpression ex:l4-formula-empirical-cdf ; cd:authoredResource true .
  ex:l4-def-empirical-cdf a cd:Definition ; cd:body "The right-continuous step function giving the fraction of observed values less than or equal to each threshold x, with equal observation weights."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:population-quantile a cd:Concept ; skos:prefLabel "Populationsquantil"@de, "population quantile"@en ; skos:related ex:distribution, ex:sample-quantile ; skos:broader ex:statistical-parameter ; cd:hasDefinition ex:l4-def-population-quantile ; cd:hasMathExpression ex:l4-formula-population-quantile ; cd:authoredResource true .
  ex:l4-def-population-quantile a cd:Definition ; cd:body "For 0<p<1, the generalized inverse of a population cumulative distribution function F: the smallest threshold where F reaches at least p."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:sample-quantile a cd:Concept ; skos:prefLabel "Stichprobenquantil"@de, "sample quantile"@en ; cd:prerequisite ex:order-statistic ; skos:related ex:population-quantile, ex:quantile-estimation-method ; skos:broader ex:sample-descriptor ; cd:hasDefinition ex:l4-def-sample-quantile ; cd:hasInterpretation ex:l4-interpretation-missing-values ; cd:hasMisconception ex:l4-misconception-quantile-convention ; cd:authoredResource true .
  ex:l4-def-sample-quantile a cd:Definition ; cd:body "A value calculated from observed data at probability p using a declared quantile method; it can describe the sample or estimate a population quantile under sampling assumptions."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:sample-quantile-type-1 a cd:Concept ; skos:prefLabel "Stichprobenquantil Typ 1"@de, "type-1 sample quantile"@en ; cd:prerequisite ex:empirical-cdf, ex:sample-quantile ; skos:broader ex:quantile-estimation-method ; cd:hasDefinition ex:l4-def-sample-quantile-type-1 ; cd:hasMathExpression ex:l4-formula-sample-quantile-type-1 ; cd:authoredResource true .
  ex:l4-def-sample-quantile-type-1 a cd:Definition ; cd:body "R quantile type 1 is the inverse empirical CDF for 0<p≤1, returning an observed order statistic; by endpoint convention p=0 returns the minimum."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:sample-quantile-type-7 a cd:Concept ; skos:prefLabel "Stichprobenquantil Typ 7"@de, "type-7 sample quantile"@en ; cd:prerequisite ex:order-statistic, ex:sample-quantile ; skos:broader ex:quantile-estimation-method ; cd:hasDefinition ex:l4-def-sample-quantile-type-7 ; cd:hasMathExpression ex:l4-formula-sample-quantile-type-7 ; cd:authoredResource true .
  ex:l4-def-sample-quantile-type-7 a cd:Definition ; cd:body "R quantile type 7 is piecewise linear interpolation between adjacent order statistics at probability knots (k-1)/(n-1); it is the default R quantile method."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:quartile a cd:Concept ; skos:prefLabel "Quartil"@de, "quartile"@en ; cd:prerequisite ex:sample-quantile ; skos:related ex:median ; cd:hasDefinition ex:l4-def-quartile ; cd:hasInterpretation ex:l4-interpretation-quartile-method ; cd:authoredResource true .
  ex:l4-def-quartile a cd:Definition ; cd:body "The first, second and third quartiles correspond to p=0.25, 0.50 and 0.75; computed sample quartiles require the same explicitly chosen quantile convention."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:percentile a cd:Concept ; skos:prefLabel "Perzentil"@de, "percentile"@en ; cd:prerequisite ex:sample-quantile ; cd:hasDefinition ex:l4-def-percentile ; cd:authoredResource true .
  ex:l4-def-percentile a cd:Definition ; cd:body "The kth percentile is a quantile corresponding to probability p=k/100; its sample computation depends on the selected method."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:interquartile-range a cd:Concept ; skos:prefLabel "Interquartilsabstand"@de, "interquartile range"@en ; cd:prerequisite ex:quartile ; skos:related ex:statistical-dispersion ; cd:hasDefinition ex:l4-def-interquartile-range ; cd:hasMathExpression ex:l4-formula-interquartile-range ; cd:authoredResource true .
  ex:l4-def-interquartile-range a cd:Definition ; cd:body "The upper quartile minus the lower quartile, using one consistent quartile convention. For R IQR(x) the default quartiles are quantile type 7, not Tukey hinges."@en ; cd:hasSource ex:l4-source-r-iqr ; cd:authoredResource true .
  ex:median-absolute-deviation a cd:Concept ; skos:prefLabel "Median der absoluten Abweichungen"@de, "raw median absolute deviation"@en ; cd:prerequisite ex:median ; skos:related ex:interquartile-range, ex:statistical-dispersion ; cd:hasDefinition ex:l4-def-median-absolute-deviation ; cd:hasMathExpression ex:l4-formula-median-absolute-deviation ; cd:authoredResource true .
  ex:l4-def-median-absolute-deviation a cd:Definition ; cd:body "The median of the absolute differences between observations and their sample median; the raw statistic is not automatically scaled to estimate standard deviation."@en ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:normal-scaled-mad a cd:Concept ; skos:prefLabel "normal-skaliertes MAD"@de, "normal-scaled median absolute deviation"@en ; cd:prerequisite ex:median-absolute-deviation ; cd:hasDefinition ex:l4-def-normal-scaled-mad ; cd:hasMathExpression ex:l4-formula-normal-scaled-mad ; cd:hasInterpretation ex:l4-interpretation-mad-consistency ; cd:hasMisconception ex:l4-misconception-mad-unscaled ; cd:authoredResource true .
  ex:l4-def-normal-scaled-mad a cd:Definition ; cd:body "The raw MAD multiplied by approximately 1.4826, the reciprocal of the standard normal 0.75-quantile; this is asymptotically normal-consistent, not generally finite-sample unbiased."@en ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:robust-statistic a cd:Concept ; skos:prefLabel "robuste Kennzahl"@de, "robust statistic"@en ; skos:related ex:median, ex:median-absolute-deviation, ex:interquartile-range ; cd:hasDefinition ex:l4-def-robust-statistic ; cd:authoredResource true .
  ex:l4-def-robust-statistic a cd:Definition ; cd:body "A descriptive measure or estimator with limited sensitivity to some forms of contamination, relative to a specified perturbation criterion. Robust does not mean unaffected by every outlier."@en ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:boxplot a cd:Concept ; skos:prefLabel "Boxplot"@de, "boxplot"@en ; skos:related ex:quartile, ex:interquartile-range, ex:potential-outlier ; cd:hasDefinition ex:l4-def-boxplot ; cd:hasInterpretation ex:l4-interpretation-boxplot-whisker ; cd:authoredResource true .
  ex:l4-def-boxplot a cd:Definition ; cd:body "A graphical summary of a center, two hinges or quartiles, whiskers and separately marked observations according to a stated plotting convention. Whiskers need not be sample extrema."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:tukey-hinge a cd:Concept ; skos:prefLabel "Tukey-Scharnier"@de, "Tukey hinge"@en ; skos:related ex:quartile, ex:boxplot ; cd:hasDefinition ex:l4-def-tukey-hinge ; cd:authoredResource true .
  ex:l4-def-tukey-hinge a cd:Definition ; cd:body "A lower or upper hinge in Tukey's five-number summary. R boxplot.stats uses hinges that may differ from R type-7 quartiles for even sample sizes."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:outlier-fence a cd:Concept ; skos:prefLabel "Ausreißergrenze nach Tukey"@de, "Tukey outlier fence"@en ; cd:prerequisite ex:interquartile-range ; skos:related ex:tukey-hinge, ex:potential-outlier ; cd:hasDefinition ex:l4-def-outlier-fence ; cd:hasMathExpression ex:l4-formula-outlier-fence ; cd:authoredResource true .
  ex:l4-def-outlier-fence a cd:Definition ; cd:body "For the conventional 1.5×IQR rule, lower and upper reference limits around the chosen hinges or quartiles. The underlying convention must be declared."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:potential-outlier a cd:Concept ; skos:prefLabel "potenziell auffälliger Wert"@de, "potential outlier"@en ; skos:related ex:outlier-fence ; cd:hasDefinition ex:l4-def-potential-outlier ; cd:hasInterpretation ex:l4-interpretation-outlier-diagnosis ; cd:hasMisconception ex:l4-misconception-outlier-is-error ; cd:authoredResource true .
  ex:l4-def-potential-outlier a cd:Definition ; cd:body "An observation beyond a declared diagnostic fence. A flag is not evidence by itself that the value is erroneous or should be deleted."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:raw-moment a cd:Concept ; skos:prefLabel "rohes Moment"@de, "raw moment"@en ; skos:related ex:expected-value, ex:central-moment ; cd:hasDefinition ex:l4-def-raw-moment ; cd:hasMathExpression ex:l4-formula-raw-moment ; cd:authoredResource true .
  ex:l4-def-raw-moment a cd:Definition ; cd:body "The rth raw population moment is E[X^r] if the corresponding absolute moment is finite; for r=1 it is the expected value."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:central-moment a cd:Concept ; skos:prefLabel "zentrales Moment"@de, "central moment"@en ; cd:prerequisite ex:raw-moment ; skos:related ex:variance, ex:expected-value ; cd:hasDefinition ex:l4-def-central-moment ; cd:hasMathExpression ex:l4-formula-central-moment ; cd:authoredResource true .
  ex:l4-def-central-moment a cd:Definition ; cd:body "The rth central population moment is E[(X−μ)^r] about the population mean μ. The first is zero and the second is the population variance when the moments exist."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:empirical-central-moment a cd:Concept ; skos:prefLabel "empirisches zentrales Moment"@de, "empirical central moment"@en ; cd:prerequisite ex:arithmetic-mean ; skos:related ex:central-moment, ex:sample-variance ; skos:broader ex:sample-descriptor ; cd:hasDefinition ex:l4-def-empirical-central-moment ; cd:hasMathExpression ex:l4-formula-empirical-central-moment ; cd:hasInterpretation ex:l4-interpretation-variance-denominator ; cd:authoredResource true .
  ex:l4-def-empirical-central-moment a cd:Definition ; cd:body "For a finite observed sample, mr=(1/n)Σ(xi−xbar)^r. This is a descriptive quantity; m2 is not the Bessel-corrected sample variance."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:standardized-central-moment a cd:Concept ; skos:prefLabel "standardisiertes zentrales Moment"@de, "standardized central moment"@en ; cd:prerequisite ex:central-moment, ex:variance ; cd:hasDefinition ex:l4-def-standardized-central-moment ; cd:hasMathExpression ex:l4-formula-standardized-central-moment ; cd:hasInterpretation ex:l4-interpretation-zero-dispersion ; cd:authoredResource true .
  ex:l4-def-standardized-central-moment a cd:Definition ; cd:body "The rth central population moment divided by σ^r, requiring σ>0 and the relevant finite moment; for r=3 and r=4 it yields skewness and non-excess kurtosis."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:skewness a cd:Concept ; skos:prefLabel "Schiefe"@de, "population skewness"@en ; cd:prerequisite ex:standardized-central-moment ; skos:related ex:distribution ; skos:broader ex:statistical-parameter ; cd:hasDefinition ex:l4-def-skewness ; cd:hasMathExpression ex:l4-formula-skewness ; cd:hasInterpretation ex:l4-interpretation-shape-limits ; cd:hasMisconception ex:l4-misconception-zero-skew-symmetry ; cd:authoredResource true .
  ex:l4-def-skewness a cd:Definition ; cd:body "The third standardized central population moment γ1=μ3/σ³. Its sign describes the direction of moment-based asymmetry, but zero skewness alone does not prove symmetry."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:kurtosis a cd:Concept ; skos:prefLabel "Kurtosis"@de, "population kurtosis"@en ; cd:prerequisite ex:standardized-central-moment ; skos:broader ex:statistical-parameter ; cd:hasDefinition ex:l4-def-kurtosis ; cd:hasMathExpression ex:l4-formula-kurtosis ; cd:hasInterpretation ex:l4-interpretation-kurtosis-limits ; cd:hasMisconception ex:l4-misconception-kurtosis-peak ; cd:authoredResource true .
  ex:l4-def-kurtosis a cd:Definition ; cd:body "The fourth standardized central population moment β2=μ4/σ⁴, defined for nonzero variance and finite fourth moment; it is sensitive to extreme deviations and is not simply peak height."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:excess-kurtosis a cd:Concept ; skos:prefLabel "Exzess-Kurtosis"@de, "population excess kurtosis"@en ; cd:prerequisite ex:kurtosis ; cd:hasDefinition ex:l4-def-excess-kurtosis ; cd:hasMathExpression ex:l4-formula-excess-kurtosis ; cd:authoredResource true .
  ex:l4-def-excess-kurtosis a cd:Definition ; cd:body "Population kurtosis minus three. Under the normal model it is zero; excess kurtosis and unadjusted kurtosis are not interchangeable."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:sample-skewness a cd:Concept ; skos:prefLabel "empirische Schiefe"@de, "descriptive sample skewness"@en ; cd:prerequisite ex:empirical-central-moment ; skos:related ex:skewness, ex:moment-estimation-convention ; skos:broader ex:sample-descriptor ; cd:hasDefinition ex:l4-def-sample-skewness ; cd:hasMathExpression ex:l4-formula-sample-skewness ; cd:authoredResource true .
  ex:l4-def-sample-skewness a cd:Definition ; cd:body "For the declared unadjusted Fisher–Pearson convention, g1=m3/m2^(3/2), requiring m2>0. Bias-adjusted sample skewness is a different convention."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:sample-excess-kurtosis a cd:Concept ; skos:prefLabel "empirischer Kurtosis-Exzess"@de, "descriptive sample excess kurtosis"@en ; cd:prerequisite ex:empirical-central-moment ; skos:related ex:excess-kurtosis, ex:moment-estimation-convention ; skos:broader ex:sample-descriptor ; cd:hasDefinition ex:l4-def-sample-excess-kurtosis ; cd:hasMathExpression ex:l4-formula-sample-excess-kurtosis ; cd:authoredResource true .
  ex:l4-def-sample-excess-kurtosis a cd:Definition ; cd:body "For the declared unadjusted descriptive convention, g2=m4/m2²−3 with m2>0. Software bias corrections may instead report another estimator."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:moment-estimation-convention a cd:Concept ; skos:prefLabel "Berechnungskonvention für Stichprobenmomente"@de, "sample-moment computation convention"@en ; skos:related ex:sample-variance, ex:empirical-central-moment ; cd:hasDefinition ex:l4-def-moment-estimation-convention ; cd:hasInterpretation ex:l4-interpretation-moment-sample-correction ; cd:hasMisconception ex:l4-misconception-n-minus-one-all ; cd:authoredResource true .
  ex:l4-def-moment-estimation-convention a cd:Definition ; cd:body "The chosen normalization and any finite-sample adjustment for moments, skewness or kurtosis. Using n−1 is justified for the usual unbiased variance estimator under its assumptions, not as a universal higher-moment rule."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:distribution-symmetry a cd:Concept ; skos:prefLabel "Symmetrie einer Verteilung"@de, "distribution symmetry"@en ; skos:related ex:skewness, ex:distribution ; cd:hasDefinition ex:l4-def-distribution-symmetry ; cd:authoredResource true .
  ex:l4-def-distribution-symmetry a cd:Definition ; cd:body "A distribution is symmetric about a center c when X−c and c−X have the same distribution; zero third moment, when it exists, is necessary but not sufficient for symmetry."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:moment-existence a cd:Concept ; skos:prefLabel "Existenz eines Moments"@de, "moment existence"@en ; skos:related ex:raw-moment, ex:central-moment, ex:kurtosis ; cd:hasDefinition ex:l4-def-moment-existence ; cd:hasInterpretation ex:l4-interpretation-moment-domain ; cd:authoredResource true .
  ex:l4-def-moment-existence a cd:Definition ; cd:body "The rth absolute population moment E[|X|^r] must be finite for the usual finite rth raw and central moments to be well-defined. Skewness requires a finite third moment and kurtosis a finite fourth moment with nonzero variance."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .

  ex:l4-formula-order-statistic a cd:MathExpression ; cd:latex "x_{(1)}\\le\\cdots\\le x_{(n)}" ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-formula-empirical-cdf a cd:MathExpression ; cd:latex "F_n(x)=\\frac1n\\sum_{i=1}^{n}\\mathbf{1}\\{x_i\\le x\\}" ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-formula-population-quantile a cd:MathExpression ; cd:latex "Q(p)=\\inf\\{x:F(x)\\ge p\\},\\quad 0<p<1" ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-formula-sample-quantile-type-1 a cd:MathExpression ; cd:latex "\\widehat Q_1(p)=\\inf\\{x:F_n(x)\\ge p\\},\\quad 0<p\\le 1" ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-formula-sample-quantile-type-7 a cd:MathExpression ; cd:latex "\\begin{gathered}h=1+(n-1)p,\\ j=\\lfloor h\\rfloor,\\ \\delta=h-j\\\\\\widehat Q_7(p)=(1-\\delta)x_{(j)}+\\delta x_{(j+1)}\\end{gathered}" ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-formula-interquartile-range a cd:MathExpression ; cd:latex "\\mathrm{IQR}=Q(0.75)-Q(0.25)" ; cd:hasSource ex:l4-source-r-iqr ; cd:authoredResource true .
  ex:l4-formula-median-absolute-deviation a cd:MathExpression ; cd:latex "\\mathrm{MAD}_{\\mathrm{raw}}=\\mathrm{median}_i\\left|x_i-\\mathrm{median}_j(x_j)\\right|" ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:l4-formula-normal-scaled-mad a cd:MathExpression ; cd:latex "\\mathrm{MAD}_{N}\\approx1.4826\\,\\mathrm{MAD}_{\\mathrm{raw}}" ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:l4-formula-outlier-fence a cd:MathExpression ; cd:latex "L=Q_1-1.5\\,\\mathrm{IQR},\\quad U=Q_3+1.5\\,\\mathrm{IQR}" ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:l4-formula-raw-moment a cd:MathExpression ; cd:latex "\\mu'_r=\\operatorname E[X^r]" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-central-moment a cd:MathExpression ; cd:latex "\\mu_r=\\operatorname E[(X-\\mu)^r],\\quad\\mu=\\operatorname E[X]" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-empirical-central-moment a cd:MathExpression ; cd:latex "m_r=\\frac1n\\sum_{i=1}^{n}(x_i-\\bar x)^r" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-standardized-central-moment a cd:MathExpression ; cd:latex "\\frac{\\mu_r}{\\sigma^r},\\quad\\sigma>0" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-skewness a cd:MathExpression ; cd:latex "\\gamma_1=\\frac{\\mu_3}{\\sigma^3}" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-kurtosis a cd:MathExpression ; cd:latex "\\beta_2=\\frac{\\mu_4}{\\sigma^4}" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-excess-kurtosis a cd:MathExpression ; cd:latex "\\gamma_2=\\beta_2-3" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-sample-skewness a cd:MathExpression ; cd:latex "g_1=\\frac{m_3}{m_2^{3/2}}" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-formula-sample-excess-kurtosis a cd:MathExpression ; cd:latex "g_2=\\frac{m_4}{m_2^2}-3" ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .

  ex:l4-interpretation-quartile-method a cd:Interpretation ; skos:prefLabel "quartile method"@en ; cd:body "Quantile, quartile and IQR values require a specified method. R IQR defaults to type 7; R boxplot.stats uses Tukey hinges, which may differ for even n."@en ; cd:hasSource ex:l4-source-r-iqr ; cd:authoredResource true .
  ex:l4-interpretation-boxplot-whisker a cd:Interpretation ; skos:prefLabel "boxplot whisker"@en ; cd:body "Under the 1.5 IQR rule, whiskers end at the most extreme observed values still within the fences; they do not extend to the numerical fence itself. Other boxplot conventions exist."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:l4-interpretation-outlier-diagnosis a cd:Interpretation ; skos:prefLabel "outlier diagnosis"@en ; cd:body "A fence flag warrants investigation of analytical conditions, transcription, contamination and sampling context; it does not authorize deleting an observation."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:l4-interpretation-missing-values a cd:Interpretation ; skos:prefLabel "missing values"@en ; cd:body "Define the treatment of missing, non-finite and censored measurements before computing sample quantiles, moments or diagnostics; blindly deleting censored results can bias summaries."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-interpretation-mad-consistency a cd:Interpretation ; skos:prefLabel "mad consistency"@en ; cd:body "The ~1.4826 factor is chosen for consistency under a Gaussian population model as sample size grows; it is not an exact universal finite-sample correction."@en ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:l4-interpretation-variance-denominator a cd:Interpretation ; skos:prefLabel "variance denominator"@en ; cd:body "The uncorrected m2 has denominator n; for n>1 the conventional Bessel-corrected sample variance is s²=n m2/(n−1). The unbiasedness interpretation assumes independent identically distributed observations with finite population variance."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-interpretation-moment-sample-correction a cd:Interpretation ; skos:prefLabel "moment sample correction"@en ; cd:body "Different libraries report descriptive coefficients or finite-sample-adjusted variants. The n−1 correction for variance does not directly generalize to skewness or kurtosis."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-interpretation-shape-limits a cd:Interpretation ; skos:prefLabel "shape limits"@en ; cd:body "Moment-based skewness may vanish in asymmetric distributions. It can be strongly affected by rare large observations; its sign alone is not a complete distribution shape description."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-interpretation-kurtosis-limits a cd:Interpretation ; skos:prefLabel "kurtosis limits"@en ; cd:body "Kurtosis weighs fourth powers of standardized deviations; it is influenced by extremes and tail behavior but does not uniquely determine tail probabilities, modality, or the height of the density at its mode."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-interpretation-moment-domain a cd:Interpretation ; skos:prefLabel "moment domain"@en ; cd:body "The formula needs the relevant finite absolute population moment; a finite observed-sample moment does not establish that the corresponding population moment exists."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-interpretation-zero-dispersion a cd:Interpretation ; skos:prefLabel "zero dispersion"@en ; cd:body "When the variance or empirical second central moment is zero, standardized skewness and kurtosis are undefined; do not display zero as an arbitrary replacement."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .

  ex:l4-misconception-quantile-convention a cd:Misconception ; cd:body "All standard software packages compute exactly the same sample quartile."@en ; cd:hasCorrection ex:l4-correction-quantile-convention ; cd:authoredResource true .
  ex:l4-correction-quantile-convention a cd:Correction ; cd:body "R quantile methods differ. State the numerical convention, including endpoint and missing-value behavior."@en ; cd:hasSource ex:l4-source-r-quantile ; cd:authoredResource true .
  ex:l4-misconception-outlier-is-error a cd:Misconception ; cd:body "Any observation beyond a boxplot whisker is a wrong measurement."@en ; cd:hasCorrection ex:l4-correction-outlier-is-error ; cd:authoredResource true .
  ex:l4-correction-outlier-is-error a cd:Correction ; cd:body "The fence is a diagnostic flag, not an error verdict. Investigate measurement and sampling context before exclusions."@en ; cd:hasSource ex:l4-source-r-boxplot ; cd:authoredResource true .
  ex:l4-misconception-mad-unscaled a cd:Misconception ; cd:body "R mad(x) returns the raw median absolute deviation."@en ; cd:hasCorrection ex:l4-correction-mad-unscaled ; cd:authoredResource true .
  ex:l4-correction-mad-unscaled a cd:Correction ; cd:body "R mad(x) uses constant=1.4826 by default. Request constant=1 for the raw MAD."@en ; cd:hasSource ex:l4-source-r-mad ; cd:authoredResource true .
  ex:l4-misconception-n-minus-one-all a cd:Misconception ; cd:body "Every empirical central moment should use n−1 to remove bias."@en ; cd:hasCorrection ex:l4-correction-n-minus-one-all ; cd:authoredResource true .
  ex:l4-correction-n-minus-one-all a cd:Correction ; cd:body "The sample descriptive moment mr uses denominator n. The special variance estimator correction and any skewness/kurtosis adjustments have distinct derivations and assumptions."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-misconception-zero-skew-symmetry a cd:Misconception ; cd:body "Skewness equal to zero proves that the entire distribution is symmetric."@en ; cd:hasCorrection ex:l4-correction-zero-skew-symmetry ; cd:authoredResource true .
  ex:l4-correction-zero-skew-symmetry a cd:Correction ; cd:body "Symmetry with a finite third moment implies zero skewness, but the converse is false."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
  ex:l4-misconception-kurtosis-peak a cd:Misconception ; cd:body "High kurtosis means the probability density necessarily has a high central peak."@en ; cd:hasCorrection ex:l4-correction-kurtosis-peak ; cd:authoredResource true .
  ex:l4-correction-kurtosis-peak a cd:Correction ; cd:body "Kurtosis is a standardized fourth central moment and does not directly measure central peak height or uniquely specify a tail shape."@en ; cd:hasSource ex:l4-source-nist-skew-kurt ; cd:authoredResource true .
}

