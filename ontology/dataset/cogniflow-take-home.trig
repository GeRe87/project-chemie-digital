@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-take-home> {
  ex:cogniflow-take-home a cd:Concept ;
    skos:prefLabel "Take Home"@en ;
    cd:hasDefinition ex:def-cogniflow-take-home ;
    cd:authoredResource true .

  ex:def-cogniflow-take-home a cd:Definition ;
    cd:body "CogniFlow standardizes meaning rather than implementations: semantics define the shared model, services provide replaceable capabilities, and those capabilities compose into reusable workflows."@en ;
    cd:authoredResource true .

  ex:cogniflow-take-home-vision a cd:Interpretation ;
    cd:body "Standardize meaning — not implementations."@en ;
    cd:authoredResource true .

  ex:cogniflow-take-home-chain a cd:Interpretation ;
    cd:body "The CogniFlow vision in three steps."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-take-home-semantics,
      ex:keypoint-cogniflow-take-home-services,
      ex:keypoint-cogniflow-take-home-workflows ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-take-home-semantics a cd:KeyPoint ;
    cd:position 1 ;
    cd:body "SEMANTICS"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-take-home-services a cd:KeyPoint ;
    cd:position 2 ;
    cd:body "SERVICES"@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-take-home-workflows a cd:KeyPoint ;
    cd:position 3 ;
    cd:body "REUSABLE WORKFLOWS"@en ;
    cd:authoredResource true .

  ex:cogniflow-take-home-install a cd:Interpretation ;
    cd:body """GET COGNIFLOW
pip install cogniflow"""@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-standardized-data-processing> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-take-home .

  ex:path-step-cogniflow-take-home a cd:PathStep ;
    cd:position 19 ;
    cd:usesResource ex:cogniflow-take-home-vision,
      ex:cogniflow-take-home-chain,
      ex:cogniflow-take-home-install ;
    cd:usesScene ex:scene-cogniflow-take-home ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-take-home> {
  ex:scene-cogniflow-take-home a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-take-home ;
    cd:hasSceneItem ex:scene-item-cogniflow-take-home-heading,
      ex:scene-item-cogniflow-take-home-vision,
      ex:scene-item-cogniflow-take-home-chain,
      ex:scene-item-cogniflow-take-home-install ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-take-home ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-vision a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-take-home-vision ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-chain a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-take-home-chain ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-take-home-install a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-take-home-install ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
