<https://w3id.org/project-chemie-digital/graph/data/talks-ted-schematic> {
  # Hand-authored teaching coordinates, not measured data or a polymer assignment.
  # No real retention times, ion masses, calibration slopes or detection limits.
  ex:ted-marker-chromatogram a cd:ChartDefinition ;
    skos:prefLabel "Schematic chromatogram — not measured data"@en ;
    cd:body "Synthetic trace · not measured data · no polymer assignment."@en ;
    cd:chartType cd:LineChart ; cd:xAxisLabel "Relative retention time"@en ;
    cd:yAxisLabel "Relative ion signal"@en ; cd:yAxisUnit "a.u." ;
    cd:usesDataset ex:ted-schematic-signal ;
    cd:hasChartAnnotation ex:ted-marker-candidate-a, ex:ted-marker-matrix, ex:ted-marker-area ;
    dct:references ex:ted-polymer-markers ; cd:hasSource ex:ted-source-method, ex:ted-source-review ; cd:authoredResource true .
  ex:ted-schematic-signal a cd:Dataset ; skos:prefLabel "Synthetic signal; no measured sample"@en ;
    dct:description "Illustrative coordinates only; arbitrary relative retention scale and arbitrary relative signal. No polymer identity or physical calibration can be inferred."@en ;
