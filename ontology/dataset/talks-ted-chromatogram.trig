  # Explicit synthetic teaching coordinates: 81 points per trace, no measurements.
  # EIC is a schematic selected ion channel, not a named compound or polymer.
  # Its signal stays below the TIC at each time; no independent rescaling.
  ex:ted-marker-chromatogram a cd:ChartDefinition ;
    skos:prefLabel "Schematic TIC → EIC: not measured data"@en ;
    cd:body "Synthetic TIC → selected EIC · no measured sample or polymer assignment."@en ;
    cd:chartType cd:LineChart ; cd:xAxisLabel "Relative retention time"@en ;
    cd:yAxisLabel "Relative ion signal"@en ; cd:yAxisUnit "a.u." ;
    # The annotations describe the selected EIC; the TIC is its contextual series.
    cd:usesDataset ex:ted-schematic-eic ; dct:hasPart ex:ted-schematic-signal ;
    cd:hasChartAnnotation ex:ted-select-eic, ex:ted-marker-candidate-a, ex:ted-marker-area ;
    dct:references ex:ted-polymer-markers ; cd:hasSource ex:ted-source-method, ex:ted-source-review ; cd:authoredResource true .

