<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-revisions> {
  ex:ted-scene-process-variance a cd:SceneDefinition ; cd:focusConcept ex:ted-process-variance ; cd:hasSceneItem ex:ted-variance-heading, ex:ted-variance-visual, ex:ted-variance-fit, ex:ted-variance-takeaway-item ; cd:narration "The sequence decompose, cool, capture, transfer, desorb, refocus and heat again creates multiple possible variability and recovery contributions. This is a causal illustration, not a measured variance decomposition. The left plot uses exactly standards 6–10, the second five-point block in the existing balanced SBR display sequence, without altering their values. Its linear fit with intercept gives a coefficient of determination of 0.7408299948. This selected illustration is not a representative method comparison. The right plot is artificial and deliberately tight (0.990), not a measured UV-visible data set. Dilute photometric solutions can produce very tight fits, but their performance is not transferable to this multistage process. In the speaker's experience TED calibrations around 0.7 occur; no frequency or universal acceptance criterion is supplied. Plan multiple determinations and quantify prediction uncertainty. A low fit coefficient does not by itself prove random noise or justify accepting an unsuitable calibration. Replication does not fix bias, carryover, interference or poor calibration design."@en ; cd:authoredResource true .
  ex:ted-variance-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-process-variance ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-variance-visual a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-variance-image ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-variance-fit a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-variance-fit-label ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-variance-takeaway-item a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:ted-variance-takeaway ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-scene-temperature-program a cd:SceneDefinition ; cd:focusConcept ex:ted-temperature-program ; cd:hasSceneItem ex:ted-temp-heading, ex:ted-temp-chart-item, ex:ted-temp-bullets ; cd:narration "This is the actual supplied method export, separate from the illustrative optimized schedule. Hold 200 degrees Celsius for 2 minutes with nitrogen at 20 millilitres per minute; ramp at 10 kelvin per minute to 500 degrees Celsius, taking 30 minutes; hold for 6 minutes with nitrogen at 30 millilitres per minute. The axis shows 38 minutes of nominal programmed segments only. Conditional sample-temperature settling in the export uses a 5 kelvin band, 2 minutes and a 10-minute timeout for both hold segments. Those conditions, insertion, cooling, removal and reset are not included in the drawn time. Do not infer throughput or the previously discussed optimum heating rate from this distinct source."@en ; cd:authoredResource true .
  ex:ted-temp-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-temperature-program ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-temp-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-temperature-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-temp-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-temperature-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-scene-fifo-design a cd:SceneDefinition ; cd:focusConcept ex:ted-fifo-design ; cd:hasSceneItem ex:ted-fifo-heading, ex:ted-fifo-chart-item, ex:ted-fifo-bullets ; cd:narration "Adapted from the supplied Running Calibration slide, not a new experiment. FIFO means first in, first out. Compare recursive interval-halving with cyclic reuse, one fixed shuffled cycle and independent random masses. The source reports 16000 synthetic campaigns per scenario with a stationary slope and no sample-signal noise. The target correlation is about 0.7, which is not a coefficient of determination of 0.7. Error is the 95th percentile absolute inverse-prediction mass error among fits passing an illustrative slope threshold greater than 0.15; excluded fits are not represented. Only sizes 5, 15 and 30 have exact values in the supplied notes, so the chart omits unsupported sizes 10 and 20. At 15 the errors are 0.2637, 0.2617 and 0.2860 normalized mass units. Order matters less as the window grows, but the strategies are not identical. This supports a practical 15-standard working choice within these assumptions, not a universal optimum or proof of drift robustness. Under drift, adding older standards can become harmful. Simulation code and a seed were not supplied, so the original Monte Carlo has not been independently reproduced. Maintain blanks, replicates and independent quality-control checks."@en ; cd:authoredResource true .
  ex:ted-fifo-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-fifo-design ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-fifo-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-fifo-design-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-fifo-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-fifo-design-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
