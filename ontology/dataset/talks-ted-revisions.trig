<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-revisions> {
  ex:ted-source-revision-notes a cd:Source ; dct:title "Speaker specification for the TED-GC-MS revision" ; dct:creator "Gerrit Renner" ; dct:identifier "issue-296/speaker-revision" ; dct:description "Speaker-reported instrument range 25–1000 degrees Celsius, partial gas-stream sampling and Twister reconditioning. These describe this setup, not universal recovery or an independently verified instrument specification. Reuse requires appropriate conditioning, blanks and carryover checks. The speaker reports calibrations around a coefficient of determination of 0.7; this is not a survey of methods or an acceptance threshold."@en ; cd:supportsResource ex:ted-heat-point-1, ex:ted-capture-point-1, ex:ted-capture-point-3, ex:ted-variance-definition ; cd:authoredResource true .
  ex:ted-source-tga-method a cd:Source ; dct:title "Supplied TGA method: 250114_Pyrolyse_Schulung" ; dct:identifier "Methode_TGA.txt" ; dct:hasVersion "sha256:188bd7f832032b75f4a6240246a3e2359eed0b11b7ffd184a57fac1cfef8c4d9" ; dct:description "Local STARe SW 18.00 export, method dated 2025-01-14 and export dated 2025-06-26. Segment 1: 200 degrees Celsius, 2 min, nitrogen 20 mL/min. Segment 2: 200 to 500 degrees Celsius at 10 K/min, nitrogen 30 mL/min. Segment 3: 500 degrees Celsius, 6 min, nitrogen 30 mL/min. Segments 1 and 3 include settling on sample temperature, bandwidth 5 K, time 2 min, timeout 10 min. The plotted 38 min are nominal programmed segments, excluding conditional settling, insertion, cooling, removal and reset. This is distinct from the earlier illustrative optimized schedule."@en ; cd:supportsResource ex:ted-temperature-definition, ex:ted-temperature-data ; cd:authoredResource true .
  ex:ted-source-fifo-slide a cd:Source ; dct:title "Speaker-supplied Running Calibration slide and notes" ; dct:identifier "Running_Calibration_Slide.pptx" ; dct:hasVersion "sha256:3a358efb956f16fb2cfe39c6f2e0f464ba02d7e84470d061ba63adc8f83a94c3" ; dct:description "Synthetic Monte Carlo summary: 16000 campaigns per scenario, ordinary least squares, target correlation about 0.7 (not coefficient of determination 0.7), true mass 0.8, 15 levels from 0.1 to 1.5 normalized mass units, one standard per day. 95th percentile of absolute inverse-prediction error conditional on valid fits, illustrative slope threshold greater than 0.15; noise-free sample signal and no drift. Only the three window sizes with exact numerical values in the notes (5, 15, 30) are transcribed. No simulation code or random seed was supplied, so these are source-transcribed results, not independently reproduced Monte Carlo evidence."@en ; cd:supportsResource ex:ted-fifo-design-definition, ex:ted-fifo-recursive, ex:ted-fifo-shuffled, ex:ted-fifo-random ; cd:authoredResource true .
  ex:ted-source-shacl-slide a cd:Source ; dct:title "Speaker-supplied SHACL validation example" ; dct:identifier "TED_GCMS_SHACL_Validation_Example.pptx" ; dct:hasVersion "sha256:14f65bd10d05935e60d393a55b5fcc0eab943b2d98e75ff84c865e1d6f1a5a0c" ; dct:description "Two-stage teaching example: PeakVector output connected first to IntegerValue input (failure), then to PeakVector input (pass). Simplified example vocabulary, not asserted production-service IRIs. The companion named RDF graphs and untargeted SHACL shape are exercised independently in regression tests. Explicit revisions and timestamps record changes; RDF and SHACL do not create a version history automatically."@en ; cd:supportsResource ex:ted-validation-definition ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-revisions> {
  ex:ted-temperature-program a cd:Concept ; skos:prefLabel "Our TGA temperature program"@en ; cd:hasDefinition ex:ted-temperature-definition ; cd:hasSource ex:ted-source-tga-method ; cd:authoredResource true .
  ex:ted-temperature-definition a cd:Definition ; cd:body "The supplied program holds 200 degrees Celsius for 2 minutes, heats to 500 degrees Celsius at 10 kelvin per minute (30 minutes), then holds 500 degrees Celsius for 6 minutes. The nominal segment total is 38 minutes. Nitrogen flow changes from 20 to 30 millilitres per minute after the first segment. Conditional sample-temperature settling, insertion, cooling and reset are excluded from the plotted time. This supplied program must not be mistaken for the optimized 20-minute extraction in the preceding schedule model."@en ; cd:hasSource ex:ted-source-tga-method ; cd:authoredResource true .
  ex:ted-temperature-points a cd:Interpretation ; cd:body "Nominal programmed segments, not a complete instrument cycle."@en ; cd:hasKeyPoint ex:ted-temp-p1, ex:ted-temp-p2, ex:ted-temp-p3 ; cd:authoredResource true .
  ex:ted-temp-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Hold:** 200 °C, 2 min; nitrogen 20 mL/min"@en ; cd:authoredResource true .
  ex:ted-temp-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Ramp:** 10 K/min to 500 °C; nitrogen 30 mL/min"@en ; cd:authoredResource true .
  ex:ted-temp-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "**Hold:** 500 °C, 6 min; settling/reset excluded"@en ; cd:authoredResource true .

  ex:ted-process-variance a cd:Concept ; skos:prefLabel "Why TED-GC-MS needs replicates"@en ; cd:hasDefinition ex:ted-variance-definition ; cd:hasSource ex:ted-source-revision-notes, ex:ted-source-calibration-pairs ; cd:authoredResource true .
  ex:ted-variance-definition a cd:Definition ; cd:body "Decomposition, cooling, sorptive capture, transfer, desorption, refocusing and reinjection can each contribute to measurement variability and recovery differences. The process chain makes possible contributions understandable, but does not establish their sizes or independence. The comparison uses the second non-overlapping five-point block in the existing balanced display order (standards 6 through 10), unchanged: its ordinary-least-squares coefficient of determination with an intercept is approximately 0.741. Selection is illustrative, not representative evidence about all TED calibrations. The UV-visible comparison is explicitly artificial with a coefficient of determination 0.990. A dilute photometric solution can give a much tighter calibration, but no universal photometric or TED performance claim is inferred. A low coefficient alone neither diagnoses the cause nor justifies acceptance. Replicates, blanks, residuals, prediction errors and a method-specific uncertainty budget are required. Replication reduces some random error, not bias, carryover or invalid calibration. The speaker's experience of calibrations around 0.7 is reported experience, not a validated frequency or threshold."@en ; cd:hasSource ex:ted-source-revision-notes, ex:ted-source-calibration-pairs ; cd:authoredResource true .
  ex:ted-variance-image a cd:MediaAsset ; cd:uri "/talks-media/ted-variance-comparison.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Process chain: decompose, cool, capture, desorb, refocus and heat/inject. Below: supplied five-point SBR calibration, standards 6–10, versus an explicitly artificial tight UV-visible calibration. Each has its own axes and units; neither is an uncertainty budget."@en ; cd:hasSource ex:ted-source-calibration-pairs, ex:ted-source-revision-notes ; cd:authoredResource true .
  ex:ted-variance-fit-label a cd:MathExpression ; cd:latex "R^2_{\\mathrm{TED}}=0.741\\qquad R^2_{\\mathrm{UV}}=0.990" ; dct:hasPart ex:ted-variance-fit-legend ; cd:authoredResource true .
  ex:ted-variance-fit-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ted-variance-fit-entry ; cd:authoredResource true .
  ex:ted-variance-fit-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "R², TED, UV, ="@en ; cd:body "R²: dimensionless squared correlation for a linear fit with intercept, not uncertainty. Subscripts: supplied TED standards 6–10; artificial UV-visible comparison. =: equals; rounded values."@en ; cd:authoredResource true .
  ex:ted-variance-takeaway a cd:Interpretation ; cd:body "**Plan replicates.** Check prediction and uncertainty. Replicates do not repair bias or invalid calibration."@en ; cd:bodyFormat "markdown" ; cd:authoredResource true .

  ex:ted-marker-spectrum-image a cd:MediaAsset ; cd:uri "/talks-media/ted-marker-spectrum.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Synthetic mirror-spectrum inset: candidate above and reference below, with corresponding anonymous ion channels and similar relative-intensity patterns. Illustrates a reference check, not a measured spectrum, named compound identification or library-match score. Retention and interference checks remain required."@en ; cd:authoredResource true .
  ex:ted-fair-comparison-image a cd:MediaAsset ; cd:uri "/talks-media/ted-fair-compatibility.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two computer pairs exchange data. Compatible but unstandardized: the sender can read and understand, while the receiver can read but cannot understand the meaning without a shared mapping. Standardized semantics: both can read and understand the agreed definitions. Schematic distinction, not proof of all FAIR requirements."@en ; cd:authoredResource true .
  ex:ted-fair-comparison-label a cd:MathExpression ; cd:latex "\\text{Interoperable}\\ne\\text{Interoperable}" ; dct:hasPart ex:ted-fair-comparison-legend ; cd:authoredResource true .
  ex:ted-fair-comparison-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ted-fair-comparison-entry ; cd:authoredResource true .
  ex:ted-fair-comparison-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Left, right, ≠"@en ; cd:body "Left: readable files. Right: shared meaning. ≠: not equivalent. Two uses of the same word, not contradictory formal definitions."@en ; cd:authoredResource true .

  ex:ted-fifo-design a cd:Concept ; skos:prefLabel "Running calibration: how much does order matter?"@en ; cd:hasDefinition ex:ted-fifo-design-definition ; cd:hasSource ex:ted-source-fifo-slide ; cd:authoredResource true .
  ex:ted-fifo-design-definition a cd:Definition ; cd:body "The supplied synthetic Monte Carlo slide compares recursive interval-halving plus cyclic reuse, one fixed shuffled cycle, and independent random replacement masses. With few standards the selection schedule matters more. Around 15 standards the three displayed conditional error summaries are close, but not equal; 15 is a working choice, not a universal optimum. This is robustness to selection order within the specified no-drift simulation, not proof of robust laboratory calibration. More points have diminishing returns and can be harmful when drift makes older standards unrepresentative. The notes supply exact values only for window sizes 5, 15 and 30; only those are plotted. Source simulations were not independently reproduced."@en ; cd:hasSource ex:ted-source-fifo-slide ; cd:authoredResource true .
  ex:ted-fifo-design-chart a cd:ChartDefinition ; skos:prefLabel "Selection strategies converge as the FIFO window grows"@en ; cd:body "Absolute mass error, normalized units. Source-transcribed synthetic Monte Carlo · no drift · valid fits only · noise-free sample signal · not laboratory uncertainty."@en ; cd:chartType cd:LineChart ; cd:xAxisLabel "Standards in FIFO window"@en ; cd:yAxisLabel "95th percentile error"@en ; cd:yAxisUnit "norm. mass" ; cd:usesDataset ex:ted-fifo-recursive ; dct:hasPart ex:ted-fifo-shuffled, ex:ted-fifo-random ; cd:hasSource ex:ted-source-fifo-slide ; cd:authoredResource true .
  ex:ted-fifo-design-points a cd:Interpretation ; cd:body "FIFO means first in, first out: replace one oldest standard."@en ; cd:hasKeyPoint ex:ted-fifo-p1, ex:ted-fifo-p2, ex:ted-fifo-p3 ; cd:authoredResource true .
  ex:ted-fifo-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**5 standards:** selection order matters more"@en ; cd:authoredResource true .
  ex:ted-fifo-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**About 15:** similar errors across three replacement strategies"@en ; cd:authoredResource true .
  ex:ted-fifo-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Robust to order here, not automatically to drift=="@en ; cd:authoredResource true .
}

