  ex:ted-fifo-shuf15 a cd:Observation ; cd:position 2 ; cd:xValue 15.0 ; cd:numericValue 0.2617 ; cd:authoredResource true .
  ex:ted-fifo-shuf30 a cd:Observation ; cd:position 3 ; cd:xValue 30.0 ; cd:numericValue 0.1694 ; cd:authoredResource true .
