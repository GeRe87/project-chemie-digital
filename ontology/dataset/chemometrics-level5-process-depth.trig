@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-process-depth> {
  ex:dep-functions-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-f1, ex:dep-f2, ex:dep-f3 ; cd:authoredResource true .
  ex:dep-f1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "PDF: probability in a range"@en ; cd:body "- A pipette volume is bounded by 9.98 and 10.02 mL.\n\n- Under a uniform uncertainty model, integrate density over an acceptable range."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-f2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "CDF: probability up to a limit"@en ; cd:body "- How much model probability lies at or below 10.01 mL?\n\n- Accumulate density from the lower support to that limit."@en ; cd:visualMotif "nonlinear-curve" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-f3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Inverse CDF: choose a bound"@en ; cd:body "- Which volume is the 75th percentile?\n\n- Start from a probability and return a value in mL. These are model claims, not guaranteed tolerances."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-pair-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-pdf-cdf-linked.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two views of the same Uniform(0,1) input. Left: PDF rectangle between values 0.25 and 0.75 has area 0.50. Right: CDF heights 0.25 and 0.75 differ by 0.50. A horizontal value axis is shared conceptually, but the vertical axes are density and probability. The normalized values map to pipette volumes 9.99 and 10.01 mL under the stated uncertainty model."@en ; cd:authoredResource true .
  ex:dep-pipette-formula a cd:MathExpression ; cd:formulaLabel "One analytical model, three useful questions"@en ; cd:latex "\\begin{gathered}V=(9.98+0.04X)\\;\\mathrm{mL}\\\\P(9.99<V<10.01)=0.50\\\\F_V(10.01)=0.75,\\quad Q_V(0.75)=10.01\\;\\mathrm{mL}\\end{gathered}" ; dct:hasPart ex:dep-pipette-legend ; cd:hasSymbol ex:dep-pipette-values, ex:dep-pipette-functions, ex:dep-pipette-ops ; cd:authoredResource true .
  ex:dep-pipette-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-pipette-entry ; cd:authoredResource true .
  ex:dep-pipette-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Values, functions and units"@en ; dct:references ex:dep-pipette-values, ex:dep-pipette-functions, ex:dep-pipette-ops ; cd:authoredResource true .
  ex:dep-pipette-values a cd:MathSymbol ; cd:symbol "volume model" ; cd:mathNotation "V,\\ X" ; cd:body "V is pipetted volume in mL; X is dimensionless Uniform(0,1). Lower bound 9.98 mL plus width 0.04 mL times X gives bounds 9.98 to 10.02 mL. Assume equal plausibility within them, not measured repeatability evidence."@en ; cd:authoredResource true .
  ex:dep-pipette-functions a cd:MathSymbol ; cd:symbol "three questions" ; cd:mathNotation "P,\\ F_V,\\ Q_V" ; cd:body "P is range probability; F subscript V is the volume CDF; Q is its inverse. Arguments 9.99 and 10.01 denote mL. Probability 0.50 comes from PDF area; 0.75 is cumulative probability or inverse input. Inverse output has mL units."@en ; cd:authoredResource true .
  ex:dep-pipette-ops a cd:MathSymbol ; cd:symbol "arithmetic" ; cd:mathNotation "=,\\ +,\\ <" ; cd:body "Equals states the model and exact calculations; plus adds, juxtaposition multiplies; inequalities choose a volume interval. Endpoints do not alter probability in this continuous model. Probabilities are dimensionless, not density heights."@en ; cd:authoredResource true .

  ex:dep-normal-bands-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-normal-sigma-bands.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Normal model with mean 10.00 mg/L and SD 0.30 mg/L. Three nested model ranges: 9.70 to 10.30 with 68.27 percent coverage, 9.40 to 10.60 with 95.45 percent, and 9.10 to 10.90 with 99.73 percent. These describe individual results, not confidence intervals for the mean or guaranteed limits."@en ; cd:authoredResource true .
  ex:dep-normal-bands a cd:MathExpression ; cd:formulaLabel "Normal model coverage, not a mean confidence interval"@en ; cd:latex "P(\\mu-k\\sigma\\le X\\le\\mu+k\\sigma)=2\\Phi(k)-1" ; dct:hasPart ex:dep-normal-bands-legend ; cd:hasSymbol ex:dep-nb-values, ex:dep-nb-cdf, ex:dep-nb-ops ; cd:authoredResource true .
  ex:dep-normal-bands-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-normal-bands-entry ; cd:authoredResource true .
  ex:dep-normal-bands-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Sigma ranges and probabilities"@en ; dct:references ex:dep-nb-values, ex:dep-nb-cdf, ex:dep-nb-ops ; cd:authoredResource true .
  ex:dep-nb-values a cd:MathSymbol ; cd:symbol "normal values" ; cd:mathNotation "X,\\ \\mu,\\ \\sigma,\\ k" ; cd:body "X is one normal analytical result; mean mu=10.00 and positive SD sigma=0.30 are in mg/L. k is 1, 2 or 3 SDs, dimensionless. The ranges are 9.70-10.30, 9.40-10.60 and 9.10-10.90 mg/L."@en ; cd:authoredResource true .
  ex:dep-nb-cdf a cd:MathSymbol ; cd:symbol "normal coverage" ; cd:mathNotation "P,\\ \\Phi" ; cd:body "P is probability; Phi is the standard-normal CDF. Symmetry gives coverages 68.2689%, 95.4500% and 99.7300%. Two SDs are not exactly 95%; a central 95% range uses about 1.95996 SDs."@en ; cd:authoredResource true .
  ex:dep-nb-ops a cd:MathSymbol ; cd:symbol "range arithmetic" ; cd:mathNotation "\\le,\\ =,\\ +,\\ -" ; cd:body "Inequalities include endpoints; equality is exact under the model; plus/minus extend about the mean; juxtaposition multiplies. Twice the lower-tail CDF minus one is dimensionless central coverage. Estimated parameters, bias and nonnormality change what a report can claim."@en ; cd:authoredResource true .

  ex:dep-log-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-l1, ex:dep-l2, ex:dep-l3 ; cd:authoredResource true .
  ex:dep-l1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Analytical question"@en ; cd:body "- Measure aerosol particle diameters by microscopy.\n\n- Report a size range and the fraction above 5 µm, not a particle count."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-l2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Growth by factors"@en ; cd:body "- Relative growth effects multiply a positive diameter.\n\n- A nearly normal sum of log factors motivates a lognormal candidate."@en ; cd:visualMotif "multiple-inputs" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-l3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Sampling and detection"@en ; cd:body "- Define number-weighted sizes and the observed population.\n\n- Check mixtures, agglomeration and size-dependent detection before applying the model."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:dep-log-process-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-multiplicative-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "A particle undergoes relative growth effects. Multiplication on the diameter scale becomes addition of log ratios. Many suitable small log contributions can yield an approximately normal log size and therefore a lognormal diameter. The drawing is a model rationale, not evidence of fitted particle sizes; mixtures and agglomeration can violate it."@en ; cd:authoredResource true .
  ex:dep-log-law a cd:MathExpression ; cd:formulaLabel "A positive size model, normal on the log scale"@en ; cd:latex "\\begin{gathered}D=d_0\\prod_{j=1}^{r}G_j\\\\U=\\ln(D/d_0)=\\sum_{j=1}^{r}\\ln G_j\\\\U\\sim\\mathcal N(m,s^2),\\quad m=\\ln2,\\ s=0.75\\end{gathered}" ; dct:hasPart ex:dep-log-legend ; cd:hasSymbol ex:dep-log-values, ex:dep-log-factors, ex:dep-log-ops ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:dep-log-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-log-entry ; cd:authoredResource true .
  ex:dep-log-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Diameter and log-growth model"@en ; dct:references ex:dep-log-values, ex:dep-log-factors, ex:dep-log-ops ; cd:authoredResource true .
  ex:dep-log-values a cd:MathSymbol ; cd:symbol "diameter and reference" ; cd:mathNotation "D,\\ d_0,\\ U" ; cd:body "D: positive diameter in µm (micrometres); reference d0=1 µm. U: dimensionless natural log ratio. Division removes units; equals states identities. Number-weighted sizes, not counts."@en ; cd:authoredResource true .
  ex:dep-log-factors a cd:MathSymbol ; cd:symbol "relative factors" ; cd:mathNotation "G_j,\\ j,\\ r" ; cd:body "Positive dimensionless growth factor G indexed by j from 1 to r. Product multiplies factors; sum adds log factors. Normality is a separate assumption."@en ; cd:authoredResource true .
  ex:dep-log-ops a cd:MathSymbol ; cd:symbol "log model notation" ; cd:mathNotation "\\ln,\\ \\sim,\\ \\mathcal N" ; cd:body "ln: natural log; tilde: distributed as; calligraphic N: normal. Log mean m=ln(2), log SD s=0.75; s squared is log variance, all dimensionless. Neither is diameter SD."@en ; cd:authoredResource true .

  ex:dep-log-tail a cd:MathExpression ; cd:formulaLabel "Microscopy question: fraction above 5 µm"@en ; cd:latex "\\begin{gathered}z=\\frac{\\ln(5/d_0)-m}{s}\\approx1.22172\\\\P(D>5)=1-\\Phi(z)\\approx0.11091\\end{gathered}" ; dct:hasPart ex:dep-log-tail-legend ; cd:hasSymbol ex:dep-log-tail-values, ex:dep-log-tail-cdf, ex:dep-log-tail-ops ; cd:authoredResource true .
  ex:dep-log-tail-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-log-tail-entry ; cd:authoredResource true .
  ex:dep-log-tail-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Size threshold on a log scale"@en ; dct:references ex:dep-log-tail-values, ex:dep-log-tail-cdf, ex:dep-log-tail-ops ; cd:authoredResource true .
  ex:dep-log-tail-values a cd:MathSymbol ; cd:symbol "size model parameters" ; cd:mathNotation "D,\\ d_0,\\ m,\\ s" ; cd:body "D is diameter; threshold 5 and reference d subscript zero=1 are both in µm, so their ratio is dimensionless. Model log mean m=ln(2) and log SD s=0.75 describe this hypothetical microscopy population, not fitted evidence."@en ; cd:authoredResource true .
  ex:dep-log-tail-cdf a cd:MathSymbol ; cd:symbol "tail probability" ; cd:mathNotation "z,\\ P,\\ \\Phi" ; cd:body "z is standardized log-size threshold; Phi is standard-normal CDF. P is dimensionless probability: approximately 11.09% of modeled individual diameters exceed 5 µm. This is not the probability that a population mean exceeds five."@en ; cd:authoredResource true .
  ex:dep-log-tail-ops a cd:MathSymbol ; cd:symbol "calculation operators" ; cd:mathNotation "\\ln,\\ >,\\ -,\\ /,\\ \\approx" ; cd:body "Natural log acts on a unitless ratio; subtract m and divide by s. Greater than selects the upper event; one minus CDF takes its complement. Equals states identities, approximately rounds numbers. Detection bias can invalidate environmental extrapolation."@en ; cd:authoredResource true .

  ex:dep-log-bands-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-lognormal-bands.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Lognormal diameter intervals from normal log-size bands. With central diameter 2 µm and log SD 0.75, one log SD gives 0.9447-4.2340 µm, two give 0.4463-8.9634, and three give 0.2108-18.9755. Coverages are 68.27%, 95.45% and 99.73%. They are asymmetric on the diameter scale and symmetric on the log scale."@en ; cd:authoredResource true .
  ex:dep-log-bands a cd:MathExpression ; cd:formulaLabel "The sigma analogue is multiplicative, not additive"@en ; cd:latex "\\begin{gathered}[d_0e^{m-ks},\\ d_0e^{m+ks}]\\\\=[d_c/g^k,\\ d_cg^k]\\\\d_c=2\\;\\text{µm},\\quad g=e^{0.75}\\approx2.117\\end{gathered}" ; dct:hasPart ex:dep-log-bands-legend ; cd:hasSymbol ex:dep-log-band-values, ex:dep-log-band-prob, ex:dep-log-band-ops ; cd:authoredResource true .
  ex:dep-log-bands-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-log-bands-entry ; cd:authoredResource true .
  ex:dep-log-bands-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Log-scale sigma ranges"@en ; dct:references ex:dep-log-band-values, ex:dep-log-band-prob, ex:dep-log-band-ops ; cd:authoredResource true .
  ex:dep-log-band-values a cd:MathSymbol ; cd:symbol "multiplicative centre and spread" ; cd:mathNotation "d_c,\\ g,\\ m,\\ s" ; cd:body "d subscript c=d0 exp(m) is central diameter (median), 2 µm. d0=1 µm; m=ln(2), s=0.75 are log mean and SD. g=exp(s) is dimensionless geometric SD, not an additive diameter SD. e is the natural exponential base."@en ; cd:authoredResource true .
  ex:dep-log-band-prob a cd:MathSymbol ; cd:symbol "number of log SDs" ; cd:mathNotation "k" ; cd:body "k=1,2,3 selects one, two or three log-scale SDs. Normal log-size gives the same 68.27%, 95.45%, 99.73% coverages as the corresponding normal bands. Original-scale bounds divide and multiply the centre by g raised to k."@en ; cd:authoredResource true .
  ex:dep-log-band-ops a cd:MathSymbol ; cd:symbol "interval conventions" ; cd:mathNotation "[\\ ,\\ ],\\ +,\\ -,\\ /,\\ \\approx" ; cd:body "Brackets include endpoints; plus/minus act on the log scale; division and juxtaposition undo that scale multiplicatively. Equals states identities; approximately rounds g. Bounds have µm units. These are model ranges for individual particles, not confidence intervals for an estimated centre."@en ; cd:authoredResource true .

  ex:dep-log-report a cd:MathExpression ; cd:formulaLabel "Choose the reported coverage, then invert the model"@en ; cd:latex "\\begin{gathered}Q_D(p)=d_0\\exp\\!\\left(m+s\\Phi^{-1}(p)\\right)\\\\\\left[Q_D(0.025),Q_D(0.975)\\right]\\approx[0.4599,8.6982]\\;\\text{µm}\\end{gathered}" ; dct:hasPart ex:dep-log-report-legend ; cd:hasSymbol ex:dep-log-report-values, ex:dep-log-report-quantiles, ex:dep-log-report-ops ; cd:authoredResource true .
  ex:dep-log-report-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-log-report-entry ; cd:authoredResource true .
  ex:dep-log-report-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Quantile-based size report"@en ; dct:references ex:dep-log-report-values, ex:dep-log-report-quantiles, ex:dep-log-report-ops ; cd:authoredResource true .
  ex:dep-log-report-values a cd:MathSymbol ; cd:symbol "diameter model" ; cd:mathNotation "D,\\ d_0,\\ m,\\ s" ; cd:body "Positive diameter D in µm; d0=1 µm, log mean m=ln(2), log SD s=0.75. These specified model parameters are not estimated from the plotted curve. µm denotes micrometres."@en ; cd:authoredResource true .
  ex:dep-log-report-quantiles a cd:MathSymbol ; cd:symbol "inverse probabilities" ; cd:mathNotation "Q_D(p),\\ \\Phi^{-1}(p)" ; cd:body "Q is diameter quantile; p is a dimensionless cumulative probability strictly between zero and one. Phi inverse is the standard-normal quantile, not a reciprocal. Probabilities 0.025 and 0.975 leave 2.5% in each tail: a central 95% size range."@en ; cd:authoredResource true .
  ex:dep-log-report-ops a cd:MathSymbol ; cd:symbol "back-transform and rounding" ; cd:mathNotation "\\exp,\\ +,\\ [\\ ,\\ ],\\ \\approx" ; cd:body "exp is natural exponential; plus adds on the log scale; juxtaposition multiplies. Equals defines the model quantile, brackets include endpoints, approximately rounds to µm values. A 95% range is not a two-log-SD range (95.45%) or a confidence interval for the mean."@en ; cd:authoredResource true .
}
