@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantic-triples> {
  ex:cogniflow-semantic-triples a cd:Concept ;
    skos:prefLabel "From Language to a Knowledge Graph"@en ;
    cd:hasDefinition ex:def-cogniflow-semantic-triples ;
    cd:authoredResource true .

  ex:def-cogniflow-semantic-triples a cd:Definition ;
    cd:body "Semantics makes relationships explicit by expressing statements as subject-predicate-object triples. Multiple triples that share entities naturally connect into a knowledge graph."@en ;
    cd:authoredResource true .

  ex:cogniflow-semantic-triples-banner a cd:Interpretation ;
    cd:body "SUBJECT → PREDICATE → OBJECT"@en ;
    cd:authoredResource true .

  ex:cogniflow-semantic-triples-cards a cd:Interpretation ;
    cd:body "The same information can be read as natural language, explicit semantic statements, or a connected knowledge graph."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-semantic-prose,
      ex:keypoint-cogniflow-semantic-statements,
      ex:keypoint-cogniflow-semantic-graph ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantic-prose a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """PROSE

“Anna, who lives in Essen, works at a university that is located in the same city.”"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantic-statements a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """SEMANTIC STATEMENTS

Anna → livesIn → Essen

Anna → worksAt → University

University → locatedIn → Essen"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantic-graph a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """KNOWLEDGE GRAPH

same entities
explicit labeled relationships"""@en ;
    cd:authoredResource true .

  ex:cogniflow-semantic-triples-note a cd:Interpretation ;
    cd:body "THREE SIMPLE STATEMENTS — ONE CONNECTED GRAPH"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantic-triples-extension> {
  ex:path-step-cogniflow-semantic-triples a cd:PathStep ;
    cd:position 7 ;
    cd:usesResource ex:cogniflow-semantic-triples-banner,
      ex:cogniflow-semantic-triples-cards,
      ex:cogniflow-semantic-triples-note ;
    cd:usesScene ex:scene-cogniflow-semantic-triples ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantic-triples> {
  ex:scene-cogniflow-semantic-triples a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantic-triples ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantic-triples-heading,
      ex:scene-item-cogniflow-semantic-triples-banner,
      ex:scene-item-cogniflow-semantic-triples-cards,
      ex:scene-item-cogniflow-semantic-triples-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-triples-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantic-triples ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-triples-banner a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-semantic-triples-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-triples-cards a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-semantic-triples-cards ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantic-triples-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-semantic-triples-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
