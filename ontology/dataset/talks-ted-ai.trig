 ex:ted-ai-flow a cd:FlowDiagram ; skos:prefLabel "AI-assisted construction: under development, with successful first tests"@en ; cd:body "Speaker-reported initial tests: agents build explicit pipeline graphs and pass all configured structural and semantic validation checks. This is an early development result, not a generally available system or proof of analytical validity."@en ; cd:hasDiagramNode ex:ted-ai-agent, ex:ted-ai-gateway, ex:ted-ai-run ; cd:hasDiagramEdge ex:ted-ai-edge1, ex:ted-ai-edge2 ; cd:hasSource ex:ted-source-ai-tools ; cd:authoredResource true .
 ex:ted-ai-agent a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "AI agent"@en ; cd:body "Propose a workflow\nfrom documented steps"@en ; cd:visualMotif "semantic-model" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
