<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-ai> {
 ex:ted-ai-orchestration a cd:Concept ; skos:prefLabel "Laboratory 5.0: AI builds on explicit interfaces"@en ; cd:hasDefinition ex:ted-ai-definition ; cd:hasSource ex:ted-source-ai-tools ; cd:authoredResource true .
 ex:ted-ai-definition a cd:Definition ; cd:body "Standardized processing operations can be exposed through a Model Context Protocol (MCP) gateway. An AI agent can discover documented operations, propose explicit connections and submit a pipeline for validation and execution instead of inventing undocumented APIs. This supports complex workflow construction. Planning remains fallible: registered-tool checks and structural validation constrain errors but do not establish scientific correctness or guarantee freedom from hallucinations. Deterministic execution requires appropriate implementations, fixed inputs, parameters, versions, and random seeds where relevant, independently of how an agent proposed the plan."@en ; cd:hasSource ex:ted-source-ai-tools ; cd:authoredResource true .
 ex:ted-ai-points a cd:Interpretation ; cd:body "Constrained planning, explicit validation, reproducible execution."@en ; cd:hasKeyPoint ex:ted-ai-p1, ex:ted-ai-p2, ex:ted-ai-p3 ; cd:authoredResource true .
 ex:ted-ai-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Discover:** registered tools, documented ports, explicit constraints"@en ; cd:authoredResource true .
 ex:ted-ai-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Validate, then execute:** fixed inputs, parameters and versions"@en ; cd:authoredResource true .
 ex:ted-ai-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Constrained AI planning is not guaranteed scientific correctness=="@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-ai> {
 ex:ted-source-ai-tools a cd:Source ; dct:title "Speaker-described AI workflow orchestration and MCP gateway documentation" ; dct:identifier "speaker-request/laboratory-5.0; stonecastle/cf_service_mcp_server/README.md" ; dct:hasVersion "gateway-readme sha256:8206e1490f6d60e3784d3129deeed5762e2f28c7c65712402efd7a910459ec23" ; dct:description "The speaker describes registered processing steps made callable through MCP for agent-assisted pipeline construction. The inspected gateway README documents a built-in service-call tool with semantic discovery, resolution, validation and invocation. This supports the gateway diagram, not a claim that every operation is a separately enumerated MCP tool or that autonomous scientific planning is error-free. No benchmark or pedagogical-effectiveness evidence is asserted."@en ; cd:supportsResource ex:ted-ai-definition ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/diagrams/talks-ted-ai> {
 ex:ted-ai-flow a cd:FlowDiagram ; skos:prefLabel "An AI planning layer above standardized processing"@en ; cd:body "The agent proposes an explicit graph using registered operations. The gateway resolves tools and contracts; validated implementations execute the saved plan. Tool availability and structural validation do not establish scientific correctness."@en ; cd:hasDiagramNode ex:ted-ai-agent, ex:ted-ai-gateway, ex:ted-ai-run ; cd:hasDiagramEdge ex:ted-ai-edge1, ex:ted-ai-edge2 ; cd:hasSource ex:ted-source-ai-tools ; cd:authoredResource true .
 ex:ted-ai-agent a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "AI agent"@en ; cd:body "Propose a workflow\nfrom documented steps"@en ; cd:visualMotif "semantic-model" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
 ex:ted-ai-gateway a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "MCP tool gateway"@en ; cd:body "Discover registered operations\nRead ports and constraints"@en ; cd:visualMotif "processing-composition" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
 ex:ted-ai-run a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Validated pipeline"@en ; cd:body "Execute the explicit graph\nRecord inputs and versions"@en ; cd:visualMotif "workflow-results" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
 ex:ted-ai-edge1 a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:ted-ai-agent ; cd:targetNode ex:ted-ai-gateway ; skos:prefLabel "discover + compose"@en ; cd:authoredResource true .
 ex:ted-ai-edge2 a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:ted-ai-gateway ; cd:targetNode ex:ted-ai-run ; skos:prefLabel "validate + run"@en ; cd:authoredResource true .
}
