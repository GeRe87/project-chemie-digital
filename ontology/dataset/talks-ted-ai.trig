 ex:ted-ai-edge2 a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:ted-ai-gateway ; cd:targetNode ex:ted-ai-run ; skos:prefLabel "build + validate"@en ; cd:authoredResource true .
