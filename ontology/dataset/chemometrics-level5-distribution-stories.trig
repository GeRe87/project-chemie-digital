<https://w3id.org/project-chemie-digital/graph/specifications/level5-distribution-stories> {
  ex:l5-n09-story1-title a cd:Interpretation ; skos:prefLabel "One water sample is part of the investigation"@en ; cd:authoredResource true .
  ex:l5-n09-story2-title a cd:Interpretation ; skos:prefLabel "Our target is the water body, not one sample"@en ; cd:authoredResource true .
  ex:l5-l12-story-title a cd:Interpretation ; skos:prefLabel "Across sites, dilution changes concentration"@en ; cd:authoredResource true .
  ex:l5-t16-variance-story-title a cd:Interpretation ; skos:prefLabel "Uncertainty in our estimate of spread"@en ; cd:authoredResource true .
  ex:l5-t16-mean-story-title a cd:Interpretation ; skos:prefLabel "A laboratory interval is only one component"@en ; cd:authoredResource true .
  ex:l5-f17-story-title a cd:Interpretation ; skos:prefLabel "Compare the methods behind our estimates"@en ; cd:authoredResource true .

  ex:l5-story-nitrate-chart a cd:ChartDefinition ; skos:prefLabel "An analyst repeats UV/Vis on one homogeneous nitrate sample"@en ; cd:body "Illustrative values: 9.6, 9.8, 10.0, 10.2, 10.4 mg/L. One sample."@en ; cd:chartType cd:DotPlot ; cd:hasChartGroup ex:l5-story-nitrate-group ; cd:xAxisLabel "One nitrate sample"@en ; cd:yAxisLabel "Measured concentration"@en ; cd:yAxisUnit "mg/L" ; cd:yAxisMinimum 9.4 ; cd:observationLabel "Measured values" ; cd:summaryLabel "Mean" ; cd:authoredResource true .
  ex:l5-story-nitrate-group a cd:ChartGroup ; skos:prefLabel "Five repeats"@en ; cd:position 1 ; cd:usesDataset ex:l5-s15-readings ; cd:summaryResult ex:l5-s15-mean ; cd:authoredResource true .
  ex:l5-story-normal-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-story-normal-sample, ex:l5-story-normal-variation, ex:l5-story-normal-target ; cd:authoredResource true .
  ex:l5-story-normal-sample a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Target: the water body"@en ; cd:body "Estimate its mean nitrate concentration in a defined volume at a fixed survey time."@en ; cd:authoredResource true .
  ex:l5-story-normal-variation a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Sampling: select water units"@en ; cd:body "Select locations and depths to cover the target volume. The selection design connects samples to that target."@en ; cd:authoredResource true .
  ex:l5-story-normal-target a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Analysis: measure each sample"@en ; cd:body "Normal errors can model laboratory variation. Repeats alone do not make one sample representative."@en ; cd:authoredResource true .

  ex:l5-story-factors-chart a cd:ChartDefinition ; skos:prefLabel "A constructed illustration of relative concentration changes"@en ; cd:body "Half, unchanged, double: 1, 2, 4 mg/L. Not measured sites."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-story-factors ; cd:xAxisLabel "Relative concentration change"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:authoredResource true .
  ex:l5-story-factors a cd:Dataset ; skos:prefLabel "Three deterministic factor scenarios around 2 mg/L"@en ; cd:hasObservation ex:l5-story-half, ex:l5-story-unchanged, ex:l5-story-double ; cd:authoredResource true .
  ex:l5-story-half a cd:Observation ; cd:position 1 ; skos:prefLabel "Half"@en ; cd:numericValue 1.0 ; cd:authoredResource true .
  ex:l5-story-unchanged a cd:Observation ; cd:position 2 ; skos:prefLabel "Unchanged"@en ; cd:numericValue 2.0 ; cd:authoredResource true .
  ex:l5-story-double a cd:Observation ; cd:position 3 ; skos:prefLabel "Double"@en ; cd:numericValue 4.0 ; cd:authoredResource true .

  ex:l5-story-variances-chart a cd:ChartDefinition ; skos:prefLabel "A laboratory repeats a five-measurement precision study"@en ; cd:body "Five simulated studies, each with five nitrate measurements."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-t16-variances ; cd:xAxisLabel "Repeat study"@en ; cd:yAxisLabel "Estimated variance"@en ; cd:yAxisUnit "(mg/L)^2" ; cd:authoredResource true .
  ex:l5-story-methods-chart a cd:ChartDefinition ; skos:prefLabel "A laboratory compares repeatability of two nitrate methods"@en ; cd:body "Constructed sample SDs: A 0.20, B 0.40 mg/L."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-f17-sds ; cd:xAxisLabel "Method"@en ; cd:yAxisLabel "Sample SD"@en ; cd:yAxisUnit "mg/L" ; cd:authoredResource true .
}

