  ex:v44 a cd:Interpretation ; skos:prefLabel "R Lab 5: Residual Degrees of Freedom"@en ; cd:body "Six minutes: fit a calibration line with intercept and slope and inspect its residual spread."@en ; cd:authoredResource true .
  ex:v44-task a cd:Exercise ; cd:body "Six minutes: use lm(), coef(), residuals() and df.residual(). Check the manual residual SD against summary(fit)$sigma.\nWhy do fitting an intercept and slope leave only three residual df? Explain what this signal-scale SD describes and why it is not concentration uncertainty."@en ; cd:usesDataset ex:v43-data ; cd:authoredResource true .
  ex:v44-task cd:hasCodeExample ex:v44-code .
  ex:v44-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:code "concentration <- c(0, 1, 2, 3, 4)\nsignal <- c(.05, 1.02, 1.95, 3.10, 3.92)\nfit <- lm(signal ~ concentration)\nlist(coefficients=coef(fit),\n     residuals=residuals(fit),\n     df=df.residual(fit),\n     manual=sqrt(sum(residuals(fit)^2)/df.residual(fit)),\n     R=summary(fit)$sigma)\n# n = 5, p = 2, residual df = 3" ; cd:authoredResource true .

  ex:v45 a cd:Interpretation ; skos:prefLabel "Analytical Decision Challenge"@en ; cd:body "Discuss two QC methods using five repeats each. The inclusive interval [9.5, 10.5] mg/L is an illustrative teaching rule, not a validated routine-performance requirement. These results alone cannot establish routine suitability."@en ; cd:authoredResource true .
  ex:v45-table a cd:TableDefinition ; skos:prefLabel "Case data: control target 10 mg/L"@en ; cd:hasTableColumn ex:v45-c1, ex:v45-c2 ; cd:hasTableRow ex:v45-r1, ex:v45-r2 ; cd:authoredResource true .
  ex:v45-c1 a cd:TableColumn ; cd:position 1 ; skos:prefLabel "Method"@en ; cd:authoredResource true .
  ex:v45-c2 a cd:TableColumn ; cd:position 2 ; skos:prefLabel "Five measurements (mg/L)"@en ; cd:authoredResource true .
  ex:v45-r1 a cd:TableRow ; cd:position 1 ; cd:hasTableCell ex:v45-a1, ex:v45-a2 ; cd:authoredResource true .
  ex:v45-r2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:v45-b1, ex:v45-b2 ; cd:authoredResource true .
  ex:v45-a1 a cd:TableCell ; cd:position 1 ; cd:body "A"@en ; cd:authoredResource true .
  ex:v45-a2 a cd:TableCell ; cd:position 2 ; cd:body "9.8, 10.0, 10.1, 9.9, 10.2"@en ; cd:authoredResource true .
  ex:v45-b1 a cd:TableCell ; cd:position 1 ; cd:body "B"@en ; cd:authoredResource true .
  ex:v45-b2 a cd:TableCell ; cd:position 2 ; cd:body "8.7, 10.8, 9.5, 11.2, 9.8"@en ; cd:authoredResource true .
  ex:v45-task a cd:Exercise ; cd:body "Discuss in pairs: what would you report about A versus B from these five results each? Compare means, SD, RSD and counts in the inclusive illustrative interval [9.5, 10.5] mg/L.\nWhich measurement conditions and independent sampling units must be known? Propose further independent replication and a validated performance requirement before judging routine suitability. Separate what n = 5 shows from what it cannot establish."@en ; cd:usesDataset ex:dataset-qc-method-a, ex:dataset-qc-method-b ; cd:authoredResource true .

  ex:v46 a cd:Interpretation ; skos:prefLabel "What Have We Learned?"@en ; cd:hasKeyPoint ex:v46-k1, ex:v46-k2, ex:v46-k3, ex:v46-k4, ex:v46-k5 ; cd:authoredResource true .
  ex:v46-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "The mean describes location; variance describes spread."@en ; cd:authoredResource true .
  ex:v46-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Variance has squared units; SD is its square root, in the original unit."@en ; cd:authoredResource true .
  ex:v46-k3 a cd:KeyPoint ; cd:position 3 ; cd:body "Degrees of freedom account for constraints introduced by estimated parameters."@en ; cd:authoredResource true .
  ex:v46-k4 a cd:KeyPoint ; cd:position 4 ; cd:body "SD: individual spread. SE: sampling spread of an estimate. RSD: SD relative to |mean|."@en ; cd:authoredResource true .
  ex:v46-k5 a cd:KeyPoint ; cd:position 5 ; cd:body "Interpretation needs measurement conditions and a design identifying independent units."@en ; cd:authoredResource true .
  ex:v46-task a cd:Exercise ; cd:body "A report states ‘10.0 ± 0.2 mg/L’. What does ± mean: SD, SE, a confidence interval or something else? Which sample size, independent units and measurement conditions are missing? Explain why the statement alone is insufficient."@en ; cd:authoredResource true .
}

