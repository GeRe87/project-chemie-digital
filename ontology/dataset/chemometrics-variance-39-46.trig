  ex:v43-table a cd:TableDefinition ; skos:prefLabel "Observed y, fitted ŷ and residual (a.u.)"@en ; cd:hasTableColumn ex:v43-c1, ex:v43-c2, ex:v43-c3, ex:v43-c4 ; cd:hasTableRow ex:v43-r1, ex:v43-r2, ex:v43-r3, ex:v43-r4, ex:v43-r5 ; cd:authoredResource true .
