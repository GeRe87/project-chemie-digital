  ex:l7-scene01 <http://purl.org/dc/terms/subject> ex:slide-topic-use-case .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-opening> {
  ex:slide-topic-use-case a skos:Concept ; skos:prefLabel "Use case"@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-intro> {
  ex:l7-intro-hypothesis-perspectives a cd:DefinitionList ;
    cd:hasDefinitionListEntry ex:l7-hypothesis-means, ex:l7-hypothesis-variation ;
    cd:hasSource ex:l7-source-nist-anova ; cd:authoredResource true .
  ex:l7-hypothesis-means a cd:DefinitionListEntry ; cd:position 1 ;
    skos:prefLabel "What we test"@en ;
    cd:body "Under the null hypothesis, methods A, B and C have the same mean recovery in the population."@en ;
    cd:hasSource ex:l7-source-nist-anova ; cd:authoredResource true .
  ex:l7-hypothesis-variation a cd:DefinitionListEntry ; cd:position 2 ;
    skos:prefLabel "What we expect in the data"@en ;
    cd:body "If the means are equal, the between-group and within-group mean squares estimate the same error variance on average."@en ;
    cd:hasSource ex:l7-source-nist-anova ; cd:authoredResource true .
  ex:l7-source-nist-anova cd:supportsResource ex:l7-intro-hypothesis-perspectives, ex:l7-hypothesis-means, ex:l7-hypothesis-variation .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-intro> {
  ex:l7-intro-ss-partition-visual a cd:MediaAsset ;
    cd:uri "/chemometrics/level7-anova-ss-partition.svg"^^xsd:anyURI ;
    cd:mediaType "image/svg+xml" ;
    cd:alternativeText "A bar of total squared deviations, 114 percentage points squared, is split proportionally into 84 between groups and 30 within groups."@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-intro-ss-partition-visual .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-intro> {
  ex:l7-intro-df-partition-visual a cd:MediaAsset ;
    cd:uri "/chemometrics/level7-anova-df-partition.svg"^^xsd:anyURI ;
    cd:mediaType "image/svg+xml" ;
    cd:alternativeText "A bar of 17 total degrees of freedom splits into 2 between groups and 15 within groups. The components count three group means minus one and eighteen observations minus three fitted group means."@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-intro-df-partition-visual .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-intro> {
  ex:l7-intro-ms-calculation-visual a cd:MediaAsset ;
    cd:uri "/chemometrics/level7-anova-ms-calculation.svg"^^xsd:anyURI ;
    cd:mediaType "image/svg+xml" ; cd:alternativeText "Divide each sum of squares by its degrees of freedom. Between groups: 84 divided by 2 equals 42. Within groups: 30 divided by 15 equals 2."@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-intro-ms-calculation-visual .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-intro> {
  ex:l7-intro-f-calculation-visual a cd:MediaAsset ;
    cd:uri "/chemometrics/level7-anova-f-calculation.svg"^^xsd:anyURI ;
    cd:mediaType "image/svg+xml" ; cd:alternativeText "The between-group mean square of 42 divided by the within-group mean square of 2 gives a dimensionless F of 21."@en ;
    cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-intro-f-calculation-visual .
}
