<https://w3id.org/project-chemie-digital/graph/scenes/level7-anova-opening> {
  ex:l7-scene-cover a cd:SceneDefinition ; cd:focusConcept ex:l7-intro-concept-01 ;
    cd:hasSceneItem ex:l7-anova-cover-heading-item ;
    cd:narration "The lecture introduces analysis of variance through a practical comparison of sample preparation methods."@en ; cd:authoredResource true .
  ex:l7-anova-cover-heading-item a cd:SceneItem ; cd:position 1 ; cd:language "en" ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:selectsResource ex:l7-anova-cover-heading ; cd:authoredResource true .
  ex:l7-scene-bridge a cd:SceneDefinition ; cd:focusConcept ex:l7-intro-concept-01 ;
    cd:hasSceneItem ex:l7-anova-bridge-heading-item, ex:l7-anova-bridge-visual-item ;
    cd:narration "Start with groups A and B and ask how we would compare their means. Advance to reveal group C. One-way ANOVA lets us test the hypothesis that all three population means are equal. The brackets show which groups each test considers."@en ; cd:authoredResource true .
  ex:l7-anova-bridge-heading-item a cd:SceneItem ; cd:position 1 ; cd:language "en" ;
    cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:selectsResource ex:l7-anova-bridge-heading ; cd:authoredResource true .
  ex:l7-anova-bridge-visual-item a cd:SceneItem ; cd:position 2 ; cd:language "en" ;
    cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:selectsResource ex:l7-anova-bridge-visual ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/knowledge/level7-anova-opening> {
  ex:l7-anova-cover-heading a cd:Interpretation ; skos:prefLabel "ANOVA: Analysis of Variance"@en ; cd:authoredResource true .
  ex:l7-anova-bridge-heading a cd:Interpretation ; skos:prefLabel "From two samples to three or more"@en ; cd:authoredResource true .
  ex:l7-anova-bridge-visual a cd:MediaAsset ; cd:uri "/chemometrics/anova-two-to-three-groups.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ;
    cd:alternativeText "Two similar groups are bracketed below as Two-sample t-test. In the second stage Group C appears, with slightly higher values, and an ANOVA bracket spans all three groups above."@en ; cd:authoredResource true .
}

