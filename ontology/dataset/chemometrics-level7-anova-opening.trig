  ex:l7-setup-takeaway a cd:Interpretation ;
    cd:body "Prepare samples independently for each method so the within-method spread includes variation from preparation."@en ;
    cd:interpretsResource ex:l7-intro-recovery-schema ; cd:hasSource ex:l7-source-package ; cd:authoredResource true .
  ex:l7-source-package cd:supportsResource ex:l7-setup-takeaway .
