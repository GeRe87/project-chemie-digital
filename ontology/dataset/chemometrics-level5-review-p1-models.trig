@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-review-p1-models> {
 ex:p1-signed-grown a cd:ChartDefinition ; skos:prefLabel "From four to two hundred independent signed effects"@en ; cd:body "Begin with four contributions; compare the fixed 200-effect points and normal reference. Then increase the live count through 16, 50 and 200. Total SD remains 0.10 mg/L. Every finite law remains discrete. The display focuses on plus/minus 4.5 SD; numerical data retain every outcome."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "signed" ; cd:hasExperimentParameter ex:p1-n200, ex:rx-sigma, ex:p1-overlay-on ; cd:xAxisLabel "Standardized total error"@en ; cd:yAxisLabel "Mass divided by grid spacing"@en ; cd:authoredResource true .
 ex:p1-five-squares a cd:ChartDefinition ; skos:prefLabel "Add independent squared standard normals"@en ; cd:body "Start with two independent squared components: a chi-square distribution with two degrees of freedom. Change the component count to compare shapes. Arbitrary dependent residuals do not count as independent components."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "squares" ; cd:hasExperimentParameter ex:p1-df2, ex:rx-M, ex:rx-seed ; cd:xAxisLabel "Sum of independent squared distances"@en ; cd:yAxisLabel "Chi-square reference density"@en ; cd:authoredResource true .
 ex:p1-normal-cdf a cd:ChartDefinition ; skos:prefLabel "Left and right areas correspond to one CDF ordinate"@en ; cd:body "Threshold 10.20 mg/L: two SD above the known model expectation. The two colored areas sum to one; the left area equals the CDF ordinate. Density height is not probability."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:rx-inverse, ex:p1-view1 ; cd:xAxisLabel "Nitrate concentration (mg/L)"@en ; cd:yAxisLabel "Density and cumulative probability"@en ; cd:authoredResource true .
 ex:p1-normal-tail a cd:ChartDefinition ; skos:prefLabel "A right-tail event, not density at one point"@en ; cd:body "A stable known-parameter method exceeds 10.20 mg/L in about 2.275% of individual results. Only the upper area is emphasized here. An exceedance alone does not diagnose a fault."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:rx-inverse, ex:p1-view2 ; cd:xAxisLabel "Nitrate concentration (mg/L)"@en ; cd:yAxisLabel "Density and upper-tail area"@en ; cd:authoredResource true .
 ex:p1-normal-inverse a cd:ChartDefinition ; skos:prefLabel "Choose the upper rate first, then find the concentration limit"@en ; cd:body "A 1% upper-tail rate places the threshold at 10.232635 mg/L, not at 10.20. This concerns one measurement from the assumed known-parameter normal model, not a legal limit."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:p1-inverse-on, ex:p1-view2 ; cd:xAxisLabel "Nitrate concentration (mg/L)"@en ; cd:yAxisLabel "Density and selected upper rate"@en ; cd:authoredResource true .
 ex:p1-normal-bands a cd:ChartDefinition ; skos:prefLabel "A one-sided rate is not a two-sided outside probability"@en ; cd:body "Compare an upper 1% limit with both tails outside two SD on the same concentration scale. The latter leave 95.45% centrally, not 99%. Bands of one, two and three SD give the 68/95/99.7 rule."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:p1-inverse-on, ex:p1-view3, ex:p1-band ; cd:xAxisLabel "Nitrate concentration (mg/L)"@en ; cd:yAxisLabel "Normal density and tail areas"@en ; cd:authoredResource true .
 ex:p1-normal-devices a cd:ChartDefinition ; skos:prefLabel "Same concentration, different known population SDs"@en ; cd:body "- Hypothetical known SDs: A 0.10; B 0.20 mg/L.\n- Compare one measurement result on both models.\n- Not the later observed device series."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "normal" ; cd:hasExperimentParameter ex:rx-mu, ex:rx-sigma, ex:rx-threshold, ex:rx-alpha01, ex:rx-inverse, ex:p1-view4, ex:p1-sigmaB ; cd:xAxisLabel "Nitrate concentration (mg/L)"@en ; cd:yAxisLabel "Two known-parameter densities"@en ; cd:authoredResource true .
 ex:p1-ecdf-start a cd:ChartDefinition ; skos:prefLabel "A short seeded prefix visibly differs from its generating model"@en ; cd:body "20 simulated measurement results from the same seeded stream used for the normal-growth example. Empirical steps fluctuate around the fixed generating CDF. Increasing to 1,000 results gives 978/1,000 at 10.20 mg/L, not proof of normality."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "ecdf" ; cd:hasExperimentParameter ex:p1-M20, ex:rx-mu, ex:rx-sigma, ex:rx-seed, ex:rx-threshold ; cd:xAxisLabel "Individual nitrate result (mg/L)"@en ; cd:yAxisLabel "Empirical fraction and model probability"@en ; cd:authoredResource true .
 ex:p1-factors a cd:ChartDefinition ; skos:prefLabel "10 to 12.5 and back to 10: factor and reciprocal"@en ; cd:body "Multiply 10 ng/L by 1.25, then by its reciprocal 0.80. The same trajectory is 0, +0.22314, 0 in natural log-ratio units. Absolute changes and relative factors are different mechanisms, not evidence that all preparation effects are lognormal."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "factors" ; cd:hasExperimentParameter ex:rx-start, ex:p1-factor125, ex:rx-delta, ex:p1-steps2, ex:p1-mode2 ; cd:xAxisLabel "Successive effect"@en ; cd:yAxisLabel "Concentration or log ratio"@en ; cd:authoredResource true .
 ex:p1-log-transform a cd:ChartDefinition ; skos:prefLabel "Normal log ratios become skewed concentrations by exponentiation"@en ; cd:body "Read left to right: a normal dimensionless log ratio, then its exponential concentration transform. Products become sums on the log scale; approximate normality of that sum is a model motivation, not a guarantee from sample preparation alone."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "lognormal" ; cd:hasExperimentParameter ex:rx-reference, ex:rx-logsd, ex:rx-logthreshold, ex:rx-alpha05, ex:rx-inverse, ex:p1-view1 ; cd:xAxisLabel "Log ratio, then concentration"@en ; cd:yAxisLabel "Density on each scale"@en ; cd:authoredResource true .
 ex:p1-log-centers a cd:ChartDefinition ; skos:prefLabel "Three centers, one concentration density"@en ; cd:body "Median 10 ng/L and log SD 0.30: mode 9.13931, median 10.00 and arithmetic expectation 10.46028 ng/L. The vertical markers identify different population targets; they are not three estimates of the same quantity."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "lognormal" ; cd:hasExperimentParameter ex:rx-reference, ex:rx-logsd, ex:rx-logthreshold, ex:rx-alpha05, ex:rx-inverse, ex:p1-view2 ; cd:xAxisLabel "Concentration (ng/L)"@en ; cd:yAxisLabel "Lognormal density and centers"@en ; cd:authoredResource true .
 ex:p1-log-tasks a cd:ChartDefinition ; skos:prefLabel "Forward probability and inverse threshold are different questions"@en ; cd:body "- Left: probability above the chosen concentration.\n- Right: concentration for a chosen upper-tail rate.\n- Same assumed model: median 10 ng/L; dimensionless log SD initially 0.30."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "lognormal" ; cd:hasExperimentParameter ex:rx-reference, ex:rx-logsd, ex:rx-logthreshold, ex:rx-alpha05, ex:rx-inverse, ex:p1-view3 ; cd:xAxisLabel "Concentration (ng/L)"@en ; cd:yAxisLabel "Forward and inverse upper areas"@en ; cd:authoredResource true .
 ex:rx-means cd:hasExperimentParameter ex:p1-comp30 .
 ex:rx-variance cd:usesDataset ex:p1-variance-examples .
 ex:p1-stress-outlier a cd:ChartDefinition ; skos:prefLabel "A visible outlier changes the nominal variance comparison"@en ; cd:body "- B: add one 0.80 mg/L outlier; A stays unchanged.\n- Switch to stable or drift; keep seed and axis fixed.\n- Drift is ordered change, not independent scatter."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "stress" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-sigma, ex:rx-seed, ex:p1-mode1, ex:rx-mu, ex:rx-outlier, ex:rx-drift ; cd:xAxisLabel "Acquisition order"@en ; cd:yAxisLabel "Nitrate result (mg/L)"@en ; cd:authoredResource true .
 ex:p1-variance-compare a cd:ChartDefinition ; skos:prefLabel "Six and thirty measurements: one common sample-variance scale"@en ; cd:body "- Repeated normal series; true SD fixed at 0.10 mg/L.\n- More measurements per series improve variance precision.\n- More simulated series only smooth the picture."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "variance" ; cd:hasExperimentParameter ex:rx-n6, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-observed, ex:p1-comp30 ; cd:xAxisLabel "Sample variance ((mg/L) squared)"@en ; cd:yAxisLabel "Comparable density histograms"@en ; cd:authoredResource true .
 ex:p1-student-compare a cd:ChartDefinition ; skos:prefLabel "Four versus thirty measurements: different Student critical values"@en ; cd:body "Four measurements leave three df; thirty leave twenty-nine. Both retain the same two-sided 5% error budget. The positive critical value moves from 3.18245 to 2.04523. These are hypothetical designs, not changed CRM observations."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "student" ; cd:hasExperimentParameter ex:p1-n4, ex:p1-Mreference, ex:rx-sigma, ex:p1-seed-reference, ex:rx-departure, ex:rx-observedSd, ex:p1-comp30, ex:p1-view1 ; cd:xAxisLabel "Studentized mean departure"@en ; cd:yAxisLabel "Student reference comparison"@en ; cd:authoredResource true .
 ex:p1-student-decision a cd:ChartDefinition ; skos:prefLabel "Observed t lies just inside the two-sided non-rejection interval"@en ; cd:body "Actual six-result CRM case: observed t 2.44949 is inside the five-df bounds -2.57058 and +2.57058. Student p is 0.05797; the hypothetical known-SD normal p would be 0.01431. The estimated SD is not a known population SD."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "student" ; cd:hasExperimentParameter ex:p1-n6-fixed, ex:p1-Mreference, ex:rx-sigma, ex:p1-seed-reference, ex:rx-departure, ex:rx-observedSd, ex:p1-view2 ; cd:xAxisLabel "Studentized mean departure"@en ; cd:yAxisLabel "Two-sided 5% decision"@en ; cd:authoredResource true .
 ex:p1-student-ci a cd:ChartDefinition ; skos:prefLabel "The same decision, now on a concentration axis"@en ; cd:body "The 95% mean interval is 9.99506 to 10.20494 mg/L. The fixed 10.00 mg/L CRM reference is just inside, matching the two-sided t-test non-rejection. The interval does not describe 95% of individual results."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "student" ; cd:hasExperimentParameter ex:p1-n6-fixed, ex:p1-Mreference, ex:rx-sigma, ex:p1-seed-reference, ex:rx-departure, ex:rx-observedSd, ex:p1-crm-reference, ex:p1-view3 ; cd:xAxisLabel "Concentration (mg/L)"@en ; cd:yAxisLabel "Mean confidence interval and reference"@en ; cd:authoredResource true .
 ex:p1-f-df a cd:ChartDefinition ; skos:prefLabel "An asymmetric design exposes the ordered degrees of freedom"@en ; cd:body "Hypothetical design: B has ten measurements and A six, so B/A uses numerator df nine and denominator df five. Reversing the ratio swaps both roles. This does not replace the original observed six-versus-six device study."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "f-ratio" ; cd:hasExperimentParameter ex:rx-nA, ex:p1-nB10, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-ratio, ex:rx-alpha05, ex:rx-reverse, ex:p1-view1 ; cd:xAxisLabel "Prespecified variance ratio"@en ; cd:yAxisLabel "F reference for an asymmetric design"@en ; cd:authoredResource true .
 ex:p1-f-decision a cd:ChartDefinition ; skos:prefLabel "The observed variance ratio and both rejection tails"@en ; cd:body "Return to the actual independent six-versus-six groups. B/A is nine, outside the equal-tail 5% bounds 0.139931 and 7.146382. The two-sided p-value is 0.030749. Alpha sensitivity is not permission to choose the error rate after observing the data."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "f-ratio" ; cd:hasExperimentParameter ex:rx-nA, ex:rx-nB, ex:rx-M, ex:rx-sigma, ex:rx-seed, ex:rx-ratio, ex:rx-alpha05, ex:rx-reverse, ex:p1-view2 ; cd:xAxisLabel "B/A sample variance ratio"@en ; cd:yAxisLabel "F reference and equal-tail decision"@en ; cd:authoredResource true .
 ex:p1-calibration-residuals a cd:ChartDefinition ; skos:prefLabel "First inspect the linear calibration residuals"@en ; cd:body "New constructed calibration data. The linear residuals show a systematic bend around zero. Ask whether a quadratic term might help before revealing its fit and the nested-model statistic on the next scene."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "calibration" ; cd:hasExperimentParameter ex:p1-quadratic-off, ex:p1-view1 ; cd:usesDataset ex:rx-cal-data ; cd:xAxisLabel "Calibration concentration (mg/L)"@en ; cd:yAxisLabel "Linear-model residual response"@en ; cd:authoredResource true .
 ex:p1-pearson-contributions a cd:ChartDefinition ; skos:prefLabel "From category counts to weighted discrepancies and a decision"@en ; cd:body "- Initial counts: 11.6 exceeds the four-df 5% cutoff of 9.49.\n- Therefore these counts differ significantly from the stated proportions.\n- Switching outcomes keeps categories, expectations and the decision rule fixed."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "pearson" ; cd:hasExperimentParameter ex:rx-pearson-mode, ex:p1-view1 ; cd:usesDataset ex:rx-pearson-data ; cd:xAxisLabel "Particle diameter category"@en ; cd:yAxisLabel "Contribution to Pearson statistic"@en ; cd:authoredResource true .
 ex:p1-dilution-trial a cd:ChartDefinition ; skos:prefLabel "One triple of uniforms produces one concentration result"@en ; cd:body "- Draw, transform, calculate one concentration.\n- Trace one trial before interpreting repeated trials; retain the seeded stream."@en ; cd:chartType cd:ScientificExperiment ; cd:experimentKind "dilution" ; cd:hasExperimentParameter ex:p1-Mone, ex:rx-seedmc, ex:rx-signal, ex:rx-signalSd, ex:rx-slope, ex:rx-intercept, ex:rx-pipette, ex:rx-pipetteHalf, ex:rx-flask, ex:rx-flaskHalf, ex:rx-source ; cd:xAxisLabel "One propagated trial"@en ; cd:yAxisLabel "Concentration result (mg/L)"@en ; cd:authoredResource true .

 ex:p1-view1 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Authored comparison / transformation view"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 1.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-n200 a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "n" ; skos:prefLabel "Independent signed contributions"@en ; cd:numericValue 4.0 ; cd:parameterMinimum 4.0 ; cd:parameterMaximum 200.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-overlay-on a cd:ExperimentParameter ; cd:position 3 ; cd:parameterKey "overlay" ; skos:prefLabel "Normal reference: 0 off, 1 on"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 1.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-df5 a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "df" ; skos:prefLabel "Independent squared components"@en ; cd:numericValue 5.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 20.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-df2 a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "df" ; skos:prefLabel "Independent squared components"@en ; cd:numericValue 2.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 20.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-view2 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Authored focused / decision view"@en ; cd:numericValue 2.0 ; cd:parameterMinimum 2.0 ; cd:parameterMaximum 2.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-view3 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Authored inverse / interval view"@en ; cd:numericValue 3.0 ; cd:parameterMinimum 3.0 ; cd:parameterMaximum 3.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-view4 a cd:ExperimentParameter ; cd:position 20 ; cd:parameterKey "view" ; skos:prefLabel "Authored two-model comparison view"@en ; cd:numericValue 4.0 ; cd:parameterMinimum 4.0 ; cd:parameterMaximum 4.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-inverse-on a cd:ExperimentParameter ; cd:position 6 ; cd:parameterKey "inverse" ; skos:prefLabel "Inverse mode: upper rate chosen first"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 1.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-sigmaB a cd:ExperimentParameter ; cd:position 7 ; cd:parameterKey "comparisonSigma" ; skos:prefLabel "Device B known model SD (mg/L)"@en ; cd:numericValue 0.20 ; cd:parameterMinimum 0.20 ; cd:parameterMaximum 0.20 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-band a cd:ExperimentParameter ; cd:position 7 ; cd:parameterKey "band" ; skos:prefLabel "Symmetric distance in SD units"@en ; cd:numericValue 2.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 3.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-M20 a cd:ExperimentParameter ; cd:position 8 ; cd:parameterKey "M" ; skos:prefLabel "Results in the seeded prefix"@en ; cd:numericValue 20.0 ; cd:parameterMinimum 20.0 ; cd:parameterMaximum 1000.0 ; cd:parameterStep 10.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-factor125 a cd:ExperimentParameter ; cd:position 2 ; cd:parameterKey "factor" ; skos:prefLabel "Relative factor"@en ; cd:numericValue 1.25 ; cd:parameterMinimum 0.80 ; cd:parameterMaximum 1.30 ; cd:parameterStep 0.01 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-steps2 a cd:ExperimentParameter ; cd:position 4 ; cd:parameterKey "steps" ; skos:prefLabel "Number of effects"@en ; cd:numericValue 2.0 ; cd:parameterMinimum 2.0 ; cd:parameterMaximum 12.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-mode2 a cd:ExperimentParameter ; cd:position 7 ; cd:parameterKey "mode" ; skos:prefLabel "0 absolute, 1 repeated factor, 2 factor and reciprocal"@en ; cd:numericValue 2.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 2.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-mode1 a cd:ExperimentParameter ; cd:position 7 ; cd:parameterKey "mode" ; skos:prefLabel "0 stable, 1 outlier, 2 drift"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 2.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-comp30 a cd:ExperimentParameter ; cd:position 19 ; cd:parameterKey "comparisonN" ; skos:prefLabel "Comparison measurements per series"@en ; cd:numericValue 30.0 ; cd:parameterMinimum 30.0 ; cd:parameterMaximum 30.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-n4 a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "n" ; skos:prefLabel "Measurements in the first hypothetical design"@en ; cd:numericValue 4.0 ; cd:parameterMinimum 3.0 ; cd:parameterMaximum 100.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-n6-fixed a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "n" ; skos:prefLabel "Actual CRM sample size"@en ; cd:numericValue 6.0 ; cd:parameterMinimum 6.0 ; cd:parameterMaximum 6.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-crm-reference a cd:ExperimentParameter ; cd:position 19 ; cd:parameterKey "reference" ; skos:prefLabel "Fixed CRM reference (mg/L), negligible teaching uncertainty"@en ; cd:numericValue 10.0 ; cd:parameterMinimum 10.0 ; cd:parameterMaximum 10.0 ; cd:parameterStep 0.01 ; cd:adjustableParameter false ; cd:authoredResource true .
 ex:p1-nB10 a cd:ExperimentParameter ; cd:position 2 ; cd:parameterKey "nB" ; skos:prefLabel "Hypothetical measurements in B"@en ; cd:numericValue 10.0 ; cd:parameterMinimum 3.0 ; cd:parameterMaximum 100.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-quadratic-off a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "showQuadratic" ; skos:prefLabel "Additional fit hidden for the initial residual question"@en ; cd:numericValue 0.0 ; cd:parameterMinimum 0.0 ; cd:parameterMaximum 1.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-Mone a cd:ExperimentParameter ; cd:position 1 ; cd:parameterKey "M" ; skos:prefLabel "Monte Carlo trials, starting with one"@en ; cd:numericValue 1.0 ; cd:parameterMinimum 1.0 ; cd:parameterMaximum 10000.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter true ; cd:authoredResource true .
 ex:p1-Mreference a cd:ExperimentParameter ; cd:position 8 ; cd:parameterKey "M" ; skos:prefLabel "Fixed reference replay count, not the observed sample size"@en ; cd:numericValue 1000.0 ; cd:parameterMinimum 1000.0 ; cd:parameterMaximum 1000.0 ; cd:parameterStep 1.0 ; cd:adjustableParameter false ; cd:authoredResource true .
