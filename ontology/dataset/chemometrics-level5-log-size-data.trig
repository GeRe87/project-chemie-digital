<https://w3id.org/project-chemie-digital/graph/data/level5-log-size> {
  ex:dep-log-size a cd:Concept ; skos:prefLabel "Lognormal particle diameter model"@en ; cd:hasDefinition ex:dep-log-size-definition ; cd:authoredResource true .
  ex:dep-log-size-definition a cd:Definition ; cd:body "A positive particle diameter is lognormal when the natural log of its ratio to a fixed positive length reference is normal. Multiplicative growth can motivate this model, provided log contributions and their dependence justify it. It describes number-weighted sizes, not particle counts. Multimodality, agglomeration, truncation and detection bias can defeat it."@en ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:unit-level5-probability-models cd:hasFocusConcept ex:dep-log-size .
  ex:dep-log-size-chart a cd:ChartDefinition ; skos:prefLabel "Specified size model, not fitted microscopy data"@en ; cd:body "Log mean ln(2), log SD 0.75; diameter in µm. Positive tails continue beyond the drawing."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.40 ; cd:usesDataset ex:dep-size-density ; cd:xAxisLabel "Particle diameter"@en ; cd:xAxisUnit "µm" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "per µm" ; cd:authoredResource true .
  ex:dep-log-tail-chart a cd:ChartDefinition ; skos:prefLabel "Fraction above 5 µm under the model"@en ; cd:body "Full upper-tail probability: 11.09%. Shading stops at the 20 µm drawing boundary, not at infinity."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.40 ; cd:usesDataset ex:dep-size-density ; cd:hasChartAnnotation ex:dep-size-tail-mark ; cd:xAxisLabel "Particle diameter"@en ; cd:xAxisUnit "µm" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "per µm" ; cd:authoredResource true .
