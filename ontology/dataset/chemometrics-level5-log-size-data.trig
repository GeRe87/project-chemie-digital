  ex:dep-size-density a cd:Dataset ; skos:prefLabel "Evaluated lognormal diameter density"@en ; cd:unit "µm" ; cd:derivedFromResource ex:dep-log-law ; cd:hasObservation ex:dep-size0, ex:dep-size1, ex:dep-size2, ex:dep-size3, ex:dep-size4, ex:dep-size5, ex:dep-size6, ex:dep-size7, ex:dep-size8, ex:dep-size9, ex:dep-size10, ex:dep-size11, ex:dep-size12, ex:dep-size13, ex:dep-size14 ; cd:authoredResource true .
