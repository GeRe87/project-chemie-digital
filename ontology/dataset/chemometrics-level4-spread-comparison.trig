  ex:l4-scene-spread-skewed a cd:SceneDefinition ; cd:focusConcept ex:median-absolute-deviation ; cd:hasSceneItem ex:l4-spread-skewed-item1, ex:l4-spread-skewed-item2, ex:l4-spread-skewed-item3, ex:l4-spread-skewed-item4, ex:l4-spread-skewed-item5 ; cd:authoredResource true .
