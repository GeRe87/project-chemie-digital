  ex:vv-centers-k a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:vv-centers-cue ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-centers-media a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-centers-svg ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-shift-media a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-centers-svg ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-sum-media a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-decomposition-svg ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-simplify-media a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-decomposition-svg ; cd:communicativeRole cd:MediaRole ; cd:selectionPath "cd:uri" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-recap-chart a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:uq-corrected-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
