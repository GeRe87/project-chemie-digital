  ex:vv-scatter-i a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-scatter ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-scatter-k a cd:SceneItem ; cd:position 4 ; cd:selectsResource ex:vv-scatter-cue ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
  ex:vv-mc-c a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:vv-mc-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
