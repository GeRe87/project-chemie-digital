  ex:l8-script-material-1-3 a cd:ScriptMaterial ; cd:position 4 ; cd:scriptResource ex:l8-f-line ; dct:title "Fit by eye: two coefficients: formula and complete symbol legend"@en ; cd:authoredResource true .
