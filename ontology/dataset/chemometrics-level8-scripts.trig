  ex:l8-multiple-regression-coefficients-script a cd:ScriptMaterial ; cd:position 13 ; cd:scriptResource ex:l8-multiple-regression-coefficients-formula ; dct:title "Substitute the products to get three coefficients"@en ; cd:relatedScene ex:l8-multiple-regression-coefficients-scene ; cd:authoredResource true .
