  ex:l8-script-material-residual-orthogonality a cd:ScriptMaterial ; cd:position 6 ; cd:scriptResource ex:l8-orthogonality-section ; dct:title "Two residual conditions as one matrix equation, with complete symbol legends"@en ; dct:references ex:l8-f-orthogonality-input, ex:l8-f-orthogonal ; cd:relatedScene ex:l8-scene-residual-orthogonality ; cd:authoredResource true .
