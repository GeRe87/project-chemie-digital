  ex:l8-multiple-regression-fit-formula-script a cd:ScriptMaterial ; cd:position 16 ; cd:scriptResource ex:l8-multiple-regression-fit-formula ; dct:title "Predict detector signal from two settings"@en ; cd:relatedScene ex:l8-multiple-regression-fit-scene ; cd:authoredResource true .
