<https://w3id.org/project-chemie-digital/graph/scenes/level5-lognormal-workup> {
  ex:lg-checks-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-checks-title .
  ex:lg-checks-title rdf:type cd:Interpretation ;
    skos:prefLabel "Match the lognormal model to the measurement process"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:lg-definition-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-definition-title .
  ex:lg-definition-title rdf:type cd:Interpretation ;
    skos:prefLabel "Exponentiating a normal log ratio creates the model"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:lg-log-scale-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:lg-log-scale .
  ex:lg-log-scale-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-log-scale-title .
  ex:lg-log-scale-scene dct:subject ex:l5-topic-lognormal ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:lognormal-concentration-model ;
    cd:hasSceneItem ex:lg-log-scale-f ;
    cd:hasSceneItem ex:lg-log-scale-h ;
    cd:hasSceneItem ex:lg-log-scale-v ;
    cd:narration "The same three concentrations have linear gaps of 2 and 2.5 ng/L. Their natural log ratios to 10 ng/L are symmetric around zero, at about -0.22314 and 0.22314.\n\nLogarithms express relative changes. Their arguments are dimensionless, and concentrations below the reference give negative log ratios."@en .
  ex:lg-log-scale-title rdf:type cd:Interpretation ;
    skos:prefLabel "A log axis displays relative concentration changes"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:lg-log-scale-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:MediaRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:uri" ;
    cd:selectsResource ex:lg-scales-media .
  ex:lg-process dct:subject ex:l5-topic-lognormal ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:lognormal-concentration-model ;
    cd:hasSceneItem ex:lg-process-c ;
    cd:hasSceneItem ex:lg-process-h ;
    cd:hasSceneItem ex:lg-process-v ;
    cd:narration "This example measures an organic trace analyte by LC-MS/MS in ng/L. Procedure A repeats injections of one prepared solution. Procedure B independently prepares aliquots from one homogeneous sample.\n\nB includes preparation variability as well as injection variability. Relative preparation effects motivate a multiplicative candidate model."@en .
  ex:lg-process-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:lg-process-cards .
  ex:lg-process-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-process-title .
  ex:lg-process-title rdf:type cd:Interpretation ;
    skos:prefLabel "Multiplicative factors motivate a different model"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:lg-process-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:MediaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:uri" ;
    cd:selectsResource ex:lg-process-media .
  ex:lg-saved-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-saved-title .
  ex:lg-saved-title rdf:type cd:Interpretation ;
    skos:prefLabel "Positive relative factors can produce a long right tail"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:lg-saved-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:ChartRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:body" ;
    cd:selectsResource ex:lg-saved-chart .
  ex:lg-tail-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:lg-tail-title .
  ex:lg-tail-title rdf:type cd:Interpretation ;
    skos:prefLabel "Lognormal tail probabilities retain the concentration scale"@en ;
    cd:authoredResource "true"^^xsd:boolean .
}

