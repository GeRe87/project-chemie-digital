    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:nn-phi .
  ex:nn-phi-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:nn-phi-title .
  ex:nn-phi-title rdf:type cd:Interpretation ;
    skos:prefLabel "$\\varphi$ describes the standard-Normal density"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:nn-tail-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:nn-tail .
  ex:nn-tail-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:nn-tail-title .
  ex:nn-tail-title rdf:type cd:Interpretation ;
    skos:prefLabel "A fixed limit's exceedance probability depends on model spread"@en ;
    cd:authoredResource "true"^^xsd:boolean .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-review-complete> {
