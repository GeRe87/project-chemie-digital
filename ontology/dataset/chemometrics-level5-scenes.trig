  ex:ix-square-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:ix-square .
  ex:ix-square-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ix-square-title .
  ex:ix-square-scene dct:subject ex:l5-topic-chi ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:al-chi-square ;
    cd:hasSceneItem ex:ix-square-f ;
    cd:hasSceneItem ex:ix-square-h ;
    cd:hasSceneItem ex:ix-square-v ;
    cd:narration "Squaring a standard-normal value folds both tails onto the nonnegative axis. The result follows a chi-square distribution with one degree of freedom and a long right tail. As for every continuous variable, probabilities describe intervals; each exact value has probability zero."@en .
  ex:ix-square-title rdf:type cd:Interpretation ;
    skos:prefLabel "Squaring a standard-Normal draw creates a chi-square quantity"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:ix-square-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:MediaRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:uri" ;
    cd:selectsResource ex:ix-square-media .
  ex:ix-sum-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:ix-sum .
  ex:ix-sum-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ix-sum-title .
  ex:ix-sum-title rdf:type cd:Interpretation ;
    skos:prefLabel "Add independent squares to construct chi-square"@en ;
    cd:authoredResource "true"^^xsd:boolean .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-ic-precision> {
  ex:ic-deviations-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ic-deviations-title .
  ex:ic-deviations-t rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:TableRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:hasTableRow" ;
    cd:selectsResource ex:ic-deviation-table .
  ex:ic-deviations-title rdf:type cd:Interpretation ;
    skos:prefLabel "How much do the six nitrate results vary?"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:ic-repeated-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ic-repeated-title .
  ex:ic-repeated-title rdf:type cd:Interpretation ;
    skos:prefLabel "An unchanged method still produces varying variance estimates"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:ic-squares dct:subject ex:l5-topic-chi ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:al-chi-square ;
    cd:hasSceneItem ex:ic-squares-c ;
    cd:hasSceneItem ex:ic-squares-f ;
    cd:hasSceneItem ex:ic-squares-h ;
    cd:hasSceneItem ex:ic-squares-v ;
    cd:narration "Scale the deviations from the sample mean 10.05 mg/L by the reference SD 0.10 mg/L. The residuals become -1, 1, -2, 2, -1, 1; their squared sum is 12.\n\nThe same result follows from 0.12 / 0.01 or 5 times 0.024 / 0.01. Units cancel. Estimating the mean links the six residuals, leaving five independent degrees of freedom under the Normal model."@en .
  ex:ic-squares-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:ic-q-context .
  ex:ic-squares-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "4"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:ic-q .
  ex:ic-squares-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ic-squares-title .
  ex:ic-squares-title rdf:type cd:Interpretation ;
    skos:prefLabel "Scaled squared deviations make sample spread comparable"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:ic-squares-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:MediaRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:uri" ;
    cd:selectsResource ex:ic-residual-media .
  ex:ic-test dct:subject ex:l5-topic-chi ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:al-chi-square ;
    cd:hasSceneItem ex:ic-test-c ;
    cd:hasSceneItem ex:ic-test-f ;
    cd:hasSceneItem ex:ic-test-h ;
    cd:hasSceneItem ex:ic-test-v ;
    cd:narration "The prespecified question is whether repeatability SD exceeds 0.10 mg/L. At this boundary, Q = 12 has upper-tail probability 0.0347878, about 3.48%. It exceeds the 5% critical value 11.0704977, providing evidence of increased spread.\n\nThe reference requires independent Normal readings and a known reference SD. Smaller true SDs shift Q downward. The p-value describes the statistic's tail probability under the boundary model. Laboratory procedures govern investigation and release; identifying the cause requires further evidence."@en .
  ex:ic-test-c rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:DefinitionListRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
    cd:selectionPath "cd:hasDefinitionListEntry" ;
    cd:selectsResource ex:ic-decision-context .
  ex:ic-test-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "4"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:ic-decision .
  ex:ic-test-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:ic-test-title .
  ex:ic-test-title rdf:type cd:Interpretation ;
    skos:prefLabel "An upper-tail comparison checks the reference precision"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:ic-test-v rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:MediaRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:uri" ;
    cd:selectsResource ex:ic-tail-media .
}

