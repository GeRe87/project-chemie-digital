<https://w3id.org/project-chemie-digital/graph/scenes/level5-tf-story> {
  ex:tf-denominator-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:tf-denominator-title .
  ex:tf-denominator-title rdf:type cd:Interpretation ;
    skos:prefLabel "An estimated denominator gives t its heavier tails"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:tf-df-live-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:tf-df-live-title .
  ex:tf-df-live-title rdf:type cd:Interpretation ;
    skos:prefLabel "More degrees of freedom bring t closer to Normal"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:tf-f-construction-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "2"^^xsd:integer ;
    cd:selectionPath "cd:latex" ;
    cd:selectsResource ex:tf-f-law .
  ex:tf-f-construction-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:tf-f-construction-title .
  ex:tf-f-construction-scene dct:subject ex:l5-topic-f ;
    rdf:type cd:SceneDefinition ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:focusConcept ex:l5-f-distribution ;
    cd:hasSceneItem ex:tf-f-construction-f ;
    cd:hasSceneItem ex:tf-f-construction-h ;
    cd:narration "An F variable is the ratio of two independent chi-square variables, each divided by its own degrees of freedom. For independent Normal samples, these terms arise from sample variances scaled by their true variances. Equal true variances cancel, leaving the sample-variance ratio B/A; population means may differ."@en .
  ex:tf-f-construction-title rdf:type cd:Interpretation ;
    skos:prefLabel "F combines two independent chi-square quantities"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:tf-f-live-h rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:tf-f-live-title .
  ex:tf-f-live-title rdf:type cd:Interpretation ;
    skos:prefLabel "Equal true variances give a reference for the sample ratio"@en ;
    cd:authoredResource "true"^^xsd:boolean .
}

<https://w3id.org/project-chemie-digital/graph/scenes/level5-review-pdf-cdf> {
  ex:l5-interval-question a cd:Interpretation ; cd:authoredResource true ;
