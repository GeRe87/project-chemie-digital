    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:HeadingRole ;
    cd:language "en" ;
    cd:position "1"^^xsd:integer ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:selectsResource ex:nn-eta-title .
  ex:nn-eta-title rdf:type cd:Interpretation ;
    skos:prefLabel "z-score: distance from expectation in SD units"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:nn-phi-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
    cd:position "3"^^xsd:integer ;
