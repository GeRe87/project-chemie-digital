  ex:nn-phi-title rdf:type cd:Interpretation ;
    skos:prefLabel "Lowercase phi describes density, not point probability"@en ;
    cd:authoredResource "true"^^xsd:boolean .
  ex:nn-tail-f rdf:type cd:SceneItem ;
    cd:authoredResource "true"^^xsd:boolean ;
    cd:communicativeRole cd:FormulaRole ;
    cd:language "en" ;
