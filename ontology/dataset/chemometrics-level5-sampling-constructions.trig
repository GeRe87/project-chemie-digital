@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-sampling-constructions> {
  ex:dep-origins-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-sampling-origins.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Sampling distributions arise from analytical statistics, not from changing the raw measurements. Under iid normal sampling, fitting a mean leaves independent normal residual coordinates whose squared sum gives chi-square and a variance reference. A normal mean divided by an independent estimated scale gives Student-t. A ratio of two independently estimated normal-sample variances gives an F reference after appropriate scaling. Normality and independence are essential."@en ; dct:references ex:dep-chi-build, ex:dep-t-build, ex:dep-f-build ; cd:authoredResource true .
  ex:dep-chi-build a cd:MathExpression ; cd:formulaLabel "Squared independent standard-normal coordinates"@en ; cd:latex "\\begin{gathered}U=\\sum_{i=1}^{\\nu}Z_i^2\\sim\\chi^2_\\nu\\\\u=1^2+(-1)^2+0^2+2^2=6,\\quad\\nu=4\\end{gathered}" ; dct:hasPart ex:dep-chi-build-legend ; cd:hasSymbol ex:dep-chi-values, ex:dep-chi-rule, ex:dep-chi-ops ; cd:authoredResource true .
  ex:dep-chi-build-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-chi-entry ; cd:authoredResource true .
  ex:dep-chi-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Construction and illustration"@en ; dct:references ex:dep-chi-values, ex:dep-chi-rule, ex:dep-chi-ops ; cd:authoredResource true .
  ex:dep-chi-values a cd:MathSymbol ; cd:symbol "normal coordinates" ; cd:mathNotation "Z_i,\\ i,\\ \\nu" ; cd:body "Z subscript i are independent standard-normal quantities. Index i runs from one to nu; nu counts coordinates and is degrees of freedom. Four chosen values 1,-1,0,2 illustrate arithmetic, not measured raw residuals or proof of a distribution."@en ; cd:authoredResource true .
  ex:dep-chi-rule a cd:MathSymbol ; cd:symbol "chi-square law" ; cd:mathNotation "U,\\ u,\\ \\chi^2_\\nu" ; cd:body "U is the random sum of squares, u one realized sum, all dimensionless. Tilde means distributed as chi-square with nu degrees of freedom. Fitting one sample mean leaves n minus one independent normal residual coordinates, not n independent centered raw residuals."@en ; cd:authoredResource true .
  ex:dep-chi-ops a cd:MathSymbol ; cd:symbol "sum of squares" ; cd:mathNotation "\\sum,\\ (\\ )^2,\\ +,\\ =" ; cd:body "Sum adds every indexed squared coordinate; parentheses group a negative value before squaring. Plus adds and equality evaluates the illustration. Squaring removes sign and makes the sum nonnegative. Normal independence gives this exact law, not a large-sample approximation."@en ; cd:authoredResource true .

  ex:dep-t-build a cd:MathExpression ; cd:formulaLabel "An estimated denominator adds tail uncertainty"@en ; cd:latex "\\begin{gathered}T=\\frac{Z}{\\sqrt{U/\\nu}}\\sim t_\\nu\\\\z=1,\\ u=1,\\ \\nu=4\\quad\\Longrightarrow\\quad t=\\frac{1}{\\sqrt{1/4}}=2\\end{gathered}" ; dct:hasPart ex:dep-t-build-legend ; cd:hasSymbol ex:dep-t-values, ex:dep-t-law, ex:dep-t-ops ; cd:authoredResource true .
  ex:dep-t-build-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-t-entry ; cd:authoredResource true .
  ex:dep-t-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent numerator and scale"@en ; dct:references ex:dep-t-values, ex:dep-t-law, ex:dep-t-ops ; cd:authoredResource true .
  ex:dep-t-values a cd:MathSymbol ; cd:symbol "numerator and scale" ; cd:mathNotation "Z,\\ U,\\ \\nu" ; cd:body "Z is standard normal; U is an independent chi-square with positive degrees of freedom nu. U/nu is a random variance-scale estimate. All are dimensionless. Independence is essential; arbitrary ratios do not have a t law."@en ; cd:authoredResource true .
  ex:dep-t-law a cd:MathSymbol ; cd:symbol "Student-t variable" ; cd:mathNotation "T,\\ t_\\nu,\\ z,\\ u,\\ t" ; cd:body "Uppercase T is the random ratio; t subscript nu names its Student-t law. Lowercase z,u,t are illustrative realized values. A small realized denominator can enlarge t, explaining heavier tails. The actual mean-inference version uses an independent normal mean and sample variance."@en ; cd:authoredResource true .
  ex:dep-t-ops a cd:MathSymbol ; cd:symbol "scale arithmetic" ; cd:mathNotation "\\sqrt{\\ },\\ /,\\ =,\\ \\sim" ; cd:body "Square root is positive; fractions divide; equals states construction or arithmetic; tilde names a law. The implication arrow inserts z=1,u=1,nu=4: root 1/4 is 1/2, giving two. If u were four instead, the denominator would be one and t one."@en ; cd:authoredResource true .

  ex:dep-f-build a cd:MathExpression ; cd:formulaLabel "Two uncertain variance scales form an ordered ratio"@en ; cd:latex "\\begin{gathered}F=\\frac{U_1/\\nu_1}{U_2/\\nu_2}\\sim F_{\\nu_1,\\nu_2}\\\\f=\\frac{10/5}{2.5/5}=\\frac{2}{0.5}=4\\end{gathered}" ; dct:hasPart ex:dep-f-build-legend ; cd:hasSymbol ex:dep-f-values, ex:dep-f-law, ex:dep-f-ops ; cd:authoredResource true .
  ex:dep-f-build-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:dep-f-entry ; cd:authoredResource true .
  ex:dep-f-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent scaled chi-squares"@en ; dct:references ex:dep-f-values, ex:dep-f-law, ex:dep-f-ops ; cd:authoredResource true .
  ex:dep-f-values a cd:MathSymbol ; cd:symbol "two scale estimates" ; cd:mathNotation "U_1,U_2,\\ \\nu_1,\\nu_2" ; cd:body "U1 and U2 are independent chi-square quantities, each divided by its own positive degrees of freedom nu1 or nu2. Indices distinguish numerator and denominator, not powers. The example chooses 10 and 2.5 with five degrees of freedom each."@en ; cd:authoredResource true .
  ex:dep-f-law a cd:MathSymbol ; cd:symbol "F reference" ; cd:mathNotation "F,\\ F_{\\nu_1,\\nu_2},\\ f" ; cd:body "Uppercase F is the random ratio; the subscripted F names its law with ordered numerator/denominator degrees of freedom. Lowercase f=4 is one illustrative ratio, dimensionless. Independent normal-series variances give this reference under equal population variances."@en ; cd:authoredResource true .
  ex:dep-f-ops a cd:MathSymbol ; cd:symbol "ratio arithmetic" ; cd:mathNotation "=,\\ /,\\ \\sim" ; cd:body "Equals defines and evaluates; fractions divide; tilde means distributed as. First normalize each scale (10/5=2, 2.5/5=0.5), then divide to obtain four. Reversing the quotient swaps degrees of freedom. Neither this ratio nor F assesses method bias or accuracy."@en ; cd:authoredResource true .
}
