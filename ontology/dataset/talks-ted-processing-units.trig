  ex:ted-unit-state-specs a cd:DiagramState ; cd:position 2 ; skos:prefLabel "2. Atomic and composite specializations"@en ; cd:activeDiagramNode ex:ted-unit-model, ex:ted-unit-specializations ; cd:authoredResource true .
  ex:ted-unit-state-operation a cd:DiagramState ; cd:position 3 ; skos:prefLabel "3. Concrete operation and its implementation"@en ; cd:activeDiagramNode ex:ted-unit-model, ex:ted-unit-specializations, ex:ted-unit-operation ; cd:authoredResource true .
