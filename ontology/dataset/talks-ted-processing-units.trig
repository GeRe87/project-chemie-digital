  ex:ted-unit-specializations a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Specializations"@en ; cd:visualMotif "processing-composition" ; cd:visualMotifRole "highlight" ; cd:hasDiagramNodePart ex:ted-unit-part-step, ex:ted-unit-part-pipeline, ex:ted-unit-part-node ; dct:references ex:cogniflow-domain-specifications ; cd:authoredResource true .
