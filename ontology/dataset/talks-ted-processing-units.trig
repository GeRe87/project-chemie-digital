<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-processing-units> {
  ex:ted-scene-processing-step a cd:SceneDefinition ; cd:focusConcept ex:ted-processing-step ; cd:hasSceneItem ex:ted-step-heading, ex:ted-step-diagram, ex:ted-step-bullets ; cd:narration "Transfer the semantic-description idea to data processing. A step receives input data, performs a defined transformation and produces output data. Parameters configure what happens inside. We first describe this boundary without opening the algorithm. The schematic shows one input and output for clarity, not a restriction to one port. A semantic description must say what the data mean, not just where a file is stored."@en ; cd:authoredResource true .
  ex:ted-step-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-processing-step ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-step-diagram a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-step-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-step-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-step-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .

  ex:ted-scene-composable-steps a cd:SceneDefinition ; cd:focusConcept ex:ted-composable-steps ; cd:hasSceneItem ex:ted-chain-heading, ex:ted-chain-diagram, ex:ted-chain-bullets ; cd:narration "A pipeline repeats the same input-task-output pattern with specialized tasks. In this TED excerpt, qPeaks receives EICs and produces features. Joint fitting receives those features and produces components. Marker selection receives components and returns selected marker components. Each result can supply the next step only when meaning, type, structure, units and constraints are compatible. A matching filename, extension or port label does not establish compatibility. An explicit conversion may be required. Import and external calibration still belong to the full pipeline shown earlier; this excerpt explains composition rather than adding a new analytical method."@en ; cd:authoredResource true .
  ex:ted-chain-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-composable-steps ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-chain-diagram a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-chain-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-chain-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-chain-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .

  ex:ted-scene-processing-unit a cd:SceneDefinition ; cd:focusConcept ex:ted-processing-unit ; cd:hasSceneItem ex:ted-unit-heading, ex:ted-unit-diagram, ex:ted-unit-bullets ; cd:narration "For FAIR interoperability, make interfaces explicit and understandable first. Describe required inputs and promised outputs using standardized terms, data types, structures, units and relevant constraints. Then explain the implementation: algorithm, parameters, software version and execution provenance. This is our explanatory order, not a ranking that makes algorithms irrelevant to FAIR reuse. The CogniFlow workshop calls the reusable abstraction ProcessingUnit. It has Ports with roles Input, Output and Parameter. ProcessingStep is atomic and ProcessingPipeline is composite; both expose the same kind of interface. The diagram shows data flow at that boundary, not the directions of hasPort assertions. Shared semantics lets different tools agree on a contract, but licenses, discovery, access, persistence and provenance remain necessary. The model is adapted from the supplied cogniflow_workshop concept-domain diagram and the existing canonical CogniFlow teaching definitions, without importing historical meta-model syntax."@en ; cd:authoredResource true .
  ex:ted-unit-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-processing-unit ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-unit-diagram a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-unit-flow ; cd:communicativeRole cd:DiagramRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-unit-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-unit-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
