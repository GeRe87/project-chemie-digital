<https://w3id.org/project-chemie-digital/graph/paths/talk-microplastics-ted-gc-ms> {
  ex:path-talk-microplastics-ted-gc-ms cd:forTopic ex:ted-processing-step, ex:ted-composable-steps, ex:ted-processing-unit ; cd:hasStep ex:ted-step-processing-step, ex:ted-step-composable-steps, ex:ted-step-processing-unit .
