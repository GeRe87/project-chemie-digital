  ex:ted-unit-part-step a cd:DiagramNodePart ; cd:position 1 ; skos:prefLabel "ProcessingStep"@en ; cd:body "Atomic ProcessingUnit"@en ; cd:authoredResource true .
  ex:ted-unit-part-pipeline a cd:DiagramNodePart ; cd:position 2 ; skos:prefLabel "ProcessingPipeline"@en ; cd:body "Composite ProcessingUnit"@en ; cd:authoredResource true .
