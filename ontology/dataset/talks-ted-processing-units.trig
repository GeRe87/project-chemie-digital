  ex:ted-chain-components a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Form components"@en ; cd:body "IN: features\nTASK: joint fitting\nOUT: components"@en ; cd:visualMotif "shared-peak-shape" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-peak-components ; cd:authoredResource true .
  ex:ted-chain-markers a cd:DiagramNode ; cd:position 3 ; skos:prefLabel "Select markers"@en ; cd:body "IN: components\nTASK: select markers\nOUT: marker components"@en ; cd:visualMotif "marker-selection" ; cd:visualMotifRole "highlight" ; dct:references ex:ted-polymer-markers ; cd:authoredResource true .
  ex:ted-chain-edge1 a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:ted-chain-peaks ; cd:targetNode ex:ted-chain-components ; skos:prefLabel "features"@en ; cd:authoredResource true .
  ex:ted-chain-edge2 a cd:DiagramEdge ; cd:position 2 ; cd:sourceNode ex:ted-chain-components ; cd:targetNode ex:ted-chain-markers ; skos:prefLabel "components"@en ; cd:authoredResource true .

  ex:ted-unit-flow a cd:FlowDiagram ; skos:prefLabel "Processing model, specializations and a concrete operation"@en ; cd:body "Three semantic levels adapted from the workshop. Arrows mean specialization and specification, not data flow or execution order. Binding connects a declared operation to its implementation."@en ; cd:hasDiagramNode ex:ted-unit-model, ex:ted-unit-specializations, ex:ted-unit-operation ; cd:hasDiagramEdge ex:ted-unit-edge1, ex:ted-unit-edge2 ; cd:hasSource ex:ted-source-processing-unit ; cd:authoredResource true .
  ex:ted-unit-model a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Shared vocabulary"@en ; cd:visualMotif "semantic-model" ; cd:visualMotifRole "highlight" ; cd:hasDiagramNodePart ex:ted-unit-part-concept, ex:ted-unit-part-port, ex:ted-unit-part-role ; dct:references ex:ted-processing-unit ; cd:authoredResource true .
  ex:ted-unit-specializations a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Specializations"@en ; cd:visualMotif "processing-composition" ; cd:visualMotifRole "highlight" ; cd:hasDiagramNodePart ex:ted-unit-part-step, ex:ted-unit-part-pipeline, ex:ted-unit-part-node ; dct:references ex:cogniflow-domain-specifications ; cd:authoredResource true .
