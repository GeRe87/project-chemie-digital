@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-domain-specifications> {
  ex:cogniflow-domain-specifications a cd:Concept ;
    skos:prefLabel "From Grammar to Scientific Meaning"@en ;
    cd:hasDefinition ex:def-cogniflow-domain-specifications ;
    cd:authoredResource true .

  ex:def-cogniflow-domain-specifications a cd:Definition ;
    cd:body "The same small semantic grammar can describe scientific domains. Peak integration is an illustrative example: the domain supplies the scientific meaning while the core grammar stays unchanged."@en ;
    cd:authoredResource true .

  ex:cogniflow-domain-grammar-banner a cd:Interpretation ;
    cd:body """SAME CORE GRAMMAR
Now applied to PEAK INTEGRATION"""@en ;
    cd:authoredResource true .

  ex:cogniflow-domain-cards a cd:Interpretation ;
    cd:body "Illustrative mapping of the core grammar to a familiar analytical-chemistry task."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-scientific-concept,
      ex:keypoint-cogniflow-scientific-attributes,
      ex:keypoint-cogniflow-scientific-relations,
      ex:keypoint-cogniflow-scientific-values,
      ex:keypoint-cogniflow-scientific-shape ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-scientific-concept a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """CONCEPT
PEAK INTEGRATION
chromatographic signal → integrated peak area"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-scientific-attributes a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """ATTRIBUTES
Signal
Baseline
Integration Window
Peak Area"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-scientific-relations a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """RELATIONS
hasSignal
hasBaseline
hasIntegrationWindow
hasPeakArea"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-scientific-values a cd:KeyPoint ;
    cd:position 4 ;
    cd:body """CONTROLLED VALUE
Integration Mode
automatic · manual"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-scientific-shape a cd:KeyPoint ;
    cd:position 5 ;
    cd:body """SHAPE
checks required context
and valid structure"""@en ;
    cd:authoredResource true .

  ex:cogniflow-domain-compatibility-note a cd:Interpretation ;
    cd:body "THE GRAMMAR STAYS THE SAME — THE DOMAIN ADDS THE SCIENTIFIC MEANING"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-domain-specifications-extension> {
  ex:path-step-cogniflow-domain-specifications a cd:PathStep ;
    cd:position 9 ;
    cd:usesResource ex:cogniflow-domain-grammar-banner,
      ex:cogniflow-domain-cards,
      ex:cogniflow-domain-compatibility-note ;
    cd:usesScene ex:scene-cogniflow-domain-specifications ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-domain-specifications> {
  ex:scene-cogniflow-domain-specifications a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-domain-specifications ;
    cd:hasSceneItem ex:scene-item-cogniflow-domain-specifications-heading,
      ex:scene-item-cogniflow-domain-specifications-grammar,
      ex:scene-item-cogniflow-domain-specifications-cards,
      ex:scene-item-cogniflow-domain-specifications-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-domain-specifications-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-domain-specifications ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-domain-specifications-grammar a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-domain-grammar-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-domain-specifications-cards a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-domain-cards ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-domain-specifications-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-domain-compatibility-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
