<https://w3id.org/project-chemie-digital/graph/scenes/talks-ted-calibration> {
  ex:ted-scene-calibration-time a cd:SceneDefinition ; cd:focusConcept ex:ted-calibration-time ; cd:hasSceneItem ex:ted-cal-time-heading, ex:ted-cal-time-chart-item, ex:ted-cal-time-bullets ;
    cd:narration "Even the optimized workflow still needs ten runs for five standards alternating with five blanks. This reuses the same optimized schedule from the previous chapter, not a second timing implementation. Std means calibration standard and B means blank. The final post-run ends at minute 550, 9 hours 10 minutes. This is the earlier workshop's schedule model, with the same sorbent-transfer and buffering assumptions. It does not justify removing blank or quality-control measurements. Source: supplied bridge-slide-time and renderBridgeCalibrationGantt."@en ; cd:authoredResource true .
  ex:ted-cal-time-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-calibration-time ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-cal-time-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-calibration-time-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-cal-time-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-calibration-time-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-scene-running-calibration a cd:SceneDefinition ; cd:focusConcept ex:ted-running-calibration ; cd:hasSceneItem ex:ted-running-heading, ex:ted-running-chart-item, ex:ted-running-bullets ;
    cd:narration "This standardized linked chart uses all 44 supplied SBR mass/area pairs, not invented calibration values. The strip shows balanced display order, not acquisition time: five near-equal-size mass strata are cycled, with 9, 9, 9, 9 and 8 records. Start with five standards spanning these strata, expand to fifteen, then replace the oldest balanced cycle of five by the next cycle while keeping fifteen. The central line is ordinary least squares on the selected observations. The right panel refits after leaving each standard out once, predicts its mass from its held-out area, and shows absolute mass errors and their mean in micrograms. These are internal cross-validation errors, not training residuals, independent validation or a confidence interval. No guarantee of lower error, drift correction or matrix equivalence follows. Blank and quality-control requirements remain. Raw-peak panels and the old fixed-t confidence-band shortcut are not reproduced. Source: supplied running-regression code and sbr_mz104_peak_table.csv; original measurement file names and acquisition dates are excluded from the public data."@en ; cd:authoredResource true .
  ex:ted-running-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:ted-running-calibration ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-running-chart-item a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:ted-running-regression-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:ted-running-bullets a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:ted-running-points ; cd:communicativeRole cd:KeyPointRole ; cd:selectionPath "cd:hasKeyPoint" ; cd:language "en" ; cd:authoredResource true .
}
