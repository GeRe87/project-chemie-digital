  ex:l4-unequal-density-h a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l4-unequal-density ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l4-unequal-density-b a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l4-unequal-density ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
