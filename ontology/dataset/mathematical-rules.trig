@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/mathematics/rules> {
  ex:rule-a-symbol a cd:MathSymbol ; cd:symbol "a, aᵢ" ; cd:body "A placeholder quantity or indexed term in a general mathematical identity."@en ; cd:authoredResource true .
  ex:rule-b-symbol a cd:MathSymbol ; cd:symbol "b, bᵢ" ; cd:body "A second placeholder quantity or indexed term."@en ; cd:authoredResource true .
  ex:rule-c-symbol a cd:MathSymbol ; cd:symbol "c" ; cd:body "A scalar placeholder; a fixed constant when pulled outside a sum or expectation."@en ; cd:authoredResource true .
  ex:rule-q-symbol a cd:MathSymbol ; cd:symbol "q" ; cd:body "A separate index-independent term; it need not be the square of another coefficient."@en ; cd:authoredResource true .
  ex:rule-U-symbol a cd:MathSymbol ; cd:symbol "U" ; cd:body "An integrable random quantity in an expectation identity."@en ; cd:authoredResource true .
  ex:rule-V-symbol a cd:MathSymbol ; cd:symbol "V" ; cd:body "A second integrable random quantity."@en ; cd:authoredResource true .
  ex:rule-Y-symbol a cd:MathSymbol ; cd:symbol "Y" ; cd:body "A random quantity with the moments required by the stated identity."@en ; cd:authoredResource true .

  ex:assumption-finite-sum a cd:Interpretation ; skos:prefLabel "Finite observation count"@en ; cd:body "n is a positive integer; all indexed equalities hold for i = 1, …, n."@en ; cd:authoredResource true .
  ex:assumption-fixed-summand a cd:Interpretation ; skos:prefLabel "Constant with respect to the index"@en ; cd:body "c has the same value for every index i within the sum; n is a positive integer."@en ; cd:authoredResource true .
  ex:assumption-arithmetic-center a cd:Interpretation ; skos:prefLabel "Residuals about the arithmetic mean"@en ; cd:body "Each residual is the observation minus the arithmetic mean of those same n observations."@en ; cd:authoredResource true .
  ex:assumption-iid-finite a cd:Interpretation ; skos:prefLabel "Independent identical observations; finite variance; n > 1"@en ; cd:body "Independent, identically distributed observations; finite population variance; n > 1. Normality is not required."@en ; cd:authoredResource true .
  ex:assumption-integrable a cd:Interpretation ; skos:prefLabel "Expectations exist"@en ; cd:body "The displayed random quantities have finite expectations. A constant moved outside E is fixed across samples."@en ; cd:authoredResource true .
  ex:assumption-second-moment a cd:Interpretation ; skos:prefLabel "Finite second moment"@en ; cd:body "Y has a finite second moment, so its expectation and variance exist."@en ; cd:authoredResource true .
  ex:assumption-n-more-one a cd:Interpretation ; skos:prefLabel "Nonzero divisor"@en ; cd:body "n > 1, so n−1 is positive and division by n−1 is valid."@en ; cd:authoredResource true .

  ex:rule-sum-equalities a cd:MathematicalRule ; skos:prefLabel "Sum indexed equalities"@en ; cd:ruleFormula ex:rule-sum-equalities-formula ; cd:requiresAssumption ex:assumption-finite-sum ; cd:body "Add the left sides and the right sides of equalities that hold at every index. This gives a consequence; the summed equality alone does not recover every individual equality."@en ; cd:hasSource ex:source-openstax-statistics ; cd:authoredResource true .
  ex:rule-sum-equalities-formula a cd:MathExpression ; cd:latex "\\begin{gathered}a_i=b_i\\ (i=1,\\ldots,n)\\\\\\Longrightarrow\\quad\\sum_{i=1}^n a_i=\\sum_{i=1}^n b_i\\end{gathered}" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-sum-linearity a cd:MathematicalRule ; skos:prefLabel "Linearity of a finite sum"@en ; cd:ruleFormula ex:rule-sum-linearity-formula ; cd:requiresAssumption ex:assumption-finite-sum ; cd:body "A finite sum distributes over addition. No independence or probability assumption is needed."@en ; cd:authoredResource true .
  ex:rule-sum-linearity-formula a cd:MathExpression ; cd:latex "\\sum_{i=1}^n(a_i+b_i)=\\sum_{i=1}^n a_i+\\sum_{i=1}^n b_i" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-sum-constant a cd:MathematicalRule ; skos:prefLabel "Sum a constant"@en ; cd:ruleFormula ex:rule-sum-constant-formula ; cd:requiresAssumption ex:assumption-fixed-summand ; cd:body "The same value is added once for each of n indices. A quantity can be random across samples and still be constant with respect to i within a given sample."@en ; cd:authoredResource true .
  ex:rule-sum-constant-formula a cd:MathExpression ; cd:latex "\\sum_{i=1}^n c=nc" ; cd:hasSymbol ex:rule-c-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-pull-sum-constant a cd:MathematicalRule ; skos:prefLabel "Factor a constant out of a sum"@en ; cd:ruleFormula ex:rule-pull-sum-constant-formula ; cd:requiresAssumption ex:assumption-fixed-summand ; cd:body "A factor that does not depend on the index multiplies the entire sum."@en ; cd:authoredResource true .
  ex:rule-pull-sum-constant-formula a cd:MathExpression ; cd:latex "\\sum_{i=1}^n ca_i=c\\sum_{i=1}^n a_i" ; cd:hasSymbol ex:rule-c-symbol, ex:rule-a-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-subtract-constant-sum a cd:MathematicalRule ; skos:prefLabel "Split a sum and count the constant"@en ; cd:ruleFormula ex:rule-subtract-constant-sum-formula ; dct:hasPart ex:rule-sum-linearity, ex:rule-sum-constant ; cd:requiresAssumption ex:assumption-fixed-summand ; cd:body "First distribute the sum over a difference. The second sum repeats c exactly n times and equals nc."@en ; cd:authoredResource true .
  ex:rule-subtract-constant-sum-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\sum_{i=1}^n(a_i-c)&=\\sum_{i=1}^n a_i-nc\\end{aligned}" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-c-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-mean-definition a cd:MathematicalRule ; skos:prefLabel "Use the arithmetic mean"@en ; cd:ruleFormula ex:rule-mean-definition-formula ; cd:requiresAssumption ex:assumption-finite-sum ; cd:body "Multiplying the definition of the arithmetic mean by the positive count n gives the sum of the observations."@en ; cd:authoredResource true .
  ex:rule-mean-definition-formula a cd:MathExpression ; cd:latex "n\\bar{x}=\\sum_{i=1}^n x_i" ; cd:hasSymbol ex:n-symbol, ex:xbar-symbol, ex:xi-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-residual-zero a cd:MathematicalRule ; skos:prefLabel "Residuals sum to zero"@en ; cd:ruleFormula ex:rule-residual-zero-formula ; cd:requiresAssumption ex:assumption-arithmetic-center ; dct:source ex:vr-cancel-formula ; cd:body "Subtracting the fitted arithmetic mean from every observation creates one exact sum constraint. It is a deterministic identity, not a claim about expectation."@en ; cd:authoredResource true .
  ex:rule-residual-zero-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\sum_{i=1}^n(X_i-\\bar X)\\\\=\\sum_{i=1}^n d_i=0\\end{gathered}" ; cd:hasSymbol ex:vr-X-symbol, ex:vr-Xbar-symbol, ex:vr-d-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-binomial-square a cd:MathematicalRule ; skos:prefLabel "Binomial square"@en ; cd:ruleFormula ex:rule-binomial-square-formula ; cd:body "Multiplying a+b by itself gives a², the two equal cross-products ab, and b². Squaring both sides of an equality is a valid implication, not generally a reversible operation without sign information."@en ; cd:authoredResource true .
  ex:rule-binomial-square-formula a cd:MathExpression ; cd:latex "(a+b)^2=a^2+2ab+b^2" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol ; cd:authoredResource true .
  ex:rule-sum-three-terms a cd:MathematicalRule ; skos:prefLabel "Distribute the sum and factor the cross term"@en ; cd:ruleFormula ex:rule-sum-three-terms-formula ; cd:requiresAssumption ex:assumption-fixed-summand ; dct:hasPart ex:rule-sum-linearity, ex:rule-pull-sum-constant ; cd:body "Use linearity for each of the three summands and move the index-independent coefficient c outside the middle sum. The last sum is not simplified yet."@en ; cd:authoredResource true .
  ex:rule-sum-three-terms-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\sum_{i=1}^n(a_i+cb_i+q)\\\\=\\sum_{i=1}^n a_i+c\\sum_{i=1}^n b_i\\\\+\\sum_{i=1}^n q\\end{gathered}" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol, ex:rule-q-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-expectation-addition a cd:MathematicalRule ; skos:prefLabel "Linearity of expectation"@en ; cd:ruleFormula ex:rule-expectation-addition-formula ; cd:requiresAssumption ex:assumption-integrable ; cd:body "Take expectations of equal integrable random quantities and distribute E over addition. Independence of the two summands is not needed for linearity."@en ; cd:authoredResource true .
  ex:rule-expectation-addition-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[U+V]=\\operatorname{E}[U]+\\operatorname{E}[V]" ; cd:hasSymbol ex:vr-E-symbol, ex:rule-U-symbol, ex:rule-V-symbol ; cd:authoredResource true .
  ex:rule-expectation-factor a cd:MathematicalRule ; skos:prefLabel "Factor a fixed constant out of expectation"@en ; cd:ruleFormula ex:rule-expectation-factor-formula ; cd:requiresAssumption ex:assumption-integrable ; cd:body "A constant fixed across repeated samples multiplies the expectation. A random offset such as Δ must not itself be pulled outside E; the fixed count n may be."@en ; cd:authoredResource true .
  ex:rule-expectation-factor-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[cY]=c\\operatorname{E}[Y]" ; cd:hasSymbol ex:rule-c-symbol, ex:rule-Y-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:rule-variance-definition a cd:MathematicalRule ; skos:prefLabel "Variance is an expected squared deviation"@en ; cd:ruleFormula ex:rule-variance-definition-formula ; cd:body "For a random variable with finite second moment, variance is the expected squared distance from its expectation."@en ; cd:requiresAssumption ex:assumption-second-moment ; cd:authoredResource true .
  ex:rule-variance-definition-formula a cd:MathExpression ; cd:latex "\\operatorname{Var}(Y)=\\operatorname{E}[(Y-\\operatorname{E}[Y])^2]" ; cd:hasSymbol ex:vm-var-symbol, ex:rule-Y-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:rule-population-moments a cd:MathematicalRule ; skos:prefLabel "Insert the established moment results"@en ; cd:ruleFormula ex:rule-population-moments-formula ; cd:requiresAssumption ex:assumption-iid-finite ; cd:body "Each observation has expected squared deviation σ² about μ. A finite sum gives nσ². The previously established sample-mean calculation gives E[nΔ²] = σ²."@en ; dct:source ex:vm-helper-formula ; cd:authoredResource true .
  ex:rule-population-moments-formula a cd:MathExpression ; cd:latex "\\begin{gathered}\\operatorname{E}[{\\textstyle\\sum_{i=1}^n}(X_i-\\mu)^2]=n\\sigma^2\\\\\\operatorname{E}[n\\Delta^2]=\\sigma^2\\end{gathered}" ; cd:hasSymbol ex:vr-E-symbol, ex:vr-X-symbol, ex:mu-symbol, ex:vr-index-symbol, ex:n-symbol, ex:v-sum-symbol, ex:vr-sigma2-symbol, ex:vs-Delta-symbol ; cd:authoredResource true .
  ex:rule-isolate-term a cd:MathematicalRule ; skos:prefLabel "Subtract the same term"@en ; cd:ruleFormula ex:rule-isolate-term-formula ; cd:body "Subtract c from both sides and read the equality in reverse. This is an equivalent algebraic rearrangement."@en ; cd:authoredResource true .
  ex:rule-isolate-term-formula a cd:MathExpression ; cd:latex "a=b+c\\quad\\Longleftrightarrow\\quad b=a-c" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-b-symbol, ex:rule-c-symbol ; cd:authoredResource true .
}
