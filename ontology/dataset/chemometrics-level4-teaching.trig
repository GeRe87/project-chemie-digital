@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

# New teaching prompts and interactive mechanics are authored here. Scientific definitions
# and mathematical expressions remain owned by the accepted Level 4 knowledge graphs.
<https://w3id.org/project-chemie-digital/graph/specifications/chemometrics-level4-teaching> {
  ex:l4-lesson-title a cd:Interpretation ; skos:prefLabel "Quantiles, Moments & Distribution Shape"@en ; cd:body "From location and variance to order-based summaries and distribution shape."@en ; cd:authoredResource true .
  ex:l4-lesson-intro a cd:Interpretation ; skos:prefLabel "Questions first"@en ; cd:body "How can two quantile conventions describe one dataset differently? Which summaries resist one large observation, and what do central moments reveal?"@en ; cd:authoredResource true .
  # Narrative scene heading is not a second scientific definition. It only
  # names the activity and points back to the canonical synthetic WorkedExample.
  ex:l4-qc-scene-heading a cd:Interpretation ;
    skos:prefLabel "Compare two synthetic QC series"@en ;
    cd:body "Explore order-based and moment-based summaries of the same constructed measurements."@en ;
    cd:derivedFromResource ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-lesson-takeaways a cd:Interpretation ; skos:prefLabel "Review the scientific decisions"@en ; cd:body "Use a declared quantile method, justify treatment of extreme observations, and distinguish descriptive moments from estimators."@en ; cd:authoredResource true .
  ex:l4-poll-type-7 a cd:AudiencePoll ; skos:prefLabel "Level 4 type-7 knowledge check"@en ; cd:body "Four observations are 2, 4, 5 and 8 mg/L. What is the first quartile using R's type-7 sample quantile?"@en ;
    cd:hasPollOption ex:l4-poll-type-7-option-a, ex:l4-poll-type-7-option-b, ex:l4-poll-type-7-option-c ;
    cd:correctPollOption ex:l4-poll-type-7-option-b ; cd:hasExpectedResult ex:l4-poll-type-7-expected ; cd:authoredResource true .
  ex:l4-poll-type-7-option-a a cd:PollOption ; skos:prefLabel "2 mg/L — inverse-ECDF type 1"@en ; cd:authoredResource true .
  ex:l4-poll-type-7-option-b a cd:PollOption ; skos:prefLabel "3.5 mg/L — interpolated type 7"@en ; cd:authoredResource true .
  ex:l4-poll-type-7-option-c a cd:PollOption ; skos:prefLabel "4 mg/L — second ordered value"@en ; cd:authoredResource true .
  ex:l4-poll-type-7-expected a cd:ExpectedResult ; cd:body "For n=4 and p=0.25, h=1+3×0.25=1.75, so the type-7 quartile is 0.25×2+0.75×4=3.5 mg/L. R type 1 returns 2 mg/L."@en ; cd:authoredResource true .
  ex:quantile-estimation-method cd:hasAudiencePoll ex:l4-poll-type-7 .
  ex:l4-poll-outlier a cd:AudiencePoll ; skos:prefLabel "Level 4 outlier knowledge check"@en ; cd:body "A synthetic QC series contains 2, 4, 4, 5, 5, 6 and 30 mg/L. The type-7 upper fence is 7.75 mg/L. What conclusion is warranted about 30 mg/L?"@en ;
    cd:hasPollOption ex:l4-poll-outlier-option-a, ex:l4-poll-outlier-option-b, ex:l4-poll-outlier-option-c ;
    cd:correctPollOption ex:l4-poll-outlier-option-b ; cd:hasExpectedResult ex:l4-poll-outlier-expected ; cd:authoredResource true .
  ex:l4-poll-outlier-option-a a cd:PollOption ; skos:prefLabel "Discard it automatically because it exceeds a Tukey fence"@en ; cd:authoredResource true .
  ex:l4-poll-outlier-option-b a cd:PollOption ; skos:prefLabel "Investigate the sample, analytical method and measurement conditions"@en ; cd:authoredResource true .
  ex:l4-poll-outlier-option-c a cd:PollOption ; skos:prefLabel "Conclude it is certainly a valid result without investigation"@en ; cd:authoredResource true .
  ex:l4-poll-outlier-expected a cd:ExpectedResult ; cd:body "A Tukey fence is a descriptive diagnostic flag, not an error classification. Investigate before deciding whether an observation is retained or excluded."@en ; cd:authoredResource true .
  ex:potential-outlier cd:hasAudiencePoll ex:l4-poll-outlier .
  ex:l4-task-quantile a cd:Exercise ; cd:body "In R, compare the first and third sample quartiles using quantile type 1 and type 7 for x = c(2,4,5,8); calculate the type-7 IQR. Explain why the answers differ."@en ;
    cd:hasCodeExample ex:l4-code-quantile ; cd:hasExpectedResult ex:l4-result-quantile ; cd:authoredResource true .
  ex:l4-result-quantile a cd:ExpectedResult ; cd:body "For x = c(2,4,5,8), type 1 returns Q1=2 and Q3=5 mg/L; type 7 returns Q1=3.5 and Q3=5.75 mg/L, IQR=2.25 mg/L. These are alternative sample conventions, not conflicting population definitions."@en ; cd:authoredResource true .
  ex:l4-code-quantile a cd:CodeExample ; cd:code "x <- c(2, 4, 5, 8)\nlist(type_1 = unname(quantile(x, c(.25, .75), type = 1)),\n     type_7 = unname(quantile(x, c(.25, .75), type = 7)),\n     IQR_type_7 = IQR(x, type = 7))" ;
    cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:sample-quantile-type-1, ex:sample-quantile-type-7, ex:interquartile-range ; cd:authoredResource true .
  ex:l4-task-qc a cd:Exercise ; cd:body "Use the two synthetic QC series from the canonical graph. Calculate median, type-7 quartiles, IQR, raw MAD and descriptive m2 (denominator n). Compare which statistics change when the last value becomes 30 mg/L."@en ;
    cd:hasCodeExample ex:l4-code-qc ; cd:hasExpectedResult ex:l4-result-qc ; cd:authoredResource true .
  ex:l4-result-qc a cd:ExpectedResult ; cd:body "Both series have median=5, type-7 Q1=4, Q3=5.5, IQR=1.5 and raw MAD=1 mg/L. Reference m2≈2.20408163 (mg/L)^2; extreme-series m2=82 (mg/L)^2. Robust summaries do not by themselves establish that 30 mg/L is an error."@en ; cd:authoredResource true .
  ex:l4-code-qc a cd:CodeExample ; cd:code "reference <- c(2, 4, 4, 5, 5, 6, 7)\nextreme <- c(2, 4, 4, 5, 5, 6, 30)\nsummarize_qc <- function(x) {\n  c(median = median(x),\n    Q1_type7 = unname(quantile(x, .25, type = 7)),\n    Q3_type7 = unname(quantile(x, .75, type = 7)),\n    IQR_type7 = IQR(x, type = 7),\n    MAD_raw = mad(x, constant = 1),\n    m2 = mean((x - mean(x))^2))\n}\nrbind(reference = summarize_qc(reference),\n      extreme = summarize_qc(extreme))" ;
    cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:l4-qc-reference, ex:l4-qc-extreme, ex:median-absolute-deviation, ex:empirical-second-central-moment ; cd:authoredResource true .
  ex:l4-task-shape a cd:Exercise ; cd:body "Calculate unadjusted descriptive skewness g1=m3/m2^(3/2) and excess kurtosis g2=m4/m2^2-3 for the two QC series. Check what happens when all observations are identical, and keep undefined coefficients as NA."@en ;
    cd:hasCodeExample ex:l4-code-shape ; cd:hasExpectedResult ex:l4-result-shape ; cd:authoredResource true .
  ex:l4-result-shape a cd:ExpectedResult ; cd:body "The formulas use descriptive central moments with denominator n. At m2=0, neither standardized skewness nor excess kurtosis is defined: return NA, not zero. The script uses only base R and does not claim adjusted or unbiased estimators."@en ; cd:authoredResource true .
  ex:l4-code-shape a cd:CodeExample ; cd:code "reference <- c(2, 4, 4, 5, 5, 6, 7)\nextreme <- c(2, 4, 4, 5, 5, 6, 30)\nshape <- function(x) {\n  z <- x - mean(x)\n  m2 <- mean(z^2)\n  if (m2 == 0) return(c(m2 = 0, g1 = NA_real_, g2 = NA_real_))\n  c(m2 = m2, g1 = mean(z^3) / m2^(3 / 2),\n    g2 = mean(z^4) / m2^2 - 3)\n}\nrbind(reference = shape(reference),\n      extreme = shape(extreme),\n      constant = shape(rep(5, 7)))" ;
    cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:sample-skewness, ex:sample-excess-kurtosis, ex:empirical-central-moment ; cd:authoredResource true .
}
