  ex:ic-simulation-code a cd:CodeExample ; skos:prefLabel "Deterministic repeated IC series at the null boundary"@en ; cd:programmingLanguage "r" ; cd:editable false ; cd:executable false ; cd:showsResource ex:al-chi-square ; cd:code """# Teaching simulation: fixed true SD, not real validation data.
M <- 10000; n <- 6; sigma0 <- 0.10; state <- 20261101
Q <- numeric(M)
for (j in seq_len(M)) {
  x <- numeric(n)
  for (i in seq_len(n)) {
    state <- (16807 * state) %% 2147483647
    x[i] <- 10 + sigma0 * qnorm(state / 2147483647)
  }
  Q[j] <- sum(((x - mean(x)) / sigma0)^2)
}
stopifnot(all(Q >= 0 & Q < 32))
counts <- tabulate(floor(Q) + 1L, nbins = 32)
print(counts)
print(c(mean_Q = mean(Q), flags = sum(Q > qchisq(.95, df = 5))))
""" ; cd:authoredResource true .
