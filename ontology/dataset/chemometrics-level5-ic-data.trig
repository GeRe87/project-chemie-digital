  ex:ic-tail-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-ic-chi5-tail.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; dct:references ex:ic-case, ex:ic-chi5-density ; cd:alternativeText "Chi-square reference with five degrees of freedom at true SD equal to 0.10 mg/L. Dashed line: upper 5% critical value 11.0704977. Solid orange line: observed statistic 12. Orange area to its right is the upper tail, about 3.47878%; the theoretical tail continues beyond the drawing at 32. Observed 12 exceeds the cutoff, so reject the no-deterioration null at 5% under the stated assumptions."@en ; cd:authoredResource true .
