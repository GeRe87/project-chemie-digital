<https://w3id.org/project-chemie-digital/graph/paths/chemometrics-variance-dispersion-lecture> {
  ex:path-chemometrics-variance-dispersion-lecture a cd:LearningPath ;
    skos:prefLabel "Chemometrics Variance and Dispersion lecture path"@en ;
    cd:forTopic ex:variance,
      ex:standard-deviation,
      ex:standard-error,
      ex:relative-standard-deviation ;
    cd:forLearningUnit ex:learning-unit-variance-dispersion ;
    # Compact primary argument. Full algebra and sample-mean proofs are explicit
    # optional derivation details, never extra slides or hidden slide stages.
    cd:hasStep ex:path-step-chemometrics-variance-dispersion-title,
      ex:vr-step02, ex:vr-step03, ex:vr-step04, ex:vr-step05,
      ex:cv-path06, ex:cv-path07, ex:cv-path08, ex:cv-path09, ex:cv-path10,
      ex:cv-path11, ex:cv-path12, ex:cv-path13, ex:cv-path14, ex:cv-path15,
