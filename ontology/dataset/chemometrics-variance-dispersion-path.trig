      ex:cv-path31, ex:cv-path32, ex:cv-path33, ex:cv-path34, ex:cv-path35,
      ex:cv-path36, ex:cv-path37, ex:cv-path38, ex:cv-path39, ex:cv-path40,
      ex:cv-path41, ex:cv-path42, ex:cv-path43, ex:cv-path44,
      ex:se-path-return, ex:se-path-sem, ex:se-path-rate, ex:se-path-example, ex:cv-path46 ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variance-dispersion-title a cd:PathStep ;
    cd:position 1 ;
    cd:usesResource ex:variance-lecture-title ;
    cd:usesScene ex:scene-chemometrics-variance-dispersion-title ;
    cd:authoredResource true .

  ex:path-step-chemometrics-variance-dispersion-variance a cd:PathStep ;
    cd:position 2 ;
    cd:usesResource ex:mean-and-spread-comparison, ex:chart-variance-same-mean, ex:variance-same-mean-definition ;
    cd:usesScene ex:scene-chemometrics-variance-dispersion-variance ;
    cd:authoredResource true .

  ex:path-step-variance-analytical-quality a cd:PathStep ;
