@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-extension-system> {
  ex:cogniflow-extension-system a cd:Concept ;
    skos:prefLabel "CogniFlow: One Rulebook, Extensible by Design"@en ;
    cd:hasDefinition ex:def-cogniflow-extension-system ;
    cd:authoredResource true .

  ex:def-cogniflow-extension-system a cd:Definition ;
    cd:body "CogniFlow defines the rules for how functionality is described and exposed. Conforming modules combine implementation logic with machine-readable semantics and publish their capabilities through the common service boundary."@en ;
    cd:hasKeyPoint
      ex:keypoint-cogniflow-extension-rulebook,
      ex:keypoint-cogniflow-extension-bootstrap,
      ex:keypoint-cogniflow-extension-webui,
      ex:keypoint-cogniflow-extension-pipeline,
      ex:keypoint-cogniflow-extension-service,
      ex:keypoint-cogniflow-extension-report ;
    cd:authoredResource true .

  ex:cogniflow-extension-system-banner a cd:Interpretation ;
    cd:body """COGNIFLOW = RULES + CONFORMING EXTENSIONS
the core defines how functionality is described — modules supply what it does"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-rulebook a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """RULEBOOK · HUMAN + MACHINE READABLE
RDF/TriG semantics · SHACL conformance · package model · service contracts"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-bootstrap a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """Bootstrap Installer
runtime setup
dependency installation
profile bootstrap
→ install + initialize"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-webui a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """Web UI
REWORK IN PROGRESS
browser-based interface
workflow control
status + results views
→ user interaction"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-pipeline a cd:KeyPoint ;
    cd:position 4 ;
    cd:body """Pipeline Engine
REWORK IN PROGRESS
workflow orchestration
processing execution
step coordination
→ pipeline runtime"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-service a cd:KeyPoint ;
    cd:position 5 ;
    cd:body """Service Module
service boundary
tool exposure
standardized calls/results
→ service access"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-extension-report a cd:KeyPoint ;
    cd:position 6 ;
    cd:body """Report Generator
report creation
FAIR summaries
exported artifacts
→ reporting"""@en ;
    cd:authoredResource true .

  ex:cogniflow-extension-service-boundary a cd:Interpretation ;
    cd:body """ONE SERVICE BOUNDARY
cf_call_service → semantic resolution → standardized result
EXTEND BY ADDING A CONFORMING MODULE — NOT BY CHANGING THE CORE"""@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-extension-system> {
  ex:path-cogniflow-standardized-data-processing
    cd:hasStep ex:path-step-cogniflow-extension-system .

  ex:path-step-cogniflow-extension-system a cd:PathStep ;
    cd:position 13 ;
    cd:usesResource
      ex:cogniflow-extension-system-banner,
      ex:def-cogniflow-extension-system,
      ex:cogniflow-extension-service-boundary ;
    cd:usesScene ex:scene-cogniflow-extension-system ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-extension-system> {
  ex:scene-cogniflow-extension-system a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-extension-system ;
    cd:hasSceneItem
      ex:scene-item-cogniflow-extension-system-heading,
      ex:scene-item-cogniflow-extension-system-banner,
      ex:scene-item-cogniflow-extension-system-modules,
      ex:scene-item-cogniflow-extension-system-boundary ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-extension-system-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-extension-system ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-extension-system-banner a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-extension-system-banner ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-extension-system-modules a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:def-cogniflow-extension-system ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-extension-system-boundary a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-extension-service-boundary ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
