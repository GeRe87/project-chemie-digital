  ex:l5-s15-v2 a cd:Observation ; cd:position 2 ; cd:numericValue 9.8 ; cd:authoredResource true .
  ex:l5-s15-v3 a cd:Observation ; cd:position 3 ; cd:numericValue 10.0 ; cd:authoredResource true .
  ex:l5-s15-v4 a cd:Observation ; cd:position 4 ; cd:numericValue 10.2 ; cd:authoredResource true .
  ex:l5-s15-v5 a cd:Observation ; cd:position 5 ; cd:numericValue 10.4 ; cd:authoredResource true .
  ex:l5-s15-mean a cd:StatisticalResult ; cd:usesDataset ex:l5-s15-readings ; cd:quantifiesProperty ex:arithmetic-mean ; cd:unit "mg/L" ; cd:numericValue 10.0 ; cd:derivedFromResource ex:l5-s15-v1, ex:l5-s15-v2, ex:l5-s15-v3, ex:l5-s15-v4, ex:l5-s15-v5 ; cd:authoredResource true .
  ex:l5-s15b-context a cd:Interpretation ; cd:body "Separate analytical model, SD 0.316 mg/L: simulated laboratory series, not environmental surveys or resampling the five values."@en ; cd:authoredResource true .
  ex:l5-s15b-chart a cd:ChartDefinition ; skos:prefLabel "5,000 laboratory means versus individual analytical results"@en ; cd:body "Laboratory model: mean 10, SD 0.316 mg/L. Not environmental variability."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:l5-s15-mean-counts ; dct:hasPart ex:l5-s15-individual-density ; cd:binEdges ex:l5-s15-edge0 ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:authoredResource true .
  ex:l5-s15c-chart a cd:ChartDefinition ; skos:prefLabel "Estimated analytical SD and laboratory-mean SE"@en ; cd:body "Analytical SD 0.316; laboratory SE 0.141 mg/L. Not environmental SE."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-s15-spreads ; cd:xAxisLabel "What varies"@en ; cd:yAxisLabel "Estimated spread"@en ; cd:yAxisUnit "mg/L" ; cd:authoredResource true .
  ex:l5-s15-spreads a cd:Dataset ; skos:prefLabel "Observed sample SD and estimated standard error"@en ; cd:derivedFromResource ex:l5-s15-readings, ex:l5-s15a-formula, ex:l5-s15c-formula ; cd:hasObservation ex:l5-s15-sd, ex:l5-s15-se ; cd:authoredResource true .
  ex:l5-s15-sd a cd:Observation ; cd:position 1 ; skos:prefLabel "Lab values: SD"@en ; cd:numericValue 0.31622776601683794 ; cd:authoredResource true .
  ex:l5-s15-se a cd:Observation ; cd:position 2 ; skos:prefLabel "Mean: est. SE"@en ; cd:numericValue 0.1414213562373095 ; cd:authoredResource true .
  ex:l5-s15d-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-s15d-center, ex:l5-s15d-repeats, ex:l5-s15d-dependence, ex:l5-s15d-uncertainty ; cd:authoredResource true .
  ex:l5-s15d-center a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Reference 10.0; center 10.2"@en ; cd:body "A hypothetical analytical bias of +0.2 mg/L shifts the expected result and mean to 10.2 mg/L."@en ; cd:authoredResource true .
  ex:l5-s15d-repeats a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "5 repeats or 80: still 10.2"@en ; cd:body "More independent repeats reduce random spread of means. Their expected center stays biased, not corrected to 10.0 mg/L."@en ; cd:authoredResource true .
  ex:l5-s15d-dependence a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Check selection and independence"@en ; cd:body "An unrepresentative location stays unrepresentative after more lab repeats. Correlation can also invalidate the simple SE rule."@en ; cd:authoredResource true .
  ex:l5-s15d-uncertainty a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "SE is not all uncertainty"@en ; cd:body "Calibration, reference values and sample preparation can add uncertainty. A small SE alone does not demonstrate accuracy."@en ; cd:authoredResource true .
  ex:l5-s15-protocol a cd:WorkedExample ; cd:bodyFormat "markdown" ; cd:body """S15 uses a separate illustrative iid normal population, mean 10 mg/L and population SD the square root of 0.10 (mg/L) squared. These constants are chosen to match the scale of the constructed readings; they are not known true population parameters inferred from five observations and normality is not established by those observations. This model replaces the preceding C13/C14 lognormal population, whose individual SD was 9 mg/L.

Mulberry32 seed 20261031, uncached cosine Box-Muller, two uniforms per draw. Draw 5,000 fresh five-value samples, 25,000 individuals, without resampling, rejection or forcing sample moments. Fixed width-0.1 bins cover 8.8 to 11.2 mg/L. All means are retained; no density renormalization. The theoretical individual density is a separate reference, not part of the observation counts. Its normal support extends outside this display window. Normality makes the mean exactly normal at size five in this illustration, not by a size-five CLT guarantee.

```javascript
function standardErrorSimulation() {
  let state=20261031;
  function uniform(){state=(state+0x6d2b79f5)>>>0;let t=state;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return((t^(t>>>14))>>>0)/4294967296;}
  const means=[],counts=Array(24).fill(0);
  for(let r=0;r<5000;r++){
    let sum=0;
    for(let i=0;i<5;i++)sum+=10+Math.sqrt(.1)*Math.sqrt(-2*Math.log(1-uniform()))*Math.cos(2*Math.PI*uniform());
    const mean=sum/5;means.push(mean);
    if(mean<8.8||mean>11.2)throw new Error("Mean outside fixed bins");
    counts[Math.min(23,Math.floor((mean-8.8)/.1))]++;
  }
  return {means,counts};
}
```

This authored provenance is not executable lecture UI. Pseudorandom draws approximate an independent sampling model and do not prove physical independence. The constant-bias example on S15d is a separate hypothetical scenario, not a diagnosis of the five readings. With correlated observations, the variance of a mean is the sum of all pairwise covariances divided by sample size squared; off-diagonal covariance terms need not vanish. General measurement uncertainty may contain contributions beyond repeatability."""@en ; cd:authoredResource true .
}

