@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-f-distribution> {
  ex:l5-f-distribution a cd:Concept ; skos:prefLabel "F reference for ratios of independent normal-sample variances"@en ; cd:hasDefinition ex:l5-f17-definition ; cd:authoredResource true .
  ex:l5-f17-definition a cd:Definition ; cd:body "An F variable is the ratio of two independent chi-square variables, each divided by its own degrees of freedom. For two independent samples, each iid normal, the sample-variance ratio has an F reference under equal population variances, with numerator sample size minus one and denominator sample size minus one degrees of freedom, in that order. An observed ratio alone does not establish different population precisions. The classical variance comparison is sensitive to nonnormality."@en ; cd:authoredResource true .
  ex:l5-f17a-formula a cd:MathExpression ; cd:formulaLabel "A descriptive variance ratio, not a test decision"@en ; cd:body "Square each observed sample SD before dividing: 0.40 squared divided by 0.20 squared is four. The sample SD ratio is two, but the sample variance ratio is four."@en ; cd:latex "\\frac{s_B^2}{s_A^2}=\\frac{0.40^2}{0.20^2}=4" ; dct:hasPart ex:l5-f17a-legend ; cd:hasSymbol ex:l5-f17a-methods, ex:l5-f17a-sd, ex:l5-f17a-variance, ex:l5-f17a-operators ; cd:authoredResource true .
  ex:l5-f17a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-f17a-entry ; cd:authoredResource true .
  ex:l5-f17a-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and ratio direction"@en ; dct:references ex:l5-f17a-methods, ex:l5-f17a-sd, ex:l5-f17a-variance, ex:l5-f17a-operators ; cd:authoredResource true .
  ex:l5-f17a-methods a cd:MathSymbol ; cd:symbol "method indices" ; cd:mathNotation "A,\\ B" ; cd:body "Labels for two analytical methods. The ratio is B over A, fixed in this order, not automatically the larger variance over the smaller."@en ; cd:authoredResource true .
  ex:l5-f17a-sd a cd:MathSymbol ; cd:symbol "observed sample SDs" ; cd:mathNotation "s_A,\\ s_B" ; cd:body "Observed sample SDs: A is 0.20 and B is 0.40 mg/L. Lowercase s denotes a sample result, not known population SD."@en ; cd:authoredResource true .
  ex:l5-f17a-variance a cd:MathSymbol ; cd:symbol "sample variances" ; cd:mathNotation "s_A^2,\\ s_B^2" ; cd:body "Squared SDs give sample variances 0.04 and 0.16 (mg/L) squared. Their ratio has no units; the SD ratio would be 2."@en ; cd:authoredResource true .
  ex:l5-f17a-operators a cd:MathSymbol ; cd:symbol "squaring and division" ; cd:mathNotation "{}^2,\\ /,\\ =" ; cd:body "Square, divide numerator by denominator and use exact equality. Ratio 4 is descriptive; without sample sizes and assumptions it is not a significance claim."@en ; cd:authoredResource true .
  ex:l5-f17b-formula a cd:MathExpression ; cd:formulaLabel "Reference under equal population variances"@en ; cd:body "With independent iid normal samples and equal population variances, sample variance B over sample variance A has an F law with numerator sample size B minus one and denominator sample size A minus one degrees of freedom."@en ; cd:latex "\\frac{S_B^2}{S_A^2}\\sim F_{n_B-1,\\,n_A-1}" ; dct:hasPart ex:l5-f17b-legend ; cd:hasSymbol ex:l5-f17b-variances, ex:l5-f17b-sizes, ex:l5-f17b-law, ex:l5-f17b-null ; cd:authoredResource true .
  ex:l5-f17b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-f17b-entry ; cd:authoredResource true .
  ex:l5-f17b-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and model assumptions"@en ; dct:references ex:l5-f17b-variances, ex:l5-f17b-sizes, ex:l5-f17b-law, ex:l5-f17b-null ; cd:authoredResource true .
  ex:l5-f17b-variances a cd:MathSymbol ; cd:symbol "random sample variances" ; cd:mathNotation "S_B^2,\\ S_A^2" ; cd:body "Random sample variances for B and A, each using its sample mean and divisor size minus 1. Squared concentration units cancel in B divided by A."@en ; cd:authoredResource true .
  ex:l5-f17b-sizes a cd:MathSymbol ; cd:symbol "sample sizes and degrees of freedom" ; cd:mathNotation "n_B-1,\\ n_A-1" ; cd:body "Each size is at least 2. First subscript: numerator degrees of freedom; second: denominator. Actual sample sizes for the SD example are not supplied."@en ; cd:authoredResource true .
  ex:l5-f17b-law a cd:MathSymbol ; cd:symbol "F distribution" ; cd:mathNotation "\\sim,\\ F" ; cd:body "Tilde means distributed as F, not equality to a density. The dimensionless plot illustrates numerator 10 and denominator 5 degrees of freedom only."@en ; cd:authoredResource true .
  ex:l5-f17b-null a cd:MathSymbol ; cd:symbol "equal-variance condition" ; cd:mathNotation "S_B^2/S_A^2" ; cd:body "Exact F reference requires equal population variances and two independent samples, each iid normal. It does not require equal population means."@en ; cd:authoredResource true .
  ex:l5-f17c-formula a cd:MathExpression ; cd:formulaLabel "Normalize each chi-square before taking the ratio"@en ; cd:body "Divide each of two independent chi-square variables by its own degrees of freedom. Their quotient is F with numerator and denominator degrees of freedom in the same order."@en ; cd:latex "F=\\frac{U_1/\\nu_1}{U_2/\\nu_2}" ; dct:hasPart ex:l5-f17c-legend ; cd:hasSymbol ex:l5-f17c-variables, ex:l5-f17c-df, ex:l5-f17c-ratio, ex:l5-f17c-indices ; cd:authoredResource true .
  ex:l5-f17c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-f17c-entry ; cd:authoredResource true .
  ex:l5-f17c-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, independence and normalization"@en ; dct:references ex:l5-f17c-variables, ex:l5-f17c-df, ex:l5-f17c-ratio, ex:l5-f17c-indices ; cd:authoredResource true .
  ex:l5-f17c-variables a cd:MathSymbol ; cd:symbol "independent chi-squares" ; cd:mathNotation "U_1,\\ U_2" ; cd:body "Independent chi-square random variables with degrees of freedom nu 1 and nu 2. Both are dimensionless; independence is essential."@en ; cd:authoredResource true .
  ex:l5-f17c-df a cd:MathSymbol ; cd:symbol "degrees of freedom" ; cd:mathNotation "\\nu_1,\\ \\nu_2" ; cd:body "Positive degrees of freedom for numerator and denominator. Illustrative values here are 10 and 5, not inferred sample sizes for methods A and B."@en ; cd:authoredResource true .
  ex:l5-f17c-ratio a cd:MathSymbol ; cd:symbol "ratio and arithmetic" ; cd:mathNotation "F,\\ /,\\ =" ; cd:body "Divide each chi-square by its own degrees of freedom, then divide the two results. Equality defines dimensionless F, not a formal test decision."@en ; cd:authoredResource true .
  ex:l5-f17c-indices a cd:MathSymbol ; cd:symbol "ordered components" ; cd:mathNotation "1,\\ 2" ; cd:body "Subscript 1 labels numerator, 2 denominator. Reversing the ratio swaps the degrees of freedom and changes its reference law."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-f-distribution> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:l5-f-distribution .
  ex:l5-f17a-title a cd:Interpretation ; skos:prefLabel "Compare estimated analytical precisions"@en ; cd:authoredResource true .
  ex:l5-f17b-title a cd:Interpretation ; skos:prefLabel "Reference for the method-variance ratio"@en ; cd:authoredResource true .
  ex:l5-f17c-title a cd:Interpretation ; skos:prefLabel "Two estimated variances, two parameters"@en ; cd:authoredResource true .
  ex:l5-f17a-chart a cd:ChartDefinition ; skos:prefLabel "Constructed sample SDs for two analytical methods"@en ; cd:body "A: 0.20; B: 0.40 mg/L. SD ratio 2, variance ratio 4. Sample sizes are not supplied; no test decision."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-f17-sds ; cd:xAxisLabel "Method"@en ; cd:yAxisLabel "Sample SD"@en ; cd:yAxisUnit "mg/L" ; cd:authoredResource true .
  ex:l5-f17-sds a cd:Dataset ; skos:prefLabel "Two idealized analytical-method sample SDs"@en ; cd:hasObservation ex:l5-f17-sda, ex:l5-f17-sdb ; cd:authoredResource true .
  ex:l5-f17-sda a cd:Observation ; cd:position 1 ; skos:prefLabel "A"@en ; cd:numericValue 0.20 ; cd:authoredResource true .
  ex:l5-f17-sdb a cd:Observation ; cd:position 2 ; skos:prefLabel "B"@en ; cd:numericValue 0.40 ; cd:authoredResource true .
  ex:l5-f17b-chart a cd:ChartDefinition ; skos:prefLabel "Illustrative F density, numerator 10 and denominator 5 degrees of freedom"@en ; cd:body "Illustrative degrees of freedom: 10, 5, not inferred from the SDs. Tail continues beyond 8. Sensitive to nonnormality."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.70 ; cd:usesDataset ex:l5-f17-density ; cd:xAxisLabel "Variance ratio"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-f17c-chart a cd:ChartDefinition ; skos:prefLabel "Constructed normalized chi-square values: numerator over denominator"@en ; cd:body "Arithmetic illustration only: 16/10 = 1.6, 2/5 = 0.4; ratio 4. Not simulated draws or method A/B data."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-f17-components ; cd:xAxisLabel "Normalized component"@en ; cd:yAxisLabel "Value"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-f17-components a cd:Dataset ; skos:prefLabel "Constructed normalized numerator and denominator, not sampled observations"@en ; cd:derivedFromResource ex:l5-f17c-formula ; cd:hasObservation ex:l5-f17-numerator, ex:l5-f17-denominator ; cd:authoredResource true .
  ex:l5-f17-numerator a cd:Observation ; cd:position 1 ; skos:prefLabel "Numerator"@en ; cd:numericValue 1.6 ; cd:authoredResource true .
  ex:l5-f17-denominator a cd:Observation ; cd:position 2 ; skos:prefLabel "Denominator"@en ; cd:numericValue 0.4 ; cd:authoredResource true .
  ex:l5-f17-protocol a cd:WorkedExample ; cd:body "The method SDs are constructed 0.20 and 0.40 mg/L. They supply a descriptive variance ratio of 4 but no sample sizes, sampling design or evidence of normality. Do not attach a p value, critical value or formal decision to them. The separate theoretical F density chooses numerator degrees of freedom 10 and denominator 5 only to illustrate the law. If this were a normal-sample variance-ratio application, these would correspond to sample sizes 11 in the numerator and 6 in the denominator, but those sizes are not asserted for A and B. The density at nonnegative dimensionless x is (a/b)^(a/2) times x^(a/2-1) divided by Beta(a/2,b/2), times (1+a*x/b)^(-(a+b)/2), with a=10 and b=5. Beta(p,q) is Gamma(p)*Gamma(q)/Gamma(p+q). Coordinates are theoretical, rounded to twelve decimals, and connected linearly for drawing. Support extends to infinity and the 0 to 8 display is not renormalized. A separate deterministic arithmetic illustration chooses U1=16, nu1=10, U2=2, nu2=5, giving normalized components 1.6 and 0.4 and ratio 4. These are not simulated draws, independent evidence, or measurements from either method. The construction assumes independent chi-square variables at the distributional level; one chosen quotient does not demonstrate that distribution."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:forTopic ex:l5-f-distribution ; cd:hasStep ex:l5-f17a-step, ex:l5-f17b-step, ex:l5-f17c-step .
  ex:l5-f17a-step a cd:PathStep ; cd:position 56 ; cd:usesScene ex:l5-f17a-scene ; cd:usesResource ex:l5-f17a-title, ex:l5-f17a-chart, ex:l5-f17a-formula ; cd:authoredResource true .
  ex:l5-f17b-step a cd:PathStep ; cd:position 57 ; cd:usesScene ex:l5-f17b-scene ; cd:usesResource ex:l5-f17b-title, ex:l5-f17b-chart, ex:l5-f17b-formula ; cd:authoredResource true .
  ex:l5-f17c-step a cd:PathStep ; cd:position 58 ; cd:usesScene ex:l5-f17c-scene ; cd:usesResource ex:l5-f17c-title, ex:l5-f17c-chart, ex:l5-f17c-formula ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-f-distribution> {
  ex:l5-f17a-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; cd:hasSceneItem ex:l5-f17a-heading, ex:l5-f17a-plot, ex:l5-f17a-math ; cd:narration "F17a. Compare two idealized analytical methods. Their observed sample SDs are 0.20 mg/L for A and 0.40 mg/L for B. B has twice the sample SD, but squaring gives variances 0.04 and 0.16 in squared concentration units. The variance ratio B over A is four, with units cancelling. This is a descriptive sample comparison, not proof that the population variances differ or that one method is more accurate. Sample variances themselves fluctuate. The blueprint supplies no sample sizes or raw samples for this example, so we do not invent them or report a p value. The ratio direction is fixed as B over A, not chosen after seeing which variance is larger. Precision concerns repeat spread under defined conditions; a smaller observed SD alone does not establish absence of systematic bias, general superiority or significance."@en ; cd:authoredResource true .
  ex:l5-f17b-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; cd:hasSceneItem ex:l5-f17b-heading, ex:l5-f17b-plot, ex:l5-f17b-math ; cd:narration "F17b. Under equal population variances, two independent samples, each made of iid normal observations, give an exact F reference for the sample variance ratio. Population means need not be equal. The first degrees-of-freedom parameter belongs to numerator B, size B minus one. The second belongs to denominator A, size A minus one. The plot separately illustrates numerator ten and denominator five degrees of freedom, which would correspond to sample sizes eleven and six if used in that model. These are chosen illustration parameters, not missing facts inferred from the method SDs. The right-skewed theoretical density has support beyond eight and is not renormalized to the displayed window. No observed-ratio marker, tail probability, critical region or test decision is inferred for A and B. The exact reference is sensitive to nonnormality; it is not a universal robust variance-comparison method. Paired or otherwise dependent samples do not satisfy the two-independent-samples assumption. A formal test and its decision rule belong to the next session."@en ; cd:authoredResource true .
  ex:l5-f17c-scene a cd:SceneDefinition ; cd:focusConcept ex:l5-f-distribution ; cd:hasSceneItem ex:l5-f17c-heading, ex:l5-f17c-plot, ex:l5-f17c-math ; cd:narration "F17c. The F construction connects directly to chi-square: take two independent chi-square variables, divide each by its own degrees of freedom, then divide numerator by denominator. This explains why the reference has two ordered parameters. The chart is a deliberately constructed arithmetic illustration, not simulated random draws or data from the two methods: choose first chi-square value sixteen with ten degrees of freedom and second value two with five degrees of freedom. Their normalized values are 1.6 and 0.4; their quotient is four. A single chosen quotient does not establish an F distribution or its tail probability. At the distributional level, independence of the two chi-square variables is essential. For independent normal samples, each sample variance divided by its own population variance gives the required scaled chi-square component; equal population variances then cancel in the raw variance ratio. If population variances differ, the raw ratio is instead a population-variance scale factor times an F variable, not this unscaled equal-variance reference. Reversing the quotient swaps the degrees of freedom. The classical comparison is sensitive to nonnormality and does not by itself assess accuracy. This completes the distributional connection, not a hypothesis-test decision."@en ; cd:authoredResource true .
  ex:l5-f17a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-f17a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17a-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-f17a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17a-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-f17a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-f17b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17b-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-f17b-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17b-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-f17b-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17c-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-f17c-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17c-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-f17c-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-f17c-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-f17c-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
}
