@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/project-chemie-digital/graph/specifications/cogniflow-semantics-first> {
  ex:cogniflow-semantics-first a cd:Concept ;
    skos:prefLabel "Semantics First — Meaning Before Implementation"@en ;
    cd:hasDefinition ex:def-cogniflow-semantics-first ;
    cd:authoredResource true .

  ex:def-cogniflow-semantics-first a cd:Definition ;
    cd:body "CogniFlow describes what a processing capability means and why it exists before choosing how that capability is implemented."@en ;
    cd:authoredResource true .

  ex:cogniflow-semantics-first-principle a cd:Interpretation ;
    cd:body "DESCRIBE WHAT + WHY BEFORE HOW."@en ;
    cd:authoredResource true .

  ex:cogniflow-semantics-first-cards a cd:Interpretation ;
    cd:body "A baseline-correction example separates scientific intent and semantic contract from the replaceable implementation."@en ;
    cd:hasKeyPoint ex:keypoint-cogniflow-semantics-first-intent,
      ex:keypoint-cogniflow-semantics-first-contract,
      ex:keypoint-cogniflow-semantics-first-implementation ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantics-first-intent a cd:KeyPoint ;
    cd:position 1 ;
    cd:body """WHAT + WHY
BASELINE CORRECTION
WHY · remove slowly varying background
WHAT · chromatogram → corrected chromatogram"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantics-first-contract a cd:KeyPoint ;
    cd:position 2 ;
    cd:body """SEMANTIC CONTRACT
meaning · inputs · outputs
parameters · constraints
provenance requirements"""@en ;
    cd:authoredResource true .

  ex:keypoint-cogniflow-semantics-first-implementation a cd:KeyPoint ;
    cd:position 3 ;
    cd:body """HOW
IMPLEMENTATIONS
Python package
Rust service
another compatible provider"""@en ;
    cd:authoredResource true .

  ex:cogniflow-semantics-first-note a cd:Interpretation ;
    cd:body "ONE MEANING → MULTIPLE IMPLEMENTATIONS"@en ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/cogniflow-semantics-first-extension> {
  ex:path-step-cogniflow-semantics-first a cd:PathStep ;
    cd:position 6 ;
    cd:usesResource ex:cogniflow-semantics-first-principle,
      ex:cogniflow-semantics-first-cards,
      ex:cogniflow-semantics-first-note ;
    cd:usesScene ex:scene-cogniflow-semantics-first ;
    cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/scenes/cogniflow-semantics-first> {
  ex:scene-cogniflow-semantics-first a cd:SceneDefinition ;
    cd:focusConcept ex:cogniflow-semantics-first ;
    cd:hasSceneItem ex:scene-item-cogniflow-semantics-first-heading,
      ex:scene-item-cogniflow-semantics-first-principle,
      ex:scene-item-cogniflow-semantics-first-cards,
      ex:scene-item-cogniflow-semantics-first-note ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-first-heading a cd:SceneItem ;
    cd:position 1 ;
    cd:selectsResource ex:cogniflow-semantics-first ;
    cd:communicativeRole cd:HeadingRole ;
    cd:selectionPath "skos:prefLabel@en" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-first-principle a cd:SceneItem ;
    cd:position 2 ;
    cd:selectsResource ex:cogniflow-semantics-first-principle ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-first-cards a cd:SceneItem ;
    cd:position 3 ;
    cd:selectsResource ex:cogniflow-semantics-first-cards ;
    cd:communicativeRole cd:KeyPointRole ;
    cd:selectionPath "cd:hasKeyPoint" ;
    cd:language "en" ;
    cd:authoredResource true .

  ex:scene-item-cogniflow-semantics-first-note a cd:SceneItem ;
    cd:position 4 ;
    cd:selectsResource ex:cogniflow-semantics-first-note ;
    cd:communicativeRole cd:StatementRole ;
    cd:selectionPath "cd:body" ;
    cd:language "en" ;
    cd:authoredResource true .
}
