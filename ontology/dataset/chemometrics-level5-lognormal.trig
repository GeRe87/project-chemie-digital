  ex:l5-lognormal-log-density a cd:Dataset ; skos:prefLabel "Specified normal density of the dimensionless log ratio"@en ; cd:body "Theoretical normal coordinates with mean ln(2) and SD 0.75, not a fit to the constructed observations. Display covers four log-scale SDs either side; tails continue beyond it. This density has a different scale and units from the concentration density."@en ; cd:unit "1" ; cd:derivedFromResource ex:l5-l12b-formula ; cd:hasObservation ex:l5-ltd-0, ex:l5-ltd-1, ex:l5-ltd-2, ex:l5-ltd-3, ex:l5-ltd-4, ex:l5-ltd-5, ex:l5-ltd-6, ex:l5-ltd-7, ex:l5-ltd-8, ex:l5-ltd-9, ex:l5-ltd-10, ex:l5-ltd-11, ex:l5-ltd-12, ex:l5-ltd-13, ex:l5-ltd-14, ex:l5-ltd-15, ex:l5-ltd-16, ex:l5-ltd-17, ex:l5-ltd-18, ex:l5-ltd-19, ex:l5-ltd-20, ex:l5-ltd-21, ex:l5-ltd-22, ex:l5-ltd-23, ex:l5-ltd-24 ; cd:authoredResource true .
