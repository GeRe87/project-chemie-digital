  ex:l5-lognormal-log-values a cd:Dataset ; skos:prefLabel "Natural logs of the same 20 concentration/reference ratios"@en ; cd:body "Each transformed value has an explicit derivation link to its original concentration. The reference is 1 mg/L, so log ratios are dimensionless. The observations are transformed, not redrawn; ties and order remain. This is a histogram of transformed values, not merely relabelled ticks on the original density."@en ; cd:unit "1" ; cd:derivedFromResource ex:l5-lognormal-values, ex:l5-l12b-formula ; cd:hasObservation ex:l5-llog-1, ex:l5-llog-2, ex:l5-llog-3, ex:l5-llog-4, ex:l5-llog-5, ex:l5-llog-6, ex:l5-llog-7, ex:l5-llog-8, ex:l5-llog-9, ex:l5-llog-10, ex:l5-llog-11, ex:l5-llog-12, ex:l5-llog-13, ex:l5-llog-14, ex:l5-llog-15, ex:l5-llog-16, ex:l5-llog-17, ex:l5-llog-18, ex:l5-llog-19, ex:l5-llog-20 ; cd:authoredResource true .
