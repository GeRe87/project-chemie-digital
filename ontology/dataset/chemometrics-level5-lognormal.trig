<https://w3id.org/project-chemie-digital/graph/sources/level5-lognormal> {
  ex:l5-source-r-lognormal a cd:Source ; dct:title "R stats: The Log-Normal Distribution" ; dct:creator "R Core Team" ; dct:identifier "l5-source-r-lognormal" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Lognormal.html> ; cd:supportsResource ex:l5-lognormal-definition, ex:l5-l12b-formula, ex:l5-l12c-formula ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal> {
  ex:lognormal-concentration-model a cd:Concept ; skos:prefLabel "Lognormal concentration model"@en ; cd:hasDefinition ex:l5-lognormal-definition ; cd:authoredResource true .
  ex:l5-lognormal-definition a cd:Definition ; cd:body "A positive concentration follows a lognormal model when the natural logarithm of its ratio to a fixed positive reference concentration is normally distributed. The normal parameters describe the dimensionless log ratio, not the concentration itself. Multiplicative influences can motivate such a model, but positivity, right skew or a log transformation alone does not establish it."@en ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-l12b-formula a cd:MathExpression ; cd:formulaLabel "Normal on the log scale"@en ; cd:body "Define U as the natural logarithm of positive concentration X divided by a reference concentration. U follows a normal model with log-ratio mean m and variance s squared."@en ; cd:latex "\\begin{gathered}U=\\ln(X/c_0)\\sim\\mathcal{N}(m,s^2)\\\\X>0,\\quad s>0\\end{gathered}" ; dct:hasPart ex:l5-l12b-legend ; cd:hasSymbol ex:l5-lb-concentration, ex:l5-lb-log, ex:l5-lb-parameters, ex:l5-lb-notation ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-l12b-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-lb-entry ; cd:authoredResource true .
  ex:l5-lb-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and convention"@en ; dct:references ex:l5-lb-concentration, ex:l5-lb-log, ex:l5-lb-parameters, ex:l5-lb-notation ; cd:authoredResource true .
  ex:l5-lb-concentration a cd:MathSymbol ; cd:symbol "X and reference" ; cd:mathNotation "X,\\ c_0" ; cd:body "Positive concentration X in mg/L; fixed reference c with subscript 0 is 1 mg/L. Division cancels units before taking a logarithm."@en ; cd:authoredResource true .
  ex:l5-lb-log a cd:MathSymbol ; cd:symbol "U and ln" ; cd:mathNotation "U,\\ \\ln" ; cd:body "U is the dimensionless log ratio; ln is the natural logarithm. Negative log ratios are valid for concentrations below the reference."@en ; cd:authoredResource true .
  ex:l5-lb-parameters a cd:MathSymbol ; cd:symbol "m, s and variance" ; cd:mathNotation "m,\\ s,\\ s^2" ; cd:body "Log-ratio mean m = 0.69315 and SD s = 0.75 here, both dimensionless. The second normal parameter is variance, not concentration SD."@en ; cd:authoredResource true .
  ex:l5-lb-notation a cd:MathSymbol ; cd:symbol "model and operators" ; cd:mathNotation "=,\\ /,\\ \\sim,\\ \\mathcal{N},\\ >" ; cd:body "Equality defines U; / divides; tilde means distributed as; N denotes normal. Greater than zero requires positive concentration and log SD."@en ; cd:authoredResource true .

  ex:l5-l12c-formula a cd:MathExpression ; cd:formulaLabel "Population median and mean are different"@en ; cd:body "The population median and geometric mean equal the reference concentration times exp of m. The arithmetic expectation equals the reference times exp of m plus half the log variance."@en ; cd:latex "\\begin{gathered}\\operatorname{Median}(X)=G(X)=c_0e^m\\\\E[X]=c_0e^{m+s^2/2}\\end{gathered}" ; dct:hasPart ex:l5-l12c-legend ; cd:hasSymbol ex:l5-lc-concentration, ex:l5-lc-parameters, ex:l5-lc-summaries, ex:l5-lc-operators ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-l12c-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-lc-entry ; cd:authoredResource true .
  ex:l5-lc-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, population targets and units"@en ; dct:references ex:l5-lc-concentration, ex:l5-lc-parameters, ex:l5-lc-summaries, ex:l5-lc-operators ; cd:authoredResource true .
  ex:l5-lc-concentration a cd:MathSymbol ; cd:symbol "X and reference" ; cd:mathNotation "X,\\ c_0" ; cd:body "Random positive concentration X; reference c with subscript 0 is fixed at 1 mg/L. Multiplying by this reference restores concentration units."@en ; cd:authoredResource true .
  ex:l5-lc-parameters a cd:MathSymbol ; cd:symbol "m and s" ; cd:mathNotation "m,\\ s" ; cd:body "Mean and positive SD of the natural log of X/reference, both dimensionless: m = 0.69315 and s = 0.75. Squaring s gives log variance."@en ; cd:authoredResource true .
  ex:l5-lc-summaries a cd:MathSymbol ; cd:symbol "Median, G and E" ; cd:mathNotation "\\operatorname{Median},\\ G,\\ E" ; cd:body "Population median and geometric mean G: 2.00 mg/L. Arithmetic expectation E: about 2.65 mg/L. These are model quantities, not sample estimates."@en ; cd:authoredResource true .
  ex:l5-lc-operators a cd:MathSymbol ; cd:symbol "exponential and arithmetic" ; cd:mathNotation "e,\\ =,\\ +,\\ /,\\ s^2" ; cd:body "e is the natural exponential base. Equality states identities; + adds half the log variance; /2 divides by two. Juxtaposition multiplies; exponents are dimensionless."@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/specifications/level5-lognormal> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:lognormal-concentration-model .
  ex:l5-l12a-title a cd:Interpretation ; skos:prefLabel "Model variation between water samples"@en ; cd:authoredResource true .
  ex:l5-l12b-title a cd:Interpretation ; skos:prefLabel "Transform values, not our investigation target"@en ; cd:authoredResource true .
  ex:l5-l12c-title a cd:Interpretation ; skos:prefLabel "For mean concentration, median is not enough"@en ; cd:authoredResource true .
  ex:l5-l12d-title a cd:Interpretation ; skos:prefLabel "Check which data can support the estimate"@en ; cd:authoredResource true .
  ex:l5-l12a-context a cd:Interpretation ; cd:body "Factors motivate a lognormal candidate. Use 20 new constructed values to illustrate it; these are not the preceding site data or a fitted model."@en ; cd:authoredResource true .
  ex:l5-l12a-chart a cd:ChartDefinition ; skos:prefLabel "20 constructed positive concentrations"@en ; cd:body "Bars: 20 constructed values. Line: specified lognormal model, median 2 mg/L. Its right tail continues beyond 10 mg/L."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:l5-lognormal-values ; dct:hasPart ex:l5-lognormal-density ; cd:binEdges ex:l5-lre-0 ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-l12b-chart a cd:ChartDefinition ; skos:prefLabel "The same 20 values after a natural-log transformation"@en ; cd:body "Bars: the same 20 values, now logged relative to 1 mg/L. Line: specified normal model on this dimensionless scale, not a fitted result."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:l5-lognormal-log-values ; dct:hasPart ex:l5-lognormal-log-density ; cd:binEdges ex:l5-lte-0 ; cd:xAxisLabel "Log concentration ratio"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "1" ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-l12c-chart a cd:ChartDefinition ; skos:prefLabel "Population summaries on the original concentration scale"@en ; cd:body "Model median/geometric mean: 2.00 mg/L; arithmetic expectation: 2.65 mg/L. These are not sample estimates."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.4 ; cd:usesDataset ex:l5-lognormal-density ; cd:hasChartAnnotation ex:l5-lmedian-mark, ex:l5-lmean-mark ; cd:xAxisLabel "Concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:hasSource ex:l5-source-r-lognormal ; cd:authoredResource true .
  ex:l5-lmedian-mark a cd:ChartPointAnnotation ; cd:position 1 ; cd:targetObservation ex:l5-ld-8 ; cd:body "Median"@en ; cd:authoredResource true .
  ex:l5-lmean-mark a cd:ChartPointAnnotation ; cd:position 2 ; cd:targetObservation ex:l5-ld-10 ; cd:body "Mean"@en ; cd:authoredResource true .

  ex:l5-lognormal-values a cd:Dataset ; skos:prefLabel "20 constructed concentrations for a log-scale comparison"@en ; cd:body "A new teaching example, not the forty site values from N11. Seven log-spaced levels have multiplicities 1, 2, 4, 6, 4, 2, 1. Values are twice exp of offsets -1.5, -1, -0.5, 0, 0.5, 1, 1.5, in mg/L. Deliberately constructed, not measured or randomly simulated. The reference model has log-ratio mean ln(2) and SD 0.75; it is specified, not fitted."@en ; cd:unit "mg/L" ; cd:hasObservation ex:l5-lraw-1, ex:l5-lraw-2, ex:l5-lraw-3, ex:l5-lraw-4, ex:l5-lraw-5, ex:l5-lraw-6, ex:l5-lraw-7, ex:l5-lraw-8, ex:l5-lraw-9, ex:l5-lraw-10, ex:l5-lraw-11, ex:l5-lraw-12, ex:l5-lraw-13, ex:l5-lraw-14, ex:l5-lraw-15, ex:l5-lraw-16, ex:l5-lraw-17, ex:l5-lraw-18, ex:l5-lraw-19, ex:l5-lraw-20 ; cd:authoredResource true .
  ex:l5-lraw-1 a cd:Observation ; cd:position 1 ; cd:numericValue 0.446260320296860 ; cd:authoredResource true .
  ex:l5-lraw-2 a cd:Observation ; cd:position 2 ; cd:numericValue 0.735758882342885 ; cd:authoredResource true .
  ex:l5-lraw-3 a cd:Observation ; cd:position 3 ; cd:numericValue 0.735758882342885 ; cd:authoredResource true .
