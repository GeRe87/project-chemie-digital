  ex:l5-lognormal-density a cd:Dataset ; skos:prefLabel "Specified lognormal density: log-ratio mean ln(2), SD 0.75"@en ; cd:body "Theoretical concentration-density coordinates with reference 1 mg/L. The support is strictly positive. The value at zero is the limiting density, not an observed zero or point mass. Linear segments approximate the curve, which continues beyond 10 mg/L; about 1.594% probability lies above that plot limit. Median is 2 mg/L and arithmetic expectation is 2.649569517457731 mg/L."@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:l5-lognormal-definition, ex:l5-l12c-formula ; cd:hasObservation ex:l5-ld-0, ex:l5-ld-1, ex:l5-ld-2, ex:l5-ld-3, ex:l5-ld-4, ex:l5-ld-5, ex:l5-ld-6, ex:l5-ld-7, ex:l5-ld-8, ex:l5-ld-9, ex:l5-ld-10, ex:l5-ld-11, ex:l5-ld-12, ex:l5-ld-13, ex:l5-ld-14, ex:l5-ld-15, ex:l5-ld-16, ex:l5-ld-17, ex:l5-ld-18, ex:l5-ld-19, ex:l5-ld-20 ; cd:authoredResource true .
