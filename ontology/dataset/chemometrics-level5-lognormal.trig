  ex:l5-l12d-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-l12d-zero, ex:l5-l12d-limits, ex:l5-l12d-mixtures, ex:l5-l12d-return ; cd:authoredResource true .
  ex:l5-l12d-zero a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Real zeros"@en ; cd:body "A real zero cannot be logged. Do not add an arbitrary constant just to make a lognormal model usable."@en ; cd:authoredResource true .
  ex:l5-l12d-limits a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Below a limit"@en ; cd:body "Below detection or quantification is censored information, not a known zero. Missing values are not zeros either."@en ; cd:authoredResource true .
  ex:l5-l12d-mixtures a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Different groups"@en ; cd:body "Mixtures and censoring can create apparent skewness. Check the process, groups and dependence before choosing a model."@en ; cd:authoredResource true .
  ex:l5-l12d-return a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "Return to the right target"@en ; cd:body "Back-transforming a log mean gives a geometric mean, not an arithmetic mean. A log transform does not guarantee normality."@en ; cd:authoredResource true .
}

