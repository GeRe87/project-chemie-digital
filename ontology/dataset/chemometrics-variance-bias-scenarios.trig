# Local didactic additions. Existing data, excluded topics and published units
# are preserved. Numerical projections are authored tables, not renderer text.
<https://w3id.org/project-chemie-digital/graph/specifications/variance-bias-scenarios> {
  ex:vr04 cd:hasKeyPoint ex:vb04-b .
  ex:vb04-b a cd:KeyPoint ; cd:position 2 ; cd:body "The arithmetic mean is the sum of observations divided by their count."@en ; cd:authoredResource true .
  ex:vr05 cd:hasKeyPoint ex:vb05-a, ex:vb05-b .
  ex:vb05-a a cd:KeyPoint ; cd:position 1 ; cd:body "Subtract the sample mean from each observation to obtain its signed deviation."@en ; cd:authoredResource true .
  ex:vb05-b a cd:KeyPoint ; cd:position 2 ; cd:body "Negative means below the sample mean; positive means above it."@en ; cd:authoredResource true .
  ex:vr06 cd:hasKeyPoint ex:vb06-a, ex:vb06-b .
  ex:vb06-a a cd:KeyPoint ; cd:position 1 ; cd:body "Signed deviations cancel around their own arithmetic mean."@en ; cd:authoredResource true .
  ex:vb06-b a cd:KeyPoint ; cd:position 2 ; cd:body "A zero sum does not mean zero spread. We need a summary that avoids cancellation."@en ; cd:authoredResource true .
  ex:vr07 cd:hasKeyPoint ex:vb07-b .
  ex:vb07-b a cd:KeyPoint ; cd:position 2 ; cd:body "SS names the sum of squared deviations. Its unit is the squared measurement unit."@en ; cd:authoredResource true .
  ex:vr08 cd:hasKeyPoint ex:vb08-a, ex:vb08-b .
  ex:vb08-a a cd:KeyPoint ; cd:position 1 ; cd:body "MSD means mean squared deviation. Divide SS, the sum of squared deviations, by the observation count."@en ; cd:authoredResource true .
  ex:vb08-b a cd:KeyPoint ; cd:position 2 ; cd:body "This describes the spread of the observed values about their observed mean."@en ; cd:authoredResource true .
  ex:vb-msd-comparison a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vr09a, ex:vr09b ; dct:source ex:vr09, ex:vr10 ; cd:authoredResource true .
  ex:vr11-cards cd:hasDefinitionListEntry ex:vb-pop-context .
  ex:vb-pop-context a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Why make the population known?"@en ; cd:body "In a real laboratory the population mean is often unknown. Here it is deliberately specified, so we can compare estimates with known targets and investigate estimation bias."@en ; cd:authoredResource true .

