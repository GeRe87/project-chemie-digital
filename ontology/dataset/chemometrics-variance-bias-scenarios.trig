  # Scenario introductions precede their algebra or interpretation.
  ex:vb-centers a cd:Interpretation ; skos:prefLabel "Two Different Centers"@en ; dct:source ex:vr14 ; cd:authoredResource true .
  ex:vb-centers-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vb-centers-a, ex:vb-centers-b ; cd:authoredResource true .
  ex:vb-centers-a a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Population center"@en ; cd:body "Scenario: the true mean μ is usually unknown in a laboratory. Our demonstration deliberately supplies μ = 10 mg/L so we can assess estimation errors."@en ; cd:authoredResource true .
  ex:vb-centers-b a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Estimated center"@en ; cd:body "Series A has sample mean x̄ = 32/3 ≈ 10.667 mg/L. This is not the supplied population mean. The difference between these centers shifts every deviation by the same amount."@en ; cd:authoredResource true .
  ex:vb-mixture a cd:Interpretation ; skos:prefLabel "A Mixture with One Constraint"@en ; dct:source ex:vr12 ; cd:authoredResource true .
  ex:vb-mixture-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:vb-mixture-a, ex:vb-mixture-b ; cd:authoredResource true .
  ex:vb-mixture-a a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario"@en ; cd:body "A mixture contains three nonnegative component percentages.\nTogether they must total 100%.\nSet the first two to 20% and 30%. What remains?"@en ; cd:authoredResource true .
  ex:vb-mixture-b a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Degrees of freedom"@en ; cd:body "The number of quantities that can vary freely after independent constraints are imposed. Here the third share is determined. This is a constraint concept, not a statement about probabilistic sampling independence."@en ; cd:authoredResource true .
  ex:vb-quality a cd:Interpretation ; skos:prefLabel "Precision, Trueness and Bias"@en ; dct:source ex:vr29 ; cd:authoredResource true .

  # Complete worked calculation after derivation and degrees of freedom.
