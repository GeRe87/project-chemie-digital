  # Prepared demonstrations separate random estimates from their expectations.
  ex:vb-sample a cd:Interpretation ; skos:prefLabel "Experiment 1: Five Samples at Each Size"@en ; cd:hasCodeExample ex:vs-exp1-code ; dct:source ex:vs-model, ex:vr20 ; cd:authoredResource true .
  ex:vb-sample-task a cd:Exercise ; cd:body "Prepared instructor demonstration. Five independent normal samples for each n = 2, 3, 5, 10, 25, 50, 100. Mean 10 mg/L; variance 5 (mg/L)². Calculate MSD about each empirical mean using divisor n. Seed 1901 retains the original drawing order; display is ascending. Five repeats illustrate fluctuations, not reliable evidence of bias."@en ; cd:hasCodeExample ex:vs-exp1-code ; cd:authoredResource true .
  ex:vb-sample-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:code "# Prepared instructor code; students interpret the output\nset.seed(1801)\nsizes <- c(3, 5, 10, 30, 100)\none <- t(sapply(sizes, function(n) {\n  x <- rnorm(n, 10, 2)\n  ss <- sum((x - mean(x))^2)\n  c(n = n, mean = mean(x), MSD = ss/n, s2 = ss/(n-1))\n}))\nround(one, 3)" ; cd:authoredResource true .
  ex:vb-mc a cd:Interpretation ; skos:prefLabel "Repeated Sampling: Sizes 2 to 100"@en ; cd:hasCodeExample ex:vs-exp2-code ; dct:source ex:vs-model, ex:vr20 ; cd:authoredResource true .
  ex:vb-mc-task a cd:Exercise ; cd:body "Prepared instructor demonstration. Five independent samples at every n from 2 to 100: 495 estimates. Mean 10 mg/L; variance 5 (mg/L)²; seed 1902. draws2 retains all results; output previews seven sizes. A numerical scatterplot is not supported by the current chart contract. Five realizations per n do not reliably establish bias."@en ; cd:hasCodeExample ex:vs-exp2-code ; cd:authoredResource true .
  ex:vb-mc-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:code "set.seed(1802)\nsizes <- c(3, 5, 10, 30, 100)\nmc <- t(sapply(sizes, function(n) {\n  z <- replicate(5000, {\n    x <- rnorm(n, 10, 2)\n    ss <- sum((x - mean(x))^2)\n    c(mean = mean(x), MSD = ss/n, s2 = ss/(n-1))\n  })\n  c(n = n, rowMeans(z))\n}))\nround(mc, 6)" ; cd:authoredResource true .
  ex:vb-bias a cd:Interpretation ; skos:prefLabel "Theory and Monte Carlo: Variance Estimates"@en ; cd:body "Theory describes the expected estimator under repeated sampling. A finite Monte-Carlo mean is a reproducible random approximation. The sample mean is unbiased for μ but random. MSD about the fitted mean has downward bias as a population-variance estimator; the n−1 estimator is unbiased for σ² under iid sampling with finite variance."@en ; cd:hasKeyPoint ex:vb-bias-k1, ex:vb-bias-k2, ex:vb-bias-k3 ; cd:authoredResource true .
  ex:vb-bias-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "The sample mean is unbiased but random. Its repeated-sampling average targets 10 mg/L."@en ; cd:authoredResource true .
  ex:vb-bias-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "MSD using n is downward biased for population variance. Using n−1 removes this average bias, not random fluctuation."@en ; cd:authoredResource true .
  ex:vb-bias-k3 a cd:KeyPoint ; cd:position 3 ; cd:body "Theory means exact expectations. MC means averages of 5,000 independent simulated samples, seed 1802."@en ; cd:authoredResource true .
  ex:vb-bias-data a cd:Dataset ; cd:unit "(mg/L)²" ; dct:description "Theoretical expectations and rounded webR Monte-Carlo means. MC provenance: seed 1802, 5000 independent samples per size, normal population mean 10 mg/L and SD 2 mg/L. Values are estimates of averages, not raw measurement observations."@en ; dct:source ex:vb-mc-code ; cd:hasObservation ex:vb-n3-tm, ex:vb-n3-ts, ex:vb-n3-mm, ex:vb-n3-ms, ex:vb-n5-tm, ex:vb-n5-ts, ex:vb-n5-mm, ex:vb-n5-ms, ex:vb-n10-tm, ex:vb-n10-ts, ex:vb-n10-mm, ex:vb-n10-ms, ex:vb-n30-tm, ex:vb-n30-ts, ex:vb-n30-mm, ex:vb-n30-ms, ex:vb-n100-tm, ex:vb-n100-ts, ex:vb-n100-mm, ex:vb-n100-ms ; cd:authoredResource true .
  ex:vb-n3-tm a cd:Observation ; cd:position 1 ; skos:prefLabel "Theory MSD"@en ; cd:groupLabel "n = 3"@en ; cd:numericValue 2.666666666666667 ; cd:authoredResource true .
  ex:vb-n3-ts a cd:Observation ; cd:position 2 ; skos:prefLabel "Theory s²"@en ; cd:groupLabel "n = 3"@en ; cd:numericValue 4.0 ; cd:authoredResource true .
