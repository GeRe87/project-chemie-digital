@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-tf-story> {
  ex:tf-crm a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-crm1, ex:tf-crm2 ; cd:authoredResource true .
  ex:tf-crm1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A fresh nitrate CRM study"@en ; cd:body "Six independent IC results, in mg/L. The CRM reference is 10.00 mg/L, treated as known with negligible uncertainty only for this teaching example. This is a new series, not the preceding chi-square QC data."@en ; cd:authoredResource true .
  ex:tf-crm2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Is the method systematically high?"@en ; cd:body "The true repeatability SD is unknown. Our mean is 10.10 mg/L and the sample SD is 0.10 mg/L. Is this departure evidence of bias, or compatible with random sampling? Assume iid normal results provisionally."@en ; cd:authoredResource true .
  ex:tf-data a cd:TableDefinition ; skos:prefLabel "Fictional CRM results in mg/L: device A is retained unchanged"@en ; cd:hasTableColumn ex:tf-col-a ; cd:hasTableRow ex:tf-row1, ex:tf-row2, ex:tf-row3, ex:tf-row4, ex:tf-row5, ex:tf-row6 ; cd:authoredResource true .
  ex:tf-col-a a cd:TableColumn ; cd:position 1 ; skos:prefLabel "Device A (mg/L)"@en ; cd:authoredResource true .
