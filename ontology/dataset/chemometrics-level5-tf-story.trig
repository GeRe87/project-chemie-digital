  ex:tf-a4 a cd:TableCell ; cd:position 1 ; cd:body "10.10"@en ; cd:authoredResource true .
  ex:tf-a5 a cd:TableCell ; cd:position 1 ; cd:body "10.15"@en ; cd:authoredResource true .
  ex:tf-a6 a cd:TableCell ; cd:position 1 ; cd:body "10.25"@en ; cd:authoredResource true .
  ex:tf-pair-data a cd:TableDefinition ; skos:prefLabel "Independent groups, not paired rows; concentrations in mg/L"@en ; dct:references ex:tf-data ; cd:hasTableColumn ex:tf-col-pa, ex:tf-col-b ; cd:hasTableRow ex:tf-pair1, ex:tf-pair2, ex:tf-pair3, ex:tf-pair4, ex:tf-pair5, ex:tf-pair6 ; cd:authoredResource true .
  ex:tf-col-pa a cd:TableColumn ; cd:position 1 ; skos:prefLabel "Same device A (mg/L)"@en ; cd:authoredResource true .
  ex:tf-col-b a cd:TableColumn ; cd:position 2 ; skos:prefLabel "Device B (mg/L)"@en ; cd:authoredResource true .
  ex:tf-pair1 a cd:TableRow ; cd:position 1 ; cd:hasTableCell ex:tf-pa1, ex:tf-b1 ; cd:authoredResource true .
  ex:tf-pair2 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:tf-pa2, ex:tf-b2 ; cd:authoredResource true .
  ex:tf-pair3 a cd:TableRow ; cd:position 3 ; cd:hasTableCell ex:tf-pa3, ex:tf-b3 ; cd:authoredResource true .
  ex:tf-pair4 a cd:TableRow ; cd:position 4 ; cd:hasTableCell ex:tf-pa4, ex:tf-b4 ; cd:authoredResource true .
  ex:tf-pair5 a cd:TableRow ; cd:position 5 ; cd:hasTableCell ex:tf-pa5, ex:tf-b5 ; cd:authoredResource true .
  ex:tf-pair6 a cd:TableRow ; cd:position 6 ; cd:hasTableCell ex:tf-pa6, ex:tf-b6 ; cd:authoredResource true .
  ex:tf-pa1 a cd:TableCell ; cd:position 1 ; cd:body "9.95"@en ; cd:authoredResource true .
  ex:tf-pa2 a cd:TableCell ; cd:position 1 ; cd:body "10.05"@en ; cd:authoredResource true .
  ex:tf-pa3 a cd:TableCell ; cd:position 1 ; cd:body "10.10"@en ; cd:authoredResource true .
  ex:tf-pa4 a cd:TableCell ; cd:position 1 ; cd:body "10.10"@en ; cd:authoredResource true .
  ex:tf-pa5 a cd:TableCell ; cd:position 1 ; cd:body "10.15"@en ; cd:authoredResource true .
  ex:tf-pa6 a cd:TableCell ; cd:position 1 ; cd:body "10.25"@en ; cd:authoredResource true .
  ex:tf-b1 a cd:TableCell ; cd:position 2 ; cd:body "9.55"@en ; cd:authoredResource true .
  ex:tf-b2 a cd:TableCell ; cd:position 2 ; cd:body "9.85"@en ; cd:authoredResource true .
  ex:tf-b3 a cd:TableCell ; cd:position 2 ; cd:body "10.00"@en ; cd:authoredResource true .
  ex:tf-b4 a cd:TableCell ; cd:position 2 ; cd:body "10.00"@en ; cd:authoredResource true .
  ex:tf-b5 a cd:TableCell ; cd:position 2 ; cd:body "10.15"@en ; cd:authoredResource true .
  ex:tf-b6 a cd:TableCell ; cd:position 2 ; cd:body "10.45"@en ; cd:authoredResource true .

  ex:tf-known a cd:MathExpression ; cd:formulaLabel "A known-SD reference, under the null"@en ; cd:latex "\\bar X\\sim\\mathcal N(\\mu,\\sigma^2/n),\\qquad Z=\\frac{\\bar X-\\mu_0}{\\sigma/\\sqrt n}\\sim\\mathcal N(0,1)\\quad(H_0)" ; cd:body "As with the individual-result z-score, standardize by a true SD. Here it is the SD of a mean, not of one result. Hypothetically known SD 0.10 mg/L gives a two-sided normal p-value 0.01431. That is not our actual unknown-SD situation."@en ; dct:hasPart ex:tf-known-legend ; cd:hasSymbol ex:tf-known-symbol ; cd:authoredResource true .
  ex:tf-known-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-known-entry ; cd:authoredResource true .
  ex:tf-known-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Mean, SE and null reference"@en ; dct:references ex:tf-known-symbol ; cd:authoredResource true .
  ex:tf-known-symbol a cd:MathSymbol ; cd:symbol "known-SD standardization" ; cd:mathNotation "\\bar X,\\mu,\\mu_0,\\sigma,n,Z,H_0" ; cd:body "Bar X is the random sample mean; mu is the population mean; mu subscript zero is the null reference 10.00, all in mg/L. Sigma is fixed positive individual SD in mg/L, n=6 is the count. Square means variance; division by n gives mean variance, positive square root n gives SE. Subtract and divide define unitless Z. Tilde means distributed as; N lists mean then variance. H subscript zero assumes mu equals the reference. Only then does Z have mean zero and variance one; comma separates parameters and equality defines the statistic."@en ; cd:authoredResource true .
  ex:tf-estimated a cd:MathExpression ; cd:formulaLabel "Same number, different reference distribution"@en ; cd:latex "t=\\frac{\\bar x-\\mu_0}{s/\\sqrt n}=\\frac{10.10-10.00}{0.10/\\sqrt6}=\\sqrt6\\approx2.449" ; cd:body "The sample SD is estimated from these same six results, not a known constant. Repeated series change both mean and SD. Plugging this number into the normal reference would ignore the random denominator."@en ; dct:hasPart ex:tf-estimated-legend ; cd:hasSymbol ex:tf-estimated-symbol ; cd:authoredResource true .
  ex:tf-estimated-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-estimated-entry ; cd:authoredResource true .
  ex:tf-estimated-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Observed values versus random variables"@en ; dct:references ex:tf-estimated-symbol ; cd:authoredResource true .
  ex:tf-estimated-symbol a cd:MathSymbol ; cd:symbol "observed studentized mean" ; cd:mathNotation "t,\\bar x,\\mu_0,s,n" ; cd:body "Lowercase t is the observed unitless statistic, bar x=10.10 is the observed mean, mu subscript zero=10.00 the null reference, and s=0.10 the sample SD, in mg/L. n=6 is sample size. Subtraction gives the mean departure; division by s over positive root n uses estimated SE 0.040825 mg/L. Equal signs give the calculation; approximately allows rounding. This t is not a density or a probability."@en ; cd:authoredResource true .
  ex:tf-denominator a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-denom1, ex:tf-denom2 ; cd:authoredResource true .
  ex:tf-denom1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Small denominator, large statistic"@en ; cd:body "- Small estimated SE can magnify either sign of mean departure.\n- True generating SD stays fixed."@en ; cd:authoredResource true .
  ex:tf-denom2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Heavier tails, not biased means"@en ; cd:body "- Symmetric t density: lower peak, heavier tails than normal.\n- Studentized means, not individual concentrations.\n- Normal sampling makes mean and variance independent."@en ; cd:authoredResource true .
  ex:tf-construction a cd:MathExpression ; cd:formulaLabel "The unknown population SD cancels"@en ; cd:latex "Q=\\frac{(n-1)S^2}{\\sigma^2}\\sim\\chi^2_\\nu,\\quad\\nu=n-1,\\qquad T=\\frac{Z}{\\sqrt{Q/\\nu}}=\\frac{\\bar X-\\mu}{S/\\sqrt n}\\sim t_\\nu" ; cd:body "For iid normal results, the standardized mean and the scaled sample variance are independent. This independence is essential: an arbitrary normal numerator divided by a correlated variance estimate need not have a t distribution."@en ; dct:hasPart ex:tf-construction-legend ; cd:hasSymbol ex:tf-construction-symbol ; cd:authoredResource true .
  ex:tf-construction-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-construction-entry ; cd:authoredResource true .
  ex:tf-construction-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Independent normal and chi-square pieces"@en ; dct:references ex:tf-construction-symbol ; cd:authoredResource true .
  ex:tf-construction-symbol a cd:MathSymbol ; cd:symbol "t construction" ; cd:mathNotation "Q,\\nu,n,S,\\sigma,Z,T,\\bar X,\\mu" ; cd:body "n is count, nu=n minus one is df (5 here). S squared is random sample variance with divisor n minus one; sigma squared is fixed true variance, both in (mg/L) squared. Q is their unitless scaled ratio; chi squared names the chi-square law, subscript nu gives df. Z is the mean minus true mu divided by sigma over root n, an independent standard normal. Bar X and mu are in mg/L; S is sample SD in mg/L. Dividing by positive root Q over nu defines unitless T. Squaring, subtraction, multiplication and division have their usual arithmetic meanings; equality defines quantities, tilde names their laws. Lowercase t with subscript nu names the Student law, not an observed value. For a null test replace mu by mu subscript zero under that null."@en ; cd:authoredResource true .
  ex:tf-df a cd:TableDefinition ; skos:prefLabel "Two-sided 5% critical values: more observations stabilize the SD estimate"@en ; cd:hasTableColumn ex:tf-dfn, ex:tf-dfv, ex:tf-dfq ; cd:hasTableRow ex:tf-df4, ex:tf-df6, ex:tf-df10, ex:tf-df30, ex:tf-df100 ; cd:authoredResource true .
  ex:tf-dfn a cd:TableColumn ; cd:position 1 ; skos:prefLabel "Sample size"@en ; cd:authoredResource true .
  ex:tf-dfv a cd:TableColumn ; cd:position 2 ; skos:prefLabel "Residual df"@en ; cd:authoredResource true .
  ex:tf-dfq a cd:TableColumn ; cd:position 3 ; skos:prefLabel "Positive 97.5th percentile"@en ; cd:authoredResource true .
  ex:tf-df4 a cd:TableRow ; cd:position 1 ; cd:hasTableCell ex:tf-df4n, ex:tf-df4v, ex:tf-df4q ; cd:authoredResource true .
  ex:tf-df4n a cd:TableCell ; cd:position 1 ; cd:body "4"@en ; cd:authoredResource true .
  ex:tf-df4v a cd:TableCell ; cd:position 2 ; cd:body "3"@en ; cd:authoredResource true .
  ex:tf-df4q a cd:TableCell ; cd:position 3 ; cd:body "3.18245"@en ; cd:authoredResource true .
  ex:tf-df6 a cd:TableRow ; cd:position 2 ; cd:hasTableCell ex:tf-df6n, ex:tf-df6v, ex:tf-df6q ; cd:authoredResource true .
  ex:tf-df6n a cd:TableCell ; cd:position 1 ; cd:body "6"@en ; cd:authoredResource true .
  ex:tf-df6v a cd:TableCell ; cd:position 2 ; cd:body "5"@en ; cd:authoredResource true .
  ex:tf-df6q a cd:TableCell ; cd:position 3 ; cd:body "2.57058"@en ; cd:authoredResource true .
  ex:tf-df10 a cd:TableRow ; cd:position 3 ; cd:hasTableCell ex:tf-df10n, ex:tf-df10v, ex:tf-df10q ; cd:authoredResource true .
  ex:tf-df10n a cd:TableCell ; cd:position 1 ; cd:body "10"@en ; cd:authoredResource true .
  ex:tf-df10v a cd:TableCell ; cd:position 2 ; cd:body "9"@en ; cd:authoredResource true .
  ex:tf-df10q a cd:TableCell ; cd:position 3 ; cd:body "2.26216"@en ; cd:authoredResource true .
  ex:tf-df30 a cd:TableRow ; cd:position 4 ; cd:hasTableCell ex:tf-df30n, ex:tf-df30v, ex:tf-df30q ; cd:authoredResource true .
  ex:tf-df30n a cd:TableCell ; cd:position 1 ; cd:body "30"@en ; cd:authoredResource true .
  ex:tf-df30v a cd:TableCell ; cd:position 2 ; cd:body "29"@en ; cd:authoredResource true .
  ex:tf-df30q a cd:TableCell ; cd:position 3 ; cd:body "2.04523"@en ; cd:authoredResource true .
  ex:tf-df100 a cd:TableRow ; cd:position 5 ; cd:hasTableCell ex:tf-df100n, ex:tf-df100v, ex:tf-df100q ; cd:authoredResource true .
  ex:tf-df100n a cd:TableCell ; cd:position 1 ; cd:body "100"@en ; cd:authoredResource true .
  ex:tf-df100v a cd:TableCell ; cd:position 2 ; cd:body "99"@en ; cd:authoredResource true .
  ex:tf-df100q a cd:TableCell ; cd:position 3 ; cd:body "1.98422"@en ; cd:authoredResource true .
  ex:tf-t-decision a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-td1, ex:tf-td2, ex:tf-td3 ; cd:authoredResource true .
  ex:tf-td1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Prespecified two-sided 5% test"@en ; cd:body "Null: the population mean is 10.00 mg/L. Alternative: it differs in either direction. With five df, compare observed t=2.44949 with critical values minus and plus 2.57058. Two-sided p=0.05797: do not reject."@en ; cd:authoredResource true .
  ex:tf-td2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Why the reference matters"@en ; cd:body "If SD 0.10 mg/L truly were known, the normal p-value would be 0.01431 and we would reject at 5%. It is not known here: the t reference accounts for its estimation from only six observations."@en ; cd:authoredResource true .
  ex:tf-td3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Non-rejection does not prove unbiasedness"@en ; cd:body "The p-value is a null-model tail probability, not the probability that the method is unbiased. Six results provide insufficient evidence at this level. Detecting a small bias reliably requires a prospective power and precision study."@en ; cd:authoredResource true .
  ex:tf-ci a cd:MathExpression ; cd:formulaLabel "The same reference gives a mean confidence interval"@en ; cd:latex "\\bar x\\pm t_{0.975;5}\\frac{s}{\\sqrt n}=[9.99506,10.20494]\\;\\mathrm{mg/L}" ; cd:body "The 10.00 mg/L reference is just inside. In repeated iid normal studies, 95% of intervals from this procedure cover the fixed true mean. This is not a 95% probability assigned to the mean after observing this particular interval, nor a range for 95% of individual readings."@en ; dct:hasPart ex:tf-ci-legend ; cd:hasSymbol ex:tf-ci-symbol ; cd:authoredResource true .
  ex:tf-ci-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-ci-entry ; cd:authoredResource true .
  ex:tf-ci-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Interval endpoints and coverage"@en ; dct:references ex:tf-ci-symbol ; cd:authoredResource true .
  ex:tf-ci-symbol a cd:MathSymbol ; cd:symbol "mean interval" ; cd:mathNotation "\\bar x,s,n,t_{0.975;5},\\pm" ; cd:body "Bar x=10.10 mg/L and s=0.10 mg/L are observed mean and sample SD; n=6 is count. t with subscript 0.975 semicolon 5 is the dimensionless 97.5th percentile 2.57058 of Student t with five df. Divide s by positive root n for estimated SE, multiply by the quantile for margin 0.10494 mg/L. Plus/minus forms lower and upper endpoints; brackets and comma delimit the closed interval; equality gives rounded endpoints. mg/L is milligrams per litre. The confidence level is 95%, matching a two-sided 5% test under the same model."@en ; cd:authoredResource true .
  ex:tf-ratio a cd:MathExpression ; cd:formulaLabel "Nine times the observed variance, not necessarily the true variance"@en ; cd:latex "f=\\frac{s_B^2}{s_A^2}=\\frac{0.090}{0.010}=9" ; cd:body "A retains mean 10.10 and SD 0.10 mg/L. B has mean 10.00 and SD 0.30 mg/L. B's observed mean is closer to the CRM, while A's observed spread is smaller. Trueness and precision are different properties; six results do not establish either population property."@en ; dct:hasPart ex:tf-ratio-legend ; cd:hasSymbol ex:tf-ratio-symbol ; cd:authoredResource true .
  ex:tf-ratio-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-ratio-entry ; cd:authoredResource true .
  ex:tf-ratio-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Preserve B over A"@en ; dct:references ex:tf-ratio-symbol ; cd:authoredResource true .
  ex:tf-ratio-symbol a cd:MathSymbol ; cd:symbol "observed variance ratio" ; cd:mathNotation "f,s_B^2,s_A^2" ; cd:body "Lowercase f is the observed dimensionless ratio. Lowercase s squared means sample variance computed about each group's own mean, using divisor five. Subscripts B and A identify the devices; values 0.090 and 0.010 are in (mg/L) squared, so units cancel on division. Equality gives arithmetic results. B/A is assigned before inspecting the data; never automatically put the larger estimate on top. Each group has six results, independent within and between groups."@en ; cd:authoredResource true .
  ex:tf-f-law a cd:MathExpression ; cd:formulaLabel "Two independent scaled variances"@en ; cd:latex "Q_j=\\frac{\\nu_j S_j^2}{\\sigma_j^2}\\sim\\chi^2_{\\nu_j},\\qquad F=\\frac{Q_B/\\nu_B}{Q_A/\\nu_A}\\sim F_{\\nu_B,\\nu_A}" ; cd:body "Under equal population variances the unknown common variance cancels, leaving the random sample-variance ratio B/A. Each group is iid normal and the groups are independent. Equal group means are not required."@en ; dct:hasPart ex:tf-f-law-legend ; cd:hasSymbol ex:tf-f-law-symbol ; cd:authoredResource true .
  ex:tf-f-law-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-f-law-entry ; cd:authoredResource true .
  ex:tf-f-law-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Ordered df and independence"@en ; dct:references ex:tf-f-law-symbol ; cd:authoredResource true .
  ex:tf-f-law-symbol a cd:MathSymbol ; cd:symbol "F construction" ; cd:mathNotation "j,Q_j,\\nu_j,S_j^2,\\sigma_j^2,F" ; cd:body "Index j is A or B; nu subscript j is that group's sample count minus one. S squared is its random sample variance and sigma squared its positive true variance, in (mg/L) squared. Multiply variance by df and divide by true variance to obtain unitless Q, a chi-square variable. Q A and Q B are independent. Divide each by its own df, then take B over A. F denotes the resulting unitless variable and, on the right, the F distribution name. Its first df is numerator B, second denominator A; both five here. Squares mean variance; equality defines quantities, tilde names laws, comma orders parameters. Without equal variances the observed sample ratio must also be divided by the true B/A variance ratio to have this reference law."@en ; cd:authoredResource true .
  ex:tf-f-df a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-fdf1, ex:tf-fdf2 ; cd:authoredResource true .
  ex:tf-fdf1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Numerator first"@en ; cd:body "- Six versus six readings: df 5,5.\n- Ten B versus six A: df 9,5.\n- Inverting the ratio swaps the df."@en ; cd:authoredResource true .
  ex:tf-fdf2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Positive and right-skewed"@en ; cd:body "- Equal true variances still allow ratios below or above one.\n- Small denominators produce large ratios; no finite upper limit.\n- Variances, not means."@en ; cd:authoredResource true .
  ex:tf-f-decision a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-fd1, ex:tf-fd2 ; cd:authoredResource true .
  ex:tf-fd1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Equal variances: reject at 5%"@en ; cd:body "- Null: equal true variances; alternative: different.\n- Independent normal groups; df 5,5.\n- Two-sided p: twice the smaller null tail."@en ; cd:authoredResource true .
  ex:tf-fd2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Repeatability, not overall quality"@en ; cd:body "- B has larger sample variance.\n- Bias, selectivity, robustness and reference uncertainty are separate questions."@en ; cd:authoredResource true .
  ex:tf-square a cd:MathExpression ; cd:formulaLabel "The two-sided t tail equals an upper F tail"@en ; cd:latex "T^2=\\frac{Z^2}{Q/\\nu}\\sim F_{1,\\nu},\\qquad t^2=6,\\quad p=0.05797" ; cd:body "Squaring an independent standard-normal numerator gives chi-square with one df. Squaring removes the sign: the two-sided t event becomes one upper-tail F event. Do not double this F tail again. This is not the two-device F ratio 9 with df 5,5."@en ; dct:hasPart ex:tf-square-legend ; cd:hasSymbol ex:tf-square-symbol ; cd:authoredResource true .
  ex:tf-square-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-square-entry ; cd:authoredResource true .
  ex:tf-square-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random law and observed result"@en ; dct:references ex:tf-square-symbol ; cd:authoredResource true .
  ex:tf-square-symbol a cd:MathSymbol ; cd:symbol "squared t" ; cd:mathNotation "T,Z,Q,\\nu,F_{1,\\nu},t,p" ; cd:body "T is a random Student variable; Z is standard normal, independent of chi-square Q with nu df. Superscript two squares a variable. Divide Q by positive df nu (five here). Z squared has chi-square df one, so the ratio has F law with numerator df one and denominator df nu; tilde means distributed as. Lowercase t is observed root six; its square is six. p is the upper-tail probability 0.05797 under F with df 1,5, equal to the two-sided t-five p-value. All quantities are dimensionless; equals gives identities or rounded calculations, comma separates ordered df."@en ; cd:authoredResource true .
  ex:tf-calibration a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-cal1, ex:tf-cal2 ; cd:authoredResource true .
  ex:tf-cal1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Linear or quadratic calibration?"@en ; cd:body "Twelve fixed concentrations from 0 to 10 mg/L, with synthetic response in arbitrary units. Fit intercept plus concentration, then add squared concentration. On the same data, nested ordinary least squares cannot increase residual sum of squares when a term is added."@en ; cd:authoredResource true .
  ex:tf-cal2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Improvement must pay for complexity"@en ; cd:body "A smaller RSS alone does not justify curvature. Compare improvement per added parameter with remaining error variance. The null says the quadratic coefficient is zero. Assume fixed error-free concentrations and independent normal, equal-variance response errors; other calibration designs require other analyses."@en ; cd:authoredResource true .
  ex:tf-cal-law a cd:MathExpression ; cd:formulaLabel "Added-term variation over remaining error"@en ; cd:latex "F=\\frac{(\\mathrm{RSS}_s-\\mathrm{RSS}_c)/(p_c-p_s)}{\\mathrm{RSS}_c/(n-p_c)}\\sim F_{p_c-p_s,n-p_c}\\quad(H_0)" ; cd:body "The two RSS values are dependent. Under the null, the added-term sum of squares and the complex-model residual sum of squares, scaled by the common error variance, are independent chi-square forms. That orthogonal decomposition supplies the F law used in regression and ANOVA."@en ; dct:hasPart ex:tf-cal-law-legend ; cd:hasSymbol ex:tf-cal-law-symbol ; cd:authoredResource true .
  ex:tf-cal-law-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-cal-law-entry ; cd:authoredResource true .
  ex:tf-cal-law-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Same observations, nested full-rank OLS models"@en ; dct:references ex:tf-cal-law-symbol ; cd:authoredResource true .
  ex:tf-cal-law-symbol a cd:MathSymbol ; cd:symbol "nested regression F" ; cd:mathNotation "F,\\mathrm{RSS}_s,\\mathrm{RSS}_c,p_s,p_c,n,H_0" ; cd:body "RSS is sum of squared response residuals in squared response units. Subscripts s and c denote simple linear and complex quadratic models on identical observations. p counts all fitted coefficients including intercept: p s=2 and p c=3. n=12 is count. Subtract RSS for added-term SS, divide by added df p c minus p s=1; divide complex RSS by residual df n minus p c=9. Their ratio F is unitless. Under H subscript zero (quadratic coefficient zero), tilde names F law with ordered df 1,9. Minus, division and equality are arithmetic; comma orders df. Normal iid errors with common positive variance, fixed predictor values and full-rank nested designs give the exact reference."@en ; cd:authoredResource true .
  ex:tf-assumptions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-as1, ex:tf-as2 ; cd:authoredResource true .
  ex:tf-as1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Exact laws need a sampling model"@en ; cd:body "One-sample t is exact for iid normal results. Other populations may permit an approximation, not an automatic guarantee at six results. The classical two-variance F test is especially sensitive to nonnormality. Outliers and drift change more than a p-value."@en ; cd:authoredResource true .
  ex:tf-as2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Check the experiment, not just a histogram"@en ; cd:body "Inspect time order, preparation and instrument dependencies, residuals and plausible error mechanisms. Drift violates identical sampling; shared disturbances can destroy independence. A normal-looking plot cannot establish either condition. Real CRM uncertainty belongs in a real validation model."@en ; cd:authoredResource true .
  ex:tf-design a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-de1, ex:tf-de2 ; cd:authoredResource true .
  ex:tf-de1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Match the mean comparison to its design"@en ; cd:body "- Paired samples: analyze within-pair differences.\n- Independent groups, unequal variances: consider Welch t.\n- Do not choose a pooled test mechanically after a variance test."@en ; cd:authoredResource true .
  ex:tf-de2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Robust is not design-proof"@en ; cd:body "- Brown-Forsythe (median-centered Levene) or suitable resampling can help compare nonnormal spread.\n- Neither automatically fixes drift or dependence.\n- Respect exchangeability and sampling units; never delete results for significance."@en ; cd:authoredResource true .
  ex:tf-summary a cd:DefinitionList ; cd:hasDefinitionListEntry ex:tf-su1, ex:tf-su2, ex:tf-su3 ; cd:authoredResource true .
  ex:tf-su1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Counts and individual results"@en ; cd:body "Binomial: success counts in independent equal-probability yes/no trials. Normal: additive fluctuations of individual results under suitable conditions. Lognormal: a parallel branch obtained by exponentiating normal log ratios, motivated by multiplicative effects."@en ; cd:authoredResource true .
  ex:tf-su2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Estimated spread and estimated means"@en ; cd:body "Chi-square: scaled sample variance under iid normal sampling. Student t: a normal mean departure divided by an independent estimated-SE factor. F: a ratio of independent chi-square quantities normalized by their df, used for variance and nested-model comparisons."@en ; cd:authoredResource true .
  ex:tf-su3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "From describing results to inference"@en ; cd:body "Distributions describe not only chemical measurement variation, but also the sampling variation of our estimates and decision statistics. The mathematical links do not replace checking the experiment's assumptions. Next, examine model checks and finish with the live dilution Monte Carlo case."@en ; cd:authoredResource true .
}
