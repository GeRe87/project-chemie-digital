<https://w3id.org/project-chemie-digital/graph/knowledge/talks-ted-calibration> {
  ex:ted-calibration-time a cd:Concept ; skos:prefLabel "Calibration still consumes the day"@en ;
    cd:hasDefinition ex:ted-calibration-time-definition ; cd:hasSource ex:ted-source-workshop-calibration ; cd:authoredResource true .
  ex:ted-calibration-time-definition a cd:Definition ;
    cd:body "The supplied workshop alternates five calibration standards and five blanks, using its optimized TGA schedule. The TGA starts every 50 minutes; GC-MS starts at minute 20 and then every 53 minutes, with a 53-minute sequence. The tenth run ends at minute 550, or 9 hours 10 minutes. This is an authored schedule model, not a new throughput measurement or a universal calibration protocol. Blanks are retained; calibration cannot be treated as free overhead."@en ;
    cd:hasSource ex:ted-source-workshop-calibration ; cd:authoredResource true .
  ex:ted-running-calibration a cd:Concept ; skos:prefLabel "Balanced running calibration"@en ;
    cd:hasDefinition ex:ted-running-calibration-definition ; cd:hasSource ex:ted-source-workshop-calibration, ex:ted-source-calibration-pairs ; cd:authoredResource true .
  ex:ted-running-calibration-definition a cd:Definition ;
    cd:body "The supplied workshop orders 44 SBR calibrants into five near-equal-size mass strata containing 9, 9, 9, 9 and 8 records, cycling through these strata to balance the displayed mass coverage. This is a demonstration order, not acquisition chronology. Explicit windows show five calibrants, fifteen calibrants, and a fifteen-calibrant window shifted by one five-point cycle. Each window is fitted by ordinary least squares of peak area on calibrant mass. For each member, a separate line fitted without that member predicts its mass from its held-out peak area; the plot shows absolute mass errors and their mean in micrograms. This is internal leave-one-out checking, not independent validation, a prediction interval or proof of drift correction. A balanced mass range does not establish temporal representativeness, matrix equivalence or permission to omit blanks. The old talk's fixed-t confidence-band approximation, endless wraparound animation and raw-peak panels are not imported. The supplied paired mass/area data are retained without file names or acquisition dates in the public transport."@en ;
    cd:hasSource ex:ted-source-workshop-calibration, ex:ted-source-calibration-pairs ; cd:authoredResource true .
  ex:ted-calibration-time-points a cd:Interpretation ; cd:body "Calibration remains a time bottleneck."@en ; cd:hasKeyPoint ex:ted-cal-time-p1, ex:ted-cal-time-p2, ex:ted-cal-time-p3 ; cd:authoredResource true .
  ex:ted-cal-time-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**5 standards + 5 blanks**"@en ; cd:authoredResource true .
  ex:ted-cal-time-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**550 min:** 9 h 10 min"@en ; cd:authoredResource true .
  ex:ted-cal-time-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Even with the optimized schedule=="@en ; cd:authoredResource true .
  ex:ted-running-points a cd:Interpretation ; cd:body "Balance, update and check calibration windows."@en ; cd:hasKeyPoint ex:ted-running-p1, ex:ted-running-p2, ex:ted-running-p3 ; cd:authoredResource true .
  ex:ted-running-p1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Cover** the mass range"@en ; cd:authoredResource true .
  ex:ted-running-p2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Update:** oldest out, newest in"@en ; cd:authoredResource true .
  ex:ted-running-p3 a cd:KeyPoint ; cd:position 3 ; cd:body "==Check held-out prediction, not only fit=="@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/sources/talks-ted-calibration> {
  ex:ted-source-workshop-calibration a cd:Source ; dct:title "Renner workshop microplastics: calibration overhead and balanced running regression" ; dct:creator "Gerrit Renner" ;
    dct:identifier "renner_workshop_microplastics.html#bridge-slide-time; #running-regression; renderBridgeCalibrationGantt; balanceCalibrationOrder; fitLinearRegression; computeMeanLooPredictionError" ;
    dct:hasVersion "sha256:29cfc1ceeadcd3a870ad2ca41ef6930ec2ce537dc8297dca5f07407a5c23472f" ;
    dct:description "Author-supplied earlier HTML. Timings and method narrative are transcribed into RDF, not copied as executable slide code. The confidence-band shortcut and scientific claims about neighboring-session uncertainty are not adopted."@en ;
    cd:supportsResource ex:ted-calibration-time-definition, ex:ted-running-calibration-definition ; cd:authoredResource true .
  ex:ted-source-calibration-pairs a cd:Source ; dct:title "Author-supplied SBR calibration peak table" ; dct:creator "Gerrit Renner" ;
    dct:identifier "sbr_mz104_peak_table.csv; columns mass_ug and area; 44 data records" ;
    dct:hasVersion "sha256:772240ea48f349f0089faae3ca9bb465744a0f51afc1a43694ee1815b7cf3f3c" ;
    dct:description "Mass is given in micrograms by the column name; peak-area physical units are not specified and remain source units. All 44 paired values are retained; display order follows the workshop's five-stratum balancing algorithm. Source row identifiers allow audit without disclosing original file names or dates. No synthetic calibration values, confidence bands or external-validation results are substituted."@en ;
    cd:supportsResource ex:ted-calibration-pairs, ex:ted-running-calibration-definition ; cd:authoredResource true .
}

