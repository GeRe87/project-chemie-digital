<https://w3id.org/project-chemie-digital/graph/knowledge/level5-lognormal-workup-visuals> {
  ex:lg-process-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-lognormal-workup-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Two distinct repeat experiments for an organic trace analyte in ng/L by LC-MS/MS. A reinjects one already prepared homogeneous control solution. B splits a homogeneous water sample into independent aliquots, each undergoing extraction, concentration and instrumental analysis. Relative influences in B motivate a multiplicative candidate model but do not prove lognormality."@en ; cd:authoredResource true .
  ex:lg-scales-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-lognormal-ratio-scales.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Concentrations 8, 10 and 12.5 ng/L on a linear axis have gaps 2 and 2.5 ng/L. On a natural-log-ratio axis relative to 10 ng/L they lie at minus 0.22314, zero and plus 0.22314, with equal gaps. Reciprocal factors 0.8 and 1.25 become opposite additive log steps."@en ; cd:authoredResource true .
  ex:lg-table a cd:TableDefinition ; skos:prefLabel "Illustrative ng/L results: unpaired columns; B sorted, not time order"@en ; dct:references ex:lg-example-a, ex:lg-example-b ; cd:hasTableColumn ex:lg-tca, ex:lg-tcb ; cd:hasTableRow ex:lg-tr01, ex:lg-tr02, ex:lg-tr03, ex:lg-tr04, ex:lg-tr05, ex:lg-tr06, ex:lg-tr07, ex:lg-tr08, ex:lg-tr09, ex:lg-tr10 ; cd:authoredResource true .
