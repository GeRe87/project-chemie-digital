@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# Semantic teaching resources only. Existing renderer rules compose the views.
<https://w3id.org/project-chemie-digital/graph/specifications/level4-order-teaching> {
  ex:l4-range-title a cd:Interpretation ; skos:prefLabel "Range: the span of the observations"@en ; cd:authoredResource true .
  ex:l4-range-example-title a cd:Interpretation ; skos:prefLabel "Range: one value changes the span"@en ; cd:authoredResource true .
  ex:l4-quartiles-title a cd:Interpretation ; skos:prefLabel "Quartiles: three landmarks in ordered data"@en ; cd:authoredResource true .
  ex:l4-quartiles-example-title a cd:Interpretation ; skos:prefLabel "Quartiles: the same landmarks, different extremes"@en ; cd:authoredResource true .
  ex:l4-quantiles-title a cd:Interpretation ; skos:prefLabel "Quantiles: choose any probability"@en ; cd:authoredResource true .
  ex:l4-quantiles-example-title a cd:Interpretation ; skos:prefLabel "Quantiles: look further into the upper tail"@en ; cd:authoredResource true .
  ex:l4-iqr-title a cd:Interpretation ; skos:prefLabel "IQR: the distance between the outer quartiles"@en ; cd:authoredResource true .
  ex:l4-iqr-example-title a cd:Interpretation ; skos:prefLabel "IQR: unchanged here, despite a larger range"@en ; cd:authoredResource true .
  ex:l4-mad-title a cd:Interpretation ; skos:prefLabel "MAD: a median of absolute deviations"@en ; cd:authoredResource true .
  ex:l4-mad-example-title a cd:Interpretation ; skos:prefLabel "MAD: sort the distances, then take their median"@en ; cd:authoredResource true .
  ex:l4-box-construction-title a cd:Interpretation ; skos:prefLabel "Boxplots: construct and read the summary"@en ; cd:authoredResource true .
  ex:l4-box-example-title a cd:Interpretation ; skos:prefLabel "Boxplots: the same box, a different whisker"@en ; cd:authoredResource true .
  ex:l4-box-lab-title a cd:Interpretation ; skos:prefLabel "R lab: build and inspect a ggplot2 boxplot"@en ; cd:authoredResource true .

  # Authored symbol/meaning legends reuse the formula-deck composition from Variance.
  ex:l4-formula-range dct:hasPart ex:l4-range-legend .
  ex:l4-formula-quartile-positions dct:hasPart ex:l4-quartiles-legend .
  ex:l4-formula-quantile-interpolation dct:hasPart ex:l4-quantiles-legend .
  ex:l4-formula-interquartile-range dct:hasPart ex:l4-iqr-legend .
  ex:l4-formula-median-absolute-deviation dct:hasPart ex:l4-mad-legend .
  ex:l4-range-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-range-symbols ; cd:authoredResource true .
  ex:l4-range-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Order first"@en ; cd:body "x₍₁₎ is the minimum; x₍ₙ₎ is the maximum. R is a width, not the endpoint pair returned by R's range(x)."@en ; dct:references ex:order-statistic ; cd:authoredResource true .
  ex:l4-quartiles-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-quartiles-symbols ; cd:authoredResource true .
  ex:l4-quartiles-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Quarter, half, three quarters"@en ; cd:body "Q₁, Q₂ and Q₃ are the lower quartile, sample median and upper quartile. Q̂(p) is the linearly interpolated sample quantile at cumulative proportion p. The fractions 0.25, 0.50 and 0.75 are unitless; all quantile values have the measurement unit."@en ; dct:references ex:sample-quantile-type-7, ex:median ; cd:authoredResource true .
  ex:l4-quantiles-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-quantiles-symbols ; cd:authoredResource true .
  ex:l4-quantiles-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Interpolate between adjacent ranks"@en ; cd:body "p: unitless cumulative proportion; n: number of observations; h: fractional rank; floor(h): round h down to integer j; d: unitless interpolation weight h−j. x₍ⱼ₎ and x₍ⱼ₊₁₎ are adjacent ordered values; Q̂(p) is their weighted average, in the measurement unit. The factors 1−d and d sum to one. The displayed interior case requires n≥2 and p<1; at p=1 return the maximum, and for n=1 return the sole observation."@en ; dct:references ex:sample-quantile-type-7, ex:order-statistic ; cd:authoredResource true .
  ex:l4-iqr-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-iqr-symbols ; cd:authoredResource true .
  ex:l4-iqr-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "A width in the original unit"@en ; cd:body "x₁,…,xₙ: observed values; n≥1: sample size. Q̂(p): linearly interpolated sample quantile at unitless proportion p. Subtract the lower quartile at 0.25 from the upper quartile at 0.75. IQR is this central width in the measurement unit, not the entire observed range."@en ; dct:references ex:quartile ; cd:authoredResource true .
  ex:l4-mad-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-mad-symbols ; cd:authoredResource true .
  ex:l4-mad-symbols a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Two median operations"@en ; cd:body "First find the sample median; then find the median of all absolute distances to it. No squaring and no averaging of these distances."@en ; dct:references ex:median ; cd:authoredResource true .

  ex:l4-range-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-range-k1, ex:l4-range-k2 ; cd:authoredResource true .
  ex:l4-range-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "**Only the extrema matter**, not the arrangement between them."@en ; cd:authoredResource true .
  ex:l4-range-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "One extreme value can change it strongly. Consider sample size and context."@en ; cd:authoredResource true .
  ex:l4-quartiles-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-quartiles-k1, ex:l4-quartiles-k2 ; cd:authoredResource true .
  ex:l4-quartiles-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Quartiles locate positions in ordered data; they are **not distances**."@en ; cd:authoredResource true .
  ex:l4-quartiles-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "**Ties and interpolation:** the four parts need not contain exactly 25% each."@en ; cd:authoredResource true .
  ex:l4-quantiles-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-quantiles-k1, ex:l4-quantiles-k2 ; cd:authoredResource true .
  ex:l4-quantiles-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "The 90th percentile uses **p=0.90**, not p=90. Quartiles are special quantiles."@en ; cd:authoredResource true .
  ex:l4-quantiles-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Declare the method: interpolated quantiles need not be observed values."@en ; cd:authoredResource true .
  ex:l4-iqr-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-iqr-k1, ex:l4-iqr-k2 ; cd:authoredResource true .
  ex:l4-iqr-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Less sensitive to some tail changes than range or SD; **not immune**."@en ; cd:authoredResource true .
  ex:l4-iqr-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Same unit as SD, but not interchangeable with it or a confidence interval."@en ; cd:authoredResource true .
  ex:l4-mad-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-mad-k1, ex:l4-mad-k2 ; cd:authoredResource true .
  ex:l4-mad-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "R: **mad(x, constant=1)** is raw; the default scales by **1.4826**."@en ; cd:authoredResource true .
  ex:l4-mad-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "Ties can make raw MAD zero even when observations are not all equal."@en ; cd:authoredResource true .

  # All hand examples reuse the same existing canonical QC observations, not copied datasets.
  ex:l4-order-dots cd:yAxisMinimum "0"^^xsd:decimal .
  ex:l4-order-boxes-one cd:yAxisMinimum "0"^^xsd:decimal .
  ex:l4-order-boxes cd:yAxisMinimum "0"^^xsd:decimal .
  ex:l4-order-group-reference a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Reference"@en ; cd:usesDataset ex:l4-qc-reference ; cd:authoredResource true .
  ex:l4-order-group-modified a cd:ChartGroup ; cd:position 2 ; skos:prefLabel "Modified"@en ; cd:usesDataset ex:l4-qc-extreme ; cd:authoredResource true .
  ex:l4-order-dots a cd:ChartDefinition ; cd:chartType cd:DotPlot ; skos:prefLabel "Same seven observations, one changed endpoint"@en ; cd:body "Synthetic concentrations: reference 2, 4, 4, 5, 5, 6, 7; modified 2, 4, 4, 5, 5, 6, 30 mg/L. Every point is retained."@en ; cd:xAxisLabel "Series"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:hasChartGroup ex:l4-order-group-reference, ex:l4-order-group-modified ; cd:authoredResource true .
  ex:l4-order-box-reference a cd:ChartGroup ; cd:position 1 ; skos:prefLabel "Reference"@en ; cd:usesDataset ex:l4-qc-reference ; cd:authoredResource true .
  ex:l4-order-boxes-one a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "Construct the reference boxplot"@en ; cd:body "Linearly interpolated quartiles; 1.5 × IQR fences. Median line, quartile box, observed whisker endpoints. No confidence interval is shown."@en ; cd:xAxisLabel "Synthetic series"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:hasChartGroup ex:l4-order-box-reference ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier "1.5"^^xsd:decimal ; cd:authoredResource true .
  ex:l4-order-boxes a cd:ChartDefinition ; cd:chartType cd:BoxPlot ; skos:prefLabel "Same quartile box, different tail observations"@en ; cd:body "Linearly interpolated quartiles; 1.5 × IQR fences. The modified upper whisker ends at 6, not the fence 7.75 mg/L. The point at 30 is retained and flagged."@en ; cd:xAxisLabel "Synthetic series"@en ; cd:yAxisLabel "Concentration"@en ; cd:yAxisUnit "mg/L" ; cd:hasChartGroup ex:l4-order-group-reference, ex:l4-order-group-modified ; cd:dependsOn ex:sample-quantile-type-7 ; cd:fenceMultiplier "1.5"^^xsd:decimal ; cd:authoredResource true .

  ex:l4-range-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-range-scenario-card ; cd:authoredResource true .
  ex:l4-range-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: change only the maximum"@en ; cd:body "• Both synthetic series contain **seven values**.\n• Replace only **7 by 30 mg/L**.\n• How does the observed span respond?"@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-quartiles-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-quartiles-scenario-card ; cd:authoredResource true .
  ex:l4-quartiles-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: inspect ranks, not extrema"@en ; cd:body "• Use the same two **ordered** QC series.\n• For n=7, interpolation ranks are **2.5, 4 and 5.5**.\n• Interpolate adjacent values when needed."@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-quantiles-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-quantiles-scenario-card ; cd:authoredResource true .
  ex:l4-quantiles-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: compare the 90th percentiles"@en ; cd:body "• Linear interpolation at p=0.9 gives **h=6.4**.\n• Take **0.6 × rank 6 + 0.4 × rank 7**.\n• Now the changed final value matters."@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-iqr-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-iqr-scenario-card ; cd:authoredResource true .
  ex:l4-iqr-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: focus on the central spread"@en ; cd:body "• Both have **Q₁=4 and Q₃=5.5 mg/L**.\n• Subtract the **linearly interpolated quartiles**.\n• Compare with the ranges 5 and 28 mg/L."@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-mad-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-mad-scenario-card ; cd:authoredResource true .
  ex:l4-mad-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: measure distances to the median"@en ; cd:body "• Both sample medians are **5 mg/L**.\n• Compute every **absolute deviation**.\n• Sort those distances and take rank **4 of 7**."@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .
  ex:l4-box-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-box-scenario-card ; cd:authoredResource true .
  ex:l4-box-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Construction: declare the convention first"@en ; cd:body "Reference: **2,4,4,5,5,6,7 mg/L**.\n\n- **Quartiles:** use linear interpolation.\n- **Fences:** Q₁−1.5 IQR and Q₃+1.5 IQR.\n- **Whiskers:** last observed values inside.\n\n==Whiskers end at observations, not fences.=="@en ; dct:source ex:l4-qc-reference, ex:l4-formula-outlier-fence ; cd:authoredResource true .
  ex:l4-box-example-scenario a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-box-example-scenario-card ; cd:authoredResource true .
  ex:l4-box-example-scenario-card a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Scenario: read box, whiskers and flagged points"@en ; cd:body "• The same change: **7 → 30 mg/L**.\n• Quartiles and fences remain unchanged here.\n• Is the upper whisker now at **30, 7.75 or 6**?"@en ; dct:source ex:l4-qc-example ; cd:authoredResource true .

  ex:l4-range-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-range-example-k ; cd:authoredResource true .
  ex:l4-range-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "The range rises from **5 to 28 mg/L**, although six observations do not change. It tells us nothing about their arrangement."@en ; cd:authoredResource true .
  ex:l4-quartiles-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-quartiles-example-k ; cd:authoredResource true .
  ex:l4-quartiles-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "All three quartiles are **unchanged in this example**. That does not make the samples identical or quartiles immune to all changes."@en ; cd:authoredResource true .
  ex:l4-quantiles-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-quantiles-example-k ; cd:authoredResource true .
  ex:l4-quantiles-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "The **90th percentile changes** even though the median and quartiles agree. A few quantiles cannot determine the full distribution."@en ; cd:authoredResource true .
  ex:l4-iqr-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-iqr-example-k ; cd:authoredResource true .
  ex:l4-iqr-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "Both IQRs are **1.5 mg/L**: the central spread agrees while the tail changes. Retain a view of the individual observations."@en ; cd:authoredResource true .
  ex:l4-mad-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-mad-example-k ; cd:authoredResource true .
  ex:l4-mad-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "The fourth distance is **1 mg/L** in both samples. R's default mad(x) instead returns **1.4826 mg/L**; raw MAD needs constant=1."@en ; cd:authoredResource true .
  ex:l4-box-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-box-k1, ex:l4-box-k2 ; cd:authoredResource true .
  ex:l4-box-k1 a cd:KeyPoint ; cd:position 1 ; cd:body "Read **median → quartile box → whiskers → flagged points**. Box length shows IQR, not SD."@en ; cd:authoredResource true .
  ex:l4-box-k2 a cd:KeyPoint ; cd:position 2 ; cd:body "A boxplot does **not reveal modality**, sample size or every observation. Base R Tukey hinges can differ from ggplot2 quartiles."@en ; cd:authoredResource true .
  ex:l4-box-example-points a cd:Interpretation ; cd:hasKeyPoint ex:l4-box-example-k ; cd:authoredResource true .
  ex:l4-box-example-k a cd:KeyPoint ; cd:position 1 ; cd:body "The modified whisker ends at **6 mg/L**, not at the fence. **30 remains plotted** as a diagnostic flag, not an automatic error verdict."@en ; cd:authoredResource true .

  # The tables are authored semantic structures, never tab-separated code or renderer strings.
