  ex:l4-box-task a cd:Exercise ; cd:body "Synthetic recoveries: **50 preparations per group**.\n\n- [!] **Run:** compare methods, then matrices. Inspect **ggplot_build()**.\n- [!] **Change:** the final **110 to 140**. Predict box, whisker and flag first.\n- [?] **Explain:** why does the box stay unchanged?\n\n==A fence is not a whisker endpoint.== Flags do not remove observations.\n\nMay download ggplot2. Local execution; no learner-data upload."@en ; cd:hasCodeExample ex:l4-box-code ; cd:hasExpectedResult ex:l4-box-result ; cd:authoredResource true .
  ex:l4-box-result a cd:ExpectedResult ; cd:body "50 synthetic preparations per group. Linearly interpolated Q1/median/Q3 (%): A/matrix1=97.55/100/102.45, B/matrix1=90.2/100/109.8, A/matrix2=80.6/90.4/100.2. Whiskers: 95.1–104.9, 80.4–119.6, 70.8–110; no flags initially. For A/matrix2 the upper fence is 129.6%. Changing its final 110 to 140 leaves the box unchanged, moves the upper whisker to the observed 109.2% and flags 140%; the fence is not a whisker endpoint. Synthetic grids do not establish method superiority or a causal matrix effect. Package installation requires network access; desktop R needs ggplot2 installed."@en ; cd:authoredResource true .
  ex:l4-box-code a cd:CodeExample ; cd:programmingLanguage "r" ; cd:editable true ; cd:executable true ; cd:showsResource ex:boxplot, ex:l4-large-extract-a, ex:l4-large-extract-b, ex:l4-large-matrix, ex:l4-interpretation-ggplot-boxplot ; dct:hasPart ex:l4-box-functions ;
    cd:code "if (!requireNamespace(\"ggplot2\", quietly = TRUE)) {\n  if (requireNamespace(\"webr\", quietly = TRUE)) webr::install(\"ggplot2\")\n  else stop(\"Install ggplot2 first: install.packages('ggplot2')\")\n}\nlibrary(ggplot2)\ngroups <- c(\"A / matrix 1\", \"B / matrix 1\", \"A / matrix 2\")\nd <- data.frame(series = rep(groups, each = 50),\n  value = c(seq(95.1, by=0.2, length.out=50),\n            seq(80.4, by=0.8, length.out=50),\n            seq(70.8, by=0.8, length.out=50)))\nd$value[150] <- 110\nd$series <- factor(d$series, levels = groups)\np <- ggplot(d, aes(series, value)) +\n  geom_boxplot(coef = 1.5) +\n  labs(x = \"Synthetic extraction / matrix\", y = \"Recovery (%)\") +\n  theme_minimal(base_size = 16)\nprint(p)\nggplot_build(p)$data[[1]][c(\"lower\", \"middle\", \"upper\", \"ymin\", \"ymax\", \"outliers\")]" ; cd:authoredResource true .
  ex:l4-box-functions a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l4-box-fn1, ex:l4-box-fn2, ex:l4-box-fn3 ; cd:authoredResource true .
  ex:l4-box-fn1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "ggplot() + aes()"@en ; cd:body "Map the extraction/matrix group to x and recovery (%) to y."@en ; cd:authoredResource true .
  ex:l4-box-fn2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "geom_boxplot(coef=1.5)"@en ; cd:body "Use ggplot2's usual linearly interpolated quartiles and 1.5×IQR fences; flag rather than remove distant values."@en ; cd:authoredResource true .
  ex:l4-box-fn3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "ggplot_build(p)$data[[1]]"@en ; cd:body "Inspect the computed quartiles, whisker endpoints and separately plotted observations."@en ; cd:authoredResource true .
}
