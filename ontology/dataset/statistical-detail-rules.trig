@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/project-chemie-digital/graph/mathematics/rules> {
  ex:random-sample-variance-symbol a cd:MathSymbol ; cd:symbol "S²" ; cd:mathNotation "S^2" ; cd:body "The corrected sample variance statistic across hypothetical samples; lowercase s² is its realized value."@en ; cd:presentationDefinition "Corrected variance statistic; s² is its observed value."@en ; cd:authoredResource true .
  ex:rule-expectation-equality a cd:MathematicalRule ; skos:prefLabel "Expectation preserves equality"@en ; cd:ruleFormula ex:rule-expectation-equality-formula ; cd:requiresAssumption ex:assumption-integrable ; cd:body "If integrable random quantities agree with probability one, their expectations agree. Applying E does not require independence. An equality between expectations alone does not recover equality of the random quantities, so the displayed direction is an implication."@en ; cd:authoredResource true .
  ex:rule-expectation-equality-formula a cd:MathExpression ; cd:latex "U=V\\quad\\Longrightarrow\\quad\\operatorname{E}[U]=\\operatorname{E}[V]" ; cd:hasSymbol ex:rule-U-symbol, ex:rule-V-symbol, ex:vr-E-symbol ; cd:authoredResource true .
  ex:rule-abar-symbol a cd:MathSymbol ; cd:symbol "ā" ; cd:mathNotation "\\bar a" ; cd:body "Arithmetic mean of the same finite values a_i."@en ; cd:authoredResource true .
  ex:assumption-common-observation-moments a cd:Interpretation ; skos:prefLabel "Common mean and finite variance; fixed n ≥ 1"@en ; cd:body "For each i = 1, …, n, E[X_i] = μ and Var(X_i) = σ² < ∞. The positive integer n is fixed. Identical distribution is sufficient but equality of these moments is all that is needed here."@en ; cd:authoredResource true .
  ex:assumption-pairwise-uncorrelated a cd:Interpretation ; skos:prefLabel "Pairwise zero covariance"@en ; cd:body "Cov(X_i,X_j) = 0 for distinct indices. Independent finite-variance observations satisfy this condition; independence is sufficient, not necessary. Correlated observations require covariance terms."@en ; cd:authoredResource true .
  ex:assumption-independent-integrable a cd:Interpretation ; skos:prefLabel "Independent integrable random quantities"@en ; cd:body "U and V are independent with finite absolute first moments. Independence then also gives E[|UV|] = E[|U|]E[|V|] < ∞."@en ; cd:authoredResource true .
  ex:assumption-fitted-finite-center a cd:Interpretation ; skos:prefLabel "Arithmetic mean of the same n values"@en ; cd:body "n is a positive integer, ā = (1/n)Σa_i, and c is fixed with respect to the index. The identity holds deterministically for every finite realization."@en ; cd:authoredResource true .
  ex:rule-second-moment a cd:MathematicalRule ; skos:prefLabel "Second moment and variance"@en ; cd:ruleFormula ex:rule-second-moment-formula ; cd:requiresAssumption ex:assumption-second-moment ; dct:hasPart ex:rule-variance-definition, ex:rule-expectation-addition, ex:rule-expectation-factor ; cd:body "Expand E[(Y−E[Y])²] and use linearity. The middle term is −2(E[Y])² and the constant term is (E[Y])². Rearranging gives E[Y²] = Var(Y)+(E[Y])². A finite second moment is required; independence is not."@en ; cd:authoredResource true .
  ex:rule-second-moment-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[Y^2]=\\operatorname{Var}(Y)+(\\operatorname{E}[Y])^2" ; cd:hasSymbol ex:vr-E-symbol, ex:vm-var-symbol, ex:rule-Y-symbol ; cd:authoredResource true .
  ex:rule-independent-product a cd:MathematicalRule ; skos:prefLabel "Expectation of an independent product"@en ; cd:ruleFormula ex:rule-independent-product-formula ; cd:requiresAssumption ex:assumption-independent-integrable ; cd:body "For independent integrable quantities, the joint distribution factors and the expectation of the product is the product of the expectations. This is not linearity and is generally false for dependent quantities. The independence assumption also ensures integrability of the product under the stated finite absolute moments."@en ; cd:authoredResource true .
  ex:rule-independent-product-formula a cd:MathExpression ; cd:latex "\\operatorname{E}[UV]=\\operatorname{E}[U]\\operatorname{E}[V]" ; cd:hasSymbol ex:vr-E-symbol, ex:rule-U-symbol, ex:rule-V-symbol ; cd:authoredResource true .
  ex:rule-variance-uncorrelated-sum a cd:MathematicalRule ; skos:prefLabel "Variance of a pairwise uncorrelated sum"@en ; cd:ruleFormula ex:rule-variance-independent-sum-formula ; cd:requiresAssumption ex:assumption-second-moment, ex:assumption-pairwise-uncorrelated ; dct:hasPart ex:rule-variance-covariance ; cd:body "For a finite collection with finite second moments, the variance-covariance identity includes all pairwise cross covariances. When each is zero, only the individual variances remain. Independence is sufficient for this result but pairwise zero covariance is enough."@en ; cd:authoredResource true .
  ex:rule-mean-centered-squares a cd:MathematicalRule ; skos:prefLabel "Center squared distances at their arithmetic mean"@en ; cd:ruleFormula ex:rule-mean-centered-squares-formula ; cd:requiresAssumption ex:assumption-fitted-finite-center ; dct:hasPart ex:rule-binomial-square, ex:rule-sum-linearity, ex:rule-mean-definition ; cd:body "Expand each centered difference, distribute the finite sum, and use Σ(a_i−c) = n(ā−c). The two cross-term contributions combine with the last squared shift to leave one negative squared shift. The fitted mean removes a nonnegative term. This is an exact algebraic identity for each realization, not an expectation or an unbiasedness claim."@en ; cd:authoredResource true .
  ex:rule-mean-centered-squares-formula a cd:MathExpression ; cd:latex "\\begin{aligned}\\frac1n\\sum_i(a_i-\\bar a)^2&=\\frac1n\\sum_i(a_i-c)^2\\\\&\\quad-(\\bar a-c)^2\\end{aligned}" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-abar-symbol, ex:rule-c-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-fixed-center-sum a cd:MathematicalRule ; skos:prefLabel "Sum distances from a fixed center"@en ; cd:ruleFormula ex:rule-fixed-center-sum-formula ; cd:requiresAssumption ex:assumption-fitted-finite-center ; dct:hasPart ex:rule-subtract-constant-sum, ex:rule-mean-definition ; cd:body "Split the finite sum over subtraction, count c exactly n times, and substitute Σa_i = n ā. This needs the arithmetic mean of those same values and does not require probability assumptions."@en ; cd:authoredResource true .
  ex:rule-fixed-center-sum-formula a cd:MathExpression ; cd:latex "\\sum_{i=1}^n(a_i-c)=n(\\bar a-c)" ; cd:hasSymbol ex:rule-a-symbol, ex:rule-abar-symbol, ex:rule-c-symbol, ex:n-symbol, ex:vr-index-symbol, ex:v-sum-symbol ; cd:authoredResource true .
  ex:rule-substitute-and-factor a cd:MathematicalRule ; skos:prefLabel "Substitute and factor the fixed count"@en ; cd:ruleFormula ex:rule-factor-shortfall-formula ; cd:requiresAssumption ex:assumption-finite-sum ; dct:hasPart ex:rule-substitute-equality, ex:rule-factor-shortfall ; cd:body "Insert an already established equality into the expression, then factor the common value. The statistical premises of the inserted result remain necessary; this algebra does not establish them."@en ; cd:authoredResource true .
}
