<https://w3id.org/project-chemie-digital/graph/knowledge/binary-outcomes> {
  ex:bernoulli-trial a cd:Concept ; skos:prefLabel "Bernoulli trial"@en ; cd:hasDefinition ex:bernoulli-trial-definition ; cd:authoredResource true .
  ex:bernoulli-trial-definition a cd:Definition ; cd:body "A Bernoulli trial has two clearly defined outcomes, coded as success (1) and failure (0). Success names the event being counted, not a favourable scientific outcome. The sum of a fixed number of independent Bernoulli trials with the same success probability follows a binomial model. An individual outcome sequence and its success count are different objects."@en ; cd:hasSource ex:l5-source-r-binomial ; cd:authoredResource true .
  ex:binary-analytical-finding a cd:Concept ; skos:prefLabel "Binary analytical result"@en ; cd:hasDefinition ex:binary-analytical-finding-definition ; cd:authoredResource true .
  ex:binary-analytical-finding-definition a cd:Definition ; cd:body "A positive or negative analytical result is a classification made using a predefined analytical procedure and decision rule. It is neither the concentration itself nor an infallible indicator of the true state. Without a model of misclassification, the probability of a positive result must not be equated with the true prevalence of contamination."@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/sources/binary-outcomes> {
  ex:l5-source-r-binomial a cd:Source ; dct:title "R stats: The Binomial Distribution" ; dct:creator "R Core Team" ; dct:identifier "l5-source-r-binomial" ; dct:source <https://stat.ethz.ch/R-manual/R-devel/library/stats/html/Binomial.html> ; cd:supportsResource ex:bernoulli-trial-definition ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/specifications/level5-binomial-opening> {
  # Local authoring only. The accepted course offering is unchanged.
  ex:offering-level5-binomial-preview a cd:TeachingOffering ; skos:prefLabel "Level 5: local B01/B02 review"@en ; cd:hasUnitPlacement ex:placement-level5-binomial-preview .
  ex:unit-level5-probability-models a cd:LearningUnit ; skos:prefLabel "Probability Distributions"@en ; cd:hasFocusConcept ex:bernoulli-trial, ex:binary-analytical-finding .
  ex:placement-level5-binomial-preview a cd:UnitPlacement ; cd:position 60 ; cd:placesLearningUnit ex:unit-level5-probability-models .

  ex:l5-b01-title a cd:Interpretation ; skos:prefLabel "Investigate PFAS findings in a water body"@en ; cd:body "Use selected water samples to learn about positive-finding frequency in a defined target population, not concentration or true prevalence directly."@en ; dct:references ex:binary-analytical-finding-definition ; cd:authoredResource true .
  ex:l5-b02-title a cd:Interpretation ; skos:prefLabel "A sample survey gives one positive count"@en ; cd:body "Different samples can give different estimates of the same population finding frequency."@en ; dct:references ex:bernoulli-trial-definition ; cd:authoredResource true .

  ex:l5-b01-model a cd:BinaryExperiment ; skos:prefLabel "One binary PFAS screening result"@en ; cd:binaryExperimentMode "decision" ; cd:binaryTrialCount 1 ; cd:binaryPositiveProbability 0.2 ; cd:binarySeed 20261030 ; cd:binaryPositiveLabel "positive"@en ; cd:binaryNegativeLabel "negative"@en ; cd:binaryUnitLabel "Sample"@en ; cd:binaryTrialName "Bernoulli trial"@en ; dct:references ex:bernoulli-trial-definition, ex:binary-analytical-finding-definition ; cd:authoredResource true .
  ex:l5-b02-model a cd:BinaryExperiment ; skos:prefLabel "Ten independent modelled PFAS screening results"@en ; cd:binaryExperimentMode "series" ; cd:binaryTrialCount 10 ; cd:binaryPositiveProbability 0.2 ; cd:binarySeed 20261030 ; cd:binaryPositiveLabel "positive"@en ; cd:binaryNegativeLabel "negative"@en ; cd:binaryUnitLabel "Sample"@en ; cd:binaryTrialName "Bernoulli trial"@en ; dct:references ex:bernoulli-trial-definition, ex:binary-analytical-finding-definition ; cd:authoredResource true .

  ex:l5-b01-flow a cd:FlowDiagram ; skos:prefLabel "From a selected water sample to a binary decision"@en ; cd:body "Selected samples inform positive-finding frequency in a defined water population. A screening classification is not a concentration or an infallible true state."@en ; cd:hasBinaryExperiment ex:l5-b01-model ; cd:hasDiagramNode ex:l5-b01-sample, ex:l5-b01-decision ; cd:hasDiagramEdge ex:l5-b01-edge ; cd:authoredResource true .
  ex:l5-b01-sample a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Water sample · PFAS screening"@en ; cd:authoredResource true .
  ex:l5-b01-decision a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Screening classification"@en ; cd:body "Two outcomes: positive or negative result. Codes: 1 and 0. Bernoulli trial."@en ; cd:authoredResource true .
  ex:l5-b01-edge a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:l5-b01-sample ; cd:targetNode ex:l5-b01-decision ; skos:prefLabel "one predefined classification decision per sample"@en ; cd:authoredResource true .

  ex:l5-b02-flow a cd:FlowDiagram ; skos:prefLabel "Outcome sequences and collected success counts"@en ; cd:body "Teaching model: ten independent water samples, one decision each, with a constant 20% positive-result probability. Same population and stable conditions; not a measured PFAS rate."@en ; cd:hasBinaryExperiment ex:l5-b02-model ; cd:hasDiagramNode ex:l5-b02-samples, ex:l5-b02-count ; cd:hasDiagramEdge ex:l5-b02-edge ; cd:authoredResource true .
  ex:l5-b02-samples a cd:DiagramNode ; cd:position 1 ; skos:prefLabel "Ten independently selected samples"@en ; cd:authoredResource true .
  ex:l5-b02-count a cd:DiagramNode ; cd:position 2 ; skos:prefLabel "Number of positive results per series"@en ; cd:body "Possible counts: 0 to 10. The average across many series does not guarantee a particular count in one series."@en ; cd:authoredResource true .
  ex:l5-b02-edge a cd:DiagramEdge ; cd:position 1 ; cd:sourceNode ex:l5-b02-samples ; cd:targetNode ex:l5-b02-count ; skos:prefLabel "count the outcomes and collect exactly one count per series"@en ; cd:authoredResource true .
}
