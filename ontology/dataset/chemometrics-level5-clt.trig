<https://w3id.org/project-chemie-digital/graph/knowledge/level5-clt> {
  ex:central-limit-theorem a cd:Concept ; skos:prefLabel "Central limit theorem for sample means"@en ; cd:hasDefinition ex:l5-clt-definition ; cd:authoredResource true .
  ex:l5-clt-definition a cd:Definition ; cd:body "For independent identically distributed random variables with finite mean and finite positive variance, the standardized sample mean converges in distribution to standard normal as sample size increases. The mean and variance identities for a sample mean are exact under the stated assumptions, not asymptotic approximations. The theorem does not change the individual population or supply a universal sample-size threshold."@en ; cd:authoredResource true .
  ex:l5-c14a-formula a cd:MathExpression ; cd:formulaLabel "Exact relationships before any approximation"@en ; cd:body "The expectation of the sample mean is mu. Its variance is sigma squared divided by n; its standard deviation is sigma divided by the square root of n. These are exact under the stated independent identical-distribution assumptions."@en ; cd:latex "\\begin{gathered}E[\\bar X_n]=\\mu\\\\\\operatorname{Var}(\\bar X_n)=\\frac{\\sigma^2}{n}\\\\\\operatorname{SD}(\\bar X_n)=\\frac{\\sigma}{\\sqrt n}\\end{gathered}" ; dct:hasPart ex:l5-c14a-legend ; cd:hasSymbol ex:l5-c14a-mean, ex:l5-c14a-parameters, ex:l5-c14a-functions, ex:l5-c14a-operators ; cd:authoredResource true .
  ex:l5-c14a-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-c14a-entry ; cd:authoredResource true .
  ex:l5-c14a-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols, units and assumptions"@en ; dct:references ex:l5-c14a-mean, ex:l5-c14a-parameters, ex:l5-c14a-functions, ex:l5-c14a-operators ; cd:authoredResource true .
  ex:l5-c14a-mean a cd:MathSymbol ; cd:symbol "sample mean and size" ; cd:mathNotation "\\bar X_n,\\ n" ; cd:body "Random arithmetic mean of n independent, identically distributed individuals. Subscript n is sample size, a positive integer, not a repeat index."@en ; cd:authoredResource true .
  ex:l5-c14a-parameters a cd:MathSymbol ; cd:symbol "mu and sigma" ; cd:mathNotation "\\mu,\\ \\sigma,\\ \\sigma^2" ; cd:body "Individual population mean 10 and SD 9 mg/L here. Squared sigma is finite variance, in (mg/L) squared; it is not variance of the means."@en ; cd:authoredResource true .
  ex:l5-c14a-functions a cd:MathSymbol ; cd:symbol "E, Var and SD" ; cd:mathNotation "E,\\ \\operatorname{Var},\\ \\operatorname{SD}" ; cd:body "Expectation, variance and standard deviation of the sample mean. Mean and SD retain mg/L; variance has squared concentration units."@en ; cd:authoredResource true .
  ex:l5-c14a-operators a cd:MathSymbol ; cd:symbol "equality, division and root" ; cd:mathNotation "=,\\ /,\\ \\sqrt n" ; cd:body "Equalities are exact, not CLT approximations. Divide by sample size for variance and by its positive square root for SD."@en ; cd:authoredResource true .
  ex:l5-c14d-formula a cd:MathExpression ; cd:formulaLabel "Convergence in distribution, not exact finite-sample normality"@en ; cd:body "The square root of n times the sample mean minus mu, divided by sigma, converges in distribution to standard normal as n increases."@en ; cd:latex "\\frac{\\sqrt n(\\bar X_n-\\mu)}{\\sigma}\\xrightarrow{\\mathcal D}\\mathcal N(0,1)" ; dct:hasPart ex:l5-c14d-legend ; cd:hasSymbol ex:l5-c14d-mean, ex:l5-c14d-parameters, ex:l5-c14d-standard, ex:l5-c14d-limit ; cd:authoredResource true .
  ex:l5-c14d-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-c14d-entry ; cd:authoredResource true .
  ex:l5-c14d-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Symbols and limiting statement"@en ; dct:references ex:l5-c14d-mean, ex:l5-c14d-parameters, ex:l5-c14d-standard, ex:l5-c14d-limit ; cd:authoredResource true .
  ex:l5-c14d-mean a cd:MathSymbol ; cd:symbol "mean and sample size" ; cd:mathNotation "\\bar X_n,\\ n" ; cd:body "Random mean of n independent identically distributed individuals. The positive integer subscript n grows in the limit; the plot uses n = 64."@en ; cd:authoredResource true .
  ex:l5-c14d-parameters a cd:MathSymbol ; cd:symbol "population parameters" ; cd:mathNotation "\\mu,\\ \\sigma" ; cd:body "Finite individual mean and positive finite SD. Here 10 and 9 mg/L. The denominator is population SD, not an estimated sample SD."@en ; cd:authoredResource true .
  ex:l5-c14d-standard a cd:MathSymbol ; cd:symbol "centering and scaling" ; cd:mathNotation "\\sqrt n(\\bar X_n-\\mu)/\\sigma" ; cd:body "Subtract the mean, multiply by the positive square root of n, divide by SD. Units cancel: standardized means are dimensionless."@en ; cd:authoredResource true .
  ex:l5-c14d-limit a cd:MathSymbol ; cd:symbol "distributional limit" ; cd:mathNotation "\\xrightarrow{\\mathcal D},\\ \\mathcal N(0,1)" ; cd:body "Arrow D means convergence in distribution as n increases. The limit is normal with mean 0 and variance 1, not an exact identity at n = 64."@en ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/specifications/level5-clt> {
  ex:unit-level5-probability-models cd:hasFocusConcept ex:central-limit-theorem .
  ex:l5-c14a-title a cd:Interpretation ; skos:prefLabel "Larger samples can improve estimate precision"@en ; cd:authoredResource true .
  ex:l5-c14b-title a cd:Interpretation ; skos:prefLabel "One or four environmental units per sample"@en ; cd:authoredResource true .
  ex:l5-c14c-title a cd:Interpretation ; skos:prefLabel "Sixteen or sixty-four units: less variation"@en ; cd:authoredResource true .
  ex:l5-c14d-title a cd:Interpretation ; skos:prefLabel "A reference for standardized estimation error"@en ; cd:authoredResource true .
  ex:l5-c14e-title a cd:Interpretation ; skos:prefLabel "Precision does not create representativeness"@en ; cd:authoredResource true .
  ex:l5-c14a-chart a cd:ChartDefinition ; skos:prefLabel "Theoretical SD of sample means"@en ; cd:body "Sample sizes 1, 4, 16, 64 give SDs 9, 4.5, 2.25, 1.125 mg/L. Exact model values, not simulated estimates."@en ; cd:chartType cd:BarChart ; cd:chartPresentation "complete" ; cd:usesDataset ex:l5-c14-sd-values ; cd:xAxisLabel "Sample size"@en ; cd:yAxisLabel "SD of means"@en ; cd:yAxisUnit "mg/L" ; cd:authoredResource true .
  ex:l5-c14-sd-values a cd:Dataset ; skos:prefLabel "Exact SD values for the C13 population"@en ; cd:derivedFromResource ex:l5-c14a-formula ; cd:hasObservation ex:l5-c14-sd1, ex:l5-c14-sd4, ex:l5-c14-sd16, ex:l5-c14-sd64 ; cd:authoredResource true .
  ex:l5-c14-sd1 a cd:Observation ; cd:position 1 ; skos:prefLabel "1"@en ; cd:numericValue 9.0 ; cd:authoredResource true .
  ex:l5-c14-sd4 a cd:Observation ; cd:position 2 ; skos:prefLabel "4"@en ; cd:numericValue 4.5 ; cd:authoredResource true .
  ex:l5-c14-sd16 a cd:Observation ; cd:position 3 ; skos:prefLabel "16"@en ; cd:numericValue 2.25 ; cd:authoredResource true .
  ex:l5-c14-sd64 a cd:Observation ; cd:position 4 ; skos:prefLabel "64"@en ; cd:numericValue 1.125 ; cd:authoredResource true .
  ex:l5-c14b-context a cd:Interpretation ; cd:body "More values per sample narrow the distribution of means, not the original population."@en ; cd:authoredResource true .
  ex:l5-c14c-context a cd:Interpretation ; cd:body "Means concentrate near 10 mg/L. Larger samples do not change individual concentrations."@en ; cd:authoredResource true .
  ex:l5-c14b-chart a cd:ChartDefinition ; skos:prefLabel "Frequency polygons: sample sizes 1 and 4"@en ; cd:body "Polygons of 5,000 means: solid 1, dashed 4. Window 0–40 mg/L; outside: 80 and 0. No renormalization."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.38 ; cd:xAxisLabel "Mean concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-c14-poly1 ; dct:hasPart ex:l5-c14-poly4 ; cd:authoredResource true .
  ex:l5-c14c-chart a cd:ChartDefinition ; skos:prefLabel "Frequency polygons: sample sizes 16 and 64"@en ; cd:body "Polygons of 5,000 means: solid 16, dashed 64. Same 0–40 mg/L and density scale. All means shown."@en ; cd:chartType cd:LineChart ; cd:chartPresentation "complete" ; cd:lineInterpolation "linear" ; cd:showChartPoints false ; cd:chartYMinimum 0.0 ; cd:chartYMaximum 0.38 ; cd:xAxisLabel "Mean concentration"@en ; cd:xAxisUnit "mg/L" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "L/mg" ; cd:usesDataset ex:l5-c14-poly16 ; dct:hasPart ex:l5-c14-poly64 ; cd:authoredResource true .
  ex:l5-c14d-chart a cd:ChartDefinition ; skos:prefLabel "5,000 standardized means at sample size 64"@en ; cd:body "Bars: all 5,000 standardized means of size 64. Line: standard normal reference, an approximation at this finite size. Both axes are dimensionless."@en ; cd:chartType cd:Histogram ; cd:histogramNormalization "density" ; cd:usesDataset ex:l5-c14-z-counts ; dct:hasPart ex:l5-c14-standard-normal ; cd:binEdges ex:l5-c14-ze0 ; cd:xAxisLabel "Standardized mean"@en ; cd:xAxisUnit "1" ; cd:yAxisLabel "Density"@en ; cd:yAxisUnit "1" ; cd:authoredResource true .
  ex:l5-c14e-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:l5-c14e-iid, ex:l5-c14e-variance, ex:l5-c14e-threshold, ex:l5-c14e-normal ; cd:authoredResource true .
  ex:l5-c14e-iid a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Check the sampling"@en ; cd:body "This version assumes independent, identically distributed values. Drift, dependence and changing populations need separate justification."@en ; cd:authoredResource true .
  ex:l5-c14e-variance a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Finite positive variance"@en ; cd:body "Heavy tails can slow convergence. Infinite variance is outside this theorem; more samples do not repair its assumptions."@en ; cd:authoredResource true .
  ex:l5-c14e-threshold a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "No universal size 30"@en ; cd:body "Approximation quality depends on the population and the probability of interest. Individuals do not become normal."@en ; cd:authoredResource true .
  ex:l5-c14e-normal a cd:DefinitionListEntry ; cd:position 4 ; skos:prefLabel "A stronger special case"@en ; cd:body "With independent normal individuals from the same population, the sample mean is exactly normal at every positive sample size."@en ; cd:authoredResource true .
  ex:l5-c14-protocol a cd:WorkedExample ; cd:bodyFormat "markdown" ; cd:body """Same lognormal population and Mulberry32/cosine Box-Muller algorithm as C13: individual mean 10 mg/L, SD 9 mg/L, reference 1 mg/L. Reset seed 20261031 for this separate comparison. Within this run one continuous stream supplies disjoint new samples for sizes 1, 4, 16 and 64 in that order, 5,000 samples each. The run does not reuse the C13 four-value collection. There are 425,000 individual draws, two uniforms per draw. Mathematical independence is a model assumption; the PRNG supplies reproducible approximation, not physical evidence.

```javascript
function comparison() {
  let state=20261031;
  function uniform(){state=(state+0x6d2b79f5)>>>0;let t=state;t=Math.imul(t^(t>>>15),t|1);t^=t+Math.imul(t^(t>>>7),t|61);return((t^(t>>>14))>>>0)/4294967296;}
  const v=Math.log1p(.81),m=Math.log(10)-v/2,s=Math.sqrt(v),groups=[];
  for(const n of [1,4,16,64]){
    const means=[],counts=Array(40).fill(0);let outside=0;
    for(let r=0;r<5000;r++){
      let sum=0;
      for(let i=0;i<n;i++)sum+=Math.exp(m+s*Math.sqrt(-2*Math.log(1-uniform()))*Math.cos(2*Math.PI*uniform()));
      const mean=sum/n;means.push(mean);
      if(mean<40)counts[Math.floor(mean)]++;else outside++;
    }
    groups.push({n,means,counts,outside});
  }
  const standardized=groups[3].means.map(x=>8*(x-10)/9),zCounts=Array(24).fill(0);
  for(const z of standardized){if(z< -6||z>6)throw new Error("Standardized value outside bins");zCounts[Math.min(23,Math.floor((z+6)*2))]++;}
  return {groups,standardized,zCounts,m,s};
}
```

Raw-scale frequency polygons use heights count/5000 for width-one bins. The common display window is 0 to 40 mg/L. Outside counts are 80, 0, 0 and 0; those observations are retained by this protocol, not discarded from the simulation or removed from the density denominator. Vertices at bin midpoints join linearly, with the first/last bin height carried to the window boundary. Zero tail runs can be represented by their endpoints. These polygons are approximate displays, not fitted densities or exact probability integrals. The standardized histogram retains every size-64 mean in fixed width-0.5 bins from -6 to 6."""@en ; cd:authoredResource true .
}

<https://w3id.org/project-chemie-digital/graph/paths/level5-binomial-opening> {
  ex:path-level5-binomial-opening cd:forTopic ex:central-limit-theorem ; cd:hasStep ex:l5-c14a-step, ex:l5-c14b-step, ex:l5-c14c-step, ex:l5-c14d-step, ex:l5-c14e-step .
  ex:l5-c14a-step a cd:PathStep ; cd:position 37 ; cd:usesScene ex:l5-c14a-scene ; cd:usesResource ex:l5-c14a-title, ex:l5-c14a-chart, ex:l5-c14a-formula ; cd:authoredResource true .
  ex:l5-c14b-step a cd:PathStep ; cd:position 38 ; cd:usesScene ex:l5-c14b-scene ; cd:usesResource ex:l5-c14b-title, ex:l5-c14b-context, ex:l5-c14b-chart ; cd:authoredResource true .
  ex:l5-c14c-step a cd:PathStep ; cd:position 39 ; cd:usesScene ex:l5-c14c-scene ; cd:usesResource ex:l5-c14c-title, ex:l5-c14c-context, ex:l5-c14c-chart ; cd:authoredResource true .
  ex:l5-c14d-step a cd:PathStep ; cd:position 40 ; cd:usesScene ex:l5-c14d-scene ; cd:usesResource ex:l5-c14d-title, ex:l5-c14d-chart, ex:l5-c14d-formula ; cd:authoredResource true .
  ex:l5-c14e-step a cd:PathStep ; cd:position 41 ; cd:usesScene ex:l5-c14e-scene ; cd:usesResource ex:l5-c14e-title, ex:l5-c14e-cards ; cd:authoredResource true .
}
<https://w3id.org/project-chemie-digital/graph/scenes/level5-clt> {
  ex:l5-c14a-scene a cd:SceneDefinition ; cd:focusConcept ex:central-limit-theorem ; cd:hasSceneItem ex:l5-c14a-heading, ex:l5-c14a-plot, ex:l5-c14a-math ; cd:narration "C14a. Keep the C13 individual population with mean 10 and SD 9 mg/L. For independent identically distributed individuals with finite variance, the sample mean has exactly the same expectation and variance equal to individual variance divided by sample size. These are exact identities, not approximations justified by the CLT. Its theoretical SD is 9 divided by the square root of size: 9, 4.5, 2.25 and 1.125 mg/L for sizes one, four, sixteen and sixty-four. The chart shows these theoretical values, not estimates forced onto a simulation. Lower spread concerns sample means, not a change in the distribution of individual concentrations. The standard deviation of a sample mean is often called its standard error; estimating it from data is later work."@en ; cd:authoredResource true .
  ex:l5-c14b-scene a cd:SceneDefinition ; cd:focusConcept ex:central-limit-theorem ; cd:hasSceneItem ex:l5-c14b-heading, ex:l5-c14b-text, ex:l5-c14b-plot ; cd:narration "C14b. Compare frequency polygons from five thousand new samples at each size, using the same lognormal individual population and simulation algorithm. The solid curve is size one: its theoretical sampling distribution equals the individual population, though this finite simulated polygon is not the exact density. The dashed curve is size four and is narrower but still right-skewed. Each point is a width-one-bin count divided by all five thousand means, joined at bin midpoints. This is a frequency polygon, not a fitted smooth model. Both comparisons use the same concentration display window from zero to forty mg/L and the same vertical density range. Eighty of the five thousand size-one means lie above the displayed window; none of the size-four means do. Their values remain in the reproducible simulation, and density is not renormalized to the displayed subset. The population remains unchanged. Independent fresh samples for each size use disjoint sections of one seeded stream within this comparison; this is not reuse of the old C13 four-value samples."@en ; cd:authoredResource true .
  ex:l5-c14c-scene a cd:SceneDefinition ; cd:focusConcept ex:central-limit-theorem ; cd:hasSceneItem ex:l5-c14c-heading, ex:l5-c14c-text, ex:l5-c14c-plot ; cd:narration "C14c. The solid polygon now represents means from size-sixteen samples; the dashed one represents size sixty-four. Each uses five thousand independent model samples from new disjoint draws in the same comparison protocol. Keep the same zero-to-forty concentration window and zero-to-0.38 density range as the preceding comparison, with no hidden zoom. No means in either of these two simulated collections fall outside the window. They concentrate around 10 mg/L and their theoretical SDs are 2.25 and 1.125 mg/L. Their realized centers and SDs fluctuate; no sample mean or spread is forced to its theoretical value. These width-one frequency polygons approximate shape and can look angular at the narrower size. The individual population has not become normal. A normal-like appearance of means in one constructed model does not establish a universal sample size for every population or tail probability."@en ; cd:authoredResource true .
  ex:l5-c14d-scene a cd:SceneDefinition ; cd:focusConcept ex:central-limit-theorem ; cd:hasSceneItem ex:l5-c14d-heading, ex:l5-c14d-plot, ex:l5-c14d-math ; cd:narration "C14d. Standardize each size-sixty-four sample mean by subtracting the true population mean 10, multiplying by the square root of sixty-four, and dividing by the true individual SD 9. These constants are specified model parameters, not fitted to this histogram. The standardized quantity is dimensionless. All five thousand standardized means fall inside the displayed bins from minus six to six; none is excluded. The standard normal reference has mean zero and variance one and extends beyond the finite plot. The central limit theorem says convergence in distribution as sample size tends to infinity under independence, identical distributions, finite mean and finite positive variance. The plot is a finite-size comparison, not proof of equality with standard normal or of a universal error bound. It can retain skewness and tail differences even when its central shape looks close. The arrow refers to the sequence of distributions, not to each individual realization settling at zero."@en ; cd:authoredResource true .
  ex:l5-c14e-scene a cd:SceneDefinition ; cd:focusConcept ex:central-limit-theorem ; cd:hasSceneItem ex:l5-c14e-heading, ex:l5-c14e-list ; cd:narration "C14e. Keep the exact moment identities separate from asymptotic normal approximation. This iid version requires independent identically distributed individuals with finite positive variance. Correlation, drift or a changing sampling population needs additional analysis; merely collecting more observations does not restore these assumptions. Heavy tails may require much larger samples, while infinite variance is outside this theorem. There is no universal rule that thirty observations guarantees normality or reliable extreme-tail probabilities. The original individual population does not change. A stronger special case is available if individuals are already independent normal observations from one common population: their arithmetic mean is exactly normal for every positive sample size, not merely approximately normal for large sizes. The lesson has used a didactic lognormal model and reproducible pseudorandom samples, not a claim about real monitoring data. Confidence intervals and estimated standard errors are the next subjects, not silently included here."@en ; cd:authoredResource true .
  ex:l5-c14a-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-c14a-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14a-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-c14a-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14a-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-c14a-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14b-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-c14b-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14b-text a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-c14b-context ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14b-plot a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-c14b-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14c-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-c14c-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14c-text a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-c14c-context ; cd:communicativeRole cd:StatementRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14c-plot a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-c14c-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14d-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-c14d-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14d-plot a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-c14d-chart ; cd:communicativeRole cd:ChartRole ; cd:selectionPath "cd:body" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14d-math a cd:SceneItem ; cd:position 3 ; cd:selectsResource ex:l5-c14d-formula ; cd:communicativeRole cd:FormulaRole ; cd:selectionPath "cd:latex" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14e-heading a cd:SceneItem ; cd:position 1 ; cd:selectsResource ex:l5-c14e-title ; cd:communicativeRole cd:HeadingRole ; cd:selectionPath "skos:prefLabel@en" ; cd:language "en" ; cd:authoredResource true .
  ex:l5-c14e-list a cd:SceneItem ; cd:position 2 ; cd:selectsResource ex:l5-c14e-cards ; cd:communicativeRole cd:DefinitionListRole ; cd:selectionPath "cd:hasDefinitionListEntry" ; cd:language "en" ; cd:authoredResource true .
