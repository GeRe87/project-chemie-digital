@prefix cd: <https://w3id.org/project-chemie-digital/ontology/> .
@prefix ex: <https://w3id.org/project-chemie-digital/resource/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/project-chemie-digital/graph/knowledge/level5-ic-precision> {
  ex:ic-df-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-df1, ex:ic-df2, ex:ic-df3 ; cd:authoredResource true .
  ex:ic-df1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "IC variance check: six results"@en ; cd:body "- Fit one mean to the six IC readings.\n\n- Five residual directions remain: the chi-square precision reference uses 5 df."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-df2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Different questions, different counts"@en ; cd:body "- The later t example has five readings: 4 df.\n\n- F compares two six-result methods: 5 numerator df and 5 denominator df."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-df3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Five categories, fixed total"@en ; cd:body "- Four category counts determine the fifth.\n\n- Pearson uses 4 df here, not observations minus one. Fitted probabilities require further justification."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-case a cd:WorkedExample ; cd:body "Hypothetical IC nitrate repeatability check supplied for teaching. Fixed known reference SD sigma0=0.10 mg/L. Six independent repeats of a homogeneous sample: 9.95,10.15,9.85,10.25,9.95,10.15 mg/L; mean 10.05. Squared deviations sum to 0.12 (mg/L)^2; sample variance 0.024; SD 0.1549193338 mg/L. Prespecify alpha=0.05 and alternative sigma>sigma0. Q=12 has chi-square with 5 df at sigma=sigma0 under iid normal observations. For smaller sigma, Q is scaled smaller, so the boundary is least favorable for the composite null sigma<=sigma0. Cutoff 11.07049769351635; upper tail at 12 is 0.03478778050624185. Reject at 5% under these assumptions. This is evidence of poorer repeatability, not bias, a column-failure diagnosis or sample-release authorization. If the reference SD has material estimation uncertainty, this known-reference calibration is insufficient: account for its df using an appropriate independent variance comparison or another justified method."@en ; cd:authoredResource true .
  ex:ic-readings a cd:Dataset ; skos:prefLabel "Six constructed IC nitrate repeats"@en ; cd:unit "mg/L" ; cd:derivedFromResource ex:ic-case ; cd:hasObservation ex:ic-x1, ex:ic-x2, ex:ic-x3, ex:ic-x4, ex:ic-x5, ex:ic-x6 ; cd:authoredResource true .
  ex:ic-x1 a cd:Observation ; cd:position 1 ; cd:numericValue 9.95 ; cd:authoredResource true .
  ex:ic-x2 a cd:Observation ; cd:position 2 ; cd:numericValue 10.15 ; cd:authoredResource true .
  ex:ic-x3 a cd:Observation ; cd:position 3 ; cd:numericValue 9.85 ; cd:authoredResource true .
  ex:ic-x4 a cd:Observation ; cd:position 4 ; cd:numericValue 10.25 ; cd:authoredResource true .
  ex:ic-x5 a cd:Observation ; cd:position 5 ; cd:numericValue 9.95 ; cd:authoredResource true .
  ex:ic-x6 a cd:Observation ; cd:position 6 ; cd:numericValue 10.15 ; cd:authoredResource true .
  ex:ic-cards a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-c1, ex:ic-c2, ex:ic-c3 ; cd:authoredResource true .
  ex:ic-c1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Validated reference"@en ; cd:body "- Nitrate by ion chromatography (IC).\n\n- Previous repeatability SD: 0.10 mg/L, treated as a fixed known reference in this teaching case."@en ; cd:visualMotif "calibration-flasks" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-c2 a cd:DefinitionListEntry ; cd:position 2 ; skos:prefLabel "Today's six independent repeats"@en ; cd:body "- 9.95, 10.15, 9.85, 10.25, 9.95, 10.15 mg/L.\n\n- Same homogeneous water sample; mean 10.05 mg/L. Assume stable, independent normal errors."@en ; cd:visualMotif "statistics" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-c3 a cd:DefinitionListEntry ; cd:position 3 ; skos:prefLabel "Has precision deteriorated"@en ; cd:body "- A column problem is suspected, not established.\n\n- Test increased spread, not whether the nitrate result is correct. Choose a one-sided 5% rule before inspecting the series."@en ; cd:visualMotif "inference" ; cd:visualMotifRole "highlight" ; cd:authoredResource true .
  ex:ic-process-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-ic-precision-process.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Known-reference IC precision check: previous repeatability SD 0.10 mg/L, then six independent nitrate measurements on the same homogeneous water sample. Estimate today's spread and ask whether its increase could arise by chance. Chi-square compares the scaled squared-deviation sum against repeated-series variation. This checks precision, not accuracy or the cause of deterioration."@en ; cd:authoredResource true .
  ex:ic-residual-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-ic-residual-squares.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "In original measurement order, subtract fitted mean 10.05 mg/L and divide by fixed reference SD 0.10 mg/L. Scaled residuals are -1, 1, -2, 2, -1, 1; their squares are 1, 1, 4, 4, 1, 1, summing to 12. These centered residuals are constrained, not six independent standard normals."@en ; cd:authoredResource true .
  ex:ic-df-media a cd:MediaAsset ; cd:uri "/chemometrics/level5-ic-five-directions.svg"^^xsd:anyURI ; cd:mediaType "image/svg+xml" ; cd:alternativeText "Six independent normal IC results, one fitted mean, one zero-sum constraint on their centered residuals. Five independent orthogonal normal residual directions remain. At the true SD equal to the fixed 0.10 mg/L reference, their squared sum has a chi-square distribution with five degrees of freedom. Raw centered residuals are not independent standard normals."@en ; cd:authoredResource true .
  ex:ic-spread-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-spread-context1 ; cd:authoredResource true .
  ex:ic-spread-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Bigger spread: deterioration or just six unusual results"@en ; cd:body "Today's SD is about 0.155 mg/L, above the 0.10 mg/L reference. A new six-result series would give a different SD even if true method precision were unchanged. We need that sampling variation as a reference."@en ; cd:authoredResource true .
  ex:ic-spread a cd:MathExpression ; cd:formulaLabel "Sample spread versus the known reference SD"@en ; cd:latex "\\begin{gathered}s^2=\\frac{\\sum_{i=1}^{6}(x_i-\\bar x)^2}{6-1}=0.024\\;(\\mathrm{mg/L})^2\\\\s\\approx0.155\\;\\mathrm{mg/L},\\quad\\sigma_0=0.10\\;\\mathrm{mg/L}\\end{gathered}" ; dct:hasPart ex:ic-spread-legend ; cd:hasSymbol ex:ic-spread-values, ex:ic-spread-ops, ex:ic-spread-reference ; cd:authoredResource true .
  ex:ic-spread-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-spread-entry ; cd:authoredResource true .
  ex:ic-spread-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Data, divisor and units"@en ; dct:references ex:ic-spread-values, ex:ic-spread-ops, ex:ic-spread-reference ; cd:authoredResource true .
  ex:ic-spread-values a cd:MathSymbol ; cd:symbol "sample spread" ; cd:mathNotation "x_i,\\bar x,s^2,s" ; cd:body "x_i: measurement i, in mg/L; bar x: sample mean 10.05 mg/L. s²: sample variance, in (mg/L)²; s: sample SD, its positive root, in mg/L."@en ; cd:authoredResource true .
  ex:ic-spread-ops a cd:MathSymbol ; cd:symbol "calculation" ; cd:mathNotation "\\sum,i,-,{}^2,/,=,\\sqrt{},\\approx" ; cd:body "i=1,...,6 indexes measurements; sum adds squared deviations. Minus subtracts; superscript 2 squares; fraction divides; root is positive; equals states identity; approximately marks rounding. One fitted mean leaves divisor 6-1=5."@en ; cd:authoredResource true .
  ex:ic-spread-reference a cd:MathSymbol ; cd:symbol "reference SD" ; cd:mathNotation "\\sigma_0" ; cd:body "Sigma-zero: reference SD, 0.10 mg/L, known independently, not estimated from this sample. Subscript zero labels the reference, not its value."@en ; cd:authoredResource true .
  ex:ic-q-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-q-context1 ; cd:authoredResource true .
  ex:ic-q-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Put the observed spread on the reference scale"@en ; cd:body "Divide each deviation by 0.10 mg/L, then square and add. The result is 12, dimensionless. Subtracting the fitted mean constrains these residuals; they are not six independent standard normals."@en ; cd:authoredResource true .
  ex:ic-q a cd:MathExpression ; cd:formulaLabel "Same squared deviations, scaled by the reference variance"@en ; cd:latex "q=\\sum_{i=1}^{6}\\left(\\frac{x_i-\\bar x}{\\sigma_0}\\right)^2=\\frac{0.12}{0.10^2}=12" ; dct:hasPart ex:ic-q-legend ; cd:hasSymbol ex:ic-q-values, ex:ic-q-ops ; cd:authoredResource true .
  ex:ic-q-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-q-entry ; cd:authoredResource true .
  ex:ic-q-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Reference scaling"@en ; dct:references ex:ic-q-values, ex:ic-q-ops ; cd:authoredResource true .
  ex:ic-q-values a cd:MathSymbol ; cd:symbol "observed statistic" ; cd:mathNotation "q,x_i,\\bar x,\\sigma_0" ; cd:body "Lowercase q is this series' observed statistic. x indexed by i: IC result; bar x: fitted mean 10.05 mg/L. Sigma subscript zero: fixed reference SD 0.10 mg/L, not a fitted SD from these data."@en ; cd:authoredResource true .
  ex:ic-q-ops a cd:MathSymbol ; cd:symbol "squared scaled residuals" ; cd:mathNotation "\\sum,i,-,/,{}^2,=" ; cd:body "Sum all six indexed terms. Subtract, divide by reference SD, then square. Parentheses group the ratio; equality rewrites the same calculation. Numerator 0.12 has (mg/L) squared units; dividing by 0.10 squared cancels them, giving q=12."@en ; cd:authoredResource true .
  ex:ic-law-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-law-context1 ; cd:authoredResource true .
  ex:ic-law-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Why five degrees of freedom, not six"@en ; cd:body "Six independent normal results lose one residual direction when their mean is fitted. At true SD 0.10 mg/L, the sum can be decomposed into five independent squared standard-normal coordinates. It is not a sum of six independent raw residuals."@en ; cd:authoredResource true .
  ex:ic-law a cd:MathExpression ; cd:formulaLabel "Reference law when true SD equals the validated reference"@en ; cd:latex "Q=\\frac{(n-1)S^2}{\\sigma_0^2}\\sim\\chi^2_{n-1}=\\chi^2_5\\quad(\\sigma=\\sigma_0)" ; dct:hasPart ex:ic-law-legend ; cd:hasSymbol ex:ic-law-values, ex:ic-law-ops ; cd:authoredResource true .
  ex:ic-law-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-law-entry ; cd:authoredResource true .
  ex:ic-law-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Random variance reference and boundary condition"@en ; dct:references ex:ic-law-values, ex:ic-law-ops ; cd:authoredResource true .
  ex:ic-law-values a cd:MathSymbol ; cd:symbol "random series statistic" ; cd:mathNotation "Q,n,S^2,\\sigma,\\sigma_0" ; cd:body "Q varies across new six-result series; observed q is 12. n=6; S squared is random sample variance. Sigma is fixed true method SD; sigma0=0.10 mg/L is reference SD. Both SDs have mg/L units; Q is dimensionless."@en ; cd:authoredResource true .
  ex:ic-law-ops a cd:MathSymbol ; cd:symbol "law and degrees of freedom" ; cd:mathNotation "-,{}^2,/,=,\\sim,\\chi^2_{n-1}" ; cd:body "Subtract one fitted mean: n-1=5 df. Square SD and divide as shown; juxtaposition multiplies. Equality defines Q and identifies the df-five family; tilde names its law. Exact only for iid normal results at sigma=sigma0; below that boundary Q is scaled smaller."@en ; cd:authoredResource true .
  ex:ic-decision-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-decision-context1 ; cd:authoredResource true .
  ex:ic-decision-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Is this spread unusual under unchanged precision"@en ; cd:body "Observed 12 exceeds cutoff 11.07; its boundary-null upper tail is 3.48%. Reject at the preselected 5% level. Investigate repeatability; the test does not identify an ageing column as the cause."@en ; cd:authoredResource true .
  ex:ic-decision a cd:MathExpression ; cd:formulaLabel "One-sided test of deterioration in repeatability"@en ; cd:latex "\\begin{gathered}H_0:\\sigma\\le\\sigma_0,\\quad H_1:\\sigma>\\sigma_0\\\\q=12>\\chi^2_{5;0.95}\\approx11.07\\\\p=P_{\\sigma=\\sigma_0}(Q\\ge12)\\approx0.03479\\end{gathered}" ; dct:hasPart ex:ic-decision-legend ; cd:hasSymbol ex:ic-decision-values, ex:ic-decision-quantile, ex:ic-decision-ops ; cd:authoredResource true .
  ex:ic-decision-legend a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-decision-entry ; cd:authoredResource true .
  ex:ic-decision-entry a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Hypotheses, threshold and tail probability"@en ; dct:references ex:ic-decision-values, ex:ic-decision-quantile, ex:ic-decision-ops ; cd:authoredResource true .
  ex:ic-decision-values a cd:MathSymbol ; cd:symbol "hypotheses and SD" ; cd:mathNotation "H_0,H_1,\\sigma,\\sigma_0" ; cd:body "H with subscript 0: true SD at most reference; subscript 1: larger SD. Sigma is true repeatability SD; sigma0=0.10 mg/L is treated as known. This tests spread, not the correctness of a 10 mg/L mean."@en ; cd:authoredResource true .
  ex:ic-decision-quantile a cd:MathSymbol ; cd:symbol "upper-tail comparison" ; cd:mathNotation "q,Q,\\chi^2_{5;0.95},p,P" ; cd:body "q=12 is observed; Q is random. Chi-square subscript 5;0.95: 95th percentile with 5 df. P is probability at the null boundary sigma=sigma0; p is its upper tail, not the probability the null is true. All are dimensionless."@en ; cd:authoredResource true .
  ex:ic-decision-ops a cd:MathSymbol ; cd:symbol "decision notation" ; cd:mathNotation ":,\\le,>,\\ge,=,\\approx" ; cd:body "Colon defines hypotheses; inequalities select directions; equals states values; approximately rounds. Choose alpha=0.05 before data. For sigma below sigma0 this upper-tail rejection probability is smaller, so boundary calibration controls the composite null."@en ; cd:authoredResource true .
  ex:ic-repeat-context a cd:DefinitionList ; cd:hasDefinitionListEntry ex:ic-repeat-context1 ; cd:authoredResource true .
  ex:ic-repeat-context1 a cd:DefinitionListEntry ; cd:position 1 ; skos:prefLabel "Constant true precision does not mean constant estimated variance"@en ; cd:body "10,000 simulated series, six new normal readings each, true SD always 0.10 mg/L. Their scaled variance statistics fluctuate around the chi-square reference. The distribution calibrates chance variation; a finite histogram only approximates it."@en ; cd:authoredResource true .
}
